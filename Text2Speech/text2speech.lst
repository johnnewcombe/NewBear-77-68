   0000                      12 T_Q:             .rmb     1       ; Temp storage for ZIN
   0001                      13 T_Z:             .rmb     2       ;   "     "     "  RDX
   0003                      14 T_X:             .rmb     2       ;   "     "     "  PR_WORD
   0005                      15 T_Y:             .rmb     2       ;   "     "     "  table pointer
