0521                         ;ff63
0522 ef60 bd ec 76           HEADER  JSR     STRING  ; print string...
0523 ef63 20 43 43                   FCC     " CC"   ;
0524 ef66 20 42 20                   FCC     " B "   ;
0525 ef69 20 41 20                   FCC     " A "   ;
0526 ef6c 20 20 58                   FCC     "  X"   ;
0527 ef6f 20 20 20                   FCC     "   "   ;
0528 ef72 20 50 43                   FCC     " PC"   ;
0529 ef75 20 20 20                   FCC     "   "   ;
0530 ef78 53 50                      FCC     "SP"    ;
0531 ef7a ff                         FCB     $FF     ; End-of-string
0532 ef7b 7e ef 8c                   JMP     START   ; Return to MINIMON
0533 ef7e 8e f0 d0           RESET   LDS     #STACK  ; Set up stack for MINIMON
0534 ef81 86 03                      LDAA    #$03    ; Reset:
0535 ef83 b7 f4 01                   STAA    CTRLA   ;   ACIA.A
0536 ef86 b7 f4 03                   STAA    CTRLB   ;   ACIA.B
0537 ef89 bf f0 fd           SWI     STS     PSTACK  ; Save callers stack pointer
0538 ef8c 8e f0 d0           START   LDS     #STACK  ; Set up stack for MINMON
0539 ef8f 86 11                      LDAA    #$11    ; Set up:
0540 ef91 b7 f4 01                   STAA    CTRLA   ;   ACIA.A
0541 ef94 bd ec 76                   JSR     STRING  ; Print string...
0542 ef97 0d 0a 00 2a                FCB     $0D,$0A,$00,'*    ; c/r l/f null `*`
0543 ef9b ff                         FCB     $FF     ; End-of-string
0544 ef9c bd ec 00                   JSR     RD_CMD  ; Read a byte (test for `.`)
0545 ef9f 81 53                      CMPA    #'S     ; Is it `S` ?
0546 efa1 27 93                      BEQ     BRPTSET ; Yes: Set breakpoint cmd
0547 efa3 81 48                      CMPA    #'H     ; Is it `H` ?
0548 efa5 27 b9                      BEQ     HEADER  ;
0549 efa7 81 50                      CMPA    #'P     ; Is it `P` ?
0550 efa9 26 03                      BNE     L1      ; No: Skip
0551 efab 7e ec d8                   JMP     PUNCH   ;
0552 efae 81 4c              L1      CMPA    #'L     ; Is it `L` ?
0553 efb0 26 03                      BNE     L2      ; No: Skip
0554 efb2 7e ec e6                   JMP     LOAD    ;
0555 efb5 81 52              L2      CMPA    #'R     ; Is it `R`
0556 efb7 26 03                      BNE     L3      ; No: Skip
0557 efb9 7e ed 36                   JMP     REGPRT  ;
0558 efbc 81 42              L3      CMPA    #'B     ; Is it `B` ?
0559 efbe 26 03                      BNE     L6      ; No: Skip
0560 efc0 7e ed 62                   JMP     BLKMOV  ;
0561 efc3 81 4d              L6      CMPA    #'M     ; Is it `M` ?
0562 efc5 26 03                      BNE     L8      ; No: Skip
0563 efc7 7e ee 43                   JMP     MODIFY  ;
0564 efca 81 47              L8      CMPA    #'G     ; Is it `G` ?
0565 efcc 26 03                      BNE     L9      ; No: Skip
0566 efce 7e ee bf                   JMP     GO      ;
0567 efd1 81 43              L9      CMPA    #'C     ; Is it `C` ?
0568 efd3 26 03                      BNE     L10     ; No: Skip
0569 efd5 7e ee d6                   JMP     CONTNU  ;
0570 efd8 81 44              L10     CMPA    #'D     ; Is it `D` ?
0571 efda 26 b0                      BNE     START   ; No: Give up - ignore comand
0572 efdc 7e ef 04                   JMP     DUMP    ;
