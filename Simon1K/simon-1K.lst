output:  simon-1K.s19
0001                         ; ---------------------------------------------------------------
0002                         ; DEMON v6 CDC : JAN 2025 
0003                         ; was SIMON v1 CDC : DEC 2023 
0004                         ; which was trimmed DEMON v5 to get 
0005                         ; SWI handling, Load and Modify into 1K
0006                         ; with all other commands in 2nd 1K called EXTRAS
0007                         ; hence new name: Software Interrupt MONitor
0008                         ;
0009                         ; Set version number...
0010 0006                    C_VERSION   EQU     6
0011 0001                    C_SUBVER    EQU     1
0012                         ;
0013                         ; History...
0014                         ;
0015                         ; Jan-2025 : Minor mods
0016                         ;
0017                         ; Sep-2024 : ? shows name as DEMON as this command is only in 2kb version
0018                         ;
0019                         ; Jun-2024 : Bug fix in Block Move
0020                         ;
0021                         ; Feb-2023...
0022                         ;   Change Pdelay (Punch delay) from 5 to 8
0023                         ;
0024                         ; Jan-2023...
0025                         ;   Change `S`=Switches to Leds cmd to `R` ( coz we want the S )...
0026                         ;
0027                         ;   If `S` met as command, jump into LOAD at point after `S` 
0028                         ;   received so just starting to send an S19 file will 
0029                         ;   automagically invoke the LOAD process
0030                         ;
0031                         ; Dec-2023...  ver 1.1
0032                         ;   Code base taken from Demon v5
0033                         ;   Trimmed to just SWI handling, Load and Modify cmds
0034                         ;   Prompt suffix changed to >> from ->
0035                         ;   Some (more) JSR calls in CMD_M changed to SWI
0036                         ;   to save one byte each.
0037                         ;
0038                         ; ---------------------------------------------------------------
0039                         ; CD & DJ Carter  :  www.cmas-net.co.uk/vintage
0040                         ; ---------------------------------------------------------------
0041                         ; RESET address is same as ROM base address
0042                         ;
0043                         ; SIMON (Top 1KB) Commands:-                   Based on code from
0044                         ;   M = Modify                                          Minimon
0045                         ;   L = S19 format file load                            Mikbug
0046                         ;   G = Go <addr>
0047                         ; DEMON Extra (optional 2nd KB) Commands:-
0048                         ;   B = Block Move                                      Minimon
0049                         ;   P = File : `punch` S19 format                       Mikbug
0050                         ;   D = Dump                                            Minimon
0051                         ;   ? = Show version /  Help
0052                         ;   I = On/Off toggle for LED count during input wait
0053                         ;   Z = Set memory to <switches>        /__  For debugging
0054                         ;   Y = Check memory for <switches>     \    corrupted memory
0055                         ;   X = Find byte on <switches>
0056                         ;   S = <switches> to LEDs
0057                         ;   * = Bounce LEDs
0058                         ;   T = Test memory (R/W 0 to 255)  (error bit detect based on
0059                         ;       code by Ben Zotto ... https://sphere.computer)
0060                         ;
0061                         ; ---------------------------------------------------------------
0062                         ; Set up system-specific addresses
0063                         
0064 fff8                    H_VECT      EQU     $FFF8       ; Interrup Vector List Address
0065                         
0066 ffe0                    O_JMPS      EQU     H_VECT-24   ; Calc start of JMP list...
0067                                                         ; For 8 JMPs, 3 bytes per JMP
0068                                                         ; This is for entry points for
0069                                                         ; INEEE, OUTEEE equivalents etc
0070                                                         ; So these are at fixed positions
0071                                                         ; just before normal interrupt vectors
0072                         
0073 f800                    O_EXTRA     EQU     $F800       ; Start of DEMON, optional part.2 of SIMON
0074 fc00                    O_ROM       EQU     $FC00       ; Start of ROM ( 1K monitor )
0075                         
0076 0012                    D_MARK_1    EQU     $12         ; Marker byte for O_2NDKB, if used
0077 0021                    D_MARK_2    EQU     $21         ; Marker byte for O_2NDKB+1, if used
0078                         
0079 f0ff                    H_PANEL     EQU     $F0FF       ; Switches / Lights
0080                         
0081 f000                    O_RAM       EQU     $F000       ; Start of our RAM usage (F000->F00FE)
0082                         
0083 f0fd                    O_RAM_TOP   EQU     $F0FD       ; RAM TOP for variable and stack
0084                                                         ; Note: This leaves F0FE `unused`
0085                                                         ; in case any apps use S or X reg
0086                                                         ; to write to F0FE/F0FF to set
0087                                                         ; lights ( eg: Newbear tune program )
0088                         
0089                         ; ---------------------------------------------------------------
0090                         ; 2 x ACIAs :-  Hardware addresses
0091                         ;
0092 f400                    H_AciaA     EQU     $F400       ; Address of 1st ACIA (I/O port)
0093 f402                    H_AciaB     EQU     H_AciaA+2   ; Address of 2nd ACIA (I/O port)
0094                         ;
0095 f400                    H_DataA     EQU     H_AciaA     ; ACIA.A Data register
0096 f401                    H_CtrlA     EQU     H_AciaA+1   ; ACIA.A Ctrl/Status
0097 f402                    H_DataB     EQU     H_AciaB     ; ACIA.B Data register
0098 f403                    H_CtrlB     EQU     H_AciaB+1   ; ACIA.B Ctrl/Status
0099                         
0100                         ;--------------------------------------------------------
0101                         ;- ACIA setting values
0102                         ;--------------------------------------------------------
0103                         
0104 0003                    A_Reset   EQU  $03       ; Value: ACIA Reset
0105                         
0106                         ; Bits...
0107                         
0108 0001                    A_Got     EQU  $01       ; Value: ACIA `Has Data` bit
0109 0002                    A_Busy    EQU  $02       ; Value: ACIA `Busy` bit
0110                         
0111                         ; MODE definitions:-
0112                         
0113 0001                    A_M7_D_16 EQU  $01       ; Value: ACIA Mode: 7 data, 2 stop,
0114                                                  ;             Odd Parity, Clk/16
0115                         
0116 0011                    A_M8_D_16 EQU  $11       ; Value: ACIA Mode: 8.data, 2.stop,
0117                                                  ;             No Parity,  Clk/16
0118                         
0119 0010                    A_M8_D_1  EQU  $10       ; Value: ACIA Mode: 8.data, 2.stop,
0120                                                  ;             No Parity,  Clk/1
0121                         ; DEFAULT MODE...
0122                         ;
0123 0011                    A_AciaMode EQU A_M8_D_16 ; Default for both ACIAs
0124                         
0125                         ; -----------------------------------------------------
0126                         ; General constants
0127                         ;
0128                         ; Our lowest ASCII char allowed within a string is $07=BELL
0129                         ; anything *below* this can act as a string terminator
0130 0007                    C_ASC_low  EQU   $07    ; BELL
0131                         ; Using Zero as our teminator here (as in `c`)...
0132 0000                    C_EOS      EQU   $00    ; End-Of-String, for PR_STR_JSR
0133                         
0134 000d                    C_CR       EQU   $0D    ; C/R ( carriage-return )
0135 000a                    C_LF       EQU   $0A    ; L/F ( line-feed )
0136                         
0137                         ; -----------------------------------------------------
0138                         ; SIMON/DEMON SWI $nn call function codes for 
0139                         ; 1st data bye after SWI instruction...
0140 0000                    D_RESET       EQU     $00 ; Reset Monitor SOFT (& Stack)
0141 0001                    D_RD_BYTE     EQU     $01 ; Get char into A from ACIA
0142 0002                    D_RD_CMD      EQU     $02 ; Get char, test for . + LEDs
0143 0003                    D_RD_PR_BYT   EQU     $03 ; Get char into A from ACIA and output it
0144 0004                    D_PR_BYTE     EQU     $04 ; Output char in A
0145 0005                    D_PR_FROM_X   EQU     $05 ; Print string pointed to by X
0146 0006                    D_PR_STR      EQU     $06 ; Print string following SWI $06
0147 0007                    D_RD_HEX2     EQU     $07 ; Read 2hex char value into A
0148 0008                    D_RD_HEX4     EQU     $08 ; Read 4hex char value into X
0149 0009                    D_PR_HEX2     EQU     $09 ; O/P 2hex char value from A
0150 000a                    D_PR_HEX4     EQU     $0A ; O/P 4hex char value from X
0151 000b                    D_PR_STK      EQU     $0B ; Print data put on stack by SWI
0152 000c                    D_PR_REPEAT   EQU     $0C ; Print char in A no. of times in B
0153 000d                    D_PR_SPACE    EQU     $0D ; Print char in A no. of times in B
0154 000e                    D_PR_AND_SP   EQU     $0E ; Print char in A then a space
0155 000f                    D_PR_CRLF     EQU     $0F ; Print c/r and l/f
0156 0010                    D_RESET_HRD   EQU     $10 ; Reset monitor HARD - Inc.ACIAs
0157 0011                    D_RD_IFRDY    EQU     $11 ; Read Kbd char if one is ready,else A=0
0158 0012                    D_GET_RANDOM  EQU     $12 ; Put pseudo random number into X
0159 0013                    D_GET_VERSION EQU     $13 ; Return version Ver.Sub in A and B
0160 0014                    D_ASK_START   EQU     $14 ; Prompt for "Start:", value in X
0161 0015                    D_ASK_STOP    EQU     $15 ; Prompt for "Stop:", value in X
0162                         
0163                         ; -----------------------------------------------------
0164                         ; Flag bits ( in b_Flag byte ) etc...
0165 0001                    Flag_I      EQU     $01         ; `Idle` flag
0166 007f                    FlgAll      EQU     $7F         ; All possible flag bits ON
0167                         
0168                         ; -----------------------------------------------------
0169                         ; Delay after `P` issued, before o/p starts (0 to 255)...
0170 0008                    Pdelay      EQU     $08         ; = times delay loop is run
0171                         
0172                         ; -----------------------------------------------------
0173 0010                    DumpBPL     EQU     16          ; Dump Bytes Per Line default
0174                         
0175                         ; -----------------------------------------------------
0176                         ; -----------------------------------------------------
0177                         ; - RAM -
0178                         ; -------
0179 f000                                ORG     O_RAM
0180                         
0181                         ; - - - - - - - - - - - - - - - - - - - - - - - - - - -
0182                         ; Variables: b_ = BYTE,  d_ = Double Byte
0183                         ;
0184 f000                    d_AciaGO    RMB     2       ; ACIA addr for UI ( Console )
0185 f002                    b_AciaID    RMB     1       ; '1'=ACIA.A, '2'=ACIA.B
0186                         
0187 f003                    b_Wait      RMB     1       ; Delay for `Wait` after `P` (0 to 255) 
0188 f004                    b_Flag      RMB     1       ; Flag bits
0189                         
0190 f005                    b_dbpl      RMB     1       ; For Dump Bytes Per Line - User can change via 'M' cmd
0191 f006                    b_Q         RMB     1       ; For ZIN, DUMP, MODIFY
0192                         
0193 f007                    d_START     RMB     2       ; For ASK_Start `Start:`
0194 f009                    d_STOP      RMB     2       ;  "  ASK_Addrs `Stop:`
0195 f00b                    d_NEW       RMB     2       ;  "  Block move `To:`
0196                         
0197 f00d                    q_XY        EQU     *       ; For addressing X & Y as quad byte
0198 f00d                    d_X         RMB     2       ;  "  Block move (SUB) \_These 2 must
0199 f00f                    d_Y         RMB     2       ;  "  Block move (SUB) /  be together
0200                         
0201 f011                    d_BolX      RMB     2       ;  "  Modify, Dump (Begining Of Line)
0202 f013                    d_Hx4X      RMB     2       ;  "  RDX4 PRX4
0203 f015                    d_RdPrX     RMB     2       ;  "  RD_BYTE, PR_BYTE X, RD_IFRDY
0204 f017                    d_RdFstX    RMB     2       ;  "  RD_ByteFast X
0205                         ;
0206 f019                    d_PrStrR    EQU     *       ;  "  PR_STR_... : Return addr: WORD
0207 f019                    b_PrStrRhi  RMB     1       ;  "  PR_STR_... : Return addr: High byte
0208 f01a                    b_PrStrRlo  RMB     1       ;  "  PR_STR_... : Return addr: Low byte
0209                         ;
0210 f01b                    d_PrStrX    RMB     2       ;  "  PR_STR_... : X  and DumpAsc
0211 f01d                    d_PrStkX    RMB     2       ;  "  PR_STK_... : X
0212 f01f                    d_PrStrRAD  RMB     2       ;  "  PR_STR_... : Addr of Return Addr
0213 f021                    d_TW        RMB     2       ;  "  S19
0214 f023                    b_Csum      RMB     1       ;  "  S19
0215 f024                    b_Count     RMB     1       ;  "  S19
0216 f025                    b_Temp      RMB     1       ;  "  S19 and T(test)
0217 f026                    b_PrStrA    RMB     1       ;  "  PR_STR_... : A
0218 f027                    b_PrStkA    RMB     1       ;  "  PR_STK_... : A
0219 f028                    b_LEDa      RMB     1       ;  "  LED display work and CMD_T
0220 f029                    b_LEDs      RMB     1       ;  "  LED display work and CMD_T
0221 f02a                    d_Random    EQU     *       ; For grabbing next 2 bytes in GET_RANDOM
0222 f02a                    b_PrCnt     RMB     1       ;  "  PR and GET_RANDOM
0223 f02b                    b_RndCnt    RMB     1       ;  "  Incremented lots, mainly in ACIA waits
0224                         
0225                         ; SWI RAM variables
0226 f02c                    b_SwiTmp    RMB     1       ; Save B reg and to set CCs before RTI
0227 f02d                    b_SwiFunc   RMB     1       ; Our SWI Function code
0228                         ;
0229                         ; JMP <addr> ...
0230                         ; JMP ...
0231 f02e                    b_SwiJMP    RMB     1       ; JMP Instruction for SWI
0232                         ; <addr> ...
0233 f02f                    d_SwiAddr   EQU     *       ; JMP address - 16.bit value via X
0234 f02f                    b_SwiAdHi   RMB     1       ; JMP address - High byte
0235 f030                    b_SwiAdLo   RMB     1       ; JMP address - Low byte
0236                         ;
0237 f031                    d_SwiStk    RMB     2       ; Save SP
0238                         ;
0239 f033                    d_SwiX      EQU     *       ; Save X - 16.bit value for STX,LDX
0240 f033                    b_SwiXhi    RMB     1       ; Save X - High byte
0241 f034                    b_SwiXlo    RMB     1       ; Save X - low byte
0242                         ;
0243 f035                    d_SwiRet    EQU     *       ; Return PC - 16.bit value for STX
0244 f035                    b_SwiRetHi  RMB     1       ; Return PC - High byte
0245 f036                    b_SwiRetLo  RMB     1       ; Return PC - low byte
0246                         
0247 f036                    VAR_LAST    EQU     *-1
0248 0036                    VARS_USE    EQU     VAR_LAST-O_RAM  ; for lisitng
0249                         
0250                         ; - - - - - - - - - - - - - - - - - - - - - - - - - - -
0251                         ; STACK: The rest of our 256 byte RAM area is stack
0252                         
0253 f037                    S_BASE      EQU     *                 ; Bottom of stack
0254 f0fd                    S_TOP       EQU     O_RAM_TOP         ; Top of our stack
0255 00c7                    S_SIZE      EQU     S_TOP-VAR_LAST    ; for listing
0256                         
0257                         ; ------------------------------------------------------------------
0258                         ; FOR SIMON 1KB monitor ONLY :
0259                         ; ------------------------------------------------------------------
0260                         ; SIMON START 
0261                         ; -----------------------------------------------------
0262                         ; - ROM -
0263                         ; -------
0264 fc00                                ORG     O_ROM       ; Start of ROM based code
0265                         
0266 fc00                    Do_RESET    EQU     *           ; Main RESET point
0267 fc00 0e                             CLI                 ; Clear interrupt bit - for SWI func.0
0268 fc01 8e f0 fd                       LDS     #S_TOP      ; Set up stack for SIMON
0269                         
0270 fc04 86 10                          LDAA    #DumpBPL    ; Dump Bytes Per Line    ...
0271 fc06 b7 f0 05                       STAA    b_dbpl      ;  User can change via 'M' cmd
0272                         
0273 fc09 86 55                          LDAA    #$55        ; Put 01010101 on the LEDs
0274 fc0b b7 f0 ff                       STAA    H_PANEL     ; Put on LEDs
0275                         
0276 fc0e 86 7f                          LDAA    #FlgAll     ; A = All flag bits set ON
0277 fc10 b7 f0 04                       STAA    b_Flag      ; Set into flag byte
0278                         
0279 fc13 86 08                          LDAA    #Pdelay     ; Default delay
0280 fc15 b7 f0 03                       STAA    b_Wait      ; Set into RAM byte, where user can modify it
0281                         
0282                                                         ; Initialise ACIA modes in RAM...
0283                         
0284 fc18 86 03                          LDAA    #A_Reset    ; RESET ACIAs...
0285 fc1a b7 f4 01                       STAA    H_CtrlA     ;   ACIA.A
0286 fc1d b7 f4 03                       STAA    H_CtrlB     ;   ACIA.B
0287                         
0288 fc20 86 11                          LDAA    #A_AciaMode ; Get default mode for ACIAs
0289 fc22 b7 f4 01                       STAA    H_CtrlA     ;   ACIA.A
0290 fc25 b7 f4 03                       STAA    H_CtrlB     ;   ACIA.B
0291                         
0292 fc28 ce f4 00                       LDX     #H_AciaA    ; Get addr of ACIA.A for UI
0293 fc2b ff f0 00                       STX     d_AciaGO    ; Set A as our CURRENT device
0294 fc2e 86 31                          LDAA    #'1         ; Set ACIA ID char
0295 fc30 b7 f0 02                       STAA    b_AciaID    ;     for prompt
0296                         
0297 fc33                    WaitChr     EQU     *
0298                         ;            v
0299 fc33 ce f4 00                       LDX     #H_AciaA    ; X = addr of ACIA.A
0300 fc36 a6 01                          LDAA    1,X         ; Get ACIA status byte
0301 fc38 47                             ASRA                ; Shift low order bit to C
0302 fc39 25 10                          BCS     .ReadChr    ; Got char on A, already set, so GO
0303                         ;            v
0304 fc3b ce f4 02           .NoChrA     LDX     #H_AciaB    ; X = addr of ACIA.B
0305 fc3e a6 01                          LDAA    1,X         ; Get ACIA status byte
0306 fc40 47                             ASRA                ; Shift low order bit to C
0307 fc41 24 f0                          BCC     WaitChr     ; C not set, no char waiting
0308                         ;            v                  ; Set B as i/o tty device
0309 fc43 ff f0 00                       STX     d_AciaGO    ; Set B as our CURRENT device
0310 fc46 86 32                          LDAA    #'2         ; Set ACIA ID char
0311 fc48 b7 f0 02                       STAA    b_AciaID    ;     for prompt
0312 fc4b 8d 58              .ReadChr    BSR     RD_BYTE     ; Get rid of keystroke
0313                         ;            v
0314                         ; - - - - - - - - - - - - - - - - - - - - - - - - - - -
0315                         ;            v
0316 fc4d                    ReSTART     EQU     *           ; SOFT RESET point
0317 fc4d 8e f0 fd                       LDS     #S_TOP      ; Set up stack for SIMON
0318                         
0319 fc50 bd fe bd                       JSR     PR_CRLF     ; c/r l/f
0320 fc53 b6 f0 02                       LDAA    b_AciaID    ; Get ACIA.ID char (A or B)
0321 fc56 bd fc e3                       JSR     PR_BYTE     ; Output it
0322 fc59 bd fe 6c                       JSR     PR_STR_JSR  ; Print string...
0323 fc5c 3e 3e 20                       FCC     ">> "       ; PROMPT
0324 fc5f 00                             FCB     C_EOS       ;
0325                         
0326 fc60 8d 2b              RsGetCmd    BSR     RD_CMD      ; Read a byte (test for `.`)
0327 fc62 8d 36                          BSR     UPPER       ; Change Cmd byte to uppercase
0328 fc64 ce ff 84                       LDX     #C_STRT     ; Point to start of CMD table
0329 fc67                    .rsChkCmd   EQU     *
0330 fc67 a1 00                          CMPA    0,X         ; Is this the command ?
0331 fc69 26 07                          BNE     .rsIncIdx   ; No: skip past it
0332 fc6b bd fd b9                       JSR     PR_SPACE    ; Yes: Output a space
0333 fc6e ee 01                          LDX     1,X         ; Load address associated with
0334 fc70 6e 00                          JMP     0,X         ;  this CMD to X and JUMP to it
0335 fc72 08                 .rsIncIdx   INX                 ; Increment X
0336 fc73 08                             INX                 ;  to get to
0337 fc74 08                             INX                 ;   next command byte
0338 fc75 8c ff 90                       CPX     #C_END      ; Are we at end of list ?
0339 fc78 26 ed                          BNE     .rsChkCmd   ; No: Go check this one
0340 fc7a f6 f8 00                       LDAB    O_EXTRA     ; Look at 1st byte of SIMON extras
0341 fc7d c1 12                          CMPB    #D_MARK_1   ; Does it match 1st marker byte ?            
0342 fc7f 26 0a                          BNE     .rsChkEnd   ; No: quit
0343 fc81 f6 f8 01                       LDAB    O_EXTRA+1   ; Look at 2nd byte of SIMON extras
0344 fc84 c1 21                          CMPB    #D_MARK_2   ; Does it match 2nd marker byte ?
0345 fc86 26 03                          BNE     .rsChkEnd   ; No: quit
0346 fc88 bd f8 02                       JSR     O_EXTRA+2   ; Got extras... JSR to them           
0347 fc8b 20 c0              .rsChkEnd   BRA     ReSTART     ; Go back to start point
0348                         
0349                         ; -----------------------------------------------------
0350                         ; READ COMMAND BYTE ...
0351                         ;  Read a character into A
0352                         ;  : if `.` then soft START
0353                         ;  : Ignore NULLS ( =0 )
0354                         
0355 fc8d                    RD_CMD      EQU     *           ; Read ONE Character
0356 fc8d 8d 16                          BSR     RD_BYTE     ; Input one character
0357 fc8f 84 7f                          ANDA    #$7F        ; Strip off `parity` bit, if present
0358 fc91 8d 50                          BSR     PR_BYTE     ; Echo character
0359 fc93 81 2e                          CMPA    #'.         ; Was it '.' ?
0360 fc95 26 02                          BNE     .cDone      ;  If not, go to return
0361 fc97 20 b4              .cReStart   BRA     ReSTART     ; Yes: Go to START
0362 fc99 39                 .cDone      RTS                 ; RETURN
0363                         
0364                         ; -----------------------------------------------------
0365                         ; Convert Reg.A to UPPERCASE
0366                         
0367 fc9a 81 61              UPPER       CMPA    #'a         ; Is it below lowercase a-z ?
0368 fc9c 2d 06                          BLT     .CaseOK    
0369 fc9e 81 7a                          CMPA    #'z         ; Is it above lowercase a-z ?
0370 fca0 2e 02                          BGT     .CaseOK    
0371 fca2 80 20                          SUBA    #$20        ; Convert lowercase alpha to upper
0372 fca4 39                 .CaseOK     RTS
0373                         
0374                         ; -----------------------------------------------------
0375                         ; Read byte from ACIA(current) to A.  B and X preserved
0376                         
0377 fca5                    RD_BYTE     EQU     *           ; Read from ACIA to A
0378 fca5 7f f0 29                       CLR     b_LEDs
0379 fca8 37                             PSHB                ; Save B on STACK
0380 fca9 ff f0 15                       STX     d_RdPrX     ; Save X
0381 fcac fe f0 00                       LDX     d_AciaGO    ; X = addr of current ACIA
0382 fcaf 7c f0 2b           .rdChk      INC     b_RndCnt    ; Bump random number
0383 fcb2 5c                             INCB                ; Add one to B
0384 fcb3 27 0d                          BEQ     .rdLED
0385 fcb5 a6 01              .rdGet      LDAA    1,X         ; Get ACIA status byte
0386 fcb7 47                             ASRA                ; Shift low order bit to C
0387 fcb8 24 f5                          BCC     .rdChk      ; Loop until C set
0388 fcba a6 00                          LDAA    0,X         ; Get the data byte to A
0389 fcbc fe f0 15                       LDX     d_RdPrX     ; Restore X
0390 fcbf 33                             PULB                ; Restore B from STACK
0391 fcc0 4d                             TSTA                ; Set status bits for A
0392 fcc1 39                             RTS                 ; RETURN
0393 fcc2 f6 f0 04           .rdLED      LDAB    b_Flag      ; Load flag bits
0394 fcc5 c4 01                          ANDB    #Flag_I     ; Is the Flag_I bit set ?
0395 fcc7 27 ec                          BEQ     .rdGet      ; No: Skip LED display
0396 fcc9 7c f0 28                       INC     b_LEDa      ; Delay: Count through
0397 fccc f6 f0 28                       LDAB    b_LEDa      ; another byte
0398 fccf 26 e4                          BNE     .rdGet      ; If not zero, go back
0399 fcd1 7c f0 29                       INC     b_LEDs      ; Now increment LEDs value
0400 fcd4 f6 f0 29                       LDAB    b_LEDs      ; and load to B
0401                                                         ; Speaker attached to low bit...
0402 fcd7 58                             ASLB                ; Shift B left to zero low bit
0403                                                         ; This stops blips on speaker
0404 fcd8 f7 f0 ff                       STAB    H_PANEL     ; Show B on LEDs
0405 fcdb 20 d8                          BRA     .rdGet      ; go back to work
0406                         
0407                         
0408                         ; -----------------------------------------------------
0409                         ; Read a byte and echo it to ACIA...
0410                         
0411 fcdd 8d c6              RD_PR_BYTE  BSR     RD_BYTE     ; Read a byte from ACIA
0412 fcdf 20 02                          BRA     PR_BYTE     ; Output it and return via its BSR
0413                         ;..dummy..  RTS                 ; BRA used instead of BSR (above)
0414                         
0415                         ; -----------------------------------------------------
0416 fce1 86 3f              PR_QM       LDAA    #'?         ;  Question mark
0417                         ;             v
0418                         ; - - - - - - - - - - - - - - - - - - - - - - - - - - - -
0419                         ; Print byte in A, Preserve B and X
0420                         
0421 fce3                    PR_BYTE     EQU     *           ; From A to ACIA(current)
0422 fce3 7c f0 2a                       INC     b_PrCnt     ; Characters printed + One
0423 fce6 37                             PSHB                ; Preserve B on STACK
0424 fce7 ff f0 15                       STX     d_RdPrX     ; Save X
0425 fcea fe f0 00                       LDX     d_AciaGO    ; X = addr of current ACIA
0426 fced 7c f0 2b           .prChk      INC     b_RndCnt    ; Bump random number
0427 fcf0 e6 01                          LDAB    1,X         ; B = ACIA.status byte
0428 fcf2 c5 02                          BITB    #A_Busy     ; Is it busy ?
0429 fcf4 27 f7                          BEQ     .prChk      ; Yes: Try again
0430 fcf6 a7 00                          STAA    0,X         ; ACIA.data = A
0431 fcf8 fe f0 15                       LDX     d_RdPrX     ; Restore X
0432 fcfb 33                             PULB                ; Restore B from STACK
0433 fcfc 39                             RTS                 ; RETURN
0434                         
0435                         ; -----------------------------------------------------
0436 fcfd                    RD_ByteFast EQU     *           ; Read ONE Character (fast)
0437 fcfd ff f0 17                       STX     d_RdFstX    ; Save X
0438 fd00 fe f0 00                       LDX     d_AciaGO    ; X = addr of current ACIA
0439 fd03 a6 01              .rdChkF     LDAA    1,X         ; Get ACIA status byte
0440 fd05 47                             ASRA                ; Shift low order bit to C
0441 fd06 24 fb                          BCC     .rdChkF     ; Loop until C set
0442 fd08 a6 00                          LDAA    0,X         ; Get the data byte to A
0443 fd0a 8d d7                          BSR     PR_BYTE     ; Echo character ...echo...
0444                         ;xxx CUT    ANDA    #$7F        ; Strip off `parity` bit, if present
0445                         ;xxx CUT    BEQ     .rdChkF     ; Ignore paper tape follower
0446 fd0c 81 2e                          CMPA    #'.         ; Was it
0447 fd0e 26 03                          BNE     .rfDone      ;  a fullstop ?
0448 fd10 7e fc 4d                       JMP     ReSTART     ; Yes: Go to START
0449 fd13 fe f0 17           .rfDone     LDX     d_RdFstX    ; Restore X
0450 fd16 39                             RTS                 ; RETURN
0451                         
0452                         ; -----------------------------------------------------
0453                         ; -----------------------------------------------------
0454                         ; S format data load : Modded version of Mikbug code
0455                         ;                      S1<addr><len><data><crc>
0456                         ;                      S9<...> = end
0457                         ;
0458 fd17                    CMD_L       EQU     *           ; L = Load = Input an S19 file
0459 fd17                    .sRead      EQU     *
0460 fd17 8d e4                          BSR     RD_ByteFast ; Read+Echo, test for '.'
0461 fd19 81 53                          CMPA    #'S         ; Is it `S` ?
0462 fd1b 26 fa                          BNE     .sRead      ; No: Keep waiting for `S`
0463 fd1d 8d de              CMD_S       BSR     RD_ByteFast ; Read+Echo, test for '.'
0464 fd1f 81 39                          CMPA    #'9         ; Is it `9` ?  ( `S9` record )
0465 fd21 27 27                          BEQ     .sDone      ; Yes: End-data, Back to START
0466 fd23 81 31                          CMPA    #'1         ; Is it `1` ?  ( `S1` record )
0467 fd25 26 f0                          BNE     .sRead      ; No: Wait for next `S`
0468 fd27 7f f0 23                       CLR     b_Csum      ; Clear checksum
0469 fd2a 8d 56                          BSR     RD_HEX2     ; Read 2xHex = data.byte count to A
0470 fd2c 80 02                          SUBA    #2          ; Subtract 2 (to get bytes left in line)
0471 fd2e b7 f0 24                       STAA    b_Count     ; Store byte count
0472 fd31 8d 75                          BSR     RD_HEX4     ; Read 4xHex digit address to X
0473 fd33 8d 4d              .sDoByt     BSR     RD_HEX2     ; Read 2xHex digits, value to A
0474 fd35 7a f0 24                       DEC     b_Count     ; Decrement our byte count
0475 fd38 27 05                          BEQ     .sChk       ; If end-of-line, go look at checksum
0476 fd3a a7 00                          STAA    0,X         ; Save byte where X points
0477 fd3c 08                             INX                 ; Point X at next byte
0478 fd3d 20 f4                          BRA     .sDoByt     ; Go get next byte
0479 fd3f 86 0d              .sChk       LDAA    #C_CR       ; Print a
0480 fd41 8d a0                          BSR     PR_BYTE     ;  carriage-return
0481 fd43 7c f0 23                       INC     b_Csum      ; Add 1 to checksum
0482 fd46 27 cf                          BEQ     .sRead      ; OK: Go read next record
0483 fd48 8d 97                          BSR     PR_QM       ; Print "?"
0484 fd4a                    .sDone      EQU     *
0485 fd4a 7e fc 4d                       JMP     ReSTART     ; Go to START
0486                         
0487                         ; -----------------------------------------------------
0488                         ; Check A contains a HEX character,  Set C.bit on fail
0489                         ; If it fails, try converting to uppercase and retry
0490                         ; Trying to keep hex data reads fast.
0491                         
0492 fd4d                    VFY_HEX     EQU     *
0493 fd4d 8d 07                          BSR     .vTry       ; 1st try
0494 fd4f 24 0d                          BCC     .vIsHex     ; OK
0495 fd51 bd fc 9a                       JSR     UPPER       ; Convert to uppercase
0496 fd54 20 00                          BRA     .vTry       ; 2nd try
0497                         ;..dummy..  RTS                 ; BRA used instead of BSR (above)
0498                         ;           ---
0499 fd56 81 2f              .vTry       CMPA    #$2F        ; A < 30 ?
0500 fd58 2f 0e                          BLE     .vNoHex     ;  not hex
0501 fd5a 81 39                          CMPA    #$39        ; A > 39 ?
0502 fd5c 22 02                          BHI     .vNoNum     ;  Not a Numeral
0503 fd5e 0c                 .vIsHex     CLC                 ; It's OK (clear C bit)
0504 fd5f 39                             RTS                 ; RETURN
0505                         ;           ---
0506 fd60 81 40              .vNoNum     CMPA    #$40        ; A < 41 ?
0507 fd62 2f 04                          BLE     .vNoHex     ;  not hex
0508 fd64 81 46                          CMPA    #$46        ; A <= 46
0509 fd66 2f f6                          BLE     .vIsHex     ;  then it is hex
0510 fd68 0d                 .vNoHex     SEC                 ; Set C bit
0511 fd69 39                             RTS                 ; RETURN
0512                         
0513                         ; -----------------------------------------------------
0514                         ; A and B have 2 x hex digits, convert to binary and return in A
0515                         
0516 fd6a 85 30              HEX2BIN     BITA    #$30        ; Is A a letter ?
0517 fd6c 27 0c                          BEQ     .hNumA      ; Yes: Go to handle it
0518 fd6e 48                 .hShftA     ASLA                ;  No: It is a number, so
0519 fd6f 48                             ASLA                ;      shift
0520 fd70 48                             ASLA                ;       left
0521 fd71 48                             ASLA                ;        4 bits
0522 fd72 c5 30                          BITB    #$30        ; Is B a letter ?
0523 fd74 27 08                          BEQ     .hNumB      ; Yes: Go handle it
0524 fd76 c4 0f              .hMaskB     ANDB    #$0F        ; Clear 4 high bits in B
0525 fd78 1b                             ABA                 ; Form binary character (A=A+B)
0526 fd79 39                             RTS                 ; RETURN
0527 fd7a 8b 09              .hNumA      ADDA    #$09        ; Make A a binary
0528 fd7c 20 f0                          BRA     .hShftA     ;  as before
0529 fd7e cb 09              .hNumB      ADDB    #$09        ; Make B a binary
0530 fd80 20 f4                          BRA     .hMaskB     ;  as before
0531                         
0532                         ; -----------------------------------------------------
0533                         ; Read a 2 digit HEX value, put result into X
0534                         
0535 fd82                    RD_HEX2     EQU     *
0536 fd82 bd fc fd                       JSR     RD_ByteFast ; Read a character
0537 fd85 8d c6                          BSR     VFY_HEX     ; Is it a hex character ?
0538 fd87 25 18                          BCS     .rxPrQM     ; No: go to print `?`
0539 fd89 b7 f0 06                       STAA    b_Q         ; Save it
0540 fd8c bd fc fd                       JSR     RD_ByteFast ; Read 2nd character
0541 fd8f 8d bc                          BSR     VFY_HEX     ; Is it a hex character ?
0542 fd91 25 0e                          BCS     .rxPrQM     ; No: go to print `?`
0543 fd93 16                             TAB                 ; Yes: Put it into B
0544 fd94 b6 f0 06                       LDAA    b_Q         ; Retrieve 1st hex char to A
0545 fd97 8d d1                          BSR     HEX2BIN     ; Convert A:B to binary to A
0546 fd99 16                             TAB                 ; B=A
0547 fd9a fb f0 23                       ADDB    b_Csum      ; Add this value
0548 fd9d f7 f0 23                       STAB    b_Csum      ; to the Checksum (for S19)
0549 fda0 39                             RTS                 ; RETURN
0550 fda1 bd fc e1           .rxPrQM     JSR     PR_QM       ; Print "?"
0551 fda4 20 dc                          BRA     RD_HEX2     ; Go back to start of hex input
0552                         
0553                         ; -----------------------------------------------------
0554                         ; Read 4 hex digits and put value into X
0555                         ;
0556                         ; RD_HEX4   = Read 4.hex digit address value into X
0557                         ; RD_HEX4_S = As above, but print a SPACE first
0558                         
0559 fda6 8d 11              RD_HEX4_S   BSR     PR_SPACE    ; Print a space
0560 fda8 8d d8              RD_HEX4     BSR     RD_HEX2     ; Read 2 digit hex val into A
0561 fdaa b7 f0 13                       STAA    d_Hx4X      ; Save high.byte
0562 fdad 8d d3                          BSR     RD_HEX2     ; Read 2 digit hex val into A
0563 fdaf b7 f0 14                       STAA    d_Hx4X+1    ; Save low.byte
0564 fdb2 fe f0 13                       LDX     d_Hx4X      ; Load 4 digit hex val into X
0565 fdb5 39                             RTS                 ; RETURN
0566                         
