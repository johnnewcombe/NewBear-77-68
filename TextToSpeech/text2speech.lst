                            206 ;--------------------------------------------------------------
                            207 ; Gets the weight data from the scales and rerurns with carry
                            208 ; set if a valid reading, carry clear otherwise. A valid weight
                            209 ; reading resets the idle count. Data received is stored in
                            210 ; T_WEIGHT and MSB in A.
                            211 ;--------------------------------------------------------------
ASxxxx Assembler V05.50.5  (Motorola 6800/6802/6808)                    Page 5
Hexadecimal [16-Bits]                                 Fri May  1 13:46:24 2026



   024C                     212 GETDATA:
   024C BD 02 D6      [ 9]  213         JSR     RD_XB           ; read 4 hex characters into X
   024F FF 19 51      [ 6]  214         STX     T_WEIGHT        ; store X
   0252 0C            [ 2]  215         CLC
   0253 B6 19 51      [ 4]  216         LDAA    T_WEIGHT        ; get fist byte (stones)
   0256 27 04         [ 4]  217         BEQ     GDDONE          ; idle message
   0258 7F 00 02      [ 6]  218         CLR     IDLE_SECS       ; not an idle message so reset the idle counter
   025B 0D            [ 2]  219         SEC                     ; non idle message return with carry set
   025C 39            [ 5]  220 GDDONE:  RTS
