0421                         ; -----------------------------------------------------
0422                         ; Outputs a word based on value in A
0423                         ; -----------------------------------------------------
0424                         ; The routine loops through all of the word pointers derementing X as it goes
0425                         ; When X = 0, then the pointer to the word has been found.
0426 0440 ce 04 5c           PR_WORD     LDX     #WORDPTR        ; base of pointer table
0427 0443 4d                 PR_WORD1    TSTA                    ; is A zero?
0428 0444 27 05                          BEQ     FOUNDW          ; yes, use current entry
0429 0446 08                             INX                     ; advance to next 2-byte entry
0430 0447 08                             INX
0431 0448 4a                             DECA                    ; decrement index
0432 0449 20 f8                          BRA     PR_WORD1        ; loop
0433 044b a6 00              FOUNDW      LDAA    0,X             ; load high byte of pointer
0434 044d b7 18 0d                       STAA    T_X
0435 0450 a6 01                          LDAA    1,X             ; load low byte of pointer
0436 0452 b7 18 0e                       STAA    T_X+1
0437 0455 fe 18 0d                       LDX     T_X             ; load X with the word pointer
0438 0458 bd 03 7e                       JSR     STRINGBX        ; output the word
0439 045b 39                             RTS
0440                         
