                              1 ;------------------------------------------------------------------
                              2 ; text2speech.asm
                              3 ;------------------------------------------------------------------
                              4 
                              5                 .area   CODE1 (ABS)     ; absolute i.e. not relocatable
   0100                       6                 .org    0x0100
                              7 
                     F400     8 DATAA           .equ    0xF400          ; ACIA(a) Data register
                     F401     9 CTRLA           .equ    0xF401          ; ACIA(a) Ctrl/Status
                     F402    10 DATAB           .equ    0xF402          ; ACIA(b) Data register
                     F403    11 CTRLB           .equ    0xF403          ; ACIA(b) Ctrl/Status
                             12 
                             13 ; MINIMON routines
                     FC76    14 STRING          .equ    0xFC76          ; Prints a string.
                     FC89    15 GETADD          .equ    0xFC89          ; Get Address, read 4 digit hex value.
                     FCC9    16 ZOUT            .equ    0xFCC9          ; Print value in A as 2 hex digits.
                     FE97    17 NEWLINE         .equ    0xFE97          ; Prints a new line.
                     FF8F    18 START           .equ    0xFF8F          ; Restarts MniMon.
                     FC0F    19 PR_A            .equ    0xFC0F          ; Print char in A to ACIA (a)
                     FD2B    20 RD_A            .equ    0xFD2B          ; Read char from A
                     FD4D    21 PRSP            .equ    0xFD4D          ; Print a space
                     FC31    22 BINARY          .equ    0xFC31          ; Converts ASCII hex digits in A and B to binary?
                     FC65    23 RD_X            .equ    0xFC65          ; Read 4 hex digits Value from ACIA(a) and put value into X.
                     FC1D    24 VHEX            .equ    0xFC1D          ; Checks that A contains a HEX character
                             25 
                     F0FF    26 PANEL           .equ    0xF0FF          ; LEDs and switches
                     03FF    27 DELAY_VAL       .EQU    0x03FF          ; Delay loop count - adjust to taste (16 BIT VALUE)
                             28 
                     002D    29 IDLE_TICS       .equ    45              ; ticks between idle messages (1 tic = 2 secs approx)
                     000F    30 SHEAVY_WGHT     .equ    15              ; >= 15 stones
                     000D    31 HEAVY_WGHT      .equ    13              ; >= 13 stones
                     000A    32 NORM_WGHT       .equ    10              ; >= 10 stones
                     0006    33 LIGHT_WGHT      .equ    6               ; >= 6 stones
                     0014    34 TOO_HEAVY       .equ    20
                             35 
                             36 ; number of messages
                     000D    37 GREET_MSG_CNT   .equ    13
                     000A    38 LIGHT_MSG_CNT   .equ    10
                     0015    39 NORM_MSG_CNT    .equ    21
                     0012    40 HEAVY_MSG_CNT   .equ    18
                     000A    41 SHEAVY_MSG_CNT  .equ    10
                     0019    42 IDLE_MSG_CNT    .equ    25
                             43 
   0100                      44 INIT:
                             45                 ; clear the counters
   0100 7F 1B 1A      [ 6]   46                 CLR     IDLE_COUNT
   0103 7F 1B 1B      [ 6]   47                 CLR     IDLE_MSG_ID
   0106 7F 1B 1C      [ 6]   48                 CLR     GREET_MSG_ID
   0109 7F 1B 1D      [ 6]   49                 CLR     LIGHT_MSG_ID
   010C 7F 1B 1E      [ 6]   50                 CLR     NORMAL_MSG_ID
   010F 7F 1B 1F      [ 6]   51                 CLR     HEAVY_MSG_ID
   0112 7F 1B 20      [ 6]   52                 CLR     SHEAVY_MSG_ID
   0115 7F 1B 21      [ 6]   53                 CLR     PROCESSING_FLG
   0118 7F 1B 22      [ 6]   54                 CLR     SYLLABLES
   011B 7F F0 FF      [ 6]   55                 CLR     PANEL
