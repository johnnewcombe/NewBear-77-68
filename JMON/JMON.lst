0666                         ; FF8F
0667                         ; -----------------------------------------------------
0668 ff8f 8e f0 d0           START   LDS     #STACK  ; Set up stack for JMON
0669 ff92 86 11                      LDAA    #$11    ; 8 Data, No Parity, 2 Stop Bits
0670 ff94 b7 f4 01                   STAA    CTRLA   ;   ACIA.A
0671 ff97 bd fc 76                   JSR     STRING  ; Print string...
0672 ff9a 0d 0a 00 2a                FCB     $0D,$0A,$00,'*    ; c/r l/f null `*`
0673 ff9e ff                         FCB     $FF     ; End-of-string
0674 ff9f bd fc 00                   JSR     RD_CMD  ; Read a byte (test for `.`)
0675 ffa2 ce ff b8                   LDX     #CMDTAB ; point to command table
0676 ffa5 e6 00              CMDLP   LDAB    0,X     ; B = key byte (0 ends table)
0677 ffa7 27 e6                      BEQ     START   ; end of table → default to START
0678 ffa9 11                         CBA             ; compare A vs B
0679 ffaa 27 05                      BEQ     FOUND   ; match → dispatch
0680 ffac 08                         INX             ; skip key
0681 ffad 08                         INX             ; skip FDB high
0682 ffae 08                         INX             ; skip FDB low
0683 ffaf 20 f4                      BRA      CMDLP  ; try next entry
0684                         
0685 ffb1 e6 01              FOUND   LDAB    1,X     ; B = target high byte (FDB stores high,low)
0686 ffb3 a6 02                      LDAA    2,X     ; A = target low byte
0687 ffb5 36                         PSHA            ; push high first
0688 ffb6 37                         PSHB            ; push low — now low is on top of stack
0689 ffb7 39                         RTS             ; jump to target
0690                         
0691                         ; Command table: key, then FDB routine
0692 ffb8 53                 CMDTAB  FCB     'S
0693 ffb9 ff 39                      FDB     BRPTSET
0694 ffbb 48                         FCB     'H
0695 ffbc ff 63                      FDB     HEADER
0696 ffbe 50                         FCB     'P
0697 ffbf fd e2                      FDB     PUNCH
0698 ffc1 4c                         FCB     'L
0699 ffc2 fc e3                      FDB     LOAD
0700 ffc4 52                         FCB     'R
0701 ffc5 fd 36                      FDB     REGPRT
0702 ffc7 4d                         FCB     'M
0703 ffc8 fe 43                      FDB     MODIFY
0704 ffca 47                         FCB     'G
0705 ffcb fe c2                      FDB     GO
0706 ffcd 43                         FCB     'C
0707 ffce fe d9                      FDB     CONTNU
0708 ffd0 44                         FCB     'D
0709 ffd1 ff 07                      FDB     DUMP
0710 ffd3 54                         FCB     'T'
0711 ffd4 fd 62                      FDB     MEMTEST
0712 ffd6 56                         FCB     'V'
0713 ffd7 fd c3                      FDB     VERSION
0714 ffd9 4e                         FCB     'N'
0715 ffda ff 81                      FDB     RESET
0716 ffdc 00                         FCB     0       ; terminator
0717 ffdd ff 8f                      FDB     START   ; not used (any value ok after 0)
0718                         
