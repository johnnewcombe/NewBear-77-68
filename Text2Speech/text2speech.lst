                            314 ; Simulates a form feed to clear the screen
                            315 ;--------------------------------------------------------------
   0374 86 0D         [ 2]  316 CLS:    LDAA    #0x0d
   0376 BD FC 0F      [ 9]  317         JSR     PR_A            ; output carriage return
   0379 C6 10         [ 2]  318         LDAB    #16             ; 16 line feeds
   037B 86 0A         [ 2]  319         LDAA    #0x0a
