                     000D    28 HEAVY_WGHT      .equ    13              ; >= 13 stones
                     000A    29 NORM_WGHT       .equ    10              ; >= 10 stones
                     0006    30 LIGHT_WGHT      .equ    6               ; >= 6 stones
                     0014    31 TOO_HEAVY       .equ    20
