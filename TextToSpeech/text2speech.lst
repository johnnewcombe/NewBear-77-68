0395                         ; -----------------------------------------------------
0396                         ; Outputs a phrase from the memory location in X
0397                         ; -----------------------------------------------------
0398                         PR_PHRASE
0399                         
0400 033f a6 00              PR_PH1  LDAA    0,X         ; get high byte of word
0401 0341 e6 01                      LDAB    1,X         ; get low byte
0402 0343 81 ff                      CMPA    #$FF        ; check high byte
0403 0345 27 19                      BEQ     PR_PH2      ; high byte is $FF so we're done
0404 0347 ff 19 43           PR_PH3  STX     T_Y         ; save table pointer
0405 034a b7 19 45                   STAA    T_P
0406 034d f7 19 46                   STAB    T_P+1
0407 0350 fe 19 45                   LDX     T_P         ; X now points to the word
0408 0353 bd 03 61                   JSR     PR_WORD
0409 0356 bd 03 21                   JSR     PR_SPCB
0410 0359 fe 19 43                   LDX     T_Y         ; restore table pointer
0411 035c 08                         INX                 ; move to next entry
0412 035d 08                         INX                 ; (2 bytes per entry)
0413 035e 20 df                      BRA     PR_PH1
0414 0360 39                 PR_PH2  RTS
0415                         
