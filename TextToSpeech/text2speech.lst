0001                         ;------------------------------------------------------------------
0002                         ; text2speech.asm
0003                         ;------------------------------------------------------------------
0004                         
0005                         ; 7768 ACIA
0006 f400                    DATAA   EQU $F400 ; ACIA(a) Data register
0007 f401                    CTRLA   EQU $F401 ; ACIA(a) Ctrl/Status
0008 f402                    DATAB   EQU $F402 ; ACIA(b) Data register
0009 f403                    CTRLB   EQU $F403 ; ACIA(b) Ctrl/Status
0010                         
0011                         ; MINIMON routines
0012 fc76                    STRING  EQU $FC76 ; Prints a string. The string should follow JSR and be terminated with $FF.
0013 fc89                    GETADD  EQU $FC89 ; Get Address, read 4 digit hex value.
0014 fcc9                    ZOUT    EQU $FCC9 ; Print value in A as 2 hex digits.
0015 fe97                    NEWLINE EQU $FE97 ; Prints a new line.
0016 ff8f                    START   EQU $FF8F ; Restarts MniMon.
0017 fc0f                    PR_A    EQU $FC0F ; Print char in A to ACIA (a)
0018 fd2b                    RD_A    EQU $FD2B ; Read char from A
0019 fd4d                    PRSP    EQU $FD4D ; Print a space
0020 fc31                    BINARY  EQU $FC31 ; Converts ASCII hex digits in A and B to binary?
0021 fc65                    RD_X    EQU $FC65 ; Read 4 hex digits Value from ACIA(a) and put value into X.
0022 fc1d                    VHEX    EQU $FC1D ; Checks that A contains a HEX character
0023 0200                    	    ORG $0200
0024                         
0025                         ; initialise serial port B
0026 0200 86 11              TX2SP   LDAA    #$11    ; 8 Data, No Parity, 2 Stop Bits
0027 0202 b7 f4 03                   STAA    CTRLB   ;   ACIA.A
0028                         
0029 0205 ce 02 ef                   LDX     #TEXTBLOCK
0030 0208 bd 02 9a                   JSR     STRINGBX
0031                         
0032                         
0033                         LOOP:
0034                                 ; -----------------------------------------------------
0035                                 ; Data arrives at port B as four hex characters
0036                                 ; -----------------------------------------------------
0037 020b bd 02 da                   JSR     RD_XB           ; read 4 hex characters into X
0038 020e ff 03 15                   STX     TEMP            ; save X
0039                         
0040 0211 bd 02 e9                   JSR     PRSPB
0041 0214 b6 03 15                   LDAA    TEMP            ; Load high byte of X into Accumulator A
0042 0217 bd 02 66                   JSR     PR_DEC          ; puts 3 decimal digits in DEC, DEC+1 and DEC+2
0043                         
0044 021a b6 03 18                   LDAA    DEC+1           ; don't care about the hundreds
0045 021d 8b 30                      ADDA    #$30
0046 021f bd 02 cf                   JSR     PR_B
0047                         
0048 0222 b6 03 19                   LDAA    DEC+2
0049 0225 8b 30                      ADDA    #$30
0050 0227 bd 02 cf                   JSR     PR_B
0051                         
0052                         
0053                         ;--------------------------------------------------------------
0054                         ; SECOND DIGIT
0055                         ;--------------------------------------------------------------
0056                         
0057 022a bd 02 e9                   JSR     PRSPB
0058 022d b6 03 16                   LDAA    TEMP+1            ; Load high byte of X into Accumulator A
0059 0230 bd 02 66                   JSR     PR_DEC
0060                         
0061 0233 b6 03 18                   LDAA    DEC+1             ; don't care about the hundreds
0062 0236 8b 30                      ADDA    #$30
0063 0238 bd 02 cf                   JSR     PR_B
0064                         
0065 023b b6 03 19                   LDAA    DEC+2
0066 023e 8b 30                      ADDA    #$30
0067 0240 bd 02 cf                   JSR     PR_B
0068                         
0069                         
0070                         
0071                         
0072                         
0073 0243 bd 02 84                   JSR     STRINGB
0074 0246 0d 0a                      FCB     $0D, $0A
0075 0248 53 68 61 6c 6c 20          FCC     "Shall I tell you a joke?"
     49 20 74 65 6c 6c
     20 79 6f 75 20 61
     20 6a 6f 6b 65 3f
0076 0260 0d 0a ff                   FCB     $0D, $0A,$FF
0077                         
0078 0263 7e 02 0b           .END    JMP     LOOP  ;START   ; all done
0079                         
0080                         ; -----------------------------------------------------
0081                         ; PR_DEC: Puts 3 decimal digits in DEC, DEC+1 and DEC+2
0082                         ;
0083                         ;       !! ONLY WORKS WITH VALUES BELOW 128 !!
0084                         ; -----------------------------------------------------
0085 0266 5f                 PR_DEC  CLRB            ; Clear B for hundreds
0086                         
0087 0267 81 64              HUND    CMPA    #100    ; 100 or more?
0088                         
0089 0269 2d 05                      BLT     TENS
0090 026b 80 64                      SUBA    #100    ; Sub 100
0091 026d 5c                         INCB            ; Increment hundred counter
0092 026e 20 f7                      BRA     HUND
0093                         
0094 0270 f7 03 17           TENS    STAB    DEC     ; store the hundreds
0095                         
0096 0273 5f                         CLRB
0097 0274 81 0a              TENS1   CMPA    #10     ; 10 or more?
0098 0276 2d 05                      BLT     UNITS
0099 0278 80 0a                      SUBA    #10     ; Sub 10
0100 027a 5c                         INCB            ; Increment ten counter
0101 027b 20 f7                      BRA     TENS1
0102                         
0103 027d f7 03 18           UNITS   STAB    DEC+1
0104 0280 b7 03 19                   STAA    DEC+2   ; Final remainder is units
0105                         
0106 0283 39                         RTS
0107                         
0108                         
0109                         ; -----------------------------------------------------
0110                         ; Print string FOLLOWING JSR ( terminated by $FF ) to
0111                         ; ACIA(b) and ACIA(b)
0112                         ; -----------------------------------------------------
0113 0284 30                 STRINGB TSX             ; Get loc. of return addr to X
0114 0285 ee 00                      LDX     0,X     ; Get return addr to X
0115 0287 09                         DEX             ; Point to byte before
0116 0288 08                 AGAIN   INX             ; Point to next byte
0117 0289 a6 00                      LDAA    0,X     ; Get byte to be printed
0118 028b 81 ff                      CMPA    #$FF    ; End-string ?
0119 028d 27 07                      BEQ     ENDSTR  ; Yes: Go to finish up
0120 028f bd fc 0f                   JSR     PR_A    ; Print the byte to ACIA(a) (A is maintained)
0121 0292 8d 3b                      BSR     PR_B    ; Print the byte to ACIA(b)
0122 0294 20 f2                      BRA     AGAIN   ; Go back for next byte
0123 0296 31                 ENDSTR  INS             ; Clean up stack...
0124 0297 31                         INS             ;  ( pop off the return addr )
0125 0298 6e 01                      JMP     1,X     ; Jump back to caller (RETURN)
0126                         
0127                         ; -----------------------------------------------------
0128                         ; Prints a string pointed to by X
0129                         ; -----------------------------------------------------
0130 029a a6 00              STRINGBX    LDAA    0,X         ; get char
0131 029c 81 ff                          CMPA    #$FF        ; is character NULL?
0132 029e 27 08                          BEQ     DONEB       ; yes, end of string
0133 02a0 bd fc 0f                       JSR     PR_A        ; Print the byte to ACIA(a) (A is maintained)
0134 02a3 8d 2a                          BSR     PR_B        ; Print the byte to ACIA(b)
0135 02a5 08                             INX
0136 02a6 20 f2                          BRA     STRINGBX
0137 02a8 39                 DONEB       RTS
0138                         
0139                         ; -----------------------------------------------------
0140                         ; Reads a character from ACIA(b) into A
0141                         ; -----------------------------------------------------
0142 02a9 b6 f4 03           RD_B    LDAA    CTRLB       ; Get ACIA.A status byte
0143 02ac 85 01                      BITA    #01         ; Is byte ready in DATAb
0144 02ae 27 f9                      BEQ     RD_B        ; No: Try again
0145 02b0 b6 f4 02                   LDAA    DATAB       ; Get the data byte to A
0146                                 ;ANDA    #$7F        ; Mask off parity bit if it exists
0147 02b3 39                         RTS                 ; RETURN
0148                         
0149                         ; -----------------------------------------------------
0150                         ;
0151                         ; -----------------------------------------------------
0152 02b4 8d f3              ZINB    BSR     RD_B    ; Read a character
0153 02b6 bd fc 1d                   JSR     VHEX    ; Is it a hex character ?
0154 02b9 25 12                      BCS     Z_PRQM  ; No: go to print `?`
0155 02bb b7 03 12                   STAA    T_Q     ; Yes: Save Acc.A
0156 02be 8d e9                      BSR     RD_B    ; Read 2nd character
0157 02c0 bd fc 1d                   JSR     VHEX    ; Is it a hex character ?
0158 02c3 25 08                      BCS     Z_PRQM  ; No: go to print `?`
0159 02c5 16                         TAB             ; Yes: Put it into Acc.B
0160 02c6 b6 03 12                   LDAA    T_Q     ; Retrieve 1st hex char to Acc.A
0161 02c9 bd fc 31                   JSR     BINARY  ; Convert A:B to binary
0162 02cc 39                         RTS             ; RETURN
0163                         Z_PRQM  ;LDAA    #'?     ; Load `?` into A
0164                                 ;BSR     PR_B    ; Print it
0165 02cd 20 e5                      BRA     ZINB    ; Go back to start of hex input
0166                         
0167                         ; -----------------------------------------------------
0168                         ; Print character in A to ACIA(b)
0169                         ; -----------------------------------------------------
0170 02cf f6 f4 03           PR_B    LDAB    CTRLB   ; Get ACIA(a) status byte
0171 02d2 c5 02                      BITB    #02     ; Is it busy ?
0172 02d4 27 f9                      BEQ     PR_B    ; Yes: Try again
0173 02d6 b7 f4 02                   STAA    DATAB   ;  No: Send data
0174 02d9 39                 PRB_END RTS             ; RETURN
0175                         
0176                         ; -----------------------------------------------------
0177                         ; Read 4 hex digits and put value into X
0178                         ; -----------------------------------------------------
0179                         RD_XB   ;JSR     PRSPB   ; Print a space
0180 02da 8d d8                      BSR     ZINB    ; Read 2 digit hex value into A
0181 02dc b7 03 13                   STAA    T_Z     ; Save byte (most significant)
0182 02df 8d d3                      BSR     ZINB    ; Read 2 digit hex value into A
0183 02e1 b7 03 14                   STAA    T_Z+1   ; Save byte (least significant)
0184 02e4 fe 03 13                   LDX     T_Z     ; Load full 4 hex value into X
0185 02e7 39                         RTS             ; RETURN
0186                         
0187                         ; -----------------------------------------------------
0188                         ; Random idle phrase to ports B
0189                         ; -----------------------------------------------------
0190 02e8 39                 IDLE    RTS
0191                         
0192                         ; -----------------------------------------------------
0193                         ; Prints a space
0194                         ; -----------------------------------------------------
0195 02e9 86 20              PRSPB   LDAA    #$20        ; Put space character in A
0196 02eb bd 02 cf                   JSR     PR_B        ; Print it
0197 02ee 39                         RTS                 ; RETURN
0198                         
