output:  JMON.s19
0001                         ; ----------------------------------------------------------------------------
0002                         ; JMON (Jan. 2026)
0003                         ; ----------------------------------------------------------------------------
0004                         ;
0005                         ; Created by GlassTTY, Jan. 2026, using MINIMON (ACH, Dec. 1978) as a base
0006                         ; with additional code from Motorola's MIKBUG.
0007                         ;
0008                         ; Special thanks to Chris Carter for inspiration and help.
0009                         ;
0010                         ; ----------------------------------------------------------------------------
0011                         ;
0012                         ; This is a MINIMON compatible monitor for the 77-68 Bear/Newbear system with
0013                         ; the LOAD and PUNCH commands replaced for versions that support the
0014                         ; Motorola S Record Format (.s19) files.
0015                         ;
0016                         ; All entry points and source code labels as published in the MINIMON
0017                         ; documentation have been preserved with the exception of the LOAD and PUNCH
0018                         ; commands.
0019                         ;
0020                         ; In order to make space for the additional code required, the ALTER and
0021                         ; OFFSET CALCULATION commands have been removed. This has been justified as
0022                         ; the MODIFY command has very similar functionality to ALTER making ALTER
0023                         ; unnecessary, and the OFFSET CALCULATION routines (commands X and Y) are
0024                         ; rarely used as all cross-assemblers perform these calculations
0025                         ; automatically. In addition BLOCKMOVE command (Cmd 'B') has been removed
0026                         ; to allow for a memory test command to be added (Cmd 'T')'.
0027                         ;
0028                         ; One other minor change is that the terminal along with any devices sending
0029                         ; S19 format files have been configured for 8 Data Bits, No Parity, 2 Stop
0030                         ; Bits.
0031                         ;
0032                         ; ----------------------------------------------------------------------------
0033                         
0034 f401                    CTRLA   EQU     $F401   ; ACIA.A Ctrl/Status
0035 f403                    CTRLB   EQU     $F403   ; ACIA.B Ctrl/Status
0036 f400                    DATAA   EQU     $F400   ; ACIA.A Data register
0037 f402                    DATAB   EQU     $F402   ; ACIA.B Data register
0038                         
0039                         ; -----------------------------------------------------
0040                         ; Note:The original 256 bytes of RAM on the CPU board
0041                         ;  appears at $F000 to $F0FE, with Switches/LEDs at $F0FF
0042                         ;  when a MON1 board is installed
0043                         ; -----------------------------------------------------
0044 f0dd                    JNMI    EQU     $F0DD   ; 3 bytes for jump to NMI sub.
0045 f0e0                    JIRQ    EQU     $F0E0   ; 3 bytes for jump to IRQ sub.
0046 f0d0                    STACK   EQU     $F0D0   ; Stack goes down from $F0D0
0047                         
0048                         ; -----------------------------------------------------
0049 f0d8                            ORG     $F0D8
0050                         ; -----------------------------------------------------
0051                         ; $F0D1 to $F0DC APPREARS TO BE unused RAM
0052                         ; -----------------------------------------------------
0053                         
0054 f0d8                    T_TW    RMB     2       ; New additions to support SRec
0055 f0da                    T_CSUM  RMB     1       ;            "
0056 f0db                    T_COUNT RMB     1       ;            "
0057 f0dc                    T_TEMP  RMB     1       ;            "
0058                         
0059                         ; -----------------------------------------------------
0060 f0e3                            ORG     $F0E3   ; Start of RAM variables
0061                         ; -----------------------------------------------------
0062                         
0063 f0e3                    T_SAVE  RMB     2       ; Temp storage for NEWLINE
0064 f0e5                    T_P     RMB     1       ;   "     "     "  Z,X
0065 f0e6                    T_X     RMB     2       ;   "     "     "  Sub
0066 f0e8                    T_Y     RMB     2       ;   "     "     "  Sub
0067 f0ea                    T_NEW   RMB     2       ;   "     "     "  Block move
0068 f0ec                    T_M     RMB     1       ;   "     "     "  ZOUT
0069 f0ed                    T_TMPX  RMB     2       ;   "     "     "  PRX
0070 f0ef                    T_STRT  RMB     2       ;   "     "     "  GETADDRESS
0071 f0f1                    T_STOP  RMB     2       ;   "     "     "  GETADDRESS
0072 f0f3                    T_Z     RMB     2       ;   "     "     "   . RDX
0073 f0f5                    T_R     RMB     1       ;   "     "     "     PR
0074 f0f6                    T_Q     RMB     1       ;   "     "     "  ZIN,DUMP 
0075 f0f7                    T_ABYT  RMB     2       ;   "     "     "  SET BR.PT.
0076 f0f9                            RMB     2       ;   "     "     "  SET BR.PT.
0077 f0fb                    T_BYTE  RMB     2       ;   "     "     "  SET BR.PT.
0078 f0fd                    PSTACK  RMB     2       ;   "     "     "     SWI etc
0079                         
0080                         ; -----------------------------------------------------
0081 fc00                            ORG     $FC00   ; Start of ROM based code
0082                         ; -----------------------------------------------------
0083                         
0084                         ; -----------------------------------------------------
0085                         ; Read Character from ACIA
0086                         ; FC00
0087                         ; -----------------------------------------------------
0088 fc00 bd fd 2b           RD_CMD  JSR     RD_A    ; Input one character
0089 fc03 27 fb                      BEQ     RD_CMD  ; Ignore paper tape follower
0090 fc05 8d 08                      BSR     PR_A    ; Echo character
0091 fc07 81 2e                      CMPA    #'.     ; Was it a fullstop ?
0092 fc09 26 11                      BNE     PRA_END ;
0093 fc0b 7e ff 8f                   JMP     START   ; Yes: Go to start of MINIMON
0094                         
0095 fc0e 01                         NOP
0096                         
0097                         ; -----------------------------------------------------
0098                         ; Print character in A
0099                         ; FC0F
0100                         ; -----------------------------------------------------
0101 fc0f f6 f4 01           PR_A    LDAB    CTRLA   ; Get ACIA(a) status byte
0102 fc12 c5 02                      BITB    #02     ; Is it busy ?
0103 fc14 27 f9                      BEQ     PR_A    ; Yes: Try again
0104 fc16 b7 f4 00                   STAA    DATAA   ;  No: Send data
0105 fc19 7c f0 f5                   INC     T_R     ; Characters printed + One
0106 fc1c 39                 PRA_END RTS             ; RETURN
0107                         
0108                         ; -----------------------------------------------------
0109                         ; Check A contains a HEX character,  Set C.bit on fail
0110                         ; FC1D
0111                         ; -----------------------------------------------------
0112 fc1d 81 2f              VHEX    CMPA    #$2F    ; A < 30 ?
0113 fc1f 2f 0e                      BLE     NotHex  ;  not hex
0114 fc21 81 39                      CMPA    #$39    ; A > 39 ?    
0115 fc23 22 02                      BHI     NotNum  ;  Not a Numeral
0116 fc25 0c                 IsHex   CLC             ; It's OK (clear C bit)
0117 fc26 39                         RTS             ; RETURN
0118 fc27 81 40              NotNum  CMPA    #$40    ; A < 41 ?
0119 fc29 2f 04                      BLE     NotHex  ;  not hex
0120 fc2b 81 46                      CMPA    #$46    ; A <= 46
0121 fc2d 2f f6                      BLE     IsHex   ;  then it is hex
0122 fc2f 0d                 NotHex  SEC             ; Set C bit
0123 fc30 39                         RTS             ; RETURN
0124                         
0125                         ; -----------------------------------------------------
0126                         ; Convert A:B to binary
0127                         ; FC31
0128                         ; -----------------------------------------------------
0129 fc31 85 30              BINARY  BITA    #$30    ; Is it a letter ?
0130 fc33 27 0c                      BEQ     LETTA   ; Yes: Got to handle it
0131 fc35 48                 RIDA    ASLA            ;  No: It is a number, so
0132 fc36 48                         ASLA            ;      shift
0133 fc37 48                         ASLA            ;       left
0134 fc38 48                         ASLA            ;        4 bits
0135 fc39 c5 30                      BITB    #$30    ; Is Acc.B a letter ?
0136 fc3b 27 08                      BEQ     LETTB   ; Yes: Go handle it
0137 fc3d c4 0f              RIDB    ANDB    #$0F    ; Clear 4 high bits in Acc.B
0138 fc3f 1b                         ABA             ; Form binary character (A=A+B)
0139 fc40 39                         RTS             ; RETURN
0140 fc41 8b 09              LETTA   ADDA    #$09    ; Make Acc.A a binary
0141 fc43 20 f0                      BRA     RIDA    ;  as before
0142 fc45 cb 09              LETTB   ADDB    #$09    ; Make Acc.B a binary
0143 fc47 20 f4                      BRA     RIDB    ;  as before
0144                         
0145                         ; -----------------------------------------------------
0146                         ; Read a 4 digit HEX value, put result into X
0147                         ; FC49
0148                         ; -----------------------------------------------------
0149 fc49 8d b5              ZIN     BSR     RD_CMD  ; Read a character
0150 fc4b 8d d0                      BSR     VHEX    ; Is it a hex character ?
0151 fc4d 25 10                      BCS     Z_PRQM  ; No: go to print `?`
0152 fc4f b7 f0 f6                   STAA    T_Q     ; Save it
0153 fc52 8d ac                      BSR     RD_CMD  ; Read 2nd character
0154 fc54 8d c7                      BSR     VHEX    ; Is it a hex character ?
0155 fc56 25 07                      BCS     Z_PRQM  ; No: go to print `?`
0156 fc58 16                         TAB             ; Yes: Put it into B
0157 fc59 b6 f0 f6                   LDAA    T_Q     ; Retrieve 1st hex char to A
0158 fc5c 7e fc d8                   JMP     ZIN2    ; S19 version of ZIN is longer
0159 fc5f bd fd 21           Z_PRQM  JSR     PR_QM   ; Print "?"
0160 fc62 7e fc 49                   JMP     ZIN     ; Go back to start of hex input
0161                         
0162                         ; -----------------------------------------------------
0163                         ; Read 4 hex digits and put value into X
0164                         ; FC65
0165                         ; -----------------------------------------------------
0166 fc65 bd fd 4d           RD_X    JSR     PRSP    ; Print a space
0167 fc68 8d df                      BSR     ZIN     ; Read 2 digit hex value into A
0168 fc6a b7 f0 f3                   STAA    T_Z     ; Save byte (most significant)
0169 fc6d 8d da                      BSR     ZIN     ; Read 2 digit hex value into A
0170 fc6f b7 f0 f4                   STAA    T_Z+1   ; Save byte (least significant)
0171 fc72 fe f0 f3                   LDX     T_Z     ; Load full 4 hex value into X
0172 fc75 39                         RTS             ; RETURN
0173                         
0174                         ; -----------------------------------------------------
0175                         ; Print string FOLLOWING JSR ( terminated by $FF )
0176                         ;  IE: It starts at the `return addr` put onto the stack by JSR
0177                         ;  So actual return address needed is past the string
0178                         ; FC76
0179                         ; -----------------------------------------------------
0180 fc76 30                 STRING  TSX             ; Get loc. of return addr to X
0181 fc77 ee 00                      LDX     0,X     ; Get return addr to X
0182 fc79 09                         DEX             ; Point to byte before
0183 fc7a 08                 AGAIN   INX             ; Point to next byte
0184 fc7b a6 00                      LDAA    0,X     ; Get byte to be printed
0185 fc7d 81 ff                      CMPA    #$FF    ; End-string ?
0186 fc7f 27 04                      BEQ     ENDSTR  ; Yes: Go to finish up
0187 fc81 8d 8c                      BSR     PR_A    ; Print the byte
0188 fc83 20 f5                      BRA     AGAIN   ; Go back for next byte
0189 fc85 31                 ENDSTR  INS             ; Clean up stack...
0190 fc86 31                         INS             ;  ( pop off the return addr )
0191 fc87 6e 01                      JMP     1,X     ; Jump back to caller (RETURN)
0192                         
0193                         ; -----------------------------------------------------
0194                         ; FC89
0195                         ; -----------------------------------------------------
0196 fc89 8d eb              GETADD  BSR     STRING  ; Print string...
0197 fc8b 20 53                      FCC     " S"    ;
0198 fc8d ff                         FCB     $FF     ; End-of-string
0199 fc8e 8d d5                      BSR     RD_X    ; Read 4 digit HEX addr value
0200 fc90 ff f0 ef                   STX     T_STRT  ; Save it
0201 fc93 8d e1                      BSR     STRING  ; Print string...
0202 fc95 20 46                      FCC     " F"    ;
0203 fc97 ff                         FCB     $FF     ; End-of-string
0204 fc98 8d cb                      BSR     RD_X    ; Read 4 digit HEX addr value
0205 fc9a ff f0 f1                   STX     T_STOP  ; Save it
0206 fc9d 39                         RTS             ; RETURN
0207                         
0208                         ; -----------------------------------------------------
0209                         ; Convert value in A to 2 x ASCII hex digits in A and B
0210                         ; FC9E
0211                         ; -----------------------------------------------------
0212 fc9e 16                 ASCII   TAB             ; Copy A to B
0213 fc9f 84 f0                      ANDA    #$F0    ; Clear low order 4 bits of A
0214 fca1 44                         LSRA            ; Shift
0215 fca2 44                         LSRA            ;  right
0216 fca3 44                         LSRA            ;   4
0217 fca4 44                         LSRA            ;    bits
0218 fca5 81 09                      CMPA    #$09    ; Letter or number ?
0219 fca7 22 0b                      BHI     SUBT    ; 
0220 fca9 8b 30                      ADDA    #$30    ; Make it an ASCII number
0221 fcab c4 0f              AND     ANDB    #$0F    ; Clear high order bits of B
0222 fcad c1 09                      CMPB    #$09    ; Letter or number ?
0223 fcaf 22 07                      BHI     ADD     ;
0224 fcb1 cb 30                      ADDB    #$30    ; Make it an ASCII number
0225 fcb3 39                         RTS             ; RETURN
0226 fcb4 8b 37              SUBT    ADDA    #$37    ; Make it an ASCI letter
0227 fcb6 20 f3                      BRA     AND     ; Go to process low order value
0228 fcb8 cb 37              ADD     ADDB    #$37    ; Make it an ASII letter
0229 fcba 39                         RTS             ; RETURN
0230                         
0231                         ; -----------------------------------------------------
0232                         ; Print value in X as 4 hex digits
0233                         ; FCBB
0234                         ; -----------------------------------------------------
0235 fcbb ff f0 ed           PRX     STX     T_TMPX  ; Save X
0236 fcbe b6 f0 ed                   LDAA    T_TMPX  ; Get high order byte to A
0237 fcc1 8d 06                      BSR     ZOUT    ; Print A as 2 hex digits
0238 fcc3 b6 f0 ee                   LDAA    T_TMPX+1; Get low order byte to A
0239 fcc6 20 01                      BRA     ZOUT    ; Print A as 2 hex digits
0240                         
0241 fcc8 01                         NOP
0242                         
0243                         ; -----------------------------------------------------
0244                         ; Print value in A as 2 hex digits, Preserve B
0245                         ; X unchanged by called routines
0246                         ; This is 1 byte shorter that original ZOUT
0247                         ; FCC9
0248                         ; -----------------------------------------------------
0249 fcc9 37                 ZOUT    PSHB            ; Save B to STACK
0250 fcca 36                         PSHA            ; Save A to STACK
0251 fccb 8d d1                      BSR     ASCII   ; Convert A to ASCII in A & B
0252 fccd 37                         PSHB            ; Save B (2nd byte) to STACK
0253 fcce bd fc 0f                   JSR     PR_A    ; Print byte in A
0254 fcd1 32                         PULA            ; Get 2nd byte into A from STACK
0255 fcd2 bd fc 0f                   JSR     PR_A    ; Print byte in A
0256 fcd5 32                         PULA            ; Recover A from STACK
0257 fcd6 33                         PULB            ; Recover B from STACK
0258 fcd7 39                         RTS             ; RETURN
0259                         
0260                         
0261                         ; second part of S19 version of ZIN
0262 fcd8 bd fc 31           ZIN2    JSR     BINARY  ; Convert A:B to binary to A
0263 fcdb 16                         TAB             ; B=A
0264 fcdc fb f0 da                   ADDB    T_CSUM  ; Add this value
0265 fcdf f7 f0 da                   STAB    T_CSUM  ; to the Checksum (for S19)
0266 fce2 39                         RTS             ; RETURN
0267                         
0268                         ; -----------------------------------------------------
0269                         ; S19 format data load : Modded version of Mikbug code
0270                         ; FCE3
0271                         ; -----------------------------------------------------
0272 fce3                    LOAD    EQU     *       ; L = Load = Input an S19 file
0273 fce3 8d 91                      BSR     STRING
0274 fce5 0d 0a                      FCB     $0D,$0A ; c/r l/f
0275 fce7 ff                         FCB     $FF     ; End-Of-String
0276 fce8 bd fc 00           LREAD   JSR     RD_CMD  ; Read+Echo, test for '.'
0277 fceb 81 53                      CMPA    #'S     ; Is it `S` ?
0278 fced 26 f9                      BNE     LREAD   ; No: Keep waiting for `S`
0279 fcef bd fc 00                   JSR     RD_CMD  ; Read+Echo, test for '.'
0280 fcf2 81 39                      CMPA    #'9     ; Is it `9` ?  ( `S9` record )
0281 fcf4 26 03                      BNE     LREAD1
0282 fcf6 7e fe b3                   JMP     STERMR  ; handle termination record
0283 fcf9 81 31              LREAD1  CMPA    #'1     ; Is it `1` ?  ( `S1` record )
0284 fcfb 26 eb                      BNE     LREAD   ; No: Wait for next `S`
0285 fcfd 7f f0 da                   CLR     T_CSUM  ; Clear checksum
0286 fd00 bd fc 49                   JSR     ZIN     ; Read 2xHex = data.byte count to A
0287 fd03 80 02                      SUBA    #2      ; Subtract 2 (to get bytes left in line)
0288 fd05 b7 f0 db                   STAA    T_COUNT ; Store byte count
0289 fd08 bd fc 65                   JSR     RD_X    ; Read 4xHex digit address to X
0290 fd0b bd fc 49           LDOBYT  JSR     ZIN     ; Read 2xHex digits, value to A
0291 fd0e 7a f0 db                   DEC     T_COUNT ; Decrement our byte count
0292 fd11 27 05                      BEQ     LCHK    ; If end-of-line, go look at checksum
0293 fd13 a7 00                      STAA    0,X     ; Save byte where X points
0294 fd15 08                         INX             ; Point X at next byte
0295 fd16 20 f3                      BRA     LDOBYT  ; Go get next byte
0296 fd18 7c f0 da           LCHK    INC     T_CSUM  ; Add 1 to checksum
0297 fd1b 27 cb                      BEQ     LREAD   ; OK: Go read next record
0298 fd1d 8d 02                      BSR     PR_QM   ; Print "?"
0299 fd1f 20 29                      BRA     STARTR  ; Go to START
0300                         
0301 fd21 86 3f              PR_QM   LDAA #'?        ; Put '?' character in A
0302 fd23 7e fc 0f                   JMP     PR_A    ; Print it and return via PR_As RTS
0303                         
0304 fd26 01                         NOP
0305 fd27 01                         NOP
0306 fd28 01                         NOP
0307 fd29 01                         NOP
0308 fd2a 01                         NOP
0309                         
0310                         ; -----------------------------------------------------
0311                         ; Read byte from ACIA.A to A
0312                         ; FD2B
0313                         ; -----------------------------------------------------
0314 fd2b b6 f4 01           RD_A    LDAA    CTRLA   ; Get ACIA.A status byte
0315 fd2e 85 01                      BITA    #$01    ; Is byte ready in DATAA
0316 fd30 27 f9                      BEQ     RD_A    ; No: Try again
0317 fd32 7e fd cf                   JMP     PARITY  ; Need to clear parity as we
0318                                                 ; need to support 7E2 & 8N2
0319                         
0320 fd35 01                         NOP
0321                         
0322                         ; -----------------------------------------------------
0323                         ; FD36
0324                         ; -----------------------------------------------------
0325 fd36 8d 15              REGPRT  BSR     PRSP    ; Print a space
0326 fd38 fe f0 fd                   LDX     PSTACK  ; Point X at user's stack
0327 fd3b 8d 1c                      BSR     PR2     ; Print CC
0328 fd3d 8d 1a                      BSR     PR2     ; Print B
0329 fd3f 8d 18                      BSR     PR2     ; Print A
0330 fd41 8d 10                      BSR     PR4     ; Print X
0331 fd43 8d 0e                      BSR     PR4     ; Print PC
0332 fd45 ce f0 fd                   LDX     #PSTACK ; Point X at stack pointer
0333 fd48 8d 0a                      BSR     PR4X    ; Print stack pointer
0334 fd4a 7e ff 8f           STARTR  JMP     START  ; (RETURN) to MINIMON
0335                         
0336                         
0337                         ; -----------------------------------------------------
0338                         ; FD4D
0339                         ; -----------------------------------------------------
0340 fd4d 86 20              PRSP    LDAA    #$20    ; Put space character in A
0341 fd4f bd fc 0f                   JSR     PR_A    ; Print it
0342 fd52 39                         RTS             ; RETURN
0343 fd53 08                 PR4     INX             ; Point X to next character
0344 fd54 a6 00              PR4X    LDAA    0,X     ; Get byte pointed to by X
0345 fd56 bd fc c9                   JSR     ZOUT    ; Print it
0346 fd59 08                 PR2     INX             ; Point X to next character
0347 fd5a a6 00                      LDAA    0,X     ; Get byte pointed to by X
0348 fd5c bd fc c9                   JSR     ZOUT    ; Print it
0349 fd5f 8d ec                      BSR     PRSP    ; Print a space
0350 fd61 39                         RTS             ; RETURN
0351                         
0352                         ; -----------------------------------------------------
0353                         ; FD62
0354                         ; -----------------------------------------------------
0355 fd62 bd fc 89           MEMTEST JSR     GETADD      ; get the start and finish addresses
0356 fd65 bd fc 76                   JSR     STRING
0357 fd68 20 54 45 53 54 49          FCC     " TESTING..."
     4e 47 2e 2e 2e
0358 fd73 0d 0a ff                   FCB     $0D,$0A,$FF
0359 fd76 5f                         CLRB                ; set up accumulators
0360 fd77 37                 .TST    PSHB
0361 fd78 bd fc 76                   JSR     STRING
0362 fd7b 0d ff                      FCB     $0D,$FF
0363 fd7d 33                         PULB
0364 fd7e 17                         TBA
0365 fd7f bd fc c9                   JSR     ZOUT
0366 fd82 fe f0 ef                   LDX     T_STRT      ; put start address in X
0367 fd85 4f                         CLRA
0368 fd86 1b                 .LOOP1  ABA                 ; create the pattern
0369 fd87 a7 00                      STAA    0,X         ; Write to memory
0370 fd89 08                         INX
0371 fd8a bc f0 f1                   CPX     T_STOP      ; Check for end of memory
0372 fd8d 26 f7                      BNE     .LOOP1
0373 fd8f fe f0 ef                   LDX     T_STRT
0374 fd92 4f                         CLRA
0375 fd93 1b                 .LOOP2  ABA
0376 fd94 a1 00                      CMPA     0,X        ; Read from memory
0377 fd96 26 1d                      BNE     .FAULT
0378 fd98 08                 .NOPR   INX
0379 fd99 bc f0 f1                   CPX     T_STOP
0380 fd9c 26 f5                      BNE     .LOOP2
0381 fd9e b6 f4 01                   LDAA    CTRLA       ; Read ACIA status
0382 fda1 85 01                      BITA    #$01        ; Key waiting?
0383 fda3 26 03                      BNE     .END        ; Yes so end the test
0384 fda5 5c                         INCB                ; change the pattern and repeat
0385 fda6 26 cf                      BNE     .TST        ; we loop the test 256 times
0386 fda8 b6 f4 00           .END    LDAA    DATAA       ; Clear a byte from ACIA
0387 fdab bd fc 76                   JSR     STRING
0388 fdae 20 4f 4b                   FCC     " OK"
0389 fdb1 ff                         FCB     $FF
0390 fdb2 7e ff 8f                   JMP     START
0391 fdb5 bd fe 97           .FAULT  JSR     NEWLINE
0392 fdb8 bd fc 76                   JSR     STRING
0393 fdbb 20 46 4c 54                FCC     " FLT"
0394 fdbf ff                         FCB     $FF
0395 fdc0 7e ff 8f                   JMP START
0396                         
0397                         ; -----------------------------------------------------
0398                         ; FDC3
0399                         ; -----------------------------------------------------
0400 fdc3 bd fc 76           VERSION JSR     STRING
0401 fdc6 20 31 2e 30 30             FCC     " 1.00" ;
0402 fdcb ff                         FCB     $FF
0403 fdcc 7e ff 8f                   JMP     START
0404                         
0405 fdcf b6 f4 00           PARITY  LDAA    DATAA   ; Get the data byte to A
0406 fdd2 84 7f                      ANDA    #$7F    ; Mask off parity bit if it exists
0407 fdd4 39                         RTS             ; RETURN
0408                         
0409 fdd5 01                         NOP
0410                         
0411                         ; -----------------------------------------------------
0412                         ; FDD6
0413                         ; -----------------------------------------------------
0414 fdd6 ce f0 e6           SUB     LDX     #T_X    ; Point X to start of T_X data
0415 fdd9 a6 01                      LDAA    1,X     ; A = T_X (low)
0416 fddb e6 00                      LDAB    0,X     ; B = T_X (high)
0417 fddd a0 03                      SUBA    3,X     ; A = A - T_Y (low)
0418 fddf e2 02                      SBCB    2,X     ; B = B - T_Y (high)
0419 fde1 39                         RTS             ; RETURN
0420                         
0421                         ; -----------------------------------------------------
0422                         ; S format data output : Modded version of Mikbug code
0423                         ; -----------------------------------------------------
0424 fde2 bd fc 89           PUNCH   JSR     GETADD      ; Prompt for "Start:","Stop:"
0425 fde5 fe f0 ef                   LDX     T_STRT      ; Get start address
0426 fde8 ff f0 d8                   STX     T_TW        ; save it to work area
0427 fdeb b6 f0 f2           POUT1   LDAA    T_STOP+1    ; get low order of end address
0428 fdee b0 f0 d9                   SUBA    T_TW+1      ; Subtract low order start
0429 fdf1 f6 f0 f1                   LDAB    T_STOP      ; ( carry not affected by LDA )
0430 fdf4 f2 f0 d8                   SBCB    T_TW        ; Subtract with Carry
0431 fdf7 26 04                      BNE     POUT2
0432 fdf9 81 10                      CMPA    #16
0433 fdfb 25 02                      BCS     POUT3
0434 fdfd 86 0f              POUT2   LDAA    #15
0435 fdff 8b 04              POUT3   ADDA    #4
0436 fe01 b7 f0 db                   STAA    T_COUNT     ; FRAME COUNT THIS RECORD
0437 fe04 80 03                      SUBA    #3
0438 fe06 b7 f0 dc                   STAA    T_TEMP      ; BYTE COUNT THIS RECORD
0439 fe09 bd fc 76                   JSR     STRING      ; Output this string...
0440 fe0c 0d 0a                      FCB     $0D,$0A     ; c/r l/f
0441 fe0e 53 31                      FCB     'S,'1       ; S1
0442 fe10 ff                         FCB     $FF         ; End-Of-String
0443 fe11 5f                         CLRB                ; Clear checksum
0444                         
0445                         ; Output frame count...
0446 fe12 ce f0 db                   LDX     #T_COUNT    ; X = Address of Framecount
0447 fe15 bd fe a8                   JSR     POUTH2      ; O/P byte <-X and inc X
0448                         
0449                         ; Output address...
0450 fe18 ce f0 d8                   LDX     #T_TW
0451 fe1b bd fe a8                   JSR     POUTH2      ; O/P byte <-X and inc X
0452 fe1e bd fe a8                   JSR     POUTH2      ; O/P byte <-X and inc X
0453                         
0454                         ; Output data...
0455 fe21 fe f0 d8                   LDX     T_TW
0456 fe24 bd fe a8           POUT4   JSR     POUTH2      ; O/P byte <-X and inc X
0457 fe27 7a f0 dc                   DEC     T_TEMP      ; Decrement `bytes left` count
0458 fe2a 26 f8                      BNE     POUT4       ; Loop back if any left
0459 fe2c ff f0 d8                   STX     T_TW
0460 fe2f 53                         COMB
0461 fe30 37                         PSHB
0462 fe31 30                         TSX                ; X = S + 1
0463 fe32 8d 74                      BSR     POUTH2     ; PUNCH CHECKSUM
0464 fe34 33                         PULB
0465 fe35 fe f0 d8                   LDX     T_TW
0466 fe38 09                         DEX
0467 fe39 bc f0 f1                   CPX     T_STOP
0468 fe3c 26 ad                      BNE     POUT1
0469 fe3e 7e ff d9                   JMP     STERMS
0470                         
0471 fe41 01                         NOP
0472 fe42 01                         NOP
0473                         
0474                         ; -----------------------------------------------------
0475                         ; FE43
0476                         ; -----------------------------------------------------
0477 fe43 bd fc 65           MODIFY  JSR     RD_X    ; Get address to X
0478 fe46 bd fd 4d           STRT    JSR     PRSP    ; Print a space
0479 fe49 7f f0 f5                   CLR     T_R     ; T_R = 0
0480 fe4c a6 00              PRz     LDAA    0,X     ; Get byte pointed to by X to A
0481 fe4e bd fc c9                   JSR     ZOUT    ; Print it as 2.hex digits
0482 fe51 bd fc 00           WATSIT  JSR     RD_CMD  ; Get command character
0483 fe54 81 20              WHAT    CMPA    #$20    ; Is it a space ?
0484 fe56 26 0c                      BNE     ISSLSH  ; No: go test for slash
0485 fe58 08                 CARYON  INX             ; Increment X
0486 fe59 b6 f0 f5                   LDAA    T_R     ; A = T_R
0487 fe5c 81 16                      CMPA    #$16    ; At end of line ?
0488 fe5e 2f ec                      BLE     PRz     ; No: Loop back to continue
0489 fe60 8d 35              NEW_1   BSR     NEWLINE ; Print c/r l/f nul
0490 fe62 20 e2                      BRA     STRT    ; Loop back (Note: Hex was wrong in doc, E2 instead of E5)
0491                         
0492 fe64 81 2f              ISSLSH  CMPA    #'/     ; Is it a slash ?
0493 fe66 26 03                      BNE     ISCRET  ; No: go test for c/r
0494 fe68 09                         DEX             ; X = X - 1
0495 fe69 20 f5                      BRA     NEW_1   ; Loop back (print newline)
0496                         
0497 fe6b 81 0d              ISCRET  CMPA    #$0D    ; Is it a c/r ?
0498 fe6d 26 03                      BNE     ISHEX   ; No: go test for valid Hex
0499 fe6f 08                         INX             ; X = X + 1
0500 fe70 20 ee                      BRA     NEW_1   ; Loop back (print newline)
0501                         
0502 fe72 bd fc 1d           ISHEX   JSR     VHEX    ; Is it a valid hex character ?
0503 fe75 25 19                      BCS     PRQM    ; No: print `?` and ignore
0504 fe77 b7 f0 f6                   STAA    T_Q     ; T_Q = A : Save it
0505 fe7a bd fc 00                   JSR     RD_CMD  ; Get 2nd character
0506 fe7d bd fc 1d                   JSR     VHEX    ; Is it a valid hex character ?
0507 fe80 25 d2                      BCS     WHAT    ; No: then see what it is
0508 fe82 16                         TAB             ; B = A
0509 fe83 b6 f0 f6                   LDAA    T_Q     ; A = T_Q
0510 fe86 bd fc 31                   JSR     BINARY  ; Convert to binary value
0511 fe89 a7 00                      STAA    0,X     ; Store it
0512 fe8b bd fd 4d                   JSR     PRSP    ; Print a space
0513 fe8e 20 c8                      BRA     CARYON  ; Loop back
0514                         
0515 fe90 86 3f              PRQM    LDAA    #'?     ; Put `?` into A
0516 fe92 bd fc 0f                   JSR     PR_A    ; Print it
0517 fe95 20 ba                      BRA     WATSIT  ; Loop back
0518                         
0519 fe97 ff f0 e3           NEWLINE STX     T_SAVE  ; Save X
0520 fe9a bd fc 76                   JSR     STRING  ; Print string...
0521 fe9d 0d 0a 00                   FCB     $0D,$0A,$00
0522 fea0 ff                         FCB     $FF     ; End-of-string
0523 fea1 fe f0 e3                   LDX     T_SAVE  ; Restore X
0524 fea4 bd fc bb                   JSR     PRX     ; Print X
0525 fea7 39                         RTS             ; RETURN
0526                         
0527 fea8 eb 00              POUTH2 ADDB    0,X      ; Update checksum
0528 feaa 36                         PSHA            ; Push A to STACK
0529 feab a6 00                      LDAA    0,X     ; Load byte to be o/p
0530 fead bd fc c9                   JSR     ZOUT    ; O/P byte <- X
0531 feb0 32                         PULA            ; Pull A off STACK
0532 feb1 08                         INX             ; Increment X
0533 feb2 39                         RTS             ; RETURN
0534                         
0535                         ; Processes the termination record which, if we get here is an S9 record
0536                         ; A will contain the umber of bytes to follow (should be 39h i.e. ASCII '9')
0537                         ; which means there are left to absorb.
0538 feb3 ce 00 08           STERMR  LDX     #8      ; get the number of bytes left in record
0539 feb6 bd fc 00           STERM1  JSR     RD_CMD  ; read and echo from ACIA and ignore
0540 feb9 09                         DEX
0541 feba 26 fa                      BNE     STERM1   ; loop for remaining bytes
0542 febc 7e ff 8f           STARTS  JMP     START
0543                         
0544 febf 01                         NOP
0545 fec0 01                         NOP
0546 fec1 01                         NOP
0547                         
0548                         ; -----------------------------------------------------
0549                         ; FEC2
0550                         ; -----------------------------------------------------
0551 fec2 bd fc 65           GO      JSR     RD_X    ; Get address to X (16.bit)
0552 fec5 bd fc 00                   JSR     RD_CMD  ; Right address ?
0553 fec8 b6 f0 f4                   LDAA    T_Z+1   ; T_Z.low to A
0554 fecb f6 f0 f3                   LDAB    T_Z     ; T_Z.high to B
0555 fece fe f0 fd           GOTO    LDX     PSTACK  ; Callers stack address to X
0556 fed1 a7 07                      STAA    7,X     ; Put new return
0557 fed3 e7 06                      STAB    6,X     ; address on stack
0558 fed5 be f0 fd                   LDS     PSTACK  ; Set up calling programs stack
0559 fed8 3b                         RTI             ; RETURN-FROM-INTERRUPT (SWI)
0560                         
0561                         ; -----------------------------------------------------
0562                         ; FED9
0563                         ; -----------------------------------------------------
0564 fed9 bd fc 00           CONTNU  JSR     RD_CMD  ; Read a byte (test for `.`)
0565 fedc 81 31                      CMPA    #'1     ; Is it `1` ?
0566 fede 26 10                      BNE     IsIt2  ; No: go test for `2`
0567 fee0 fe f0 f7                   LDX     T_ABYT  ; Get address of break.point
0568 fee3 b6 f0 fb                   LDAA    T_BYTE  ; Get saved opcode
0569 fee6 a7 00                      STAA    0,X     ; Put it back in the program
0570 fee8 b6 f0 f8                   LDAA    T_ABYT+1 ; Get address at which
0571 feeb f6 f0 f7                   LDAB    T_ABYT  ;   to re-enter program
0572 feee 20 de                      BRA     GOTO    ; Go to calling program
0573                         
0574 fef0 81 32              IsIt2   CMPA    #'2     ; Is it `2`
0575 fef2 27 03                      BEQ     G_Is2   ; Yes: go process it
0576 fef4 7e ff 8f                   JMP     START   ; No: Return to MINIMON
0577 fef7 fe f0 f9           G_Is2   LDX     T_ABYT+2 ; Get addr. of break.point 2
0578 fefa b6 f0 fc                   LDAA    T_BYTE+1 ; Get old opcode
0579 fefd a7 00                      STAA    0,X      ; Put it back
0580 feff b6 f0 fa                   LDAA    T_ABYT+3 ; Load address to start
0581 ff02 f6 f0 f9                   LDAB    T_ABYT+2 ;  running program at
0582 ff05 20 c7                      BRA     GOTO    ; Run user program
0583                         
0584                         ; -----------------------------------------------------
0585                         ; FF07
0586                         ; -----------------------------------------------------
0587 ff07 bd fc 89           DUMP    JSR     GETADD  ; Prompt for boundary addresses
0588 ff0a fe f0 ef                   LDX     T_STRT  ;
0589 ff0d bd fe 97           D_NEW   JSR     NEWLINE ; Print c/r l/f nul
0590 ff10 86 08                      LDAA    #$08    ;
0591 ff12 b7 f0 f6                   STAA    T_Q     ; T_Q = 8
0592 ff15 09                         DEX             ; X = X - 1
0593 ff16 08                 D_NXT   INX             ; X = X + 1
0594 ff17 bd fd 4d                   JSR     PRSP    ; Print a space
0595 ff1a a6 00                      LDAA    0,X     ; Get a byte
0596 ff1c bd fc c9                   JSR     ZOUT    ; Print it as 2.hex digits
0597 ff1f bc f0 f1                   CPX     T_STOP  ; Finished ?
0598 ff22 26 06                      BNE     D_CNT   ; No: Carry on
0599 ff24 b6 f4 00           D_END   LDAA    DATAA   ; Get a byte from ACIA (clear)
0600 ff27 7e ff 8f                   JMP     START   ; Return to MINIMON
0601 ff2a b6 f4 01           D_CNT   LDAA    CTRLA   ; Read ACIA status
0602 ff2d 85 01                      BITA    #$01    ; Stop dump ?
0603 ff2f 26 f3                      BNE     D_END   ; Yes; go clear ACIA etc
0604 ff31 7a f0 f6                   DEC     T_Q     ; New line needed ?
0605 ff34 26 e0                      BNE     D_NXT   ; No: Loop back
0606 ff36 08                         INX             ; Print next byte
0607 ff37 20 d4                      BRA     D_NEW   ;  on a new line
0608                         
0609                         ; -----------------------------------------------------
0610                         ; FF39
0611                         ; -----------------------------------------------------
0612 ff39 bd fc 00           BRPTSET JSR     RD_CMD  ; Read a byte (test for `.`)
0613 ff3c 81 31                      CMPA    #'1     ; Is it `1` ?
0614 ff3e 26 12                      BNE     Is2b    ; No: go test for `2`
0615 ff40 bd fc 65                   JSR     RD_X    ; Read addr value into X
0616 ff43 a6 00                      LDAA    0,X     ; Get the opcode
0617 ff45 b7 f0 fb                   STAA    T_BYTE  ; Save it
0618 ff48 ff f0 f7                   STX     T_ABYT  ; and the address
0619 ff4b 86 3f              SAME    LDAA    #$3F    ; `SWI` opcode :
0620 ff4d a7 00                      STAA    0,X     ;   set the breakpoint
0621 ff4f 7e ff 8f           ENDB    JMP     START   ; Return to MINIMON
0622 ff52 81 32              Is2b    CMPA    #'2     ; Is it `2` ?
0623 ff54 26 f9                      BNE     ENDB   ; No: Return to MINIMON
0624 ff56 bd fc 65                   JSR     RD_X    ; Read address into X
0625 ff59 a6 00                      LDAA    0,X     ; Get opcode
0626 ff5b b7 f0 fc                   STAA    T_BYTE+1 ; Save it
0627 ff5e ff f0 f9                   STX     T_ABYT+2 ; Save address
0628 ff61 20 e8                      BRA     SAME    ; Set the breakpoint
0629                         
