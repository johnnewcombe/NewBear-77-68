Hexadecimal [16-Bits]                                 Sun May 10 20:24:13 2026



                            310 ; -----------------------------------------------------
   0360 A6 00         [ 5]  311 STRINGBX:   LDAA    0,X         ; get char
   0362 81 FF         [ 2]  312             CMPA    #0xFF        ; is character NULL?
   0364 27 0F         [ 4]  313             BEQ     DONEB       ; yes, end of string
                            314             ;STAA   PANEL     ; REMOVED, too much activity
   0366 F6 F0 FF      [ 4]  315             LDAB    PANEL
   0369 C5 01         [ 2]  316             BITB    #1
   036B 27 03         [ 4]  317             BEQ     STRBX       ; panel switch 0 is debug and copies data to A
   036D BD FC 0F      [ 9]  318             JSR     PR_A        ; Print the byte to ACIA(a) (A is maintained)
   0370 8D 2F         [ 8]  319 STRBX:      BSR     PR_B        ; Print the byte to ACIA(b)
   0372 08            [ 4]  320             INX
   0373 20 EB         [ 4]  321             BRA     STRINGBX
   0375 39            [ 5]  322 DONEB:      RTS
                            323 
                            324 ; -----------------------------------------------------
                            325 ; Reads a character from ACIA(b) into A
                            326 ; -----------------------------------------------------
   0376 7C 1B A6      [ 6]  327 RD_B:    INC     RND         ; simple way to get a random number
   0379 B6 F4 03      [ 4]  328         LDAA    CTRLB       ; Get ACIA.A status byte
   037C 85 01         [ 2]  329         BITA    #01         ; Is byte ready in DATAb
   037E 27 F6         [ 4]  330         BEQ     RD_B        ; No: Try again
   0380 B6 F4 02      [ 4]  331         LDAA    DATAB       ; Get the data byte to A
   0383 84 7F         [ 2]  332         ANDA    #0x7F        ; Mask off parity bit if it exists
   0385 39            [ 5]  333         RTS                 ; RETURN
                            334 
                            335 ; -----------------------------------------------------
                            336 ;
                            337 ; -----------------------------------------------------
   0386 8D EE         [ 8]  338 ZINB:    BSR     RD_B    ; Read a character
   0388 BD FC 1D      [ 9]  339         JSR     VHEX    ; Is it a hex character ?
   038B 25 12         [ 4]  340         BCS     Z_PRQM  ; No: go to print `?`
   038D B7 1B 99      [ 5]  341         STAA    T_Q     ; Yes: Save Acc.A
   0390 8D E4         [ 8]  342         BSR     RD_B    ; Read 2nd character
   0392 BD FC 1D      [ 9]  343         JSR     VHEX    ; Is it a hex character ?
   0395 25 08         [ 4]  344         BCS     Z_PRQM  ; No: go to print `?`
   0397 16            [ 2]  345         TAB             ; Yes: Put it into Acc.B
   0398 B6 1B 99      [ 4]  346         LDAA    T_Q     ; Retrieve 1st hex char to Acc.A
   039B BD FC 31      [ 9]  347         JSR     BINARY  ; Convert A:B to binary
   039E 39            [ 5]  348         RTS             ; RETURN
   039F                     349 Z_PRQM:  ;LDAA    #'?     ; Load `?` into A
                            350         ;BSR     PR_B    ; Print it
   039F 20 E5         [ 4]  351         BRA     ZINB    ; Go back to start of hex input
                            352 
                            353 
                            354 ; -----------------------------------------------------
                            355 ; Print character in A to ACIA(b)
                            356 ; -----------------------------------------------------
   03A1 F6 F4 03      [ 4]  357 PR_B:    LDAB    CTRLB   ; Get ACIA(a) status byte
   03A4 C5 02         [ 2]  358         BITB    #02     ; Is it busy ?
   03A6 27 F9         [ 4]  359         BEQ     PR_B    ; Yes: Try again
   03A8 B7 F4 02      [ 5]  360         STAA    DATAB   ;  No: Send data
   03AB 39            [ 5]  361 PRB_END: RTS             ; RETURN
                            362 
                            363 ; -----------------------------------------------------
                            364 ; Read 4 hex digits and put value into X
ASxxxx Assembler V05.50.5  (Motorola 6800/6802/6808)                    Page 8
Hexadecimal [16-Bits]                                 Sun May 10 20:24:13 2026



                            365 ; -----------------------------------------------------
   03AC 8D D8         [ 8]  366 RD_XB:   BSR     ZINB    ; Read 2 digit hex value into A
   03AE B7 1B 9A      [ 5]  367         STAA    T_Z     ; Save byte (most significant)
   03B1 8D D3         [ 8]  368         BSR     ZINB    ; Read 2 digit hex value into A
   03B3 B7 1B 9B      [ 5]  369         STAA    T_Z+1   ; Save byte (least significant)
   03B6 FE 1B 9A      [ 5]  370         LDX     T_Z     ; Load full 4 hex value into X
   03B9 39            [ 5]  371         RTS             ; RETURN
                            372 
                            373 ; -----------------------------------------------------
                            374 ; Adds A to X and leaves the result in X, A is
                            375 ; preserved.
                            376 ; -----------------------------------------------------
   03BA 36            [ 4]  377 ADX:     PSHA
   03BB FF 1B A4      [ 6]  378         STX     T_TMP
   03BE BB 1B A5      [ 4]  379         ADDA    T_TMP+1   ; add A to low byte
   03C1 B7 1B A5      [ 5]  380         STAA    T_TMP+1
   03C4 B6 1B A4      [ 4]  381         LDAA    T_TMP     ; get high byte
   03C7 89 00         [ 2]  382         ADCA    #0      ; add carry only
   03C9 B7 1B A4      [ 5]  383         STAA    T_TMP
   03CC FE 1B A4      [ 5]  384         LDX     T_TMP
   03CF 32            [ 4]  385         PULA
   03D0 39            [ 5]  386         RTS
                            387 
                            388 ; -----------------------------------------------------
                            389 ; Loads X with A, A is preserved.
                            390 ; -----------------------------------------------------
   03D1 B7 1B A5      [ 5]  391 TAX:    STAA    T_TMP+1       ; store A as low byte of X
   03D4 7F 1B A4      [ 6]  392         CLR     T_TMP         ; zero the high byte
   03D7 FE 1B A4      [ 5]  393         LDX     T_TMP         ; load X
   03DA 39            [ 5]  394         RTS
                            395 
                            396 ; -----------------------------------------------------
                            397 ; Prints the message " n stones n pounds"
                            398 ; place stones in MSB of X and pound in LSB
                            399 ; -----------------------------------------------------
   03DB                     400 PR_WEIGHT:
                            401 
   03DB FF 1B A2      [ 6]  402         STX     T_W
   03DE B6 1B A2      [ 4]  403         LDAA    T_W
   03E1 BD 03 D1      [ 9]  404         JSR     TAX
   03E4 BD 04 5D      [ 9]  405         JSR     PR_WORD         ; n
   03E7 BD 04 09      [ 9]  406         JSR     PR_SPCB
   03EA CE 01 2B      [ 3]  407         LDX     #STONES
   03ED BD 04 5D      [ 9]  408         JSR     PR_WORD         ; "stones"
   03F0 BD 04 09      [ 9]  409         JSR     PR_SPCB
   03F3 B6 1B A3      [ 4]  410         LDAA    T_W+1            ; Load high byte of X into Accumulator A
   03F6 BD 03 D1      [ 9]  411         JSR     TAX
   03F9 BD 04 5D      [ 9]  412         JSR     PR_WORD         ; n
   03FC CE 00 F5      [ 3]  413         LDX     #POUNDS
   03FF BD 04 09      [ 9]  414         JSR     PR_SPCB
   0402 BD 04 5D      [ 9]  415         JSR     PR_WORD         ; "pounds"
   0405 BD 04 14      [ 9]  416         JSR     PR_CRB
   0408 39            [ 5]  417         RTS
                            418 
                            419 ; -----------------------------------------------------
ASxxxx Assembler V05.50.5  (Motorola 6800/6802/6808)                    Page 9
Hexadecimal [16-Bits]                                 Sun May 10 20:24:13 2026



                            420 ; Prints a space on both consoles (preserves A)
                            421 ; -----------------------------------------------------
   0409 36            [ 4]  422 PR_SPCB: PSHA
   040A 86 20         [ 2]  423         LDAA    #0x20        ; Put space character in A
   040C BD FC 0F      [ 9]  424         JSR     PR_A
   040F BD 03 A1      [ 9]  425         JSR     PR_B        ; Print it
   0412 32            [ 4]  426         PULA
   0413 39            [ 5]  427         RTS                 ; RETURN
                            428 
                            429 ; -----------------------------------------------------
                            430 ; Prints a CRLF on both consoles (preserves A)
                            431 ; -----------------------------------------------------
   0414 36            [ 4]  432 PR_CRB:     PSHA
   0415 86 0D         [ 2]  433             LDAA    #0x0D        ; Put CHAR character in A
   0417 BD FC 0F      [ 9]  434             JSR     PR_A
   041A BD 03 A1      [ 9]  435             JSR     PR_B        ; Print it
   041D 86 0A         [ 2]  436             LDAA    #0x0A
   041F F6 F0 FF      [ 4]  437             LDAB     PANEL
   0422 C5 01         [ 2]  438             BITB    #1
   0424 27 03         [ 4]  439             BEQ     PR_CRB1
   0426 BD FC 0F      [ 9]  440             JSR     PR_A
   0429 BD 03 A1      [ 9]  441 PR_CRB1:    JSR     PR_B        ; Print it
   042C 32            [ 4]  442             PULA
   042D 39            [ 5]  443             RTS                 ; RETURN
                            444 
                            445 ; -----------------------------------------------------
                            446 ; Prints a CR/LF to ACIA(a) A is preserved
                            447 ; -----------------------------------------------------
   042E 36            [ 4]  448 PR_CR:     PSHA
   042F 86 0D         [ 2]  449             LDAA    #0x0D        ; Put CHAR character in A
   0431 BD FC 0F      [ 9]  450             JSR     PR_A
   0434 86 0A         [ 2]  451             LDAA    #0x0A
   0436 BD FC 0F      [ 9]  452             JSR     PR_A
   0439 32            [ 4]  453 PR_CR1:    PULA
   043A 39            [ 5]  454             RTS                 ; RETURN
                            455 
                            456 ; -----------------------------------------------------
                            457 ; Outputs a phrase from the memory location in X
                            458 ; -----------------------------------------------------
   043B                     459 PR_PHRASE:
                            460 
   043B A6 00         [ 5]  461 PR_PH1:  LDAA    0,X         ; get high byte of word
   043D E6 01         [ 5]  462         LDAB    1,X         ; get low byte
   043F 81 FF         [ 2]  463         CMPA    #0xFF        ; check high byte
   0441 27 19         [ 4]  464         BEQ     PR_PH2      ; high byte is 0xFF so we're done
   0443 FF 1B 9E      [ 6]  465 PR_PH3:  STX     T_Y         ; save table pointer
   0446 B7 1B A0      [ 5]  466         STAA    T_P
   0449 F7 1B A1      [ 5]  467         STAB    T_P+1
   044C FE 1B A0      [ 5]  468         LDX     T_P         ; X now points to the word
   044F BD 04 5D      [ 9]  469         JSR     PR_WORD
   0452 BD 04 09      [ 9]  470         JSR     PR_SPCB
   0455 FE 1B 9E      [ 5]  471         LDX     T_Y         ; restore table pointer
   0458 08            [ 4]  472         INX                 ; move to next entry
   0459 08            [ 4]  473         INX                 ; (2 bytes per entry)
   045A 20 DF         [ 4]  474         BRA     PR_PH1
ASxxxx Assembler V05.50.5  (Motorola 6800/6802/6808)                   Page 10
Hexadecimal [16-Bits]                                 Sun May 10 20:24:13 2026



   045C 39            [ 5]  475 PR_PH2:  RTS
                            476 
                            477 ; -----------------------------------------------------
                            478 ; Outputs a word based on value in X
                            479 ; -----------------------------------------------------
   045D                     480 PR_WORD:
   045D FF 1B 9C      [ 6]  481             STX     T_X             ; use ASL and ROL to multiply by 2 (pointer is 2 bytes wide)
   0460 78 1B 9D      [ 6]  482             ASL     T_X+1           ; shift low byte left, bit 7 goes to carry
   0463 79 1B 9C      [ 6]  483             ROL     T_X             ; rotate high byte left, carry in from low byte
   0466 FE 1B 9C      [ 5]  484             LDX     T_X
   0469 FF 1B 9C      [ 6]  485             STX     T_X             ; Stash X
   046C B6 1B 9C      [ 4]  486             LDAA    T_X             ; High byte of X
   046F F6 1B 9D      [ 4]  487             LDAB    T_X+1           ; Low byte of X
   0472 CB 96         [ 2]  488             ADDB    #<WORDPTR    ; Add low byte of WORDPTR address
   0474 89 04         [ 2]  489             ADCA    #>WORDPTR    ; Add high byte of WORDPTR address + carry
   0476 B7 1B 9C      [ 5]  490             STAA    T_X             ; T_X has the address of the pointer NOT the word
   0479 F7 1B 9D      [ 5]  491             STAB    T_X+1
   047C FE 1B 9C      [ 5]  492             LDX     T_X             ; X has the address of the pointer NOT the word
                            493 
   047F A6 00         [ 5]  494             LDAA    0,X             ; get the hi byte of the word
   0481 B7 1B 9C      [ 5]  495             STAA    T_X
   0484 A6 01         [ 5]  496             LDAA    1,X             ; get the low byte of the word
   0486 B7 1B 9D      [ 5]  497             STAA    T_X+1
   0489 FE 1B 9C      [ 5]  498             LDX     T_X             ; X now has address of the word
   048C BD 03 60      [ 9]  499             JSR     STRINGBX        ; output the word
   048F 7C 1B B3      [ 6]  500             INC     SYLLABLES
   0492 BD FD 4D      [ 9]  501             JSR     PRSP
   0495 39            [ 5]  502             RTS
                            503 
