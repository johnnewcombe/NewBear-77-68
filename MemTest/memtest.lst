output:  memtest.s19
0001                         ;------------------------------------------------------------------
0002                         ; MemTest.asm
0003                         ; MemTest from MON1 documentation updated to run from F000.
0004                         ;
0005                         ; MINIMON is required.
0006                         ;
0007                         ; Load and run from F000, e.g.
0008                         ;
0009                         ;
0010                         ; MINIMON Variables
0011 f0ef                    T_STRT  EQU $F0EF ; Temp storage for GETADDRESS
0012 f0f1                    T_STOP  EQU $F0F1 ; Temp storage for GETADDRESS
0013                         
0014                         ; 7768 ACIA(a)
0015 f401                    CTRLA   EQU $F401 ; ACIA.A Ctrl/Status
0016 f400                    DATAA   EQU $F400 ; ACIA.A Data register
0017                         
0018                         ; MINIMON routines
0019 fc76                    STRING  EQU $FC76 ; Prints a string. The string should follow JSR and be terminated with $FF.
0020 fc89                    GETADD  EQU $FC89 ; Get Address, read 4 digit hex value.
0021 fcc9                    ZOUT    EQU $FCC9 ; Print value in A as 2 hex digits.
0022 fe97                    NEWLINE EQU $FE97 ; Prints a new line.
0023 ff8f                    START   EQU $FF8F ; Restarts MniMon.
0024                         
0025 f000                    	    ORG $F000
0026                         
0027 f000 bd fc 76           MEMTEST JSR     STRING
0028 f003 4d 45 4d 54 45 53          FCC     "MEMTEST"
     54
0029 f00a 0d 0a ff                   FCB     $0D, $0A,$FF
0030 f00d bd fc 89                   JSR     GETADD      ; get the start and finish addresses
0031 f010 bd fc 76                   JSR     STRING
0032 f013 20 54 45 53 54 49          FCC     " TESTING..."
     4e 47 2e 2e 2e
0033 f01e ff                         FCB     $FF
0034                         
0035 f01f fe f0 ef           .TST    LDX     T_STRT      ; put start address in X
0036 f022 4f                         CLRA
0037 f023 1b                 .LOOP1  ABA                 ; create the pattern
0038 f024 a7 00                      STAA    0,X         ; Write to memory
0039 f026 08                         INX
0040 f027 bc f0 f1                   CPX     T_STOP      ; Check for end of memory
0041 f02a 26 f7                      BNE     .LOOP1
0042 f02c fe f0 ef                   LDX     T_STRT
0043 f02f 4f                         CLRA
0044 f030 1b                 .LOOP2  ABA
0045 f031 a1 00                      CMPA     0,X        ; Read from memory
0046 f033 26 1d                      BNE     .FAULT
0047 f035 08                 .NOPR   INX
0048 f036 bc f0 f1                   CPX     T_STOP
0049 f039 26 f5                      BNE     .LOOP2
0050 f03b b6 f4 01                   LDAA    CTRLA       ; Read ACIA status
0051 f03e 85 01                      BITA    #$01        ; Key waiting?
0052 f040 26 03                      BNE     .END        ; Yes so end the test
0053 f042 5c                         INCB                ; change the pattern and repeat
0054 f043 26 da                      BNE     .TST        ; we loop the test 256 times
0055 f045 b6 f4 00           .END    LDAA    DATAA       ; Clear a byte from ACIA
0056 f048 bd fc 76                   JSR     STRING
0057 f04b 20 4f 4b                   FCC     " OK"
0058 f04e ff                         FCB     $FF
0059 f04f 7e ff 8f                   JMP     START
0060 f052 bd fe 97           .FAULT  JSR     NEWLINE
0061 f055 bd fc 76                   JSR     STRING
0062 f058 20 46 4c 54                FCC     " FLT"
0063 f05c ff                         FCB     $FF
0064 f05d 7e ff 8f                   JMP     START
