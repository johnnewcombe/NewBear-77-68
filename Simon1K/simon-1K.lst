0684                         ; -----------------------------------------------------
0685                         ; Convert value in A to 2 x ASCII hex digits in A and B
0686                         ; X unchanged
0687                         
0688 fe54 16                 BIN2HEX     TAB                 ; Copy A to B
0689 fe55 8d 09                          BSR     .bxNibble   ; Convert B.nibble to hex in A
0690 fe57 36                             PSHA                ; Push A as B result to STACK
0691 fe58 17                             TBA                 ; Get original back to A from B
0692 fe59 33                             PULB                ; Pop B result from Stack
0693 fe5a 44                             LSRA                ; Shift A
0694 fe5b 44                             LSRA                ;  Right
0695 fe5c 44                             LSRA                ;   4
0696 fe5d 44                             LSRA                ;    bits
0697 fe5e 20 00                          BRA     .bxNibble   ; Convert A.nibble to hex in A
0698                         ;..dummy..  RTS                 ; BRA used instead of BSR (above)
0699                         
0700                         ; - - - - - - - - - - - - - - - - - - - - - - - - -
0701                         ; Convert value in low 4.bits of A to Hex char in A
0702                         
0703 fe60 84 0f              .bxNibble   ANDA    #$0F        ; Clear high order bits
0704 fe62 81 09                          CMPA    #$09        ; Letter or number ?
0705 fe64 22 03                          BHI     .bxAscHi    ;
0706 fe66 8b 30                          ADDA    #$30        ; Make it an ASCII number
0707 fe68 39                             RTS                 ; RETURN
0708 fe69 8b 37              .bxAscHi    ADDA    #$37        ; Make it an ASCI letter
0709 fe6b 39                             RTS                 ; RETURN
0710                         
0711                         
0712                         ; -----------------------------------------------------
0713                         ; Print string FOLLOWING JSR/BSR ( terminated by a C_EOS )
0714                         ;  IE: It starts at the `return addr` put onto the stack by JSR
0715                         ;  So actual return address needed is past the string
0716                         ;  It is popped off the stack, and the new one pushed on
0717                         ;  before RTS
0718                         ;  A,B and X are PRESERVED
0719                         ;
0720 fe6c ff f0 1b           PR_STR_JSR  STX     d_PrStrX    ; Save X
0721 fe6f b7 f0 26                       STAA    b_PrStrA    ; Save A
0722 fe72 30                             TSX                 ; Get addr of return to X (X=S+1)
0723 fe73 20 0e                          BRA     PR_STR_cmn  ; Go to common print string code
0724                         
0725                         ;- - - - - - - - - - - - - - - - - - - - - - - - - - - - -
0726                         ; As PR_STR_JSR, but using stack as set when called via SWI
0727                         ; Note: We have to take account of, and ignore, the last 2 bytes
0728                         ;       on the stack from the JSR which got us here
0729                         ;
0730 fe75 ff f0 1b           PR_STR_SWI  STX     d_PrStrX    ; Save X
0731 fe78 b7 f0 26                       STAA    b_PrStrA    ; Save A
0732 fe7b 30                             TSX                 ; Get addr of return to X (X=S+1)
0733 fe7c 08                             INX                 ; 1: Move pointer
0734 fe7d 08                             INX                 ; 2:  7 bytes
0735 fe7e 08                             INX                 ; 3:   up
0736 fe7f 08                             INX                 ; 4:    the
0737 fe80 08                             INX                 ; 5:     `stack`
0738 fe81 08                             INX                 ; 6:      to get to
0739 fe82 08                             INX                 ; 7:       SWI return address
0740                         
0741 fe83 ff f0 1f           PR_STR_cmn  STX     d_PrStrRAD  ; Save Retrun Address pointer
0742 fe86 ee 00                          LDX     0,X         ; Get return addr to X
0743 fe88 8d 18                          BSR     PR_FROM_X   ; Print string, addr in X
0744                         
0745 fe8a 08                             INX                 ; X = return address
0746 fe8b ff f0 19                       STX     d_PrStrR    ; Put it back on stack, so RTI returns to right place...
0747                         
0748 fe8e fe f0 1f                       LDX     d_PrStrRAD  ; Get address of return address
0749 fe91 b6 f0 19                       LDAA    b_PrStrRhi  ; Get high byte of return address
0750 fe94 a7 00                          STAA    0,X         ; Put back Pc High byte into stack
0751 fe96 b6 f0 1a                       LDAA    b_PrStrRlo  ; Get low byte of return address
0752 fe99 a7 01                          STAA    1,X         ; Put back Pc Low byte into stack
0753                         
0754 fe9b b6 f0 26                       LDAA    b_PrStrA    ; Retrieve original A at entry
0755 fe9e fe f0 1b                       LDX     d_PrStrX    ; Retrieve original X at entry
0756 fea1 39                             RTS                 ; RETURN to addr on stack
0757                         
0758                         ; - - - - - - - - - - - - - - - - - - - - - - - - - - - -
0759                         ; Print string pointed to by X
0760                         ; At end, X points to the string terminator byte
0761 fea2                    PR_FROM_X   EQU     *
0762 fea2 36                             PSHA                ; Preserve A on STACK
0763 fea3 a6 00              .prNext     LDAA    0,X         ; Get byte to be printed
0764 fea5 81 07                          CMPA    #C_ASC_low  ; less than lowest val allowed
0765 fea7 2d 06                          BLT     .prx_rts    ; Yes: Go to finish up
0766 fea9 bd fc e3                       JSR     PR_BYTE     ; Print the byte
0767 feac 08                             INX                 ; Point to next byte
0768 fead 20 f4                          BRA     .prNext     ; Go back for next byte
0769 feaf 32                 .prx_rts    PULA                ; Restore A from STACK
0770 feb0 39                             RTS                 ; RETURN to addr on stack
0771                         
0772                         ; -----------------------------------------------------
0773                         ; Print char from A the number of times held in B
0774 feb1 37                 PR_REPEAT   PSHB                ; Push B to stack
0775 feb2 5c                             INCB                ; Add one to count
0776 feb3 5a                 .prr_loop   DECB                ; subtract one fom count
0777 feb4 2f 05                          BLE     .prr_end    ; If <=0 then finished
0778 feb6 bd fc e3                       JSR     PR_BYTE     ; Print from A
0779 feb9 20 f8                          BRA     .prr_loop   ; back for next one
0780 febb 33                 .prr_end    PULB                ; Restore B
0781 febc 39                             RTS                 ; RETURN
0782                         
0783                         ; -----------------------------------------------------
0784 febd bd fe 6c           PR_CRLF     JSR     PR_STR_JSR  ; Print string...
0785 fec0 0d 0a                          FCB     C_CR,C_LF   ; c/r l/f
0786 fec2 00                             FCB     C_EOS
0787 fec3 39                             RTS
0788                         
0789                         ; -----------------------------------------------------
0790                         ; SWI handler
0791                         ; - - - - - - - - - - - - - - - - - - - - - - - - - - -
0792                         ; Pushed on stack by SWI call:-
0793                         ;
0794                         ;  0: <-- data relative to stack pointer at SWI
0795                         ;  1: CC       <-- 0,X : After TSX, X points here
0796                         ;  2: B          = 1,X
0797                         ;  3: A          = 2,X
0798                         ;  4: X-high     = 3,X
0799                         ;  5: X-low      = 4,X
0800                         ;  6: PC-high    = 5,X
0801                         ;  7: PC-low     = 6,X
0802                         ; - - - - - - - - - - - - - - - - - - - - - - - - - - -
0803                         
0804 fec4                    Do_SWI  EQU     *           ; SWI Handling -- NOTE: uses CALLERS STACK, not SIMONs
0805                         ;...                        ; A value at call not saved as it is not changed
0806                         ;...                        ; before the call to the SIMON routine
0807                         ;...                        ; And A, B and X are all set to their values after
0808                         ;...                        ; that call before return to caller...
0809 fec4 7c f0 2b                   INC     b_RndCnt    ; Bump random number
0810 fec7 f7 f0 2c                   STAB    b_SwiTmp    ; Save B value at SWI call
0811 feca ff f0 33                   STX     d_SwiX      ; Save X value at SWI call
0812 fecd bf f0 31                   STS     d_SwiStk    ; Save the callers stack pointer
0813                         
0814                                                     ; Now get our function code from the byte after the
0815                                                     ; SWI instruction that got us here.  We use the PC
0816                                                     ; left on the stack for this, then incement it so
0817                                                     ; our eventual RTI will go back to the byte after
0818                                                     ; the function code...
0819 fed0 30                         TSX                 ; Copy stack pointer+1 to index register
0820                         
0821 fed1 ee 05                      LDX     5,X         ; Put content of address pointed to by X+5 (PC) to X
0822 fed3 e6 00                      LDAB    0,X         ; X now points to function code following SWI, load it into B
0823 fed5 f7 f0 2d                   STAB    b_SwiFunc   ; Store it
0824                         
0825 fed8 08                         INX                 ; Add one to callers PC to get past function code
0826 fed9 ff f0 35                   STX     d_SwiRet    ; Put it back on stack, so RTI returns to right place...
0827 fedc 30                         TSX                 ; Copy stack pointer+1 to index register
0828 fedd f6 f0 35                   LDAB    b_SwiRetHi  ;
0829 fee0 e7 05                      STAB    5,X         ; Put back Pc High byte into stack
0830 fee2 f6 f0 36                   LDAB    b_SwiRetLo  ;
0831 fee5 e7 06                      STAB    6,X         ; Put back Pc Low byte into stack
0832                         
0833 fee7 f6 f0 2d                   LDAB    b_SwiFunc   ; Get function code into B
0834 feea f1 ff 66                   CMPB    D_CNTV      ; Compare function code with call vector count
0835 feed 2c 2b                      BGE     .SwiEnd     ; Error, if too big (call IDs start at 0, hence BGE, not BGT)
0836                         
0837 feef 58                         ASLB                ; Shift B left, to multiply func code by 2
0838 fef0 ce ff 3a                   LDX     #D_LIST     ; Load X with start address of routine list
0839 fef3 ff f0 2f                   STX     d_SwiAddr   ; Store  it in RAM (modifiable JMP instruction)
0840 fef6 fb f0 30                   ADDB    b_SwiAdLo   ; Add low byte of address to value in B
0841 fef9 f7 f0 30                   STAB    b_SwiAdLo   ; Save it back to low byte of jump address
0842 fefc 24 03                      BCC     .Swi3       ; If CARRY BIT is set...
0843 fefe 7c f0 2f                   INC     b_SwiAdHi   ; add one to the high byte of the jump address
0844 ff01 c6 7e              .Swi3   LDAB    #$7E        ; Put JMP opcode into B
0845 ff03 f7 f0 2e                   STAB    b_SwiJMP    ; and write it to RAM
0846                         
0847 ff06 fe f0 2f                   LDX     d_SwiAddr   ; Get vector address for call
0848 ff09 ee 00                      LDX     0,X         ; Get actual routine address
0849 ff0b ff f0 2f                   STX     d_SwiAddr   ; Put it back, ready for JSR
0850                         
0851 ff0e f6 f0 2c           .SwiCmd LDAB    b_SwiTmp    ; Restore B to value at SWI call
0852 ff11 7f f0 2c                   CLR     b_SwiTmp    ; Clear ready to hold `C` bit on RTI
0853 ff14 fe f0 33                   LDX     d_SwiX      ; Restore X to value at SWI call
0854 ff17 bd f0 2e                   JSR     b_SwiJMP    ; JSR to required function, via JMP in RAM
0855                         ;       ...
0856                         ;       ...                 ; Return from SIMON function to `user` program
0857                         ;       ...
0858 ff1a                    .SwiEnd EQU     *           ; Tidy up and return to caller
0859 ff1a 24 03                      BCC     .SwiCC      ; Is C bit clear
0860 ff1c 7c f0 2c                   INC     b_SwiTmp    ; Set C bit in CCs
0861 ff1f ff f0 33           .SwiCC  STX     d_SwiX      ; Save X value set by our routine
0862 ff22 be f0 31                   LDS     d_SwiStk    ; Recover Stack pointer to state before function call
0863                                                     ; Replace A,B,X on stack with values from SIMON call
0864 ff25 30                         TSX                 ; Get Stack Ptr+1 to X
0865 ff26 e7 01                      STAB    1,X         ; Put B back on stack to go back to caller
0866 ff28 a7 02                      STAA    2,X         ;  and A
0867 ff2a b6 f0 2c                   LDAA    b_SwiTmp    ; Get our CCs containing C bit into A
0868 ff2d a7 00                      STAA    0,X         ;  and put back on stack
0869 ff2f b6 f0 33                   LDAA    b_SwiXhi    ; Get high byte of X returned by our routine
0870 ff32 a7 03                      STAA    3,X         ;   and put in into stack
0871 ff34 b6 f0 34                   LDAA    b_SwiXlo    ; Get low byte of X returned by our routine
0872 ff37 a7 04                      STAA    4,X         ;   and put in into stack
0873 ff39 3b                 Do_RTI  RTI                 ; RETURN FROM INTERRUPT
0874                         
0875                         ; - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
0876                                 ; SWI function call vectors
0877 ff3a                    D_LIST  EQU     *
0878 ff3a fc 4d                      FDB     ReSTART     ; $00 - Reset Monitor (& Stack)
0879 ff3c fc a5                      FDB     RD_BYTE     ; $01 - Get char into A from ACIA
0880 ff3e fc 8d                      FDB     RD_CMD      ; $02 - Get char, test for `.` + cycle LEDs
0881 ff40 fc dd                      FDB     RD_PR_BYTE  ; $03 - Get char into A from ACIA and output it
0882 ff42 fc e3                      FDB     PR_BYTE     ; $04 - Output char in A
0883 ff44 fe a2                      FDB     PR_FROM_X   ; $05 - Print string pointed to by X to (End=ANY <= $06)
0884 ff46 fe 75                      FDB     PR_STR_SWI  ; $06 - Print string following SWI $06
0885 ff48 fd 82                      FDB     RD_HEX2     ; $07 - Read 2hex char value into A
0886 ff4a fd a8                      FDB     RD_HEX4     ; $08 - Read 4hex char value into X
0887 ff4c fd f2                      FDB     PR_HEX2     ; $09 - O/P 2hex char value from A
0888 ff4e fd e2                      FDB     PR_HEX4     ; $0A - O/P 4hex char value from X
0889 ff50 fe 01                      FDB     PR_STK_SWI  ; $0B - Print data put on stack by SWI
0890 ff52 fe b1                      FDB     PR_REPEAT   ; $0C - Print char in A no. of times in B
0891 ff54 fd b9                      FDB     PR_SPACE    ; $0D - Print a space
0892 ff56 fd b6                      FDB     PR_AND_SP   ; $0E - Print char in A then a space
0893 ff58 fe bd                      FDB     PR_CRLF     ; $0F - Print c/r and l/f
0894 ff5a fc 00                      FDB     Do_RESET    ; $10 - Reset monitor HARD : Reset ACIAs
0895 ff5c ff 70                      FDB     RD_IFRDY    ; $11 - Read Kbd char if one is ready,else A=0
0896 ff5e ff 6c                      FDB     GET_RANDOM  ; $12 - Put pseudo random number into X
0897 ff60 ff 67                      FDB     GET_VERSION ; $13 - Return s/w version number in A & B
0898 ff62 fd d1                      FDB     ASK_Start   ; $14 - Prompt for Start:, value into X
0899 ff64 fd c1                      FDB     ASK_Stop    ; $15 - Prompt for Stop:, value into X
0900 ff66 16                 D_CNTV  FCB     *-D_LIST/2  ; Count of call vectors in 1 byte
0901                         
0902                         ;-
0903 00a3                    SZ_SWI  EQU     *-Do_SWI    ; Show size of SWI code
0904                         
0905                         ; ------------------------------------------------------------------
0906 ff67                    GET_VERSION EQU     *
0907 ff67 86 06                          LDAA    #C_VERSION
0908 ff69 c6 01                          LDAB    #C_SUBVER
0909 ff6b 39                             RTS
0910                         
0911                         ; ------------------------------------------------------------------
0912                         ; Fetch a pseudo random number into X
0913 ff6c                    GET_RANDOM  EQU     *
0914 ff6c fe f0 2a                       LDX     d_Random
0915 ff6f 39                             RTS
0916                         
0917                         ; ------------------------------------------------------------------
0918                         ; Test for a char waiting in ACIA...
0919                         ; If present return A=1, else A=0
0920 ff70                    RD_IFRDY    EQU     *
0921 ff70 ff f0 15                       STX     d_RdPrX     ; Save X
0922                         ;           ....                ; Check for keystroke...
0923 ff73 fe f0 00                       LDX     d_AciaGO    ; X = addr of current ACIA 
0924 ff76 a6 01                          LDAA    1,X         ; Get ACIA status byte
0925 ff78 47                             ASRA                ; Shift low order bit to C
0926 ff79 24 04                          BCC     .NoChr      ; C not set, no char waiting
0927 ff7b 86 01                          LDAA    #$01        ; A=1
0928 ff7d 20 01                          BRA     .GotChr     ; Done
0929 ff7f 4f                 .NoChr      CLRA                ; No char, so set A=0
0930 ff80 fe f0 15           .GotChr     LDX     d_RdPrX     ; Recover X
0931 ff83 39                             RTS                 ; RETURN
0932                         
0933                         
0934                         ; ------------------------------------------------------------------
0935                         ; COMMAND TABLE
0936                         ; ------------------------------------------------------------------
0937 ff84                    C_STRT      EQU     *
0938 ff84 47                             FCB     'G      ; G = Go = Jump to address
0939 ff85 ff 90                          FDB     CMD_G
0940 ff87 4c                             FCB     'L      ; L = Load S format
0941 ff88 fd 17                          FDB     CMD_L
0942 ff8a 4d                             FCB     'M      ; M = Modify
0943 ff8b ff 94                          FDB     CMD_M
0944 ff8d 53                             FCB     'S      ; S = Trap S19 loading (jump to Load routine)
0945 ff8e fd 1d                          FDB     CMD_S
0946 ff90                    C_END       EQU     *
0947                         
0948                         ; ------------------------------------------------------------------
0949                         ; G = Go to <addr>...
0950                         ; ------------------------------------------------------------------
0951 ff90                    CMD_G       EQU     *           ; G = GO : Jump to address
0952 ff90 3f                             SWI                 ; Call via SWI...
0953 ff91 14                             FCB     D_ASK_START ; Prompt for "Start:" (to X)
0954 ff92 6e 00                          JMP     0,X         ; Jump to it
0955                         
0956                         ; ------------------------------------------------------------------
0957                         ; Built-in `M` (Modify) command ...
0958                         ; ------------------------------------------------------------------
0959 ff94                    CMD_M       EQU     *           ; M = MODIFY
0960 ff94 3f                             SWI                 ; Call via SWI...
0961 ff95 14                             FCB     D_ASK_START ; Prompt for "Start:" (to X)
0962 ff96 3f                 .mStrt      SWI                 ; Call via SWI...
0963 ff97 0d                             FCB     D_PR_SPACE  ; to print a space
0964 ff98 7f f0 2a                       CLR     b_PrCnt     ; d_R = 0
0965 ff9b a6 00              .mNewC      LDAA    0,X         ; Get byte pointed to by X to A
0966 ff9d 3f                             SWI                 ; Call via SWI...
0967 ff9e 09                             FCB     D_PR_HEX2   ;  to print it as 2.hex digits
0968 ff9f 3f                 .mRead      SWI                 ; Call via SWI...
0969 ffa0 02                             FCB     D_RD_CMD    ;  to read byt, test for `.` etc
0970 ffa1 81 20              .mIsSP      CMPA    #$20        ; Is it a space ?
0971 ffa3 26 0c                          BNE     .mIsSL      ; No: go test for slash
0972 ffa5 08                 .mNext      INX                 ; Increment X
0973 ffa6 b6 f0 2a                       LDAA    b_PrCnt     ; A = b_PrCnt
0974 ffa9 81 16                          CMPA    #$16        ; At end of line ?
0975 ffab 2f ee                          BLE     .mNewC      ; No: Loop back to continue
0976 ffad 8d 31              .mNewL      BSR     M_BOL       ; Print c/r l/f XXXX
0977 ffaf 20 e5                          BRA     .mStrt      ; Loop back
0978                         
0979 ffb1 81 2f              .mIsSL      CMPA    #'/         ; Is it a slash ?
0980 ffb3 26 03                          BNE     .mIsCR      ; No: go test for c/r
0981 ffb5 09                             DEX                 ; X = X - 1
0982 ffb6 20 f5                          BRA     .mNewL      ; Loop back (print newline)
0983                         
0984 ffb8 81 0d              .mIsCR      CMPA    #C_CR       ; Is it a c/r ?
0985 ffba 26 03                          BNE     .mIsHx      ; No: go test for valid Hex
0986 ffbc 08                             INX                 ; X = X + 1
0987 ffbd 20 ee                          BRA     .mNewL      ; Loop back (print newline)
0988                         
0989 ffbf bd fd 4d           .mIsHx      JSR     VFY_HEX     ; Is it a valid hex character ?
0990 ffc2 25 17                          BCS     .mPrQM      ; No: print `?` and ignore
0991 ffc4 b7 f0 06                       STAA    b_Q         ; b_Q = A : Save it
0992 ffc7 3f                             SWI                 ; Call via SWI...
0993 ffc8 02                             FCB     D_RD_CMD    ; Get 2nd character
0994 ffc9 bd fd 4d                       JSR     VFY_HEX     ; Is it a valid hex character ?
0995 ffcc 25 d3                          BCS     .mIsSP      ; No: then see what it is
0996 ffce 16                             TAB                 ; B = A
0997 ffcf b6 f0 06                       LDAA    b_Q         ; A = b_Q
0998 ffd2 bd fd 6a                       JSR     HEX2BIN     ; Convert to binary value
0999 ffd5 a7 00                          STAA    0,X         ; Store it
1000 ffd7 3f                             SWI                 ; Call via SWI...
1001 ffd8 0d                             FCB     D_PR_SPACE  ; to print a space
1002 ffd9 20 ca                          BRA     .mNext      ; Loop back
1003                         
1004 ffdb bd fc e1           .mPrQM      JSR     PR_QM       ; Print "?"
1005 ffde 20 bf                          BRA     .mRead      ; Loop back
1006                         
1007                         ; - - - - - - - - - - - - - - - - - - - - - - - - -
1008                         ; Beginning Of Line
1009 ffe0                    M_BOL       EQU     *           ; print l/f c/r and X in hex
1010 ffe0 ff f0 11                       STX     d_BolX      ; Save X
1011 ffe3 3f                             SWI                 ; Call via SWI...
1012 ffe4 0f                             FCB     D_PR_CRLF   ; Print c/r  l/f
1013 ffe5 fe f0 11                       LDX     d_BolX      ; Restore X
1014 ffe8 7e fd e2                       JMP     PR_HEX4     ; Print X .. JMP instead of JSR
1015                         ;..dummy..  RTS                 ; RETURN  .. to save this RTS
