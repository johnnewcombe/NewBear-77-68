   0254 CE 11 BD      [ 3]  193         LDX     #LIGHTPTR       ; A has phrase ID, set X to the base address
   0257 BD 02 A1      [ 9]  194         JSR     PHRASE_OUT
   025A 7E 01 6B      [ 3]  195         JMP     MAINLOOP
