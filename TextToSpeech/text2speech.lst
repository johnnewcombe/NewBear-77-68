                            223 ; DECIMAL CONVERSION EXAMPLE
                            224 ;--------------------------------------------------------------
                            225         ;JSR     PR_DEC          ; puts 3 decimal digits in DEC, DEC+1 and DEC+2
                            226         ;LDAA    DEC+1           ; don't care about the hundreds        ADDA    #0x30
                            227         ;JSR     PR_WORD
                            228         ;JSR     PR_SPCB
                            229         ;LDAA    DEC+2
                            230         ;JSR     PR_WORD
                            231 
                            232 ; -----------------------------------------------------
                            233 ; PR_DEC: Puts 3 decimal digits in DEC, DEC+1 and DEC+2
                            234 ;
                            235 ;       !! ONLY WORKS WITH VALUES BELOW 128 !!
                            236 ; -----------------------------------------------------
   025D 5F            [ 2]  237 PR_DEC:  CLRB            ; Clear B for hundreds
                            238 
   025E 81 64         [ 2]  239 HUND:    CMPA    #100    ; 100 or more?
                            240 
   0260 2D 05         [ 4]  241         BLT     TENS
   0262 80 64         [ 2]  242         SUBA    #100    ; Sub 100
   0264 5C            [ 2]  243         INCB            ; Increment hundred counter
   0265 20 F7         [ 4]  244         BRA     HUND
                            245 
   0267 F7 19 4B      [ 5]  246 TENS:    STAB    DEC     ; store the hundreds
                            247 
   026A 5F            [ 2]  248         CLRB
   026B 81 0A         [ 2]  249 TENS1:   CMPA    #10     ; 10 or more?
   026D 2D 05         [ 4]  250         BLT     UNITS
   026F 80 0A         [ 2]  251         SUBA    #10     ; Sub 10
   0271 5C            [ 2]  252         INCB            ; Increment ten counter
   0272 20 F7         [ 4]  253         BRA     TENS1
                            254 
   0274 F7 19 4C      [ 5]  255 UNITS:   STAB    DEC+1
   0277 B7 19 4D      [ 5]  256         STAA    DEC+2   ; Final remainder is units
                            257 
   027A 39            [ 5]  258         RTS
                            259 
