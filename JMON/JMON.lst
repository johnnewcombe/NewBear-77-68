0655                         ; FF8F
0656                         ; -----------------------------------------------------
0657 ff8f 8e f0 d0           START   LDS     #STACK  ; Set up stack for MINMON
0658 ff92 8d 57                      BSR     SETACIA ; Set up ACIAs
0659 ff94 bd fc 76                   JSR     STRING  ; Print string...
0660 ff97 0d 0a 00 2a                FCB     $0D,$0A,$00,'*    ; c/r l/f null `*`
0661 ff9b ff                         FCB     $FF     ; End-of-string
0662 ff9c bd fc 00                   JSR     RD_CMD  ; Read a byte (test for `.`)
0663 ff9f ce ff b5                   LDX     #CMDTAB ; point to command table
0664 ffa2 e6 00              CMDLP   LDAB    0,X     ; B = key byte (0 ends table)
0665 ffa4 27 e9                      BEQ     START   ; end of table → default to START
0666 ffa6 11                         CBA             ; compare A vs B
0667 ffa7 27 05                      BEQ     FOUND   ; match → dispatch
0668 ffa9 08                         INX             ; skip key
0669 ffaa 08                         INX             ; skip FDB high
0670 ffab 08                         INX             ; skip FDB low
0671 ffac 20 f4                      BRA      CMDLP  ; try next entry
0672                         
0673 ffae e6 01              FOUND   LDAB    1,X     ; B = target high byte (FDB stores high,low)
0674 ffb0 a6 02                      LDAA    2,X     ; A = target low byte
0675 ffb2 36                         PSHA            ; push high first
0676 ffb3 37                         PSHB            ; push low — now low is on top of stack
0677 ffb4 39                         RTS             ; jump to target
0678                         
0679                         ; This can probably be removed...
0680                         ;.DEFAULT JMP     START ; unknown command → ignore
0681                         
0682                         ; Command table: key, then FDB routine
0683 ffb5 53                 CMDTAB  FCB     'S
0684 ffb6 ff 39                      FDB     BRPTSET
0685 ffb8 48                         FCB     'H
0686 ffb9 ff 63                      FDB     HEADER
0687 ffbb 50                         FCB     'P
0688 ffbc fd e2                      FDB     PUNCH
0689 ffbe 4c                         FCB     'L
0690 ffbf fc e3                      FDB     LOAD
0691 ffc1 52                         FCB     'R
0692 ffc2 fd 36                      FDB     REGPRT
0693 ffc4 4d                         FCB     'M
0694 ffc5 fe 43                      FDB     MODIFY
0695 ffc7 47                         FCB     'G
0696 ffc8 fe c2                      FDB     GO
0697 ffca 43                         FCB     'C
0698 ffcb fe d9                      FDB     CONTNU
0699 ffcd 44                         FCB     'D
0700 ffce ff 07                      FDB     DUMP
0701 ffd0 54                         FCB     'T'
0702 ffd1 fd 62                      FDB     MEMTEST
0703 ffd3 56                         FCB     'V'
0704 ffd4 fd c3                      FDB     VERSION
0705 ffd6 00                         FCB     0       ; terminator
0706 ffd7 ff 8f                      FDB     START   ; not used (any value ok after 0)
0707                         
0708                         ; Transmit an address '0000' S9 terminating record
0709 ffd9 bd fc 76           STERMS  JSR     STRING
0710 ffdc 0d 0a                      FCB     $0D,$0A
0711 ffde 53 39 30 33 30 30          FCC     "S9030000FC"
     30 30 46 43
0712 ffe8 ff                         FCB     $FF
0713 ffe9 20 a4                      BRA     START
0714                         
0715                         ; Reset the ACIAs
0716 ffeb 86 11              SETACIA LDAA    #$11    ; 8 Data, No Parity, 2 Stop Bits
0717 ffed b7 f4 01                   STAA    CTRLA   ;   ACIA.A
0718 fff0 86 01                      LDAA    #$01    ; 7 Data, Even Parity, 2 Stop Bits
0719 fff2 b7 f4 03                   STAA    CTRLB   ;   ACIA.B
0720 fff5 39                         RTS
0721                         
0722 fff6 01                         NOP
0723 fff7 01                         NOP
