0403                         ; -----------------------------------------------------
0404                         ; Outputs a phrase from the memory location in X
0405                         ; -----------------------------------------------------
0406                         PR_PHRASE
0407                         
0408 033c a6 00              PR_PH1  LDAA    0,X         ; get high byte of word
0409 033e e6 01                      LDAB    1,X         ; get low byte
0410 0340 81 ff                      CMPA    #$FF        ; check high byte
0411 0342 27 19                      BEQ     PR_PH2      ; high byte is $FF so we're done
0412 0344 ff 19 3a           PR_PH3  STX     T_Y         ; save table pointer
0413 0347 b7 19 3c                   STAA    T_P
0414 034a f7 19 3d                   STAB    T_P+1
0415 034d fe 19 3c                   LDX     T_P         ; X now points to the word
0416 0350 bd 03 5e                   JSR     PR_WORD
0417 0353 bd 03 1e                   JSR     PR_SPCB
0418 0356 fe 19 3a                   LDX     T_Y         ; restore table pointer
0419 0359 08                         INX                 ; move to next entry
0420 035a 08                         INX                 ; (2 bytes per entry)
0421 035b 20 df                      BRA     PR_PH1
0422 035d 39                 PR_PH2  RTS
0423                         
