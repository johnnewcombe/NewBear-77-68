0499 fe9a bd fc 76                   JSR     STRING  ; Print string...
0500 fe9d 0d 0a 00                   FCB     $0D,$0A,$00
0501 fea0 ff                         FCB     $FF     ; End-of-string
0502 fea1 fe f0 e3                   LDX     T_SAVE  ; Restore X
0503 fea4 bd fc bb                   JSR     PRX     ; Print X
0504 fea7 39                         RTS             ; RETURN
