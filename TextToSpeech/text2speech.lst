Hexadecimal [16-Bits]                                 Wed May  6 15:47:33 2026



                            314 
                            315 ; -----------------------------------------------------
                            316 ; Prints a string pointed to by X
                            317 ; -----------------------------------------------------
   0306 A6 00         [ 5]  318 STRINGBX:    LDAA    0,X         ; get char
   0308 81 FF         [ 2]  319             CMPA    #0xFF        ; is character NULL?
   030A 27 0B         [ 4]  320             BEQ     DONEB       ; yes, end of string
   030C B7 F0 FF      [ 5]  321             STAA     PANEL
   030F BD FC 0F      [ 9]  322             JSR     PR_A        ; Print the byte to ACIA(a) (A is maintained)
   0312 8D 2F         [ 8]  323             BSR     PR_B        ; Print the byte to ACIA(b)
   0314 08            [ 4]  324             INX
   0315 20 EF         [ 4]  325             BRA     STRINGBX
   0317 39            [ 5]  326 DONEB:      RTS
                            327 
                            328 ; -----------------------------------------------------
                            329 ; Reads a character from ACIA(b) into A
                            330 ; -----------------------------------------------------
   0318 7C 1A 05      [ 6]  331 RD_B:    INC     RND         ; simple way to get a random number
   031B B6 F4 03      [ 4]  332         LDAA    CTRLB       ; Get ACIA.A status byte
   031E 85 01         [ 2]  333         BITA    #01         ; Is byte ready in DATAb
   0320 27 F6         [ 4]  334         BEQ     RD_B        ; No: Try again
   0322 B6 F4 02      [ 4]  335         LDAA    DATAB       ; Get the data byte to A
   0325 84 7F         [ 2]  336         ANDA    #0x7F        ; Mask off parity bit if it exists
   0327 39            [ 5]  337         RTS                 ; RETURN
                            338 
                            339 ; -----------------------------------------------------
                            340 ;
                            341 ; -----------------------------------------------------
   0328 8D EE         [ 8]  342 ZINB:    BSR     RD_B    ; Read a character
   032A BD FC 1D      [ 9]  343         JSR     VHEX    ; Is it a hex character ?
   032D 25 12         [ 4]  344         BCS     Z_PRQM  ; No: go to print `?`
   032F B7 19 F5      [ 5]  345         STAA    T_Q     ; Yes: Save Acc.A
   0332 8D E4         [ 8]  346         BSR     RD_B    ; Read 2nd character
   0334 BD FC 1D      [ 9]  347         JSR     VHEX    ; Is it a hex character ?
   0337 25 08         [ 4]  348         BCS     Z_PRQM  ; No: go to print `?`
   0339 16            [ 2]  349         TAB             ; Yes: Put it into Acc.B
   033A B6 19 F5      [ 4]  350         LDAA    T_Q     ; Retrieve 1st hex char to Acc.A
   033D BD FC 31      [ 9]  351         JSR     BINARY  ; Convert A:B to binary
   0340 39            [ 5]  352         RTS             ; RETURN
   0341                     353 Z_PRQM:  ;LDAA    #'?     ; Load `?` into A
                            354         ;BSR     PR_B    ; Print it
   0341 20 E5         [ 4]  355         BRA     ZINB    ; Go back to start of hex input
                            356 
                            357 
                            358 ; -----------------------------------------------------
                            359 ; Print character in A to ACIA(b)
                            360 ; -----------------------------------------------------
   0343 F6 F4 03      [ 4]  361 PR_B:    LDAB    CTRLB   ; Get ACIA(a) status byte
   0346 C5 02         [ 2]  362         BITB    #02     ; Is it busy ?
   0348 27 F9         [ 4]  363         BEQ     PR_B    ; Yes: Try again
   034A B7 F4 02      [ 5]  364         STAA    DATAB   ;  No: Send data
   034D 39            [ 5]  365 PRB_END: RTS             ; RETURN
                            366 
                            367 ; -----------------------------------------------------
                            368 ; Read 4 hex digits and put value into X
ASxxxx Assembler V05.50.5  (Motorola 6800/6802/6808)                    Page 8
Hexadecimal [16-Bits]                                 Wed May  6 15:47:33 2026



                            369 ; -----------------------------------------------------
   034E 8D D8         [ 8]  370 RD_XB:   BSR     ZINB    ; Read 2 digit hex value into A
   0350 B7 19 F6      [ 5]  371         STAA    T_Z     ; Save byte (most significant)
   0353 8D D3         [ 8]  372         BSR     ZINB    ; Read 2 digit hex value into A
   0355 B7 19 F7      [ 5]  373         STAA    T_Z+1   ; Save byte (least significant)
   0358 FE 19 F6      [ 5]  374         LDX     T_Z     ; Load full 4 hex value into X
   035B 39            [ 5]  375         RTS             ; RETURN
                            376 
                            377 ; -----------------------------------------------------
                            378 ; Adds A to X and leaves the result in X, A is
                            379 ; preserved.
                            380 ; -----------------------------------------------------
   035C 36            [ 4]  381 ADX:     PSHA
   035D FF 1A 00      [ 6]  382         STX     T_TMP
   0360 BB 1A 01      [ 4]  383         ADDA    T_TMP+1   ; add A to low byte
   0363 B7 1A 01      [ 5]  384         STAA    T_TMP+1
   0366 B6 1A 00      [ 4]  385         LDAA    T_TMP     ; get high byte
   0369 89 00         [ 2]  386         ADCA    #0      ; add carry only
   036B B7 1A 00      [ 5]  387         STAA    T_TMP
   036E FE 1A 00      [ 5]  388         LDX     T_TMP
   0371 32            [ 4]  389         PULA
   0372 39            [ 5]  390         RTS
                            391 
                            392 ; -----------------------------------------------------
                            393 ; Loads X with A, A is preserved.
                            394 ; -----------------------------------------------------
   0373 B7 1A 01      [ 5]  395 TAX:    STAA    T_TMP+1       ; store A as low byte of X
   0376 7F 1A 00      [ 6]  396         CLR     T_TMP         ; zero the high byte
   0379 FE 1A 00      [ 5]  397         LDX     T_TMP         ; load X
   037C 39            [ 5]  398         RTS
                            399 
                            400 ; -----------------------------------------------------
                            401 ; Prints the message " n stones n pounds"
                            402 ; place stones in MSB of X and pound in LSB
                            403 ; -----------------------------------------------------
   037D                     404 PR_WEIGHT:
                            405 
   037D FF 19 FE      [ 6]  406         STX     T_W
   0380 B6 19 FE      [ 4]  407         LDAA    T_W
   0383 BD 03 73      [ 9]  408         JSR     TAX
   0386 BD 03 EB      [ 9]  409         JSR     PR_WORD         ; n
   0389 BD 03 AB      [ 9]  410         JSR     PR_SPCB
   038C CE 01 2B      [ 3]  411         LDX     #STONES
   038F BD 03 EB      [ 9]  412         JSR     PR_WORD         ; "stones"
   0392 BD 03 AB      [ 9]  413         JSR     PR_SPCB
   0395 B6 19 FF      [ 4]  414         LDAA    T_W+1            ; Load high byte of X into Accumulator A
   0398 BD 03 73      [ 9]  415         JSR     TAX
   039B BD 03 EB      [ 9]  416         JSR     PR_WORD         ; n
   039E CE 00 F5      [ 3]  417         LDX     #POUNDS
   03A1 BD 03 AB      [ 9]  418         JSR     PR_SPCB
   03A4 BD 03 EB      [ 9]  419         JSR     PR_WORD         ; "pounds"
   03A7 BD 03 B6      [ 9]  420         JSR     PR_CRB
   03AA 39            [ 5]  421         RTS
                            422 
                            423 ; -----------------------------------------------------
ASxxxx Assembler V05.50.5  (Motorola 6800/6802/6808)                    Page 9
Hexadecimal [16-Bits]                                 Wed May  6 15:47:33 2026



                            424 ; Prints a space on both consoles (preserves A)
                            425 ; -----------------------------------------------------
   03AB 36            [ 4]  426 PR_SPCB: PSHA
   03AC 86 20         [ 2]  427         LDAA    #0x20        ; Put space character in A
   03AE BD FC 0F      [ 9]  428         JSR     PR_A
   03B1 BD 03 43      [ 9]  429         JSR     PR_B        ; Print it
   03B4 32            [ 4]  430         PULA
   03B5 39            [ 5]  431         RTS                 ; RETURN
                            432 
                            433 ; -----------------------------------------------------
                            434 ; Prints a CRLF on both consoles (preserves A)
                            435 ; -----------------------------------------------------
   03B6 36            [ 4]  436 PR_CRB:  PSHA
   03B7 86 0D         [ 2]  437         LDAA    #0x0D        ; Put CHAR character in A
   03B9 BD FC 0F      [ 9]  438         JSR     PR_A
   03BC BD 03 43      [ 9]  439         JSR     PR_B        ; Print it
   03BF 86 0A         [ 2]  440         LDAA    #0x0A
   03C1 BD FC 0F      [ 9]  441         JSR     PR_A
   03C4 BD 03 43      [ 9]  442         JSR     PR_B        ; Print it
   03C7 32            [ 4]  443         PULA
   03C8 39            [ 5]  444         RTS                 ; RETURN
                            445 
                            446 ; -----------------------------------------------------
                            447 ; Outputs a phrase from the memory location in X
                            448 ; -----------------------------------------------------
   03C9                     449 PR_PHRASE:
                            450 
   03C9 A6 00         [ 5]  451 PR_PH1:  LDAA    0,X         ; get high byte of word
   03CB E6 01         [ 5]  452         LDAB    1,X         ; get low byte
   03CD 81 FF         [ 2]  453         CMPA    #0xFF        ; check high byte
   03CF 27 19         [ 4]  454         BEQ     PR_PH2      ; high byte is 0xFF so we're done
   03D1 FF 19 FA      [ 6]  455 PR_PH3:  STX     T_Y         ; save table pointer
   03D4 B7 19 FC      [ 5]  456         STAA    T_P
   03D7 F7 19 FD      [ 5]  457         STAB    T_P+1
   03DA FE 19 FC      [ 5]  458         LDX     T_P         ; X now points to the word
   03DD BD 03 EB      [ 9]  459         JSR     PR_WORD
   03E0 BD 03 AB      [ 9]  460         JSR     PR_SPCB
   03E3 FE 19 FA      [ 5]  461         LDX     T_Y         ; restore table pointer
   03E6 08            [ 4]  462         INX                 ; move to next entry
   03E7 08            [ 4]  463         INX                 ; (2 bytes per entry)
   03E8 20 DF         [ 4]  464         BRA     PR_PH1
   03EA 39            [ 5]  465 PR_PH2:  RTS
                            466 
                            467 ; -----------------------------------------------------
                            468 ; Outputs a word based on value in X
                            469 ; -----------------------------------------------------
   03EB                     470 PR_WORD:
   03EB FF 19 F8      [ 6]  471             STX     T_X             ; use ASL and ROL to multiply by 2 (pointer is 2 bytes wide)
   03EE 78 19 F9      [ 6]  472             ASL     T_X+1           ; shift low byte left, bit 7 goes to carry
   03F1 79 19 F8      [ 6]  473             ROL     T_X             ; rotate high byte left, carry in from low byte
   03F4 FE 19 F8      [ 5]  474             LDX     T_X
   03F7 FF 19 F8      [ 6]  475             STX     T_X             ; Stash X
   03FA B6 19 F8      [ 4]  476             LDAA    T_X             ; High byte of X
   03FD F6 19 F9      [ 4]  477             LDAB    T_X+1           ; Low byte of X
   0400 CB 1E         [ 2]  478             ADDB    #<WORDPTR    ; Add low byte of WORDPTR address
ASxxxx Assembler V05.50.5  (Motorola 6800/6802/6808)                   Page 10
Hexadecimal [16-Bits]                                 Wed May  6 15:47:33 2026



   0402 89 04         [ 2]  479             ADCA    #>WORDPTR    ; Add high byte of WORDPTR address + carry
   0404 B7 19 F8      [ 5]  480             STAA    T_X             ; T_X has the address of the pointer NOT the word
   0407 F7 19 F9      [ 5]  481             STAB    T_X+1
   040A FE 19 F8      [ 5]  482             LDX     T_X             ; X has the address of the pointer NOT the word
                            483 
   040D A6 00         [ 5]  484             LDAA    0,X             ; get the hi byte of the word
   040F B7 19 F8      [ 5]  485             STAA    T_X
   0412 A6 01         [ 5]  486             LDAA    1,X             ; get the low byte of the word
   0414 B7 19 F9      [ 5]  487             STAA    T_X+1
   0417 FE 19 F8      [ 5]  488             LDX     T_X             ; X now has address of the word
   041A BD 03 06      [ 9]  489             JSR     STRINGBX        ; output the word
   041D 39            [ 5]  490             RTS
