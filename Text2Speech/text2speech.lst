                            139 ; we cycle thought idle message when no one is on the scales, data comes in a one
                            140 ; second intervals so we simply increase the idle count until it's time to display
                            141 ; the next idle message
                            142 
   01EB 7F 1B 59      [ 6]  143 IDLE:   CLR     PROCESSING_FLG  ; clear the processing flag as no one
                            144                                 ;   is standing on the scales
   01EE 7C 1B 52      [ 6]  145         INC     IDLE_COUNT      ; increase the idle count
   01F1 B6 1B 52      [ 4]  146         LDAA    IDLE_COUNT      ; see if idle count = max idle time
   01F4 81 2D         [ 2]  147         CMPA    #IDLE_TICS      ; a data message appears every second
   01F6 27 03         [ 4]  148         BEQ     IDLE1           ; not reached the max idle time
   01F8 7E 01 68      [ 3]  149         JMP     MAINLOOP             ; nothing to do yet
                            150 
   01FB BD FC 76      [ 9]  151 IDLE1:  JSR     STRING
   01FE 53 54 3A 20 49 4D   152         .fcc    "ST: IMSG"
        53 47
   0206 0D 0A FF            153         .fcb    0x0d,0x0a,0xff
   0209 7F 1B 52      [ 6]  154         CLR     IDLE_COUNT      ; time to output an idle message so reset the count
