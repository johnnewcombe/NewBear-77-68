0391                         PR_PHRASE
0392 0415 4c                         INCA
0393 0416 ce 04 64                   LDX     #PHRASEPTR  ; load address of phrase ponter
0394                                                     ; table
0395 0419 4a                 PR_PH1  DECA                ; loop through A times to get
0396 041a 27 04                      BEQ     FOUNDP      ;   address of phrase
0397 041c 08                         INX                 ; move to next address
0398 041d 08                         INX
0399 041e 20 f9                      BRA     PR_PH1      ; try again
0400                         
0401 0420 a6 00              FOUNDP  LDAA    0,X         ; transfer addr pointed to by X to memory
0402 0422 b7 04 ef                   STAA    T_P         ; MSB
0403 0425 a6 01                      LDAA    1,X         ;
0404 0427 b7 04 f0                   STAA    T_P+1       ; LSB
0405 042a fe 04 ef           PR_PH3  LDX     T_P         ; load X
0406 042d a6 00                      LDAA    0,X         ; get word id
0407 042f 08                         INX                 ; point X to next word
0408 0430 ff 04 ef                   STX     T_P         ; store X away
0409 0433 81 00                      CMPA    #0
0410 0435 27 08                      BEQ     PR_PH2      ; no more words
0411 0437 bd 04 40                   JSR     PR_WORD     ; print word based on value in A
0412 043a bd 03 f7                   JSR     PR_SPCB
0413 043d 20 eb                      BRA     PR_PH3      ; next word
0414 043f 39                 PR_PH2  RTS
0415                         
