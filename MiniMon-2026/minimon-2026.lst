0476 fe92 bd fc 0f                   JSR     PR_A    ; Print it
0477 fe95 20 ba                      BRA     WATSIT  ; Loop back
0478                         
0479 fe97 ff f0 e3           NEWLINE STX     T_SAVE  ; Save X
0480 fe9a bd fc 76                   JSR     STRING  ; Print string...
0481 fe9d 0d 0a 00                   FCB     $0D,$0A,$00
0482 fea0 ff                         FCB     $FF     ; End-of-string
0483 fea1 fe f0 e3                   LDX     T_SAVE  ; Restore X
0484 fea4 bd fc bb                   JSR     PRX     ; Print X
0485 fea7 39                         RTS             ; RETURN
