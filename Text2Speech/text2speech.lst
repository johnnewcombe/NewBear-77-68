                            260 
                            261 ;END:     JMP     MAINLOOP  ;START   ; all done
                            262 
                            263 ;--------------------------------------------------------------
                            264 ; Gets the weight data from the scales and rerurns with carry
                            265 ; set if a valid reading, carry clear otherwise. A valid weight
                            266 ; reading resets the idle count. Data received is stored in
                            267 ; T_WEIGHT and MSB in A.
                            268 ;--------------------------------------------------------------
   03F4                     269 GETDATA:
   03F4 BD 04 81      [ 9]  270         JSR     RD_XB           ; read 4 hex characters into X
   03F7 FF 1C 53      [ 6]  271         STX     T_WEIGHT        ; store X
   03FA BD FC 76      [ 9]  272         JSR     STRING
   03FD 44 52 3A 20         273         .fcc    "DR: "
   0401 FF                  274         .fcb    0xff
   0402 FE 1C 53      [ 5]  275         LDX     T_WEIGHT
   0405 BD FC BB      [ 9]  276         JSR     PRX             ; print the data
   0408 BD 05 03      [ 9]  277         JSR    PR_CR
   040B 0C            [ 2]  278         CLC
   040C B6 1C 53      [ 4]  279         LDAA    T_WEIGHT        ; get fist byte (stones)
   040F 27 04         [ 4]  280         BEQ     GDDONE          ; idle message
   0411 7F 00 2D      [ 6]  281         CLR     IDLE_TICS       ; not an idle message so reset the idle counter
   0414 0D            [ 2]  282         SEC                     ; non idle message return with carry set
   0415 39            [ 5]  283 GDDONE:  RTS
                            284 
                            285 ; -----------------------------------------------------
                            286 ; Print string FOLLOWING JSR ( terminated by 0xFF ) to
                            287 ; ACIA(b) and ACIA(b)
                            288 ; -----------------------------------------------------
   0416 30            [ 4]  289 STRINGB: TSX             ; Get loc. of return addr to X
   0417 EE 00         [ 6]  290          LDX     0,X     ; Get return addr to X
   0419 09            [ 4]  291          DEX             ; Point to byte before
   041A 08            [ 4]  292 STRB1:   INX             ; Point to next byte
   041B A6 00         [ 5]  293          LDAA    0,X     ; Get byte to be printed
   041D 81 FF         [ 2]  294          CMPA    #0xFF    ; End-string ?
   041F 27 0E         [ 4]  295          BEQ     ENDSTR  ; Yes: Go to finish up
   0421 F6 F0 FF      [ 4]  296          LDAB    PANEL
   0424 C5 01         [ 2]  297          BITB     #1
   0426 27 03         [ 4]  298          BEQ     STRB    ; panel switch 0 is debug and copies data to A
   0428 BD FC 0F      [ 9]  299          JSR     PR_A    ; Print the byte to ACIA(a) (A is maintained)
                            300                          ;  DEBUG depending on panel data switch zero
   042B 8D 46         [ 8]  301 STRB:    BSR     PR_B    ; Print the byte to ACIA(b)
   042D 20 EB         [ 4]  302          BRA     STRB1   ; Go back for next byte
   042F 31            [ 4]  303 ENDSTR:  INS             ; Clean up stack...
   0430 31            [ 4]  304          INS             ;  ( pop off the return addr )
   0431 6E 01         [ 4]  305          JMP     1,X     ; Jump back to caller (RETURN)
                            306 
                            307 ; -----------------------------------------------------
                            308 ; Prints a string pointed to by X
                            309 ; -----------------------------------------------------
   0433 A6 00         [ 5]  310 STRINGBX:   LDAA    0,X         ; get char
   0435 81 FF         [ 2]  311             CMPA    #0xFF        ; is character NULL?
   0437 27 0F         [ 4]  312             BEQ     DONEB       ; yes, end of string
   0439 F6 F0 FF      [ 4]  313             LDAB    PANEL
   043C C5 01         [ 2]  314             BITB    #1
ASxxxx Assembler V05.50.5  (Motorola 6800/6802/6808)                    Page 7
Hexadecimal [16-Bits]                                 Thu May 14 20:50:38 2026



   043E 27 03         [ 4]  315             BEQ     STRBX       ; panel switch 0 is debug and copies data to A
   0440 BD FC 0F      [ 9]  316             JSR     PR_A        ; Print the byte to ACIA(a) (A is maintained)
   0443 8D 2E         [ 8]  317 STRBX:      BSR     PR_B        ; Print the byte to ACIA(b)
   0445 08            [ 4]  318             INX
   0446 20 EB         [ 4]  319             BRA     STRINGBX
   0448 39            [ 5]  320 DONEB:      RTS
                            321 
                            322 ; -----------------------------------------------------
                            323 ; Reads a character from ACIA(b) into A
                            324 ; -----------------------------------------------------
   0449 B6 F4 03      [ 4]  325 RD_B:   LDAA    CTRLB       ; Get ACIA.A status byte
   044C 85 01         [ 2]  326         BITA    #01         ; Is byte ready in DATAb
   044E 27 F9         [ 4]  327         BEQ     RD_B        ; No: Try again
   0450 B6 F4 02      [ 4]  328         LDAA    DATAB       ; Get the data byte to A
                            329         ;STAA     PANEL
   0453 84 7F         [ 2]  330         ANDA    #0x7F        ; Mask off parity bit if it exists
   0455 39            [ 5]  331         RTS                 ; RETURN
                            332 
                            333 ; -----------------------------------------------------
                            334 ; Reads 2 hex ascii characters and saves them the
                            335 ; byte value to A e.g. "0F" received is stored to A as
                            336 ; 15d.
                            337 ; This version ignores non-hex characters
                            338 ; -----------------------------------------------------
   0456 8D F1         [ 8]  339 ZINB:   BSR     RD_B    ; Read a character
   0458 BD FC 1D      [ 9]  340         JSR     VHEX    ; Is it a hex character ?
   045B 24 02         [ 4]  341         BCC     ZINBA   ; No: go to print `?`
   045D 86 FF         [ 2]  342         LDAA    #0xFF
   045F B7 1C 44      [ 5]  343 ZINBA:  STAA    T_Q     ; Yes: Save Acc.A
   0462 8D E5         [ 8]  344         BSR     RD_B    ; Read 2nd character
   0464 BD FC 1D      [ 9]  345         JSR     VHEX    ; Is it a hex character ?
   0467 24 02         [ 4]  346         BCC     ZINBB   ; No: go to print `?`
   0469 86 FF         [ 2]  347         LDAA    #0xFF
   046B 16            [ 2]  348 ZINBB:  TAB             ; Yes: Put it into Acc.B
   046C B6 1C 44      [ 4]  349         LDAA    T_Q     ; Retrieve 1st hex char to Acc.A
   046F BD FC 31      [ 9]  350         JSR     BINARY  ; Convert A:B to binary
   0472 39            [ 5]  351         RTS             ; RETURN
                            352 
                            353 ; -----------------------------------------------------
                            354 ; Print character in A to ACIA(b)
                            355 ; -----------------------------------------------------
   0473 F6 F4 03      [ 4]  356 PR_B:    LDAB    CTRLB   ; Get ACIA(a) status byte
   0476 C5 02         [ 2]  357         BITB    #02     ; Is it busy ?
   0478 27 F9         [ 4]  358         BEQ     PR_B    ; Yes: Try again
   047A B7 F4 02      [ 5]  359         STAA    DATAB   ;  No: Send data
   047D B7 F0 FF      [ 5]  360         STAA    PANEL
   0480 39            [ 5]  361 PRB_END: RTS             ; RETURN
                            362 
                            363 ; -----------------------------------------------------
                            364 ; Read 4 hex digits and put value into X
                            365 ; -----------------------------------------------------
   0481 8D D3         [ 8]  366 RD_XB:   BSR     ZINB    ; Read 2 digit hex value into A
   0483 B7 1C 45      [ 5]  367         STAA    T_Z     ; Save byte (most significant)
   0486 8D CE         [ 8]  368         BSR     ZINB    ; Read 2 digit hex value into A
   0488 B7 1C 46      [ 5]  369         STAA    T_Z+1   ; Save byte (least significant)
ASxxxx Assembler V05.50.5  (Motorola 6800/6802/6808)                    Page 8
Hexadecimal [16-Bits]                                 Thu May 14 20:50:38 2026



   048B FE 1C 45      [ 5]  370         LDX     T_Z     ; Load full 4 hex value into X
   048E 39            [ 5]  371         RTS             ; RETURN
                            372 
                            373 ; -----------------------------------------------------
                            374 ; Adds A to X and leaves the result in X, A is
                            375 ; preserved.
                            376 ; -----------------------------------------------------
   048F 36            [ 4]  377 ADX:     PSHA
   0490 FF 1C 4F      [ 6]  378         STX     T_TMP
   0493 BB 1C 50      [ 4]  379         ADDA    T_TMP+1   ; add A to low byte
   0496 B7 1C 50      [ 5]  380         STAA    T_TMP+1
   0499 B6 1C 4F      [ 4]  381         LDAA    T_TMP     ; get high byte
   049C 89 00         [ 2]  382         ADCA    #0      ; add carry only
   049E B7 1C 4F      [ 5]  383         STAA    T_TMP
   04A1 FE 1C 4F      [ 5]  384         LDX     T_TMP
   04A4 32            [ 4]  385         PULA
   04A5 39            [ 5]  386         RTS
                            387 
                            388 ; -----------------------------------------------------
                            389 ; Loads X with A, A is preserved.
                            390 ; -----------------------------------------------------
   04A6 B7 1C 50      [ 5]  391 TAX:    STAA    T_TMP+1       ; store A as low byte of X
   04A9 7F 1C 4F      [ 6]  392         CLR     T_TMP         ; zero the high byte
   04AC FE 1C 4F      [ 5]  393         LDX     T_TMP         ; load X
   04AF 39            [ 5]  394         RTS
                            395 
                            396 ; -----------------------------------------------------
                            397 ; Prints the message " n stones n pounds"
                            398 ; place stones in MSB of X and pound in LSB
                            399 ; -----------------------------------------------------
   04B0                     400 PR_WEIGHT:
                            401 
   04B0 FF 1C 4D      [ 6]  402         STX     T_W
   04B3 B6 1C 4D      [ 4]  403         LDAA    T_W
   04B6 BD 04 A6      [ 9]  404         JSR     TAX
   04B9 BD 05 32      [ 9]  405         JSR     PR_WORD         ; n
   04BC BD 04 DE      [ 9]  406         JSR     PR_SPCB
   04BF CE 01 2B      [ 3]  407         LDX     #STONES
   04C2 BD 05 32      [ 9]  408         JSR     PR_WORD         ; "stones"
   04C5 BD 04 DE      [ 9]  409         JSR     PR_SPCB
   04C8 B6 1C 4E      [ 4]  410         LDAA    T_W+1            ; Load high byte of X into Accumulator A
   04CB BD 04 A6      [ 9]  411         JSR     TAX
   04CE BD 05 32      [ 9]  412         JSR     PR_WORD         ; n
   04D1 CE 00 F5      [ 3]  413         LDX     #POUNDS
   04D4 BD 04 DE      [ 9]  414         JSR     PR_SPCB
   04D7 BD 05 32      [ 9]  415         JSR     PR_WORD         ; "pounds"
   04DA BD 04 E9      [ 9]  416         JSR     PR_CRB
   04DD 39            [ 5]  417         RTS
                            418 
                            419 ; -----------------------------------------------------
                            420 ; Prints a space on both consoles (preserves A)
                            421 ; -----------------------------------------------------
   04DE 36            [ 4]  422 PR_SPCB: PSHA
   04DF 86 20         [ 2]  423         LDAA    #0x20        ; Put space character in A
   04E1 BD FC 0F      [ 9]  424         JSR     PR_A
ASxxxx Assembler V05.50.5  (Motorola 6800/6802/6808)                    Page 9
Hexadecimal [16-Bits]                                 Thu May 14 20:50:38 2026



   04E4 BD 04 73      [ 9]  425         JSR     PR_B        ; Print it
   04E7 32            [ 4]  426         PULA
   04E8 39            [ 5]  427         RTS                 ; RETURN
                            428 
                            429 ; -----------------------------------------------------
                            430 ; Prints a CRLF on both consoles (preserves A)
                            431 ; -----------------------------------------------------
   04E9 36            [ 4]  432 PR_CRB:     PSHA
   04EA 86 0D         [ 2]  433             LDAA    #0x0D        ; Put CHAR character in A
   04EC BD FC 0F      [ 9]  434             JSR     PR_A
   04EF BD 04 73      [ 9]  435             JSR     PR_B        ; Print it
   04F2 86 0A         [ 2]  436             LDAA    #0x0A
   04F4 F6 F0 FF      [ 4]  437             LDAB     PANEL
   04F7 C5 01         [ 2]  438             BITB    #1
   04F9 27 03         [ 4]  439             BEQ     PR_CRB1
   04FB BD FC 0F      [ 9]  440             JSR     PR_A
   04FE BD 04 73      [ 9]  441 PR_CRB1:    JSR     PR_B        ; Print it
   0501 32            [ 4]  442             PULA
   0502 39            [ 5]  443             RTS                 ; RETURN
                            444 
                            445 ; -----------------------------------------------------
                            446 ; Prints a CR/LF to ACIA(a) A is preserved
                            447 ; -----------------------------------------------------
   0503 36            [ 4]  448 PR_CR:     PSHA
   0504 86 0D         [ 2]  449             LDAA    #0x0D        ; Put CHAR character in A
   0506 BD FC 0F      [ 9]  450             JSR     PR_A
   0509 86 0A         [ 2]  451             LDAA    #0x0A
   050B BD FC 0F      [ 9]  452             JSR     PR_A
   050E 32            [ 4]  453 PR_CR1:    PULA
   050F 39            [ 5]  454             RTS                 ; RETURN
                            455 
                            456 ; -----------------------------------------------------
                            457 ; Outputs a phrase from the memory location in X
                            458 ; -----------------------------------------------------
   0510                     459 PR_PHRASE:
                            460 
   0510 A6 00         [ 5]  461 PR_PH1:  LDAA    0,X         ; get high byte of word
   0512 E6 01         [ 5]  462         LDAB    1,X         ; get low byte
   0514 81 FF         [ 2]  463         CMPA    #0xFF        ; check high byte
   0516 27 19         [ 4]  464         BEQ     PR_PH2      ; high byte is 0xFF so we're done
   0518 FF 1C 49      [ 6]  465 PR_PH3:  STX     T_Y         ; save table pointer
   051B B7 1C 4B      [ 5]  466         STAA    T_P
   051E F7 1C 4C      [ 5]  467         STAB    T_P+1
   0521 FE 1C 4B      [ 5]  468         LDX     T_P         ; X now points to the word
   0524 BD 05 32      [ 9]  469         JSR     PR_WORD
   0527 BD 04 DE      [ 9]  470         JSR     PR_SPCB
   052A FE 1C 49      [ 5]  471         LDX     T_Y         ; restore table pointer
   052D 08            [ 4]  472         INX                 ; move to next entry
   052E 08            [ 4]  473         INX                 ; (2 bytes per entry)
   052F 20 DF         [ 4]  474         BRA     PR_PH1
   0531 39            [ 5]  475 PR_PH2:  RTS
                            476 
                            477 ; -----------------------------------------------------
                            478 ; Outputs a word based on value in X
                            479 ; -----------------------------------------------------
ASxxxx Assembler V05.50.5  (Motorola 6800/6802/6808)                   Page 10
Hexadecimal [16-Bits]                                 Thu May 14 20:50:38 2026



   0532                     480 PR_WORD:
   0532 FF 1C 47      [ 6]  481             STX     T_X             ; use ASL and ROL to multiply by 2 (pointer is 2 bytes wide)
   0535 78 1C 48      [ 6]  482             ASL     T_X+1           ; shift low byte left, bit 7 goes to carry
   0538 79 1C 47      [ 6]  483             ROL     T_X             ; rotate high byte left, carry in from low byte
   053B FE 1C 47      [ 5]  484             LDX     T_X
   053E FF 1C 47      [ 6]  485             STX     T_X             ; Stash X
   0541 B6 1C 47      [ 4]  486             LDAA    T_X             ; High byte of X
   0544 F6 1C 48      [ 4]  487             LDAB    T_X+1           ; Low byte of X
   0547 CB 6B         [ 2]  488             ADDB    #<WORDPTR    ; Add low byte of WORDPTR address
   0549 89 05         [ 2]  489             ADCA    #>WORDPTR    ; Add high byte of WORDPTR address + carry
   054B B7 1C 47      [ 5]  490             STAA    T_X             ; T_X has the address of the pointer NOT the word
   054E F7 1C 48      [ 5]  491             STAB    T_X+1
   0551 FE 1C 47      [ 5]  492             LDX     T_X             ; X has the address of the pointer NOT the word
                            493 
   0554 A6 00         [ 5]  494             LDAA    0,X             ; get the hi byte of the word
   0556 B7 1C 47      [ 5]  495             STAA    T_X
   0559 A6 01         [ 5]  496             LDAA    1,X             ; get the low byte of the word
   055B B7 1C 48      [ 5]  497             STAA    T_X+1
   055E FE 1C 47      [ 5]  498             LDX     T_X             ; X now has address of the word
   0561 BD 04 33      [ 9]  499             JSR     STRINGBX        ; output the word
   0564 7C 1C 5D      [ 6]  500             INC     WORDS
   0567 BD FD 4D      [ 9]  501             JSR     PRSP
   056A 39            [ 5]  502             RTS
