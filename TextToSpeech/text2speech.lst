                            149 ; we cycle thought idle message when no one is on the scales, data comes in a one
ASxxxx Assembler V05.50.5  (Motorola 6800/6802/6808)                    Page 4
Hexadecimal [16-Bits]                                 Thu May  7 22:05:00 2026



                            150 ; second intervals so we simply increase the idle count until it's time to display
                            151 ; the next idle message
                            152 
   0207 7F 1A 26      [ 6]  153 IDLE:   CLR     PROCESSING_FLG  ; clear the processing flag as no one
                            154                                 ;   is standing on the scales
   020A 7C 1A 1F      [ 6]  155         INC     IDLE_COUNT      ; increase the idle count
   020D B6 1A 1F      [ 4]  156         LDAA    IDLE_COUNT      ; see if idle count = max idle time
   0210 81 2D         [ 2]  157         CMPA    #IDLE_TICS      ; a data message appears every second
   0212 27 03         [ 4]  158         BEQ     IDLE1           ; not reached the max idle time
   0214 7E 01 6B      [ 3]  159         JMP     MAINLOOP             ; nothing to do yet
                            160 
   0217 7F 1A 1F      [ 6]  161 IDLE1:   CLR     IDLE_COUNT      ; time to output an idle message so reset the count
   021A B6 1A 20      [ 4]  162         LDAA    IDLE_MSG_ID     ; get next Message ID
   021D 81 19         [ 2]  163         CMPA    #IDLE_MSG_CNT   ; are we beyond the end of the list
   021F 26 04         [ 4]  164         BNE     IDLE_OP         ; still at valid id so output idle message
   0221 7F 1A 20      [ 6]  165         CLR     IDLE_MSG_ID     ; beyond last message so reset the current msg to zero
   0224 4F            [ 2]  166         CLRA                    ; set currentid back to 0
   0225                     167 IDLE_OP:
   0225 7C 1A 20      [ 6]  168         INC     IDLE_MSG_ID     ; set to next message for the next next time
   0228 CE 12 31      [ 3]  169         LDX     #IDLEPTR        ; A has phrase ID, set X to the base address
   022B BD 02 A1      [ 9]  170         JSR     PHRASE_OUT
   022E 7E 01 6B      [ 3]  171         JMP     MAINLOOP
                            172 
   0231                     173 GREET:   ; output the greeting message
   0231 B6 1A 21      [ 4]  174         LDAA    GREET_MSG_ID    ; get next Message ID
   0234 81 0D         [ 2]  175         CMPA    #GREET_MSG_CNT  ; are we beyond the end of the list
   0236 26 04         [ 4]  176         BNE     GREET_OP        ; still at valid id so output idle message
   0238 7F 1A 21      [ 6]  177         CLR     GREET_MSG_ID    ; beyond last message so reset the current msg to zero
   023B 4F            [ 2]  178         CLRA                    ; set currentid back to 0
   023C                     179 GREET_OP:
   023C 7C 1A 21      [ 6]  180         INC     GREET_MSG_ID    ; set to next message for the next next time
   023F CE 11 A3      [ 3]  181         LDX     #GREETPTR       ; A has phrase ID, set X to the base address
   0242 BD 02 A1      [ 9]  182         JSR     PHRASE_OUT
   0245 39            [ 5]  183         RTS
                            184 
