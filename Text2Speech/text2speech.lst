   0293 53 54 3A 53 4F 46   179                 .fcc    "ST:SOFL "
        4C 20
   029B 20 FF               180                 .fcb    0x20,0xff
   029D CE 1B 97      [ 3]  181                 LDX     #MTOOHEAVY1
   02A0 BD 04 84      [ 9]  182                 JSR     PR_PHRASE
