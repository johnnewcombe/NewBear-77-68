1412 0ac6 bd 06 76                       JSR         ROWSET      ; Set up for printout
1413 0ac9 bd 07 02                       JSR         QUAD        ; Print current quadrant
1414                         
1415 0acc c6 04                          LDAB        #$04        ; Set row number four
1416 0ace bd 06 76                       JSR         ROWSET      ; Set up for printout
1417 0ad1 ce 01 e3                       LDX         #Msg08a     ; Set up sector message (was $01E3)
1418 0ad4 df 20                          STX         PNTR1       ; Pointer in storage
1419 0ad6 de 5a                          LDX         PSLOSS      ; Pointer to current sector
1420 0ad8 bd 07 12                       JSR         TWO         ; Put two digits in message
1421 0adb ce 01 d8                       LDX         #MSG08      ; Set pointer to sector message
1422 0ade 8d ce                          BSR         SRSCN1      ; Print sector message
1423                         
1424 0ae0 c6 05                          LDAB        #$05        ; Set row number five 
1425 0ae2 bd 06 76                       JSR         ROWSET      ; Set up row for printout
1426 0ae5 de 66                          LDX         PDVME       ; Set pointer to main energy 
1427 0ae7 c6 02                          LDAB        #$02        ; Set precision counter 
1428 0ae9 bd 05 29                       JSR         BINDEC      ; Convert to decimal 
1429 0aec ce 01 f5                       LDX         #Msg09a+3   ; Message pointer 
1430 0aef c6 04                          LDAB        #$04        ; Counter for four digits 
1431 0af1 bd 06 62                       JSR         DIGPRT      ; Put digits in message 
1432 0af4 ce 01 e7                       LDX         #MSG09      ; Set pointer to energy message 
1433 0af7 8d b5                          BSR         SRSCN1      ; Print energy message 
