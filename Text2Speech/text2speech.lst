                            132                 ; -----------------------------------------------------
                            133                 ; Data arrives at port B as four hex characters
                            134                 ; -----------------------------------------------------
   0241 BD 03 86      [ 9]  135                 JSR     GETDATA         ; value in T_WEIGHT, stones in A
   0244 25 03         [ 4]  136                 BCS     ML1             ; is it invalid i.e. carry clear
   0246 7E 02 C2      [ 3]  137                 JMP     IDLE
                            138 
   0249 7D 00 18      [ 6]  139 ML1:            TST     PROCESSING_FLG  ; are we already processing a weight
   024C 26 ED         [ 4]  140                 BNE     MAINLOOP        ; flag non-zero so ignore everything that follows
   024E 7C 00 18      [ 6]  141                 INC     PROCESSING_FLG  ; ignore any following data until we next idle
   0251 81 14         [ 2]  142                 CMPA    #TOO_HEAVY      ; more that 20 is too heavy
   0253 22 3B         [ 4]  143                 BHI     OVERLOADED
   0255 B6 00 10      [ 4]  144                 LDAA    T_WEIGHT+1      ; validate pounds
   0258 81 0D         [ 2]  145                 CMPA    #13             ; invalid pounds
   025A 22 4D         [ 4]  146                 BHI     IERROR          ; internal error
   025C BD 02 EC      [ 9]  147                 JSR     GREET           ; send a greeting message
                            148 
                            149                 ; get the weight a second time, this should allow the scales time to settle
   025F BD 03 86      [ 9]  150                 JSR     GETDATA
                            151 
                            152                 ; output "you weigh" maybe use a phrase rather than individual words
   0262 CE 1B A8      [ 3]  153                 LDX     #MYOUWEIGH
   0265 BD 04 84      [ 9]  154                 JSR     PR_PHRASE
   0268 FE 00 0F      [ 5]  155                 LDX     T_WEIGHT        ; restore X
   026B BD 04 34      [ 9]  156                 JSR     PR_WEIGHT       ; weight back X so output the weight
                            157 
                            158                 ; output a comments
   026E B6 00 0F      [ 4]  159                 LDAA    T_WEIGHT        ; stones
   0271 81 0F         [ 2]  160                 CMPA    #SHEAVY_WGHT
   0273 25 03         [ 4]  161                 BLO     ML2             ; not super heavy weight
   0275 7E 03 46      [ 3]  162                 JMP     SHEAVYW
   0278 81 0D         [ 2]  163 ML2:            CMPA    #HEAVY_WGHT
