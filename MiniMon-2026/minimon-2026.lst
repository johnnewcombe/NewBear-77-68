0436                         ;FE43
0437 fe43 bd fc 65           MODIFY  JSR     RD_X    ; Get address to X
0438 fe46 bd fd 4d           STRT    JSR     PRSP    ; Print a space
0439 fe49 7f f0 f5                   CLR     T_R     ; T_R = 0
0440 fe4c a6 00              PRz     LDAA    0,X     ; Get byte pointed to by X to A
0441 fe4e bd fc c9                   JSR     ZOUT    ; Print it as 2.hex digits
0442 fe51 bd fc 00           WATSIT  JSR     RD_CMD  ; Get command character
0443 fe54 81 20              WHAT    CMPA    #$20    ; Is it a space ?
0444 fe56 26 0c                      BNE     ISSLSH  ; No: go test for slash
0445 fe58 08                 CARYON  INX             ; Increment X
0446 fe59 b6 f0 f5                   LDAA    T_R     ; A = T_R
0447 fe5c 81 16                      CMPA    #$16    ; At end of line ?
0448 fe5e 2f ec                      BLE     PRz     ; No: Loop back to continue
0449 fe60 8d 35              NEW_1   BSR     NEWLINE ; Print c/r l/f nul
0450 fe62 20 e2                      BRA     STRT    ; Loop back (Note: Hex was wrong in doc, E2 instead of E5)
0451                         
0452 fe64 81 2f              ISSLSH  CMPA    #'/     ; Is it a slash ?
0453 fe66 26 03                      BNE     ISCRET  ; No: go test for c/r
0454 fe68 09                         DEX             ; X = X - 1
0455 fe69 20 f5                      BRA     NEW_1   ; Loop back (print newline)
0456                         
0457 fe6b 81 0d              ISCRET  CMPA    #$0D    ; Is it a c/r ?
0458 fe6d 26 03                      BNE     ISHEX   ; No: go test for valid Hex
0459 fe6f 08                         INX             ; X = X + 1
0460 fe70 20 ee                      BRA     NEW_1   ; Loop back (print newline)
0461                         
0462 fe72 bd fc 1d           ISHEX   JSR     VHEX    ; Is it a valid hex character ?
0463 fe75 25 19                      BCS     PRQM    ; No: print `?` and ignore
0464 fe77 b7 f0 f6                   STAA    T_Q     ; T_Q = A : Save it
0465 fe7a bd fc 00                   JSR     RD_CMD  ; Get 2nd character
0466 fe7d bd fc 1d                   JSR     VHEX    ; Is it a valid hex character ?
0467 fe80 25 d2                      BCS     WHAT    ; No: then see what it is
0468 fe82 16                         TAB             ; B = A
0469 fe83 b6 f0 f6                   LDAA    T_Q     ; A = T_Q
0470 fe86 bd fc 31                   JSR     BINARY  ; Convert to binary value
0471 fe89 a7 00                      STAA    0,X     ; Store it
0472 fe8b bd fd 4d                   JSR     PRSP    ; Print a space
0473 fe8e 20 c8                      BRA     CARYON  ; Loop back
0474                         
