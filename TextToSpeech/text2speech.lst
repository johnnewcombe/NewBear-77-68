                            270 ; -----------------------------------------------------
                            271 ; Prints a string pointed to by X
                            272 ; -----------------------------------------------------
   0292 A6 00         [ 5]  273 STRINGBX:    LDAA    0,X         ; get char
   0294 81 FF         [ 2]  274             CMPA    #0xFF        ; is character NULL?
   0296 27 08         [ 4]  275             BEQ     DONEB       ; yes, end of string
   0298 BD FC 0F      [ 9]  276             JSR     PR_A        ; Print the byte to ACIA(a) (A is maintained)
   029B 8D 2F         [ 8]  277             BSR     PR_B        ; Print the byte to ACIA(b)
   029D 08            [ 4]  278             INX
   029E 20 F2         [ 4]  279             BRA     STRINGBX
   02A0 39            [ 5]  280 DONEB:       RTS
