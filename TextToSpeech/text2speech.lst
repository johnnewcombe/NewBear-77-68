0105 02a1 7c 06 e7           IDLE    INC     IDLE_COUNT      ; increase the idle count
0106 02a4 b6 06 e7                   LDAA    IDLE_COUNT      ; see if idle count = max idle time
0107 02a7 81 5a                      CMPA    #IDLE_SECS      ; a data message appears every second
0108 02a9 27 03                      BEQ     IDLE1           ; not reached the max idle time
0109 02ab 7e 03 36                   JMP     END
