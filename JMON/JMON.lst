0655                         ; FF81
0656                         ; -----------------------------------------------------
0657 ff81 8e f0 d0           RESET   LDS     #STACK      ; Set up stack for MINIMON
0658 ff84 86 03                      LDAA    #$03        ; Reset:
0659 ff86 b7 f4 01                   STAA    CTRLA       ;   ACIA.A
0660 ff89 b7 f4 03                   STAA    CTRLB       ;   ACIA.B
0661                         
0662                         ; -----------------------------------------------------
0663                         ; FF8C
0664                         ; -----------------------------------------------------
0665 ff8c bf f0 fd           SWI     STS     PSTACK      ; Save callers stack pointer
0666                         
0667                         ; -----------------------------------------------------
0668                         ; FF8F
0669                         ; -----------------------------------------------------
0670 ff8f 8e f0 d0           START   LDS     #STACK      ; Set up stack for JMON
0671 ff92 86 11                      LDAA    #$11        ; 8 Data, No Parity, 2 Stop Bits
0672 ff94 b7 f4 01                   STAA    CTRLA       ;   ACIA.A
0673 ff97 bd fc 76                   JSR     STRING      ; Print string...
0674 ff9a 0d 0a                      FCB     $0D,$0A     ; c/r l/f null `*`
0675 ff9c 00 2a ff                   FCB     $00,'*,$FF  ; End-of-string
0676 ff9f bd fc 00                   JSR     RD_CMD      ; Read a byte (test for `.`)
0677 ffa2 ce ff b8                   LDX     #CMDTAB     ; point to command table
0678 ffa5 e6 00              CMDLP   LDAB    0,X         ; B = key byte (0 ends table)
0679 ffa7 27 e6                      BEQ     START       ; end of table → default to START
0680 ffa9 11                         CBA                 ; compare A vs B
0681 ffaa 27 05                      BEQ     FOUND       ; match → dispatch
0682 ffac 08                         INX                 ; skip key
0683 ffad 08                         INX                 ; skip FDB high
0684 ffae 08                         INX                 ; skip FDB low
0685 ffaf 20 f4                      BRA      CMDLP      ; try next entry
0686                         
0687 ffb1 e6 01              FOUND   LDAB    1,X         ; B = target high byte (FDB stores high,low)
0688 ffb3 a6 02                      LDAA    2,X         ; A = target low byte
0689 ffb5 36                         PSHA                ; push high first
0690 ffb6 37                         PSHB                ; push low — now low is on top of stack
0691 ffb7 39                         RTS                 ; jump to target
0692                         
0693                         ; Command table: key, then FDB routine
0694 ffb8 53                 CMDTAB  FCB     'S
0695 ffb9 ff 39                      FDB     BRPTSET
0696 ffbb 48                         FCB     'H
0697 ffbc ff 63                      FDB     HEADER
0698 ffbe 50                         FCB     'P
0699 ffbf fd e2                      FDB     PUNCH
0700 ffc1 4c                         FCB     'L
0701 ffc2 fc e3                      FDB     LOAD
0702 ffc4 52                         FCB     'R
0703 ffc5 fd 36                      FDB     REGPRT
0704 ffc7 4d                         FCB     'M
0705 ffc8 fe 43                      FDB     MODIFY
0706 ffca 47                         FCB     'G
0707 ffcb fe c2                      FDB     GO
0708 ffcd 43                         FCB     'C
0709 ffce fe d9                      FDB     CONTNU
0710 ffd0 44                         FCB     'D
0711 ffd1 ff 07                      FDB     DUMP
0712 ffd3 54                         FCB     'T'
0713 ffd4 fd 62                      FDB     MEMTEST
0714 ffd6 56                         FCB     'V'
0715 ffd7 fd c4                      FDB     VERSION
0716 ffd9 4e                         FCB     'N'
0717 ffda ff 81                      FDB     RESET
0718 ffdc 00                         FCB     0           ; terminator
0719                         
