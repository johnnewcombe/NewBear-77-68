0086                         ; -----------------------------------------------------
0087                         ; Random idle phrase to ports B
0088                         ; -----------------------------------------------------
0089 0237 bd 02 74           IDLE    JSR     STRINGB
0090 023a 53 68 61 6c 6c 20          FCC     "Shall I tell you a joke?"
     49 20 74 65 6c 6c
     20 79 6f 75 20 61
     20 6a 6f 6b 65 3f
0091 0252 0a 0d ff                   FCB     $0A, $0D, $FF
0092 0255 39                         RTS
0093                         
0094                         ;--------------------------------------------------------------
0095                         ; DECIMAL CONVERSION EXAMPLE
0096                         ;--------------------------------------------------------------
0097                                 ;JSR     PR_DEC          ; puts 3 decimal digits in DEC, DEC+1 and DEC+2
0098                                 ;LDAA    DEC+1           ; don't care about the hundreds        ADDA    #$30
0099                                 ;JSR     PR_WORD
0100                                 ;JSR     PR_SPCB
0101                                 ;LDAA    DEC+2
0102                                 ;JSR     PR_WORD
0103                         
0104                         ; -----------------------------------------------------
0105                         ; PR_DEC: Puts 3 decimal digits in DEC, DEC+1 and DEC+2
0106                         ;
0107                         ;       !! ONLY WORKS WITH VALUES BELOW 128 !!
0108                         ; -----------------------------------------------------
0109 0256 5f                 PR_DEC  CLRB            ; Clear B for hundreds
0110                         
0111 0257 81 64              HUND    CMPA    #100    ; 100 or more?
0112                         
0113 0259 2d 05                      BLT     TENS
0114 025b 80 64                      SUBA    #100    ; Sub 100
0115 025d 5c                         INCB            ; Increment hundred counter
0116 025e 20 f7                      BRA     HUND
0117                         
0118 0260 f7 04 81           TENS    STAB    DEC     ; store the hundreds
0119                         
0120 0263 5f                         CLRB
0121 0264 81 0a              TENS1   CMPA    #10     ; 10 or more?
0122 0266 2d 05                      BLT     UNITS
0123 0268 80 0a                      SUBA    #10     ; Sub 10
0124 026a 5c                         INCB            ; Increment ten counter
0125 026b 20 f7                      BRA     TENS1
0126                         
0127 026d f7 04 82           UNITS   STAB    DEC+1
0128 0270 b7 04 83                   STAA    DEC+2   ; Final remainder is units
0129                         
0130 0273 39                         RTS
0131                         
0132                         
0133                         ; -----------------------------------------------------
0134                         ; Print string FOLLOWING JSR ( terminated by $FF ) to
0135                         ; ACIA(b) and ACIA(b)
0136                         ; -----------------------------------------------------
0137 0274 30                 STRINGB TSX             ; Get loc. of return addr to X
0138 0275 ee 00                      LDX     0,X     ; Get return addr to X
0139 0277 09                         DEX             ; Point to byte before
0140 0278 08                 AGAIN   INX             ; Point to next byte
0141 0279 a6 00                      LDAA    0,X     ; Get byte to be printed
0142 027b 81 ff                      CMPA    #$FF    ; End-string ?
0143 027d 27 07                      BEQ     ENDSTR  ; Yes: Go to finish up
0144 027f bd fc 0f                   JSR     PR_A    ; Print the byte to ACIA(a) (A is maintained)
0145 0282 8d 40                      BSR     PR_B    ; Print the byte to ACIA(b)
0146 0284 20 f2                      BRA     AGAIN   ; Go back for next byte
0147 0286 31                 ENDSTR  INS             ; Clean up stack...
0148 0287 31                         INS             ;  ( pop off the return addr )
0149 0288 6e 01                      JMP     1,X     ; Jump back to caller (RETURN)
0150                         
0151                         ; -----------------------------------------------------
0152                         ; Prints a string pointed to by X
0153                         ; -----------------------------------------------------
0154 028a a6 00              STRINGBX    LDAA    0,X         ; get char
0155 028c 81 ff                          CMPA    #$FF        ; is character NULL?
0156 028e 27 08                          BEQ     DONEB       ; yes, end of string
0157 0290 bd fc 0f                       JSR     PR_A        ; Print the byte to ACIA(a) (A is maintained)
0158 0293 8d 2f                          BSR     PR_B        ; Print the byte to ACIA(b)
0159 0295 08                             INX
0160 0296 20 f2                          BRA     STRINGBX
0161 0298 39                 DONEB       RTS
0162                         
0163                         ; -----------------------------------------------------
0164                         ; Reads a character from ACIA(b) into A
0165                         ; -----------------------------------------------------
0166 0299 7c 04 84           RD_B    INC     RND         ; simple way to get a random number
0167 029c b6 f4 03                   LDAA    CTRLB       ; Get ACIA.A status byte
0168 029f 85 01                      BITA    #01         ; Is byte ready in DATAb
0169 02a1 27 f6                      BEQ     RD_B        ; No: Try again
0170 02a3 b6 f4 02                   LDAA    DATAB       ; Get the data byte to A
0171 02a6 84 7f                      ANDA    #$7F        ; Mask off parity bit if it exists
0172 02a8 39                         RTS                 ; RETURN
0173                         
0174                         ; -----------------------------------------------------
0175                         ;
0176                         ; -----------------------------------------------------
0177 02a9 8d ee              ZINB    BSR     RD_B    ; Read a character
0178 02ab bd fc 1d                   JSR     VHEX    ; Is it a hex character ?
0179 02ae 25 12                      BCS     Z_PRQM  ; No: go to print `?`
0180 02b0 b7 04 78                   STAA    T_Q     ; Yes: Save Acc.A
0181 02b3 8d e4                      BSR     RD_B    ; Read 2nd character
0182 02b5 bd fc 1d                   JSR     VHEX    ; Is it a hex character ?
0183 02b8 25 08                      BCS     Z_PRQM  ; No: go to print `?`
0184 02ba 16                         TAB             ; Yes: Put it into Acc.B
0185 02bb b6 04 78                   LDAA    T_Q     ; Retrieve 1st hex char to Acc.A
0186 02be bd fc 31                   JSR     BINARY  ; Convert A:B to binary
0187 02c1 39                         RTS             ; RETURN
0188                         Z_PRQM  ;LDAA    #'?     ; Load `?` into A
0189                                 ;BSR     PR_B    ; Print it
0190 02c2 20 e5                      BRA     ZINB    ; Go back to start of hex input
0191                         
0192                         ; -----------------------------------------------------
0193                         ; Print character in A to ACIA(b)
0194                         ; -----------------------------------------------------
0195 02c4 f6 f4 03           PR_B    LDAB    CTRLB   ; Get ACIA(a) status byte
0196 02c7 c5 02                      BITB    #02     ; Is it busy ?
0197 02c9 27 f9                      BEQ     PR_B    ; Yes: Try again
0198 02cb b7 f4 02                   STAA    DATAB   ;  No: Send data
0199 02ce 39                 PRB_END RTS             ; RETURN
0200                         
0201                         ; -----------------------------------------------------
0202                         ; Read 4 hex digits and put value into X
0203                         ; -----------------------------------------------------
0204 02cf 8d d8              RD_XB   BSR     ZINB    ; Read 2 digit hex value into A
0205 02d1 b7 04 79                   STAA    T_Z     ; Save byte (most significant)
0206 02d4 8d d3                      BSR     ZINB    ; Read 2 digit hex value into A
0207 02d6 b7 04 7a                   STAA    T_Z+1   ; Save byte (least significant)
0208 02d9 fe 04 79                   LDX     T_Z     ; Load full 4 hex value into X
0209 02dc 39                         RTS             ; RETURN
0210                         
0211                         ; -----------------------------------------------------
0212                         ; Prints the message " n stones n pounds"
0213                         ; place stones in MSB of X and pound in LSB
0214                         ; -----------------------------------------------------
0215                         PR_WEIGHT
0216 02dd ff 04 7f                   STX     T_W
0217                                 ;JSR     STRINGB
0218                                 ;FCC     "You weigh "
0219                                 ;FDB     $FF
0220 02e0 b6 04 7f                   LDAA    T_W             ; Load high byte of X into Accumulator A
0221 02e3 bd 03 52                   JSR     PR_WORD
0222 02e6 bd 02 74                   JSR     STRINGB
0223 02e9 20 73 74 6f 6e 65          FCC     " stones "
     73 20
0224 02f1 00 ff                      FDB     $FF
0225 02f3 b6 04 80                   LDAA    T_W+1            ; Load high byte of X into Accumulator A
0226 02f6 bd 03 52                   JSR     PR_WORD
0227 02f9 bd 02 74                   JSR     STRINGB
0228 02fc 20 70 6f 75 6e 64          FCC     " pounds"
     73
0229 0303 0d 0a ff                   FCB     $0D, $0A,$FF
0230                         
0231 0306 39                         RTS
0232                         
0233                         ; -----------------------------------------------------
0234                         ; Prints a space on both consoles (preserves A)
0235                         ; -----------------------------------------------------
0236 0307 36                 PR_SPCB   PSHA
0237 0308 86 20                      LDAA    #$20        ; Put space character in A
0238 030a bd fc 0f                   JSR     PR_A
0239 030d bd 02 c4                   JSR     PR_B        ; Print it
0240 0310 32                         PULA
0241 0311 39                         RTS                 ; RETURN
0242                         
0243                         ; -----------------------------------------------------
0244                         ; Prints a CRLF on both consoles (preserves A)
0245                         ; -----------------------------------------------------
0246 0312 36                 PR_CRB  PSHA
0247 0313 86 0d                      LDAA    #$0D        ; Put CHAR character in A
0248 0315 bd fc 0f                   JSR     PR_A
0249 0318 bd 02 c4                   JSR     PR_B        ; Print it
0250 031b 86 0a                      LDAA    #$0A
0251 031d bd fc 0f                   JSR     PR_A
0252 0320 bd 02 c4                   JSR     PR_B        ; Print it
0253 0323 32                         PULA
0254 0324 39                         RTS                 ; RETURN
0255                         
0256                         ; -----------------------------------------------------
0257                         ; Outputs a phrase from the value in A
0258                         ; -----------------------------------------------------
0259                         PR_PHRASE
0260 0325 4c                         INCA
0261 0326 ce 03 a2                   LDX     #PHRASEPTR  ; load address of phrase ponter
0262                                                     ; table
0263 0329 4a                 PR_PH1  DECA                ; loop through A times to get
0264 032a 27 04                      BEQ     FOUNDP      ;   address of phrase
0265 032c 08                         INX                 ; move to next address
0266 032d 08                         INX
0267 032e 20 f9                      BRA     PR_PH1      ; try again
0268 0330 a6 00              FOUNDP  LDAA    0,X         ; transfer addr pointed to by X to memory
0269 0332 b7 04 7d                   STAA    T_P         ; MSB
0270 0335 a6 01                      LDAA    1,X         ;
0271 0337 b7 04 7e                   STAA    T_P+1       ; LSB
0272 033a fe 04 7d                   LDX     T_P         ; load address of phrase
0273 033d a6 00              PR_PH3  LDAA    0,X         ; get word
0274 033f 81 00                      CMPA    #0
0275 0341 27 0e                      BEQ     PR_PH2      ; no more words
0276 0343 bd 03 52                   JSR     PR_WORD     ; print word
0277 0346 7c 04 7d                   INC     T_P
0278 0349 fe 04 7d                   LDX     T_P         ; recover X
0279 034c bd 03 07                   JSR     PR_SPCB
0280 034f 20 ec                      BRA     PR_PH3      ; next word
0281 0351 39                 PR_PH2  RTS
0282                         
0283                         ; -----------------------------------------------------
0284                         ; Outputs a word based on value in A
0285                         ; -----------------------------------------------------
0286 0352 4c                 PR_WORD     INCA
0287 0353 ce 03 6e                       LDX     #WORDPTR  ; base of offset table
0288 0356 4a                 PR_WORD1    DECA
0289 0357 27 04                          BEQ     FOUNDW
0290 0359 08                             INX                 ; move to next address
0291 035a 08                             INX
0292 035b 26 f9                          BNE     PR_WORD1    ; loop around to retest
0293 035d a6 00              FOUNDW      LDAA    0,X
0294 035f b7 04 7b                       STAA    T_X
0295 0362 a6 01                          LDAA    1,X
0296 0364 b7 04 7c                       STAA    T_X+1
0297 0367 fe 04 7b                       LDX     T_X
0298 036a bd 02 8a                       JSR     STRINGBX
0299 036d 39                             RTS
0300                         
