output:  minimon-2026.s19
0001                         ; ------------------------------------------------------
0002                         ; Minimon
0003                         ; ------------------------------------------------------
0004                         ;  Original author ACH, Dec.1978;
0005                         ; ------------------------------------------------------
0006                         ; 13 NOV 2025 : [JN] added NOP at FFF7 to remove gap to
0007                         ;             : allow easier conversion to bin from s19
0008                         ; 05 DEC 2025 : [JN] Changed ACIA(a) to be 8N2 to match
0009                         ;             : PROM. So that MiniMon can be loaded and
0010                         ;             : run from the same terminal config.
0011                         ; ------------------------------------------------------
0012                         ; 2 x ACIAs :-
0013                         ;
0014                         
0015 f401                    CTRLA   EQU     $F401   ; ACIA.A Ctrl/Status
0016 f403                    CTRLB   EQU     $F403   ; ACIA.B Ctrl/Status
0017 f400                    DATAA   EQU     $F400   ; ACIA.A Data register
0018 f402                    DATAB   EQU     $F402   ; ACIA.B Data register
0019                         
0020                         ; Note:The original 256 bytes of RAM on the CPU board 
0021                         ;  appears at $F000 to $F0FE, with Switches/LEDs at $F0FF
0022                         ;  when a MON1 board is installed
0023                         
0024                         ; Stack goes down from $F0D0
0025 f0d0                    STACK   EQU     $F0D0   ; Top of MINIMON's stack
0026                         
0027                         
0028                         
0029                         ; RAM at $F0D1 to $F0DC appears to be unused
0030                         
0031                         ; 3 bytes reserved for each if NMI and IRQ handling
0032                         ; so an application can write JMP <addr> into those
0033                         ; places if those interrupts are wanted...
0034                         
0035 f0dd                    JNMI    EQU     $F0DD   ; Space for jump to NMI sub.
0036 f0e0                    JIRQ    EQU     $F0E0   ; Space for jump to IRQ sub.
0037                         
0038                         ; -----------------------------------------------------
0039 f0de                            ORG     $F0DE   ; Start of RAM variables
0040                         ; -----------------------------------------------------
0041                         ; Note: Temp storage variables renamed to get T_ prefix
0042                         ;       as some were sharing names with labels or registers
0043                         ;
0044                         ; New additions to support S19 additions
0045                         ;d_RdFstX    RMB     2       ;  "  RD_ByteFast X
0046                         ;d_Hx4X      RMB     2       ;  "  RDX4 PRX4
0047 f0de                    d_TW        RMB     2       ;  "  S19
0048                         ;d_STOP      RMB     2       ;  "  ASK_Addrs `Stop:`
0049 f0e0                    b_Csum      RMB     1       ;  "  S19
0050 f0e1                    b_Count     RMB     1       ;  "  S19
0051 f0e2                    b_Temp      RMB     1       ;  "  S19
0052                         ;d_START     RMB     2       ;  "  ASK_Start `Start:`
0053                         ;b_Q         RMB     1       ;  "  ZIN,DUMP
0054                         
0055 f0e3                    T_SAVE  RMB     2       ; Temp storage for NEWLINE
0056 f0e5                    T_P     RMB     1       ;   "     "     "  Z,X
0057 f0e6                    T_X     RMB     2       ;   "     "     "  Sub
0058 f0e8                    T_Y     RMB     2       ;   "     "     "  Sub
0059 f0ea                    T_NEW   RMB     2       ;   "     "     "  Block move
0060 f0ec                    T_M     RMB     1       ;   "     "     "  ZOUT
0061 f0ed                    T_TMPX  RMB     2       ;   "     "     "  PRX
0062 f0ef                    T_STRT  RMB     2       ;   "     "     "  GETADDRESS
0063 f0f1                    T_STOP  RMB     2       ;   "     "     "  GETADDRESS
0064 f0f3                    T_Z     RMB     2       ;   "     "     "   . RDX
0065 f0f5                    T_R     RMB     1       ;   "     "     "     PR
0066 f0f6                    T_Q     RMB     1       ;   "     "     "  ZIN,DUMP 
0067 f0f7                    T_ABYT  RMB     2       ;   "     "     "  SET BR.PT.
0068 f0f9                            RMB     2       ;   "     "     "  SET BR.PT.
0069 f0fb                    T_BYTE  RMB     2       ;   "     "     "  SET BR.PT.
0070 f0fd                    PSTACK  RMB     2       ;   "     "     "     SWI etc
0071                         
0072                         
0073                         
0074                         ;
0075                         ; -----------------------------------------------------
0076 ec00                            ORG     $EC00   ; Start of ROM based code
0077                         ; -----------------------------------------------------
0078 ec00 bd ed 2b           RD_CMD  JSR     RD_A    ; Input one character 
0079 ec03 27 fb                      BEQ     RD_CMD  ; Ignore paper tape follower
0080 ec05 8d 08                      BSR     PR_A    ; Echo character
0081 ec07 81 2e                      CMPA    #'.     ; Was it a fullstop ?
0082 ec09 26 03                      BNE     END_RD  ;
0083 ec0b 7e ef 8f                   JMP     START   ; Yes: Go to start of MINIMON
0084 ec0e 39                 END_RD  RTS             ;  No: RETURN
0085                         
0086                         ; -----------------------------------------------------
0087                         ; Print character in A
0088                         
0089 ec0f f6 f4 01           PR_A    LDAB    CTRLA   ; Get ACIA(a) status byte
0090 ec12 c5 02                      BITB    #02     ; Is it busy ?
0091 ec14 27 f9                      BEQ     PR_A    ; Yes: Try again
0092 ec16 b7 f4 00                   STAA    DATAA   ;  No: Send data
0093 ec19 7c f0 f5                   INC     T_R     ; Characters printed + One
0094 ec1c 39                         RTS             ; RETURN
0095                         
0096                         ; -----------------------------------------------------
0097                         ; Check A contains a HEX character,  Set C.bit on fail
0098                         
0099 ec1d 81 2f              VHEX    CMPA    #$2F    ; A < 30 ?
0100 ec1f 2f 0e                      BLE     NotHex  ;  not hex
0101 ec21 81 39                      CMPA    #$39    ; A > 39 ?    
0102 ec23 22 02                      BHI     NotNum  ;  Not a Numeral
0103 ec25 0c                 IsHex   CLC             ; It's OK (clear C bit)
0104 ec26 39                         RTS             ; RETURN
0105 ec27 81 40              NotNum  CMPA    #$40    ; A < 41 ?
0106 ec29 2f 04                      BLE     NotHex  ;  not hex
0107 ec2b 81 46                      CMPA    #$46    ; A <= 46
0108 ec2d 2f f6                      BLE     IsHex   ;  then it is hex
0109 ec2f 0d                 NotHex  SEC             ; Set C bit
0110 ec30 39                         RTS             ; RETURN
0111                         
0112                         ; -----------------------------------------------------
0113                         
0114 ec31 85 30              BINARY  BITA    #$30    ; Is it a letter ?
0115 ec33 27 0c                      BEQ     LETTA   ; Yes: Got to handle it
0116 ec35 48                 RIDA    ASLA            ;  No: It is a number, so
0117 ec36 48                         ASLA            ;      shift
0118 ec37 48                         ASLA            ;       left
0119 ec38 48                         ASLA            ;        4 bits
0120 ec39 c5 30                      BITB    #$30    ; Is Acc.B a letter ?
0121 ec3b 27 08                      BEQ     LETTB   ; Yes: Go handle it
0122 ec3d c4 0f              RIDB    ANDB    #$0F    ; Clear 4 high bits in Acc.B
0123 ec3f 1b                         ABA             ; Form binary character (A=A+B)
0124 ec40 39                         RTS             ; RETURN
0125 ec41 8b 09              LETTA   ADDA    #$09    ; Make Acc.A a binary
0126 ec43 20 f0                      BRA     RIDA    ;  as before
0127 ec45 cb 09              LETTB   ADDB    #$09    ; Make Acc.B a binary
0128 ec47 20 f4                      BRA     RIDB    ;  as before
0129                         
0130                         ; -----------------------------------------------------
0131                         ; Read a 4 digit HEX value, put result into X
0132                         
0133 ec49                            RMB 26
0134                         
0135                         ;ZIN     BSR     RD_CMD  ; Read a character
0136                         ;        BSR     VHEX    ; Is it a hex character ?
0137                         ;        BCS     Z_PRQM  ; No: go to print `?`
0138                         ;        STAA    T_Q     ; Yes: Save Acc.A
0139                         ;        BSR     RD_CMD  ; Read 2nd character
0140                         ;        BSR     VHEX    ; Is it a hex character ?
0141                         ;        BCS     Z_PRQM  ; No: go to print `?`
0142                         ;        TAB             ; Yes: Put it into Acc.B
0143                         ;        LDAA    T_Q     ; Retrieve 1st hex char to Acc.A
0144                         ;        BSR     BINARY  ; Convert A:B to binary
0145                         ;        RTS             ; RETURN
0146                         ;Z_PRQM  LDAA    #'?     ; Load `?` into A
0147                         ;        BSR     PR_A    ; Print it
0148                         ;        BRA     ZIN     ; Go back to start of hex input
0149                         
0150                         ; -----------------------------------------------------
0151                         ; Read 4 hex digits and put value into X
0152                         ;FC65
0153 ec63 bd ed 4d           RD_X    JSR     PRSP    ; Print a space
0154 ec66 bd ec d8                   JSR     ZIN     ; Read 2 digit hex value into A
0155 ec69 b7 f0 f3                   STAA    T_Z     ; Save byte (most significant)
0156 ec6c bd ec d8                   JSR     ZIN     ; Read 2 digit hex value into A
0157 ec6f b7 f0 f4                   STAA    T_Z+1   ; Save byte (least significant)
0158 ec72 fe f0 f3                   LDX     T_Z     ; Load full 4 hex value into X
0159 ec75 39                         RTS             ; RETURN
0160                         
0161                         ; -----------------------------------------------------
0162                         ; Print string FOLLOWING JSR ( terminated by $FF )
0163                         ;  IE: It starts at the `return addr` put onto the stack by JSR
0164                         ;  So actual return address needed is past the string
0165                         
0166                         ;fc76
0167 ec76 30                 STRING  TSX             ; Get loc. of return addr to X
0168 ec77 ee 00                      LDX     0,X     ; Get return addr to X
0169 ec79 09                         DEX             ; Point to byte before
0170 ec7a 08                 AGAIN   INX             ; Point to next byte
0171 ec7b a6 00                      LDAA    0,X     ; Get byte to be printed
0172 ec7d 81 ff                      CMPA    #$FF    ; End-string ?
0173 ec7f 27 04                      BEQ     ENDSTR  ; Yes: Go to finish up
0174 ec81 8d 8c                      BSR     PR_A    ; Print the byte
0175 ec83 20 f5                      BRA     AGAIN   ; Go back for next byte
0176 ec85 31                 ENDSTR  INS             ; Clean up stack...
0177 ec86 31                         INS             ;  ( pop off the return addr )
0178 ec87 6e 01                      JMP     1,X     ; Jump back to caller (RETURN)
0179                         
0180                         ; -----------------------------------------------------
0181                         ; 
0182 ec89 8d eb              GETADD  BSR     STRING  ; Print string...
0183 ec8b 20 53                      FCC     " S"    ;
0184 ec8d ff                         FCB     $FF     ; End-of-string
0185 ec8e 8d d3                      BSR     RD_X    ; Read 4 digit HEX addr value
0186 ec90 ff f0 ef                   STX     T_STRT  ; Save it
0187 ec93 8d e1                      BSR     STRING  ; Print string...
0188 ec95 20 46                      FCC     " F"    ;
0189 ec97 ff                         FCB     $FF     ; End-of-string
0190 ec98 8d c9                      BSR     RD_X    ; Read 4 digit HEX addr value
0191 ec9a ff f0 f1                   STX     T_STOP  ; Save it
0192 ec9d 39                         RTS             ; RETURN
0193                         
0194                         ; -----------------------------------------------------
0195                         ; Convert value in A to 2 x ASCII hex digits in A and B
0196                         
0197 ec9e 16                 ASCII   TAB             ; Copy A to B
0198 ec9f 84 f0                      ANDA    #$F0    ; Clear low order 4 bits of A
0199 eca1 44                         LSRA            ; Shift
0200 eca2 44                         LSRA            ;  right
0201 eca3 44                         LSRA            ;   4
0202 eca4 44                         LSRA            ;    bits
0203 eca5 81 09                      CMPA    #$09    ; Letter or number ?
0204 eca7 22 0b                      BHI     SUBT    ; 
0205 eca9 8b 30                      ADDA    #$30    ; Make it an ASCII number
0206 ecab c4 0f              AND     ANDB    #$0F    ; Clear high order bits of B
0207 ecad c1 09                      CMPB    #$09    ; Letter or number ?
0208 ecaf 22 07                      BHI     ADD     ;
0209 ecb1 cb 30                      ADDB    #$30    ; Make it an ASCII number
0210 ecb3 39                         RTS             ; RETURN
0211 ecb4 8b 37              SUBT    ADDA    #$37    ; Make it an ASCI letter
0212 ecb6 20 f3                      BRA     AND     ; Go to process low order value
0213 ecb8 cb 37              ADD     ADDB    #$37    ; Make it an ASII letter
0214 ecba 39                         RTS             ; RETURN
0215                         
0216                         ; -----------------------------------------------------
0217                         ; Print value in X as 4 hex digits
0218                         
0219 ecbb ff f0 ed           PRX     STX     T_TMPX  ; Save X
0220 ecbe b6 f0 ed                   LDAA    T_TMPX  ; Get high order byte to A
0221 ecc1 8d 06                      BSR     ZOUT    ; Print A as 2 hex digits
0222 ecc3 b6 f0 ee                   LDAA    T_TMPX+1 ; Get low order byte to A
0223 ecc6 8d 01                      BSR     ZOUT    ; Print A as 2 hex digits
0224 ecc8 39                         RTS             ; RETURN
0225                         
0226                         ; -----------------------------------------------------
0227                         ; Print value in A as 2 hex digits
0228                         
0229 ecc9 8d d3              ZOUT    BSR     ASCII   ; Convert A to ASCII in A & B
0230 eccb f7 f0 ec                   STAB    T_M     ; Save B
0231 ecce bd ec 0f                   JSR     PR_A    ; Print byte in A
0232 ecd1 b6 f0 ec                   LDAA    T_M     ; Get 2nd byte into A
0233 ecd4 bd ec 0f                   JSR     PR_A    ; Print byte in A
0234 ecd7 39                         RTS             ; RETURN
0235                         
0236                         ; -----------------------------------------------------
0237                         ;RD_HEX2 This is a new ZIN and is called RD_HEX2 on GruntMon
0238                         
0239 ecd8 bd ec 00           ZIN         JSR     RD_CMD      ; Read a character
0240 ecdb bd ec 1d                       JSR     VHEX        ; Is it a hex character ?
0241 ecde 25 1a                          BCS     Z_PRQM      ; No: go to print `?`
0242 ece0 b7 f0 f6                       STAA    T_Q         ; Save it
0243 ece3 bd ec 00                       JSR     RD_CMD      ; Read 2nd character
0244 ece6 bd ec 1d                       JSR     VHEX        ; Is it a hex character ?
0245 ece9 25 0f                          BCS     Z_PRQM      ; No: go to print `?`
0246 eceb 16                             TAB                 ; Yes: Put it into B
0247 ecec b6 f0 f6                       LDAA    T_Q         ; Retrieve 1st hex char to A
0248 ecef bd ec 31                       JSR     BINARY      ; Convert A:B to binary to A
0249 ecf2 16                             TAB                 ; B=A
0250 ecf3 fb f0 e0                       ADDB    b_Csum      ; Add this value
0251 ecf6 f7 f0 e0                       STAB    b_Csum      ; to the Checksum (for S19)
0252 ecf9 39                             RTS                 ; RETURN
0253 ecfa bd ec ff           Z_PRQM      JSR     PR_QM       ; Print "?"
0254 ecfd 20 d9                          BRA     ZIN     ; Go back to start of hex input
0255                         
0256 ecff 86 3f              PR_QM       LDAA #'?              ; Put '?' character in A
0257 ed01 bd ec 0f           PR_BYTE     JSR     PR_A    ; Print it
0258 ed04 39                             RTS             ; RETURN
0259                         
0260                         
0261                         PUNCH
0262                         LOAD
0263 ed05                            RMB 38
0264                         
0265                         ; -----------------------------------------------------
0266                         ; Read byte from ACIA.A to A
0267                         ;FD2B
0268 ed2b b6 f4 01           RD_A    LDAA    CTRLA   ; Get ACIA.A status byte
0269 ed2e 85 01                      BITA    #$01    ; Is byte ready in DATAA
0270 ed30 27 f9                      BEQ     RD_A    ; No: Try again
0271 ed32 b6 f4 00                   LDAA    DATAA   ; Get the data byte to A
0272 ed35 39                         RTS             ; RETURN
0273                         
0274                         ; -----------------------------------------------------
0275 ed36 8d 15              REGPRT  BSR     PRSP    ; Print a space
0276 ed38 fe f0 fd                   LDX     PSTACK  ; Point X at user's stack
0277 ed3b 8d 1c                      BSR     PR2     ; Print CC
0278 ed3d 8d 1a                      BSR     PR2     ; Print B
0279 ed3f 8d 18                      BSR     PR2     ; Print A
0280 ed41 8d 10                      BSR     PR4     ; Print X
0281 ed43 8d 0e                      BSR     PR4     ; Print PC
0282 ed45 ce f0 fd                   LDX     #PSTACK ; Point X at stack pointer
0283 ed48 8d 0a                      BSR     PR4X    ; Print stack pointer
0284 ed4a 7e ef 8f                   JMP     START   ; (RETURN) to MINIMON
0285                         
0286                         ; -----------------------------------------------------
0287 ed4d 86 20              PRSP    LDAA    #$20    ; Put space character in A
0288 ed4f bd ec 0f                   JSR     PR_A    ; Print it
0289 ed52 39                         RTS             ; RETURN
0290                         
0291 ed53 08                 PR4     INX             ; Point X to next character
0292 ed54 a6 00              PR4X    LDAA    0,X     ; Get byte pointed to by X
0293 ed56 bd ec c9                   JSR     ZOUT    ; Print it
0294 ed59 08                 PR2     INX             ; Point X to next character
0295 ed5a a6 00                      LDAA    0,X     ; Get byte pointed to by X
0296 ed5c bd ec c9                   JSR     ZOUT    ; Print it
0297 ed5f 8d ec                      BSR     PRSP    ; Print a space
0298 ed61 39                         RTS             ; RETURN
0299                         
0300                         ; -----------------------------------------------------
0301 ed62 bd ec 89           BLKMOV  JSR     GETADD  ; Prompt for boundary addresses
0302 ed65 bd ec 76                   JSR     STRING  ; Print string...
0303 ed68 20 54 6f                   FCC     " To"   ;
0304 ed6b ff                         FCB     $FF     ; End-of-string
0305 ed6c bd ec 63                   JSR     RD_X    ; Read 4 hex digit value into X
0306 ed6f ff f0 ea                   STX     T_NEW   ; Store it as NEW start address
0307 ed72 ff f0 e6                   STX     T_X     ;   "    "
0308 ed75 fe f0 ef                   LDX     T_STRT  ; Put start address into X
0309 ed78 ff f0 e8                   STX     T_Y     ; Store it
0310 ed7b 8d 59                      BSR     SUB     ; Perform T_X minus T_Y
0311 ed7d 2a 23                      BPL     DOWN    ; Go to Move downwards
0312 ed7f fe f0 f1                   LDX     T_STOP  ; Get the STOP stop address
0313 ed82 08                         INX             ; Add 1 to it
0314 ed83 ff f0 f1                   STX     T_STOP  ; and save it
0315 ed86 fe f0 ef           DO_UP   LDX     T_STRT  ; Get START address
0316 ed89 bc f0 f1                   CPX     T_STOP  ; Compare it with STOP
0317 ed8c 26 03                      BNE     CONT_A  ; Finished ?
0318 ed8e 7e ef 8f           STARTB  JMP     START   ; Yes: back to MINIMON
0319 ed91 a6 00              CONT_A  LDAA    0,X     ; No: Get data
0320 ed93 08                         INX             ; Point X to next `old` address
0321 ed94 ff f0 ef                   STX     T_STRT  ; and store it
0322 ed97 fe f0 ea                   LDX     T_NEW   ; get address of NEW location
0323 ed9a a7 00                      STAA    0,X     ; Store the data at NEW address
0324 ed9c 08                         INX             ; Point X to next `new` address
0325 ed9d ff f0 ea                   STX     T_NEW   ; and store it
0326 eda0 20 e4                      BRA     DO_UP   ; loop back for next byte
0327 eda2 fe f0 f1           DOWN    LDX     T_STOP  ; Get end address
0328 eda5 ff f0 e6                   STX     T_X     ; Store it
0329 eda8 8d 2c                      BSR     SUB     ; Perform T_X minus T_Y
0330 edaa bb f0 eb                   ADDA    T_NEW+1 ; Add NEW (low.byte) to A
0331 edad fb f0 ea                   ADDB    T_NEW   ; Add NEW (high.byte) to B
0332 edb0 b7 f0 eb                   STAA    T_NEW+1 ; Save NEW (low.byte)
0333 edb3 f7 f0 ea                   STAB    T_NEW   ;         (high.byte)
0334 edb6 fe f0 ef                   LDX     T_STRT  ; Get START address
0335 edb9 09                         DEX             ; Subract 1 from X
0336 edba ff f0 ef                   STX     T_STRT  ; Store it
0337 edbd fe f0 f1           DO_DOWN LDX     T_STOP  ; Get STOP address
0338 edc0 bc f0 ef                   CPX     T_STRT  ; Compare it with START address
0339 edc3 27 c9                      BEQ     STARTB  ; Effecively `JMP START`
0340 edc5 a6 00                      LDAA    0,X     ; Get data
0341 edc7 09                         DEX             ; Subract 1 from X
0342 edc8 ff f0 f1                   STX     T_STOP  ; Store it
0343 edcb fe f0 ea                   LDX     T_NEW   ; Load NEW loc address into X
0344 edce a7 00                      STAA    0,X     ; Store the data as NEW address
0345 edd0 09                         DEX             ; Point X to next `new` address
0346 edd1 ff f0 ea                   STX     T_NEW   ; Store it
0347 edd4 20 e7                      BRA     DO_DOWN ; Loop back for next byte
0348                         
0349                         ; -----------------------------------------------------
0350 edd6 ce f0 e6           SUB     LDX     #T_X    ; Point X to start of T_X data
0351 edd9 a6 01                      LDAA    1,X     ; A = T_X (low)
0352 eddb e6 00                      LDAB    0,X     ; B = T_X (high)
0353 eddd a0 03                      SUBA    3,X     ; A = A - T_Y (low)
0354 eddf e2 02                      SBCB    2,X     ; B = B - T_Y (high)
0355 ede1 39                         RTS             ; RETURN
0356                         
0357 ede2                            RMB 81          ; previously X and Z commands
0358                         
0359                         ; -----------------------------------------------------
0360                         ;FE33
0361 ee33 bd ec 76           PRP     JSR     STRING  ; Print string...
0362 ee36 20 50 20                   FCC     " P "   ;
0363 ee39 ff                         FCB     $FF     ; End-of-string
0364 ee3a 39                         RTS             ; RETURN
0365                         
0366                         ; -----------------------------------------------------
0367 ee3b bd ec 76           PRD     JSR     STRING  ; Print string...
0368 ee3e 20 44 20                   FCC     " D "   ;
0369 ee41 ff                         FCB     $FF     ; End-of-string
0370 ee42 39                         RTS             ; RETURN
0371                         
0372                         ; -----------------------------------------------------
0373 ee43 bd ec 63           MODIFY  JSR     RD_X    ; Get address to X
0374 ee46 bd ed 4d           STRT    JSR     PRSP    ; Print a space
0375 ee49 7f f0 f5                   CLR     T_R     ; T_R = 0
0376 ee4c a6 00              PRz     LDAA    0,X     ; Get byte pointed to by X to A
0377 ee4e bd ec c9                   JSR     ZOUT    ; Print it as 2.hex digits
0378 ee51 bd ec 00           WATSIT  JSR     RD_CMD  ; Get command character
0379 ee54 81 20              WHAT    CMPA    #$20    ; Is it a space ?
0380 ee56 26 0c                      BNE     ISSLSH  ; No: go test for slash
0381 ee58 08                 CARYON  INX             ; Increment X
0382 ee59 b6 f0 f5                   LDAA    T_R     ; A = T_R
0383 ee5c 81 16                      CMPA    #$16    ; At end of line ?
0384 ee5e 2f ec                      BLE     PRz     ; No: Loop back to continue
0385 ee60 8d 35              NEW_1   BSR     NEWLINE ; Print c/r l/f nul
0386 ee62 20 e2                      BRA     STRT    ; Loop back (Note: Hex was wrong in doc, E2 instead of E5)
0387                         
0388 ee64 81 2f              ISSLSH  CMPA    #'/     ; Is it a slash ?
0389 ee66 26 03                      BNE     ISCRET  ; No: go test for c/r
0390 ee68 09                         DEX             ; X = X - 1
0391 ee69 20 f5                      BRA     NEW_1   ; Loop back (print newline)
0392                         
0393 ee6b 81 0d              ISCRET  CMPA    #$0D    ; Is it a c/r ?
0394 ee6d 26 03                      BNE     ISHEX   ; No: go test for valid Hex
0395 ee6f 08                         INX             ; X = X + 1
0396 ee70 20 ee                      BRA     NEW_1   ; Loop back (print newline)
0397                         
0398 ee72 bd ec 1d           ISHEX   JSR     VHEX    ; Is it a valid hex character ?
0399 ee75 25 19                      BCS     PRQM    ; No: print `?` and ignore
0400 ee77 b7 f0 f6                   STAA    T_Q     ; T_Q = A : Save it
0401 ee7a bd ec 00                   JSR     RD_CMD  ; Get 2nd character
0402 ee7d bd ec 1d                   JSR     VHEX    ; Is it a valid hex character ?
0403 ee80 25 d2                      BCS     WHAT    ; No: then see what it is
0404 ee82 16                         TAB             ; B = A
0405 ee83 b6 f0 f6                   LDAA    T_Q     ; A = T_Q
0406 ee86 bd ec 31                   JSR     BINARY  ; Convert to binary value
0407 ee89 a7 00                      STAA    0,X     ; Store it
0408 ee8b bd ed 4d                   JSR     PRSP    ; Print a space
0409 ee8e 20 c8                      BRA     CARYON  ; Loop back
0410                         
0411 ee90 86 3f              PRQM    LDAA    #'?     ; Put `?` into A
0412 ee92 bd ec 0f                   JSR     PR_A    ; Print it
0413 ee95 20 ba                      BRA     WATSIT  ; Loop back
0414                         
0415 ee97 ff f0 e3           NEWLINE STX     T_SAVE  ; Save X
0416 ee9a bd ec 76                   JSR     STRING  ; Print string...
0417 ee9d 0d 0a 00                   FCB     $0D,$0A,$00
0418 eea0 ff                         FCB     $FF     ; End-of-string
0419 eea1 fe f0 e3                   LDX     T_SAVE  ; Restore X
0420 eea4 bd ec bb                   JSR     PRX     ; Print X
0421 eea7 39                         RTS             ; RETURN
0422                         
0423                         
0424 eea8                            RMB 26          ; previously the ALTER command
0425                         
0426                         ;FEC2
0427 eec2 bd ec 63           GO      JSR     RD_X    ; Get address to X (16.bit)
0428 eec5 bd ec 00                   JSR     RD_CMD  ; Right address ?
0429 eec8 b6 f0 f4                   LDAA    T_Z+1   ; T_Z.low to A
0430 eecb f6 f0 f3                   LDAB    T_Z     ; T_Z.high to B
0431 eece fe f0 fd           GOTO    LDX     PSTACK  ; Callers stack address to X
0432 eed1 a7 07                      STAA    7,X     ; Put new return
0433 eed3 e7 06                      STAB    6,X     ; address on stack
0434 eed5 be f0 fd                   LDS     PSTACK  ; Set up calling programs stack
0435 eed8 3b                         RTI             ; RETURN-FROM-INTERRUPT (SWI)
0436                         
0437 eed9 bd ec 00           CONTNU  JSR     RD_CMD  ; Read a byte (test for `.`)
0438 eedc 81 31                      CMPA    #'1     ; Is it `1` ?
0439 eede 26 10                      BNE     IsIt2  ; No: go test for `2`
0440 eee0 fe f0 f7                   LDX     T_ABYT  ; Get address of break.point
0441 eee3 b6 f0 fb                   LDAA    T_BYTE  ; Get saved opcode
0442 eee6 a7 00                      STAA    0,X     ; Put it back in the program
0443 eee8 b6 f0 f8                   LDAA    T_ABYT+1 ; Get address at which
0444 eeeb f6 f0 f7                   LDAB    T_ABYT  ;   to re-enter program
0445 eeee 20 de                      BRA     GOTO    ; Go to calling program
0446                         
0447 eef0 81 32              IsIt2   CMPA    #'2     ; Is it `2`
0448 eef2 27 03                      BEQ     G_Is2   ; Yes: go process it
0449 eef4 7e ef 8f                   JMP     START   ; No: Return to MINIMON
0450 eef7 fe f0 f9           G_Is2   LDX     T_ABYT+2 ; Get addr. of break.point 2
0451 eefa b6 f0 fc                   LDAA    T_BYTE+1 ; Get old opcode
0452 eefd a7 00                      STAA    0,X      ; Put it back
0453 eeff b6 f0 fa                   LDAA    T_ABYT+3 ; Load address to start
0454 ef02 f6 f0 f9                   LDAB    T_ABYT+2 ;  running program at
0455 ef05 20 c7                      BRA     GOTO    ; Run user program
0456                         
0457                         ; -----------------------------------------------------
0458 ef07 bd ec 89           DUMP    JSR     GETADD  ; Prompt for boundary addresses
0459 ef0a fe f0 ef                   LDX     T_STRT  ;
0460 ef0d bd ee 97           D_NEW   JSR     NEWLINE ; Print c/r l/f nul
0461 ef10 86 08                      LDAA    #$08    ;
0462 ef12 b7 f0 f6                   STAA    T_Q     ; T_Q = 8
0463 ef15 09                         DEX             ; X = X - 1
0464 ef16 08                 D_NXT   INX             ; X = X + 1
0465 ef17 bd ed 4d                   JSR     PRSP    ; Print a space
0466 ef1a a6 00                      LDAA    0,X     ; Get a byte
0467 ef1c bd ec c9                   JSR     ZOUT    ; Print it as 2.hex digits
0468 ef1f bc f0 f1                   CPX     T_STOP  ; Finished ?
0469 ef22 26 06                      BNE     D_CNT   ; No: Carry on
0470 ef24 b6 f4 00           D_END   LDAA    DATAA   ; Get a byte from ACIA (clear)
0471 ef27 7e ef 8f                   JMP     START   ; Return to MINIMON
0472 ef2a b6 f4 01           D_CNT   LDAA    CTRLA   ; Read ACIA status
0473 ef2d 85 01                      BITA    #$01    ; Stop dump ?
0474 ef2f 26 f3                      BNE     D_END   ; Yes; go clear ACIA etc
0475 ef31 7a f0 f6                   DEC     T_Q     ; New line needed ?
0476 ef34 26 e0                      BNE     D_NXT   ; No: Loop back
0477 ef36 08                         INX             ; Print next byte
0478 ef37 20 d4                      BRA     D_NEW   ;  on a new line
0479                         
0480                         ; -----------------------------------------------------
0481 ef39 bd ec 00           BRPTSET JSR     RD_CMD  ; Read a byte (test for `.`)
0482 ef3c 81 31                      CMPA    #'1     ; Is it `1` ?
0483 ef3e 26 12                      BNE     Is2b    ; No: go test for `2`
0484 ef40 bd ec 63                   JSR     RD_X    ; Read addr value into X
0485 ef43 a6 00                      LDAA    0,X     ; Get the opcode
0486 ef45 b7 f0 fb                   STAA    T_BYTE  ; Save it
0487 ef48 ff f0 f7                   STX     T_ABYT  ; and the address
0488 ef4b 86 3f              SAME    LDAA    #$3F    ; `SWI` opcode :
0489 ef4d a7 00                      STAA    0,X     ;   set the breakpoint
0490 ef4f 7e ef 8f           ENDB    JMP     START   ; Return to MINIMON
0491 ef52 81 32              Is2b    CMPA    #'2     ; Is it `2` ?
0492 ef54 26 f9                      BNE     ENDB   ; No: Return to MINIMON
0493 ef56 bd ec 63                   JSR     RD_X    ; Read address into X
0494 ef59 a6 00                      LDAA    0,X     ; Get opcode
0495 ef5b b7 f0 fc                   STAA    T_BYTE+1 ; Save it
0496 ef5e ff f0 f9                   STX     T_ABYT+2 ; Save address
0497 ef61 20 e8                      BRA     SAME    ; Set the breakpoint
0498                         
0499                         ; -----------------------------------------------------
0500                         ;ff63
0501 ef63 bd ec 76           HEADER  JSR     STRING  ; print string...
0502 ef66 20 43 43                   FCC     " CC"   ;
0503 ef69 20 42 20                   FCC     " B "   ;
0504 ef6c 20 41 20                   FCC     " A "   ;
0505 ef6f 20 20 58                   FCC     "  X"   ;
0506 ef72 20 20 20                   FCC     "   "   ;
0507 ef75 20 50 43                   FCC     " PC"   ;
0508 ef78 20 20 20                   FCC     "   "   ;
0509 ef7b 53 50                      FCC     "SP"    ;
0510 ef7d ff                         FCB     $FF     ; End-of-string
0511 ef7e 7e ef 8f                   JMP     START   ; Return to MINIMON
0512 ef81 8e f0 d0           RESET   LDS     #STACK  ; Set up stack for MINIMON
0513 ef84 86 03                      LDAA    #$03    ; Reset:
0514 ef86 b7 f4 01                   STAA    CTRLA   ;   ACIA.A
0515 ef89 b7 f4 03                   STAA    CTRLB   ;   ACIA.B
0516 ef8c bf f0 fd           SWI     STS     PSTACK  ; Save callers stack pointer
0517 ef8f 8e f0 d0           START   LDS     #STACK  ; Set up stack for MINMON
0518 ef92 86 11                      LDAA    #$11    ; Set up:
0519 ef94 b7 f4 01                   STAA    CTRLA   ;   ACIA.A
0520 ef97 bd ec 76                   JSR     STRING  ; Print string...
0521 ef9a 0d 0a 00 2a                FCB     $0D,$0A,$00,'*    ; c/r l/f null `*`
0522 ef9e ff                         FCB     $FF     ; End-of-string
0523 ef9f bd ec 00                   JSR     RD_CMD  ; Read a byte (test for `.`)
0524 efa2 81 53                      CMPA    #'S     ; Is it `S` ?
0525 efa4 27 93                      BEQ     BRPTSET ; Yes: Set breakpoint cmd
0526 efa6 81 48                      CMPA    #'H     ; Is it `H` ?
0527 efa8 27 b9                      BEQ     HEADER  ;
0528 efaa 81 50                      CMPA    #'P     ; Is it `P` ?
0529 efac 26 03                      BNE     L1      ; No: Skip
0530 efae 7e ed 05                   JMP     PUNCH   ;
0531 efb1 81 4c              L1      CMPA    #'L     ; Is it `L` ?
0532 efb3 26 03                      BNE     L2      ; No: Skip
0533 efb5 7e ed 05                   JMP     LOAD    ;
0534 efb8 81 52              L2      CMPA    #'R     ; Is it `R`
0535 efba 26 03                      BNE     L3      ; No: Skip
0536 efbc 7e ed 36                   JMP     REGPRT  ;
0537 efbf 81 42              L3      CMPA    #'B     ; Is it `B` ?
0538 efc1 26 03                      BNE     L6      ; No: Skip
0539 efc3 7e ed 62                   JMP     BLKMOV  ;
0540 efc6 81 4d              L6      CMPA    #'M     ; Is it `M` ?
0541 efc8 26 03                      BNE     L8      ; No: Skip
0542 efca 7e ee 43                   JMP     MODIFY  ;
0543 efcd 81 47              L8      CMPA    #'G     ; Is it `G` ?
0544 efcf 26 03                      BNE     L9      ; No: Skip
0545 efd1 7e ee c2                   JMP     GO      ;
0546 efd4 81 43              L9      CMPA    #'C     ; Is it `C` ?
0547 efd6 26 03                      BNE     L10     ; No: Skip
0548 efd8 7e ee d9                   JMP     CONTNU  ;
0549 efdb 81 44              L10     CMPA    #'D     ; Is it `D` ?
0550 efdd 26 b0                      BNE     START   ; No: Give up - ignore comand
0551 efdf 7e ef 07                   JMP     DUMP    ;
0552                         
0553                                 ; [JN] The code above ends at address FFF6 and
0554                                 ; there is no instruction at FFF7. Vectors
0555                                 ; start at FFF8 (see ORG statement below)
0556                                 ; Putting a NOP at FFF7 ensures there is no gap
0557                                 ; and allows for an easy conversion from s19 to
0558                                 ; binary.
0559 efe2 01                         NOP
0560                         
