                            141 
                            142 ; we cycle thought idle message when no one is on the scales, data comes in a one
                            143 ; second intervals so we simply increase the idle count until it's time to display
                            144 ; the next idle message
                            145 
   01FB 7F 1B B2      [ 6]  146 IDLE:   CLR     PROCESSING_FLG  ; clear the processing flag as no one
                            147                                 ;   is standing on the scales
   01FE 7C 1B AB      [ 6]  148         INC     IDLE_COUNT      ; increase the idle count
   0201 B6 1B AB      [ 4]  149         LDAA    IDLE_COUNT      ; see if idle count = max idle time
   0204 81 2D         [ 2]  150         CMPA    #IDLE_TICS      ; a data message appears every second
   0206 27 03         [ 4]  151         BEQ     IDLE1           ; not reached the max idle time
   0208 7E 01 66      [ 3]  152         JMP     MAINLOOP             ; nothing to do yet
                            153 
   020B BD FC 76      [ 9]  154 IDLE1:  JSR     STRING
