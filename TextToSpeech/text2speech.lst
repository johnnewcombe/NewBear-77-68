0374                         
0375                         ;PR_PHRASE
0376                         ;        LDAA    0,X         ; get word id
0377                         ;        INX                 ; point X to next word
0378                         ;        STX     T_P         ; store X away
0379                         ;        CMPA    #0
0380                         ;        BEQ     PR_END      ; no more words
0381                         ;        JSR     PR_WORD     ; print word based on value in A
0382                         ;        JSR     PR_SPCB
0383                         ;        LDX     T_P        ; recover X
0384                         ;        BRA     PR_PHRASE   ; next word
0385                         ;PR_END  RTS
0386                         
