output:  minimon-2026.s19
0001                         ; ----------------------------------------------------------------------------
0002                         ; Minimon (Jan. 2026)
0003                         ; ----------------------------------------------------------------------------
0004                         ; Original author ACH, Dec. 1978;
0005                         ; ----------------------------------------------------------------------------
0006                         ; This is an updated version of MINIMON with the LOAD and PUNCH commands
0007                         ; replaced for versions that support the Motorola S Record Format (.s19)
0008                         ; files.
0009                         ;
0010                         ; All entry points and source code labels as published in the MINIMON
0011                         ; documentation have been preserved with the exception of the LOAD and PUNCH
0012                         ; commands.
0013                         ;
0014                         ; In order to make space for the additional code required, the ALTER and
0015                         ; OFFSET CALCULATION commands have been removed. This has been justified as
0016                         ; the MODIFY command has very similar functionality to ALTER making ALTER
0017                         ; unnecessary, and the OFFSET CALCULATION routines (commands X and Y) are
0018                         ; rarely used as all cross-assemblers perform these calculations
0019                         ; automatically.
0020                         ;
0021                         ; One other minor change is that the terminal along with any devices sending
0022                         ; S19 format files should be configured for 8 Data Bits, No Parity, 2 Stop
0023                         ; Bits.
0024                         ;
0025                         ; ----------------------------------------------------------------------------
0026                         ; Updated by GlassTTY, Jan. 2026, using code from Motorola's Mikbug.
0027                         ; Thanks to Chris Carter for inspiration and help.
0028                         ; ----------------------------------------------------------------------------
0029                         
0030 f401                    CTRLA   EQU     $F401   ; ACIA.A Ctrl/Status
0031 f403                    CTRLB   EQU     $F403   ; ACIA.B Ctrl/Status
0032 f400                    DATAA   EQU     $F400   ; ACIA.A Data register
0033 f402                    DATAB   EQU     $F402   ; ACIA.B Data register
0034                         
0035                         ; -----------------------------------------------------
0036                         ; Note:The original 256 bytes of RAM on the CPU board
0037                         ;  appears at $F000 to $F0FE, with Switches/LEDs at $F0FF
0038                         ;  when a MON1 board is installed
0039                         ; -----------------------------------------------------
0040 f0dd                    JNMI    EQU     $F0DD   ; 3 bytes for jump to NMI sub.
0041 f0e0                    JIRQ    EQU     $F0E0   ; 3 bytes for jump to IRQ sub.
0042 f0d0                    STACK   EQU     $F0D0   ; tack goes down from $F0D0
0043                         
0044                         ; -----------------------------------------------------
0045 f0d1                            ORG     $F0D1
0046                         ; -----------------------------------------------------
0047                         
0048                         ; $F0D1 to $F0DC is unused RAM in original  MINIMON
0049 f0d1                    T_TW    RMB     2       ; New additions to support SRec
0050 f0d3                    T_CSUM  RMB     1       ;            "
0051 f0d4                    T_COUNT RMB     1       ;            "
0052 f0d5                    T_TEMP  RMB     1       ;            "
0053                         
0054                         ; -----------------------------------------------------
0055 f0e3                            ORG     $F0E3   ; Start of RAM variables
0056                         ; -----------------------------------------------------
0057                         
0058 f0e3                    T_SAVE  RMB     2       ; Temp storage for NEWLINE
0059 f0e5                    T_P     RMB     1       ;   "     "     "  Z,X
0060 f0e6                    T_X     RMB     2       ;   "     "     "  Sub
0061 f0e8                    T_Y     RMB     2       ;   "     "     "  Sub
0062 f0ea                    T_NEW   RMB     2       ;   "     "     "  Block move
0063 f0ec                    T_M     RMB     1       ;   "     "     "  ZOUT
0064 f0ed                    T_TMPX  RMB     2       ;   "     "     "  PRX
0065 f0ef                    T_STRT  RMB     2       ;   "     "     "  GETADDRESS
0066 f0f1                    T_STOP  RMB     2       ;   "     "     "  GETADDRESS
0067 f0f3                    T_Z     RMB     2       ;   "     "     "   . RDX
0068 f0f5                    T_R     RMB     1       ;   "     "     "     PR
0069 f0f6                    T_Q     RMB     1       ;   "     "     "  ZIN,DUMP 
0070 f0f7                    T_ABYT  RMB     2       ;   "     "     "  SET BR.PT.
0071 f0f9                            RMB     2       ;   "     "     "  SET BR.PT.
0072 f0fb                    T_BYTE  RMB     2       ;   "     "     "  SET BR.PT.
0073 f0fd                    PSTACK  RMB     2       ;   "     "     "     SWI etc
0074                         
0075                         ; -----------------------------------------------------
0076 fc00                            ORG     $FC00   ; Start of ROM based code
0077                         ; -----------------------------------------------------
0078                         
0079                         ; -----------------------------------------------------
0080                         ; Read Character from ACIA
0081                         ; FC00
0082                         ; -----------------------------------------------------
0083 fc00 bd fd 2b           RD_CMD  JSR     RD_A    ; Input one character
0084 fc03 27 fb                      BEQ     RD_CMD  ; Ignore paper tape follower
0085 fc05 8d 08                      BSR     PR_A    ; Echo character
0086 fc07 81 2e                      CMPA    #'.     ; Was it a fullstop ?
0087 fc09 26 11                      BNE     PRA_END ;
0088 fc0b 7e ff 8f                   JMP     START   ; Yes: Go to start of MINIMON
0089                         
0090 fc0e 01                         NOP
0091                         
0092                         ; -----------------------------------------------------
0093                         ; Print character in A
0094                         ; FC0F
0095                         ; -----------------------------------------------------
0096 fc0f f6 f4 01           PR_A    LDAB    CTRLA   ; Get ACIA(a) status byte
0097 fc12 c5 02                      BITB    #02     ; Is it busy ?
0098 fc14 27 f9                      BEQ     PR_A    ; Yes: Try again
0099 fc16 b7 f4 00                   STAA    DATAA   ;  No: Send data
0100 fc19 7c f0 f5                   INC     T_R     ; Characters printed + One
0101 fc1c 39                 PRA_END RTS             ; RETURN
0102                         
0103                         ; -----------------------------------------------------
0104                         ; Check A contains a HEX character,  Set C.bit on fail
0105                         ; FC1D
0106                         ; -----------------------------------------------------
0107 fc1d 81 2f              VHEX    CMPA    #$2F    ; A < 30 ?
0108 fc1f 2f 0e                      BLE     NotHex  ;  not hex
0109 fc21 81 39                      CMPA    #$39    ; A > 39 ?    
0110 fc23 22 02                      BHI     NotNum  ;  Not a Numeral
0111 fc25 0c                 IsHex   CLC             ; It's OK (clear C bit)
0112 fc26 39                         RTS             ; RETURN
0113 fc27 81 40              NotNum  CMPA    #$40    ; A < 41 ?
0114 fc29 2f 04                      BLE     NotHex  ;  not hex
0115 fc2b 81 46                      CMPA    #$46    ; A <= 46
0116 fc2d 2f f6                      BLE     IsHex   ;  then it is hex
0117 fc2f 0d                 NotHex  SEC             ; Set C bit
0118 fc30 39                         RTS             ; RETURN
0119                         
0120                         ; -----------------------------------------------------
0121                         ; Convert A:B to binary
0122                         ; FC31
0123                         ; -----------------------------------------------------
0124 fc31 85 30              BINARY  BITA    #$30    ; Is it a letter ?
0125 fc33 27 0c                      BEQ     LETTA   ; Yes: Got to handle it
0126 fc35 48                 RIDA    ASLA            ;  No: It is a number, so
0127 fc36 48                         ASLA            ;      shift
0128 fc37 48                         ASLA            ;       left
0129 fc38 48                         ASLA            ;        4 bits
0130 fc39 c5 30                      BITB    #$30    ; Is Acc.B a letter ?
0131 fc3b 27 08                      BEQ     LETTB   ; Yes: Go handle it
0132 fc3d c4 0f              RIDB    ANDB    #$0F    ; Clear 4 high bits in Acc.B
0133 fc3f 1b                         ABA             ; Form binary character (A=A+B)
0134 fc40 39                         RTS             ; RETURN
0135 fc41 8b 09              LETTA   ADDA    #$09    ; Make Acc.A a binary
0136 fc43 20 f0                      BRA     RIDA    ;  as before
0137 fc45 cb 09              LETTB   ADDB    #$09    ; Make Acc.B a binary
0138 fc47 20 f4                      BRA     RIDB    ;  as before
0139                         
0140                         ; -----------------------------------------------------
0141                         ; Read a 4 digit HEX value, put result into X
0142                         ; FC49
0143                         ; -----------------------------------------------------
0144 fc49 8d b5              ZIN     BSR     RD_CMD  ; Read a character
0145 fc4b 8d d0                      BSR     VHEX    ; Is it a hex character ?
0146 fc4d 25 10                      BCS     Z_PRQM  ; No: go to print `?`
0147 fc4f b7 f0 f6                   STAA    T_Q     ; Save it
0148 fc52 8d ac                      BSR     RD_CMD  ; Read 2nd character
0149 fc54 8d c7                      BSR     VHEX    ; Is it a hex character ?
0150 fc56 25 07                      BCS     Z_PRQM  ; No: go to print `?`
0151 fc58 16                         TAB             ; Yes: Put it into B
0152 fc59 b6 f0 f6                   LDAA    T_Q     ; Retrieve 1st hex char to A
0153 fc5c 7e fc d8                   JMP     ZIN2    ; S19 version of ZIN is longer
0154 fc5f bd fd 23           Z_PRQM  JSR     PR_QM   ; Print "?"
0155 fc62 7e fc 49                   JMP     ZIN     ; Go back to start of hex input
0156                         
0157                         ; -----------------------------------------------------
0158                         ; Read 4 hex digits and put value into X
0159                         ; FC65
0160                         ; -----------------------------------------------------
0161 fc65 bd fd 4d           RD_X    JSR     PRSP    ; Print a space
0162 fc68 8d df                      BSR     ZIN     ; Read 2 digit hex value into A
0163 fc6a b7 f0 f3                   STAA    T_Z     ; Save byte (most significant)
0164 fc6d 8d da                      BSR     ZIN     ; Read 2 digit hex value into A
0165 fc6f b7 f0 f4                   STAA    T_Z+1   ; Save byte (least significant)
0166 fc72 fe f0 f3                   LDX     T_Z     ; Load full 4 hex value into X
0167 fc75 39                         RTS             ; RETURN
0168                         
0169                         ; -----------------------------------------------------
0170                         ; Print string FOLLOWING JSR ( terminated by $FF )
0171                         ;  IE: It starts at the `return addr` put onto the stack by JSR
0172                         ;  So actual return address needed is past the string
0173                         ; FC76
0174                         ; -----------------------------------------------------
0175 fc76 30                 STRING  TSX             ; Get loc. of return addr to X
0176 fc77 ee 00                      LDX     0,X     ; Get return addr to X
0177 fc79 09                         DEX             ; Point to byte before
0178 fc7a 08                 AGAIN   INX             ; Point to next byte
0179 fc7b a6 00                      LDAA    0,X     ; Get byte to be printed
0180 fc7d 81 ff                      CMPA    #$FF    ; End-string ?
0181 fc7f 27 04                      BEQ     ENDSTR  ; Yes: Go to finish up
0182 fc81 8d 8c                      BSR     PR_A    ; Print the byte
0183 fc83 20 f5                      BRA     AGAIN   ; Go back for next byte
0184 fc85 31                 ENDSTR  INS             ; Clean up stack...
0185 fc86 31                         INS             ;  ( pop off the return addr )
0186 fc87 6e 01                      JMP     1,X     ; Jump back to caller (RETURN)
0187                         
0188                         ; -----------------------------------------------------
0189                         ; FC89
0190                         ; -----------------------------------------------------
0191 fc89 8d eb              GETADD  BSR     STRING  ; Print string...
0192 fc8b 20 53                      FCC     " S"    ;
0193 fc8d ff                         FCB     $FF     ; End-of-string
0194 fc8e 8d d5                      BSR     RD_X    ; Read 4 digit HEX addr value
0195 fc90 ff f0 ef                   STX     T_STRT  ; Save it
0196 fc93 8d e1                      BSR     STRING  ; Print string...
0197 fc95 20 46                      FCC     " F"    ;
0198 fc97 ff                         FCB     $FF     ; End-of-string
0199 fc98 8d cb                      BSR     RD_X    ; Read 4 digit HEX addr value
0200 fc9a ff f0 f1                   STX     T_STOP  ; Save it
0201 fc9d 39                         RTS             ; RETURN
0202                         
0203                         ; -----------------------------------------------------
0204                         ; Convert value in A to 2 x ASCII hex digits in A and B
0205                         ; FC9E
0206                         ; -----------------------------------------------------
0207 fc9e 16                 ASCII   TAB             ; Copy A to B
0208 fc9f 84 f0                      ANDA    #$F0    ; Clear low order 4 bits of A
0209 fca1 44                         LSRA            ; Shift
0210 fca2 44                         LSRA            ;  right
0211 fca3 44                         LSRA            ;   4
0212 fca4 44                         LSRA            ;    bits
0213 fca5 81 09                      CMPA    #$09    ; Letter or number ?
0214 fca7 22 0b                      BHI     SUBT    ; 
0215 fca9 8b 30                      ADDA    #$30    ; Make it an ASCII number
0216 fcab c4 0f              AND     ANDB    #$0F    ; Clear high order bits of B
0217 fcad c1 09                      CMPB    #$09    ; Letter or number ?
0218 fcaf 22 07                      BHI     ADD     ;
0219 fcb1 cb 30                      ADDB    #$30    ; Make it an ASCII number
0220 fcb3 39                         RTS             ; RETURN
0221 fcb4 8b 37              SUBT    ADDA    #$37    ; Make it an ASCI letter
0222 fcb6 20 f3                      BRA     AND     ; Go to process low order value
0223 fcb8 cb 37              ADD     ADDB    #$37    ; Make it an ASII letter
0224 fcba 39                         RTS             ; RETURN
0225                         
0226                         ; -----------------------------------------------------
0227                         ; Print value in X as 4 hex digits
0228                         ; FCBB
0229                         ; -----------------------------------------------------
0230 fcbb ff f0 ed           PRX     STX     T_TMPX  ; Save X
0231 fcbe b6 f0 ed                   LDAA    T_TMPX  ; Get high order byte to A
0232 fcc1 8d 06                      BSR     ZOUT    ; Print A as 2 hex digits
0233 fcc3 b6 f0 ee                   LDAA    T_TMPX+1; Get low order byte to A
0234 fcc6 20 01                      BRA     ZOUT    ; Print A as 2 hex digits
0235                         
0236 fcc8 01                         NOP
0237                         
0238                         ; -----------------------------------------------------
0239                         ; Print value in A as 2 hex digits, Preserve B
0240                         ; X unchanged by called routines
0241                         ; This is 1 byte shorter that original ZOUT
0242                         ; FCC9
0243                         ; -----------------------------------------------------
0244 fcc9 37                 ZOUT    PSHB            ; Save B to STACK
0245 fcca 36                         PSHA            ; Save A to STACK
0246 fccb 8d d1                      BSR     ASCII   ; Convert A to ASCII in A & B
0247 fccd 37                         PSHB            ; Save B (2nd byte) to STACK
0248 fcce bd fc 0f                   JSR     PR_A    ; Print byte in A
0249 fcd1 32                         PULA            ; Get 2nd byte into A from STACK
0250 fcd2 bd fc 0f                   JSR     PR_A    ; Print byte in A
0251 fcd5 32                         PULA            ; Recover A from STACK
0252 fcd6 33                         PULB            ; Recover B from STACK
0253 fcd7 39                         RTS             ; RETURN
0254                         
0255                         
0256                         ; second part of S19 version of ZIN
0257 fcd8 bd fc 31           ZIN2    JSR     BINARY  ; Convert A:B to binary to A
0258 fcdb 16                         TAB             ; B=A
0259 fcdc fb f0 d3                   ADDB    T_CSUM  ; Add this value
0260 fcdf f7 f0 d3                   STAB    T_CSUM  ; to the Checksum (for S19)
0261 fce2 39                         RTS             ; RETURN
0262                         
0263                         ; -----------------------------------------------------
0264                         ; S19 format data load : Modded version of Mikbug code
0265                         ; -----------------------------------------------------
0266 fce3                    LOAD    EQU     *       ; L = Load = Input an S19 file
0267 fce3 8d 91                      BSR     STRING
0268 fce5 0d 0a                      FCB     $0D,$0A ; c/r l/f
0269 fce7 ff                         FCB     $FF     ; End-Of-String
0270 fce8 bd fc 00           LREAD   JSR     RD_CMD  ; Read+Echo, test for '.'
0271 fceb 84 7f                      ANDA    #$7F    ; Mask off parity bit if it exists
0272 fced 81 53                      CMPA    #'S     ; Is it `S` ?
0273 fcef 26 f7                      BNE     LREAD   ; No: Keep waiting for `S`
0274 fcf1 bd fc 00                   JSR     RD_CMD  ; Read+Echo, test for '.'
0275 fcf4 81 39                      CMPA    #'9     ; Is it `9` ?  ( `S9` record )
0276 fcf6 26 03                      BNE     LREAD1
0277 fcf8 7e fe b3                   JMP     STERMR  ; handle termination record
0278 fcfb 81 31              LREAD1  CMPA    #'1     ; Is it `1` ?  ( `S1` record )
0279 fcfd 26 e9                      BNE     LREAD   ; No: Wait for next `S`
0280 fcff 7f f0 d3                   CLR     T_CSUM  ; Clear checksum
0281 fd02 bd fc 49                   JSR     ZIN     ; Read 2xHex = data.byte count to A
0282 fd05 80 02                      SUBA    #2      ; Subtract 2 (to get bytes left in line)
0283 fd07 b7 f0 d4                   STAA    T_COUNT ; Store byte count
0284 fd0a bd fc 65                   JSR     RD_X    ; Read 4xHex digit address to X
0285 fd0d bd fc 49           LDOBYT  JSR     ZIN     ; Read 2xHex digits, value to A
0286 fd10 7a f0 d4                   DEC     T_COUNT ; Decrement our byte count
0287 fd13 27 05                      BEQ     LCHK    ; If end-of-line, go look at checksum
0288 fd15 a7 00                      STAA    0,X     ; Save byte where X points
0289 fd17 08                         INX             ; Point X at next byte
0290 fd18 20 f3                      BRA     LDOBYT  ; Go get next byte
0291 fd1a 7c f0 d3           LCHK    INC     T_CSUM  ; Add 1 to checksum
0292 fd1d 27 c9                      BEQ     LREAD   ; OK: Go read next record
0293 fd1f 8d 02                      BSR     PR_QM   ; Print "?"
0294 fd21 20 27                      BRA     STARTR  ; Go to START
0295                         
0296 fd23 86 3f              PR_QM   LDAA #'?        ; Put '?' character in A
0297 fd25 7e fc 0f                   JMP     PR_A    ; Print it and return via PR_As RTS
0298                         
0299 fd28 01                         NOP
0300 fd29 01                         NOP
0301 fd2a 01                         NOP
0302                         
0303                         ; -----------------------------------------------------
0304                         ; Read byte from ACIA.A to A
0305                         ; FD2B
0306                         ; -----------------------------------------------------
0307 fd2b b6 f4 01           RD_A    LDAA    CTRLA   ; Get ACIA.A status byte
0308 fd2e 85 01                      BITA    #$01    ; Is byte ready in DATAA
0309 fd30 27 f9                      BEQ     RD_A    ; No: Try again
0310 fd32 b6 f4 00                   LDAA    DATAA   ; Get the data byte to A
0311 fd35 39                         RTS             ; RETURN
0312                         
0313                         ; -----------------------------------------------------
0314                         ; FD36
0315                         ; -----------------------------------------------------
0316 fd36 8d 15              REGPRT  BSR     PRSP    ; Print a space
0317 fd38 fe f0 fd                   LDX     PSTACK  ; Point X at user's stack
0318 fd3b 8d 1c                      BSR     PR2     ; Print CC
0319 fd3d 8d 1a                      BSR     PR2     ; Print B
0320 fd3f 8d 18                      BSR     PR2     ; Print A
0321 fd41 8d 10                      BSR     PR4     ; Print X
0322 fd43 8d 0e                      BSR     PR4     ; Print PC
0323 fd45 ce f0 fd                   LDX     #PSTACK ; Point X at stack pointer
0324 fd48 8d 0a                      BSR     PR4X    ; Print stack pointer
0325 fd4a 20 42              STARTR  BRA     STARTB  ; (RETURN) to MINIMON
0326                         
0327 fd4c 01                         NOP
0328                         
0329                         ; -----------------------------------------------------
0330                         ; FD4D
0331                         ; -----------------------------------------------------
0332 fd4d 86 20              PRSP    LDAA    #$20    ; Put space character in A
0333 fd4f bd fc 0f                   JSR     PR_A    ; Print it
0334 fd52 39                         RTS             ; RETURN
0335 fd53 08                 PR4     INX             ; Point X to next character
0336 fd54 a6 00              PR4X    LDAA    0,X     ; Get byte pointed to by X
0337 fd56 bd fc c9                   JSR     ZOUT    ; Print it
0338 fd59 08                 PR2     INX             ; Point X to next character
0339 fd5a a6 00                      LDAA    0,X     ; Get byte pointed to by X
0340 fd5c bd fc c9                   JSR     ZOUT    ; Print it
0341 fd5f 8d ec                      BSR     PRSP    ; Print a space
0342 fd61 39                         RTS             ; RETURN
0343                         
0344                         ; -----------------------------------------------------
0345                         ; FD62
0346                         ; -----------------------------------------------------
0347 fd62 bd fc 89           BLKMOV  JSR     GETADD  ; Prompt for boundary addresses
0348 fd65 bd fc 76                   JSR     STRING  ; Print string...
0349 fd68 20 54 6f                   FCC     " To"   ;
0350 fd6b ff                         FCB     $FF     ; End-of-string
0351 fd6c bd fc 65                   JSR     RD_X    ; Read 4 hex digit value into X
0352 fd6f ff f0 ea                   STX     T_NEW   ; Store it as NEW start address
0353 fd72 ff f0 e6                   STX     T_X     ;   "    "
0354 fd75 fe f0 ef                   LDX     T_STRT  ; Put start address into X
0355 fd78 ff f0 e8                   STX     T_Y     ; Store it
0356 fd7b 8d 59                      BSR     SUB     ; Perform T_X minus T_Y
0357 fd7d 2a 22                      BPL     DOWN    ; Go to Move downwards
0358 fd7f fe f0 f1                   LDX     T_STOP  ; Get the STOP stop address
0359 fd82 08                         INX             ; Add 1 to it
0360 fd83 ff f0 f1                   STX     T_STOP  ; and save it
0361 fd86 fe f0 ef           DO_UP   LDX     T_STRT  ; Get START address
0362 fd89 bc f0 f1                   CPX     T_STOP  ; Compare it with STOP
0363 fd8c 26 02                      BNE     CONT_A  ; Finished ?
0364 fd8e 20 ba              STARTB  BRA     STARTR  ; Yes: back to MINIMON
0365 fd90 a6 00              CONT_A  LDAA    0,X     ; No: Get data
0366 fd92 08                         INX             ; Point X to next `old` address
0367 fd93 ff f0 ef                   STX     T_STRT  ; and store it
0368 fd96 fe f0 ea                   LDX     T_NEW   ; get address of NEW location
0369 fd99 a7 00                      STAA    0,X     ; Store the data at NEW address
0370 fd9b 08                         INX             ; Point X to next `new` address
0371 fd9c ff f0 ea                   STX     T_NEW   ; and store it
0372 fd9f 20 e5                      BRA     DO_UP   ; loop back for next byte
0373 fda1 fe f0 f1           DOWN    LDX     T_STOP  ; Get end address
0374 fda4 ff f0 e6                   STX     T_X     ; Store it
0375 fda7 8d 2d                      BSR     SUB     ; Perform T_X minus T_Y
0376 fda9 bb f0 eb                   ADDA    T_NEW+1 ; Add NEW (low.byte) to A
0377 fdac fb f0 ea                   ADDB    T_NEW   ; Add NEW (high.byte) to B
0378 fdaf b7 f0 eb                   STAA    T_NEW+1 ; Save NEW (low.byte)
0379 fdb2 f7 f0 ea                   STAB    T_NEW   ;         (high.byte)
0380 fdb5 fe f0 ef                   LDX     T_STRT  ; Get START address
0381 fdb8 09                         DEX             ; Subract 1 from X
0382 fdb9 ff f0 ef                   STX     T_STRT  ; Store it
0383 fdbc fe f0 f1           DO_DOWN LDX     T_STOP  ; Get STOP address
0384 fdbf bc f0 ef                   CPX     T_STRT  ; Compare it with START address
0385 fdc2 27 ca                      BEQ     STARTB  ; Effecively `JMP START`
0386 fdc4 a6 00                      LDAA    0,X     ; Get data
0387 fdc6 09                         DEX             ; Subract 1 from X
0388 fdc7 ff f0 f1                   STX     T_STOP  ; Store it
0389 fdca fe f0 ea                   LDX     T_NEW   ; Load NEW loc address into X
0390 fdcd a7 00                      STAA    0,X     ; Store the data as NEW address
0391 fdcf 09                         DEX             ; Point X to next `new` address
0392 fdd0 ff f0 ea                   STX     T_NEW   ; Store it
0393 fdd3 20 e7                      BRA     DO_DOWN ; Loop back for next byte
0394                         
0395 fdd5 01                         NOP
0396                         
0397                         ; -----------------------------------------------------
0398                         ; FDD6
0399                         ; -----------------------------------------------------
0400 fdd6 ce f0 e6           SUB     LDX     #T_X    ; Point X to start of T_X data
0401 fdd9 a6 01                      LDAA    1,X     ; A = T_X (low)
0402 fddb e6 00                      LDAB    0,X     ; B = T_X (high)
0403 fddd a0 03                      SUBA    3,X     ; A = A - T_Y (low)
0404 fddf e2 02                      SBCB    2,X     ; B = B - T_Y (high)
0405 fde1 39                         RTS             ; RETURN
0406                         
0407                         ; -----------------------------------------------------
0408                         ; S format data output : Modded version of Mikbug code
0409                         ; -----------------------------------------------------
0410 fde2 bd fc 89           PUNCH   JSR     GETADD      ; Prompt for "Start:","Stop:"
0411 fde5 fe f0 ef                   LDX     T_STRT      ; Get start address
0412 fde8 ff f0 d1                   STX     T_TW        ; save it to work area
0413 fdeb b6 f0 f2           POUT1   LDAA    T_STOP+1    ; get low order of end address
0414 fdee b0 f0 d2                   SUBA    T_TW+1      ; Subtract low order start
0415 fdf1 f6 f0 f1                   LDAB    T_STOP      ; ( carry not affected by LDA )
0416 fdf4 f2 f0 d1                   SBCB    T_TW        ; Subtract with Carry
0417 fdf7 26 04                      BNE     POUT2
0418 fdf9 81 10                      CMPA    #16
0419 fdfb 25 02                      BCS     POUT3
0420 fdfd 86 0f              POUT2   LDAA    #15
0421 fdff 8b 04              POUT3   ADDA    #4
0422 fe01 b7 f0 d4                   STAA    T_COUNT     ; FRAME COUNT THIS RECORD
0423 fe04 80 03                      SUBA    #3
0424 fe06 b7 f0 d5                   STAA    T_TEMP      ; BYTE COUNT THIS RECORD
0425 fe09 bd fc 76                   JSR     STRING      ; Output this string...
0426 fe0c 0d 0a                      FCB     $0D,$0A     ; c/r l/f
0427 fe0e 53 31                      FCB     'S,'1       ; S1
0428 fe10 ff                         FCB     $FF         ; End-Of-String
0429 fe11 5f                         CLRB                ; Clear checksum
0430                         
0431                         ; Output frame count...
0432 fe12 ce f0 d4                   LDX     #T_COUNT    ; X = Address of Framecount
0433 fe15 bd fe a8                   JSR     POUTH2      ; O/P byte <-X and inc X
0434                         
0435                         ; Output address...
0436 fe18 ce f0 d1                   LDX     #T_TW
0437 fe1b bd fe a8                   JSR     POUTH2      ; O/P byte <-X and inc X
0438 fe1e bd fe a8                   JSR     POUTH2      ; O/P byte <-X and inc X
0439                         
0440                         ; Output data...
0441 fe21 fe f0 d1                   LDX     T_TW
0442 fe24 bd fe a8           POUT4   JSR     POUTH2      ; O/P byte <-X and inc X
0443 fe27 7a f0 d5                   DEC     T_TEMP      ; Decrement `bytes left` count
0444 fe2a 26 f8                      BNE     POUT4       ; Loop back if any left
0445 fe2c ff f0 d1                   STX     T_TW
0446 fe2f 53                         COMB
0447 fe30 37                         PSHB
0448 fe31 30                         TSX                ; X = S + 1
0449 fe32 8d 74                      BSR     POUTH2     ; PUNCH CHECKSUM
0450 fe34 33                         PULB
0451 fe35 fe f0 d1                   LDX     T_TW
0452 fe38 09                         DEX
0453 fe39 bc f0 f1                   CPX     T_STOP
0454 fe3c 26 ad                      BNE     POUT1
0455 fe3e 7e ff d9                   JMP     STERMS
0456                         
0457 fe41 01                         NOP
0458 fe42 01                         NOP
0459                         
0460                         ; -----------------------------------------------------
0461                         ; FE43
0462                         ; -----------------------------------------------------
0463 fe43 bd fc 65           MODIFY  JSR     RD_X    ; Get address to X
0464 fe46 bd fd 4d           STRT    JSR     PRSP    ; Print a space
0465 fe49 7f f0 f5                   CLR     T_R     ; T_R = 0
0466 fe4c a6 00              PRz     LDAA    0,X     ; Get byte pointed to by X to A
0467 fe4e bd fc c9                   JSR     ZOUT    ; Print it as 2.hex digits
0468 fe51 bd fc 00           WATSIT  JSR     RD_CMD  ; Get command character
0469 fe54 81 20              WHAT    CMPA    #$20    ; Is it a space ?
0470 fe56 26 0c                      BNE     ISSLSH  ; No: go test for slash
0471 fe58 08                 CARYON  INX             ; Increment X
0472 fe59 b6 f0 f5                   LDAA    T_R     ; A = T_R
0473 fe5c 81 16                      CMPA    #$16    ; At end of line ?
0474 fe5e 2f ec                      BLE     PRz     ; No: Loop back to continue
0475 fe60 8d 35              NEW_1   BSR     NEWLINE ; Print c/r l/f nul
0476 fe62 20 e2                      BRA     STRT    ; Loop back (Note: Hex was wrong in doc, E2 instead of E5)
0477                         
0478 fe64 81 2f              ISSLSH  CMPA    #'/     ; Is it a slash ?
0479 fe66 26 03                      BNE     ISCRET  ; No: go test for c/r
0480 fe68 09                         DEX             ; X = X - 1
0481 fe69 20 f5                      BRA     NEW_1   ; Loop back (print newline)
0482                         
0483 fe6b 81 0d              ISCRET  CMPA    #$0D    ; Is it a c/r ?
0484 fe6d 26 03                      BNE     ISHEX   ; No: go test for valid Hex
0485 fe6f 08                         INX             ; X = X + 1
0486 fe70 20 ee                      BRA     NEW_1   ; Loop back (print newline)
0487                         
0488 fe72 bd fc 1d           ISHEX   JSR     VHEX    ; Is it a valid hex character ?
0489 fe75 25 19                      BCS     PRQM    ; No: print `?` and ignore
0490 fe77 b7 f0 f6                   STAA    T_Q     ; T_Q = A : Save it
0491 fe7a bd fc 00                   JSR     RD_CMD  ; Get 2nd character
0492 fe7d bd fc 1d                   JSR     VHEX    ; Is it a valid hex character ?
0493 fe80 25 d2                      BCS     WHAT    ; No: then see what it is
0494 fe82 16                         TAB             ; B = A
0495 fe83 b6 f0 f6                   LDAA    T_Q     ; A = T_Q
0496 fe86 bd fc 31                   JSR     BINARY  ; Convert to binary value
0497 fe89 a7 00                      STAA    0,X     ; Store it
0498 fe8b bd fd 4d                   JSR     PRSP    ; Print a space
0499 fe8e 20 c8                      BRA     CARYON  ; Loop back
0500                         
0501 fe90 86 3f              PRQM    LDAA    #'?     ; Put `?` into A
0502 fe92 bd fc 0f                   JSR     PR_A    ; Print it
0503 fe95 20 ba                      BRA     WATSIT  ; Loop back
0504                         
0505 fe97 ff f0 e3           NEWLINE STX     T_SAVE  ; Save X
0506 fe9a bd fc 76                   JSR     STRING  ; Print string...
0507 fe9d 0d 0a 00                   FCB     $0D,$0A,$00
0508 fea0 ff                         FCB     $FF     ; End-of-string
0509 fea1 fe f0 e3                   LDX     T_SAVE  ; Restore X
0510 fea4 bd fc bb                   JSR     PRX     ; Print X
0511 fea7 39                         RTS             ; RETURN
0512                         
0513 fea8 eb 00              POUTH2 ADDB    0,X      ; Update checksum
0514 feaa 36                         PSHA            ; Push A to STACK
0515 feab a6 00                      LDAA    0,X     ; Load byte to be o/p
0516 fead bd fc c9                   JSR     ZOUT    ; O/P byte <- X
0517 feb0 32                         PULA            ; Pull A off STACK
0518 feb1 08                         INX             ; Increment X
0519 feb2 39                         RTS             ; RETURN
0520                         
0521                         ; Processes the termination record which, if we get here is an S9 record
0522                         ; A will contain the umber of bytes to follow (should be 39h i.e. ASCII '9')
0523                         ; which means there are left to absorb.
0524 feb3 ce 00 08           STERMR  LDX     #8      ; get the number of bytes left in record
0525 feb6 bd fc 00           STERM1  JSR     RD_CMD  ; read and echo from ACIA and ignore
0526 feb9 09                         DEX
0527 feba 26 fa                      BNE     STERM1   ; loop for remaining bytes
0528 febc 7e ff 8f           STARTS  JMP     START
0529                         
0530 febf 01                         NOP
0531 fec0 01                         NOP
0532 fec1 01                         NOP
0533                         
0534                         ; -----------------------------------------------------
0535                         ; FEC2
0536                         ; -----------------------------------------------------
0537 fec2 bd fc 65           GO      JSR     RD_X    ; Get address to X (16.bit)
0538 fec5 bd fc 00                   JSR     RD_CMD  ; Right address ?
0539 fec8 b6 f0 f4                   LDAA    T_Z+1   ; T_Z.low to A
0540 fecb f6 f0 f3                   LDAB    T_Z     ; T_Z.high to B
0541 fece fe f0 fd           GOTO    LDX     PSTACK  ; Callers stack address to X
0542 fed1 a7 07                      STAA    7,X     ; Put new return
0543 fed3 e7 06                      STAB    6,X     ; address on stack
0544 fed5 be f0 fd                   LDS     PSTACK  ; Set up calling programs stack
0545 fed8 3b                         RTI             ; RETURN-FROM-INTERRUPT (SWI)
0546                         
0547                         ; -----------------------------------------------------
0548                         ; FED9
0549                         ; -----------------------------------------------------
0550 fed9 bd fc 00           CONTNU  JSR     RD_CMD  ; Read a byte (test for `.`)
0551 fedc 81 31                      CMPA    #'1     ; Is it `1` ?
0552 fede 26 10                      BNE     IsIt2  ; No: go test for `2`
0553 fee0 fe f0 f7                   LDX     T_ABYT  ; Get address of break.point
0554 fee3 b6 f0 fb                   LDAA    T_BYTE  ; Get saved opcode
0555 fee6 a7 00                      STAA    0,X     ; Put it back in the program
0556 fee8 b6 f0 f8                   LDAA    T_ABYT+1 ; Get address at which
0557 feeb f6 f0 f7                   LDAB    T_ABYT  ;   to re-enter program
0558 feee 20 de                      BRA     GOTO    ; Go to calling program
0559                         
0560 fef0 81 32              IsIt2   CMPA    #'2     ; Is it `2`
0561 fef2 27 03                      BEQ     G_Is2   ; Yes: go process it
0562 fef4 7e ff 8f                   JMP     START   ; No: Return to MINIMON
0563 fef7 fe f0 f9           G_Is2   LDX     T_ABYT+2 ; Get addr. of break.point 2
0564 fefa b6 f0 fc                   LDAA    T_BYTE+1 ; Get old opcode
0565 fefd a7 00                      STAA    0,X      ; Put it back
0566 feff b6 f0 fa                   LDAA    T_ABYT+3 ; Load address to start
0567 ff02 f6 f0 f9                   LDAB    T_ABYT+2 ;  running program at
0568 ff05 20 c7                      BRA     GOTO    ; Run user program
0569                         
0570                         ; -----------------------------------------------------
0571                         ; FF07
0572                         ; -----------------------------------------------------
0573 ff07 bd fc 89           DUMP    JSR     GETADD  ; Prompt for boundary addresses
0574 ff0a fe f0 ef                   LDX     T_STRT  ;
0575 ff0d bd fe 97           D_NEW   JSR     NEWLINE ; Print c/r l/f nul
0576 ff10 86 08                      LDAA    #$08    ;
0577 ff12 b7 f0 f6                   STAA    T_Q     ; T_Q = 8
0578 ff15 09                         DEX             ; X = X - 1
0579 ff16 08                 D_NXT   INX             ; X = X + 1
0580 ff17 bd fd 4d                   JSR     PRSP    ; Print a space
0581 ff1a a6 00                      LDAA    0,X     ; Get a byte
0582 ff1c bd fc c9                   JSR     ZOUT    ; Print it as 2.hex digits
0583 ff1f bc f0 f1                   CPX     T_STOP  ; Finished ?
0584 ff22 26 06                      BNE     D_CNT   ; No: Carry on
0585 ff24 b6 f4 00           D_END   LDAA    DATAA   ; Get a byte from ACIA (clear)
0586 ff27 7e ff 8f                   JMP     START   ; Return to MINIMON
0587 ff2a b6 f4 01           D_CNT   LDAA    CTRLA   ; Read ACIA status
0588 ff2d 85 01                      BITA    #$01    ; Stop dump ?
0589 ff2f 26 f3                      BNE     D_END   ; Yes; go clear ACIA etc
0590 ff31 7a f0 f6                   DEC     T_Q     ; New line needed ?
0591 ff34 26 e0                      BNE     D_NXT   ; No: Loop back
0592 ff36 08                         INX             ; Print next byte
0593 ff37 20 d4                      BRA     D_NEW   ;  on a new line
0594                         
