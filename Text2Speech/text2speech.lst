   0016                      28 HEAVY_MSG_ID:    .rmb     1       ; holds value of next heavy weight message to use
   0017                      29 SHEAVY_MSG_ID:   .rmb     1       ; holds value of next super heavy weight message to use
   0018                      30 PROCESSING_FLG:  .rmb     1       ; non-zero indicates that that a weight is being processed
