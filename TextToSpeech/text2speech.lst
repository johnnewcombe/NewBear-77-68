0066 011e bd 02 7b                   JSR     STRINGB
0067 0121 59 6f 75 20 77 65          FCC     "You weigh"
     69 67 68
0068 012a 00                         FCB     $00
0069 012b fe 19 51                   LDX     T_WEIGHT        ; restore X
0070 012e bd 02 fb                   JSR     PR_WEIGHT       ; weight back X so output the weight
0071                         
