0083 0279 7c 06 a7           IDLE    INC     IDLE_COUNT      ; increase the idle count
0084 027c b6 06 a7                   LDAA    IDLE_COUNT      ; see if idle count = max idle time
0085 027f 81 5a                      CMPA    #IDLE_SECS      ; a data message appears every second
0086 0281 26 79                      BNE     END             ; not reached the max idle time
0087 0283 7f 06 a7                   CLR     IDLE_COUNT      ; time to output an idle message so reset the count
