0334                         ; -----------------------------------------------------
0335                         ; Prints the message " n stones n pounds"
0336                         ; place stones in MSB of X and pound in LSB
0337                         ; -----------------------------------------------------
0338                         PR_WEIGHT
0339 03da ff 19 65                   STX     T_W
0340 03dd b6 19 65                   LDAA    T_W             ; Load high byte of X into Accumulator A
0341 03e0 bd 04 49                   JSR     PR_WORD         ; n
0342 03e3 bd 04 00                   JSR     PR_SPCB
0343 03e6 86 1b                      LDAA    #$1B
0344 03e8 bd 04 49                   JSR     PR_WORD         ; "stones"
0345 03eb bd 04 00                   JSR     PR_SPCB
0346 03ee b6 19 66                   LDAA    T_W+1            ; Load high byte of X into Accumulator A
0347 03f1 bd 04 49                   JSR     PR_WORD         ; n
0348 03f4 86 1c                      LDAA    #$1C
0349 03f6 bd 04 00                   JSR     PR_SPCB
0350 03f9 bd 04 49                   JSR     PR_WORD         ; "pounds"
0351 03fc bd 04 0b                   JSR     PR_CRB
0352 03ff 39                         RTS
