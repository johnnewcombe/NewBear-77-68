                            195 ;END:     JMP     MAINLOOP  ;START   ; all done
                            196 
                            197 ;--------------------------------------------------------------
                            198 ; Gets the weight data from the scales and rerurns with carry
                            199 ; set if a valid reading, carry clear otherwise. A valid weight
                            200 ; reading resets the idle count. Data received is stored in
                            201 ; T_WEIGHT and MSB in A.
                            202 ;--------------------------------------------------------------
   024D                     203 GETDATA:
   024D BD 02 D7      [ 9]  204         JSR     RD_XB           ; read 4 hex characters into X
   0250 FF 19 64      [ 6]  205         STX     T_WEIGHT        ; store X
   0253 0C            [ 2]  206         CLC
   0254 B6 19 64      [ 4]  207         LDAA    T_WEIGHT        ; get fist byte (stones)
   0257 27 04         [ 4]  208         BEQ     GDDONE          ; idle message
   0259 7F 00 0A      [ 6]  209         CLR     IDLE_SECS       ; not an idle message so reset the idle counter
   025C 0D            [ 2]  210         SEC                     ; non idle message return with carry set
   025D 39            [ 5]  211 GDDONE:  RTS
