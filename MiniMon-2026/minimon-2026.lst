0419 fe21 fe f0 de                       LDX     d_TW
0420 fe24 bd fe a8           .fOut4      JSR     .fOutHx2    ; O/P byte <-X and inc X
0421 fe27 7a f0 e2                       DEC     b_Temp      ; Decrement `bytes left` count
0422 fe2a 26 f8                          BNE     .fOut4      ; Loop back if any left
0423 fe2c ff f0 de                       STX     d_TW
0424 fe2f 53                             COMB
0425 fe30 37                             PSHB
0426 fe31 30                             TSX                 ; X = S + 1
0427 fe32 8d 74                          BSR     .fOutHx2    ; PUNCH CHECKSUM
0428 fe34 33                             PULB
0429 fe35 fe f0 de                       LDX     d_TW
0430 fe38 09                             DEX
0431 fe39 bc f0 f1                       CPX     T_STOP
0432 fe3c 26 ad                          BNE     .fOut1
0433 fe3e bd fd 23                       JSR     STARTS      ;Go to START (via `S` code)
0434 fe41 20 65                          BRA     .fOutHx2
