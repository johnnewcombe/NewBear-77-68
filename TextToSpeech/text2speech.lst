                            280 ; Prints a string pointed to by X
                            281 ; -----------------------------------------------------
   0291 A6 00         [ 5]  282 STRINGBX:    LDAA    0,X         ; get char
   0293 81 FF         [ 2]  283             CMPA    #0xFF        ; is character NULL?
   0295 27 08         [ 4]  284             BEQ     DONEB       ; yes, end of string
   0297 BD FC 0F      [ 9]  285             JSR     PR_A        ; Print the byte to ACIA(a) (A is maintained)
   029A 8D 2F         [ 8]  286             BSR     PR_B        ; Print the byte to ACIA(b)
   029C 08            [ 4]  287             INX
   029D 20 F2         [ 4]  288             BRA     STRINGBX
   029F 39            [ 5]  289 DONEB:       RTS
