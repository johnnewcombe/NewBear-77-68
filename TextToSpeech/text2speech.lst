                             83 ; -----------------------------------------------------
                             84 ; Data arrives at port B as four hex characters
                             85 ; -----------------------------------------------------
   016B BD 02 BC      [ 9]   86                 JSR     GETDATA         ; value in T_WEIGHT, stones in A
   016E 25 03         [ 4]   87                 BCS     ML1             ; is it invalid i.e. carry clear
   0170 7E 02 07      [ 3]   88                 JMP     IDLE
   0173 7D 1A 26      [ 6]   89 ML1:            TST     PROCESSING_FLG  ; are we already processing a weight
   0176 26 F3         [ 4]   90                 BNE     MAINLOOP        ; flag non-zero so ignore everything that follows
   0178 7C 1A 26      [ 6]   91                 INC     PROCESSING_FLG  ; ignore any following data until we next idle
   017B 81 14         [ 2]   92                 CMPA    #TOO_HEAVY      ; more that 20 is too heavy
   017D 22 3E         [ 4]   93                 BHI     OVERLOADED
   017F B6 1A 1E      [ 4]   94                 LDAA    T_WEIGHT+1      ; validate pounds
   0182 81 0D         [ 2]   95                 CMPA    #13             ; invalid pounds
   0184 22 60         [ 4]   96                 BHI     ERROR           ; error
   0186 BD 02 31      [ 9]   97                 JSR     GREET           ; send a greeting message
