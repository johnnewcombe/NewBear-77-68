                            322 ; Read 4 hex digits and put value into X
                            323 ; -----------------------------------------------------
   02D7 8D D8         [ 8]  324 RD_XB:   BSR     ZINB    ; Read 2 digit hex value into A
   02D9 B7 19 52      [ 5]  325         STAA    T_Z     ; Save byte (most significant)
   02DC 8D D3         [ 8]  326         BSR     ZINB    ; Read 2 digit hex value into A
   02DE B7 19 53      [ 5]  327         STAA    T_Z+1   ; Save byte (least significant)
   02E1 FE 19 52      [ 5]  328         LDX     T_Z     ; Load full 4 hex value into X
   02E4 39            [ 5]  329         RTS             ; RETURN
                            330 
                            331 ; -----------------------------------------------------
                            332 ; Adds A to X and leaves the result in X, A is
                            333 ; preserved.
                            334 ; -----------------------------------------------------
   02E5 36            [ 4]  335 ADX:     PSHA
   02E6 FF 19 5C      [ 6]  336         STX     T_TMP
   02E9 BB 19 5D      [ 4]  337         ADDA    T_TMP+1   ; add A to low byte
   02EC B7 19 5D      [ 5]  338         STAA    T_TMP+1
   02EF B6 19 5C      [ 4]  339         LDAA    T_TMP     ; get high byte
   02F2 89 00         [ 2]  340         ADCA    #0      ; add carry only
   02F4 B7 19 5C      [ 5]  341         STAA    T_TMP
   02F7 FE 19 5C      [ 5]  342         LDX     T_TMP
   02FA 32            [ 4]  343         PULA
   02FB 39            [ 5]  344         RTS
                            345 
                            346 ; -----------------------------------------------------
                            347 ; Loads X with A, A is preserved.
                            348 ; -----------------------------------------------------
   02FC B7 19 5D      [ 5]  349 TAX:    STAA    T_TMP+1       ; store A as low byte of X
   02FF 7F 19 5C      [ 6]  350         CLR     T_TMP         ; zero the high byte
   0302 FE 19 5C      [ 5]  351         LDX     T_TMP         ; load X
   0305 39            [ 5]  352         RTS
                            353 
                            354 ; -----------------------------------------------------
                            355 ; Prints the message " n stones n pounds"
                            356 ; place stones in MSB of X and pound in LSB
                            357 ; -----------------------------------------------------
   0306                     358 PR_WEIGHT:
                            359 
   0306 FF 19 5A      [ 6]  360         STX     T_W
   0309 B6 19 5A      [ 4]  361         LDAA    T_W
   030C BD 02 FC      [ 9]  362         JSR     TAX
   030F BD 03 74      [ 9]  363         JSR     PR_WORD         ; n
   0312 BD 03 34      [ 9]  364         JSR     PR_SPCB
   0315 CE 01 2B      [ 3]  365         LDX     #STONES
   0318 BD 03 74      [ 9]  366         JSR     PR_WORD         ; "stones"
   031B BD 03 34      [ 9]  367         JSR     PR_SPCB
   031E B6 19 5B      [ 4]  368         LDAA    T_W+1            ; Load high byte of X into Accumulator A
   0321 BD 02 FC      [ 9]  369         JSR     TAX
   0324 BD 03 74      [ 9]  370         JSR     PR_WORD         ; n
   0327 CE 00 F5      [ 3]  371         LDX     #POUNDS
   032A BD 03 34      [ 9]  372         JSR     PR_SPCB
   032D BD 03 74      [ 9]  373         JSR     PR_WORD         ; "pounds"
   0330 BD 03 3F      [ 9]  374         JSR     PR_CRB
   0333 39            [ 5]  375         RTS
                            376 
ASxxxx Assembler V05.50.5  (Motorola 6800/6802/6808)                    Page 8
Hexadecimal [16-Bits]                                 Sun May  3 16:06:10 2026



                            377 ; -----------------------------------------------------
                            378 ; Prints a space on both consoles (preserves A)
                            379 ; -----------------------------------------------------
   0334 36            [ 4]  380 PR_SPCB: PSHA
   0335 86 20         [ 2]  381         LDAA    #0x20        ; Put space character in A
   0337 BD FC 0F      [ 9]  382         JSR     PR_A
   033A BD 02 CC      [ 9]  383         JSR     PR_B        ; Print it
   033D 32            [ 4]  384         PULA
   033E 39            [ 5]  385         RTS                 ; RETURN
                            386 
                            387 ; -----------------------------------------------------
                            388 ; Prints a CRLF on both consoles (preserves A)
                            389 ; -----------------------------------------------------
   033F 36            [ 4]  390 PR_CRB:  PSHA
   0340 86 0D         [ 2]  391         LDAA    #0x0D        ; Put CHAR character in A
   0342 BD FC 0F      [ 9]  392         JSR     PR_A
   0345 BD 02 CC      [ 9]  393         JSR     PR_B        ; Print it
   0348 86 0A         [ 2]  394         LDAA    #0x0A
   034A BD FC 0F      [ 9]  395         JSR     PR_A
   034D BD 02 CC      [ 9]  396         JSR     PR_B        ; Print it
   0350 32            [ 4]  397         PULA
   0351 39            [ 5]  398         RTS                 ; RETURN
                            399 
                            400 ; -----------------------------------------------------
                            401 ; Outputs a phrase from the memory location in X
                            402 ; -----------------------------------------------------
   0352                     403 PR_PHRASE:
                            404 
   0352 A6 00         [ 5]  405 PR_PH1:  LDAA    0,X         ; get high byte of word
   0354 E6 01         [ 5]  406         LDAB    1,X         ; get low byte
   0356 81 FF         [ 2]  407         CMPA    #0xFF        ; check high byte
   0358 27 19         [ 4]  408         BEQ     PR_PH2      ; high byte is 0xFF so we're done
   035A FF 19 56      [ 6]  409 PR_PH3:  STX     T_Y         ; save table pointer
   035D B7 19 58      [ 5]  410         STAA    T_P
   0360 F7 19 59      [ 5]  411         STAB    T_P+1
   0363 FE 19 58      [ 5]  412         LDX     T_P         ; X now points to the word
   0366 BD 03 74      [ 9]  413         JSR     PR_WORD
   0369 BD 03 34      [ 9]  414         JSR     PR_SPCB
   036C FE 19 56      [ 5]  415         LDX     T_Y         ; restore table pointer
   036F 08            [ 4]  416         INX                 ; move to next entry
   0370 08            [ 4]  417         INX                 ; (2 bytes per entry)
   0371 20 DF         [ 4]  418         BRA     PR_PH1
   0373 39            [ 5]  419 PR_PH2:  RTS
                            420 
                            421 ; -----------------------------------------------------
                            422 ; Outputs a word based on value in X
                            423 ; -----------------------------------------------------
   0374                     424 PR_WORD:
   0374 FF 19 54      [ 6]  425             STX     T_X             ; use ASL and ROL to multiply by 2 (pointer is 2 bytes wide)
   0377 78 19 55      [ 6]  426             ASL     T_X+1           ; shift low byte left, bit 7 goes to carry
   037A 79 19 54      [ 6]  427             ROL     T_X             ; rotate high byte left, carry in from low byte
   037D FE 19 54      [ 5]  428             LDX     T_X
   0380 FF 19 54      [ 6]  429             STX     T_X             ; Stash X
   0383 B6 19 54      [ 4]  430             LDAA    T_X             ; High byte of X
   0386 F6 19 55      [ 4]  431             LDAB    T_X+1           ; Low byte of X
ASxxxx Assembler V05.50.5  (Motorola 6800/6802/6808)                    Page 9
Hexadecimal [16-Bits]                                 Sun May  3 16:06:10 2026



   0389 CB A7         [ 2]  432             ADDB    #<WORDPTR    ; Add low byte of WORDPTR address
   038B 89 03         [ 2]  433             ADCA    #>WORDPTR    ; Add high byte of WORDPTR address + carry
   038D B7 19 54      [ 5]  434             STAA    T_X             ; T_X has the address of the pointer NOT the word
   0390 F7 19 55      [ 5]  435             STAB    T_X+1
   0393 FE 19 54      [ 5]  436             LDX     T_X             ; X has the address of the pointer NOT the word
                            437 
   0396 A6 00         [ 5]  438             LDAA    0,X             ; get the hi byte of the word
   0398 B7 19 54      [ 5]  439             STAA    T_X
   039B A6 01         [ 5]  440             LDAA    1,X             ; get the low byte of the word
   039D B7 19 55      [ 5]  441             STAA    T_X+1
   03A0 FE 19 54      [ 5]  442             LDX     T_X             ; X now has address of the word
   03A3 BD 02 92      [ 9]  443             JSR     STRINGBX        ; output the word
   03A6 39            [ 5]  444             RTS
                            445 
