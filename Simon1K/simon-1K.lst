0596                         ; Print value in X as 4 hex digits
0597                         
0598 fde2 36                 PR_HEX4     PSHA
0599 fde3 ff f0 13                       STX     d_Hx4X      ; Save X
0600 fde6 b6 f0 13                       LDAA    d_Hx4X      ; Get high order byte to A
0601 fde9 8d 07                          BSR     PR_HEX2     ; Print A as 2 hex digits
0602 fdeb b6 f0 14                       LDAA    d_Hx4X+1    ; Get low order byte to A
0603 fdee 8d 02                          BSR     PR_HEX2     ; Print A as 2 hex digits
0604 fdf0 32                             PULA
0605 fdf1 39                             RTS                 ; RETURN
