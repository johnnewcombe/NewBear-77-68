0567 ff60 bd fc 76           HEADER  JSR     STRING  ; print string...
0568 ff63 20 43 43                   FCC     " CC"   ;
0569 ff66 20 42 20                   FCC     " B "   ;
0570 ff69 20 41 20                   FCC     " A "   ;
0571 ff6c 20 20 58                   FCC     "  X"   ;
0572 ff6f 20 20 20                   FCC     "   "   ;
0573 ff72 20 50 43                   FCC     " PC"   ;
0574 ff75 20 20 20                   FCC     "   "   ;
0575 ff78 53 50                      FCC     "SP"    ;
