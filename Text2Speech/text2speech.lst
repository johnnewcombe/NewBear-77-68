   046A 36            [ 4]  492 PR_CRB:     PSHA
   046B 86 0D         [ 2]  493             LDAA    #0x0D        ; Put CHAR character in A
   046D BD FC 0F      [ 9]  494             JSR     PR_A
   0470 BD 03 F7      [ 9]  495             JSR     PR_B        ; Print it
   0473 86 0A         [ 2]  496             LDAA    #0x0A
   0475 F6 F0 FF      [ 4]  497             LDAB     PANEL
   0478 C5 01         [ 2]  498             BITB    #1
   047A 27 03         [ 4]  499             BEQ     PR_CRB1
   047C BD FC 0F      [ 9]  500             JSR     PR_A
   047F BD 03 F7      [ 9]  501 PR_CRB1:    JSR     PR_B        ; Print it
   0482 32            [ 4]  502             PULA
   0483 39            [ 5]  503             RTS                 ; RETURN
