output:  aciatest.s19
0001 f400                    DATAA   EQU     $F400   ; ACIA.A Data register
0002 f401                    CTRLA   EQU     $F401   ; ACIA.A Ctrl/Status
0003 f402                    DATAB   EQU     $F402   ; ACIA.B Data register
0004 f403                    CTRLB   EQU     $F403   ; ACIA.B Ctrl/Status
0005 f0ff                    DISPLAY EQU     $F0FF   ; LEDs
0006                         
0007 ff00                            ORG     $FF00
0008                         
0009 ff00 86 03              INIT    LDAA    #$03    ; reset ACIA
0010 ff02 b7 f4 01                   STAA    CTRLA   ;
0011 ff05 86 11                      LDAA    #$11    ; Set for 8N2
0012 ff07 b7 f4 01                   STAA    CTRLA   ;
0013                         
0014 ff0a b7 f0 ff                   STAA    DISPLAY ; will display $11 first time around and indicate that the software is running
0015                         
0016 ff0d f6 f4 01           LOOP    LDAB    CTRLA   ; get ACIA status
0017 ff10 c5 01                      BITB    #$01    ; wait for RX buffer full
0018 ff12 27 f9                      BEQ     LOOP    ; nothing there yet
0019 ff14 b6 f4 00                   LDAA    DATAA   ; load char from port
0020 ff17 b7 f0 ff                   STAA    DISPLAY ; display the value retrieved
0021 ff1a 20 f1                      BRA     LOOP    ; repeat
0022                         
0023 fffe                            ORG     $FFFE
0024 fffe ff 00                      FDB     INIT
0025                         
0026                                 END
