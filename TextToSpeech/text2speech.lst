                            459 ; -----------------------------------------------------
                            460 ; Reserved memory
                            461 ; -----------------------------------------------------
                            462 
   1951                     463 T_Q:             .rmb     1       ; Temp storage for ZIN
   1952                     464 T_Z:             .rmb     2       ;   "     "     "  RDX
   1954                     465 T_X:             .rmb     2       ;   "     "     "  PR_WORD
   1956                     466 T_Y:             .rmb     2       ;   "     "     "  table pointer
   1958                     467 T_P:             .rmb     2       ;   "     "     "  PR_PHRASE
   195A                     468 T_W:             .rmb     2       ;   "     "     "  PR_WEIGHT
   195C                     469 T_TMP:           .rmb     2       ;   "     "     "  within subroutine
   195E                     470 DEC:             .rmb     3       ; for decimal value
   1961                     471 RND:             .rmb     1       ; holds a random number (see RD_B
   1962                     472 TEMP:            .rmb     2       ; temp var (non subroutine use)
   1964                     473 T_WEIGHT:        .rmb     2       ; holds value of weight following a call to GETDATA
   1966                     474 IDLE_COUNT:      .rmb     1       ; counts the number of empty measurement reports
   1967                     475 IDLE_MSG_ID:     .rmb     1       ; holds value of next idle message to use
   1968                     476 GREET_MSG_ID:    .rmb     1       ; holds value of next greeting message to use
   1969                     477 LIGHT_MSG_ID:    .rmb     1       ; holds value of next light weight message to use
   196A                     478 NORMAL_MSG_ID:   .rmb     1       ; holds value of next normal weight message to use
   196B                     479 HEAVY_MSG_ID:    .rmb     1       ; holds value of next heavy weight message to use
   196C                     480 SHEAVY_MSG_ID:   .rmb     1       ; holds value of next super heavy weight message to use
