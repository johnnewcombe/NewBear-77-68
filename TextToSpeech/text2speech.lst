   0166                      77 MAINLOOP:
                             78 ; -----------------------------------------------------
                             79 ; Data arrives at port B as four hex characters
                             80 ; -----------------------------------------------------
   0166 BD 03 21      [ 9]   81                 JSR     GETDATA         ; value in T_WEIGHT, stones in A
   0169 25 03         [ 4]   82                 BCS     ML1             ; is it invalid i.e. carry clear
   016B 7E 01 FB      [ 3]   83                 JMP     IDLE
   016E 7D 1B B2      [ 6]   84 ML1:            TST     PROCESSING_FLG  ; are we already processing a weight
   0171 26 F3         [ 4]   85                 BNE     MAINLOOP        ; flag non-zero so ignore everything that follows
   0173 7C 1B B2      [ 6]   86                 INC     PROCESSING_FLG  ; ignore any following data until we next idle
   0176 81 14         [ 2]   87                 CMPA    #TOO_HEAVY      ; more that 20 is too heavy
   0178 22 3E         [ 4]   88                 BHI     OVERLOADED
   017A B6 1B AA      [ 4]   89                 LDAA    T_WEIGHT+1      ; validate pounds
   017D 81 0D         [ 2]   90                 CMPA    #13             ; invalid pounds
   017F 22 58         [ 4]   91                 BHI     IERROR          ; internal error
   0181 BD 02 37      [ 9]   92                 JSR     GREET           ; send a greeting message
                             93 
                             94                 ; get the weight a second time, this should allow the scales time to settle
   0184 BD 03 21      [ 9]   95                 JSR     GETDATA
                             96 
                             97                 ; output "you weigh" maybe use a phrase rather than individual words
   0187 CE 1B 5F      [ 3]   98                 LDX     #MYOUWEIGH
   018A BD 04 3B      [ 9]   99                 JSR     PR_PHRASE
   018D FE 1B A9      [ 5]  100                 LDX     T_WEIGHT        ; restore X
   0190 BD 03 DB      [ 9]  101                 JSR     PR_WEIGHT       ; weight back X so output the weight
   0193 BD 1B 6B      [ 9]  102                 JSR     PANEL_DISP
