0691                         ; FF8F
0692                         ; -----------------------------------------------------
0693 ff8f 8e f0 d0           START   LDS     #STACK      ; Set up stack for JMON
0694 ff92 86 11                      LDAA    #$11        ; 8 Data, No Parity, 2 Stop Bits
0695 ff94 b7 f4 01                   STAA    CTRLA       ;   ACIA.A
0696 ff97 bd fc 76                   JSR     STRING      ; Print string...
0697 ff9a 0d 0a                      FCB     $0D,$0A     ; c/r l/f null `*`
0698 ff9c 00 2a ff                   FCB     $00,'*,$FF  ; End-of-string
0699 ff9f bd fc 00                   JSR     RD_CMD      ; Read a byte (test for `.`)
0700 ffa2 ce ff b8                   LDX     #CMDTAB     ; point to command table
0701 ffa5 e6 00              CMDLP   LDAB    0,X         ; B = key byte (0 ends table)
0702 ffa7 27 e6                      BEQ     START       ; end of table → default to START
0703 ffa9 11                         CBA                 ; compare A vs B
0704 ffaa 27 05                      BEQ     FOUND       ; match → dispatch
0705 ffac 08                         INX                 ; skip key
0706 ffad 08                         INX                 ; skip FDB high
0707 ffae 08                         INX                 ; skip FDB low
0708 ffaf 20 f4                      BRA      CMDLP      ; try next entry
0709                         
0710 ffb1 e6 01              FOUND   LDAB    1,X         ; B = target high byte (FDB stores high,low)
0711 ffb3 a6 02                      LDAA    2,X         ; A = target low byte
0712 ffb5 36                         PSHA                ; push high first
0713 ffb6 37                         PSHB                ; push low — now low is on top of stack
0714 ffb7 39                         RTS                 ; jump to target
0715                         
