0434 fe18 ce f0 d1                   LDX     #d_TW
0435 fe1b bd fe a8                   JSR     .fOutH2    ; O/P byte <-X and inc X
0436 fe1e bd fe a8                   JSR     .fOutH2    ; O/P byte <-X and inc X
0437                         
0438                         ; Output data...
0439 fe21 fe f0 d1                   LDX     d_TW
0440 fe24 bd fe a8           .fOut4  JSR     .fOutH2    ; O/P byte <-X and inc X
0441 fe27 7a f0 d5                   DEC     b_Temp      ; Decrement `bytes left` count
0442 fe2a 26 f8                      BNE     .fOut4      ; Loop back if any left
0443 fe2c ff f0 d1                   STX     d_TW
0444 fe2f 53                         COMB
0445 fe30 37                         PSHB
0446 fe31 30                         TSX                 ; X = S + 1
0447 fe32 8d 74                      BSR     .fOutH2    ; PUNCH CHECKSUM
0448 fe34 33                         PULB
0449 fe35 fe f0 d1                   LDX     d_TW
0450 fe38 09                         DEX
0451 fe39 bc f0 f1                   CPX     T_STOP
0452 fe3c 26 ad                      BNE     .fOut1
0453 fe3e 7e ff d9                   JMP     STERMS
0454                         
0455 fe41 01                         NOP
0456 fe42 01                         NOP
