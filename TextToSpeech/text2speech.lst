0008                         
0009                         ; MINIMON routines
0010 fc76                    STRING              EQU $FC76   ; Prints a string. The string should follow JSR and be terminated with $FF.
0011 fc89                    GETADD              EQU $FC89   ; Get Address, read 4 digit hex value.
0012 fcc9                    ZOUT                EQU $FCC9   ; Print value in A as 2 hex digits.
0013 fe97                    NEWLINE             EQU $FE97   ; Prints a new line.
0014 ff8f                    START               EQU $FF8F   ; Restarts MniMon.
0015 fc0f                    PR_A                EQU $FC0F   ; Print char in A to ACIA (a)
0016 fd2b                    RD_A                EQU $FD2B   ; Read char from A
0017 fd4d                    PRSP                EQU $FD4D   ; Print a space
0018 fc31                    BINARY              EQU $FC31   ; Converts ASCII hex digits in A and B to binary?
0019 fc65                    RD_X                EQU $FC65   ; Read 4 hex digits Value from ACIA(a) and put value into X.
0020 fc1d                    VHEX                EQU $FC1D   ; Checks that A contains a HEX character
0021                         
0022 0002                    IDLE_SECS           EQU 2      ; seconds between idle messages
0023 0006                    LIGHT_WGHT          EQU 6       ; greater than 6 stones
0024 000a                    NORM_WGHT           EQU 10
0025 000d                    HEAVY_WGHT          EQU 13
0026 000f                    SHEAVY_WGHT         EQU 15
0027                         
