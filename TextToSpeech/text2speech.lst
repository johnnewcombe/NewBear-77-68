0390                         ; Outputs a word based on value in A
0391                         ; -----------------------------------------------------
0392 0406 4c                 PR_WORD     INCA
0393 0407 ce 06 04                       LDX     #WORDPTR  ; base of offset table
0394 040a 4a                 PR_WORD1    DECA
0395 040b 27 04                          BEQ     FOUNDW
0396 040d 08                             INX                 ; move to next address
0397 040e 08                             INX
0398 040f 26 f9                          BNE     PR_WORD1    ; loop around to retest
0399 0411 a6 00              FOUNDW      LDAA    0,X
0400 0413 b7 06 99                       STAA    T_X
0401 0416 a6 01                          LDAA    1,X
0402 0418 b7 06 9a                       STAA    T_X+1
0403 041b fe 06 99                       LDX     T_X
0404 041e bd 03 44                       JSR     STRINGBX
0405 0421 39                             RTS
