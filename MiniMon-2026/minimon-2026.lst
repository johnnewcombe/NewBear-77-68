0427 fe18 ce f0 de                       LDX     #d_TW
0428 fe1b bd fe a8                       JSR     .fOutHx2    ; O/P byte <-X and inc X
0429 fe1e bd fe a8                       JSR     .fOutHx2    ; O/P byte <-X and inc X
0430                         
0431                         ; Output data...
0432 fe21 fe f0 de                       LDX     d_TW
0433 fe24 bd fe a8           .fOut4      JSR     .fOutHx2    ; O/P byte <-X and inc X
0434 fe27 7a f0 e2                       DEC     b_Temp      ; Decrement `bytes left` count
0435 fe2a 26 f8                          BNE     .fOut4      ; Loop back if any left
0436 fe2c ff f0 de                       STX     d_TW
0437 fe2f 53                             COMB
0438 fe30 37                             PSHB
0439 fe31 30                             TSX                 ; X = S + 1
0440 fe32 8d 74                          BSR     .fOutHx2    ; PUNCH CHECKSUM
0441 fe34 33                             PULB
0442 fe35 fe f0 de                       LDX     d_TW
0443 fe38 09                             DEX
0444 fe39 bc f0 f1                       CPX     T_STOP
0445 fe3c 26 ad                          BNE     .fOut1
