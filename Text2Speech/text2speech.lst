Hexadecimal [16-Bits]                                 Thu May 21 15:24:30 2026



                            327 ;--------------------------------------------------------------
                            328 ; Gets the weight data from the scales and rerurns with carry
                            329 ; set if a valid reading, carry clear otherwise. A valid weight
                            330 ; reading resets the idle count. Data received is stored in
                            331 ; T_WEIGHT and MSB in A.
                            332 ;--------------------------------------------------------------
   0386                     333 GETDATA:
   0386 BD 04 05      [ 9]  334         JSR     RD_XB           ; read 4 hex characters into X
   0389 FF 00 0F      [ 6]  335         STX     T_WEIGHT        ; store X
                            336         ;JSR     PRX             ; print the data
                            337         ;JSR    PRSP
   038C 0C            [ 2]  338         CLC
   038D B6 00 0F      [ 4]  339         LDAA    T_WEIGHT        ; get fist byte (stones)
   0390 27 04         [ 4]  340         BEQ     GDDONE          ; idle message
   0392 7F 00 2D      [ 6]  341         CLR     IDLE_TICS       ; not an idle message so reset the idle counter
   0395 0D            [ 2]  342         SEC                     ; non idle message return with carry set
   0396 39            [ 5]  343 GDDONE:  RTS
                            344 
                            345 ; -----------------------------------------------------
                            346 ; Print string FOLLOWING JSR ( terminated by 0xFF ) to
                            347 ; ACIA(b) and ACIA(b)
                            348 ; -----------------------------------------------------
   0397 30            [ 4]  349 STRINGB: TSX             ; Get loc. of return addr to X
   0398 EE 00         [ 6]  350          LDX     0,X     ; Get return addr to X
   039A 09            [ 4]  351          DEX             ; Point to byte before
   039B 08            [ 4]  352 STRB1:   INX             ; Point to next byte
   039C A6 00         [ 5]  353          LDAA    0,X     ; Get byte to be printed
   039E 81 FF         [ 2]  354          CMPA    #0xFF    ; End-string ?
   03A0 27 0E         [ 4]  355          BEQ     ENDSTR  ; Yes: Go to finish up
   03A2 F6 F0 FF      [ 4]  356          LDAB    PANEL
   03A5 C5 01         [ 2]  357          BITB     #1
   03A7 27 03         [ 4]  358          BEQ     STRB    ; panel switch 0 is debug and copies data to A
   03A9 BD FC 0F      [ 9]  359          JSR     PR_A    ; Print the byte to ACIA(a) (A is maintained)
                            360                          ;  DEBUG depending on panel data switch zero
   03AC 8D 49         [ 8]  361 STRB:    BSR     PR_B    ; Print the byte to ACIA(b)
   03AE 20 EB         [ 4]  362          BRA     STRB1   ; Go back for next byte
   03B0 31            [ 4]  363 ENDSTR:  INS             ; Clean up stack...
   03B1 31            [ 4]  364          INS             ;  ( pop off the return addr )
   03B2 6E 01         [ 4]  365          JMP     1,X     ; Jump back to caller (RETURN)
                            366 
                            367 ; -----------------------------------------------------
                            368 ; Prints a string pointed to by X
                            369 ; -----------------------------------------------------
   03B4 A6 00         [ 5]  370 STRINGBX:   LDAA    0,X         ; get char
   03B6 81 FF         [ 2]  371             CMPA    #0xFF        ; is character NULL?
   03B8 27 0F         [ 4]  372             BEQ     DONEB       ; yes, end of string
   03BA F6 F0 FF      [ 4]  373             LDAB    PANEL
   03BD C5 01         [ 2]  374             BITB    #1
   03BF 27 03         [ 4]  375             BEQ     STRBX       ; panel switch 0 is debug and copies data to A
   03C1 BD FC 0F      [ 9]  376             JSR     PR_A        ; Print the byte to ACIA(a) (A is maintained)
   03C4 8D 31         [ 8]  377 STRBX:      BSR     PR_B        ; Print the byte to ACIA(b)
   03C6 08            [ 4]  378             INX
   03C7 20 EB         [ 4]  379             BRA     STRINGBX
   03C9 39            [ 5]  380 DONEB:      RTS
                            381 
ASxxxx Assembler V05.50.5  (Motorola 6800/6802/6808)                    Page 8
Hexadecimal [16-Bits]                                 Thu May 21 15:24:30 2026



                            382 ; -----------------------------------------------------
                            383 ; Reads a character from ACIA(b) into A
                            384 ; -----------------------------------------------------
   03CA 7C 00 1A      [ 6]  385 RD_B:   INC     RND         ; use this loop to create a random number
   03CD B6 F4 03      [ 4]  386         LDAA    CTRLB       ; Get ACIA.A status byte
   03D0 85 01         [ 2]  387         BITA    #01         ; Is byte ready in DATAb
   03D2 27 F6         [ 4]  388         BEQ     RD_B        ; No: Try again
   03D4 B6 F4 02      [ 4]  389         LDAA    DATAB       ; Get the data byte to A
   03D7 84 7F         [ 2]  390         ANDA    #0x7F       ; Mask off parity bit if it exists
   03D9 39            [ 5]  391         RTS                 ; RETURN
                            392 
                            393 ; -----------------------------------------------------
                            394 ; Reads 2 hex ascii characters and saves them the
                            395 ; byte value to A e.g. "0F" received is stored to A as
                            396 ; 15d.
                            397 ; This version ignores non-hex characters
                            398 ; -----------------------------------------------------
   03DA 8D EE         [ 8]  399 ZINB:   BSR     RD_B    ; Read a character
   03DC BD FC 1D      [ 9]  400         JSR     VHEX    ; Is it a hex character ?
   03DF 24 02         [ 4]  401         BCC     ZINBA   ; No: go to print `?`
   03E1 86 FF         [ 2]  402         LDAA    #0xFF
   03E3 B7 00 00      [ 5]  403 ZINBA:  STAA    T_Q     ; Yes: Save Acc.A
   03E6 8D E2         [ 8]  404         BSR     RD_B    ; Read 2nd character
   03E8 BD FC 1D      [ 9]  405         JSR     VHEX    ; Is it a hex character ?
   03EB 24 02         [ 4]  406         BCC     ZINBB   ; No: go to print `?`
   03ED 86 FF         [ 2]  407         LDAA    #0xFF
   03EF 16            [ 2]  408 ZINBB:  TAB             ; Yes: Put it into Acc.B
   03F0 B6 00 00      [ 4]  409         LDAA    T_Q     ; Retrieve 1st hex char to Acc.A
   03F3 BD FC 31      [ 9]  410         JSR     BINARY  ; Convert A:B to binary
   03F6 39            [ 5]  411         RTS             ; RETURN
                            412 
                            413 ; -----------------------------------------------------
                            414 ; Print character in A to ACIA(b)
                            415 ; -----------------------------------------------------
   03F7 F6 F4 03      [ 4]  416 PR_B:    LDAB    CTRLB   ; Get ACIA(a) status byte
   03FA C5 02         [ 2]  417         BITB    #02     ; Is it busy ?
   03FC 27 F9         [ 4]  418         BEQ     PR_B    ; Yes: Try again
   03FE B7 F4 02      [ 5]  419         STAA    DATAB   ;  No: Send data
   0401 B7 F0 FF      [ 5]  420         STAA    PANEL
   0404 39            [ 5]  421 PRB_END: RTS             ; RETURN
                            422 
                            423 ; -----------------------------------------------------
                            424 ; Read 4 hex digits and put value into X
                            425 ; -----------------------------------------------------
   0405 8D D3         [ 8]  426 RD_XB:   BSR     ZINB    ; Read 2 digit hex value into A
   0407 B7 00 01      [ 5]  427         STAA    T_Z     ; Save byte (most significant)
   040A 8D CE         [ 8]  428         BSR     ZINB    ; Read 2 digit hex value into A
   040C B7 00 02      [ 5]  429         STAA    T_Z+1   ; Save byte (least significant)
   040F FE 00 01      [ 5]  430         LDX     T_Z     ; Load full 4 hex value into X
   0412 39            [ 5]  431         RTS             ; RETURN
                            432 
                            433 ; -----------------------------------------------------
                            434 ; Adds A to X and leaves the result in X, A is
                            435 ; preserved.
                            436 ; -----------------------------------------------------
ASxxxx Assembler V05.50.5  (Motorola 6800/6802/6808)                    Page 9
Hexadecimal [16-Bits]                                 Thu May 21 15:24:30 2026



   0413 36            [ 4]  437 ADX:     PSHA
   0414 FF 00 0B      [ 6]  438         STX     T_TMP
   0417 BB 00 0C      [ 4]  439         ADDA    T_TMP+1   ; add A to low byte
   041A B7 00 0C      [ 5]  440         STAA    T_TMP+1
   041D B6 00 0B      [ 4]  441         LDAA    T_TMP     ; get high byte
   0420 89 00         [ 2]  442         ADCA    #0      ; add carry only
   0422 B7 00 0B      [ 5]  443         STAA    T_TMP
   0425 FE 00 0B      [ 5]  444         LDX     T_TMP
   0428 32            [ 4]  445         PULA
   0429 39            [ 5]  446         RTS
                            447 
                            448 ; -----------------------------------------------------
                            449 ; Loads X with A, A is preserved.
                            450 ; -----------------------------------------------------
   042A B7 00 0C      [ 5]  451 TAX:    STAA    T_TMP+1       ; store A as low byte of X
   042D 7F 00 0B      [ 6]  452         CLR     T_TMP         ; zero the high byte
   0430 FE 00 0B      [ 5]  453         LDX     T_TMP         ; load X
   0433 39            [ 5]  454         RTS
                            455 
                            456 ; -----------------------------------------------------
                            457 ; Prints the message " n stones n pounds"
                            458 ; place stones in MSB of X and pound in LSB
                            459 ; -----------------------------------------------------
   0434                     460 PR_WEIGHT:
                            461 
   0434 FF 00 09      [ 6]  462         STX     T_W
   0437 B6 00 09      [ 4]  463         LDAA    T_W
   043A BD 04 2A      [ 9]  464         JSR     TAX
   043D BD 04 A6      [ 9]  465         JSR     PR_WORD         ; n
   0440 BD 04 62      [ 9]  466         JSR     PR_SPCB
   0443 CE 01 2B      [ 3]  467         LDX     #STONES
   0446 BD 04 A6      [ 9]  468         JSR     PR_WORD         ; "stones"
   0449 BD 04 62      [ 9]  469         JSR     PR_SPCB
   044C B6 00 0A      [ 4]  470         LDAA    T_W+1            ; Load high byte of X into Accumulator A
   044F BD 04 2A      [ 9]  471         JSR     TAX
   0452 BD 04 A6      [ 9]  472         JSR     PR_WORD         ; n
   0455 CE 00 F5      [ 3]  473         LDX     #POUNDS
   0458 BD 04 62      [ 9]  474         JSR     PR_SPCB
   045B BD 04 A6      [ 9]  475         JSR     PR_WORD         ; "pounds"
   045E BD 04 6A      [ 9]  476         JSR     PR_CRB
   0461 39            [ 5]  477         RTS
                            478 
                            479 ; -----------------------------------------------------
                            480 ; Prints a space on both consoles (preserves A)
                            481 ; -----------------------------------------------------
   0462 36            [ 4]  482 PR_SPCB: PSHA
   0463 86 20         [ 2]  483         LDAA    #0x20        ; Put space character in A
                            484         ;JSR     PR_A
   0465 BD 03 F7      [ 9]  485         JSR     PR_B        ; Print it
   0468 32            [ 4]  486         PULA
   0469 39            [ 5]  487         RTS                 ; RETURN
