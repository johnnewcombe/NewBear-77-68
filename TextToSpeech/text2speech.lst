0050                         ; -----------------------------------------------------
0051                         ; Data arrives at port B as four hex characters
0052                         ; -----------------------------------------------------
0053 0105 bd 02 49                   JSR     GETDATA         ; value in T_WEIGHT, stones in A
0054 0108 25 03                      BCS     ML1             ; is it invalid i.e. carry clear
0055 010a 7e 01 a1                   JMP     IDLE
0056 010d 81 14              ML1     CMPA    #20             ; more that 20 is too heavy
0057 010f 22 45                      BHI     OVERLOADED
0058 0111 b6 19 49                   LDAA    T_WEIGHT+1      ; validate pounds
0059 0114 81 0d                      CMPA    #13             ; invalid pounds
0060 0116 22 6a                      BHI     ERROR           ; error
0061 0118 bd 01 c5                   JSR GREET               ; send a greeting message
0062                         
0063                                 ; get the weight a second time, this should allow the scales time to settle
0064 011b bd 02 49                   JSR     GETDATA
0065                         
0066                                 ; all good so output the weight mesage
0067                                 ; TODO get phrase from phrase table as per other message output routines
0068 011e bd 02 78                   JSR     STRINGB
0069 0121 59 6f 75 20 77 65          FCC     "You weigh"
     69 67 68
0070 012a 00                         FCB     $00
0071 012b fe 19 48                   LDX     T_WEIGHT        ; restore X
0072 012e bd 02 f8                   JSR     PR_WEIGHT       ; weight back X so output the weight
0073                         
0074                                 ; determine phrase category (light normal, heavy etc.) and jump to the section
0075 0131 b6 19 48                   LDAA    T_WEIGHT
0076 0134 81 06                      CMPA    #LIGHT_WGHT
0077 0136 22 03                      BHI     ML2             ; less than light weight gets no comment
0078 0138 7e 02 46                   JMP     END
0079 013b 81 0a              ML2     CMPA    #NORM_WGHT      ; less than normal is light
0080 013d 22 03                      BHI     ML3
