0619 ff63 bd fc 76           HEADER  JSR     STRING  ; print string...
0620 ff66 20 43 43                   FCC     " CC"   ;
0621 ff69 20 42 20                   FCC     " B "   ;
0622 ff6c 20 41 20                   FCC     " A "   ;
0623 ff6f 20 20 58                   FCC     "  X"   ;
0624 ff72 20 20 20                   FCC     "   "   ;
0625 ff75 20 50 43                   FCC     " PC"   ;
0626 ff78 20 20 20                   FCC     "   "   ;
0627 ff7b 53 50                      FCC     "SP"    ;
0628 ff7d ff                         FCB     $FF     ; End-of-string
0629 ff7e 20 0f                      BRA     START   ; Return to MINIMON
