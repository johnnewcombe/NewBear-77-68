0459                         ; FE43
0460                         ; -----------------------------------------------------
0461 fe43 bd fc 65           MODIFY  JSR     RD_X    ; Get address to X
0462 fe46 bd fd 4d           STRT    JSR     PRSP    ; Print a space
0463 fe49 7f f0 f5                   CLR     T_R     ; T_R = 0
0464 fe4c a6 00              PRz     LDAA    0,X     ; Get byte pointed to by X to A
0465 fe4e bd fc c9                   JSR     ZOUT    ; Print it as 2.hex digits
0466 fe51 bd fc 00           WATSIT  JSR     RD_CMD  ; Get command character
0467 fe54 81 20              WHAT    CMPA    #$20    ; Is it a space ?
0468 fe56 26 0c                      BNE     ISSLSH  ; No: go test for slash
0469 fe58 08                 CARYON  INX             ; Increment X
0470 fe59 b6 f0 f5                   LDAA    T_R     ; A = T_R
0471 fe5c 81 16                      CMPA    #$16    ; At end of line ?
0472 fe5e 2f ec                      BLE     PRz     ; No: Loop back to continue
0473 fe60 8d 35              NEW_1   BSR     NEWLINE ; Print c/r l/f nul
0474 fe62 20 e2                      BRA     STRT    ; Loop back (Note: Hex was wrong in doc, E2 instead of E5)
0475                         
0476 fe64 81 2f              ISSLSH  CMPA    #'/     ; Is it a slash ?
0477 fe66 26 03                      BNE     ISCRET  ; No: go test for c/r
0478 fe68 09                         DEX             ; X = X - 1
0479 fe69 20 f5                      BRA     NEW_1   ; Loop back (print newline)
0480                         
0481 fe6b 81 0d              ISCRET  CMPA    #$0D    ; Is it a c/r ?
0482 fe6d 26 03                      BNE     ISHEX   ; No: go test for valid Hex
0483 fe6f 08                         INX             ; X = X + 1
0484 fe70 20 ee                      BRA     NEW_1   ; Loop back (print newline)
0485                         
0486 fe72 bd fc 1d           ISHEX   JSR     VHEX    ; Is it a valid hex character ?
0487 fe75 25 19                      BCS     PRQM    ; No: print `?` and ignore
0488 fe77 b7 f0 f6                   STAA    T_Q     ; T_Q = A : Save it
0489 fe7a bd fc 00                   JSR     RD_CMD  ; Get 2nd character
0490 fe7d bd fc 1d                   JSR     VHEX    ; Is it a valid hex character ?
0491 fe80 25 d2                      BCS     WHAT    ; No: then see what it is
0492 fe82 16                         TAB             ; B = A
0493 fe83 b6 f0 f6                   LDAA    T_Q     ; A = T_Q
0494 fe86 bd fc 31                   JSR     BINARY  ; Convert to binary value
0495 fe89 a7 00                      STAA    0,X     ; Store it
0496 fe8b bd fd 4d                   JSR     PRSP    ; Print a space
0497 fe8e 20 c8                      BRA     CARYON  ; Loop back
0498                         
0499 fe90 86 3f              PRQM    LDAA    #'?     ; Put `?` into A
0500 fe92 bd fc 0f                   JSR     PR_A    ; Print it
0501 fe95 20 ba                      BRA     WATSIT  ; Loop back
0502                         
0503 fe97 ff f0 e3           NEWLINE STX     T_SAVE  ; Save X
0504 fe9a bd fc 76                   JSR     STRING  ; Print string...
0505 fe9d 0d 0a 00                   FCB     $0D,$0A,$00
0506 fea0 ff                         FCB     $FF     ; End-of-string
0507 fea1 fe f0 e3                   LDX     T_SAVE  ; Restore X
0508 fea4 bd fc bb                   JSR     PRX     ; Print X
0509 fea7 39                         RTS             ; RETURN
0510                         
0511 fea8 eb 00              .fOutH2 ADDB    0,X         ; Update checksum
0512 feaa 36                         PSHA                ; Push A to STACK
0513 feab a6 00                      LDAA    0,X         ; Load byte to be o/p
0514 fead bd fc c9                   JSR     ZOUT        ; O/P byte <- X
0515 feb0 32                         PULA                ; Pull A off STACK
0516 feb1 08                         INX                 ; Increment X
0517 feb2 39                         RTS                 ; RETURN
0518                         
0519                         ; Processes the termination record which, if we get here is an S9 record
0520                         ; A will contain the umber of bytes to follow (should be 39h i.e. ASCII '9')
0521                         ; which means there are left to absorb.
0522 feb3 ce 00 08           STERMR      LDX     #8          ; get the number of bytes left in record
0523 feb6 bd fc 00           STERM1      JSR     RD_CMD      ; read and echo from ACIA and ignore
0524 feb9 09                             DEX
0525 feba 26 fa                          BNE     STERM1      ; loop for remaining bytes
0526 febc 7e ff 8f           STARTS      JMP     START
0527                         
0528 febf 01                             NOP
0529 fec0 01                             NOP
0530 fec1 01                             NOP
0531                         
0532                         ; -----------------------------------------------------
0533                         ; FEC2
0534                         ; -----------------------------------------------------
0535 fec2 bd fc 65           GO      JSR     RD_X    ; Get address to X (16.bit)
0536 fec5 bd fc 00                   JSR     RD_CMD  ; Right address ?
0537 fec8 b6 f0 f4                   LDAA    T_Z+1   ; T_Z.low to A
0538 fecb f6 f0 f3                   LDAB    T_Z     ; T_Z.high to B
0539 fece fe f0 fd           GOTO    LDX     PSTACK  ; Callers stack address to X
0540 fed1 a7 07                      STAA    7,X     ; Put new return
0541 fed3 e7 06                      STAB    6,X     ; address on stack
0542 fed5 be f0 fd                   LDS     PSTACK  ; Set up calling programs stack
0543 fed8 3b                         RTI             ; RETURN-FROM-INTERRUPT (SWI)
0544                         
0545                         ; -----------------------------------------------------
0546                         ; FED9
0547                         ; -----------------------------------------------------
0548 fed9 bd fc 00           CONTNU  JSR     RD_CMD  ; Read a byte (test for `.`)
0549 fedc 81 31                      CMPA    #'1     ; Is it `1` ?
0550 fede 26 10                      BNE     IsIt2  ; No: go test for `2`
0551 fee0 fe f0 f7                   LDX     T_ABYT  ; Get address of break.point
0552 fee3 b6 f0 fb                   LDAA    T_BYTE  ; Get saved opcode
0553 fee6 a7 00                      STAA    0,X     ; Put it back in the program
0554 fee8 b6 f0 f8                   LDAA    T_ABYT+1 ; Get address at which
0555 feeb f6 f0 f7                   LDAB    T_ABYT  ;   to re-enter program
0556 feee 20 de                      BRA     GOTO    ; Go to calling program
0557                         
0558 fef0 81 32              IsIt2   CMPA    #'2     ; Is it `2`
0559 fef2 27 03                      BEQ     G_Is2   ; Yes: go process it
0560 fef4 7e ff 8f                   JMP     START   ; No: Return to MINIMON
0561 fef7 fe f0 f9           G_Is2   LDX     T_ABYT+2 ; Get addr. of break.point 2
0562 fefa b6 f0 fc                   LDAA    T_BYTE+1 ; Get old opcode
0563 fefd a7 00                      STAA    0,X      ; Put it back
0564 feff b6 f0 fa                   LDAA    T_ABYT+3 ; Load address to start
0565 ff02 f6 f0 f9                   LDAB    T_ABYT+2 ;  running program at
0566 ff05 20 c7                      BRA     GOTO    ; Run user program
0567                         
