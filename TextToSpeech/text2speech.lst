0001                         ;------------------------------------------------------------------
0002                         ; text2speech.asm
0003                         ;------------------------------------------------------------------
0004                         
0005                         ; 7768 ACIA
0006 f400                    DATAA   EQU $F400 ; ACIA(a) Data register
0007 f401                    CTRLA   EQU $F401 ; ACIA(a) Ctrl/Status
0008 f402                    DATAB   EQU $F402 ; ACIA(b) Data register
0009 f403                    CTRLB   EQU $F403 ; ACIA(b) Ctrl/Status
0010                         
0011                         ; MINIMON routines
0012 fc76                    STRING  EQU $FC76 ; Prints a string. The string should follow JSR and be terminated with $FF.
0013 fc89                    GETADD  EQU $FC89 ; Get Address, read 4 digit hex value.
0014 fcc9                    ZOUT    EQU $FCC9 ; Print value in A as 2 hex digits.
0015 fe97                    NEWLINE EQU $FE97 ; Prints a new line.
0016 ff8f                    START   EQU $FF8F ; Restarts MniMon.
0017 fc0f                    PR_A    EQU $FC0F ; Print char in A to ACIA (a)
0018 fd2b                    RD_A    EQU $FD2B ; Read char from A
0019 fd4d                    PRSP    EQU $FD4D ; Print a space
0020 fc31                    BINARY  EQU $FC31 ; Converts ASCII hex digits in A and B to binary?
0021 fc65                    RD_X    EQU $FC65 ; Read 4 hex digits Value from ACIA(a) and put value into X.
0022 fc1d                    VHEX    EQU $FC1D ; Checks that A contains a HEX character
0023 0200                    	    ORG $0200
0024                         
0025                         ; initialise serial port B
0026 0200 86 11              TX2SP   LDAA    #$11    ; 8 Data, No Parity, 2 Stop Bits
0027 0202 b7 f4 03                   STAA    CTRLB   ;   ACIA.A
0028                         
0029                         
0030                         MAINLOOP:
0031                         ; -----------------------------------------------------
0032                         ; Data arrives at port B as four hex characters
0033                         ; -----------------------------------------------------
0034 0205 bd 02 b2                   JSR     RD_XB           ; read 4 hex characters into X
0035 0208 ff 05 a5                   STX     TEMP            ; store X
0036                         
0037                         
0038 020b b6 05 a5                   LDAA    TEMP            ; get fist byte (stones)
0039 020e 27 19                      BEQ     IDLE
0040 0210 81 14                      CMPA    #20             ; more that 20 is too heavey
0041 0212 22 20                      BHI     TOHEAVY         ; say something rude
0042 0214 b6 05 a6                   LDAA    TEMP+1          ; get pounds
0043 0217 81 0d                      CMPA    #13             ; invalid pounds
0044 0219 22 1b                      BHI     ERROR           ; error
0045                         
0046                                 ; all good so output the weight mesage
0047 021b ce 03 36                   LDX     #YOUWEIGH       ; output the 'you weigh' phrase
0048 021e bd 03 04                   JSR     PR_PHRASE       ; output phrase specified in A
0049 0221 fe 05 a5                   LDX     TEMP            ; restore X
0050 0224 bd 02 c0                   JSR     PR_WEIGHT       ; weight back X so output the weight
0051                         
0052 0227 20 0d                      BRA     END
0053                         
0054                         IDLE
0055                                 ;LDAA    #$01            ; load phrase number (PTR)
0056 0229 ce 03 39                   LDX     #MYNAME
0057 022c bd 03 04                   JSR     PR_PHRASE
0058 022f bd 02 f1                   JSR     PR_CRB
0059 0232 20 02                      BRA     END
0060                         
0061                         
0062                         ; -----------------------------------------------------
0063                         ; Over 20 stone so random heavy phrase to ports B
0064                         ; -----------------------------------------------------
0065                         TOHEAVY
0066 0234 20 00                      BRA END
0067                         ERROR
0068                         
0069                         END
0070                                 ; comment message goes here
0071                                 ;LDX     #MYNAME
0072                                 ;JSR     PR_PHRASE
0073 0236 7e 02 05                   JMP     MAINLOOP  ;START   ; all done
0074                         
