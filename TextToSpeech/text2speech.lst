0388                         PR_PHRASE
0389 0403 4c                         INCA
0390 0404 ce 04 73                   LDX     #PHRASEPTR  ; load address of phrase ponter
0391                                                     ; table
0392 0407 4a                 PR_PH1  DECA                ; loop through A times to get
0393 0408 27 04                      BEQ     FOUNDP      ;   address of phrase
0394 040a 08                         INX                 ; move to next address
0395 040b 08                         INX
0396 040c 20 f9                      BRA     PR_PH1      ; try again
0397                         
0398 040e a6 00              FOUNDP  LDAA    0,X         ; transfer addr pointed to by X to memory
0399 0410 b7 06 c3                   STAA    T_P         ; MSB
0400 0413 a6 01                      LDAA    1,X         ;
0401 0415 b7 06 c4                   STAA    T_P+1       ; LSB
0402 0418 fe 06 c3           PR_PH3  LDX     T_P         ; load X
0403 041b a6 00                      LDAA    0,X         ; get word id
0404 041d 08                         INX                 ; point X to next word
0405 041e ff 06 c3                   STX     T_P         ; store X away
0406 0421 81 00                      CMPA    #0
0407 0423 27 08                      BEQ     PR_PH2      ; no more words
0408 0425 bd 04 2e                   JSR     PR_WORD     ; print word based on value in A
0409 0428 bd 03 e5                   JSR     PR_SPCB
0410 042b 20 eb                      BRA     PR_PH3      ; next word
0411 042d 39                 PR_PH2  RTS
