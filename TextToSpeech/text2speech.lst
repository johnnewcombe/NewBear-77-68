0047                         MAINLOOP:
0048                         ; -----------------------------------------------------
0049                         ; Data arrives at port B as four hex characters
0050                         ; -----------------------------------------------------
0051 0105 bd 02 4c                   JSR     GETDATA         ; value in T_WEIGHT, stones in A
0052 0108 25 03                      BCS     ML1             ; is it invalid i.e. carry clear
0053 010a 7e 01 9d                   JMP     IDLE
0054 010d 81 14              ML1     CMPA    #20             ; more that 20 is too heavy
0055 010f 22 45                      BHI     OVERLOADED
0056 0111 b6 19 52                   LDAA    T_WEIGHT+1      ; validate pounds
0057 0114 81 0d                      CMPA    #13             ; invalid pounds
0058 0116 22 65                      BHI     ERROR           ; error
0059 0118 bd 01 c4                   JSR GREET               ; send a greeting message
0060                         
