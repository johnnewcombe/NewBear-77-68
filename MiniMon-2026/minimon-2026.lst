0487 fea8 eb 00              .fOutHx2    ADDB    0,X         ; Update checksum
0488 feaa 36                             PSHA                ; Push A to STACK
0489 feab a6 00                          LDAA    0,X         ; Load byte to be o/p
0490 fead bd fc c9                       JSR     ZOUT        ; O/P byte <- X
0491 feb0 32                             PULA                ; Pull A off STACK
0492 feb1 08                             INX                 ; Increment X
