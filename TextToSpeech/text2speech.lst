                            282 ; -----------------------------------------------------
                            283 ; Reads a character from ACIA(b) into A
                            284 ; -----------------------------------------------------
   02A1 7C 19 61      [ 6]  285 RD_B:    INC     RND         ; simple way to get a random number
   02A4 B6 F4 03      [ 4]  286         LDAA    CTRLB       ; Get ACIA.A status byte
   02A7 85 01         [ 2]  287         BITA    #01         ; Is byte ready in DATAb
   02A9 27 F6         [ 4]  288         BEQ     RD_B        ; No: Try again
   02AB B6 F4 02      [ 4]  289         LDAA    DATAB       ; Get the data byte to A
   02AE 84 7F         [ 2]  290         ANDA    #0x7F        ; Mask off parity bit if it exists
   02B0 39            [ 5]  291         RTS                 ; RETURN
                            292 
                            293 ; -----------------------------------------------------
                            294 ;
                            295 ; -----------------------------------------------------
   02B1 8D EE         [ 8]  296 ZINB:    BSR     RD_B    ; Read a character
   02B3 BD FC 1D      [ 9]  297         JSR     VHEX    ; Is it a hex character ?
   02B6 25 12         [ 4]  298         BCS     Z_PRQM  ; No: go to print `?`
   02B8 B7 19 51      [ 5]  299         STAA    T_Q     ; Yes: Save Acc.A
   02BB 8D E4         [ 8]  300         BSR     RD_B    ; Read 2nd character
   02BD BD FC 1D      [ 9]  301         JSR     VHEX    ; Is it a hex character ?
   02C0 25 08         [ 4]  302         BCS     Z_PRQM  ; No: go to print `?`
   02C2 16            [ 2]  303         TAB             ; Yes: Put it into Acc.B
   02C3 B6 19 51      [ 4]  304         LDAA    T_Q     ; Retrieve 1st hex char to Acc.A
   02C6 BD FC 31      [ 9]  305         JSR     BINARY  ; Convert A:B to binary
   02C9 39            [ 5]  306         RTS             ; RETURN
   02CA                     307 Z_PRQM:  ;LDAA    #'?     ; Load `?` into A
                            308         ;BSR     PR_B    ; Print it
   02CA 20 E5         [ 4]  309         BRA     ZINB    ; Go back to start of hex input
                            310 
                            311 
                            312 ; -----------------------------------------------------
                            313 ; Print character in A to ACIA(b)
                            314 ; -----------------------------------------------------
   02CC F6 F4 03      [ 4]  315 PR_B:    LDAB    CTRLB   ; Get ACIA(a) status byte
   02CF C5 02         [ 2]  316         BITB    #02     ; Is it busy ?
   02D1 27 F9         [ 4]  317         BEQ     PR_B    ; Yes: Try again
   02D3 B7 F4 02      [ 5]  318         STAA    DATAB   ;  No: Send data
   02D6 39            [ 5]  319 PRB_END: RTS             ; RETURN
                            320 
                            321 ; -----------------------------------------------------
