0195                         ;--------------------------------------------------------------
0196                         ; Gets the weight data from the scales and rerurns with carry
0197                         ; set if a valid reading, carry clear otherwise. A valid weight
0198                         ; reading resets the idle count. Data received is stored in
0199                         ; T_WEIGHT and MSB in A.
0200                         ;--------------------------------------------------------------
0201                         GETDATA
0202 0327 bd 03 b1                   JSR     RD_XB           ; read 4 hex characters into X
0203 032a ff 06 cd                   STX     T_WEIGHT        ; store X
0204 032d 0c                         CLC
0205 032e b6 06 cd                   LDAA    T_WEIGHT        ; get fist byte (stones)
0206 0331 27 04                      BEQ     GDDONE          ; idle message
0207 0333 7f 00 5a                   CLR     IDLE_SECS       ; not an idle message so reset the idle counter
0208 0336 0d                         SEC                     ; non idle message return with carry set
0209 0337 39                 GDDONE  RTS
0210                         
0211                         ;--------------------------------------------------------------
0212                         ; DECIMAL CONVERSION EXAMPLE
0213                         ;--------------------------------------------------------------
0214                                 ;JSR     PR_DEC          ; puts 3 decimal digits in DEC, DEC+1 and DEC+2
0215                                 ;LDAA    DEC+1           ; don't care about the hundreds        ADDA    #$30
0216                                 ;JSR     PR_WORD
0217                                 ;JSR     PR_SPCB
0218                                 ;LDAA    DEC+2
0219                                 ;JSR     PR_WORD
0220                         
0221                         ; -----------------------------------------------------
0222                         ; PR_DEC: Puts 3 decimal digits in DEC, DEC+1 and DEC+2
0223                         ;
0224                         ;       !! ONLY WORKS WITH VALUES BELOW 128 !!
0225                         ; -----------------------------------------------------
0226 0338 5f                 PR_DEC  CLRB            ; Clear B for hundreds
0227                         
0228 0339 81 64              HUND    CMPA    #100    ; 100 or more?
0229                         
0230 033b 2d 05                      BLT     TENS
0231 033d 80 64                      SUBA    #100    ; Sub 100
0232 033f 5c                         INCB            ; Increment hundred counter
0233 0340 20 f7                      BRA     HUND
0234                         
0235 0342 f7 06 c7           TENS    STAB    DEC     ; store the hundreds
0236                         
0237 0345 5f                         CLRB
0238 0346 81 0a              TENS1   CMPA    #10     ; 10 or more?
0239 0348 2d 05                      BLT     UNITS
0240 034a 80 0a                      SUBA    #10     ; Sub 10
0241 034c 5c                         INCB            ; Increment ten counter
0242 034d 20 f7                      BRA     TENS1
0243                         
0244 034f f7 06 c8           UNITS   STAB    DEC+1
0245 0352 b7 06 c9                   STAA    DEC+2   ; Final remainder is units
0246                         
0247 0355 39                         RTS
0248                         
0249                         
0250                         ; -----------------------------------------------------
0251                         ; Print string FOLLOWING JSR ( terminated by $FF ) to
0252                         ; ACIA(b) and ACIA(b)
0253                         ; -----------------------------------------------------
0254 0356 30                 STRINGB TSX             ; Get loc. of return addr to X
0255 0357 ee 00                      LDX     0,X     ; Get return addr to X
0256 0359 09                         DEX             ; Point to byte before
0257 035a 08                 AGAIN   INX             ; Point to next byte
0258 035b a6 00                      LDAA    0,X     ; Get byte to be printed
0259 035d 81 ff                      CMPA    #$FF    ; End-string ?
0260 035f 27 07                      BEQ     ENDSTR  ; Yes: Go to finish up
0261 0361 bd fc 0f                   JSR     PR_A    ; Print the byte to ACIA(a) (A is maintained)
0262 0364 8d 40                      BSR     PR_B    ; Print the byte to ACIA(b)
0263 0366 20 f2                      BRA     AGAIN   ; Go back for next byte
0264 0368 31                 ENDSTR  INS             ; Clean up stack...
0265 0369 31                         INS             ;  ( pop off the return addr )
0266 036a 6e 01                      JMP     1,X     ; Jump back to caller (RETURN)
0267                         
0268                         ; -----------------------------------------------------
0269                         ; Prints a string pointed to by X
0270                         ; -----------------------------------------------------
0271 036c a6 00              STRINGBX    LDAA    0,X         ; get char
0272 036e 81 ff                          CMPA    #$FF        ; is character NULL?
0273 0370 27 08                          BEQ     DONEB       ; yes, end of string
0274 0372 bd fc 0f                       JSR     PR_A        ; Print the byte to ACIA(a) (A is maintained)
0275 0375 8d 2f                          BSR     PR_B        ; Print the byte to ACIA(b)
0276 0377 08                             INX
0277 0378 20 f2                          BRA     STRINGBX
0278 037a 39                 DONEB       RTS
0279                         
0280                         ; -----------------------------------------------------
0281                         ; Reads a character from ACIA(b) into A
0282                         ; -----------------------------------------------------
0283 037b 7c 06 ca           RD_B    INC     RND         ; simple way to get a random number
0284 037e b6 f4 03                   LDAA    CTRLB       ; Get ACIA.A status byte
0285 0381 85 01                      BITA    #01         ; Is byte ready in DATAb
0286 0383 27 f6                      BEQ     RD_B        ; No: Try again
0287 0385 b6 f4 02                   LDAA    DATAB       ; Get the data byte to A
0288 0388 84 7f                      ANDA    #$7F        ; Mask off parity bit if it exists
0289 038a 39                         RTS                 ; RETURN
0290                         
0291                         ; -----------------------------------------------------
0292                         ;
0293                         ; -----------------------------------------------------
0294 038b 8d ee              ZINB    BSR     RD_B    ; Read a character
0295 038d bd fc 1d                   JSR     VHEX    ; Is it a hex character ?
0296 0390 25 12                      BCS     Z_PRQM  ; No: go to print `?`
0297 0392 b7 06 be                   STAA    T_Q     ; Yes: Save Acc.A
0298 0395 8d e4                      BSR     RD_B    ; Read 2nd character
0299 0397 bd fc 1d                   JSR     VHEX    ; Is it a hex character ?
0300 039a 25 08                      BCS     Z_PRQM  ; No: go to print `?`
0301 039c 16                         TAB             ; Yes: Put it into Acc.B
0302 039d b6 06 be                   LDAA    T_Q     ; Retrieve 1st hex char to Acc.A
0303 03a0 bd fc 31                   JSR     BINARY  ; Convert A:B to binary
0304 03a3 39                         RTS             ; RETURN
0305                         Z_PRQM  ;LDAA    #'?     ; Load `?` into A
0306                                 ;BSR     PR_B    ; Print it
0307 03a4 20 e5                      BRA     ZINB    ; Go back to start of hex input
0308                         
0309                         ; -----------------------------------------------------
0310                         ; Print character in A to ACIA(b)
0311                         ; -----------------------------------------------------
0312 03a6 f6 f4 03           PR_B    LDAB    CTRLB   ; Get ACIA(a) status byte
0313 03a9 c5 02                      BITB    #02     ; Is it busy ?
0314 03ab 27 f9                      BEQ     PR_B    ; Yes: Try again
0315 03ad b7 f4 02                   STAA    DATAB   ;  No: Send data
0316 03b0 39                 PRB_END RTS             ; RETURN
0317                         
0318                         ; -----------------------------------------------------
0319                         ; Read 4 hex digits and put value into X
0320                         ; -----------------------------------------------------
0321 03b1 8d d8              RD_XB   BSR     ZINB    ; Read 2 digit hex value into A
0322 03b3 b7 06 bf                   STAA    T_Z     ; Save byte (most significant)
0323 03b6 8d d3                      BSR     ZINB    ; Read 2 digit hex value into A
0324 03b8 b7 06 c0                   STAA    T_Z+1   ; Save byte (least significant)
0325 03bb fe 06 bf                   LDX     T_Z     ; Load full 4 hex value into X
0326 03be 39                         RTS             ; RETURN
0327                         
0328                         ; -----------------------------------------------------
0329                         ; Prints the message " n stones n pounds"
0330                         ; place stones in MSB of X and pound in LSB
0331                         ; -----------------------------------------------------
0332                         PR_WEIGHT
0333 03bf ff 06 c5                   STX     T_W
0334 03c2 b6 06 c5                   LDAA    T_W             ; Load high byte of X into Accumulator A
0335 03c5 bd 04 2e                   JSR     PR_WORD         ; n
0336 03c8 bd 03 e5                   JSR     PR_SPCB
0337 03cb 86 1b                      LDAA    #$1B
0338 03cd bd 04 2e                   JSR     PR_WORD         ; "stones"
0339 03d0 bd 03 e5                   JSR     PR_SPCB
0340 03d3 b6 06 c6                   LDAA    T_W+1            ; Load high byte of X into Accumulator A
0341 03d6 bd 04 2e                   JSR     PR_WORD         ; n
0342 03d9 86 1c                      LDAA    #$1C
0343 03db bd 03 e5                   JSR     PR_SPCB
0344 03de bd 04 2e                   JSR     PR_WORD         ; "pounds"
0345 03e1 bd 03 f0                   JSR     PR_CRB
0346 03e4 39                         RTS
0347                         
0348                         ; -----------------------------------------------------
0349                         ; Prints a space on both consoles (preserves A)
0350                         ; -----------------------------------------------------
0351 03e5 36                 PR_SPCB   PSHA
0352 03e6 86 20                      LDAA    #$20        ; Put space character in A
0353 03e8 bd fc 0f                   JSR     PR_A
0354 03eb bd 03 a6                   JSR     PR_B        ; Print it
0355 03ee 32                         PULA
0356 03ef 39                         RTS                 ; RETURN
0357                         
0358                         ; -----------------------------------------------------
0359                         ; Prints a CRLF on both consoles (preserves A)
0360                         ; -----------------------------------------------------
0361 03f0 36                 PR_CRB  PSHA
0362 03f1 86 0d                      LDAA    #$0D        ; Put CHAR character in A
0363 03f3 bd fc 0f                   JSR     PR_A
0364 03f6 bd 03 a6                   JSR     PR_B        ; Print it
0365 03f9 86 0a                      LDAA    #$0A
0366 03fb bd fc 0f                   JSR     PR_A
0367 03fe bd 03 a6                   JSR     PR_B        ; Print it
0368 0401 32                         PULA
0369 0402 39                         RTS                 ; RETURN
0370                         
