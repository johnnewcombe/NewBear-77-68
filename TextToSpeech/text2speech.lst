   021C 7F 1A 0B      [ 6]  150 IDLE1:   CLR     IDLE_COUNT      ; time to output an idle message so reset the count
   021F B6 1A 0C      [ 4]  151         LDAA    IDLE_MSG_ID     ; get next Message ID
   0222 81 19         [ 2]  152         CMPA    #IDLE_MSG_CNT   ; are we beyond the end of the list
   0224 26 04         [ 4]  153         BNE     IDLE_OP         ; still at valid id so output idle message
   0226 7F 1A 0C      [ 6]  154         CLR     IDLE_MSG_ID     ; beyond last message so reset the current msg to zero
   0229 4F            [ 2]  155         CLRA                    ; set currentid back to 0
