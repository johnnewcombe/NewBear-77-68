0524 ff04 bd fc 89           DUMP    JSR     GETADD  ; Prompt for boundary addresses
0525 ff07 fe f0 ef                   LDX     T_STRT  ;
0526 ff0a bd fe 97           D_NEW   JSR     NEWLINE ; Print c/r l/f nul
0527 ff0d 86 08                      LDAA    #$08    ;
0528 ff0f b7 f0 f6                   STAA    T_Q     ; T_Q = 8
0529 ff12 09                         DEX             ; X = X - 1
0530 ff13 08                 D_NXT   INX             ; X = X + 1
0531 ff14 bd fd 4d                   JSR     PRSP    ; Print a space
0532 ff17 a6 00                      LDAA    0,X     ; Get a byte
0533 ff19 bd fc c9                   JSR     ZOUT    ; Print it as 2.hex digits
0534 ff1c bc f0 f1                   CPX     T_STOP  ; Finished ?
0535 ff1f 26 06                      BNE     D_CNT   ; No: Carry on
0536 ff21 b6 f4 00           D_END   LDAA    DATAA   ; Get a byte from ACIA (clear)
0537 ff24 7e ff 8c                   JMP     START   ; Return to MINIMON
0538 ff27 b6 f4 01           D_CNT   LDAA    CTRLA   ; Read ACIA status
0539 ff2a 85 01                      BITA    #$01    ; Stop dump ?
0540 ff2c 26 f3                      BNE     D_END   ; Yes; go clear ACIA etc
0541 ff2e 7a f0 f6                   DEC     T_Q     ; New line needed ?
0542 ff31 26 e0                      BNE     D_NXT   ; No: Loop back
0543 ff33 08                         INX             ; Print next byte
0544 ff34 20 d4                      BRA     D_NEW   ;  on a new line
