                            144 ; we cycle thought idle message when no one is on the scales, data comes in a one
                            145 ; second intervals so we simply increase the idle count until it's time to display
                            146 ; the next idle message
                            147 
   02EE 7F 1C 5C      [ 6]  148 IDLE:   CLR     PROCESSING_FLG  ; clear the processing flag as no one
                            149                                 ;   is standing on the scales
   02F1 7C 1C 55      [ 6]  150         INC     IDLE_COUNT      ; increase the idle count
   02F4 B6 1C 55      [ 4]  151         LDAA    IDLE_COUNT      ; see if idle count = max idle time
   02F7 81 2D         [ 2]  152         CMPA    #IDLE_TICS      ; a data message appears every second
   02F9 27 03         [ 4]  153         BEQ     IDLE1           ; not reached the max idle time
   02FB 7E 02 6B      [ 3]  154         JMP     MAINLOOP             ; nothing to do yet
                            155 
