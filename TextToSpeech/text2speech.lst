0093 028e 26 05                      BNE     IDLE_OP         ; still at valid id so output idle message
0094 0290 86 00                      LDAA    #0              ; beyond last message so reset the current msg to zero
0095 0292 b7 06 a8                   STAA    IDLE_MSG_ID
