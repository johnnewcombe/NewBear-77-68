                            193 
                            194 ; we cycle thought idle message when no one is on the scales, data comes in a one
                            195 ; second intervals so we simply increase the idle count until it's time to display
                            196 ; the next idle message
                            197 
   02C2 7F 00 18      [ 6]  198 IDLE:   CLR     PROCESSING_FLG  ; clear the processing flag as no one
                            199                                 ;   is standing on the scales
   02C5 7C 00 11      [ 6]  200         INC     IDLE_COUNT      ; increase the idle count
   02C8 B6 00 11      [ 4]  201         LDAA    IDLE_COUNT      ; see if idle count = max idle time
   02CB 81 2D         [ 2]  202         CMPA    #IDLE_TICS      ; a data message appears every second
   02CD 27 03         [ 4]  203         BEQ     IDLE1           ; not reached the max idle time
   02CF 7E 02 3B      [ 3]  204         JMP     MAINLOOP             ; nothing to do yet
                            205 
   02D2                     206 IDLE1:  ;JSR     STRING
                            207         ;.fcc    "ST:IMSG "
                            208         ;.fcb    0x20,0xff
   02D2 7F 00 11      [ 6]  209         CLR     IDLE_COUNT      ; time to output an idle message so reset the count
   02D5 B6 00 12      [ 4]  210         LDAA    IDLE_MSG_ID     ; get next Message ID
   02D8 81 19         [ 2]  211         CMPA    #IDLE_MSG_CNT   ; are we beyond the end of the list
   02DA 26 04         [ 4]  212         BNE     IDLE_OP         ; still at valid id so output idle message
   02DC 7F 00 12      [ 6]  213         CLR     IDLE_MSG_ID     ; beyond last message so reset the current msg to zero
   02DF 4F            [ 2]  214         CLRA                    ; set currentid back to 0
   02E0                     215 IDLE_OP:
   02E0 7C 00 12      [ 6]  216         INC     IDLE_MSG_ID     ; set to next message for the next next time
