0577                         ; A and B preserved by called routines
0578                         ; X = STOP address
0579                         
0580 fdbf 8d 10              ASK_Addrs   BSR     ASK_Start
0581 fdc1 bd fe 6c           ASK_Stop    JSR     PR_STR_JSR  ; Print string...
0582 fdc4 20 53 74 6f 70 3a              FCC     " Stop:"
0583 fdca 00                             FCB     C_EOS       ;
0584 fdcb 8d d9                          BSR     RD_HEX4_S   ; Read 4 digit HEX addr value
0585 fdcd ff f0 09                       STX     d_STOP      ; Save it
0586 fdd0 39                             RTS                 ; RETURN
0587                         
0588 fdd1 bd fe 6c           ASK_Start   JSR     PR_STR_JSR  ; Print string...
0589 fdd4 20 53 74 61 72 74              FCC     " Start:"
     3a
0590 fddb 00                             FCB     C_EOS       ;
0591 fddc 8d c8                          BSR     RD_HEX4_S   ; Read 4 digit HEX addr value
0592 fdde ff f0 07                       STX     d_START     ; Save it
0593 fde1 39                             RTS
