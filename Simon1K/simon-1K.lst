0622                         ;------------------------------------------------------
0623                         ; Output data on stack after SWI...
0624                         ; IE: Dump registers at point of SWI call
0625                         ;
0626 fe01                    PR_STK_SWI  EQU     *
0627 fe01 ff f0 1d                       STX     d_PrStkX    ; Save X
0628 fe04 b7 f0 27                       STAA    b_PrStkA    ; Save A
0629                         
0630 fe07 8d 63                          BSR     PR_STR_JSR  ; Output <newline>`SP=`
0631 fe09 0d 0a                          FCB     C_CR,C_LF   ; <newline>
0632 fe0b 53 50 3d                       FCC     "SP="
0633 fe0e 00                             FCB     C_EOS
0634 fe0f 30                             TSX                 ; get stack ptr + 1
0635                         
0636                                                         ; Note *a*:-
0637 fe10 08                             INX                 ; Move past PC put on stack
0638 fe11 08                             INX                 ; by call to get here from
0639                                                         ; SWI handling
0640 fe12 8d ce                          BSR     PR_HEX4
0641                         
0642 fe14 8d 56                          BSR     PR_STR_JSR  ; Output ` CC=`
0643 fe16 20 43 43 3d                    FCC     " CC="
0644 fe1a 00                             FCB     C_EOS
0645 fe1b 30                             TSX                 ; get stack ptr + 1
0646 fe1c a6 02                          LDAA    2,X         ; +2 as per *a*
0647 fe1e 8d d2                          BSR     PR_HEX2
0648                         
0649 fe20 8d 4a                          BSR     PR_STR_JSR  ; Output ` B=`
0650 fe22 20 42 3d                       FCC     " B="
0651 fe25 00                             FCB     C_EOS
0652 fe26 30                             TSX                 ; get stack ptr + 1
0653 fe27 a6 03                          LDAA    3,X         ; +2 as per *a*
0654 fe29 8d c7                          BSR     PR_HEX2
0655                         
0656 fe2b 8d 3f                          BSR     PR_STR_JSR  ; Output ` A=`
0657 fe2d 20 41 3d                       FCC     " A="
0658 fe30 00                             FCB     C_EOS
0659 fe31 30                             TSX                 ; get stack ptr + 1
0660 fe32 a6 04                          LDAA    4,X         ; +2 as per *a*
0661 fe34 8d bc                          BSR     PR_HEX2
0662                         
0663 fe36 8d 34                          BSR     PR_STR_JSR  ; Output ` X=`
0664 fe38 20 58 3d                       FCC     " X="
0665 fe3b 00                             FCB     C_EOS
0666 fe3c 30                             TSX                 ; get stack ptr + 1
0667 fe3d ee 05                          LDX     5,X         ; +2 as per *a*
0668 fe3f 8d a1                          BSR     PR_HEX4
0669                         
0670 fe41 8d 29                          BSR     PR_STR_JSR  ; Output ` PC=`
0671 fe43 20 50 43 3d                    FCC     " PC="
0672 fe47 00                             FCB     C_EOS
0673 fe48 30                             TSX
0674 fe49 ee 07                          LDX     7,X         ; +2 as per *a*
0675 fe4b 8d 95                          BSR     PR_HEX4
0676                         
0677 fe4d b6 f0 27                       LDAA    b_PrStkA
0678 fe50 fe f0 1d                       LDX     d_PrStkX
0679 fe53 39                             RTS
0680                         
0681                         ;-
0682 0053                    SZ_PSTK     EQU     *-PR_STK_SWI     ; Show size of PR_STK_SWI code
