   0345 39            [ 5]  315 DONEB:      RTS
                            316 
                            317 ; -----------------------------------------------------
                            318 ; Reads a character from ACIA(b) into A
                            319 ; -----------------------------------------------------
   0346 B6 F4 03      [ 4]  320 RD_B:   LDAA    CTRLB       ; Get ACIA.A status byte
   0349 85 01         [ 2]  321         BITA    #01         ; Is byte ready in DATAb
   034B 27 F9         [ 4]  322         BEQ     RD_B        ; No: Try again
   034D B6 F4 02      [ 4]  323         LDAA    DATAB       ; Get the data byte to A
                            324         ;STAA     PANEL
   0350 84 7F         [ 2]  325         ANDA    #0x7F        ; Mask off parity bit if it exists
   0352 39            [ 5]  326         RTS                 ; RETURN
                            327 
                            328 ; -----------------------------------------------------
                            329 ; Reads 2 hex ascii characters and saves them the
                            330 ; byte value to A e.g. "0F" received is stored to A as
                            331 ; 15d.
                            332 ; This version ignores non-hex characters
                            333 ; -----------------------------------------------------
   0353 8D F1         [ 8]  334 ZINB:   BSR     RD_B    ; Read a character
   0355 BD FC 1D      [ 9]  335         JSR     VHEX    ; Is it a hex character ?
   0358 24 02         [ 4]  336         BCC     ZINBA   ; No: go to print `?`
   035A 86 FF         [ 2]  337         LDAA    #0xFF
   035C B7 1B 41      [ 5]  338 ZINBA:  STAA    T_Q     ; Yes: Save Acc.A
   035F 8D E5         [ 8]  339         BSR     RD_B    ; Read 2nd character
   0361 BD FC 1D      [ 9]  340         JSR     VHEX    ; Is it a hex character ?
   0364 24 02         [ 4]  341         BCC     ZINBB   ; No: go to print `?`
   0366 86 FF         [ 2]  342         LDAA    #0xFF
   0368 16            [ 2]  343 ZINBB:  TAB             ; Yes: Put it into Acc.B
   0369 B6 1B 41      [ 4]  344         LDAA    T_Q     ; Retrieve 1st hex char to Acc.A
   036C BD FC 31      [ 9]  345         JSR     BINARY  ; Convert A:B to binary
   036F 39            [ 5]  346         RTS             ; RETURN
                            347 
                            348 ; -----------------------------------------------------
                            349 ; Print character in A to ACIA(b)
                            350 ; -----------------------------------------------------
   0370 F6 F4 03      [ 4]  351 PR_B:    LDAB    CTRLB   ; Get ACIA(a) status byte
   0373 C5 02         [ 2]  352         BITB    #02     ; Is it busy ?
   0375 27 F9         [ 4]  353         BEQ     PR_B    ; Yes: Try again
   0377 B7 F4 02      [ 5]  354         STAA    DATAB   ;  No: Send data
   037A B7 F0 FF      [ 5]  355         STAA    PANEL
   037D 39            [ 5]  356 PRB_END: RTS             ; RETURN
                            357 
                            358 ; -----------------------------------------------------
                            359 ; Read 4 hex digits and put value into X
                            360 ; -----------------------------------------------------
   037E 8D D3         [ 8]  361 RD_XB:   BSR     ZINB    ; Read 2 digit hex value into A
   0380 B7 1B 42      [ 5]  362         STAA    T_Z     ; Save byte (most significant)
   0383 8D CE         [ 8]  363         BSR     ZINB    ; Read 2 digit hex value into A
   0385 B7 1B 43      [ 5]  364         STAA    T_Z+1   ; Save byte (least significant)
   0388 FE 1B 42      [ 5]  365         LDX     T_Z     ; Load full 4 hex value into X
   038B 39            [ 5]  366         RTS             ; RETURN
                            367 
                            368 ; -----------------------------------------------------
                            369 ; Adds A to X and leaves the result in X, A is
ASxxxx Assembler V05.50.5  (Motorola 6800/6802/6808)                    Page 8
Hexadecimal [16-Bits]                                 Tue May 12 16:51:49 2026



                            370 ; preserved.
                            371 ; -----------------------------------------------------
   038C 36            [ 4]  372 ADX:     PSHA
   038D FF 1B 4C      [ 6]  373         STX     T_TMP
   0390 BB 1B 4D      [ 4]  374         ADDA    T_TMP+1   ; add A to low byte
   0393 B7 1B 4D      [ 5]  375         STAA    T_TMP+1
   0396 B6 1B 4C      [ 4]  376         LDAA    T_TMP     ; get high byte
   0399 89 00         [ 2]  377         ADCA    #0      ; add carry only
   039B B7 1B 4C      [ 5]  378         STAA    T_TMP
   039E FE 1B 4C      [ 5]  379         LDX     T_TMP
   03A1 32            [ 4]  380         PULA
   03A2 39            [ 5]  381         RTS
                            382 
                            383 ; -----------------------------------------------------
                            384 ; Loads X with A, A is preserved.
                            385 ; -----------------------------------------------------
   03A3 B7 1B 4D      [ 5]  386 TAX:    STAA    T_TMP+1       ; store A as low byte of X
   03A6 7F 1B 4C      [ 6]  387         CLR     T_TMP         ; zero the high byte
   03A9 FE 1B 4C      [ 5]  388         LDX     T_TMP         ; load X
   03AC 39            [ 5]  389         RTS
                            390 
                            391 ; -----------------------------------------------------
                            392 ; Prints the message " n stones n pounds"
                            393 ; place stones in MSB of X and pound in LSB
                            394 ; -----------------------------------------------------
   03AD                     395 PR_WEIGHT:
                            396 
   03AD FF 1B 4A      [ 6]  397         STX     T_W
   03B0 B6 1B 4A      [ 4]  398         LDAA    T_W
   03B3 BD 03 A3      [ 9]  399         JSR     TAX
   03B6 BD 04 2F      [ 9]  400         JSR     PR_WORD         ; n
   03B9 BD 03 DB      [ 9]  401         JSR     PR_SPCB
   03BC CE 01 2B      [ 3]  402         LDX     #STONES
   03BF BD 04 2F      [ 9]  403         JSR     PR_WORD         ; "stones"
   03C2 BD 03 DB      [ 9]  404         JSR     PR_SPCB
   03C5 B6 1B 4B      [ 4]  405         LDAA    T_W+1            ; Load high byte of X into Accumulator A
   03C8 BD 03 A3      [ 9]  406         JSR     TAX
   03CB BD 04 2F      [ 9]  407         JSR     PR_WORD         ; n
   03CE CE 00 F5      [ 3]  408         LDX     #POUNDS
   03D1 BD 03 DB      [ 9]  409         JSR     PR_SPCB
   03D4 BD 04 2F      [ 9]  410         JSR     PR_WORD         ; "pounds"
   03D7 BD 03 E6      [ 9]  411         JSR     PR_CRB
   03DA 39            [ 5]  412         RTS
                            413 
                            414 ; -----------------------------------------------------
                            415 ; Prints a space on both consoles (preserves A)
                            416 ; -----------------------------------------------------
   03DB 36            [ 4]  417 PR_SPCB: PSHA
   03DC 86 20         [ 2]  418         LDAA    #0x20        ; Put space character in A
   03DE BD FC 0F      [ 9]  419         JSR     PR_A
   03E1 BD 03 70      [ 9]  420         JSR     PR_B        ; Print it
   03E4 32            [ 4]  421         PULA
   03E5 39            [ 5]  422         RTS                 ; RETURN
                            423 
                            424 ; -----------------------------------------------------
ASxxxx Assembler V05.50.5  (Motorola 6800/6802/6808)                    Page 9
Hexadecimal [16-Bits]                                 Tue May 12 16:51:49 2026



                            425 ; Prints a CRLF on both consoles (preserves A)
                            426 ; -----------------------------------------------------
   03E6 36            [ 4]  427 PR_CRB:     PSHA
   03E7 86 0D         [ 2]  428             LDAA    #0x0D        ; Put CHAR character in A
   03E9 BD FC 0F      [ 9]  429             JSR     PR_A
   03EC BD 03 70      [ 9]  430             JSR     PR_B        ; Print it
   03EF 86 0A         [ 2]  431             LDAA    #0x0A
   03F1 F6 F0 FF      [ 4]  432             LDAB     PANEL
   03F4 C5 01         [ 2]  433             BITB    #1
   03F6 27 03         [ 4]  434             BEQ     PR_CRB1
   03F8 BD FC 0F      [ 9]  435             JSR     PR_A
   03FB BD 03 70      [ 9]  436 PR_CRB1:    JSR     PR_B        ; Print it
   03FE 32            [ 4]  437             PULA
   03FF 39            [ 5]  438             RTS                 ; RETURN
                            439 
                            440 ; -----------------------------------------------------
                            441 ; Prints a CR/LF to ACIA(a) A is preserved
                            442 ; -----------------------------------------------------
   0400 36            [ 4]  443 PR_CR:     PSHA
   0401 86 0D         [ 2]  444             LDAA    #0x0D        ; Put CHAR character in A
   0403 BD FC 0F      [ 9]  445             JSR     PR_A
   0406 86 0A         [ 2]  446             LDAA    #0x0A
   0408 BD FC 0F      [ 9]  447             JSR     PR_A
   040B 32            [ 4]  448 PR_CR1:    PULA
   040C 39            [ 5]  449             RTS                 ; RETURN
                            450 
                            451 ; -----------------------------------------------------
                            452 ; Outputs a phrase from the memory location in X
                            453 ; -----------------------------------------------------
   040D                     454 PR_PHRASE:
                            455 
   040D A6 00         [ 5]  456 PR_PH1:  LDAA    0,X         ; get high byte of word
   040F E6 01         [ 5]  457         LDAB    1,X         ; get low byte
   0411 81 FF         [ 2]  458         CMPA    #0xFF        ; check high byte
   0413 27 19         [ 4]  459         BEQ     PR_PH2      ; high byte is 0xFF so we're done
   0415 FF 1B 46      [ 6]  460 PR_PH3:  STX     T_Y         ; save table pointer
   0418 B7 1B 48      [ 5]  461         STAA    T_P
   041B F7 1B 49      [ 5]  462         STAB    T_P+1
   041E FE 1B 48      [ 5]  463         LDX     T_P         ; X now points to the word
   0421 BD 04 2F      [ 9]  464         JSR     PR_WORD
   0424 BD 03 DB      [ 9]  465         JSR     PR_SPCB
   0427 FE 1B 46      [ 5]  466         LDX     T_Y         ; restore table pointer
   042A 08            [ 4]  467         INX                 ; move to next entry
   042B 08            [ 4]  468         INX                 ; (2 bytes per entry)
   042C 20 DF         [ 4]  469         BRA     PR_PH1
   042E 39            [ 5]  470 PR_PH2:  RTS
                            471 
                            472 ; -----------------------------------------------------
                            473 ; Outputs a word based on value in X
                            474 ; -----------------------------------------------------
   042F                     475 PR_WORD:
   042F FF 1B 44      [ 6]  476             STX     T_X             ; use ASL and ROL to multiply by 2 (pointer is 2 bytes wide)
   0432 78 1B 45      [ 6]  477             ASL     T_X+1           ; shift low byte left, bit 7 goes to carry
   0435 79 1B 44      [ 6]  478             ROL     T_X             ; rotate high byte left, carry in from low byte
   0438 FE 1B 44      [ 5]  479             LDX     T_X
ASxxxx Assembler V05.50.5  (Motorola 6800/6802/6808)                   Page 10
Hexadecimal [16-Bits]                                 Tue May 12 16:51:49 2026



   043B FF 1B 44      [ 6]  480             STX     T_X             ; Stash X
   043E B6 1B 44      [ 4]  481             LDAA    T_X             ; High byte of X
   0441 F6 1B 45      [ 4]  482             LDAB    T_X+1           ; Low byte of X
   0444 CB 68         [ 2]  483             ADDB    #<WORDPTR    ; Add low byte of WORDPTR address
   0446 89 04         [ 2]  484             ADCA    #>WORDPTR    ; Add high byte of WORDPTR address + carry
   0448 B7 1B 44      [ 5]  485             STAA    T_X             ; T_X has the address of the pointer NOT the word
   044B F7 1B 45      [ 5]  486             STAB    T_X+1
   044E FE 1B 44      [ 5]  487             LDX     T_X             ; X has the address of the pointer NOT the word
                            488 
   0451 A6 00         [ 5]  489             LDAA    0,X             ; get the hi byte of the word
   0453 B7 1B 44      [ 5]  490             STAA    T_X
   0456 A6 01         [ 5]  491             LDAA    1,X             ; get the low byte of the word
   0458 B7 1B 45      [ 5]  492             STAA    T_X+1
   045B FE 1B 44      [ 5]  493             LDX     T_X             ; X now has address of the word
   045E BD 03 30      [ 9]  494             JSR     STRINGBX        ; output the word
   0461 7C 1B 5A      [ 6]  495             INC     WORDS
   0464 BD FD 4D      [ 9]  496             JSR     PRSP
   0467 39            [ 5]  497             RTS
