                             49 ; -----------------------------------------------------
                             50 ; Data arrives at port B as four hex characters
                             51 ; -----------------------------------------------------
   0105 BD 02 4C      [ 9]   52         JSR     GETDATA         ; value in T_WEIGHT, stones in A
   0108 25 03         [ 4]   53         BCS     ML1             ; is it invalid i.e. carry clear
   010A 7E 01 9D      [ 3]   54         JMP     IDLE
   010D 81 14         [ 2]   55 ML1:     CMPA    #20             ; more that 20 is too heavy
