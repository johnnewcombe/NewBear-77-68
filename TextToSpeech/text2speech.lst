0001                         ;------------------------------------------------------------------
0002                         ; text2speech.asm
0003                         ;------------------------------------------------------------------
0004                         
0005                         ; 7768 ACIA
0006 f400                    DATAA   EQU $F400 ; ACIA(a) Data register
0007 f401                    CTRLA   EQU $F401 ; ACIA(a) Ctrl/Status
0008 f402                    DATAB   EQU $F402 ; ACIA(b) Data register
0009 f403                    CTRLB   EQU $F403 ; ACIA(b) Ctrl/Status
0010                         
0011                         ; MINIMON routines
0012 fc76                    STRING  EQU $FC76 ; Prints a string. The string should follow JSR and be terminated with $FF.
0013 fc89                    GETADD  EQU $FC89 ; Get Address, read 4 digit hex value.
0014 fcc9                    ZOUT    EQU $FCC9 ; Print value in A as 2 hex digits.
0015 fe97                    NEWLINE EQU $FE97 ; Prints a new line.
0016 ff8f                    START   EQU $FF8F ; Restarts MniMon.
0017 fc0f                    PR_A    EQU $FC0F ; Print char in A to ACIA (a)
0018 fd2b                    RD_A    EQU $FD2B ; Read char from A
0019 fd4d                    PRSP    EQU $FD4D ; Print a space
0020 fc31                    BINARY  EQU $FC31 ; Converts ASCII hex digits in A and B to binary?
0021 fc65                    RD_X    EQU $FC65 ; Read 4 hex digits Value from ACIA(a) and put value into X.
0022 fc1d                    VHEX    EQU $FC1D ; Checks that A contains a HEX character
0023 0200                    	    ORG $0200
0024                         
0025                         ; initialise serial port B
0026 0200 86 11              TX2SP   LDAA    #$11    ; 8 Data, No Parity, 2 Stop Bits
0027 0202 b7 f4 03                   STAA    CTRLB   ;   ACIA.A
0028                         
0029                         MAINLOOP:
0030                         ; -----------------------------------------------------
0031                         ; Data arrives at port B as four hex characters
0032                         ; -----------------------------------------------------
0033 0205 bd 02 c2                   JSR     RD_XB           ; read 4 hex characters into X
0034 0208 ff 04 36                   STX     TEMP            ; store X
0035 020b b6 04 36                   LDAA    TEMP            ; get fist byte (stones)
0036 020e 81 14                      CMPA    #20             ; more that 20 is too heavey
0037 0210 22 14                      BHI     TOHEAVY         ; say something rude
0038 0212 b6 04 37                   LDAA    TEMP+1          ; get pounds
0039 0215 81 0d                      CMPA    #13             ; invalid pounds
0040 0217 22 0d                      BHI     ERROR           ; error
0041                         
0042                                 ; all good so output the weight mesage
0043 0219 86 00                      LDAA    #0              ; output the 'you weigh' phrase
0044 021b bd 03 05                   JSR     PR_PHRASE       ; output phrase specified in A
0045 021e fe 04 36                   LDX     TEMP            ; restore X
0046 0221 bd 02 d0                   JSR     PR_WEIGHT       ; weight back X so output the weight
0047                         
0048 0224 20 00                      BRA     END
0049                         
0050                         ; -----------------------------------------------------
0051                         ; Over 20 stone so random heavy phrase to ports B
0052                         ; -----------------------------------------------------
0053                         TOHEAVY
0054                         ERROR
0055                         
0056                         END
0057 0226 ce 03 79                   LDX     #TWENTYONE
0058 0229 bd 03 05                   JSR     PR_PHRASE
0059 022c 7e 02 05                   JMP     MAINLOOP  ;START   ; all done
0060                         
0061                         ; -----------------------------------------------------
0062                         ; Random idle phrase to ports B
0063                         ; -----------------------------------------------------
0064 022f bd 02 6c           IDLE    JSR     STRINGB
0065 0232 53 68 61 6c 6c 20          FCC     "Shall I tell you a joke?"
     49 20 74 65 6c 6c
     20 79 6f 75 20 61
     20 6a 6f 6b 65 3f
0066 024a 0a 0d ff                   FCB     $0A, $0D, $FF
0067 024d 39                         RTS
0068                         
0069                         ;--------------------------------------------------------------
0070                         ; DECIMAL CONVERSION EXAMPLE
0071                         ;--------------------------------------------------------------
0072                                 ;JSR     PR_DEC          ; puts 3 decimal digits in DEC, DEC+1 and DEC+2
0073                                 ;LDAA    DEC+1           ; don't care about the hundreds        ADDA    #$30
0074                                 ;JSR     PR_WORD
0075                                 ;JSR     PR_SPCB
0076                                 ;LDAA    DEC+2
0077                                 ;JSR     PR_WORD
0078                         
0079                         ; -----------------------------------------------------
0080                         ; PR_DEC: Puts 3 decimal digits in DEC, DEC+1 and DEC+2
0081                         ;
0082                         ;       !! ONLY WORKS WITH VALUES BELOW 128 !!
0083                         ; -----------------------------------------------------
0084 024e 5f                 PR_DEC  CLRB            ; Clear B for hundreds
0085                         
0086 024f 81 64              HUND    CMPA    #100    ; 100 or more?
0087                         
0088 0251 2d 05                      BLT     TENS
0089 0253 80 64                      SUBA    #100    ; Sub 100
0090 0255 5c                         INCB            ; Increment hundred counter
0091 0256 20 f7                      BRA     HUND
0092                         
0093 0258 f7 04 33           TENS    STAB    DEC     ; store the hundreds
0094                         
0095 025b 5f                         CLRB
0096 025c 81 0a              TENS1   CMPA    #10     ; 10 or more?
0097 025e 2d 05                      BLT     UNITS
0098 0260 80 0a                      SUBA    #10     ; Sub 10
0099 0262 5c                         INCB            ; Increment ten counter
0100 0263 20 f7                      BRA     TENS1
0101                         
0102 0265 f7 04 34           UNITS   STAB    DEC+1
0103 0268 b7 04 35                   STAA    DEC+2   ; Final remainder is units
0104                         
0105 026b 39                         RTS
0106                         
0107                         
0108                         ; -----------------------------------------------------
0109                         ; Print string FOLLOWING JSR ( terminated by $FF ) to
0110                         ; ACIA(b) and ACIA(b)
0111                         ; -----------------------------------------------------
0112 026c 30                 STRINGB TSX             ; Get loc. of return addr to X
0113 026d ee 00                      LDX     0,X     ; Get return addr to X
0114 026f 09                         DEX             ; Point to byte before
0115 0270 08                 AGAIN   INX             ; Point to next byte
0116 0271 a6 00                      LDAA    0,X     ; Get byte to be printed
0117 0273 81 ff                      CMPA    #$FF    ; End-string ?
0118 0275 27 07                      BEQ     ENDSTR  ; Yes: Go to finish up
0119 0277 bd fc 0f                   JSR     PR_A    ; Print the byte to ACIA(a) (A is maintained)
0120 027a 8d 3b                      BSR     PR_B    ; Print the byte to ACIA(b)
0121 027c 20 f2                      BRA     AGAIN   ; Go back for next byte
0122 027e 31                 ENDSTR  INS             ; Clean up stack...
0123 027f 31                         INS             ;  ( pop off the return addr )
0124 0280 6e 01                      JMP     1,X     ; Jump back to caller (RETURN)
0125                         
0126                         ; -----------------------------------------------------
0127                         ; Prints a string pointed to by X
0128                         ; -----------------------------------------------------
0129 0282 a6 00              STRINGBX    LDAA    0,X         ; get char
0130 0284 81 ff                          CMPA    #$FF        ; is character NULL?
0131 0286 27 08                          BEQ     DONEB       ; yes, end of string
0132 0288 bd fc 0f                       JSR     PR_A        ; Print the byte to ACIA(a) (A is maintained)
0133 028b 8d 2a                          BSR     PR_B        ; Print the byte to ACIA(b)
0134 028d 08                             INX
0135 028e 20 f2                          BRA     STRINGBX
0136 0290 39                 DONEB       RTS
0137                         
0138                         ; -----------------------------------------------------
0139                         ; Reads a character from ACIA(b) into A
0140                         ; -----------------------------------------------------
0141 0291 b6 f4 03           RD_B    LDAA    CTRLB       ; Get ACIA.A status byte
0142 0294 85 01                      BITA    #01         ; Is byte ready in DATAb
0143 0296 27 f9                      BEQ     RD_B        ; No: Try again
0144 0298 b6 f4 02                   LDAA    DATAB       ; Get the data byte to A
0145                                 ;ANDA    #$7F        ; Mask off parity bit if it exists
0146 029b 39                         RTS                 ; RETURN
0147                         
0148                         ; -----------------------------------------------------
0149                         ;
0150                         ; -----------------------------------------------------
0151 029c 8d f3              ZINB    BSR     RD_B    ; Read a character
0152 029e bd fc 1d                   JSR     VHEX    ; Is it a hex character ?
0153 02a1 25 12                      BCS     Z_PRQM  ; No: go to print `?`
0154 02a3 b7 04 2a                   STAA    T_Q     ; Yes: Save Acc.A
0155 02a6 8d e9                      BSR     RD_B    ; Read 2nd character
0156 02a8 bd fc 1d                   JSR     VHEX    ; Is it a hex character ?
0157 02ab 25 08                      BCS     Z_PRQM  ; No: go to print `?`
0158 02ad 16                         TAB             ; Yes: Put it into Acc.B
0159 02ae b6 04 2a                   LDAA    T_Q     ; Retrieve 1st hex char to Acc.A
0160 02b1 bd fc 31                   JSR     BINARY  ; Convert A:B to binary
0161 02b4 39                         RTS             ; RETURN
0162                         Z_PRQM  ;LDAA    #'?     ; Load `?` into A
0163                                 ;BSR     PR_B    ; Print it
0164 02b5 20 e5                      BRA     ZINB    ; Go back to start of hex input
0165                         
0166                         ; -----------------------------------------------------
0167                         ; Print character in A to ACIA(b)
0168                         ; -----------------------------------------------------
0169 02b7 f6 f4 03           PR_B    LDAB    CTRLB   ; Get ACIA(a) status byte
0170 02ba c5 02                      BITB    #02     ; Is it busy ?
0171 02bc 27 f9                      BEQ     PR_B    ; Yes: Try again
0172 02be b7 f4 02                   STAA    DATAB   ;  No: Send data
0173 02c1 39                 PRB_END RTS             ; RETURN
0174                         
0175                         ; -----------------------------------------------------
0176                         ; Read 4 hex digits and put value into X
0177                         ; -----------------------------------------------------
0178 02c2 8d d8              RD_XB   BSR     ZINB    ; Read 2 digit hex value into A
0179 02c4 b7 04 2b                   STAA    T_Z     ; Save byte (most significant)
0180 02c7 8d d3                      BSR     ZINB    ; Read 2 digit hex value into A
0181 02c9 b7 04 2c                   STAA    T_Z+1   ; Save byte (least significant)
0182 02cc fe 04 2b                   LDX     T_Z     ; Load full 4 hex value into X
0183 02cf 39                         RTS             ; RETURN
0184                         
0185                         ; -----------------------------------------------------
0186                         ; Prints the message " n stones n pounds"
0187                         ; place stones in MSB of X and pound in LSB
0188                         ; -----------------------------------------------------
0189                         PR_WEIGHT
0190 02d0 ff 04 31                   STX     T_W
0191                                 ;JSR     STRINGB
0192                                 ;FCC     "You weigh "
0193                                 ;FDB     $FF
0194 02d3 b6 04 31                   LDAA    T_W             ; Load high byte of X into Accumulator A
0195 02d6 bd 03 26                   JSR     PR_WORD
0196 02d9 bd 02 6c                   JSR     STRINGB
0197 02dc 20 73 74 6f 6e 65          FCC     " stones "
     73 20
0198 02e4 00 ff                      FDB     $FF
0199 02e6 b6 04 32                   LDAA    T_W+1            ; Load high byte of X into Accumulator A
0200 02e9 bd 03 26                   JSR     PR_WORD
0201 02ec bd 02 6c                   JSR     STRINGB
0202 02ef 20 70 6f 75 6e 64          FCC     " pounds"
     73
0203 02f6 0d 0a ff                   FCB     $0D, $0A,$FF
0204                         
0205 02f9 39                         RTS
0206                         
0207                         ; -----------------------------------------------------
0208                         ; Prints a space on both consoles (preserves A)
0209                         ; -----------------------------------------------------
0210 02fa 36                 PR_SPCB   PSHA
0211 02fb 86 20                      LDAA    #$20        ; Put space character in A
0212 02fd bd fc 0f                   JSR     PR_A
0213 0300 bd 02 b7                   JSR     PR_B        ; Print it
0214 0303 32                         PULA
0215 0304 39                         RTS                 ; RETURN
0216                         
0217                         ; -----------------------------------------------------
0218                         ; Outputs a phrase from the value in A
0219                         ; -----------------------------------------------------
0220                         PR_PHRASE
0221 0305 4c                         INCA
0222 0306 fe 03 72                   LDX     PHRASEPTR   ; load address of phrase ponter
0223                                                     ; table
0224 0309 4a                 PR_PH1  DECA                ; loop through A times to get
0225 030a 27 04                      BEQ     FOUNDP      ;   address of phrase
0226 030c 08                         INX                 ; move to next address
0227 030d 08                         INX
0228 030e 20 f9                      BRA     PR_PH1      ; try again
0229 0310 ff 04 2f           FOUNDP  STX     T_P         ; phrase found, save X
0230 0313 a6 00                      LDAA    0,X         ; get word
0231 0315 81 00                      CMPA    #0
0232 0317 27 0c                      BEQ     PR_PH2      ; no more words
0233 0319 bd 03 26                   JSR     PR_WORD     ; print word
0234 031c fe 04 2f                   LDX     T_P         ; recover X
0235 031f 08                         INX
0236 0320 bd 02 fa                   JSR     PR_SPCB
0237 0323 20 eb                      BRA     FOUNDP      ; next word
0238 0325 39                 PR_PH2  RTS
0239                         
0240                         ; -----------------------------------------------------
0241                         ; Outputs a word based on value in A
0242                         ; -----------------------------------------------------
0243 0326 4c                 PR_WORD     INCA
0244 0327 ce 03 42                       LDX     #WORDPTR  ; base of offset table
0245 032a 4a                 PR_WORD1    DECA
0246 032b 27 04                          BEQ     FOUNDW
0247 032d 08                             INX                 ; move to next address
0248 032e 08                             INX
0249 032f 26 f9                          BNE     PR_WORD1    ; loop around to retest
0250 0331 a6 00              FOUNDW      LDAA    0,X
0251 0333 b7 04 2d                       STAA    T_X
0252 0336 a6 01                          LDAA    1,X
0253 0338 b7 04 2e                       STAA    T_X+1
0254 033b fe 04 2d                       LDX     T_X
0255 033e bd 02 82                       JSR     STRINGBX
0256 0341 39                             RTS
0257                         
