1921 0e04 df 26                          STX         STORE1      ; Move to temporary storage 
1922 0e06 ce 04 65                       LDX         #Msg31a     ; Set up pointers (was at $0465)
1923 0e09 df 20                          STX         PNTR1       ; To fill in alien ship location 
