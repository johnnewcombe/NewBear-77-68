0004                         
0005                         ; 7768 ACIA
0006 f400                    DATAA               EQU $F400 ; ACIA(a) Data register
0007 f401                    CTRLA               EQU $F401 ; ACIA(a) Ctrl/Status
0008 f402                    DATAB               EQU $F402 ; ACIA(b) Data register
0009 f403                    CTRLB               EQU $F403 ; ACIA(b) Ctrl/Status
0010                         
0011                         ; MINIMON routines
0012 fc76                    STRING              EQU $FC76   ; Prints a string. The string should follow JSR and be terminated with $FF.
0013 fc89                    GETADD              EQU $FC89   ; Get Address, read 4 digit hex value.
0014 fcc9                    ZOUT                EQU $FCC9   ; Print value in A as 2 hex digits.
0015 fe97                    NEWLINE             EQU $FE97   ; Prints a new line.
0016 ff8f                    START               EQU $FF8F   ; Restarts MniMon.
0017 fc0f                    PR_A                EQU $FC0F   ; Print char in A to ACIA (a)
0018 fd2b                    RD_A                EQU $FD2B   ; Read char from A
0019 fd4d                    PRSP                EQU $FD4D   ; Print a space
0020 fc31                    BINARY              EQU $FC31   ; Converts ASCII hex digits in A and B to binary?
0021 fc65                    RD_X                EQU $FC65   ; Read 4 hex digits Value from ACIA(a) and put value into X.
0022 fc1d                    VHEX                EQU $FC1D   ; Checks that A contains a HEX character
0023                         
0024 005a                    IDLE_SECS           EQU 90      ; seconds between idle messages
0025 0006                    LIGHT_WGHT          EQU 6       ; greater than 6 stones
0026 000a                    NORM_WGHT           EQU 10
0027 000d                    HEAVY_WGHT          EQU 13
0028 000f                    SHEAVY_WGHT         EQU 15
0029                         
0030 0001                    IDLE_MSG_CNT        EQU 1       ; number of messages
0031 0001                    GREET_MSG_CNT       EQU 1       ; number of messages
0032 0001                    LIGHT_MSG_CNT       EQU 1       ; number of messages
0033 0001                    NORM_MSG_CNT        EQU 1       ; number of messages
0034 0001                    HEAVY_MSG_CNT       EQU 1       ; number of messages
0035 0001                    SHEAVY_MSG_CNT      EQU 1       ; number of messages
0036                         
0037 0200                    	    ORG $0200
0038                         
0039                         ; initialise serial port B
0040 0200 86 11              TX2SP   LDAA    #$11    ; 8 Data, No Parity, 2 Stop Bits
0041 0202 b7 f4 03                   STAA    CTRLB   ;   ACIA.A
0042                         
0043                         
0044                         MAINLOOP:
0045                         ; -----------------------------------------------------
0046                         ; Data arrives at port B as four hex characters
0047                         ; -----------------------------------------------------
0048 0205 bd 03 39                   JSR     GETDATA         ; value in T_WEIGHT, stones in A
0049 0208 25 03                      BCS     ML1             ; is it invalid i.e. carry clear
0050 020a 7e 02 a1                   JMP     IDLE
0051 020d 81 14              ML1     CMPA    #20             ; more that 20 is too heavy
0052 020f 22 45                      BHI     OVERLOADED
0053 0211 b6 07 9c                   LDAA    T_WEIGHT+1      ; validate pounds
0054 0214 81 0d                      CMPA    #13             ; invalid pounds
0055 0216 22 6a                      BHI     ERROR           ; error
0056 0218 bd 02 c3                   JSR GREET               ; send a greeting message
0057                         
0058                                 ; get the weight a second time, this should allow the scles time to settle
0059 021b bd 03 39                   JSR     GETDATA
0060                         
0061                                 ; all good so output the weight mesage
0062                                 ; TODO get phrase from phrase table as per other message output routines
0063 021e bd 03 68                   JSR     STRINGB
0064 0221 59 6f 75 20 77 65          FCC     "You weigh"
     69 67 68
0065 022a 00                         FCB     $00
0066 022b fe 07 9b                   LDX     T_WEIGHT        ; restore X
0067 022e bd 03 d1                   JSR     PR_WEIGHT       ; weight back X so output the weight
0068                         
0069                                 ; determine phrase category (light normal, heavy etc.) and jump to the section
0070 0231 b6 07 9b                   LDAA    T_WEIGHT
0071 0234 81 06                      CMPA    #LIGHT_WGHT
0072 0236 22 03                      BHI     ML2             ; less than light weight gets no comment
0073 0238 7e 03 36                   JMP     END
0074 023b 81 0a              ML2     CMPA    #NORM_WGHT      ; less than normal is light
0075 023d 22 03                      BHI     ML3
0076 023f 7e 02 dc                   JMP     LIGHT
0077 0242 81 0d              ML3     CMPA    #HEAVY_WGHT     ; less than heavy is normal
0078 0244 22 03                      BHI     ML4
0079 0246 7e 02 f1                   JMP     NORMALW
0080 0249 81 0f              ML4     CMPA    #SHEAVY_WGHT    ; less than super heavy is heavy
0081 024b 2b 03                      BMI     ML5
0082 024d 7e 03 06                   JMP     HEAVYW
0083 0250 7e 03 1b           ML5     JMP     SHEAVY
0084 0253 7e 03 36                   JMP END
