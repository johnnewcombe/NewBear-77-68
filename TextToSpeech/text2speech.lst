                             83 ; -----------------------------------------------------
                             84 ; Data arrives at port B as four hex characters
                             85 ; -----------------------------------------------------
   016B BD 02 C1      [ 9]   86                 JSR     GETDATA         ; value in T_WEIGHT, stones in A
   016E 25 03         [ 4]   87                 BCS     ML1             ; is it invalid i.e. carry clear
   0170 7E 02 0C      [ 3]   88                 JMP     IDLE
   0173 7D 1A 12      [ 6]   89 ML1:            TST     PROCESSING_FLG  ; are we already processing a weight
   0176 26 F3         [ 4]   90                 BNE     MAINLOOP        ; flag non-zero so ignore everything that follows
   0178 7C 1A 12      [ 6]   91                 INC     PROCESSING_FLG  ; ignore any following data until we next idle
   017B 81 14         [ 2]   92                 CMPA    #TOO_HEAVY      ; more that 20 is too heavy
   017D 22 43         [ 4]   93                 BHI     OVERLOADED
   017F B6 1A 0A      [ 4]   94                 LDAA    T_WEIGHT+1      ; validate pounds
   0182 81 0D         [ 2]   95                 CMPA    #13             ; invalid pounds
   0184 22 65         [ 4]   96                 BHI     ERROR           ; error
   0186 BD 02 36      [ 9]   97                 JSR     GREET           ; send a greeting message
                             98 
                             99                 ; get the weight a second time, this should allow the scales time to settle
   0189 BD 02 C1      [ 9]  100                 JSR     GETDATA
   018C BD 02 F0      [ 9]  101                 JSR     STRINGB         ; all good so output the weight message
   018F 59 6F 75 20 77 65   102                 .fcc     "You weigh "   ; TODO use a phrase
