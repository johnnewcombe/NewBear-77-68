output:  minimon-2026.s19
0001                         ; ----------------------------------------------------------------------------
0002                         ; Minimon (Jan. 2026)
0003                         ; ----------------------------------------------------------------------------
0004                         ; Original author ACH, Dec. 1978;
0005                         ; ----------------------------------------------------------------------------
0006                         ; This is an updated version of MINIMON with the LOAD and PUNCH commands
0007                         ; replaced for versions that support the Motorola S Record Format (.s19)
0008                         ; files.
0009                         ;
0010                         ; All entry points and source code labels as published in the MINIMON
0011                         ; documentation have been preserved with the exception of the LOAD and PUNCH
0012                         ; commands.
0013                         ;
0014                         ; In order to make space for the additional code required, the ALTER and
0015                         ; OFFSET CALCULATION commands have been removed. This has been justified as
0016                         ; the MODIFY command has very similar functionality to ALTER making ALTER
0017                         ; unnecessary, and the OFFSET CALCULATION routines (commands X and Y) are
0018                         ; rarely used as all cross-assemblers perform these calculations
0019                         ; automatically.
0020                         ;
0021                         ; One other minor change is that the terminal along with any devices sending
0022                         ; S19 format files should be configured for 8 Data Bits, No Parity, 2 Stop
0023                         ; Bits.
0024                         ;
0025                         ; ----------------------------------------------------------------------------
0026                         ; Updated by GlassTTY, Jan. 2026, using code from Motorola's Mikbug.
0027                         ; Thanks to Chris Carter for inspiration and help.
0028                         ; ----------------------------------------------------------------------------
0029                         
0030 f401                    CTRLA   EQU     $F401   ; ACIA.A Ctrl/Status
0031 f403                    CTRLB   EQU     $F403   ; ACIA.B Ctrl/Status
0032 f400                    DATAA   EQU     $F400   ; ACIA.A Data register
0033 f402                    DATAB   EQU     $F402   ; ACIA.B Data register
0034                         
0035                         ; -----------------------------------------------------
0036                         ; Note:The original 256 bytes of RAM on the CPU board
0037                         ;  appears at $F000 to $F0FE, with Switches/LEDs at $F0FF
0038                         ;  when a MON1 board is installed
0039                         ; -----------------------------------------------------
0040 f0dd                    JNMI    EQU     $F0DD   ; 3 bytes for jump to NMI sub.
0041 f0e0                    JIRQ    EQU     $F0E0   ; 3 bytes for jump to IRQ sub.
0042 f0d0                    STACK   EQU     $F0D0   ; stack goes down from $F0D0
0043                         
0044                         ; -----------------------------------------------------
0045 f0d1                            ORG     $F0D1
0046                         ; -----------------------------------------------------
0047                         
0048                         ; $F0D1 to $F0DC is unused RAM in original  MINIMON
0049 f0d1                    d_TW    RMB     2       ; New additions to support SRec
0050 f0d3                    b_Csum  RMB     1       ;            "
0051 f0d4                    b_Count RMB     1       ;            "
0052 f0d5                    b_Temp  RMB     1       ;            "
0053                         
0054                         ; -----------------------------------------------------
0055 f0e3                            ORG     $F0E3   ; Start of RAM variables
0056                         ; -----------------------------------------------------
0057                         
0058 f0e3                    T_SAVE  RMB     2       ; Temp storage for NEWLINE
0059 f0e5                    T_P     RMB     1       ;   "     "     "  Z,X
0060 f0e6                    T_X     RMB     2       ;   "     "     "  Sub
0061 f0e8                    T_Y     RMB     2       ;   "     "     "  Sub
0062 f0ea                    T_NEW   RMB     2       ;   "     "     "  Block move
0063 f0ec                    T_M     RMB     1       ;   "     "     "  ZOUT
0064 f0ed                    T_TMPX  RMB     2       ;   "     "     "  PRX
0065 f0ef                    T_STRT  RMB     2       ;   "     "     "  GETADDRESS
0066 f0f1                    T_STOP  RMB     2       ;   "     "     "  GETADDRESS
0067 f0f3                    T_Z     RMB     2       ;   "     "     "   . RDX
0068 f0f5                    T_R     RMB     1       ;   "     "     "     PR
0069 f0f6                    T_Q     RMB     1       ;   "     "     "  ZIN,DUMP 
0070 f0f7                    T_ABYT  RMB     2       ;   "     "     "  SET BR.PT.
0071 f0f9                            RMB     2       ;   "     "     "  SET BR.PT.
0072 f0fb                    T_BYTE  RMB     2       ;   "     "     "  SET BR.PT.
0073 f0fd                    PSTACK  RMB     2       ;   "     "     "     SWI etc
0074                         
0075                         ; -----------------------------------------------------
0076 fc00                            ORG     $FC00   ; Start of ROM based code
0077                         ; -----------------------------------------------------
0078                         
0079                         ; -----------------------------------------------------
0080                         ; Read Character from ACIA
0081                         ; FC00
0082                         ; -----------------------------------------------------
0083 fc00 bd fd 2b           RD_CMD  JSR     RD_A    ; Input one character
0084 fc03 27 fb                      BEQ     RD_CMD  ; Ignore paper tape follower
0085 fc05 8d 08                      BSR     PR_A    ; Echo character
0086 fc07 81 2e                      CMPA    #'.     ; Was it a fullstop ?
0087 fc09 26 11                      BNE     PRA_END ;
0088 fc0b 7e ff 8f                   JMP     START   ; Yes: Go to start of MINIMON
0089 fc0e 01                         NOP
0090                         
0091                         ; -----------------------------------------------------
0092                         ; Print character in A
0093                         ; FC0F
0094                         ; -----------------------------------------------------
0095 fc0f f6 f4 01           PR_A    LDAB    CTRLA   ; Get ACIA(a) status byte
0096 fc12 c5 02                      BITB    #02     ; Is it busy ?
0097 fc14 27 f9                      BEQ     PR_A    ; Yes: Try again
0098 fc16 b7 f4 00                   STAA    DATAA   ;  No: Send data
0099 fc19 7c f0 f5                   INC     T_R     ; Characters printed + One
0100 fc1c 39                 PRA_END RTS             ; RETURN
0101                         
0102                         ; -----------------------------------------------------
0103                         ; Check A contains a HEX character,  Set C.bit on fail
0104                         ; FC1D
0105                         ; -----------------------------------------------------
0106 fc1d 81 2f              VHEX    CMPA    #$2F    ; A < 30 ?
0107 fc1f 2f 0e                      BLE     NotHex  ;  not hex
0108 fc21 81 39                      CMPA    #$39    ; A > 39 ?    
0109 fc23 22 02                      BHI     NotNum  ;  Not a Numeral
0110 fc25 0c                 IsHex   CLC             ; It's OK (clear C bit)
0111 fc26 39                         RTS             ; RETURN
0112 fc27 81 40              NotNum  CMPA    #$40    ; A < 41 ?
0113 fc29 2f 04                      BLE     NotHex  ;  not hex
0114 fc2b 81 46                      CMPA    #$46    ; A <= 46
0115 fc2d 2f f6                      BLE     IsHex   ;  then it is hex
0116 fc2f 0d                 NotHex  SEC             ; Set C bit
0117 fc30 39                         RTS             ; RETURN
0118                         
0119                         ; -----------------------------------------------------
0120                         ; Convert A:B to binary
0121                         ; FC31
0122                         ; -----------------------------------------------------
0123 fc31 85 30              BINARY  BITA    #$30    ; Is it a letter ?
0124 fc33 27 0c                      BEQ     LETTA   ; Yes: Got to handle it
0125 fc35 48                 RIDA    ASLA            ;  No: It is a number, so
0126 fc36 48                         ASLA            ;      shift
0127 fc37 48                         ASLA            ;       left
0128 fc38 48                         ASLA            ;        4 bits
0129 fc39 c5 30                      BITB    #$30    ; Is Acc.B a letter ?
0130 fc3b 27 08                      BEQ     LETTB   ; Yes: Go handle it
0131 fc3d c4 0f              RIDB    ANDB    #$0F    ; Clear 4 high bits in Acc.B
0132 fc3f 1b                         ABA             ; Form binary character (A=A+B)
0133 fc40 39                         RTS             ; RETURN
0134 fc41 8b 09              LETTA   ADDA    #$09    ; Make Acc.A a binary
0135 fc43 20 f0                      BRA     RIDA    ;  as before
0136 fc45 cb 09              LETTB   ADDB    #$09    ; Make Acc.B a binary
0137 fc47 20 f4                      BRA     RIDB    ;  as before
0138                         
0139                         ; -----------------------------------------------------
0140                         ; Read a 4 digit HEX value, put result into X
0141                         ; FC49
0142                         ; -----------------------------------------------------
0143 fc49 8d b5              ZIN     BSR     RD_CMD  ; Read a character
0144 fc4b 8d d0                      BSR     VHEX    ; Is it a hex character ?
0145 fc4d 25 10                      BCS     Z_PRQM  ; No: go to print `?`
0146 fc4f b7 f0 f6                   STAA    T_Q     ; Save it
0147 fc52 8d ac                      BSR     RD_CMD  ; Read 2nd character
0148 fc54 8d c7                      BSR     VHEX    ; Is it a hex character ?
0149 fc56 25 07                      BCS     Z_PRQM  ; No: go to print `?`
0150 fc58 16                         TAB             ; Yes: Put it into B
0151 fc59 b6 f0 f6                   LDAA    T_Q     ; Retrieve 1st hex char to A
0152 fc5c 7e fc d8                   JMP     ZIN2    ; S19 version of ZIN is longer
0153 fc5f bd fd 23           Z_PRQM  JSR     PR_QM   ; Print "?"
0154 fc62 7e fc 49                   JMP     ZIN     ; Go back to start of hex input
0155                         
0156                         ; -----------------------------------------------------
0157                         ; Read 4 hex digits and put value into X
0158                         ; FC65
0159                         ; -----------------------------------------------------
0160 fc65 bd fd 4d           RD_X    JSR     PRSP    ; Print a space
0161 fc68 8d df                      BSR     ZIN     ; Read 2 digit hex value into A
0162 fc6a b7 f0 f3                   STAA    T_Z     ; Save byte (most significant)
0163 fc6d 8d da                      BSR     ZIN     ; Read 2 digit hex value into A
0164 fc6f b7 f0 f4                   STAA    T_Z+1   ; Save byte (least significant)
0165 fc72 fe f0 f3                   LDX     T_Z     ; Load full 4 hex value into X
0166 fc75 39                         RTS             ; RETURN
0167                         
0168                         ; -----------------------------------------------------
0169                         ; Print string FOLLOWING JSR ( terminated by $FF )
0170                         ;  IE: It starts at the `return addr` put onto the stack by JSR
0171                         ;  So actual return address needed is past the string
0172                         ; FC76
0173                         ; -----------------------------------------------------
0174 fc76 30                 STRING  TSX             ; Get loc. of return addr to X
0175 fc77 ee 00                      LDX     0,X     ; Get return addr to X
0176 fc79 09                         DEX             ; Point to byte before
0177 fc7a 08                 AGAIN   INX             ; Point to next byte
0178 fc7b a6 00                      LDAA    0,X     ; Get byte to be printed
0179 fc7d 81 ff                      CMPA    #$FF    ; End-string ?
0180 fc7f 27 04                      BEQ     ENDSTR  ; Yes: Go to finish up
0181 fc81 8d 8c                      BSR     PR_A    ; Print the byte
0182 fc83 20 f5                      BRA     AGAIN   ; Go back for next byte
0183 fc85 31                 ENDSTR  INS             ; Clean up stack...
0184 fc86 31                         INS             ;  ( pop off the return addr )
0185 fc87 6e 01                      JMP     1,X     ; Jump back to caller (RETURN)
0186                         
0187                         ; -----------------------------------------------------
0188                         ; FC89
0189                         ; -----------------------------------------------------
0190 fc89 8d eb              GETADD  BSR     STRING  ; Print string...
0191 fc8b 20 53                      FCC     " S"    ;
0192 fc8d ff                         FCB     $FF     ; End-of-string
0193 fc8e 8d d5                      BSR     RD_X    ; Read 4 digit HEX addr value
0194 fc90 ff f0 ef                   STX     T_STRT  ; Save it
0195 fc93 8d e1                      BSR     STRING  ; Print string...
0196 fc95 20 46                      FCC     " F"    ;
0197 fc97 ff                         FCB     $FF     ; End-of-string
0198 fc98 8d cb                      BSR     RD_X    ; Read 4 digit HEX addr value
0199 fc9a ff f0 f1                   STX     T_STOP  ; Save it
0200 fc9d 39                         RTS             ; RETURN
0201                         
0202                         ; -----------------------------------------------------
0203                         ; Convert value in A to 2 x ASCII hex digits in A and B
0204                         ; FC9E
0205                         ; -----------------------------------------------------
0206 fc9e 16                 ASCII   TAB             ; Copy A to B
0207 fc9f 84 f0                      ANDA    #$F0    ; Clear low order 4 bits of A
0208 fca1 44                         LSRA            ; Shift
0209 fca2 44                         LSRA            ;  right
0210 fca3 44                         LSRA            ;   4
0211 fca4 44                         LSRA            ;    bits
0212 fca5 81 09                      CMPA    #$09    ; Letter or number ?
0213 fca7 22 0b                      BHI     SUBT    ; 
0214 fca9 8b 30                      ADDA    #$30    ; Make it an ASCII number
0215 fcab c4 0f              AND     ANDB    #$0F    ; Clear high order bits of B
0216 fcad c1 09                      CMPB    #$09    ; Letter or number ?
0217 fcaf 22 07                      BHI     ADD     ;
0218 fcb1 cb 30                      ADDB    #$30    ; Make it an ASCII number
0219 fcb3 39                         RTS             ; RETURN
0220 fcb4 8b 37              SUBT    ADDA    #$37    ; Make it an ASCI letter
0221 fcb6 20 f3                      BRA     AND     ; Go to process low order value
0222 fcb8 cb 37              ADD     ADDB    #$37    ; Make it an ASII letter
0223 fcba 39                         RTS             ; RETURN
0224                         
0225                         ; -----------------------------------------------------
0226                         ; Print value in X as 4 hex digits
0227                         ; FCBB
0228                         ; -----------------------------------------------------
0229 fcbb ff f0 ed           PRX     STX     T_TMPX  ; Save X
0230 fcbe b6 f0 ed                   LDAA    T_TMPX  ; Get high order byte to A
0231 fcc1 8d 06                      BSR     ZOUT    ; Print A as 2 hex digits
0232 fcc3 b6 f0 ee                   LDAA    T_TMPX+1; Get low order byte to A
0233 fcc6 20 01                      BRA     ZOUT    ; Print A as 2 hex digits
0234 fcc8 01                         NOP
0235                         
0236                         ; -----------------------------------------------------
0237                         ; Print value in A as 2 hex digits, Preserve B
0238                         ; X unchanged by called routines
0239                         ; This is 1 byte shorter that original ZOUT
0240                         ; FCC9
0241                         ; -----------------------------------------------------
0242 fcc9 37                 ZOUT    PSHB            ; Save B to STACK
0243 fcca 36                         PSHA            ; Save A to STACK
0244 fccb 8d d1                      BSR     ASCII   ; Convert A to ASCII in A & B
0245 fccd 37                         PSHB            ; Save B (2nd byte) to STACK
0246 fcce bd fc 0f                   JSR     PR_A    ; Print byte in A
0247 fcd1 32                         PULA            ; Get 2nd byte into A from STACK
0248 fcd2 bd fc 0f                   JSR     PR_A    ; Print byte in A
0249 fcd5 32                         PULA            ; Recover A from STACK
0250 fcd6 33                         PULB            ; Recover B from STACK
0251 fcd7 39                         RTS             ; RETURN
0252                         
0253                         
0254                         ; second part of S19 version of ZIN
0255 fcd8 bd fc 31           ZIN2    JSR     BINARY  ; Convert A:B to binary to A
0256 fcdb 16                         TAB             ; B=A
0257 fcdc fb f0 d3                   ADDB    b_Csum  ; Add this value
0258 fcdf f7 f0 d3                   STAB    b_Csum  ; to the Checksum (for S19)
0259 fce2 39                         RTS             ; RETURN
0260                         
0261                         ; -----------------------------------------------------
0262                         ; S19 format data load : Modded version of Mikbug code
0263                         ; -----------------------------------------------------
0264 fce3                    LOAD    EQU     *       ; L = Load = Input an S19 file
0265 fce3 8d 91                      BSR     STRING
0266 fce5 0d 0a                      FCB     $0D,$0A ; c/r l/f
0267 fce7 ff                         FCB     $FF     ; End-Of-String
0268 fce8 bd fc 00           .sRead  JSR     RD_CMD  ; Read+Echo, test for '.'
0269 fceb 84 7f                      ANDA    #$7F    ; Mask off parity bit if it exists
0270 fced 81 53                      CMPA    #'S     ; Is it `S` ?
0271 fcef 26 f7                      BNE     .sRead  ; No: Keep waiting for `S`
0272 fcf1 bd fc 00                   JSR     RD_CMD  ; Read+Echo, test for '.'
0273 fcf4 81 39                      CMPA    #'9     ; Is it `9` ?  ( `S9` record )
0274 fcf6 26 03                      BNE     .sRead1
0275 fcf8 7e fe b3                   JMP     STERMR  ; handle termination record
0276 fcfb 81 31              .sRead1 CMPA    #'1     ; Is it `1` ?  ( `S1` record )
0277 fcfd 26 e9                      BNE     .sRead  ; No: Wait for next `S`
0278 fcff 7f f0 d3                   CLR     b_Csum  ; Clear checksum
0279 fd02 bd fc 49                   JSR     ZIN     ; Read 2xHex = data.byte count to A
0280 fd05 80 02                      SUBA    #2      ; Subtract 2 (to get bytes left in line)
0281 fd07 b7 f0 d4                   STAA    b_Count ; Store byte count
0282 fd0a bd fc 65                   JSR     RD_X    ; Read 4xHex digit address to X
0283 fd0d bd fc 49           .sDoByt JSR     ZIN     ; Read 2xHex digits, value to A
0284 fd10 7a f0 d4                   DEC     b_Count ; Decrement our byte count
0285 fd13 27 05                      BEQ     .sChk   ; If end-of-line, go look at checksum
0286 fd15 a7 00                      STAA    0,X     ; Save byte where X points
0287 fd17 08                         INX             ; Point X at next byte
0288 fd18 20 f3                      BRA     .sDoByt ; Go get next byte
0289 fd1a 7c f0 d3           .sChk   INC     b_Csum  ; Add 1 to checksum
0290 fd1d 27 c9                      BEQ     .sRead  ; OK: Go read next record
0291 fd1f 8d 02                      BSR     PR_QM   ; Print "?"
0292 fd21 20 27                      BRA     STARTR  ; Go to START
0293                         
0294 fd23 86 3f              PR_QM   LDAA #'?            ; Put '?' character in A
0295 fd25 7e fc 0f                   JMP     PR_A        ; Print it and return via PR_As RTS
0296                         
0297 fd28 01                         NOP
0298 fd29 01                         NOP
0299 fd2a 01                         NOP
0300                         
0301                         ; -----------------------------------------------------
0302                         ; Read byte from ACIA.A to A
0303                         ; FD2B
0304                         ; -----------------------------------------------------
0305 fd2b b6 f4 01           RD_A    LDAA    CTRLA   ; Get ACIA.A status byte
0306 fd2e 85 01                      BITA    #$01    ; Is byte ready in DATAA
0307 fd30 27 f9                      BEQ     RD_A    ; No: Try again
0308 fd32 b6 f4 00                   LDAA    DATAA   ; Get the data byte to A
0309 fd35 39                         RTS             ; RETURN
0310                         
0311                         ; -----------------------------------------------------
0312                         ; FD36
0313                         ; -----------------------------------------------------
0314 fd36 8d 15              REGPRT  BSR     PRSP    ; Print a space
0315 fd38 fe f0 fd                   LDX     PSTACK  ; Point X at user's stack
0316 fd3b 8d 1c                      BSR     PR2     ; Print CC
0317 fd3d 8d 1a                      BSR     PR2     ; Print B
0318 fd3f 8d 18                      BSR     PR2     ; Print A
0319 fd41 8d 10                      BSR     PR4     ; Print X
0320 fd43 8d 0e                      BSR     PR4     ; Print PC
0321 fd45 ce f0 fd                   LDX     #PSTACK ; Point X at stack pointer
0322 fd48 8d 0a                      BSR     PR4X    ; Print stack pointer
0323 fd4a 20 42              STARTR  BRA     STARTB  ; (RETURN) to MINIMON
0324                         
0325 fd4c 01                         NOP
0326                         
0327                         ; -----------------------------------------------------
0328                         ; FD4D
0329                         ; -----------------------------------------------------
0330 fd4d 86 20              PRSP    LDAA    #$20    ; Put space character in A
0331 fd4f bd fc 0f                   JSR     PR_A    ; Print it
0332 fd52 39                         RTS             ; RETURN
0333 fd53 08                 PR4     INX             ; Point X to next character
0334 fd54 a6 00              PR4X    LDAA    0,X     ; Get byte pointed to by X
0335 fd56 bd fc c9                   JSR     ZOUT    ; Print it
0336 fd59 08                 PR2     INX             ; Point X to next character
0337 fd5a a6 00                      LDAA    0,X     ; Get byte pointed to by X
0338 fd5c bd fc c9                   JSR     ZOUT    ; Print it
0339 fd5f 8d ec                      BSR     PRSP    ; Print a space
0340 fd61 39                         RTS             ; RETURN
0341                         
0342                         ; -----------------------------------------------------
0343                         ; FD62
0344                         ; -----------------------------------------------------
0345 fd62 bd fc 89           BLKMOV  JSR     GETADD  ; Prompt for boundary addresses
0346 fd65 bd fc 76                   JSR     STRING  ; Print string...
0347 fd68 20 54 6f                   FCC     " To"   ;
0348 fd6b ff                         FCB     $FF     ; End-of-string
0349 fd6c bd fc 65                   JSR     RD_X    ; Read 4 hex digit value into X
0350 fd6f ff f0 ea                   STX     T_NEW   ; Store it as NEW start address
0351 fd72 ff f0 e6                   STX     T_X     ;   "    "
0352 fd75 fe f0 ef                   LDX     T_STRT  ; Put start address into X
0353 fd78 ff f0 e8                   STX     T_Y     ; Store it
0354 fd7b 8d 59                      BSR     SUB     ; Perform T_X minus T_Y
0355 fd7d 2a 22                      BPL     DOWN    ; Go to Move downwards
0356 fd7f fe f0 f1                   LDX     T_STOP  ; Get the STOP stop address
0357 fd82 08                         INX             ; Add 1 to it
0358 fd83 ff f0 f1                   STX     T_STOP  ; and save it
0359 fd86 fe f0 ef           DO_UP   LDX     T_STRT  ; Get START address
0360 fd89 bc f0 f1                   CPX     T_STOP  ; Compare it with STOP
0361 fd8c 26 02                      BNE     CONT_A  ; Finished ?
0362 fd8e 20 ba              STARTB  BRA     STARTR  ; Yes: back to MINIMON
0363 fd90 a6 00              CONT_A  LDAA    0,X     ; No: Get data
0364 fd92 08                         INX             ; Point X to next `old` address
0365 fd93 ff f0 ef                   STX     T_STRT  ; and store it
0366 fd96 fe f0 ea                   LDX     T_NEW   ; get address of NEW location
0367 fd99 a7 00                      STAA    0,X     ; Store the data at NEW address
0368 fd9b 08                         INX             ; Point X to next `new` address
0369 fd9c ff f0 ea                   STX     T_NEW   ; and store it
0370 fd9f 20 e5                      BRA     DO_UP   ; loop back for next byte
0371 fda1 fe f0 f1           DOWN    LDX     T_STOP  ; Get end address
0372 fda4 ff f0 e6                   STX     T_X     ; Store it
0373 fda7 8d 2d                      BSR     SUB     ; Perform T_X minus T_Y
0374 fda9 bb f0 eb                   ADDA    T_NEW+1 ; Add NEW (low.byte) to A
0375 fdac fb f0 ea                   ADDB    T_NEW   ; Add NEW (high.byte) to B
0376 fdaf b7 f0 eb                   STAA    T_NEW+1 ; Save NEW (low.byte)
0377 fdb2 f7 f0 ea                   STAB    T_NEW   ;         (high.byte)
0378 fdb5 fe f0 ef                   LDX     T_STRT  ; Get START address
0379 fdb8 09                         DEX             ; Subract 1 from X
0380 fdb9 ff f0 ef                   STX     T_STRT  ; Store it
0381 fdbc fe f0 f1           DO_DOWN LDX     T_STOP  ; Get STOP address
0382 fdbf bc f0 ef                   CPX     T_STRT  ; Compare it with START address
0383 fdc2 27 ca                      BEQ     STARTB  ; Effecively `JMP START`
0384 fdc4 a6 00                      LDAA    0,X     ; Get data
0385 fdc6 09                         DEX             ; Subract 1 from X
0386 fdc7 ff f0 f1                   STX     T_STOP  ; Store it
0387 fdca fe f0 ea                   LDX     T_NEW   ; Load NEW loc address into X
0388 fdcd a7 00                      STAA    0,X     ; Store the data as NEW address
0389 fdcf 09                         DEX             ; Point X to next `new` address
0390 fdd0 ff f0 ea                   STX     T_NEW   ; Store it
0391 fdd3 20 e7                      BRA     DO_DOWN ; Loop back for next byte
0392                         
0393 fdd5 01                         NOP
0394                         
0395                         ; -----------------------------------------------------
0396                         ; FDD6
0397                         ; -----------------------------------------------------
0398 fdd6 ce f0 e6           SUB     LDX     #T_X    ; Point X to start of T_X data
0399 fdd9 a6 01                      LDAA    1,X     ; A = T_X (low)
0400 fddb e6 00                      LDAB    0,X     ; B = T_X (high)
0401 fddd a0 03                      SUBA    3,X     ; A = A - T_Y (low)
0402 fddf e2 02                      SBCB    2,X     ; B = B - T_Y (high)
0403 fde1 39                         RTS             ; RETURN
0404                         
0405                         ; -----------------------------------------------------
0406                         ; S format data output : Modded version of Mikbug code
0407                         ; -----------------------------------------------------
0408 fde2 bd fc 89           PUNCH   JSR     GETADD      ; Prompt for "Start:","Stop:"
0409 fde5 fe f0 ef                   LDX     T_STRT     ; Get start address
0410 fde8 ff f0 d1                   STX     d_TW        ; save it to work area
0411 fdeb b6 f0 f2           .fOut1  LDAA    T_STOP+1    ; get low order of end address
0412 fdee b0 f0 d2                   SUBA    d_TW+1      ; Subtract low order start
0413 fdf1 f6 f0 f1                   LDAB    T_STOP      ; ( carry not affected by LDA )
0414 fdf4 f2 f0 d1                   SBCB    d_TW        ; Subtract with Carry
0415 fdf7 26 04                      BNE     .fOut2
0416 fdf9 81 10                      CMPA    #16
0417 fdfb 25 02                      BCS     .fOut3
0418 fdfd 86 0f              .fOut2  LDAA    #15
0419 fdff 8b 04              .fOut3  ADDA    #4
0420 fe01 b7 f0 d4                   STAA    b_Count     ; FRAME COUNT THIS RECORD
0421 fe04 80 03                      SUBA    #3
0422 fe06 b7 f0 d5                   STAA    b_Temp      ; BYTE COUNT THIS RECORD
0423 fe09 bd fc 76                   JSR     STRING      ; Output this string...
0424 fe0c 0d 0a                      FCB     $0D,$0A       ; c/r l/f
0425 fe0e 53 31                      FCB     'S,'1       ; S1
0426 fe10 ff                         FCB     $FF         ; End-Of-String
0427 fe11 5f                         CLRB                ; Clear checksum
0428                         
0429                         ; Output frame count...
0430 fe12 ce f0 d4                   LDX     #b_Count    ; X = Address of Framecount
0431 fe15 bd fe a8                   JSR     .fOutH2    ; O/P byte <-X and inc X
0432                         
