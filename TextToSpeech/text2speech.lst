                            253 ;--------------------------------------------------------------
                            254 ; Gets the weight data from the scales and rerurns with carry
                            255 ; set if a valid reading, carry clear otherwise. A valid weight
                            256 ; reading resets the idle count. Data received is stored in
                            257 ; T_WEIGHT and MSB in A.
                            258 ;--------------------------------------------------------------
   02BC                     259 GETDATA:
ASxxxx Assembler V05.50.5  (Motorola 6800/6802/6808)                    Page 6
Hexadecimal [16-Bits]                                 Thu May  7 22:05:00 2026



   02BC BD 03 54      [ 9]  260         JSR     RD_XB           ; read 4 hex characters into X
   02BF FF 1A 1D      [ 6]  261         STX     T_WEIGHT        ; store X
   02C2 0C            [ 2]  262         CLC
   02C3 B6 1A 1D      [ 4]  263         LDAA    T_WEIGHT        ; get fist byte (stones)
   02C6 27 04         [ 4]  264         BEQ     GDDONE          ; idle message
   02C8 7F 00 2D      [ 6]  265         CLR     IDLE_TICS       ; not an idle message so reset the idle counter
   02CB 0D            [ 2]  266         SEC                     ; non idle message return with carry set
   02CC 39            [ 5]  267 GDDONE:  RTS
                            268 
                            269 ; -----------------------------------------------------
                            270 ; PR_DEC: Puts 3 decimal digits in DEC, DEC+1 and DEC+2
                            271 ;
                            272 ;       !! ONLY WORKS WITH VALUES BELOW 128 !!
                            273 ; -----------------------------------------------------
   02CD 5F            [ 2]  274 PR_DEC:  CLRB            ; Clear B for hundreds
                            275 
   02CE 81 64         [ 2]  276 HUND:    CMPA    #100    ; 100 or more?
                            277 
   02D0 2D 05         [ 4]  278         BLT     TENS
   02D2 80 64         [ 2]  279         SUBA    #100    ; Sub 100
   02D4 5C            [ 2]  280         INCB            ; Increment hundred counter
   02D5 20 F7         [ 4]  281         BRA     HUND
                            282 
   02D7 F7 1A 17      [ 5]  283 TENS:    STAB    DEC     ; store the hundreds
                            284 
   02DA 5F            [ 2]  285         CLRB
   02DB 81 0A         [ 2]  286 TENS1:   CMPA    #10     ; 10 or more?
   02DD 2D 05         [ 4]  287         BLT     UNITS
   02DF 80 0A         [ 2]  288         SUBA    #10     ; Sub 10
   02E1 5C            [ 2]  289         INCB            ; Increment ten counter
   02E2 20 F7         [ 4]  290         BRA     TENS1
                            291 
   02E4 F7 1A 18      [ 5]  292 UNITS:   STAB    DEC+1
   02E7 B7 1A 19      [ 5]  293         STAA    DEC+2   ; Final remainder is units
                            294 
   02EA 39            [ 5]  295         RTS
                            296 
                            297 
                            298 ; -----------------------------------------------------
                            299 ; Print string FOLLOWING JSR ( terminated by 0xFF ) to
                            300 ; ACIA(b) and ACIA(b)
                            301 ; -----------------------------------------------------
   02EB 30            [ 4]  302 STRINGB: TSX             ; Get loc. of return addr to X
   02EC EE 00         [ 6]  303          LDX     0,X     ; Get return addr to X
   02EE 09            [ 4]  304          DEX             ; Point to byte before
   02EF 08            [ 4]  305 STRB1:   INX             ; Point to next byte
   02F0 A6 00         [ 5]  306          LDAA    0,X     ; Get byte to be printed
   02F2 81 FF         [ 2]  307          CMPA    #0xFF    ; End-string ?
   02F4 27 0E         [ 4]  308          BEQ     ENDSTR  ; Yes: Go to finish up
   02F6 F6 F0 FF      [ 4]  309          LDAB    PANEL
   02F9 C5 01         [ 2]  310          BITB     #1
   02FB 27 03         [ 4]  311          BEQ     STRB    ; panel switch 0 is debug and copies data to A
   02FD BD FC 0F      [ 9]  312          JSR     PR_A    ; Print the byte to ACIA(a) (A is maintained)
                            313                          ;  DEBUG depending on panel data switch zero
   0300 8D 47         [ 8]  314 STRB:    BSR     PR_B    ; Print the byte to ACIA(b)
ASxxxx Assembler V05.50.5  (Motorola 6800/6802/6808)                    Page 7
Hexadecimal [16-Bits]                                 Thu May  7 22:05:00 2026



   0302 20 EB         [ 4]  315          BRA     STRB1   ; Go back for next byte
   0304 31            [ 4]  316 ENDSTR:  INS             ; Clean up stack...
   0305 31            [ 4]  317          INS             ;  ( pop off the return addr )
   0306 6E 01         [ 4]  318          JMP     1,X     ; Jump back to caller (RETURN)
                            319 
                            320 ; -----------------------------------------------------
                            321 ; Prints a string pointed to by X
                            322 ; -----------------------------------------------------
   0308 A6 00         [ 5]  323 STRINGBX:   LDAA    0,X         ; get char
   030A 81 FF         [ 2]  324             CMPA    #0xFF        ; is character NULL?
   030C 27 0F         [ 4]  325             BEQ     DONEB       ; yes, end of string
                            326             ;STAA   PANEL     ; REMOVED, too much activity
   030E F6 F0 FF      [ 4]  327             LDAB    PANEL
   0311 C5 01         [ 2]  328             BITB    #1
   0313 27 03         [ 4]  329             BEQ     STRBX       ; panel switch 0 is debug and copies data to A
   0315 BD FC 0F      [ 9]  330             JSR     PR_A        ; Print the byte to ACIA(a) (A is maintained)
   0318 8D 2F         [ 8]  331 STRBX:      BSR     PR_B        ; Print the byte to ACIA(b)
   031A 08            [ 4]  332             INX
   031B 20 EB         [ 4]  333             BRA     STRINGBX
   031D 39            [ 5]  334 DONEB:      RTS
                            335 
                            336 ; -----------------------------------------------------
                            337 ; Reads a character from ACIA(b) into A
                            338 ; -----------------------------------------------------
   031E 7C 1A 1A      [ 6]  339 RD_B:    INC     RND         ; simple way to get a random number
   0321 B6 F4 03      [ 4]  340         LDAA    CTRLB       ; Get ACIA.A status byte
   0324 85 01         [ 2]  341         BITA    #01         ; Is byte ready in DATAb
   0326 27 F6         [ 4]  342         BEQ     RD_B        ; No: Try again
   0328 B6 F4 02      [ 4]  343         LDAA    DATAB       ; Get the data byte to A
   032B 84 7F         [ 2]  344         ANDA    #0x7F        ; Mask off parity bit if it exists
   032D 39            [ 5]  345         RTS                 ; RETURN
                            346 
                            347 ; -----------------------------------------------------
                            348 ;
                            349 ; -----------------------------------------------------
   032E 8D EE         [ 8]  350 ZINB:    BSR     RD_B    ; Read a character
   0330 BD FC 1D      [ 9]  351         JSR     VHEX    ; Is it a hex character ?
   0333 25 12         [ 4]  352         BCS     Z_PRQM  ; No: go to print `?`
   0335 B7 1A 0A      [ 5]  353         STAA    T_Q     ; Yes: Save Acc.A
   0338 8D E4         [ 8]  354         BSR     RD_B    ; Read 2nd character
   033A BD FC 1D      [ 9]  355         JSR     VHEX    ; Is it a hex character ?
   033D 25 08         [ 4]  356         BCS     Z_PRQM  ; No: go to print `?`
   033F 16            [ 2]  357         TAB             ; Yes: Put it into Acc.B
   0340 B6 1A 0A      [ 4]  358         LDAA    T_Q     ; Retrieve 1st hex char to Acc.A
   0343 BD FC 31      [ 9]  359         JSR     BINARY  ; Convert A:B to binary
   0346 39            [ 5]  360         RTS             ; RETURN
   0347                     361 Z_PRQM:  ;LDAA    #'?     ; Load `?` into A
                            362         ;BSR     PR_B    ; Print it
   0347 20 E5         [ 4]  363         BRA     ZINB    ; Go back to start of hex input
                            364 
                            365 
                            366 ; -----------------------------------------------------
                            367 ; Print character in A to ACIA(b)
                            368 ; -----------------------------------------------------
   0349 F6 F4 03      [ 4]  369 PR_B:    LDAB    CTRLB   ; Get ACIA(a) status byte
ASxxxx Assembler V05.50.5  (Motorola 6800/6802/6808)                    Page 8
Hexadecimal [16-Bits]                                 Thu May  7 22:05:00 2026



   034C C5 02         [ 2]  370         BITB    #02     ; Is it busy ?
   034E 27 F9         [ 4]  371         BEQ     PR_B    ; Yes: Try again
   0350 B7 F4 02      [ 5]  372         STAA    DATAB   ;  No: Send data
   0353 39            [ 5]  373 PRB_END: RTS             ; RETURN
                            374 
                            375 ; -----------------------------------------------------
                            376 ; Read 4 hex digits and put value into X
                            377 ; -----------------------------------------------------
   0354 8D D8         [ 8]  378 RD_XB:   BSR     ZINB    ; Read 2 digit hex value into A
   0356 B7 1A 0B      [ 5]  379         STAA    T_Z     ; Save byte (most significant)
   0359 8D D3         [ 8]  380         BSR     ZINB    ; Read 2 digit hex value into A
   035B B7 1A 0C      [ 5]  381         STAA    T_Z+1   ; Save byte (least significant)
   035E FE 1A 0B      [ 5]  382         LDX     T_Z     ; Load full 4 hex value into X
   0361 39            [ 5]  383         RTS             ; RETURN
                            384 
                            385 ; -----------------------------------------------------
                            386 ; Adds A to X and leaves the result in X, A is
                            387 ; preserved.
                            388 ; -----------------------------------------------------
   0362 36            [ 4]  389 ADX:     PSHA
   0363 FF 1A 15      [ 6]  390         STX     T_TMP
   0366 BB 1A 16      [ 4]  391         ADDA    T_TMP+1   ; add A to low byte
   0369 B7 1A 16      [ 5]  392         STAA    T_TMP+1
   036C B6 1A 15      [ 4]  393         LDAA    T_TMP     ; get high byte
   036F 89 00         [ 2]  394         ADCA    #0      ; add carry only
   0371 B7 1A 15      [ 5]  395         STAA    T_TMP
   0374 FE 1A 15      [ 5]  396         LDX     T_TMP
   0377 32            [ 4]  397         PULA
   0378 39            [ 5]  398         RTS
                            399 
                            400 ; -----------------------------------------------------
                            401 ; Loads X with A, A is preserved.
                            402 ; -----------------------------------------------------
   0379 B7 1A 16      [ 5]  403 TAX:    STAA    T_TMP+1       ; store A as low byte of X
   037C 7F 1A 15      [ 6]  404         CLR     T_TMP         ; zero the high byte
   037F FE 1A 15      [ 5]  405         LDX     T_TMP         ; load X
   0382 39            [ 5]  406         RTS
                            407 
                            408 ; -----------------------------------------------------
                            409 ; Prints the message " n stones n pounds"
                            410 ; place stones in MSB of X and pound in LSB
                            411 ; -----------------------------------------------------
   0383                     412 PR_WEIGHT:
                            413 
   0383 FF 1A 13      [ 6]  414         STX     T_W
   0386 B6 1A 13      [ 4]  415         LDAA    T_W
   0389 BD 03 79      [ 9]  416         JSR     TAX
   038C BD 03 F8      [ 9]  417         JSR     PR_WORD         ; n
   038F BD 03 B1      [ 9]  418         JSR     PR_SPCB
   0392 CE 01 2B      [ 3]  419         LDX     #STONES
   0395 BD 03 F8      [ 9]  420         JSR     PR_WORD         ; "stones"
   0398 BD 03 B1      [ 9]  421         JSR     PR_SPCB
   039B B6 1A 14      [ 4]  422         LDAA    T_W+1            ; Load high byte of X into Accumulator A
   039E BD 03 79      [ 9]  423         JSR     TAX
   03A1 BD 03 F8      [ 9]  424         JSR     PR_WORD         ; n
ASxxxx Assembler V05.50.5  (Motorola 6800/6802/6808)                    Page 9
Hexadecimal [16-Bits]                                 Thu May  7 22:05:00 2026



   03A4 CE 00 F5      [ 3]  425         LDX     #POUNDS
   03A7 BD 03 B1      [ 9]  426         JSR     PR_SPCB
   03AA BD 03 F8      [ 9]  427         JSR     PR_WORD         ; "pounds"
   03AD BD 03 BC      [ 9]  428         JSR     PR_CRB
   03B0 39            [ 5]  429         RTS
                            430 
                            431 ; -----------------------------------------------------
                            432 ; Prints a space on both consoles (preserves A)
                            433 ; -----------------------------------------------------
   03B1 36            [ 4]  434 PR_SPCB: PSHA
   03B2 86 20         [ 2]  435         LDAA    #0x20        ; Put space character in A
   03B4 BD FC 0F      [ 9]  436         JSR     PR_A
   03B7 BD 03 49      [ 9]  437         JSR     PR_B        ; Print it
   03BA 32            [ 4]  438         PULA
   03BB 39            [ 5]  439         RTS                 ; RETURN
                            440 
                            441 ; -----------------------------------------------------
                            442 ; Prints a CRLF on both consoles (preserves A)
                            443 ; -----------------------------------------------------
   03BC 36            [ 4]  444 PR_CRB:     PSHA
   03BD 86 0D         [ 2]  445             LDAA    #0x0D        ; Put CHAR character in A
   03BF BD FC 0F      [ 9]  446             JSR     PR_A
   03C2 BD 03 49      [ 9]  447             JSR     PR_B        ; Print it
   03C5 86 0A         [ 2]  448             LDAA    #0x0A
   03C7 F6 F0 FF      [ 4]  449             LDAB     PANEL
   03CA C5 01         [ 2]  450             BITB    #1
   03CC 27 03         [ 4]  451             BEQ     PR_CRB1
   03CE BD FC 0F      [ 9]  452             JSR     PR_A
   03D1 BD 03 49      [ 9]  453 PR_CRB1:    JSR     PR_B        ; Print it
   03D4 32            [ 4]  454             PULA
   03D5 39            [ 5]  455             RTS                 ; RETURN
                            456 
                            457 ; -----------------------------------------------------
                            458 ; Outputs a phrase from the memory location in X
                            459 ; -----------------------------------------------------
   03D6                     460 PR_PHRASE:
                            461 
   03D6 A6 00         [ 5]  462 PR_PH1:  LDAA    0,X         ; get high byte of word
   03D8 E6 01         [ 5]  463         LDAB    1,X         ; get low byte
   03DA 81 FF         [ 2]  464         CMPA    #0xFF        ; check high byte
   03DC 27 19         [ 4]  465         BEQ     PR_PH2      ; high byte is 0xFF so we're done
   03DE FF 1A 0F      [ 6]  466 PR_PH3:  STX     T_Y         ; save table pointer
   03E1 B7 1A 11      [ 5]  467         STAA    T_P
   03E4 F7 1A 12      [ 5]  468         STAB    T_P+1
   03E7 FE 1A 11      [ 5]  469         LDX     T_P         ; X now points to the word
   03EA BD 03 F8      [ 9]  470         JSR     PR_WORD
   03ED BD 03 B1      [ 9]  471         JSR     PR_SPCB
   03F0 FE 1A 0F      [ 5]  472         LDX     T_Y         ; restore table pointer
   03F3 08            [ 4]  473         INX                 ; move to next entry
   03F4 08            [ 4]  474         INX                 ; (2 bytes per entry)
   03F5 20 DF         [ 4]  475         BRA     PR_PH1
   03F7 39            [ 5]  476 PR_PH2:  RTS
                            477 
                            478 ; -----------------------------------------------------
                            479 ; Outputs a word based on value in X
ASxxxx Assembler V05.50.5  (Motorola 6800/6802/6808)                   Page 10
Hexadecimal [16-Bits]                                 Thu May  7 22:05:00 2026



                            480 ; -----------------------------------------------------
   03F8                     481 PR_WORD:
   03F8 FF 1A 0D      [ 6]  482             STX     T_X             ; use ASL and ROL to multiply by 2 (pointer is 2 bytes wide)
   03FB 78 1A 0E      [ 6]  483             ASL     T_X+1           ; shift low byte left, bit 7 goes to carry
   03FE 79 1A 0D      [ 6]  484             ROL     T_X             ; rotate high byte left, carry in from low byte
   0401 FE 1A 0D      [ 5]  485             LDX     T_X
   0404 FF 1A 0D      [ 6]  486             STX     T_X             ; Stash X
   0407 B6 1A 0D      [ 4]  487             LDAA    T_X             ; High byte of X
   040A F6 1A 0E      [ 4]  488             LDAB    T_X+1           ; Low byte of X
   040D CB 2E         [ 2]  489             ADDB    #<WORDPTR    ; Add low byte of WORDPTR address
   040F 89 04         [ 2]  490             ADCA    #>WORDPTR    ; Add high byte of WORDPTR address + carry
   0411 B7 1A 0D      [ 5]  491             STAA    T_X             ; T_X has the address of the pointer NOT the word
   0414 F7 1A 0E      [ 5]  492             STAB    T_X+1
   0417 FE 1A 0D      [ 5]  493             LDX     T_X             ; X has the address of the pointer NOT the word
                            494 
   041A A6 00         [ 5]  495             LDAA    0,X             ; get the hi byte of the word
   041C B7 1A 0D      [ 5]  496             STAA    T_X
   041F A6 01         [ 5]  497             LDAA    1,X             ; get the low byte of the word
   0421 B7 1A 0E      [ 5]  498             STAA    T_X+1
   0424 FE 1A 0D      [ 5]  499             LDX     T_X             ; X now has address of the word
   0427 BD 03 08      [ 9]  500             JSR     STRINGBX        ; output the word
   042A 7C 1A 27      [ 6]  501             INC     SYLLABLES
   042D 39            [ 5]  502             RTS
                            503 
