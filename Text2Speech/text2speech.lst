                            258 ;--------------------------------------------------------------
                            259 ; Gets the weight data from the scales and rerurns with carry
ASxxxx Assembler V05.50.5  (Motorola 6800/6802/6808)                    Page 6
Hexadecimal [16-Bits]                                 Tue May 12 16:51:49 2026



                            260 ; set if a valid reading, carry clear otherwise. A valid weight
                            261 ; reading resets the idle count. Data received is stored in
                            262 ; T_WEIGHT and MSB in A.
                            263 ;--------------------------------------------------------------
   02F1                     264 GETDATA:
   02F1 BD 03 7E      [ 9]  265         JSR     RD_XB           ; read 4 hex characters into X
   02F4 FF 1B 50      [ 6]  266         STX     T_WEIGHT        ; store X
   02F7 BD FC 76      [ 9]  267         JSR     STRING
   02FA 44 52 3A 20         268         .fcc    "DR: "
   02FE FF                  269         .fcb    0xff
   02FF FE 1B 50      [ 5]  270         LDX     T_WEIGHT
   0302 BD FC BB      [ 9]  271         JSR     PRX             ; print the data
   0305 BD 04 00      [ 9]  272         JSR    PR_CR
   0308 0C            [ 2]  273         CLC
   0309 B6 1B 50      [ 4]  274         LDAA    T_WEIGHT        ; get fist byte (stones)
   030C 27 04         [ 4]  275         BEQ     GDDONE          ; idle message
   030E 7F 00 2D      [ 6]  276         CLR     IDLE_TICS       ; not an idle message so reset the idle counter
   0311 0D            [ 2]  277         SEC                     ; non idle message return with carry set
   0312 39            [ 5]  278 GDDONE:  RTS
                            279 
                            280 ; -----------------------------------------------------
                            281 ; Print string FOLLOWING JSR ( terminated by 0xFF ) to
                            282 ; ACIA(b) and ACIA(b)
                            283 ; -----------------------------------------------------
   0313 30            [ 4]  284 STRINGB: TSX             ; Get loc. of return addr to X
   0314 EE 00         [ 6]  285          LDX     0,X     ; Get return addr to X
   0316 09            [ 4]  286          DEX             ; Point to byte before
   0317 08            [ 4]  287 STRB1:   INX             ; Point to next byte
   0318 A6 00         [ 5]  288          LDAA    0,X     ; Get byte to be printed
   031A 81 FF         [ 2]  289          CMPA    #0xFF    ; End-string ?
   031C 27 0E         [ 4]  290          BEQ     ENDSTR  ; Yes: Go to finish up
   031E F6 F0 FF      [ 4]  291          LDAB    PANEL
   0321 C5 01         [ 2]  292          BITB     #1
   0323 27 03         [ 4]  293          BEQ     STRB    ; panel switch 0 is debug and copies data to A
   0325 BD FC 0F      [ 9]  294          JSR     PR_A    ; Print the byte to ACIA(a) (A is maintained)
                            295                          ;  DEBUG depending on panel data switch zero
   0328 8D 46         [ 8]  296 STRB:    BSR     PR_B    ; Print the byte to ACIA(b)
   032A 20 EB         [ 4]  297          BRA     STRB1   ; Go back for next byte
   032C 31            [ 4]  298 ENDSTR:  INS             ; Clean up stack...
   032D 31            [ 4]  299          INS             ;  ( pop off the return addr )
   032E 6E 01         [ 4]  300          JMP     1,X     ; Jump back to caller (RETURN)
                            301 
                            302 ; -----------------------------------------------------
                            303 ; Prints a string pointed to by X
                            304 ; -----------------------------------------------------
   0330 A6 00         [ 5]  305 STRINGBX:   LDAA    0,X         ; get char
   0332 81 FF         [ 2]  306             CMPA    #0xFF        ; is character NULL?
   0334 27 0F         [ 4]  307             BEQ     DONEB       ; yes, end of string
   0336 F6 F0 FF      [ 4]  308             LDAB    PANEL
   0339 C5 01         [ 2]  309             BITB    #1
   033B 27 03         [ 4]  310             BEQ     STRBX       ; panel switch 0 is debug and copies data to A
   033D BD FC 0F      [ 9]  311             JSR     PR_A        ; Print the byte to ACIA(a) (A is maintained)
   0340 8D 2E         [ 8]  312 STRBX:      BSR     PR_B        ; Print the byte to ACIA(b)
   0342 08            [ 4]  313             INX
   0343 20 EB         [ 4]  314             BRA     STRINGBX
