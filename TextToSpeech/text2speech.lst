                            291 ; -----------------------------------------------------
                            292 ; Reads a character from ACIA(b) into A
                            293 ; -----------------------------------------------------
   02A0 7C 19 4E      [ 6]  294 RD_B:    INC     RND         ; simple way to get a random number
   02A3 B6 F4 03      [ 4]  295         LDAA    CTRLB       ; Get ACIA.A status byte
   02A6 85 01         [ 2]  296         BITA    #01         ; Is byte ready in DATAb
   02A8 27 F6         [ 4]  297         BEQ     RD_B        ; No: Try again
   02AA B6 F4 02      [ 4]  298         LDAA    DATAB       ; Get the data byte to A
   02AD 84 7F         [ 2]  299         ANDA    #0x7F        ; Mask off parity bit if it exists
   02AF 39            [ 5]  300         RTS                 ; RETURN
                            301 
                            302 ; -----------------------------------------------------
                            303 ;
                            304 ; -----------------------------------------------------
   02B0 8D EE         [ 8]  305 ZINB:    BSR     RD_B    ; Read a character
   02B2 BD FC 1D      [ 9]  306         JSR     VHEX    ; Is it a hex character ?
   02B5 25 12         [ 4]  307         BCS     Z_PRQM  ; No: go to print `?`
   02B7 B7 19 3E      [ 5]  308         STAA    T_Q     ; Yes: Save Acc.A
   02BA 8D E4         [ 8]  309         BSR     RD_B    ; Read 2nd character
   02BC BD FC 1D      [ 9]  310         JSR     VHEX    ; Is it a hex character ?
   02BF 25 08         [ 4]  311         BCS     Z_PRQM  ; No: go to print `?`
   02C1 16            [ 2]  312         TAB             ; Yes: Put it into Acc.B
   02C2 B6 19 3E      [ 4]  313         LDAA    T_Q     ; Retrieve 1st hex char to Acc.A
   02C5 BD FC 31      [ 9]  314         JSR     BINARY  ; Convert A:B to binary
   02C8 39            [ 5]  315         RTS             ; RETURN
   02C9                     316 Z_PRQM:  ;LDAA    #'?     ; Load `?` into A
                            317         ;BSR     PR_B    ; Print it
   02C9 20 E5         [ 4]  318         BRA     ZINB    ; Go back to start of hex input
                            319 
                            320 ; -----------------------------------------------------
                            321 ; Print character in A to ACIA(b)
ASxxxx Assembler V05.50.5  (Motorola 6800/6802/6808)                    Page 7
Hexadecimal [16-Bits]                                 Fri May  1 13:46:24 2026



                            322 ; -----------------------------------------------------
   02CB F6 F4 03      [ 4]  323 PR_B:    LDAB    CTRLB   ; Get ACIA(a) status byte
   02CE C5 02         [ 2]  324         BITB    #02     ; Is it busy ?
   02D0 27 F9         [ 4]  325         BEQ     PR_B    ; Yes: Try again
   02D2 B7 F4 02      [ 5]  326         STAA    DATAB   ;  No: Send data
   02D5 39            [ 5]  327 PRB_END: RTS             ; RETURN
                            328 
                            329 ; -----------------------------------------------------
                            330 ; Read 4 hex digits and put value into X
                            331 ; -----------------------------------------------------
   02D6 8D D8         [ 8]  332 RD_XB:   BSR     ZINB    ; Read 2 digit hex value into A
   02D8 B7 19 3F      [ 5]  333         STAA    T_Z     ; Save byte (most significant)
   02DB 8D D3         [ 8]  334         BSR     ZINB    ; Read 2 digit hex value into A
   02DD B7 19 40      [ 5]  335         STAA    T_Z+1   ; Save byte (least significant)
   02E0 FE 19 3F      [ 5]  336         LDX     T_Z     ; Load full 4 hex value into X
   02E3 39            [ 5]  337         RTS             ; RETURN
                            338 ; -----------------------------------------------------
                            339 ; Adds A to X and leaves the result in X, A is
                            340 ; preserved.
                            341 ; -----------------------------------------------------
   02E4 36            [ 4]  342 ADX:     PSHA
   02E5 FF 19 49      [ 6]  343         STX     T_TMP
   02E8 BB 19 4A      [ 4]  344         ADDA    T_TMP+1   ; add A to low byte
   02EB B7 19 4A      [ 5]  345         STAA    T_TMP+1
   02EE B6 19 49      [ 4]  346         LDAA    T_TMP     ; get high byte
   02F1 89 00         [ 2]  347         ADCA    #0      ; add carry only
   02F3 B7 19 49      [ 5]  348         STAA    T_TMP
   02F6 FE 19 49      [ 5]  349         LDX     T_TMP
   02F9 32            [ 4]  350         PULA
   02FA 39            [ 5]  351         RTS
