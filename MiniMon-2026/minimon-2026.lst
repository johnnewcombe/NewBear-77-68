output:  minimon-2026.s19
0001                         ; ------------------------------------------------------
0002                         ; Minimon
0003                         ; ------------------------------------------------------
0004                         ;  Original author ACH, Dec.1978;
0005                         ; ------------------------------------------------------
0006                         ; 13 NOV 2025 : [JN] added NOP at FFF7 to remove gap to
0007                         ;             : allow easier conversion to bin from s19
0008                         ; 05 DEC 2025 : [JN] Changed ACIA(a) to be 8N2 to match
0009                         ;             : PROM. So that MiniMon can be loaded and
0010                         ;             : run from the same terminal config.
0011                         ; ------------------------------------------------------
0012                         ; 2 x ACIAs :-
0013                         ;
0014                         
0015 f401                    CTRLA   EQU     $F401   ; ACIA.A Ctrl/Status
0016 f403                    CTRLB   EQU     $F403   ; ACIA.B Ctrl/Status
0017 f400                    DATAA   EQU     $F400   ; ACIA.A Data register
0018 f402                    DATAB   EQU     $F402   ; ACIA.B Data register
0019                         
0020                         ; Note:The original 256 bytes of RAM on the CPU board 
0021                         ;  appears at $F000 to $F0FE, with Switches/LEDs at $F0FF
0022                         ;  when a MON1 board is installed
0023                         
0024                         ; Stack goes down from $F0D0
0025 f0d0                    STACK   EQU     $F0D0   ; Top of MINIMON's stack
0026                         
0027                         
0028                         
0029                         ; RAM at $F0D1 to $F0DC appears to be unused
0030                         
0031                         ; 3 bytes reserved for each if NMI and IRQ handling
0032                         ; so an application can write JMP <addr> into those
0033                         ; places if those interrupts are wanted...
0034                         
0035 f0dd                    JNMI    EQU     $F0DD   ; Space for jump to NMI sub.
0036 f0e0                    JIRQ    EQU     $F0E0   ; Space for jump to IRQ sub.
0037                         
0038                         ; -----------------------------------------------------
0039 f0de                            ORG     $F0DE   ; Start of RAM variables
0040                         ; -----------------------------------------------------
0041                         ; Note: Temp storage variables renamed to get T_ prefix
0042                         ;       as some were sharing names with labels or registers
0043                         ;
0044                         ; New additions to support S19 additions
0045                         ;d_RdFstX    RMB     2       ;  "  RD_ByteFast X
0046                         ;d_Hx4X      RMB     2       ;  "  RDX4 PRX4
0047 f0de                    d_TW        RMB     2       ;  "  S19
0048                         ;d_STOP      RMB     2       ;  "  ASK_Addrs `Stop:`
0049 f0e0                    b_Csum      RMB     1       ;  "  S19
0050 f0e1                    b_Count     RMB     1       ;  "  S19
0051 f0e2                    b_Temp      RMB     1       ;  "  S19
0052                         ;d_START     RMB     2       ;  "  ASK_Start `Start:`
0053                         ;b_Q         RMB     1       ;  "  ZIN,DUMP
0054                         
0055 f0e3                    T_SAVE  RMB     2       ; Temp storage for NEWLINE
0056 f0e5                    T_P     RMB     1       ;   "     "     "  Z,X
0057 f0e6                    T_X     RMB     2       ;   "     "     "  Sub
0058 f0e8                    T_Y     RMB     2       ;   "     "     "  Sub
0059 f0ea                    T_NEW   RMB     2       ;   "     "     "  Block move
0060 f0ec                    T_M     RMB     1       ;   "     "     "  ZOUT
0061 f0ed                    T_TMPX  RMB     2       ;   "     "     "  PRX
0062 f0ef                    T_STRT  RMB     2       ;   "     "     "  GETADDRESS
0063 f0f1                    T_STOP  RMB     2       ;   "     "     "  GETADDRESS
0064 f0f3                    T_Z     RMB     2       ;   "     "     "   . RDX
0065 f0f5                    T_R     RMB     1       ;   "     "     "     PR
0066 f0f6                    T_Q     RMB     1       ;   "     "     "  ZIN,DUMP 
0067 f0f7                    T_ABYT  RMB     2       ;   "     "     "  SET BR.PT.
0068 f0f9                            RMB     2       ;   "     "     "  SET BR.PT.
0069 f0fb                    T_BYTE  RMB     2       ;   "     "     "  SET BR.PT.
0070 f0fd                    PSTACK  RMB     2       ;   "     "     "     SWI etc
0071                         
0072                         
0073                         
0074                         ;
0075                         ; -----------------------------------------------------
0076 fc00                            ORG     $FC00   ; Start of ROM based code
0077                         ; -----------------------------------------------------
0078                         ;FC00
0079 fc00 bd fd 2b           RD_CMD  JSR     RD_A    ; Input one character 
0080 fc03 27 fb                      BEQ     RD_CMD  ; Ignore paper tape follower
0081 fc05 8d 08                      BSR     PR_A    ; Echo character
0082 fc07 81 2e                      CMPA    #'.     ; Was it a fullstop ?
0083 fc09 26 03                      BNE     END_RD  ;
0084 fc0b 7e ff 8f                   JMP     START   ; Yes: Go to start of MINIMON
0085 fc0e 39                 END_RD  RTS             ;  No: RETURN
0086                         
0087                         ; -----------------------------------------------------
0088                         ; Print character in A
0089                         ;FC0F
0090 fc0f f6 f4 01           PR_A    LDAB    CTRLA   ; Get ACIA(a) status byte
0091 fc12 c5 02                      BITB    #02     ; Is it busy ?
0092 fc14 27 f9                      BEQ     PR_A    ; Yes: Try again
0093 fc16 b7 f4 00                   STAA    DATAA   ;  No: Send data
0094 fc19 7c f0 f5                   INC     T_R     ; Characters printed + One
0095 fc1c 39                         RTS             ; RETURN
0096                         
0097                         ; -----------------------------------------------------
0098                         ; Check A contains a HEX character,  Set C.bit on fail
0099                         ;FC1D
0100 fc1d 81 2f              VHEX    CMPA    #$2F    ; A < 30 ?
0101 fc1f 2f 0e                      BLE     NotHex  ;  not hex
0102 fc21 81 39                      CMPA    #$39    ; A > 39 ?    
0103 fc23 22 02                      BHI     NotNum  ;  Not a Numeral
0104 fc25 0c                 IsHex   CLC             ; It's OK (clear C bit)
0105 fc26 39                         RTS             ; RETURN
0106 fc27 81 40              NotNum  CMPA    #$40    ; A < 41 ?
0107 fc29 2f 04                      BLE     NotHex  ;  not hex
0108 fc2b 81 46                      CMPA    #$46    ; A <= 46
0109 fc2d 2f f6                      BLE     IsHex   ;  then it is hex
0110 fc2f 0d                 NotHex  SEC             ; Set C bit
0111 fc30 39                         RTS             ; RETURN
0112                         
0113                         ; -----------------------------------------------------
0114                         ;FC31
0115 fc31 85 30              BINARY  BITA    #$30    ; Is it a letter ?
0116 fc33 27 0c                      BEQ     LETTA   ; Yes: Got to handle it
0117 fc35 48                 RIDA    ASLA            ;  No: It is a number, so
0118 fc36 48                         ASLA            ;      shift
0119 fc37 48                         ASLA            ;       left
0120 fc38 48                         ASLA            ;        4 bits
0121 fc39 c5 30                      BITB    #$30    ; Is Acc.B a letter ?
0122 fc3b 27 08                      BEQ     LETTB   ; Yes: Go handle it
0123 fc3d c4 0f              RIDB    ANDB    #$0F    ; Clear 4 high bits in Acc.B
0124 fc3f 1b                         ABA             ; Form binary character (A=A+B)
0125 fc40 39                         RTS             ; RETURN
0126 fc41 8b 09              LETTA   ADDA    #$09    ; Make Acc.A a binary
0127 fc43 20 f0                      BRA     RIDA    ;  as before
0128 fc45 cb 09              LETTB   ADDB    #$09    ; Make Acc.B a binary
0129 fc47 20 f4                      BRA     RIDB    ;  as before
0130                         
0131                         ; -----------------------------------------------------
0132                         ; Read a 4 digit HEX value, put result into X
0133                         ;FC49
0134 fc49 8d b5              ZIN         BSR     RD_CMD      ; Read a character
0135 fc4b 8d d0                          BSR     VHEX        ; Is it a hex character ?
0136 fc4d 25 10                          BCS     Z_PRQM      ; No: go to print `?`
0137 fc4f b7 f0 f6                       STAA    T_Q         ; Save it
0138 fc52 8d ac                          BSR     RD_CMD      ; Read 2nd character
0139 fc54 8d c7                          BSR     VHEX        ; Is it a hex character ?
0140 fc56 25 07                          BCS     Z_PRQM      ; No: go to print `?`
0141 fc58 16                             TAB                 ; Yes: Put it into B
0142 fc59 b6 f0 f6                       LDAA    T_Q         ; Retrieve 1st hex char to A
0143 fc5c 7e fc db                       JMP     ZIN2        ; S19 version of ZIN is longer
0144 fc5f bd fd 26           Z_PRQM      JSR     PR_QM       ; Print "?"
0145 fc62 7e fc 49                       JMP     ZIN      ; Go back to start of hex input
0146                         
0147                         ; -----------------------------------------------------
0148                         ; Read 4 hex digits and put value into X
0149                         ;FC65
0150 fc65 bd fd 4d           RD_X    JSR     PRSP    ; Print a space
0151 fc68 8d df                      BSR     ZIN     ; Read 2 digit hex value into A
0152 fc6a b7 f0 f3                   STAA    T_Z     ; Save byte (most significant)
0153 fc6d 8d da                      BSR     ZIN     ; Read 2 digit hex value into A
0154 fc6f b7 f0 f4                   STAA    T_Z+1   ; Save byte (least significant)
0155 fc72 fe f0 f3                   LDX     T_Z     ; Load full 4 hex value into X
0156 fc75 39                         RTS             ; RETURN
0157                         
0158                         ; -----------------------------------------------------
0159                         ; Print string FOLLOWING JSR ( terminated by $FF )
0160                         ;  IE: It starts at the `return addr` put onto the stack by JSR
0161                         ;  So actual return address needed is past the string
0162                         
0163                         ;fc76
0164 fc76 30                 STRING  TSX             ; Get loc. of return addr to X
0165 fc77 ee 00                      LDX     0,X     ; Get return addr to X
0166 fc79 09                         DEX             ; Point to byte before
0167 fc7a 08                 AGAIN   INX             ; Point to next byte
0168 fc7b a6 00                      LDAA    0,X     ; Get byte to be printed
0169 fc7d 81 ff                      CMPA    #$FF    ; End-string ?
0170 fc7f 27 04                      BEQ     ENDSTR  ; Yes: Go to finish up
0171 fc81 8d 8c                      BSR     PR_A    ; Print the byte
0172 fc83 20 f5                      BRA     AGAIN   ; Go back for next byte
0173 fc85 31                 ENDSTR  INS             ; Clean up stack...
0174 fc86 31                         INS             ;  ( pop off the return addr )
0175 fc87 6e 01                      JMP     1,X     ; Jump back to caller (RETURN)
0176                         
0177                         ; -----------------------------------------------------
0178                         ; FC89
0179 fc89 8d eb              GETADD  BSR     STRING  ; Print string...
0180 fc8b 20 53                      FCC     " S"    ;
0181 fc8d ff                         FCB     $FF     ; End-of-string
0182 fc8e 8d d5                      BSR     RD_X    ; Read 4 digit HEX addr value
0183 fc90 ff f0 ef                   STX     T_STRT  ; Save it
0184 fc93 8d e1                      BSR     STRING  ; Print string...
0185 fc95 20 46                      FCC     " F"    ;
0186 fc97 ff                         FCB     $FF     ; End-of-string
0187 fc98 8d cb                      BSR     RD_X    ; Read 4 digit HEX addr value
0188 fc9a ff f0 f1                   STX     T_STOP  ; Save it
0189 fc9d 39                         RTS             ; RETURN
0190                         
0191                         ; -----------------------------------------------------
0192                         ; Convert value in A to 2 x ASCII hex digits in A and B
0193                         ;FC9E
0194 fc9e 16                 ASCII   TAB             ; Copy A to B
0195 fc9f 84 f0                      ANDA    #$F0    ; Clear low order 4 bits of A
0196 fca1 44                         LSRA            ; Shift
0197 fca2 44                         LSRA            ;  right
0198 fca3 44                         LSRA            ;   4
0199 fca4 44                         LSRA            ;    bits
0200 fca5 81 09                      CMPA    #$09    ; Letter or number ?
0201 fca7 22 0b                      BHI     SUBT    ; 
0202 fca9 8b 30                      ADDA    #$30    ; Make it an ASCII number
0203 fcab c4 0f              AND     ANDB    #$0F    ; Clear high order bits of B
0204 fcad c1 09                      CMPB    #$09    ; Letter or number ?
0205 fcaf 22 07                      BHI     ADD     ;
0206 fcb1 cb 30                      ADDB    #$30    ; Make it an ASCII number
0207 fcb3 39                         RTS             ; RETURN
0208 fcb4 8b 37              SUBT    ADDA    #$37    ; Make it an ASCI letter
0209 fcb6 20 f3                      BRA     AND     ; Go to process low order value
0210 fcb8 cb 37              ADD     ADDB    #$37    ; Make it an ASII letter
0211 fcba 39                         RTS             ; RETURN
0212                         
0213                         ; -----------------------------------------------------
0214                         ; Print value in X as 4 hex digits
0215                         ;FCBB
0216 fcbb ff f0 ed           PRX     STX     T_TMPX  ; Save X
0217 fcbe b6 f0 ed                   LDAA    T_TMPX  ; Get high order byte to A
0218 fcc1 8d 06                      BSR     ZOUT    ; Print A as 2 hex digits
0219 fcc3 b6 f0 ee                   LDAA    T_TMPX+1 ; Get low order byte to A
0220 fcc6 8d 01                      BSR     ZOUT    ; Print A as 2 hex digits
0221 fcc8 39                         RTS             ; RETURN
0222                         
0223                         ; -----------------------------------------------------
0224                         ; Print value in A as 2 hex digits
0225                         ;FCC9
0226 fcc9 8d d3              ZOUT    BSR     ASCII   ; Convert A to ASCII in A & B
0227 fccb f7 f0 ec                   STAB    T_M     ; Save B
0228 fcce bd fc 0f                   JSR     PR_A    ; Print byte in A
0229 fcd1 b6 f0 ec                   LDAA    T_M     ; Get 2nd byte into A
0230 fcd4 bd fc 0f                   JSR     PR_A    ; Print byte in A
0231 fcd7 39                         RTS             ; RETURN
0232                         
0233                         ; -----------------------------------------------------
0234                         ;RD_HEX2 This is a new ZIN and is called RD_HEX2 on GruntMon
0235                         ;FCD8
0236 fcd8                    PUNCH       EQU *
0237 fcd8 7e fd e2                       JMP CMD_P
0238                         
0239                         ; second part of S19 version of ZIN
0240                         
0241 fcdb bd fc 31           ZIN2        JSR     BINARY      ; Convert A:B to binary to A
0242 fcde 16                             TAB                 ; B=A
0243 fcdf fb f0 e0                       ADDB    b_Csum      ; Add this value
0244 fce2 f7 f0 e0                       STAB    b_Csum      ; to the Checksum (for S19)
0245 fce5 39                             RTS                 ; RETURN
0246                         
0247                         ; -----------------------------------------------------
0248                         ; S19 format data load : Modded version of Mikbug code
0249                         ; NOTE THAT THIS IS IN THE WRONG PLACE AT PRESENT!!! It should be at FD07
0250                         ;
0251 fce6                    LOAD        EQU     *           ; L = Load = Input an S19 file
0252 fce6 bd fc 76                       JSR     STRING
0253 fce9 20 2b 20                       FCC     " + "
0254 fcec 0d 0a                          FCB     $0D,$0A     ; c/r l/f
0255 fcee ff                             FCB     $FF         ; End-Of-String
0256 fcef bd fc 00           .sRead      JSR     RD_CMD      ; Read+Echo, test for '.'
0257 fcf2 81 53                          CMPA    #'S         ; Is it `S` ?
0258 fcf4 26 f9                          BNE     .sRead      ; No: Keep waiting for `S`
0259 fcf6 bd fc 00                       JSR     RD_CMD      ; Read+Echo, test for '.'
0260 fcf9 81 39                          CMPA    #'9         ; Is it `9` ?  ( `S9` record )
0261 fcfb 27 26                          BEQ     STARTS      ; Yes: End-data, Back to START
0262 fcfd 81 31                          CMPA    #'1         ; Is it `1` ?  ( `S1` record )
0263 fcff 26 ee                          BNE     .sRead      ; No: Wait for next `S`
0264 fd01 7f f0 e0                       CLR     b_Csum      ; Clear checksum
0265 fd04 bd fc 49                       JSR     ZIN         ; Read 2xHex = data.byte count to A
0266 fd07 80 02                          SUBA    #2          ; Subtract 2 (to get bytes left in line)
0267 fd09 b7 f0 e1                       STAA    b_Count     ; Store byte count
0268 fd0c bd fc 65                       JSR     RD_X        ; Read 4xHex digit address to X
0269 fd0f bd fc 49           .sDoByt     JSR     ZIN         ; Read 2xHex digits, value to A
0270 fd12 7a f0 e1                       DEC     b_Count     ; Decrement our byte count
0271 fd15 27 05                          BEQ     .sChk       ; If end-of-line, go look at checksum
0272 fd17 a7 00                          STAA    0,X         ; Save byte where X points
0273 fd19 08                             INX                 ; Point X at next byte
0274 fd1a 20 f3                          BRA     .sDoByt     ; Go get next byte
0275 fd1c 7c f0 e0           .sChk       INC     b_Csum      ; Add 1 to checksum
0276 fd1f 27 ce                          BEQ     .sRead      ; OK: Go read next record
0277 fd21 8d 03                          BSR     PR_QM       ; Print "?"
0278 fd23 7e ff 8f           STARTS      JMP     START       ; Go to START
0279                         
0280 fd26 86 3f              PR_QM       LDAA #'?            ; Put '?' character in A
0281 fd28 7e fc 0f                       JMP     PR_A        ; Print it and return via PR_As RTS
0282                         
0283                         
0284                         
0285                         
0286                         
0287                         ; -----------------------------------------------------
0288                         ; Read byte from ACIA.A to A
0289                         ;FD2B
0290 fd2b b6 f4 01           RD_A    LDAA    CTRLA   ; Get ACIA.A status byte
0291 fd2e 85 01                      BITA    #$01    ; Is byte ready in DATAA
0292 fd30 27 f9                      BEQ     RD_A    ; No: Try again
0293 fd32 b6 f4 00                   LDAA    DATAA   ; Get the data byte to A
0294 fd35 39                         RTS             ; RETURN
0295                         
0296                         ; -----------------------------------------------------
0297                         ;FD36
0298 fd36 8d 15              REGPRT  BSR     PRSP    ; Print a space
0299 fd38 fe f0 fd                   LDX     PSTACK  ; Point X at user's stack
0300 fd3b 8d 1c                      BSR     PR2     ; Print CC
0301 fd3d 8d 1a                      BSR     PR2     ; Print B
0302 fd3f 8d 18                      BSR     PR2     ; Print A
0303 fd41 8d 10                      BSR     PR4     ; Print X
0304 fd43 8d 0e                      BSR     PR4     ; Print PC
0305 fd45 ce f0 fd                   LDX     #PSTACK ; Point X at stack pointer
0306 fd48 8d 0a                      BSR     PR4X    ; Print stack pointer
0307 fd4a 7e ff 8f                   JMP     START   ; (RETURN) to MINIMON
0308                         
0309                         ; -----------------------------------------------------
0310                         ;FD4D
0311 fd4d 86 20              PRSP    LDAA    #$20    ; Put space character in A
0312 fd4f bd fc 0f                   JSR     PR_A    ; Print it
0313 fd52 39                         RTS             ; RETURN
0314                         
0315 fd53 08                 PR4     INX             ; Point X to next character
0316 fd54 a6 00              PR4X    LDAA    0,X     ; Get byte pointed to by X
0317 fd56 bd fc c9                   JSR     ZOUT    ; Print it
0318 fd59 08                 PR2     INX             ; Point X to next character
0319 fd5a a6 00                      LDAA    0,X     ; Get byte pointed to by X
0320 fd5c bd fc c9                   JSR     ZOUT    ; Print it
0321 fd5f 8d ec                      BSR     PRSP    ; Print a space
0322 fd61 39                         RTS             ; RETURN
0323                         
0324                         ; -----------------------------------------------------
0325                         ;FD62
0326 fd62 bd fc 89           BLKMOV  JSR     GETADD  ; Prompt for boundary addresses
0327 fd65 bd fc 76                   JSR     STRING  ; Print string...
0328 fd68 20 54 6f                   FCC     " To"   ;
0329 fd6b ff                         FCB     $FF     ; End-of-string
0330 fd6c bd fc 65                   JSR     RD_X    ; Read 4 hex digit value into X
0331 fd6f ff f0 ea                   STX     T_NEW   ; Store it as NEW start address
0332 fd72 ff f0 e6                   STX     T_X     ;   "    "
0333 fd75 fe f0 ef                   LDX     T_STRT  ; Put start address into X
0334 fd78 ff f0 e8                   STX     T_Y     ; Store it
0335 fd7b 8d 59                      BSR     SUB     ; Perform T_X minus T_Y
0336 fd7d 2a 23                      BPL     DOWN    ; Go to Move downwards
0337 fd7f fe f0 f1                   LDX     T_STOP  ; Get the STOP stop address
0338 fd82 08                         INX             ; Add 1 to it
0339 fd83 ff f0 f1                   STX     T_STOP  ; and save it
0340 fd86 fe f0 ef           DO_UP   LDX     T_STRT  ; Get START address
0341 fd89 bc f0 f1                   CPX     T_STOP  ; Compare it with STOP
0342 fd8c 26 03                      BNE     CONT_A  ; Finished ?
0343 fd8e 7e ff 8f           STARTB  JMP     START   ; Yes: back to MINIMON
0344 fd91 a6 00              CONT_A  LDAA    0,X     ; No: Get data
0345 fd93 08                         INX             ; Point X to next `old` address
0346 fd94 ff f0 ef                   STX     T_STRT  ; and store it
0347 fd97 fe f0 ea                   LDX     T_NEW   ; get address of NEW location
0348 fd9a a7 00                      STAA    0,X     ; Store the data at NEW address
0349 fd9c 08                         INX             ; Point X to next `new` address
0350 fd9d ff f0 ea                   STX     T_NEW   ; and store it
0351 fda0 20 e4                      BRA     DO_UP   ; loop back for next byte
0352 fda2 fe f0 f1           DOWN    LDX     T_STOP  ; Get end address
0353 fda5 ff f0 e6                   STX     T_X     ; Store it
0354 fda8 8d 2c                      BSR     SUB     ; Perform T_X minus T_Y
0355 fdaa bb f0 eb                   ADDA    T_NEW+1 ; Add NEW (low.byte) to A
0356 fdad fb f0 ea                   ADDB    T_NEW   ; Add NEW (high.byte) to B
0357 fdb0 b7 f0 eb                   STAA    T_NEW+1 ; Save NEW (low.byte)
0358 fdb3 f7 f0 ea                   STAB    T_NEW   ;         (high.byte)
0359 fdb6 fe f0 ef                   LDX     T_STRT  ; Get START address
0360 fdb9 09                         DEX             ; Subract 1 from X
0361 fdba ff f0 ef                   STX     T_STRT  ; Store it
0362 fdbd fe f0 f1           DO_DOWN LDX     T_STOP  ; Get STOP address
0363 fdc0 bc f0 ef                   CPX     T_STRT  ; Compare it with START address
0364 fdc3 27 c9                      BEQ     STARTB  ; Effecively `JMP START`
0365 fdc5 a6 00                      LDAA    0,X     ; Get data
0366 fdc7 09                         DEX             ; Subract 1 from X
0367 fdc8 ff f0 f1                   STX     T_STOP  ; Store it
0368 fdcb fe f0 ea                   LDX     T_NEW   ; Load NEW loc address into X
0369 fdce a7 00                      STAA    0,X     ; Store the data as NEW address
0370 fdd0 09                         DEX             ; Point X to next `new` address
0371 fdd1 ff f0 ea                   STX     T_NEW   ; Store it
0372 fdd4 20 e7                      BRA     DO_DOWN ; Loop back for next byte
0373                         
0374                         ; -----------------------------------------------------
0375                         ;FDD6
0376 fdd6 ce f0 e6           SUB     LDX     #T_X    ; Point X to start of T_X data
0377 fdd9 a6 01                      LDAA    1,X     ; A = T_X (low)
0378 fddb e6 00                      LDAB    0,X     ; B = T_X (high)
0379 fddd a0 03                      SUBA    3,X     ; A = A - T_Y (low)
0380 fddf e2 02                      SBCB    2,X     ; B = B - T_Y (high)
0381 fde1 39                         RTS             ; RETURN
0382                         
0383                         ; -----------------------------------------------------
0384                         ; S format data output : Modded version of Mikbug code
0385                         ;
0386                         
0387 fde2                    CMD_P       EQU     *           ; P = Punch : Output an S19 file
0388 fde2 bd fc 89                       JSR     GETADD      ; Prompt for "Start:","Stop:"
0389 fde5 fe f0 ef                       LDX     T_STRT     ; Get start address
0390 fde8 ff f0 de                       STX     d_TW        ; save it to work area
0391 fdeb b6 f0 f2           .fOut1      LDAA    T_STOP+1    ; get low order of end address
0392 fdee b0 f0 df                       SUBA    d_TW+1      ; Subtract low order start
0393 fdf1 f6 f0 f1                       LDAB    T_STOP      ; ( carry not affected by LDA )
0394 fdf4 f2 f0 de                       SBCB    d_TW        ; Subtract with Carry
0395 fdf7 26 04                          BNE     .fOut2
0396 fdf9 81 10                          CMPA    #16
0397 fdfb 25 02                          BCS     .fOut3
0398 fdfd 86 0f              .fOut2      LDAA    #15
0399 fdff 8b 04              .fOut3      ADDA    #4
0400 fe01 b7 f0 e1                       STAA    b_Count     ; FRAME COUNT THIS RECORD
0401 fe04 80 03                          SUBA    #3
0402 fe06 b7 f0 e2                       STAA    b_Temp      ; BYTE COUNT THIS RECORD
0403 fe09 bd fc 76                       JSR     STRING      ; Output this string...
0404 fe0c 0d 0a                          FCB     $0D,$0A       ; c/r l/f
0405 fe0e 53 31                          FCB     'S,'1       ; S1
0406 fe10 ff                             FCB     $FF         ; End-Of-String
0407 fe11 5f                             CLRB                ; Clear checksum
0408                         
0409                         ; Output frame count...
0410 fe12 ce f0 e1                       LDX     #b_Count    ; X = Address of Framecount
0411 fe15 bd fe a8                       JSR     .fOutHx2    ; O/P byte <-X and inc X
0412                         
0413                         ; Output address...
0414 fe18 ce f0 de                       LDX     #d_TW
0415 fe1b bd fe a8                       JSR     .fOutHx2    ; O/P byte <-X and inc X
0416 fe1e bd fe a8                       JSR     .fOutHx2    ; O/P byte <-X and inc X
0417                         
