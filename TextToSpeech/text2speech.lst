                            259 ; DECIMAL CONVERSION EXAMPLE
                            260 ;--------------------------------------------------------------
                            261         ;JSR     PR_DEC          ; puts 3 decimal digits in DEC, DEC+1 and DEC+2
                            262         ;LDAA    DEC+1           ; don't care about the hundreds        ADDA    #0x30
                            263         ;JSR     PR_WORD
                            264         ;JSR     PR_SPCB
                            265         ;LDAA    DEC+2
                            266         ;JSR     PR_WORD
                            267 
                            268 ; -----------------------------------------------------
                            269 ; PR_DEC: Puts 3 decimal digits in DEC, DEC+1 and DEC+2
                            270 ;
                            271 ;       !! ONLY WORKS WITH VALUES BELOW 128 !!
                            272 ; -----------------------------------------------------
   02D2 5F            [ 2]  273 PR_DEC:  CLRB            ; Clear B for hundreds
                            274 
   02D3 81 64         [ 2]  275 HUND:    CMPA    #100    ; 100 or more?
                            276 
   02D5 2D 05         [ 4]  277         BLT     TENS
   02D7 80 64         [ 2]  278         SUBA    #100    ; Sub 100
   02D9 5C            [ 2]  279         INCB            ; Increment hundred counter
   02DA 20 F7         [ 4]  280         BRA     HUND
                            281 
   02DC F7 1A 02      [ 5]  282 TENS:    STAB    DEC     ; store the hundreds
                            283 
   02DF 5F            [ 2]  284         CLRB
   02E0 81 0A         [ 2]  285 TENS1:   CMPA    #10     ; 10 or more?
   02E2 2D 05         [ 4]  286         BLT     UNITS
   02E4 80 0A         [ 2]  287         SUBA    #10     ; Sub 10
   02E6 5C            [ 2]  288         INCB            ; Increment ten counter
   02E7 20 F7         [ 4]  289         BRA     TENS1
                            290 
   02E9 F7 1A 03      [ 5]  291 UNITS:   STAB    DEC+1
   02EC B7 1A 04      [ 5]  292         STAA    DEC+2   ; Final remainder is units
                            293 
   02EF 39            [ 5]  294         RTS
                            295 
                            296 
                            297 ; -----------------------------------------------------
                            298 ; Print string FOLLOWING JSR ( terminated by 0xFF ) to
                            299 ; ACIA(b) and ACIA(b)
                            300 ; -----------------------------------------------------
   02F0 30            [ 4]  301 STRINGB: TSX             ; Get loc. of return addr to X
   02F1 EE 00         [ 6]  302         LDX     0,X     ; Get return addr to X
   02F3 09            [ 4]  303         DEX             ; Point to byte before
   02F4 08            [ 4]  304 STRB1:   INX             ; Point to next byte
   02F5 A6 00         [ 5]  305         LDAA    0,X     ; Get byte to be printed
   02F7 81 FF         [ 2]  306         CMPA    #0xFF    ; End-string ?
   02F9 27 07         [ 4]  307         BEQ     ENDSTR  ; Yes: Go to finish up
   02FB BD FC 0F      [ 9]  308         JSR     PR_A    ; Print the byte to ACIA(a) (A is maintained)
   02FE 8D 43         [ 8]  309         BSR     PR_B    ; Print the byte to ACIA(b)
   0300 20 F2         [ 4]  310         BRA     STRB1   ; Go back for next byte
   0302 31            [ 4]  311 ENDSTR:  INS             ; Clean up stack...
   0303 31            [ 4]  312         INS             ;  ( pop off the return addr )
   0304 6E 01         [ 4]  313         JMP     1,X     ; Jump back to caller (RETURN)
