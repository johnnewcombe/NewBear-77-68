0106                         ; we cycle thought idle message when no one is on the scales, data comes in a one
0107                         ; second intervals so we simply increase the idle count until it's time to display
0108                         ; the next idle message
0109                         
0110 019d 7c 19 53           IDLE    INC     IDLE_COUNT      ; increase the idle count
0111 01a0 b6 19 53                   LDAA    IDLE_COUNT      ; see if idle count = max idle time
0112 01a3 81 02                      CMPA    #IDLE_SECS      ; a data message appears every second
0113 01a5 27 03                      BEQ     IDLE1           ; not reached the max idle time
0114 01a7 7e 01 05                   JMP     MAINLOOP             ; nothing to do yet
0115                         
0116 01aa 7f 19 53           IDLE1   CLR     IDLE_COUNT      ; time to output an idle message so reset the count
0117 01ad b6 19 54                   LDAA    IDLE_MSG_ID     ; get next Message ID
0118 01b0 81 05                      CMPA    #IDLE_MSG_CNT   ; are we beyond the end of the list
0119 01b2 26 04                      BNE     IDLE_OP         ; still at valid id so output idle message
0120 01b4 7f 19 54                   CLR     IDLE_MSG_ID     ; beyond last message so reset the current msg to zero
0121 01b7 4f                         CLRA                    ; set currentid back to 0
0122                         IDLE_OP
0123 01b8 7c 19 54                   INC     IDLE_MSG_ID     ; set to next message for the next next time
0124 01bb ce 11 97                   LDX     #IDLEPTR        ; A has phrase ID, set X to the base address
