0384                         ; -----------------------------------------------------
0385 032c 36                 PR_CRB  PSHA
0386 032d 86 0d                      LDAA    #$0D        ; Put CHAR character in A
0387 032f bd fc 0f                   JSR     PR_A
0388 0332 bd 02 cb                   JSR     PR_B        ; Print it
0389 0335 86 0a                      LDAA    #$0A
0390 0337 bd fc 0f                   JSR     PR_A
