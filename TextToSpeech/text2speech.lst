0087                         ; -----------------------------------------------------
0088                         ; Random idle phrase to ports B
0089                         ; -----------------------------------------------------
0090 0238 bd 02 75           IDLE    JSR     STRINGB
0091 023b 53 68 61 6c 6c 20          FCC     "Shall I tell you a joke?"
     49 20 74 65 6c 6c
     20 79 6f 75 20 61
     20 6a 6f 6b 65 3f
0092 0253 0a 0d ff                   FCB     $0A, $0D, $FF
0093 0256 39                         RTS
0094                         
0095                         ;--------------------------------------------------------------
0096                         ; DECIMAL CONVERSION EXAMPLE
0097                         ;--------------------------------------------------------------
0098                                 ;JSR     PR_DEC          ; puts 3 decimal digits in DEC, DEC+1 and DEC+2
0099                                 ;LDAA    DEC+1           ; don't care about the hundreds        ADDA    #$30
0100                                 ;JSR     PR_WORD
0101                                 ;JSR     PR_SPCB
0102                                 ;LDAA    DEC+2
0103                                 ;JSR     PR_WORD
0104                         
0105                         ; -----------------------------------------------------
0106                         ; PR_DEC: Puts 3 decimal digits in DEC, DEC+1 and DEC+2
0107                         ;
0108                         ;       !! ONLY WORKS WITH VALUES BELOW 128 !!
0109                         ; -----------------------------------------------------
0110 0257 5f                 PR_DEC  CLRB            ; Clear B for hundreds
0111                         
0112 0258 81 64              HUND    CMPA    #100    ; 100 or more?
0113                         
0114 025a 2d 05                      BLT     TENS
0115 025c 80 64                      SUBA    #100    ; Sub 100
0116 025e 5c                         INCB            ; Increment hundred counter
0117 025f 20 f7                      BRA     HUND
0118                         
0119 0261 f7 04 80           TENS    STAB    DEC     ; store the hundreds
0120                         
0121 0264 5f                         CLRB
0122 0265 81 0a              TENS1   CMPA    #10     ; 10 or more?
0123 0267 2d 05                      BLT     UNITS
0124 0269 80 0a                      SUBA    #10     ; Sub 10
0125 026b 5c                         INCB            ; Increment ten counter
0126 026c 20 f7                      BRA     TENS1
0127                         
0128 026e f7 04 81           UNITS   STAB    DEC+1
0129 0271 b7 04 82                   STAA    DEC+2   ; Final remainder is units
0130                         
0131 0274 39                         RTS
0132                         
0133                         
0134                         ; -----------------------------------------------------
0135                         ; Print string FOLLOWING JSR ( terminated by $FF ) to
0136                         ; ACIA(b) and ACIA(b)
0137                         ; -----------------------------------------------------
0138 0275 30                 STRINGB TSX             ; Get loc. of return addr to X
0139 0276 ee 00                      LDX     0,X     ; Get return addr to X
0140 0278 09                         DEX             ; Point to byte before
0141 0279 08                 AGAIN   INX             ; Point to next byte
0142 027a a6 00                      LDAA    0,X     ; Get byte to be printed
0143 027c 81 ff                      CMPA    #$FF    ; End-string ?
0144 027e 27 07                      BEQ     ENDSTR  ; Yes: Go to finish up
0145 0280 bd fc 0f                   JSR     PR_A    ; Print the byte to ACIA(a) (A is maintained)
0146 0283 8d 40                      BSR     PR_B    ; Print the byte to ACIA(b)
0147 0285 20 f2                      BRA     AGAIN   ; Go back for next byte
0148 0287 31                 ENDSTR  INS             ; Clean up stack...
0149 0288 31                         INS             ;  ( pop off the return addr )
0150 0289 6e 01                      JMP     1,X     ; Jump back to caller (RETURN)
0151                         
0152                         ; -----------------------------------------------------
0153                         ; Prints a string pointed to by X
0154                         ; -----------------------------------------------------
0155 028b a6 00              STRINGBX    LDAA    0,X         ; get char
0156 028d 81 ff                          CMPA    #$FF        ; is character NULL?
0157 028f 27 08                          BEQ     DONEB       ; yes, end of string
0158 0291 bd fc 0f                       JSR     PR_A        ; Print the byte to ACIA(a) (A is maintained)
0159 0294 8d 2f                          BSR     PR_B        ; Print the byte to ACIA(b)
0160 0296 08                             INX
0161 0297 20 f2                          BRA     STRINGBX
0162 0299 39                 DONEB       RTS
0163                         
0164                         ; -----------------------------------------------------
0165                         ; Reads a character from ACIA(b) into A
0166                         ; -----------------------------------------------------
0167 029a 7c 04 83           RD_B    INC     RND         ; simple way to get a random number
0168 029d b6 f4 03                   LDAA    CTRLB       ; Get ACIA.A status byte
0169 02a0 85 01                      BITA    #01         ; Is byte ready in DATAb
0170 02a2 27 f6                      BEQ     RD_B        ; No: Try again
0171 02a4 b6 f4 02                   LDAA    DATAB       ; Get the data byte to A
0172 02a7 84 7f                      ANDA    #$7F        ; Mask off parity bit if it exists
0173 02a9 39                         RTS                 ; RETURN
0174                         
0175                         ; -----------------------------------------------------
0176                         ;
0177                         ; -----------------------------------------------------
0178 02aa 8d ee              ZINB    BSR     RD_B    ; Read a character
0179 02ac bd fc 1d                   JSR     VHEX    ; Is it a hex character ?
0180 02af 25 12                      BCS     Z_PRQM  ; No: go to print `?`
0181 02b1 b7 04 77                   STAA    T_Q     ; Yes: Save Acc.A
0182 02b4 8d e4                      BSR     RD_B    ; Read 2nd character
0183 02b6 bd fc 1d                   JSR     VHEX    ; Is it a hex character ?
0184 02b9 25 08                      BCS     Z_PRQM  ; No: go to print `?`
0185 02bb 16                         TAB             ; Yes: Put it into Acc.B
0186 02bc b6 04 77                   LDAA    T_Q     ; Retrieve 1st hex char to Acc.A
0187 02bf bd fc 31                   JSR     BINARY  ; Convert A:B to binary
0188 02c2 39                         RTS             ; RETURN
0189                         Z_PRQM  ;LDAA    #'?     ; Load `?` into A
0190                                 ;BSR     PR_B    ; Print it
0191 02c3 20 e5                      BRA     ZINB    ; Go back to start of hex input
0192                         
0193                         ; -----------------------------------------------------
0194                         ; Print character in A to ACIA(b)
0195                         ; -----------------------------------------------------
0196 02c5 f6 f4 03           PR_B    LDAB    CTRLB   ; Get ACIA(a) status byte
0197 02c8 c5 02                      BITB    #02     ; Is it busy ?
0198 02ca 27 f9                      BEQ     PR_B    ; Yes: Try again
0199 02cc b7 f4 02                   STAA    DATAB   ;  No: Send data
0200 02cf 39                 PRB_END RTS             ; RETURN
0201                         
0202                         ; -----------------------------------------------------
0203                         ; Read 4 hex digits and put value into X
0204                         ; -----------------------------------------------------
0205 02d0 8d d8              RD_XB   BSR     ZINB    ; Read 2 digit hex value into A
0206 02d2 b7 04 78                   STAA    T_Z     ; Save byte (most significant)
0207 02d5 8d d3                      BSR     ZINB    ; Read 2 digit hex value into A
0208 02d7 b7 04 79                   STAA    T_Z+1   ; Save byte (least significant)
0209 02da fe 04 78                   LDX     T_Z     ; Load full 4 hex value into X
0210 02dd 39                         RTS             ; RETURN
0211                         
0212                         ; -----------------------------------------------------
0213                         ; Prints the message " n stones n pounds"
0214                         ; place stones in MSB of X and pound in LSB
0215                         ; -----------------------------------------------------
0216                         PR_WEIGHT
0217 02de ff 04 7e                   STX     T_W
0218                                 ;JSR     STRINGB
0219                                 ;FCC     "You weigh "
0220                                 ;FDB     $FF
0221 02e1 b6 04 7e                   LDAA    T_W             ; Load high byte of X into Accumulator A
0222 02e4 bd 03 51                   JSR     PR_WORD
0223 02e7 bd 02 75                   JSR     STRINGB
0224 02ea 20 73 74 6f 6e 65          FCC     " stones "
     73 20
0225 02f2 00 ff                      FDB     $FF
0226 02f4 b6 04 7f                   LDAA    T_W+1            ; Load high byte of X into Accumulator A
0227 02f7 bd 03 51                   JSR     PR_WORD
0228 02fa bd 02 75                   JSR     STRINGB
0229 02fd 20 70 6f 75 6e 64          FCC     " pounds"
     73
0230 0304 0d 0a ff                   FCB     $0D, $0A,$FF
0231                         
0232 0307 39                         RTS
0233                         
0234                         ; -----------------------------------------------------
0235                         ; Prints a space on both consoles (preserves A)
0236                         ; -----------------------------------------------------
0237 0308 36                 PR_SPCB   PSHA
0238 0309 86 20                      LDAA    #$20        ; Put space character in A
0239 030b bd fc 0f                   JSR     PR_A
0240 030e bd 02 c5                   JSR     PR_B        ; Print it
0241 0311 32                         PULA
0242 0312 39                         RTS                 ; RETURN
0243                         
0244                         ; -----------------------------------------------------
0245                         ; Prints a CRLF on both consoles (preserves A)
0246                         ; -----------------------------------------------------
0247 0313 36                 PR_CRB  PSHA
0248 0314 86 0d                      LDAA    #$0D        ; Put CHAR character in A
0249 0316 bd fc 0f                   JSR     PR_A
0250 0319 bd 02 c5                   JSR     PR_B        ; Print it
0251 031c 86 0a                      LDAA    #$0A
0252 031e bd fc 0f                   JSR     PR_A
0253 0321 bd 02 c5                   JSR     PR_B        ; Print it
0254 0324 32                         PULA
0255 0325 39                         RTS                 ; RETURN
0256                         
0257                         ; -----------------------------------------------------
0258                         ; Outputs a phrase from the value in A
0259                         ; -----------------------------------------------------
0260                         PR_PHRASE
0261 0326 4c                         INCA
0262 0327 ce 03 a1                   LDX     #PHRASEPTR  ; load address of phrase ponter
0263                                                     ; table
0264 032a 4a                 PR_PH1  DECA                ; loop through A times to get
0265 032b 27 04                      BEQ     FOUNDP      ;   address of phrase
0266 032d 08                         INX                 ; move to next address
0267 032e 08                         INX
0268 032f 20 f9                      BRA     PR_PH1      ; try again
0269 0331 a6 00              FOUNDP  LDAA    0,X         ; transfer addr pointed to by X to memory
0270 0333 b7 04 7c                   STAA    T_P         ; MSB
0271 0336 a6 01                      LDAA    1,X         ;
0272 0338 b7 04 7d                   STAA    T_P+1       ; LSB
0273 033b fe 04 7c           PR_PH3  LDX     T_P         ; load X
0274 033e a6 00                      LDAA    0,X         ; get word id
0275 0340 08                         INX                 ; point X to next word
0276 0341 ff 04 7c                   STX     T_P         ; store X away
0277 0344 81 00                      CMPA    #0
0278 0346 27 08                      BEQ     PR_PH2      ; no more words
0279 0348 bd 03 51                   JSR     PR_WORD     ; print word based on value in A
0280 034b bd 03 08                   JSR     PR_SPCB
0281 034e 20 eb                      BRA     PR_PH3      ; next word
0282 0350 39                 PR_PH2  RTS
0283                         
0284                         ; -----------------------------------------------------
0285                         ; Outputs a word based on value in A
0286                         ; -----------------------------------------------------
0287 0351 4c                 PR_WORD     INCA
0288 0352 ce 03 6d                       LDX     #WORDPTR  ; base of offset table
0289 0355 4a                 PR_WORD1    DECA
0290 0356 27 04                          BEQ     FOUNDW
0291 0358 08                             INX                 ; move to next address
0292 0359 08                             INX
0293 035a 26 f9                          BNE     PR_WORD1    ; loop around to retest
0294 035c a6 00              FOUNDW      LDAA    0,X
0295 035e b7 04 7a                       STAA    T_X
0296 0361 a6 01                          LDAA    1,X
0297 0363 b7 04 7b                       STAA    T_X+1
0298 0366 fe 04 7a                       LDX     T_X
0299 0369 bd 02 8b                       JSR     STRINGBX
0300 036c 39                             RTS
