0001                         ;------------------------------------------------------------------
0002                         ; text2speech.asm
0003                         ;------------------------------------------------------------------
0004                         
0005                         ; 7768 ACIA
0006 f400                    DATAA   EQU $F400 ; ACIA(a) Data register
0007 f401                    CTRLA   EQU $F401 ; ACIA(a) Ctrl/Status
0008 f402                    DATAB   EQU $F402 ; ACIA(b) Data register
0009 f403                    CTRLB   EQU $F403 ; ACIA(b) Ctrl/Status
0010                         
0011                         ; MINIMON routines
0012 fc76                    STRING  EQU $FC76 ; Prints a string. The string should follow JSR and be terminated with $FF.
0013 fc89                    GETADD  EQU $FC89 ; Get Address, read 4 digit hex value.
0014 fcc9                    ZOUT    EQU $FCC9 ; Print value in A as 2 hex digits.
0015 fe97                    NEWLINE EQU $FE97 ; Prints a new line.
0016 ff8f                    START   EQU $FF8F ; Restarts MniMon.
0017 fc0f                    PR_A    EQU $FC0F ; Print char in A to ACIA (a)
0018 fd2b                    RD_A    EQU $FD2B ; Read char from A
0019 fd4d                    PRSP    EQU $FD4D ; Print a space
0020 fc31                    BINARY  EQU $FC31 ; Converts ASCII hex digits in A and B to binary?
0021 fc65                    RD_X    EQU $FC65 ; Read 4 hex digits Value from ACIA(a) and put value into X.
0022 fc1d                    VHEX    EQU $FC1D ; Checks that A contains a HEX character
0023 0200                    	    ORG $0200
0024                         
0025                         ; initialise serial port B
0026 0200 86 11              TX2SP   LDAA    #$11    ; 8 Data, No Parity, 2 Stop Bits
0027 0202 b7 f4 03                   STAA    CTRLB   ;   ACIA.A
0028                         
0029                         
0030                         
0031                                 ; -----------------------------------------------------
0032                                 ; PRINT NUMBERS 0 TO 9
0033                                 ; -----------------------------------------------------
0034                         
0035 0205 4f                         CLRA
0036 0206 bd 02 f0           PRNUMS  JSR     PRSPB
0037 0209 bd 02 fb                   JSR     PR_NUMB
0038 020c 4c                         INCA
0039 020d 81 0a                      CMPA    #10
0040 020f 26 f5                      BNE     PRNUMS
0041 0211 bd 02 f0                   JSR     PRSPB
0042                         
0043                         
0044                         LOOP:
0045                         ; -----------------------------------------------------
0046                         ; Data arrives at port B as four hex characters
0047                         ; -----------------------------------------------------
0048 0214 bd 02 e1                   JSR     RD_XB           ; read 4 hex characters into X
0049 0217 ff 03 66                   STX     TEMP            ; save X
0050                         
0051                         ;--------------------------------------------------------------
0052                         ; FIRST DIGIT
0053                         ;--------------------------------------------------------------
0054                         
0055 021a bd 02 f0                   JSR     PRSPB
0056                         
0057 021d b6 03 66                   LDAA    TEMP            ; Load high byte of X into Accumulator A
0058 0220 bd 02 6d                   JSR     PR_DEC          ; puts 3 decimal digits in DEC, DEC+1 and DEC+2
0059                         
0060 0223 b6 03 69                   LDAA    DEC+1           ; don't care about the hundreds        ADDA    #$30
0061 0226 bd 02 fb                   JSR     PR_NUMB
0062                         
0063 0229 bd 02 f0                   JSR     PRSPB
0064                         
0065 022c b6 03 6a                   LDAA    DEC+2
0066 022f bd 02 fb                   JSR     PR_NUMB
0067                         
0068                         
0069                         ;--------------------------------------------------------------
0070                         ; SECOND DIGIT
0071                         ;--------------------------------------------------------------
0072                         
0073 0232 bd 02 f0                   JSR     PRSPB
0074 0235 b6 03 67                   LDAA    TEMP+1            ; Load high byte of X into Accumulator A
0075 0238 bd 02 6d                   JSR     PR_DEC
0076                         
0077 023b b6 03 69                   LDAA    DEC+1             ; don't care about the hundreds
0078 023e bd 02 fb                   JSR     PR_NUMB
0079                         
0080 0241 bd 02 f0                   JSR     PRSPB
0081                         
0082 0244 b6 03 6a                   LDAA    DEC+2
0083 0247 bd 02 fb                   JSR     PR_NUMB
0084                         
0085                         ;--------------------------------------------------------------
0086                         ;
0087                         ;--------------------------------------------------------------
0088 024a bd 02 8b                   JSR     STRINGB
0089 024d 0d 0a                      FCB     $0D, $0A
0090 024f 53 68 61 6c 6c 20          FCC     "Shall I tell you a joke?"
     49 20 74 65 6c 6c
     20 79 6f 75 20 61
     20 6a 6f 6b 65 3f
0091 0267 0d 0a ff                   FCB     $0D, $0A,$FF
0092                         
0093 026a 7e 02 14           .END    JMP     LOOP  ;START   ; all done
0094                         
0095                         ; -----------------------------------------------------
0096                         ; PR_DEC: Puts 3 decimal digits in DEC, DEC+1 and DEC+2
0097                         ;
0098                         ;       !! ONLY WORKS WITH VALUES BELOW 128 !!
0099                         ; -----------------------------------------------------
0100 026d 5f                 PR_DEC  CLRB            ; Clear B for hundreds
0101                         
0102 026e 81 64              HUND    CMPA    #100    ; 100 or more?
0103                         
0104 0270 2d 05                      BLT     TENS
0105 0272 80 64                      SUBA    #100    ; Sub 100
0106 0274 5c                         INCB            ; Increment hundred counter
0107 0275 20 f7                      BRA     HUND
0108                         
0109 0277 f7 03 68           TENS    STAB    DEC     ; store the hundreds
0110                         
0111 027a 5f                         CLRB
0112 027b 81 0a              TENS1   CMPA    #10     ; 10 or more?
0113 027d 2d 05                      BLT     UNITS
0114 027f 80 0a                      SUBA    #10     ; Sub 10
0115 0281 5c                         INCB            ; Increment ten counter
0116 0282 20 f7                      BRA     TENS1
0117                         
0118 0284 f7 03 69           UNITS   STAB    DEC+1
0119 0287 b7 03 6a                   STAA    DEC+2   ; Final remainder is units
0120                         
0121 028a 39                         RTS
0122                         
0123                         
0124                         ; -----------------------------------------------------
0125                         ; Print string FOLLOWING JSR ( terminated by $FF ) to
0126                         ; ACIA(b) and ACIA(b)
0127                         ; -----------------------------------------------------
0128 028b 30                 STRINGB TSX             ; Get loc. of return addr to X
0129 028c ee 00                      LDX     0,X     ; Get return addr to X
0130 028e 09                         DEX             ; Point to byte before
0131 028f 08                 AGAIN   INX             ; Point to next byte
0132 0290 a6 00                      LDAA    0,X     ; Get byte to be printed
0133 0292 81 ff                      CMPA    #$FF    ; End-string ?
0134 0294 27 07                      BEQ     ENDSTR  ; Yes: Go to finish up
0135 0296 bd fc 0f                   JSR     PR_A    ; Print the byte to ACIA(a) (A is maintained)
0136 0299 8d 3b                      BSR     PR_B    ; Print the byte to ACIA(b)
0137 029b 20 f2                      BRA     AGAIN   ; Go back for next byte
0138 029d 31                 ENDSTR  INS             ; Clean up stack...
0139 029e 31                         INS             ;  ( pop off the return addr )
0140 029f 6e 01                      JMP     1,X     ; Jump back to caller (RETURN)
0141                         
0142                         ; -----------------------------------------------------
0143                         ; Prints a string pointed to by X
0144                         ; -----------------------------------------------------
0145 02a1 a6 00              STRINGBX    LDAA    0,X         ; get char
0146 02a3 81 ff                          CMPA    #$FF        ; is character NULL?
0147 02a5 27 08                          BEQ     DONEB       ; yes, end of string
0148 02a7 bd fc 0f                       JSR     PR_A        ; Print the byte to ACIA(a) (A is maintained)
0149 02aa 8d 2a                          BSR     PR_B        ; Print the byte to ACIA(b)
0150 02ac 08                             INX
0151 02ad 20 f2                          BRA     STRINGBX
0152 02af 39                 DONEB       RTS
0153                         
0154                         ; -----------------------------------------------------
0155                         ; Reads a character from ACIA(b) into A
0156                         ; -----------------------------------------------------
0157 02b0 b6 f4 03           RD_B    LDAA    CTRLB       ; Get ACIA.A status byte
0158 02b3 85 01                      BITA    #01         ; Is byte ready in DATAb
0159 02b5 27 f9                      BEQ     RD_B        ; No: Try again
0160 02b7 b6 f4 02                   LDAA    DATAB       ; Get the data byte to A
0161                                 ;ANDA    #$7F        ; Mask off parity bit if it exists
0162 02ba 39                         RTS                 ; RETURN
0163                         
0164                         ; -----------------------------------------------------
0165                         ;
0166                         ; -----------------------------------------------------
0167 02bb 8d f3              ZINB    BSR     RD_B    ; Read a character
0168 02bd bd fc 1d                   JSR     VHEX    ; Is it a hex character ?
0169 02c0 25 12                      BCS     Z_PRQM  ; No: go to print `?`
0170 02c2 b7 03 63                   STAA    T_Q     ; Yes: Save Acc.A
0171 02c5 8d e9                      BSR     RD_B    ; Read 2nd character
0172 02c7 bd fc 1d                   JSR     VHEX    ; Is it a hex character ?
0173 02ca 25 08                      BCS     Z_PRQM  ; No: go to print `?`
0174 02cc 16                         TAB             ; Yes: Put it into Acc.B
0175 02cd b6 03 63                   LDAA    T_Q     ; Retrieve 1st hex char to Acc.A
0176 02d0 bd fc 31                   JSR     BINARY  ; Convert A:B to binary
0177 02d3 39                         RTS             ; RETURN
0178                         Z_PRQM  ;LDAA    #'?     ; Load `?` into A
0179                                 ;BSR     PR_B    ; Print it
0180 02d4 20 e5                      BRA     ZINB    ; Go back to start of hex input
0181                         
0182                         ; -----------------------------------------------------
0183                         ; Print character in A to ACIA(b)
0184                         ; -----------------------------------------------------
0185 02d6 f6 f4 03           PR_B    LDAB    CTRLB   ; Get ACIA(a) status byte
0186 02d9 c5 02                      BITB    #02     ; Is it busy ?
0187 02db 27 f9                      BEQ     PR_B    ; Yes: Try again
0188 02dd b7 f4 02                   STAA    DATAB   ;  No: Send data
0189 02e0 39                 PRB_END RTS             ; RETURN
0190                         
0191                         ; -----------------------------------------------------
0192                         ; Read 4 hex digits and put value into X
0193                         ; -----------------------------------------------------
0194                         RD_XB   ;JSR     PRSPB   ; Print a space
0195 02e1 8d d8                      BSR     ZINB    ; Read 2 digit hex value into A
0196 02e3 b7 03 64                   STAA    T_Z     ; Save byte (most significant)
0197 02e6 8d d3                      BSR     ZINB    ; Read 2 digit hex value into A
0198 02e8 b7 03 65                   STAA    T_Z+1   ; Save byte (least significant)
0199 02eb fe 03 64                   LDX     T_Z     ; Load full 4 hex value into X
0200 02ee 39                         RTS             ; RETURN
0201                         
0202                         ; -----------------------------------------------------
0203                         ; Random idle phrase to ports B
0204                         ; -----------------------------------------------------
0205 02ef 39                 IDLE    RTS
0206                         
0207                         ; -----------------------------------------------------
0208                         ; Prints a space on both consoles (preserves A)
0209                         ; -----------------------------------------------------
0210 02f0 36                 PRSPB   PSHA
0211 02f1 86 20                      LDAA    #$20        ; Put space character in A
0212 02f3 bd fc 0f                   JSR     PR_A
0213 02f6 bd 02 d6                   JSR     PR_B        ; Print it
0214 02f9 32                         PULA
0215 02fa 39                         RTS                 ; RETURN
0216                         
