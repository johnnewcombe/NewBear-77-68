output:  galaxy.s19
0001                         ;------------------------------------------
0002                         ; 6800 code for Scelbi Galaxy game lifted
0003                         ; from .pdf document & ocr of same
0004                         ; with I/O to CDC/DJC DEMON monitor
0005                         ;
0006                         ; MODIFY I/O ROUTINES AT THE END FOR YOUR SYSTEM
0007                         ;
0008                         ;   CDC 11-July-2023
0009                         ;       . Assigned labels to messages and changed references 
0010                         ;       . to message addresses in code to use those labels.
0011                         ;       . Message characters put in ASCII WITHOUT the high bit set.
0012                         ;       . Make labels for subsitution points in messages.
0013                         ;       . Change INPUT and PRINT routines to use DEMON SWI calls
0014                         ;       . Change NOPs after CHICKEN! message to jump back to DEMON
0015                         ;
0016                         ;   CDC 12-July-2023
0017                         ;       . Cosmetic changes to some messages ( Change 1 to | )
0018                         ;       . More use of labels for Hex adress references
0019                         ;
0020                         ;   CDC 13-July-2023
0021                         ;       . Added Ctrl+C = Quit back to monitor to input routine
0022                         ;       . More work on removing use of high bit in ASCII chars
0023                         ;
0024                         ;   CDC 14-July-2023
0025                         ;       . Departing more from original code...
0026                         ;       .  Changed Space station from >1< to ]O[
0027                         ;       .  Changed Ship from <*> to <o>
0028                         ;
0029                         ;   CDC 18-July-2023
0030                         ;       . Fixed bug in course table for direction 5.0 
0031                         ;
0032                         ;   Apart from some text chars not having
0033                         ;   high bit set in definitions
0034                         ;   and our I/O and `Chicken!` exit jump
0035                         ;   code hex on listing matches original listing...
0036                         ;   https://archive.org/details/Scelbi-Galaxy-Game-for-the-6800-Robert-Findley-1977
0037                         ;    or
0038                         ;   https://ia803208.us.archive.org/28/items/
0039                         ;       Scelbi-Galaxy-Game-for-the-6800-Robert-Findley-1977/
0040                         ;       Scelbi%27s_Galaxy_Game_for_the_6800_Robert_Findley_1977.pdf
0041                         ;
0042                         ;------------------------------------------
0043                         ; Some definitions...
0044 0000                    DATA_BASE   EQU     $0000   ; General data
0045 0080                    GLXY_MSGE   EQU     $0080   ; Galaxy line message
0046 00c0                    GLXY_BASE   EQU     $00C0   ; Galaxy data
0047 0100                    TEXT_BASE   EQU     $0100   ; Main message area
0048 0500                    CODE_BASE   EQU     $0500   ; Main code area
0049 0eff                    STACK_TOP   EQU     $0EFF   ; Top of stack area
0050 0f80                    IOIF_BASE   EQU     $0F80   ; I/O interface to monitor
0051                         
0052 000d                    cCR         EQU     $0D     ; Carriage-return
0053 000a                    cLF         EQU     $0A     ; Line-feed
0054 0000                    cEOS        EQU     $00     ; End-of-string
0055 0003                    cCtrlC      EQU     $03     ; Control+C
0056                         
0057 005d                    cStation1   EQU     ']      ; Spacestation left char (was '>)
0058 004f                    cStation2   EQU     'O      ; Spacestation middle char (was '1)
0059 005b                    cStation3   EQU     '[      ; Spacestation right char (was '<)
0060                         
0061 003c                    cShip1      EQU     '<      ; Ship left char
0062 006f                    cShip2      EQU     'o      ; Ship middle char (was '*)
0063 003e                    cShip3      EQU     '>      ; Ship right char
0064                         
0065 002b                    cAlien      EQU     '+      ; Alien ship is 3 of these (was +++)
0066 002a                    cStar       EQU     '*      ; Star char (was '*)
0067                         
