                            107 ; we cycle thought idle message when no one is on the scales, data comes in a one
                            108 ; second intervals so we simply increase the idle count until it's time to display
                            109 ; the next idle message
                            110 
   019D 7C 19 53      [ 6]  111 IDLE:    INC     IDLE_COUNT      ; increase the idle count
   01A0 B6 19 53      [ 4]  112         LDAA    IDLE_COUNT      ; see if idle count = max idle time
   01A3 81 02         [ 2]  113         CMPA    #IDLE_SECS      ; a data message appears every second
   01A5 27 03         [ 4]  114         BEQ     IDLE1           ; not reached the max idle time
   01A7 7E 01 05      [ 3]  115         JMP     MAINLOOP             ; nothing to do yet
                            116 
   01AA 7F 19 53      [ 6]  117 IDLE1:   CLR     IDLE_COUNT      ; time to output an idle message so reset the count
   01AD B6 19 54      [ 4]  118         LDAA    IDLE_MSG_ID     ; get next Message ID
   01B0 81 05         [ 2]  119         CMPA    #IDLE_MSG_CNT   ; are we beyond the end of the list
   01B2 26 04         [ 4]  120         BNE     IDLE_OP         ; still at valid id so output idle message
   01B4 7F 19 54      [ 6]  121         CLR     IDLE_MSG_ID     ; beyond last message so reset the current msg to zero
   01B7 4F            [ 2]  122         CLRA                    ; set currentid back to 0
   01B8                     123 IDLE_OP:
   01B8 7C 19 54      [ 6]  124         INC     IDLE_MSG_ID     ; set to next message for the next next time
   01BB CE 11 97      [ 3]  125         LDX     #IDLEPTR        ; A has phrase ID, set X to the base address
   01BE BD 02 34      [ 9]  126         JSR     PHRASE_OUT
   01C1 7E 01 05      [ 3]  127         JMP     MAINLOOP
                            128 
   01C4                     129 GREET:   ; output the greeting message
   01C4 B6 19 55      [ 4]  130         LDAA    GREET_MSG_ID    ; get next Message ID
   01C7 81 05         [ 2]  131         CMPA    #GREET_MSG_CNT  ; are we beyond the end of the list
   01C9 26 04         [ 4]  132         BNE     GREET_OP        ; still at valid id so output idle message
   01CB 7F 19 55      [ 6]  133         CLR     GREET_MSG_ID    ; beyond last message so reset the current msg to zero
   01CE 4F            [ 2]  134         CLRA                    ; set currentid back to 0
   01CF                     135 GREET_OP:
   01CF 7C 19 55      [ 6]  136         INC     GREET_MSG_ID    ; set to next message for the next next time
   01D2 CE 11 09      [ 3]  137         LDX     #GREETPTR       ; A has phrase ID, set X to the base address
   01D5 BD 02 34      [ 9]  138         JSR     PHRASE_OUT
   01D8 39            [ 5]  139         RTS
                            140 
   01D9                     141 LIGHTW:   ; output the lightweight message
   01D9 B6 19 56      [ 4]  142         LDAA    LIGHT_MSG_ID    ; get next Message ID
