0213                         ;--------------------------------------------------------------
0214                         ; Gets the weight data from the scales and rerurns with carry
0215                         ; set if a valid reading, carry clear otherwise. A valid weight
0216                         ; reading resets the idle count. Data received is stored in
0217                         ; T_WEIGHT and MSB in A.
0218                         ;--------------------------------------------------------------
0219                         GETDATA
0220 0249 bd 02 d3                   JSR     RD_XB           ; read 4 hex characters into X
0221 024c ff 19 48                   STX     T_WEIGHT        ; store X
0222 024f 0c                         CLC
0223 0250 b6 19 48                   LDAA    T_WEIGHT        ; get fist byte (stones)
0224 0253 27 04                      BEQ     GDDONE          ; idle message
0225 0255 7f 00 02                   CLR     IDLE_SECS       ; not an idle message so reset the idle counter
0226 0258 0d                         SEC                     ; non idle message return with carry set
0227 0259 39                 GDDONE  RTS
0228                         
0229                         ;--------------------------------------------------------------
0230                         ; DECIMAL CONVERSION EXAMPLE
0231                         ;--------------------------------------------------------------
0232                                 ;JSR     PR_DEC          ; puts 3 decimal digits in DEC, DEC+1 and DEC+2
0233                                 ;LDAA    DEC+1           ; don't care about the hundreds        ADDA    #$30
0234                                 ;JSR     PR_WORD
0235                                 ;JSR     PR_SPCB
0236                                 ;LDAA    DEC+2
0237                                 ;JSR     PR_WORD
0238                         
0239                         ; -----------------------------------------------------
0240                         ; PR_DEC: Puts 3 decimal digits in DEC, DEC+1 and DEC+2
0241                         ;
0242                         ;       !! ONLY WORKS WITH VALUES BELOW 128 !!
0243                         ; -----------------------------------------------------
0244 025a 5f                 PR_DEC  CLRB            ; Clear B for hundreds
0245                         
0246 025b 81 64              HUND    CMPA    #100    ; 100 or more?
0247                         
0248 025d 2d 05                      BLT     TENS
0249 025f 80 64                      SUBA    #100    ; Sub 100
0250 0261 5c                         INCB            ; Increment hundred counter
0251 0262 20 f7                      BRA     HUND
0252                         
0253 0264 f7 19 42           TENS    STAB    DEC     ; store the hundreds
0254                         
0255 0267 5f                         CLRB
0256 0268 81 0a              TENS1   CMPA    #10     ; 10 or more?
0257 026a 2d 05                      BLT     UNITS
0258 026c 80 0a                      SUBA    #10     ; Sub 10
0259 026e 5c                         INCB            ; Increment ten counter
0260 026f 20 f7                      BRA     TENS1
0261                         
0262 0271 f7 19 43           UNITS   STAB    DEC+1
0263 0274 b7 19 44                   STAA    DEC+2   ; Final remainder is units
0264                         
0265 0277 39                         RTS
0266                         
0267                         
0268                         ; -----------------------------------------------------
0269                         ; Print string FOLLOWING JSR ( terminated by $FF ) to
0270                         ; ACIA(b) and ACIA(b)
0271                         ; -----------------------------------------------------
0272 0278 30                 STRINGB TSX             ; Get loc. of return addr to X
0273 0279 ee 00                      LDX     0,X     ; Get return addr to X
0274 027b 09                         DEX             ; Point to byte before
0275 027c 08                 STRB1   INX             ; Point to next byte
0276 027d a6 00                      LDAA    0,X     ; Get byte to be printed
0277 027f 81 ff                      CMPA    #$FF    ; End-string ?
0278 0281 27 07                      BEQ     ENDSTR  ; Yes: Go to finish up
0279 0283 bd fc 0f                   JSR     PR_A    ; Print the byte to ACIA(a) (A is maintained)
0280 0286 8d 40                      BSR     PR_B    ; Print the byte to ACIA(b)
0281 0288 20 f2                      BRA     STRB1   ; Go back for next byte
0282 028a 31                 ENDSTR  INS             ; Clean up stack...
0283 028b 31                         INS             ;  ( pop off the return addr )
0284 028c 6e 01                      JMP     1,X     ; Jump back to caller (RETURN)
0285                         
0286                         ; -----------------------------------------------------
0287                         ; Prints a string pointed to by X
0288                         ; -----------------------------------------------------
0289 028e a6 00              STRINGBX    LDAA    0,X         ; get char
0290 0290 81 ff                          CMPA    #$FF        ; is character NULL?
0291 0292 27 08                          BEQ     DONEB       ; yes, end of string
0292 0294 bd fc 0f                       JSR     PR_A        ; Print the byte to ACIA(a) (A is maintained)
0293 0297 8d 2f                          BSR     PR_B        ; Print the byte to ACIA(b)
0294 0299 08                             INX
0295 029a 20 f2                          BRA     STRINGBX
0296 029c 39                 DONEB       RTS
0297                         
0298                         ; -----------------------------------------------------
0299                         ; Reads a character from ACIA(b) into A
0300                         ; -----------------------------------------------------
0301 029d 7c 19 45           RD_B    INC     RND         ; simple way to get a random number
0302 02a0 b6 f4 03                   LDAA    CTRLB       ; Get ACIA.A status byte
0303 02a3 85 01                      BITA    #01         ; Is byte ready in DATAb
0304 02a5 27 f6                      BEQ     RD_B        ; No: Try again
0305 02a7 b6 f4 02                   LDAA    DATAB       ; Get the data byte to A
0306 02aa 84 7f                      ANDA    #$7F        ; Mask off parity bit if it exists
0307 02ac 39                         RTS                 ; RETURN
0308                         
0309                         ; -----------------------------------------------------
0310                         ;
0311                         ; -----------------------------------------------------
0312 02ad 8d ee              ZINB    BSR     RD_B    ; Read a character
0313 02af bd fc 1d                   JSR     VHEX    ; Is it a hex character ?
0314 02b2 25 12                      BCS     Z_PRQM  ; No: go to print `?`
0315 02b4 b7 19 35                   STAA    T_Q     ; Yes: Save Acc.A
0316 02b7 8d e4                      BSR     RD_B    ; Read 2nd character
0317 02b9 bd fc 1d                   JSR     VHEX    ; Is it a hex character ?
0318 02bc 25 08                      BCS     Z_PRQM  ; No: go to print `?`
0319 02be 16                         TAB             ; Yes: Put it into Acc.B
0320 02bf b6 19 35                   LDAA    T_Q     ; Retrieve 1st hex char to Acc.A
0321 02c2 bd fc 31                   JSR     BINARY  ; Convert A:B to binary
0322 02c5 39                         RTS             ; RETURN
0323                         Z_PRQM  ;LDAA    #'?     ; Load `?` into A
0324                                 ;BSR     PR_B    ; Print it
0325 02c6 20 e5                      BRA     ZINB    ; Go back to start of hex input
0326                         
0327                         ; -----------------------------------------------------
0328                         ; Print character in A to ACIA(b)
0329                         ; -----------------------------------------------------
0330 02c8 f6 f4 03           PR_B    LDAB    CTRLB   ; Get ACIA(a) status byte
0331 02cb c5 02                      BITB    #02     ; Is it busy ?
0332 02cd 27 f9                      BEQ     PR_B    ; Yes: Try again
0333 02cf b7 f4 02                   STAA    DATAB   ;  No: Send data
0334 02d2 39                 PRB_END RTS             ; RETURN
0335                         
0336                         ; -----------------------------------------------------
0337                         ; Read 4 hex digits and put value into X
0338                         ; -----------------------------------------------------
0339 02d3 8d d8              RD_XB   BSR     ZINB    ; Read 2 digit hex value into A
0340 02d5 b7 19 36                   STAA    T_Z     ; Save byte (most significant)
0341 02d8 8d d3                      BSR     ZINB    ; Read 2 digit hex value into A
0342 02da b7 19 37                   STAA    T_Z+1   ; Save byte (least significant)
0343 02dd fe 19 36                   LDX     T_Z     ; Load full 4 hex value into X
0344 02e0 39                         RTS             ; RETURN
0345                         ; -----------------------------------------------------
0346                         ; Adds A to X and leaves the result in X, A is
0347                         ; preserved.
0348                         ; -----------------------------------------------------
0349 02e1 36                 ADX     PSHA
0350 02e2 ff 19 40                   STX     T_TMP
0351 02e5 bb 19 41                   ADDA    T_TMP+1   ; add A to low byte
0352 02e8 b7 19 41                   STAA    T_TMP+1
0353 02eb b6 19 40                   LDAA    T_TMP     ; get high byte
0354 02ee 89 00                      ADCA    #0      ; add carry only
0355 02f0 b7 19 40                   STAA    T_TMP
0356 02f3 fe 19 40                   LDX     T_TMP
0357 02f6 32                         PULA
0358 02f7 39                         RTS
0359                         
0360                         ; -----------------------------------------------------
0361                         ; Prints the message " n stones n pounds"
0362                         ; place stones in MSB of X and pound in LSB
0363                         ; -----------------------------------------------------
0364                         PR_WEIGHT
0365 02f8 ff 19 3e                   STX     T_W
0366 02fb b6 19 3e                   LDAA    T_W             ; Load high byte of X into Accumulator A
0367 02fe bd 03 5e                   JSR     PR_WORD         ; n
0368 0301 bd 03 1e                   JSR     PR_SPCB
0369 0304 86 1b                      LDAA    #$1B
0370 0306 bd 03 5e                   JSR     PR_WORD         ; "stones"
0371 0309 bd 03 1e                   JSR     PR_SPCB
0372 030c b6 19 3f                   LDAA    T_W+1            ; Load high byte of X into Accumulator A
0373 030f bd 03 5e                   JSR     PR_WORD         ; n
0374 0312 86 1c                      LDAA    #$1C
0375 0314 bd 03 1e                   JSR     PR_SPCB
0376 0317 bd 03 5e                   JSR     PR_WORD         ; "pounds"
0377 031a bd 03 29                   JSR     PR_CRB
0378 031d 39                         RTS
0379                         
0380                         ; -----------------------------------------------------
0381                         ; Prints a space on both consoles (preserves A)
0382                         ; -----------------------------------------------------
0383 031e 36                 PR_SPCB PSHA
0384 031f 86 20                      LDAA    #$20        ; Put space character in A
0385 0321 bd fc 0f                   JSR     PR_A
0386 0324 bd 02 c8                   JSR     PR_B        ; Print it
0387 0327 32                         PULA
0388 0328 39                         RTS                 ; RETURN
0389                         
0390                         ; -----------------------------------------------------
0391                         ; Prints a CRLF on both consoles (preserves A)
0392                         ; -----------------------------------------------------
0393 0329 36                 PR_CRB  PSHA
0394 032a 86 0d                      LDAA    #$0D        ; Put CHAR character in A
0395 032c bd fc 0f                   JSR     PR_A
0396 032f bd 02 c8                   JSR     PR_B        ; Print it
0397 0332 86 0a                      LDAA    #$0A
0398 0334 bd fc 0f                   JSR     PR_A
0399 0337 bd 02 c8                   JSR     PR_B        ; Print it
0400 033a 32                         PULA
0401 033b 39                         RTS                 ; RETURN
