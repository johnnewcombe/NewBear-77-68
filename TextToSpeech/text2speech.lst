   024B 26 04         [ 4]  188         BNE     LIGHT_OP        ; still at valid id so output idle message
   024D 7F 1A 22      [ 6]  189         CLR     LIGHT_MSG_ID    ; beyond last message so reset the current msg to zero
   0250 4F            [ 2]  190         CLRA                    ; set currentid back to 0
   0251                     191 LIGHT_OP:
