0686 ffc7 42                         FCB     'B
0687 ffc8 fd 62                      FDB     BLKMOV
0688 ffca 4d                         FCB     'M
0689 ffcb fe 43                      FDB     MODIFY
0690 ffcd 47                         FCB     'G
0691 ffce fe c2                      FDB     GO
0692 ffd0 43                         FCB     'C
0693 ffd1 fe d9                      FDB     CONTNU
0694 ffd3 44                         FCB     'D
0695 ffd4 ff 07                      FDB     DUMP
0696 ffd6 00                         FCB     0           ; terminator
0697 ffd7 ff 8f                      FDB     START       ; not used (any value ok after 0)
