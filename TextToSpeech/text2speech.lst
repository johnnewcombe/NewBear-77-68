                            262 ;END:     JMP     MAINLOOP  ;START   ; all done
                            263 
                            264 ;--------------------------------------------------------------
                            265 ; Gets the weight data from the scales and rerurns with carry
                            266 ; set if a valid reading, carry clear otherwise. A valid weight
                            267 ; reading resets the idle count. Data received is stored in
                            268 ; T_WEIGHT and MSB in A.
                            269 ;--------------------------------------------------------------
   0321                     270 GETDATA:
   0321 BD 03 AC      [ 9]  271         JSR     RD_XB           ; read 4 hex characters into X
   0324 FF 1B A9      [ 6]  272         STX     T_WEIGHT        ; store X
   0327 BD FC 76      [ 9]  273         JSR     STRING
   032A 44 52 3A 20         274         .fcc    "DR: "
   032E FF                  275         .fcb    0xff
   032F FE 1B A9      [ 5]  276         LDX     T_WEIGHT
   0332 BD FC BB      [ 9]  277         JSR     PRX             ; print the data
   0335 BD 04 2E      [ 9]  278         JSR    PR_CR
   0338 0C            [ 2]  279         CLC
   0339 B6 1B A9      [ 4]  280         LDAA    T_WEIGHT        ; get fist byte (stones)
   033C 27 04         [ 4]  281         BEQ     GDDONE          ; idle message
   033E 7F 00 2D      [ 6]  282         CLR     IDLE_TICS       ; not an idle message so reset the idle counter
   0341 0D            [ 2]  283         SEC                     ; non idle message return with carry set
   0342 39            [ 5]  284 GDDONE:  RTS
                            285 
                            286 ; -----------------------------------------------------
                            287 ; Print string FOLLOWING JSR ( terminated by 0xFF ) to
                            288 ; ACIA(b) and ACIA(b)
                            289 ; -----------------------------------------------------
   0343 30            [ 4]  290 STRINGB: TSX             ; Get loc. of return addr to X
   0344 EE 00         [ 6]  291          LDX     0,X     ; Get return addr to X
   0346 09            [ 4]  292          DEX             ; Point to byte before
   0347 08            [ 4]  293 STRB1:   INX             ; Point to next byte
   0348 A6 00         [ 5]  294          LDAA    0,X     ; Get byte to be printed
   034A 81 FF         [ 2]  295          CMPA    #0xFF    ; End-string ?
   034C 27 0E         [ 4]  296          BEQ     ENDSTR  ; Yes: Go to finish up
   034E F6 F0 FF      [ 4]  297          LDAB    PANEL
   0351 C5 01         [ 2]  298          BITB     #1
   0353 27 03         [ 4]  299          BEQ     STRB    ; panel switch 0 is debug and copies data to A
   0355 BD FC 0F      [ 9]  300          JSR     PR_A    ; Print the byte to ACIA(a) (A is maintained)
                            301                          ;  DEBUG depending on panel data switch zero
   0358 8D 47         [ 8]  302 STRB:    BSR     PR_B    ; Print the byte to ACIA(b)
   035A 20 EB         [ 4]  303          BRA     STRB1   ; Go back for next byte
   035C 31            [ 4]  304 ENDSTR:  INS             ; Clean up stack...
   035D 31            [ 4]  305          INS             ;  ( pop off the return addr )
   035E 6E 01         [ 4]  306          JMP     1,X     ; Jump back to caller (RETURN)
                            307 
                            308 ; -----------------------------------------------------
                            309 ; Prints a string pointed to by X
