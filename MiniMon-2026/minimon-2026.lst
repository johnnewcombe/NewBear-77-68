0626 ff6c 20 41 20                   FCC     " A "   ;
0627 ff6f 20 20 58                   FCC     "  X"   ;
0628 ff72 20 20 20                   FCC     "   "   ;
0629 ff75 20 50 43                   FCC     " PC"   ;
0630 ff78 20 20 20                   FCC     "   "   ;
0631 ff7b 53 50                      FCC     "SP"    ;
