0710 f0d3 8d 11              ASK_Addrs   BSR     ASK_Start
0711 f0d5 bd ec 76                       JSR     STRING   ; Print string...
0712 f0d8 20 53 74 6f 70 3a              FCC     " Stop:"
0713 f0de ff                             FCB     $FF         ; End-Of-String
0714 f0df bd ec 65                       JSR     RD_X        ; Read 4 digit HEX addr value
0715 f0e2 ff f0 db                       STX     d_STOP      ; Save it
0716 f0e5 39                             RTS                 ; RETURN
0717                         
0718 f0e6 bd ec 76           ASK_Start   JSR     STRING      ; Print string...
0719 f0e9 20 53 74 61 72 74              FCC     " Start:"
     3a
0720 f0f0 ff                             FCB     $FF         ; End-Of-String
0721 f0f1 bd ec 65                       JSR     RD_X        ; Read 4 digit HEX addr value
0722 f0f4 ff f0 e0                       STX     d_START     ; Save it
0723 f0f7 39                             RTS
