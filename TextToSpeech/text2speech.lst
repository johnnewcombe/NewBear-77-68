                             73 ; Data arrives at port B as four hex characters
                             74 ; -----------------------------------------------------
   0159 BD 02 A1      [ 9]   75                 JSR     GETDATA         ; value in T_WEIGHT, stones in A
   015C 25 03         [ 4]   76                 BCS     ML1             ; is it invalid i.e. carry clear
   015E 7E 01 F2      [ 3]   77                 JMP     IDLE
   0161 81 14         [ 2]   78 ML1:            CMPA    #TOO_HEAVY      ; more that 20 is too heavy
   0163 22 43         [ 4]   79                 BHI     OVERLOADED
   0165 B6 19 B9      [ 4]   80                 LDAA    T_WEIGHT+1      ; validate pounds
   0168 81 0D         [ 2]   81                 CMPA    #13             ; invalid pounds
   016A 22 65         [ 4]   82                 BHI     ERROR           ; error
   016C BD 02 19      [ 9]   83                 JSR     GREET           ; send a greeting message
                             84 
