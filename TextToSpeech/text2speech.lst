                            216         ;JSR     PR_DEC          ; puts 3 decimal digits in DEC, DEC+1 and DEC+2
                            217         ;LDAA    DEC+1           ; don't care about the hundreds        ADDA    #0x30
                            218         ;JSR     PR_WORD
                            219         ;JSR     PR_SPCB
