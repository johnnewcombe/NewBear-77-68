                             78 ; -----------------------------------------------------
                             79 ; Data arrives at port B as four hex characters
                             80 ; -----------------------------------------------------
   0166 BD 02 B7      [ 9]   81                 JSR     GETDATA         ; value in T_WEIGHT, stones in A
   0169 25 03         [ 4]   82                 BCS     ML1             ; is it invalid i.e. carry clear
   016B 7E 02 02      [ 3]   83                 JMP     IDLE
   016E 7D 1A 21      [ 6]   84 ML1:            TST     PROCESSING_FLG  ; are we already processing a weight
   0171 26 F3         [ 4]   85                 BNE     MAINLOOP        ; flag non-zero so ignore everything that follows
   0173 7C 1A 21      [ 6]   86                 INC     PROCESSING_FLG  ; ignore any following data until we next idle
   0176 81 14         [ 2]   87                 CMPA    #TOO_HEAVY      ; more that 20 is too heavy
   0178 22 3E         [ 4]   88                 BHI     OVERLOADED
   017A B6 1A 19      [ 4]   89                 LDAA    T_WEIGHT+1      ; validate pounds
   017D 81 0D         [ 2]   90                 CMPA    #13             ; invalid pounds
   017F 22 60         [ 4]   91                 BHI     ERROR           ; error
   0181 BD 02 2C      [ 9]   92                 JSR     GREET           ; send a greeting message
