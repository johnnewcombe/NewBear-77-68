                            194 ; get address of message in X from the pointer in X
   0238 A6 00         [ 5]  195         LDAA    0,X             ;  get high byte of word pointed to by X
   023A E6 01         [ 5]  196         LDAB    1,X             ;  get low byte of word pointed to by X
   023C B7 19 4F      [ 5]  197         STAA    TEMP
   023F F7 19 50      [ 5]  198         STAB    TEMP+1
   0242 FE 19 4F      [ 5]  199         LDX     TEMP
