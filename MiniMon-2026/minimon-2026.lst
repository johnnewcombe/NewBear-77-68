0575                         ; ============================================================================
0576                         ; This is the new load and save routines to be integrated into this monitor
0577                         ; this will need to relocated to fit in the original Load and Punch routines
0578                         ;=============================================================================
0579                         ; Spare bytes: FDE2=81, EEE8=23
0580                         ; Total= 114
0581                         
0582                         ; -----------------------------------------------------
0583                         ; S format data output : Modded version of Mikbug code
0584                         ;
0585 efdf                    CMD_P       EQU     *           ; P = Punch : Output an S19 file
0586 efdf bd ec 89                       JSR     GETADD      ; Prompt for "Start:","Stop:"
0587 efe2 fe f0 ef                       LDX     T_STRT     ; Get start address
0588 efe5 ff f0 de                       STX     d_TW        ; save it to work area
0589 efe8 b6 f0 f2           .fOut1      LDAA    T_STOP+1    ; get low order of end address
0590 efeb b0 f0 df                       SUBA    d_TW+1      ; Subtract low order start
0591 efee f6 f0 f1                       LDAB    T_STOP      ; ( carry not affected by LDA )
0592 eff1 f2 f0 de                       SBCB    d_TW        ; Subtract with Carry
0593 eff4 26 04                          BNE     .fOut2
0594 eff6 81 10                          CMPA    #16
0595 eff8 25 02                          BCS     .fOut3
0596 effa 86 0f              .fOut2      LDAA    #15
0597 effc 8b 04              .fOut3      ADDA    #4
0598 effe b7 f0 e1                       STAA    b_Count     ; FRAME COUNT THIS RECORD
0599 f001 80 03                          SUBA    #3
0600 f003 b7 f0 e2                       STAA    b_Temp      ; BYTE COUNT THIS RECORD
0601 f006 bd ec 76                       JSR     STRING      ; Output this string...
0602 f009 0d 0a                          FCB     $0D,$0A       ; c/r l/f
0603 f00b 53 31                          FCB     'S,'1       ; S1
0604 f00d ff                             FCB     $FF         ; End-Of-String
0605 f00e 5f                             CLRB                ; Clear checksum
0606                         
0607                         ; Output frame count...
0608 f00f ce f0 e1                       LDX     #b_Count    ; X = Address of Framecount
0609 f012 8d 26                          BSR     .fOutHx2    ; O/P byte <-X and inc X
0610                         
0611                         ; Output address...
0612 f014 ce f0 de                       LDX     #d_TW
0613 f017 8d 21                          BSR     .fOutHx2    ; O/P byte <-X and inc X
0614 f019 8d 1f                          BSR     .fOutHx2    ; O/P byte <-X and inc X
0615                         
0616                         ; Output data...
0617 f01b fe f0 de                       LDX     d_TW
0618 f01e 8d 1a              .fOut4      BSR     .fOutHx2    ; O/P byte <-X and inc X
0619 f020 7a f0 e2                       DEC     b_Temp      ; Decrement `bytes left` count
0620 f023 26 f9                          BNE     .fOut4      ; Loop back if any left
0621 f025 ff f0 de                       STX     d_TW
0622 f028 53                             COMB
0623 f029 37                             PSHB
0624 f02a 30                             TSX                 ; X = S + 1
0625 f02b 8d 0d                          BSR     .fOutHx2    ; PUNCH CHECKSUM
0626 f02d 33                             PULB
0627 f02e fe f0 de                       LDX     d_TW
0628 f031 09                             DEX
0629 f032 bc f0 f1                       CPX     T_STOP
0630 f035 26 b1                          BNE     .fOut1
0631                         
0632                         ;x          JSR     PR_STRING   ; Output `S9` record...
0633                         ;x          FCB     C_CR,C_LF   ; c/r l/f
0634                         ;x          FCB     'S,'9       ; S9 = <eof>
0635                         ;x          FCB     C_EOS       ; End-Of-String
0636                         
0637 f037 bd ed 23                       JSR     STARTS      ;Go to START (via `S` code)
0638                         
0639                         ;- - - - - - - - - - - - - - - - - - - - - - - - -
0640                         ; 1) Update checksum
0641                         ; 2) Output byte pointed to by X as 2 x hex chars
0642                         ; 3) Increment X
0643                         ;
0644 f03a eb 00              .fOutHx2    ADDB    0,X         ; Update checksum
0645 f03c 36                             PSHA                ; Push A to STACK
0646 f03d a6 00                          LDAA    0,X         ; Load byte to be o/p
0647 f03f bd ec c9                       JSR     ZOUT        ; O/P byte <- X
0648 f042 32                             PULA                ; Pull A off STACK
0649 f043 08                             INX                 ; Increment X
0650 f044 39                             RTS                 ; RETURN
