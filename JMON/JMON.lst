0663                         ; FF8C
0664                         ; -----------------------------------------------------
0665 ff8c bf f0 fd           SWI     STS     PSTACK  ; Save callers stack pointer
0666                         
0667                         ; -----------------------------------------------------
0668                         ; FF8F
0669                         ; -----------------------------------------------------
0670 ff8f 8e f0 d0           START   LDS     #STACK  ; Set up stack for MINMON
0671 ff92 8d 54                      BSR     SETACIA ; Set up ACIAs
0672 ff94 bd fc 76                   JSR     STRING  ; Print string...
0673 ff97 0d 0a 00 2a                FCB     $0D,$0A,$00,'*    ; c/r l/f null `*`
0674 ff9b ff                         FCB     $FF     ; End-of-string
0675 ff9c bd fc 00                   JSR     RD_CMD  ; Read a byte (test for `.`)
0676 ff9f ce ff b5                   LDX     #CMDTAB ; point to command table
0677 ffa2 e6 00              CMDLP   LDAB    0,X     ; B = key byte (0 ends table)
0678 ffa4 27 e9                      BEQ     START   ; end of table → default to START
0679 ffa6 11                         CBA             ; compare A vs B
0680 ffa7 27 05                      BEQ     FOUND   ; match → dispatch
0681 ffa9 08                         INX             ; skip key
0682 ffaa 08                         INX             ; skip FDB high
0683 ffab 08                         INX             ; skip FDB low
0684 ffac 20 f4                      BRA      CMDLP  ; try next entry
0685                         
0686 ffae e6 01              FOUND   LDAB    1,X     ; B = target high byte (FDB stores high,low)
0687 ffb0 a6 02                      LDAA    2,X     ; A = target low byte
0688 ffb2 36                         PSHA            ; push high first
0689 ffb3 37                         PSHB            ; push low — now low is on top of stack
0690 ffb4 39                         RTS             ; jump to target
0691                         
0692                         ; This can probably be removed...
0693                         ;.DEFAULT JMP     START ; unknown command → ignore
0694                         
0695                         ; Command table: key, then FDB routine
0696 ffb5 53                 CMDTAB  FCB     'S
0697 ffb6 ff 39                      FDB     BRPTSET
0698 ffb8 48                         FCB     'H
0699 ffb9 ff 63                      FDB     HEADER
0700 ffbb 50                         FCB     'P
0701 ffbc fd e2                      FDB     PUNCH
0702 ffbe 4c                         FCB     'L
0703 ffbf fc e3                      FDB     LOAD
0704 ffc1 52                         FCB     'R
0705 ffc2 fd 36                      FDB     REGPRT
0706 ffc4 4d                         FCB     'M
0707 ffc5 fe 43                      FDB     MODIFY
0708 ffc7 47                         FCB     'G
0709 ffc8 fe c2                      FDB     GO
0710 ffca 43                         FCB     'C
0711 ffcb fe d9                      FDB     CONTNU
0712 ffcd 44                         FCB     'D
0713 ffce ff 07                      FDB     DUMP
0714 ffd0 54                         FCB     'T'
0715 ffd1 fd 62                      FDB     MEMTEST
0716 ffd3 00                         FCB     0       ; terminator
0717 ffd4 ff 8f                      FDB     START   ; not used (any value ok after 0)
0718                         
0719                         ; Transmit an address '0000' S9 terminating record
0720 ffd6 bd fc 76           STERMS  JSR     STRING
0721 ffd9 0d 0a                      FCB     $0D,$0A
0722 ffdb 53 39 30 33 30 30          FCC     "S9030000FC"
     30 30 46 43
0723 ffe5 ff                         FCB     $FF
0724 ffe6 20 a7                      BRA     START
0725                         
0726                         ; Reset the ACIAs
0727 ffe8 86 11              SETACIA LDAA    #$11    ; 8 Data, No Parity, 2 Stop Bits
0728 ffea b7 f4 01                   STAA    CTRLA   ;   ACIA.A
0729 ffed 86 01                      LDAA     #$01    ; 7 Data, Even Parity, 2 Stop Bits
0730 ffef b7 f4 03                   STAA     CTRLB   ;   ACIA.B
0731 fff2 39                         RTS
0732                         
