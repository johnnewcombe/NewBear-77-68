                            103 
                            104                 ; output a comments
   0196 B6 1B 18      [ 4]  105                 LDAA    T_WEIGHT        ; stones
   0199 81 0F         [ 2]  106                 CMPA    #SHEAVY_WGHT
   019B 25 03         [ 4]  107                 BLO     ML2             ; not super heavy weight
   019D 7E 02 5A      [ 3]  108                 JMP     SHEAVYW
   01A0 81 0D         [ 2]  109 ML2:            CMPA    #HEAVY_WGHT
   01A2 25 03         [ 4]  110                 BLO     ML3             ; not heavy weight
   01A4 7E 02 43      [ 3]  111                 JMP     HEAVYW
   01A7 81 0A         [ 2]  112 ML3:            CMPA    #NORM_WGHT
   01A9 25 03         [ 4]  113                 BLO     ML4             ; not normal weight
   01AB 7E 02 2C      [ 3]  114                 JMP     NORMALW
   01AE 81 06         [ 2]  115 ML4:            CMPA    #LIGHT_WGHT
   01B0 25 03         [ 4]  116                 BLO     ML5             ; not light weight
   01B2 7E 02 15      [ 3]  117                 JMP     LIGHTW
   01B5 7E 01 66      [ 3]  118 ML5:            JMP     MAINLOOP        ; no comments for less than light weight
                            119 
                            120 ; -----------------------------------------------------
                            121 ; Over 20 stone so random heavy phrase to ports B
                            122 ; -----------------------------------------------------
   01B8                     123 OVERLOADED:
   01B8 CE 1A BA      [ 3]  124                 LDX     #MTOOHEAVY1
   01BB BD 03 A5      [ 9]  125                 JSR     PR_PHRASE
   01BE BD 03 8B      [ 9]  126                 JSR     PR_CRB
   01C1 BD 1A D7      [ 9]  127                 JSR     PANEL_DISP
   01C4 7E 01 66      [ 3]  128                 JMP     MAINLOOP
   01C7                     129 IERROR:
   01C7 CE 1A D0      [ 3]  130                 LDX     #MERROR
   01CA BD 03 A5      [ 9]  131                 JSR     PR_PHRASE
   01CD BD 03 8B      [ 9]  132                 JSR     PR_CRB
   01D0 BD 1A D7      [ 9]  133                 JSR     PANEL_DISP
   01D3 7E 01 66      [ 3]  134                 JMP     MAINLOOP
                            135 
                            136 ; we cycle thought idle message when no one is on the scales, data comes in a one
                            137 ; second intervals so we simply increase the idle count until it's time to display
                            138 ; the next idle message
                            139 
   01D6 7F 1B 21      [ 6]  140 IDLE:   CLR     PROCESSING_FLG  ; clear the processing flag as no one
                            141                                 ;   is standing on the scales
   01D9 7C 1B 1A      [ 6]  142         INC     IDLE_COUNT      ; increase the idle count
   01DC B6 1B 1A      [ 4]  143         LDAA    IDLE_COUNT      ; see if idle count = max idle time
   01DF 81 2D         [ 2]  144         CMPA    #IDLE_TICS      ; a data message appears every second
   01E1 27 03         [ 4]  145         BEQ     IDLE1           ; not reached the max idle time
   01E3 7E 01 66      [ 3]  146         JMP     MAINLOOP             ; nothing to do yet
                            147 
   01E6 7F 1B 1A      [ 6]  148 IDLE1:   CLR     IDLE_COUNT      ; time to output an idle message so reset the count
   01E9 B6 1B 1B      [ 4]  149         LDAA    IDLE_MSG_ID     ; get next Message ID
   01EC 81 19         [ 2]  150         CMPA    #IDLE_MSG_CNT   ; are we beyond the end of the list
   01EE 26 04         [ 4]  151         BNE     IDLE_OP         ; still at valid id so output idle message
   01F0 7F 1B 1B      [ 6]  152         CLR     IDLE_MSG_ID     ; beyond last message so reset the current msg to zero
   01F3 4F            [ 2]  153         CLRA                    ; set currentid back to 0
   01F4                     154 IDLE_OP:
   01F4 7C 1B 1B      [ 6]  155         INC     IDLE_MSG_ID     ; set to next message for the next next time
   01F7 CE 12 29      [ 3]  156         LDX     #IDLEPTR        ; A has phrase ID, set X to the base address
   01FA BD 02 70      [ 9]  157         JSR     PHRASE_OUT
