output:  memtest_v2.s19
0001                         ;------------------------------------------------------------------
0002                         ; memtest_comprehensive.asm
0003                         ;
0004                         ; A comprehensive memory test for the MC6800.
0005                         ;
0006                         ; Tests included:
0007                         ; 1. Data Bus Test (Walking 1s) - Checks for stuck bits or shorts.
0008                         ; 2. Address Bus Test - Checks for address aliasing.
0009                         ; 3. Pattern Test (Checkerboard) - Checks for cell interference (0x55, 0xAA).
0010                         ;
0011                         ; Requires MINIMON/JMON for I/O routines.
0012                         ;
0013                         ; Load and run from F000:
0014                         ; G F000
0015                         ;------------------------------------------------------------------
0016                         
0017                         ; MINIMON/JMON Variables (RAM)
0018 f0ef                    T_STRT  EQU $F0EF ; Temp storage for GETADD (Start Address)
0019 f0f1                    T_STOP  EQU $F0F1 ; Temp storage for GETADD (End Address + 1)
0020 f0d3                    T_TEMP  EQU $F0D3 ; Use T_TEMP from JMON area
0021                         
0022                         ; MINIMON/JMON routines (ROM)
0023 fc76                    STRING  EQU $FC76 ; Prints a string following JSR, ends with $FF.
0024 fc89                    GETADD  EQU $FC89 ; Prompt for "S <addr> F <addr>"
0025 fcc9                    ZOUT    EQU $FCC9 ; Print value in A as 2 hex digits.
0026 fcbb                    PRX     EQU $FCBB ; Print value in X as 4 hex digits.
0027 fd4d                    PRSP    EQU $FD4D ; Print a space.
0028 fe97                    NEWLINE EQU $FE97 ; Prints a new line.
0029 ff8f                    START   EQU $FF8F ; Restarts Monitor.
0030                         
0031 f000                            ORG $F000
0032                         
0033 f000 bd fc 76           MAIN    JSR     STRING
0034 f003 0d 0a                      FCB     $0D, $0A
0035 f005 4d 45 4d 54 45 53          FCC     "MEMTEST V2"
     54 20 56 32
0036 f00f 0d 0a ff                   FCB     $0D, $0A, $FF
0037                                 
0038 f012 bd fc 89                   JSR     GETADD      ; Get start and finish addresses
0039                                 
0040                                 ; 1. Data Bus Test (at T_STRT address)
0041 f015 bd fc 76                   JSR     STRING
0042 f018 0d 0a                      FCB     $0D, $0A
0043 f01a 44 3a                      FCC     "D:"
0044 f01c ff                         FCB     $FF
0045                         
0046 f01d fe f0 ef                   LDX     T_STRT
0047 f020 86 01                      LDAA    #$01        ; Start with bit 0
0048 f022 a7 00              .DATALP STAA    0,X         ; Write pattern
0049 f024 a1 00                      CMPA    0,X         ; Read back
0050 f026 26 4b                      BNE     .D_ERR      ; Failed
0051 f028 48                         ASLA                ; Shift to next bit
0052 f029 26 f7                      BNE     .DATALP     ; Loop until all 8 bits tested
0053 f02b bd f0 9e                   JSR     PROK
0054                         
0055                                 ; 2. Address Bus Test
0056 f02e bd fc 76                   JSR     STRING
0057 f031 41 3a                      FCC     "A:"
0058 f033 ff                         FCB     $FF
0059                                 
0060                                 ; Fill memory with its own low-byte address
0061 f034 fe f0 ef                   LDX     T_STRT
0062 f037 ff f0 d3           .ADRFL  STX     T_TEMP      ; X -> RAM (Big Endian: T_TEMP=High, T_TEMP+1=Low)
0063 f03a b6 f0 d4                   LDAA    T_TEMP+1    ; Get low byte of address
0064 f03d a7 00                      STAA    0,X         ; Store low byte of address at that address
0065 f03f 08                         INX
0066 f040 bc f0 f1                   CPX     T_STOP
0067 f043 26 f2                      BNE     .ADRFL
0068                                 
0069                                 ; Verify
0070 f045 fe f0 ef                   LDX     T_STRT
0071 f048 ff f0 d3           .ADRVF  STX     T_TEMP
0072 f04b b6 f0 d4                   LDAA    T_TEMP+1    ; Expected
0073 f04e a1 00                      CMPA    0,X
0074 f050 26 21                      BNE     .A_ERR
0075 f052 08                         INX
0076 f053 bc f0 f1                   CPX     T_STOP
0077 f056 26 f0                      BNE     .ADRVF
0078 f058 bd f0 9e                   JSR     PROK
0079                         
0080                                 ; 3. Checkerboard Test (0x55 then 0xAA)
0081 f05b bd fc 76                   JSR     STRING
0082 f05e 43 3a                      FCC     "C:"
0083 f060 ff                         FCB     $FF
0084                                 
0085 f061 86 55                      LDAA    #$55        ; First pattern
0086 f063 8d 1c                      BSR     DO_PATT
0087 f065 25 0c                      BCS     .C_ERR
0088                                 
0089 f067 86 aa                      LDAA    #$AA        ; Second pattern
0090 f069 8d 16                      BSR     DO_PATT
0091 f06b 25 06                      BCS     .C_ERR
0092                                 
0093 f06d bd f0 9e                   JSR     PROK
0094                         
0095 f070 7e ff 8f                   JMP     START
0096                         
0097                         ; --- Error Handlers ---
0098                         
0099                         .D_ERR
0100                                 ;JSR     STRING
0101                                 ;FCC     "FAIL AT "
0102                                 ;FCB     $FF
0103                                 ;BRA     SHOW_ERR
0104                         
0105                         .A_ERR
0106                                 ;JSR     STRING
0107                                 ;FCC     "FAIL AT "
0108                                 ;FCB     $FF
0109                                 ;BRA     SHOW_ERR
0110                         
0111                         .C_ERR
0112                                 ;JSR     STRING
0113                                 ;FCC     "FAIL AT "
0114                                 ;FCB     $FF
0115                                 ; fall through
0116                         
0117                         SHOW_ERR
0118 f073 bd fc bb                   JSR     PRX         ; Print address in X
0119 f076 bd fd 4d                   JSR     PRSP
0120 f079 a6 00                      LDAA    0,X         ; Get actual value
0121 f07b bd fc c9                   JSR     ZOUT        ; Print it
0122 f07e 7e ff 8f                   JMP     START
0123                         
0124                         ; --- Subroutines ---
0125                         
0126                         ; DO_PATT: Fill memory with A, then verify. 
0127                         ; Returns C=1 on failure, X=failure address.
0128 f081 16                 DO_PATT TAB                 ; Save pattern in B
0129 f082 fe f0 ef                   LDX     T_STRT
0130 f085 a7 00              .P_FILL STAA    0,X
0131 f087 08                         INX
0132 f088 bc f0 f1                   CPX     T_STOP
0133 f08b 26 f8                      BNE     .P_FILL
0134                                 
0135 f08d fe f0 ef                   LDX     T_STRT
0136 f090 e1 00              .P_VERI CMPB    0,X         ; Compare with pattern in B
0137 f092 26 08                      BNE     .P_FAIL
0138 f094 08                         INX
0139 f095 bc f0 f1                   CPX     T_STOP
0140 f098 26 f6                      BNE     .P_VERI
0141 f09a 0c                         CLC                 ; Success
0142 f09b 39                         RTS
0143 f09c 0d                 .P_FAIL SEC                 ; Failure
0144 f09d 39                         RTS
0145                         
0146 f09e bd fc 76           PROK    JSR     STRING
0147 f0a1 4f 4b 20                   FCC     "OK "
0148 f0a4 ff                         FCB     $FF
0149 f0a5 39                         RTS
