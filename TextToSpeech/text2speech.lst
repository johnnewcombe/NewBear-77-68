0003                         ;------------------------------------------------------------------
0004                         
0005                         ; 7768 ACIA
0006 f400                    DATAA   EQU $F400 ; ACIA(a) Data register
0007 f401                    CTRLA   EQU $F401 ; ACIA(a) Ctrl/Status
0008 f402                    DATAB   EQU $F402 ; ACIA(b) Data register
0009 f403                    CTRLB   EQU $F403 ; ACIA(b) Ctrl/Status
0010                         
0011                         ; MINIMON routines
0012 fc76                    STRING  EQU $FC76 ; Prints a string. The string should follow JSR and be terminated with $FF.
0013 fc89                    GETADD  EQU $FC89 ; Get Address, read 4 digit hex value.
0014 fcc9                    ZOUT    EQU $FCC9 ; Print value in A as 2 hex digits.
0015 fe97                    NEWLINE EQU $FE97 ; Prints a new line.
0016 ff8f                    START   EQU $FF8F ; Restarts MniMon.
0017 fc0f                    PR_A    EQU $FC0F ; Print char in A to ACIA (a)
0018 fd2b                    RD_A    EQU $FD2B ; Read char from A
0019 fd4d                    PRSP    EQU $FD4D ; Print a space
0020 fc31                    BINARY  EQU $FC31 ; Converts ASCII hex digits in A and B to binary?
0021 fc65                    RD_X    EQU $FC65 ; Read 4 hex digits Value from ACIA(a) and put value into X.
0022 fc1d                    VHEX    EQU $FC1D ; Checks that A contains a HEX character
0023 0200                    	    ORG $0200
0024                         
0025                         ; initialise serial port B
0026 0200 86 11              TX2SP   LDAA    #$11    ; 8 Data, No Parity, 2 Stop Bits
0027 0202 b7 f4 03                   STAA    CTRLB   ;   ACIA.A
0028                         
0029                         MAINLOOP:
0030                         ; -----------------------------------------------------
0031                         ; Data arrives at port B as four hex characters
0032                         ; -----------------------------------------------------
0033 0205 bd 02 b2                   JSR     RD_XB           ; read 4 hex characters into X
0034 0208 ff 04 44                   STX     TEMP            ; store X
0035                         
0036                                 ; -----------------------------------------------------
0037                                 ; hello message "My name is MARVIN"
0038                                 ; -----------------------------------------------------
0039 020b 86 01                      LDAA    #$01            ; load phrase number (PTR)
0040 020d bd 03 09                   JSR     PR_PHRASE
0041 0210 bd 02 f6                   JSR     PR_CRB
0042                                 ; -----------------------------------------------------
0043                         
0044 0213 b6 04 44                   LDAA    TEMP            ; get fist byte (stones)
0045 0216 81 14                      CMPA    #20             ; more that 20 is too heavey
0046 0218 22 14                      BHI     TOHEAVY         ; say something rude
0047 021a b6 04 45                   LDAA    TEMP+1          ; get pounds
0048 021d 81 0d                      CMPA    #13             ; invalid pounds
0049 021f 22 0e                      BHI     ERROR           ; error
0050                         
0051                                 ; all good so output the weight mesage
0052 0221 86 00                      LDAA    #0              ; output the 'you weigh' phrase
0053 0223 bd 03 09                   JSR     PR_PHRASE       ; output phrase specified in A
0054 0226 fe 04 44                   LDX     TEMP            ; restore X
0055 0229 bd 02 c0                   JSR     PR_WEIGHT       ; weight back X so output the weight
0056                         
0057 022c 20 01                      BRA     END
0058                         
0059                         ; -----------------------------------------------------
0060                         ; Over 20 stone so random heavy phrase to ports B
0061                         ; -----------------------------------------------------
0062                         TOHEAVY
0063 022e 3f                         SWI
0064                         ERROR
0065                         
0066                         END
0067 022f ce 03 8d                   LDX     #MYNAME
0068 0232 bd 03 09                   JSR     PR_PHRASE
0069 0235 7e 02 05                   JMP     MAINLOOP  ;START   ; all done
