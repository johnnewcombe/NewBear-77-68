0097                         ;--------------------------------------------------------------
0098                         ; DECIMAL CONVERSION EXAMPLE
0099                         ;--------------------------------------------------------------
0100                                 ;JSR     PR_DEC          ; puts 3 decimal digits in DEC, DEC+1 and DEC+2
0101                                 ;LDAA    DEC+1           ; don't care about the hundreds        ADDA    #$30
0102                                 ;JSR     PR_WORD
0103                                 ;JSR     PR_SPCB
0104                                 ;LDAA    DEC+2
0105                                 ;JSR     PR_WORD
0106                         
0107                         ; -----------------------------------------------------
0108                         ; PR_DEC: Puts 3 decimal digits in DEC, DEC+1 and DEC+2
0109                         ;
0110                         ;       !! ONLY WORKS WITH VALUES BELOW 128 !!
0111                         ; -----------------------------------------------------
0112 0235 5f                 PR_DEC  CLRB            ; Clear B for hundreds
0113                         
0114 0236 81 64              HUND    CMPA    #100    ; 100 or more?
0115                         
0116 0238 2d 05                      BLT     TENS
0117 023a 80 64                      SUBA    #100    ; Sub 100
0118 023c 5c                         INCB            ; Increment hundred counter
0119 023d 20 f7                      BRA     HUND
0120                         
0121 023f f7 05 c8           TENS    STAB    DEC     ; store the hundreds
0122                         
0123 0242 5f                         CLRB
0124 0243 81 0a              TENS1   CMPA    #10     ; 10 or more?
0125 0245 2d 05                      BLT     UNITS
0126 0247 80 0a                      SUBA    #10     ; Sub 10
0127 0249 5c                         INCB            ; Increment ten counter
0128 024a 20 f7                      BRA     TENS1
0129                         
0130 024c f7 05 c9           UNITS   STAB    DEC+1
0131 024f b7 05 ca                   STAA    DEC+2   ; Final remainder is units
0132                         
0133 0252 39                         RTS
0134                         
0135                         
0136                         ; -----------------------------------------------------
0137                         ; Print string FOLLOWING JSR ( terminated by $FF ) to
0138                         ; ACIA(b) and ACIA(b)
0139                         ; -----------------------------------------------------
0140 0253 30                 STRINGB TSX             ; Get loc. of return addr to X
0141 0254 ee 00                      LDX     0,X     ; Get return addr to X
0142 0256 09                         DEX             ; Point to byte before
0143 0257 08                 AGAIN   INX             ; Point to next byte
0144 0258 a6 00                      LDAA    0,X     ; Get byte to be printed
0145 025a 81 ff                      CMPA    #$FF    ; End-string ?
0146 025c 27 07                      BEQ     ENDSTR  ; Yes: Go to finish up
0147 025e bd fc 0f                   JSR     PR_A    ; Print the byte to ACIA(a) (A is maintained)
0148 0261 8d 40                      BSR     PR_B    ; Print the byte to ACIA(b)
0149 0263 20 f2                      BRA     AGAIN   ; Go back for next byte
0150 0265 31                 ENDSTR  INS             ; Clean up stack...
0151 0266 31                         INS             ;  ( pop off the return addr )
0152 0267 6e 01                      JMP     1,X     ; Jump back to caller (RETURN)
0153                         
0154                         ; -----------------------------------------------------
0155                         ; Prints a string pointed to by X
0156                         ; -----------------------------------------------------
0157 0269 a6 00              STRINGBX    LDAA    0,X         ; get char
0158 026b 81 ff                          CMPA    #$FF        ; is character NULL?
0159 026d 27 08                          BEQ     DONEB       ; yes, end of string
0160 026f bd fc 0f                       JSR     PR_A        ; Print the byte to ACIA(a) (A is maintained)
0161 0272 8d 2f                          BSR     PR_B        ; Print the byte to ACIA(b)
0162 0274 08                             INX
0163 0275 20 f2                          BRA     STRINGBX
0164 0277 39                 DONEB       RTS
0165                         
0166                         ; -----------------------------------------------------
0167                         ; Reads a character from ACIA(b) into A
0168                         ; -----------------------------------------------------
0169 0278 7c 05 cb           RD_B    INC     RND         ; simple way to get a random number
0170 027b b6 f4 03                   LDAA    CTRLB       ; Get ACIA.A status byte
0171 027e 85 01                      BITA    #01         ; Is byte ready in DATAb
0172 0280 27 f6                      BEQ     RD_B        ; No: Try again
0173 0282 b6 f4 02                   LDAA    DATAB       ; Get the data byte to A
0174 0285 84 7f                      ANDA    #$7F        ; Mask off parity bit if it exists
0175 0287 39                         RTS                 ; RETURN
0176                         
0177                         ; -----------------------------------------------------
0178                         ;
0179                         ; -----------------------------------------------------
0180 0288 8d ee              ZINB    BSR     RD_B    ; Read a character
0181 028a bd fc 1d                   JSR     VHEX    ; Is it a hex character ?
0182 028d 25 12                      BCS     Z_PRQM  ; No: go to print `?`
0183 028f b7 05 bf                   STAA    T_Q     ; Yes: Save Acc.A
0184 0292 8d e4                      BSR     RD_B    ; Read 2nd character
0185 0294 bd fc 1d                   JSR     VHEX    ; Is it a hex character ?
0186 0297 25 08                      BCS     Z_PRQM  ; No: go to print `?`
0187 0299 16                         TAB             ; Yes: Put it into Acc.B
0188 029a b6 05 bf                   LDAA    T_Q     ; Retrieve 1st hex char to Acc.A
0189 029d bd fc 31                   JSR     BINARY  ; Convert A:B to binary
0190 02a0 39                         RTS             ; RETURN
0191                         Z_PRQM  ;LDAA    #'?     ; Load `?` into A
0192                                 ;BSR     PR_B    ; Print it
0193 02a1 20 e5                      BRA     ZINB    ; Go back to start of hex input
0194                         
0195                         ; -----------------------------------------------------
0196                         ; Print character in A to ACIA(b)
0197                         ; -----------------------------------------------------
0198 02a3 f6 f4 03           PR_B    LDAB    CTRLB   ; Get ACIA(a) status byte
0199 02a6 c5 02                      BITB    #02     ; Is it busy ?
0200 02a8 27 f9                      BEQ     PR_B    ; Yes: Try again
0201 02aa b7 f4 02                   STAA    DATAB   ;  No: Send data
0202 02ad 39                 PRB_END RTS             ; RETURN
0203                         
0204                         ; -----------------------------------------------------
0205                         ; Read 4 hex digits and put value into X
0206                         ; -----------------------------------------------------
0207 02ae 8d d8              RD_XB   BSR     ZINB    ; Read 2 digit hex value into A
0208 02b0 b7 05 c0                   STAA    T_Z     ; Save byte (most significant)
0209 02b3 8d d3                      BSR     ZINB    ; Read 2 digit hex value into A
0210 02b5 b7 05 c1                   STAA    T_Z+1   ; Save byte (least significant)
0211 02b8 fe 05 c0                   LDX     T_Z     ; Load full 4 hex value into X
0212 02bb 39                         RTS             ; RETURN
0213                         
0214                         ; -----------------------------------------------------
0215                         ; Prints the message " n stones n pounds"
0216                         ; place stones in MSB of X and pound in LSB
0217                         ; -----------------------------------------------------
0218                         PR_WEIGHT
0219 02bc ff 05 c6                   STX     T_W
0220 02bf b6 05 c6                   LDAA    T_W             ; Load high byte of X into Accumulator A
0221 02c2 bd 03 41                   JSR     PR_WORD         ; n
0222 02c5 bd 02 e2                   JSR     PR_SPCB
0223 02c8 86 1b                      LDAA    #$1B
0224 02ca bd 03 41                   JSR     PR_WORD         ; "stones"
0225 02cd bd 02 e2                   JSR     PR_SPCB
0226 02d0 b6 05 c7                   LDAA    T_W+1            ; Load high byte of X into Accumulator A
0227 02d3 bd 03 41                   JSR     PR_WORD         ; n
0228 02d6 86 1c                      LDAA    #$1C
0229 02d8 bd 02 e2                   JSR     PR_SPCB
0230 02db bd 03 41                   JSR     PR_WORD         ; "pounds"
0231 02de bd 02 ed                   JSR     PR_CRB
0232 02e1 39                         RTS
0233                         
0234                         ; -----------------------------------------------------
0235                         ; Prints a space on both consoles (preserves A)
0236                         ; -----------------------------------------------------
0237 02e2 36                 PR_SPCB   PSHA
0238 02e3 86 20                      LDAA    #$20        ; Put space character in A
0239 02e5 bd fc 0f                   JSR     PR_A
0240 02e8 bd 02 a3                   JSR     PR_B        ; Print it
0241 02eb 32                         PULA
0242 02ec 39                         RTS                 ; RETURN
0243                         
0244                         ; -----------------------------------------------------
0245                         ; Prints a CRLF on both consoles (preserves A)
0246                         ; -----------------------------------------------------
0247 02ed 36                 PR_CRB  PSHA
0248 02ee 86 0d                      LDAA    #$0D        ; Put CHAR character in A
0249 02f0 bd fc 0f                   JSR     PR_A
0250 02f3 bd 02 a3                   JSR     PR_B        ; Print it
0251 02f6 86 0a                      LDAA    #$0A
0252 02f8 bd fc 0f                   JSR     PR_A
0253 02fb bd 02 a3                   JSR     PR_B        ; Print it
0254 02fe 32                         PULA
0255 02ff 39                         RTS                 ; RETURN
0256                         
0257                         ; -----------------------------------------------------
0258                         ; Outputs a phrase from the value in A
0259                         ; -----------------------------------------------------
0260                         
0261                         PR_PHRASE
0262 0300 a6 00                      LDAA    0,X         ; get word id
0263 0302 08                         INX                 ; point X to next word
0264 0303 ff 05 c4                   STX     T_P         ; store X away
0265 0306 81 00                      CMPA    #0
0266 0308 27 0b                      BEQ     PR_END      ; no more words
0267 030a bd 03 41                   JSR     PR_WORD     ; print word based on value in A
0268 030d bd 02 e2                   JSR     PR_SPCB
0269 0310 fe 05 c4                   LDX     T_P        ; recover X
0270                         
0271 0313 20 eb                      BRA     PR_PHRASE   ; next word
0272 0315 39                 PR_END  RTS
0273                         
0274                         
0275                         PR_PHRASE_OLD
0276 0316 4c                         INCA
0277 0317 ce 03 5d                   LDX     #PHRASEPTR  ; load address of phrase ponter
0278                                                     ; table
0279 031a 4a                 PR_PH1  DECA                ; loop through A times to get
0280 031b 27 04                      BEQ     FOUNDP      ;   address of phrase
0281 031d 08                         INX                 ; move to next address
0282 031e 08                         INX
0283 031f 20 f9                      BRA     PR_PH1      ; try again
0284                         
0285 0321 a6 00              FOUNDP  LDAA    0,X         ; transfer addr pointed to by X to memory
0286 0323 b7 05 c4                   STAA    T_P         ; MSB
0287 0326 a6 01                      LDAA    1,X         ;
0288 0328 b7 05 c5                   STAA    T_P+1       ; LSB
0289 032b fe 05 c4           PR_PH3  LDX     T_P         ; load X
0290 032e a6 00                      LDAA    0,X         ; get word id
0291 0330 08                         INX                 ; point X to next word
0292 0331 ff 05 c4                   STX     T_P         ; store X away
0293 0334 81 00                      CMPA    #0
0294 0336 27 08                      BEQ     PR_PH2      ; no more words
0295 0338 bd 03 41                   JSR     PR_WORD     ; print word based on value in A
0296 033b bd 02 e2                   JSR     PR_SPCB
0297 033e 20 eb                      BRA     PR_PH3      ; next word
0298 0340 39                 PR_PH2  RTS
0299                         
