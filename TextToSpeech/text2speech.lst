0127 02cb 26 05                      BNE     GREET_OP        ; still at valid id so output idle message
0128 02cd 86 00                      LDAA    #0              ; beyond last message so reset the current msg to zero
0129 02cf b7 07 9f                   STAA    GREET_MSG_ID
