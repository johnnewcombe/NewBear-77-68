0720                         ; -----------------------------------------------------
0721                         ; Print value in A as 2 hex digits, Preserve B
0722                         ; X unchanged by called routines
0723                         
0724                         ;PR_HEX2 Renamed to ZOUT as per old MiniMon
0725                         
0726 f0f8 37                 ZOUT        PSHB                ; Save B to STACK
0727 f0f9 bd ec 9e                       JSR     ASCII       ; Convert A to ASCII in A & B
0728 f0fc 37                             PSHB                ; Save B (2nd byte) to STACK
0729 f0fd 8d d0                          BSR     PR_BYTE     ; Print byte in A
0730 f0ff 32                             PULA                ; Get 2nd byte into A from STACK
0731 f100 8d cd                          BSR     PR_BYTE     ; Print byte in A
0732 f102 32                             PULA                ; Recover A from STACK
0733 f103 33                             PULB                ; Recover B from STACK
0734 f104 39                             RTS                 ; RETURN
0735                         
0736 f105 bd ec 76           PR_SP       JSR     STRING      ; Print...
0737 f108 20                             FCB     $20         ;  SPACE
0738 f109 ff                             FCB     $FF         ; End-Of-String
0739 f10a 39                             RTS                 ; RETURN
0740                         
0741                         ; -----------------------------------------------------
0742 fff8                            ORG     $FFF8   ; 6800 interrupt vectors
0743                         
0744 fff8 f0 e0                      FDB     JIRQ    ; IRQ
0745 fffa ef 8c                      FDB     SWI     ; SWI
0746 fffc f0 dd                      FDB     JNMI    ; NMI
0747 fffe ef 81                      FDB     RESET   ; Reset
