                     F400     7 DATAA               .equ 0xF400 ; ACIA(a) Data register
                     F401     8 CTRLA               .equ 0xF401 ; ACIA(a) Ctrl/Status
                     F402     9 DATAB               .equ 0xF402 ; ACIA(b) Data register
                     F403    10 CTRLB               .equ 0xF403 ; ACIA(b) Ctrl/Status
