1039                         ; ------------------------------------------------------------------
1040                         ; ------------------------------------------------------------------
1041                         ;x            ORG     H_VECT   ; 6800 interrupt vectors
1042                         ;                            ;-----------------------------
1043 fff8 ff 39                          FDB     Do_RTI   ; IRQ not used
1044 fffa fe c4                          FDB     Do_SWI   ; SWI handling
1045 fffc ff 39                          FDB     Do_RTI   ; NMI not used
1046 fffe fc 00                          FDB     Do_RESET ; Hardware Restart
