   02A6 48            [ 2]  237         ASLA                    ; multiply A by 2 as each pointer is two bytes
   02A7 BD 03 6C      [ 9]  238         JSR     ADX             ; now have the correct pointer value in X
                            239 
                            240 ; get address of message in X from the pointer in X
   02AA A6 00         [ 5]  241         LDAA    0,X             ;  get high byte of word pointed to by X
   02AC E6 01         [ 5]  242         LDAB    1,X             ;  get low byte of word pointed to by X
   02AE B7 1A 26      [ 5]  243         STAA    TEMP
   02B1 F7 1A 27      [ 5]  244         STAB    TEMP+1
   02B4 FE 1A 26      [ 5]  245         LDX     TEMP
   02B7 BD 03 E0      [ 9]  246         JSR     PR_PHRASE       ; output idle message
   02BA BD 03 C6      [ 9]  247         JSR     PR_CRB          ; CR/LF
