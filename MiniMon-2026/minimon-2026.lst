0589                         ;ff63
0590 ff63 bd fc 76           HEADER  JSR     STRING  ; print string...
0591 ff66 20 43 43                   FCC     " CC"   ;
0592 ff69 20 42 20                   FCC     " B "   ;
0593 ff6c 20 41 20                   FCC     " A "   ;
0594 ff6f 20 20 58                   FCC     "  X"   ;
0595 ff72 20 20 20                   FCC     "   "   ;
0596 ff75 20 50 43                   FCC     " PC"   ;
0597 ff78 20 20 20                   FCC     "   "   ;
0598 ff7b 53 50                      FCC     "SP"    ;
0599 ff7d ff                         FCB     $FF     ; End-of-string
0600 ff7e 20 0f                      BRA     START   ; Return to MINIMON
0601 ff80 01                         NOP
0602 ff81 8e f0 d0           RESET   LDS     #STACK  ; Set up stack for MINIMON
0603 ff84 86 03                      LDAA    #$03    ; Reset:
0604 ff86 b7 f4 01                   STAA    CTRLA   ;   ACIA.A
0605 ff89 b7 f4 03                   STAA    CTRLB   ;   ACIA.B
0606 ff8c bf f0 fd           SWI     STS     PSTACK  ; Save callers stack pointer
0607 ff8f 8e f0 d0           START   LDS     #STACK  ; Set up stack for MINMON
0608 ff92 86 11                      LDAA    #$11    ; Set up: 8N2
0609 ff94 b7 f4 01                   STAA    CTRLA   ;   ACIA.A
0610 ff97 bd fc 76                   JSR     STRING  ; Print string...
0611 ff9a 0d 0a 00 2a                FCB     $0D,$0A,$00,'*    ; c/r l/f null `*`
0612 ff9e ff                         FCB     $FF     ; End-of-string
0613 ff9f bd fc 00                   JSR     RD_CMD  ; Read a byte (test for `.`)
0614 ffa2 81 53                      CMPA    #'S     ; Is it `S` ?
0615 ffa4 27 93                      BEQ     BRPTSET ; Yes: Set breakpoint cmd
0616 ffa6 81 48                      CMPA    #'H     ; Is it `H` ?
0617 ffa8 27 b9                      BEQ     HEADER  ;
0618 ffaa 81 50                      CMPA    #'P     ; Is it `P` ?
0619 ffac 26 03                      BNE     L1      ; No: Skip
0620 ffae 7e fd e2                   JMP     PUNCH   ;
0621 ffb1 81 4c              L1      CMPA    #'L     ; Is it `L` ?
0622 ffb3 26 03                      BNE     L2      ; No: Skip
0623 ffb5 7e fc e6                   JMP     LOAD    ;
0624 ffb8 81 52              L2      CMPA    #'R     ; Is it `R`
0625 ffba 26 03                      BNE     L3      ; No: Skip
0626 ffbc 7e fd 36                   JMP     REGPRT  ;
0627 ffbf 81 42              L3      CMPA    #'B     ; Is it `B` ?
0628 ffc1 26 03                      BNE     L6      ; No: Skip
0629 ffc3 7e fd 62                   JMP     BLKMOV  ;
0630 ffc6 81 4d              L6      CMPA    #'M     ; Is it `M` ?
0631 ffc8 26 03                      BNE     L8      ; No: Skip
0632 ffca 7e fe 43                   JMP     MODIFY  ;
0633 ffcd 81 47              L8      CMPA    #'G     ; Is it `G` ?
0634 ffcf 26 03                      BNE     L9      ; No: Skip
0635 ffd1 7e fe c2                   JMP     GO      ;
0636 ffd4 81 43              L9      CMPA    #'C     ; Is it `C` ?
0637 ffd6 26 03                      BNE     L10     ; No: Skip
0638 ffd8 7e fe d9                   JMP     CONTNU  ;
0639 ffdb 81 44              L10     CMPA    #'D     ; Is it `D` ?
0640 ffdd 26 b0                      BNE     START   ; No: Give up - ignore comand
0641 ffdf 7e ff 07                   JMP     DUMP    ;
0642                         
0643                         ; Transmit an S9 terminating record
0644 ffe2 bd fc 76           STERMS      JSR     STRING
0645 ffe5 53 39 30 33 30 30              FCC     "S9030000FC"
     30 30 46 43
0646 ffef ff                             FCB $FF
0647 fff0 20 9d                          BRA START
