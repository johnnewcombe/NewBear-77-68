0045                         MAINLOOP:
0046                         ; -----------------------------------------------------
0047                         ; Data arrives at port B as four hex characters
0048                         ; -----------------------------------------------------
0049 0205 bd 03 39                   JSR     GETDATA         ; value in T_WEIGHT, stones in A
0050 0208 25 03                      BCS     ML1             ; is it invalid i.e. carry clear
0051 020a 7e 02 a1                   JMP     IDLE
0052 020d 81 14              ML1     CMPA    #20             ; more that 20 is too heavy
0053 020f 22 45                      BHI     OVERLOAD
0054 0211 b6 07 98                   LDAA    T_WEIGHT+1      ; validate pounds
0055 0214 81 0d                      CMPA    #13             ; invalid pounds
0056 0216 22 6a                      BHI     ERROR           ; error
0057 0218 bd 02 c3                   JSR GREET               ; send a greeting message
0058                         
0059                                 ; get the weight a second time, this should allow the scles time to settle
0060 021b bd 03 39                   JSR     GETDATA
0061                         
0062                                 ; all good so output the weight mesage
0063                                 ; TODO get phrase from phrase table as per other message output routines
0064 021e bd 03 68                   JSR     STRINGB
0065 0221 59 6f 75 20 77 65          FCC     "You weigh"
     69 67 68
0066 022a 00                         FCB     $00
0067 022b fe 07 97                   LDX     T_WEIGHT        ; restore X
0068 022e bd 03 d1                   JSR     PR_WEIGHT       ; weight back X so output the weight
0069                         
0070                                 ; determine phrase category (light normal, heavy etc.) and jump to the section
0071 0231 b6 07 97                   LDAA    T_WEIGHT
0072 0234 81 06                      CMPA    #LIGHT_WGHT
0073 0236 22 03                      BHI     ML2             ; less than light weight gets no comment
0074 0238 7e 03 36                   JMP     END
0075 023b 81 0a              ML2     CMPA    #NORM_WGHT      ; less than normal is light
0076 023d 22 03                      BHI     ML3
0077 023f 7e 02 dc                   JMP     LIGHT
0078 0242 81 0d              ML3     CMPA    #HEAVY_WGHT     ; less than heavy is normal
0079 0244 22 03                      BHI     ML4
0080 0246 7e 02 f1                   JMP     NORMAL
0081 0249 81 0f              ML4     CMPA    #SHEAVY_WGHT    ; less than super heavy is heavy
0082 024b 2b 03                      BMI     ML5
0083 024d 7e 03 06                   JMP     HEAVY
0084 0250 7e 03 1b           ML5     JMP     SHEAVY
0085 0253 7e 03 36                   JMP END
