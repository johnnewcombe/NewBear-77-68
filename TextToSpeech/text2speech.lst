                            258 ;--------------------------------------------------------------
                            259 ; Gets the weight data from the scales and rerurns with carry
ASxxxx Assembler V05.50.5  (Motorola 6800/6802/6808)                    Page 6
Hexadecimal [16-Bits]                                 Thu May  7 21:56:15 2026



                            260 ; set if a valid reading, carry clear otherwise. A valid weight
                            261 ; reading resets the idle count. Data received is stored in
                            262 ; T_WEIGHT and MSB in A.
                            263 ;--------------------------------------------------------------
   02C6                     264 GETDATA:
   02C6 BD 03 5E      [ 9]  265         JSR     RD_XB           ; read 4 hex characters into X
   02C9 FF 1A 28      [ 6]  266         STX     T_WEIGHT        ; store X
   02CC 0C            [ 2]  267         CLC
   02CD B6 1A 28      [ 4]  268         LDAA    T_WEIGHT        ; get fist byte (stones)
   02D0 27 04         [ 4]  269         BEQ     GDDONE          ; idle message
   02D2 7F 00 2D      [ 6]  270         CLR     IDLE_TICS       ; not an idle message so reset the idle counter
   02D5 0D            [ 2]  271         SEC                     ; non idle message return with carry set
   02D6 39            [ 5]  272 GDDONE:  RTS
                            273 
                            274 ; -----------------------------------------------------
                            275 ; PR_DEC: Puts 3 decimal digits in DEC, DEC+1 and DEC+2
                            276 ;
                            277 ;       !! ONLY WORKS WITH VALUES BELOW 128 !!
                            278 ; -----------------------------------------------------
   02D7 5F            [ 2]  279 PR_DEC:  CLRB            ; Clear B for hundreds
                            280 
   02D8 81 64         [ 2]  281 HUND:    CMPA    #100    ; 100 or more?
                            282 
   02DA 2D 05         [ 4]  283         BLT     TENS
   02DC 80 64         [ 2]  284         SUBA    #100    ; Sub 100
   02DE 5C            [ 2]  285         INCB            ; Increment hundred counter
   02DF 20 F7         [ 4]  286         BRA     HUND
                            287 
   02E1 F7 1A 21      [ 5]  288 TENS:    STAB    DEC     ; store the hundreds
                            289 
   02E4 5F            [ 2]  290         CLRB
   02E5 81 0A         [ 2]  291 TENS1:   CMPA    #10     ; 10 or more?
   02E7 2D 05         [ 4]  292         BLT     UNITS
   02E9 80 0A         [ 2]  293         SUBA    #10     ; Sub 10
   02EB 5C            [ 2]  294         INCB            ; Increment ten counter
   02EC 20 F7         [ 4]  295         BRA     TENS1
                            296 
   02EE F7 1A 22      [ 5]  297 UNITS:   STAB    DEC+1
   02F1 B7 1A 23      [ 5]  298         STAA    DEC+2   ; Final remainder is units
                            299 
   02F4 39            [ 5]  300         RTS
                            301 
                            302 
                            303 ; -----------------------------------------------------
                            304 ; Print string FOLLOWING JSR ( terminated by 0xFF ) to
                            305 ; ACIA(b) and ACIA(b)
                            306 ; -----------------------------------------------------
   02F5 30            [ 4]  307 STRINGB: TSX             ; Get loc. of return addr to X
   02F6 EE 00         [ 6]  308          LDX     0,X     ; Get return addr to X
   02F8 09            [ 4]  309          DEX             ; Point to byte before
   02F9 08            [ 4]  310 STRB1:   INX             ; Point to next byte
   02FA A6 00         [ 5]  311          LDAA    0,X     ; Get byte to be printed
   02FC 81 FF         [ 2]  312          CMPA    #0xFF    ; End-string ?
   02FE 27 0E         [ 4]  313          BEQ     ENDSTR  ; Yes: Go to finish up
   0300 F6 F0 FF      [ 4]  314          LDAB    PANEL
