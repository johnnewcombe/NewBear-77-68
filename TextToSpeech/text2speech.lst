                            353 ; -----------------------------------------------------
                            354 ; Prints the message " n stones n pounds"
                            355 ; place stones in MSB of X and pound in LSB
                            356 ; -----------------------------------------------------
   02FB                     357 PR_WEIGHT:
   02FB FF 19 47      [ 6]  358         STX     T_W
   02FE B6 19 47      [ 4]  359         LDAA    T_W             ; Load high byte of X into Accumulator A
   0301 BD 03 61      [ 9]  360         JSR     PR_WORD         ; n
   0304 BD 03 21      [ 9]  361         JSR     PR_SPCB
   0307 86 1B         [ 2]  362         LDAA    #0x1B
   0309 BD 03 61      [ 9]  363         JSR     PR_WORD         ; "stones"
   030C BD 03 21      [ 9]  364         JSR     PR_SPCB
   030F B6 19 48      [ 4]  365         LDAA    T_W+1            ; Load high byte of X into Accumulator A
   0312 BD 03 61      [ 9]  366         JSR     PR_WORD         ; n
   0315 86 1C         [ 2]  367         LDAA    #0x1C
   0317 BD 03 21      [ 9]  368         JSR     PR_SPCB
   031A BD 03 61      [ 9]  369         JSR     PR_WORD         ; "pounds"
   031D BD 03 2C      [ 9]  370         JSR     PR_CRB
   0320 39            [ 5]  371         RTS
                            372 
                            373 ; -----------------------------------------------------
                            374 ; Prints a space on both consoles (preserves A)
                            375 ; -----------------------------------------------------
   0321 36            [ 4]  376 PR_SPCB: PSHA
ASxxxx Assembler V05.50.5  (Motorola 6800/6802/6808)                    Page 8
Hexadecimal [16-Bits]                                 Fri May  1 10:37:03 2026



   0322 86 20         [ 2]  377         LDAA    #0x20        ; Put space character in A
   0324 BD FC 0F      [ 9]  378         JSR     PR_A
   0327 BD 02 CB      [ 9]  379         JSR     PR_B        ; Print it
   032A 32            [ 4]  380         PULA
   032B 39            [ 5]  381         RTS                 ; RETURN
                            382 
                            383 ; -----------------------------------------------------
                            384 ; Prints a CRLF on both consoles (preserves A)
                            385 ; -----------------------------------------------------
   032C 36            [ 4]  386 PR_CRB:  PSHA
   032D 86 0D         [ 2]  387         LDAA    #0x0D        ; Put CHAR character in A
   032F BD FC 0F      [ 9]  388         JSR     PR_A
   0332 BD 02 CB      [ 9]  389         JSR     PR_B        ; Print it
   0335 86 0A         [ 2]  390         LDAA    #0x0A
   0337 BD FC 0F      [ 9]  391         JSR     PR_A
   033A BD 02 CB      [ 9]  392         JSR     PR_B        ; Print it
   033D 32            [ 4]  393         PULA
   033E 39            [ 5]  394         RTS                 ; RETURN
                            395 
                            396 ; -----------------------------------------------------
                            397 ; Outputs a phrase from the memory location in X
                            398 ; -----------------------------------------------------
   033F                     399 PR_PHRASE:
                            400 
   033F A6 00         [ 5]  401 PR_PH1:  LDAA    0,X         ; get high byte of word
   0341 E6 01         [ 5]  402         LDAB    1,X         ; get low byte
   0343 81 FF         [ 2]  403         CMPA    #0xFF        ; check high byte
   0345 27 19         [ 4]  404         BEQ     PR_PH2      ; high byte is 0xFF so we're done
   0347 FF 19 43      [ 6]  405 PR_PH3:  STX     T_Y         ; save table pointer
   034A B7 19 45      [ 5]  406         STAA    T_P
   034D F7 19 46      [ 5]  407         STAB    T_P+1
   0350 FE 19 45      [ 5]  408         LDX     T_P         ; X now points to the word
   0353 BD 03 61      [ 9]  409         JSR     PR_WORD
   0356 BD 03 21      [ 9]  410         JSR     PR_SPCB
   0359 FE 19 43      [ 5]  411         LDX     T_Y         ; restore table pointer
   035C 08            [ 4]  412         INX                 ; move to next entry
   035D 08            [ 4]  413         INX                 ; (2 bytes per entry)
   035E 20 DF         [ 4]  414         BRA     PR_PH1
   0360 39            [ 5]  415 PR_PH2:  RTS
                            416 
                            417 
                            418 ; -----------------------------------------------------
                            419 ; Outputs a word based on value in A
                            420 ; -----------------------------------------------------
                            421 ; TODO See new routine below.
                            422 
                            423 ;PR_WORD:     INCA    ;
                            424 ;            LDX     #WORDPTR  ; base of offset table
                            425 ;PR_WORD1:    DECA
                            426 ;            BEQ     FOUNDW
                            427 ;            INX                 ; move to next address
                            428 ;            INX
                            429 ;            BNE     PR_WORD1    ; loop around to retest
                            430 ;FOUNDW:      LDAA    0,X
                            431 ;            STAA    T_X
ASxxxx Assembler V05.50.5  (Motorola 6800/6802/6808)                    Page 9
Hexadecimal [16-Bits]                                 Fri May  1 10:37:03 2026



                            432 ;            LDAA    1,X
                            433 ;            STAA    T_X+1
                            434 ;            LDX     T_X
                            435 ;            JSR     STRINGBX
                            436 ;            RTS
                            437 
                            438 ; -----------------------------------------------------
                            439 ; Outputs a word based on value in X
                            440 ; -----------------------------------------------------
   0361                     441 PR_WORD:
   0361 FF 19 41      [ 6]  442             STX     T_X             ; use ASL and ROL to multiply by 2 (pointer is 2 bytes wide)
   0364 78 19 42      [ 6]  443             ASL     T_X+1           ; shift low byte left, bit 7 goes to carry
   0367 79 19 41      [ 6]  444             ROL     T_X             ; rotate high byte left, carry in from low byte
   036A FE 19 41      [ 5]  445             LDX     T_X
   036D FF 19 41      [ 6]  446             STX     T_X             ; Stash X
   0370 B6 19 41      [ 4]  447             LDAA    T_X             ; High byte of X
   0373 F6 19 42      [ 4]  448             LDAB    T_X+1           ; Low byte of X
   0376 CB 94         [ 2]  449             ADDB    #<WORDPTR    ; Add low byte of WORDPTR address
   0378 89 03         [ 2]  450             ADCA    #>WORDPTR    ; Add high byte of WORDPTR address + carry
   037A B7 19 41      [ 5]  451             STAA    T_X             ; T_X has the address of the pointer NOT the word
   037D F7 19 42      [ 5]  452             STAB    T_X+1
   0380 FE 19 41      [ 5]  453             LDX     T_X             ; X has the address of the pointer NOT the word
                            454 
   0383 A6 00         [ 5]  455             LDAA    0,X             ; get the hi byte of the word
   0385 B7 19 41      [ 5]  456             STAA    T_X
   0388 A6 01         [ 5]  457             LDAA    1,X             ; get the low byte of the word
   038A B7 19 42      [ 5]  458             STAA    T_X+1
   038D FE 19 41      [ 5]  459             LDX     T_X             ; X now has address of the word
   0390 BD 02 91      [ 9]  460             JSR     STRINGBX        ; output the word
   0393 39            [ 5]  461             RTS
                            462 
                            463 ; -----------------------------------------------------
                            464 ; Word pointer table (max words 256)
                            465 ; Set X to the pointer ID and call PR_WORD
                            466 ; -----------------------------------------------------
                            467 ; To create new wordk add the word in the correct
                            468 ; (alphabetical) position in the word table. Then add
                            469 ; a pointer to that word at the END of the Word Pointer
                            470 ; table. Finally add an .equATE using the word as a label
                            471 ; in the word equates table;
                            472 ; -----------------------------------------------------
                            473 
   0394                     474 WORDPTR:
                            475 
