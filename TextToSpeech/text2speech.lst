                            150 
                            151 ; we cycle thought idle message when no one is on the scales, data comes in a one
                            152 ; second intervals so we simply increase the idle count until it's time to display
                            153 ; the next idle message
                            154 
   020C 7F 1A 31      [ 6]  155 IDLE:   CLR     PROCESSING_FLG  ; clear the processing flag as no one
                            156                                 ;   is standing on the scales
   020F 7C 1A 2A      [ 6]  157         INC     IDLE_COUNT      ; increase the idle count
   0212 B6 1A 2A      [ 4]  158         LDAA    IDLE_COUNT      ; see if idle count = max idle time
   0215 81 2D         [ 2]  159         CMPA    #IDLE_TICS      ; a data message appears every second
   0217 27 03         [ 4]  160         BEQ     IDLE1           ; not reached the max idle time
   0219 7E 01 6B      [ 3]  161         JMP     MAINLOOP             ; nothing to do yet
                            162 
   021C 7F 1A 2A      [ 6]  163 IDLE1:   CLR     IDLE_COUNT      ; time to output an idle message so reset the count
   021F B6 1A 2B      [ 4]  164         LDAA    IDLE_MSG_ID     ; get next Message ID
   0222 81 19         [ 2]  165         CMPA    #IDLE_MSG_CNT   ; are we beyond the end of the list
   0224 26 04         [ 4]  166         BNE     IDLE_OP         ; still at valid id so output idle message
   0226 7F 1A 2B      [ 6]  167         CLR     IDLE_MSG_ID     ; beyond last message so reset the current msg to zero
   0229 4F            [ 2]  168         CLRA                    ; set currentid back to 0
   022A                     169 IDLE_OP:
   022A 7C 1A 2B      [ 6]  170         INC     IDLE_MSG_ID     ; set to next message for the next next time
   022D CE 12 3B      [ 3]  171         LDX     #IDLEPTR        ; A has phrase ID, set X to the base address
   0230 BD 02 A6      [ 9]  172         JSR     PHRASE_OUT
   0233 7E 01 6B      [ 3]  173         JMP     MAINLOOP
                            174 
   0236                     175 GREET:   ; output the greeting message
   0236 B6 1A 2C      [ 4]  176         LDAA    GREET_MSG_ID    ; get next Message ID
   0239 81 0D         [ 2]  177         CMPA    #GREET_MSG_CNT  ; are we beyond the end of the list
   023B 26 04         [ 4]  178         BNE     GREET_OP        ; still at valid id so output idle message
   023D 7F 1A 2C      [ 6]  179         CLR     GREET_MSG_ID    ; beyond last message so reset the current msg to zero
   0240 4F            [ 2]  180         CLRA                    ; set currentid back to 0
   0241                     181 GREET_OP:
   0241 7C 1A 2C      [ 6]  182         INC     GREET_MSG_ID    ; set to next message for the next next time
   0244 CE 11 AD      [ 3]  183         LDX     #GREETPTR       ; A has phrase ID, set X to the base address
   0247 BD 02 A6      [ 9]  184         JSR     PHRASE_OUT
   024A 39            [ 5]  185         RTS
                            186 
   024B                     187 LIGHTW:   ; output the lightweight message
   024B B6 1A 2D      [ 4]  188         LDAA    LIGHT_MSG_ID    ; get next Message ID
   024E 81 0A         [ 2]  189         CMPA    #LIGHT_MSG_CNT  ; are we beyond the end of the list
   0250 26 04         [ 4]  190         BNE     LIGHT_OP        ; still at valid id so output idle message
   0252 7F 1A 2D      [ 6]  191         CLR     LIGHT_MSG_ID    ; beyond last message so reset the current msg to zero
   0255 4F            [ 2]  192         CLRA                    ; set currentid back to 0
   0256                     193 LIGHT_OP:
   0256 7C 1A 2D      [ 6]  194         INC     LIGHT_MSG_ID    ; set to next message for the next next time
   0259 CE 11 C7      [ 3]  195         LDX     #LIGHTPTR       ; A has phrase ID, set X to the base address
   025C BD 02 A6      [ 9]  196         JSR     PHRASE_OUT
   025F 7E 01 6B      [ 3]  197         JMP     MAINLOOP
