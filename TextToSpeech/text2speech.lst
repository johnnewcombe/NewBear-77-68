                            261 ; -----------------------------------------------------
                            262 ; Print string FOLLOWING JSR ( terminated by 0xFF ) to
                            263 ; ACIA(b) and ACIA(b)
                            264 ; -----------------------------------------------------
   027B 30            [ 4]  265 STRINGB: TSX             ; Get loc. of return addr to X
   027C EE 00         [ 6]  266         LDX     0,X     ; Get return addr to X
ASxxxx Assembler V05.50.5  (Motorola 6800/6802/6808)                    Page 6
Hexadecimal [16-Bits]                                 Fri May  1 13:46:24 2026



   027E 09            [ 4]  267         DEX             ; Point to byte before
   027F 08            [ 4]  268 STRB1:   INX             ; Point to next byte
   0280 A6 00         [ 5]  269         LDAA    0,X     ; Get byte to be printed
   0282 81 FF         [ 2]  270         CMPA    #0xFF    ; End-string ?
   0284 27 07         [ 4]  271         BEQ     ENDSTR  ; Yes: Go to finish up
   0286 BD FC 0F      [ 9]  272         JSR     PR_A    ; Print the byte to ACIA(a) (A is maintained)
   0289 8D 40         [ 8]  273         BSR     PR_B    ; Print the byte to ACIA(b)
   028B 20 F2         [ 4]  274         BRA     STRB1   ; Go back for next byte
   028D 31            [ 4]  275 ENDSTR:  INS             ; Clean up stack...
   028E 31            [ 4]  276         INS             ;  ( pop off the return addr )
   028F 6E 01         [ 4]  277         JMP     1,X     ; Jump back to caller (RETURN)
