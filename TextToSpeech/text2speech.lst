                            238 ; get address of message in X from the pointer in X
   02A5 A6 00         [ 5]  239         LDAA    0,X             ;  get high byte of word pointed to by X
   02A7 E6 01         [ 5]  240         LDAB    1,X             ;  get low byte of word pointed to by X
   02A9 B7 1A 1B      [ 5]  241         STAA    TEMP
   02AC F7 1A 1C      [ 5]  242         STAB    TEMP+1
   02AF FE 1A 1B      [ 5]  243         LDX     TEMP
   02B2 BD 03 D6      [ 9]  244         JSR     PR_PHRASE       ; output idle message
   02B5 BD 03 BC      [ 9]  245         JSR     PR_CRB          ; CR/LF
