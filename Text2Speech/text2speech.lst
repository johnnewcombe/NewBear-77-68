   1C44                     512 T_Q:             .rmb     1       ; Temp storage for ZIN
   1C45                     513 T_Z:             .rmb     2       ;   "     "     "  RDX
   1C47                     514 T_X:             .rmb     2       ;   "     "     "  PR_WORD
   1C49                     515 T_Y:             .rmb     2       ;   "     "     "  table pointer
   1C4B                     516 T_P:             .rmb     2       ;   "     "     "  PR_PHRASE
   1C4D                     517 T_W:             .rmb     2       ;   "     "     "  PR_WEIGHT
   1C4F                     518 T_TMP:           .rmb     2       ;   "     "     "  within subroutine
   1C51                     519 TEMP:            .rmb     2       ; temp var (non subroutine use)
   1C53                     520 T_WEIGHT:        .rmb     2       ; holds value of weight following a call to GETDATA
                            521 
                            522 ; these are cleared at start up
   1C55                     523 IDLE_COUNT:      .rmb     1       ; counts the number of empty measurement reports
   1C56                     524 IDLE_MSG_ID:     .rmb     1       ; holds value of next idle message to use
   1C57                     525 GREET_MSG_ID:    .rmb     1       ; holds value of next greeting message to use
   1C58                     526 LIGHT_MSG_ID:    .rmb     1       ; holds value of next light weight message to use
   1C59                     527 NORMAL_MSG_ID:   .rmb     1       ; holds value of next normal weight message to use
   1C5A                     528 HEAVY_MSG_ID:    .rmb     1       ; holds value of next heavy weight message to use
   1C5B                     529 SHEAVY_MSG_ID:   .rmb     1       ; holds value of next super heavy weight message to use
   1C5C                     530 PROCESSING_FLG:  .rmb     1       ; non-zero indicates that that a weight is being processed
                            531                                   ;   all following weight data is ignored until the next
                            532                                   ;   idle (0000h) data resets it.
   1C5D                     533 WORDS:           .rmb     1       ; number of words for the panel LED routines
                            534                                   ;  this is updated each time a word is transmitted.
