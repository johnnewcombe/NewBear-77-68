0237                         ; Outputs a phrase from the value in A
0238                         ; -----------------------------------------------------
0239                         
0240                         PR_PHRASE
0241 0304 a6 00                      LDAA    0,X         ; get word id
0242 0306 08                         INX                 ; point X to next word
0243 0307 ff 05 9d                   STX     T_P         ; store X away
0244 030a 81 00                      CMPA    #0
0245 030c 27 0b                      BEQ     PR_END      ; no more words
0246 030e bd 03 1a                   JSR     PR_WORD     ; print word based on value in A
0247 0311 bd 02 e6                   JSR     PR_SPCB
0248 0314 fe 05 9d                   LDX     T_P        ; recover X
0249                         
0250 0317 20 eb                      BRA     PR_PHRASE   ; next word
0251 0319 39                 PR_END  RTS
0252                         
