0656                         ; FF8C
0657                         ; -----------------------------------------------------
0658 ff8c bf f0 fd           SWI     STS     PSTACK  ; Save callers stack pointer
0659                         
0660                         ; -----------------------------------------------------
0661                         ; FF8F
0662                         ; -----------------------------------------------------
0663 ff8f 8e f0 d0           START   LDS     #STACK  ; Set up stack for JMON
0664 ff92 8d 57                      BSR     SETACIA ; Set up ACIAs
0665 ff94 bd fc 76                   JSR     STRING  ; Print string...
0666 ff97 0d 0a 00 2a                FCB     $0D,$0A,$00,'*    ; c/r l/f null `*`
0667 ff9b ff                         FCB     $FF     ; End-of-string
0668 ff9c bd fc 00                   JSR     RD_CMD  ; Read a byte (test for `.`)
0669 ff9f ce ff b5                   LDX     #CMDTAB ; point to command table
0670 ffa2 e6 00              CMDLP   LDAB    0,X     ; B = key byte (0 ends table)
0671 ffa4 27 e9                      BEQ     START   ; end of table → default to START
0672 ffa6 11                         CBA             ; compare A vs B
0673 ffa7 27 05                      BEQ     FOUND   ; match → dispatch
0674 ffa9 08                         INX             ; skip key
0675 ffaa 08                         INX             ; skip FDB high
0676 ffab 08                         INX             ; skip FDB low
0677 ffac 20 f4                      BRA      CMDLP  ; try next entry
0678                         
0679 ffae e6 01              FOUND   LDAB    1,X     ; B = target high byte (FDB stores high,low)
0680 ffb0 a6 02                      LDAA    2,X     ; A = target low byte
0681 ffb2 36                         PSHA            ; push high first
0682 ffb3 37                         PSHB            ; push low — now low is on top of stack
0683 ffb4 39                         RTS             ; jump to target
0684                         
0685                         ; Command table: key, then FDB routine
0686 ffb5 53                 CMDTAB  FCB     'S
0687 ffb6 ff 39                      FDB     BRPTSET
0688 ffb8 48                         FCB     'H
0689 ffb9 ff 63                      FDB     HEADER
0690 ffbb 50                         FCB     'P
0691 ffbc fd e2                      FDB     PUNCH
0692 ffbe 4c                         FCB     'L
0693 ffbf fc e3                      FDB     LOAD
0694 ffc1 52                         FCB     'R
0695 ffc2 fd 36                      FDB     REGPRT
0696 ffc4 4d                         FCB     'M
0697 ffc5 fe 43                      FDB     MODIFY
0698 ffc7 47                         FCB     'G
0699 ffc8 fe c2                      FDB     GO
0700 ffca 43                         FCB     'C
0701 ffcb fe d9                      FDB     CONTNU
0702 ffcd 44                         FCB     'D
0703 ffce ff 07                      FDB     DUMP
0704 ffd0 54                         FCB     'T'
0705 ffd1 fd 62                      FDB     MEMTEST
0706 ffd3 56                         FCB     'V'
0707 ffd4 fd c3                      FDB     VERSION
0708 ffd6 00                         FCB     0       ; terminator
0709 ffd7 ff 8f                      FDB     START   ; not used (any value ok after 0)
0710                         
0711                         ; Transmit an address '0000' S9 terminating record
0712 ffd9 bd fc 76           STERMS  JSR     STRING
0713 ffdc 0d 0a                      FCB     $0D,$0A
0714 ffde 53 39 30 33 30 30          FCC     "S9030000FC"
     30 30 46 43
0715 ffe8 ff                         FCB     $FF
0716 ffe9 20 a4                      BRA     START
0717                         
0718                         ; Reset the ACIAs
0719 ffeb 86 11              SETACIA LDAA    #$11    ; 8 Data, No Parity, 2 Stop Bits
0720 ffed b7 f4 01                   STAA    CTRLA   ;   ACIA.A
0721 fff0 86 01                      LDAA    #$01    ; 7 Data, Even Parity, 2 Stop Bits
0722 fff2 b7 f4 03                   STAA    CTRLB   ;   ACIA.B
0723 fff5 39                         RTS
0724                         
0725 fff6 01                         NOP
0726 fff7 01                         NOP
