   01DE 26 04         [ 4]  144         BNE     LIGHT_OP        ; still at valid id so output idle message
   01E0 7F 19 56      [ 6]  145         CLR     LIGHT_MSG_ID    ; beyond last message so reset the current msg to zero
   01E3 4F            [ 2]  146         CLRA                    ; set currentid back to 0
   01E4                     147 LIGHT_OP:
   01E4 7C 19 56      [ 6]  148         INC     LIGHT_MSG_ID    ; set to next message for the next next time
   01E7 CE 11 23      [ 3]  149         LDX     #LIGHTPTR       ; A has phrase ID, set X to the base address
   01EA BD 02 34      [ 9]  150         JSR     PHRASE_OUT
   01ED 7E 01 05      [ 3]  151         JMP     MAINLOOP
                            152 
