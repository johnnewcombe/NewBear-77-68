                            124 ; we cycle thought idle message when no one is on the scales, data comes in a one
                            125 ; second intervals so we simply increase the idle count until it's time to display
                            126 ; the next idle message
                            127 
   01F2 7C 19 BA      [ 6]  128 IDLE:    INC     IDLE_COUNT      ; increase the idle count
   01F5 B6 19 BA      [ 4]  129         LDAA    IDLE_COUNT      ; see if idle count = max idle time
   01F8 81 0A         [ 2]  130         CMPA    #IDLE_SECS      ; a data message appears every second
   01FA 27 03         [ 4]  131         BEQ     IDLE1           ; not reached the max idle time
   01FC 7E 01 59      [ 3]  132         JMP     MAINLOOP             ; nothing to do yet
                            133 
   01FF 7F 19 BA      [ 6]  134 IDLE1:   CLR     IDLE_COUNT      ; time to output an idle message so reset the count
   0202 B6 19 BB      [ 4]  135         LDAA    IDLE_MSG_ID     ; get next Message ID
   0205 81 19         [ 2]  136         CMPA    #IDLE_MSG_CNT   ; are we beyond the end of the list
   0207 26 04         [ 4]  137         BNE     IDLE_OP         ; still at valid id so output idle message
   0209 7F 19 BB      [ 6]  138         CLR     IDLE_MSG_ID     ; beyond last message so reset the current msg to zero
   020C 4F            [ 2]  139         CLRA                    ; set currentid back to 0
   020D                     140 IDLE_OP:
   020D 7C 19 BB      [ 6]  141         INC     IDLE_MSG_ID     ; set to next message for the next next time
   0210 CE 11 FE      [ 3]  142         LDX     #IDLEPTR        ; A has phrase ID, set X to the base address
   0213 BD 02 89      [ 9]  143         JSR     PHRASE_OUT
   0216 7E 01 59      [ 3]  144         JMP     MAINLOOP
                            145 
   0219                     146 GREET:   ; output the greeting message
   0219 B6 19 BC      [ 4]  147         LDAA    GREET_MSG_ID    ; get next Message ID
   021C 81 0D         [ 2]  148         CMPA    #GREET_MSG_CNT  ; are we beyond the end of the list
