   026B                     115 MAINLOOP:
                            116 ; -----------------------------------------------------
                            117 ; Data arrives at port B as four hex characters
                            118 ; -----------------------------------------------------
   026B BD 03 EC      [ 9]  119                 JSR     GETDATA         ; value in T_WEIGHT, stones in A
   026E 25 03         [ 4]  120                 BCS     ML1             ; is it invalid i.e. carry clear
   0270 7E 02 EC      [ 3]  121                 JMP     IDLE
   0273 7D 00 18      [ 6]  122 ML1:            TST     PROCESSING_FLG  ; are we already processing a weight
   0276 26 F3         [ 4]  123                 BNE     MAINLOOP        ; flag non-zero so ignore everything that follows
   0278 7C 00 18      [ 6]  124                 INC     PROCESSING_FLG  ; ignore any following data until we next idle
   027B 81 14         [ 2]  125                 CMPA    #TOO_HEAVY      ; more that 20 is too heavy
   027D 22 3B         [ 4]  126                 BHI     OVERLOADED
   027F B6 00 10      [ 4]  127                 LDAA    T_WEIGHT+1      ; validate pounds
   0282 81 0D         [ 2]  128                 CMPA    #13             ; invalid pounds
   0284 22 4D         [ 4]  129                 BHI     IERROR          ; internal error
   0286 BD 03 23      [ 9]  130                 JSR     GREET           ; send a greeting message
                            131 
                            132                 ; get the weight a second time, this should allow the scales time to settle
   0289 BD 03 EC      [ 9]  133                 JSR     GETDATA
                            134 
                            135                 ; output "you weigh" maybe use a phrase rather than individual words
   028C CE 1C 1B      [ 3]  136                 LDX     #MYOUWEIGH
   028F BD 04 F7      [ 9]  137                 JSR     PR_PHRASE
   0292 FE 00 0F      [ 5]  138                 LDX     T_WEIGHT        ; restore X
   0295 BD 04 A7      [ 9]  139                 JSR     PR_WEIGHT       ; weight back X so output the weight
                            140 
                            141                 ; output a comments
   0298 B6 00 0F      [ 4]  142                 LDAA    T_WEIGHT        ; stones
   029B 81 0F         [ 2]  143                 CMPA    #SHEAVY_WGHT
   029D 25 03         [ 4]  144                 BLO     ML2             ; not super heavy weight
   029F 7E 03 B1      [ 3]  145                 JMP     SHEAVYW
   02A2 81 0D         [ 2]  146 ML2:            CMPA    #HEAVY_WGHT
   02A4 25 03         [ 4]  147                 BLO     ML3             ; not heavy weight
   02A6 7E 03 8D      [ 3]  148                 JMP     HEAVYW
   02A9 81 0A         [ 2]  149 ML3:            CMPA    #NORM_WGHT
   02AB 25 03         [ 4]  150                 BLO     ML4             ; not normal weight
   02AD 7E 03 69      [ 3]  151                 JMP     NORMALW
   02B0 81 06         [ 2]  152 ML4:            CMPA    #LIGHT_WGHT
   02B2 25 03         [ 4]  153                 BLO     ML5             ; not light weight
   02B4 7E 03 45      [ 3]  154                 JMP     LIGHTW
   02B7 7E 02 6B      [ 3]  155 ML5:            JMP     MAINLOOP        ; no comments for less than light weight
                            156 
