0804 076c a6 00                          LDAA        0,X         ; Fetch quadrant contents 
0805 076e ce 04 c9           LR3         LDX         #Msg36a     ; Set pointer to left quadrant  (was $04C9)
0806 0771 8d c9                          BSR         QDSET       ; Set quadrant contents 
