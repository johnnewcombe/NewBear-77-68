1962 0e55 bd 05 06                       JSR         MSG         ; 
1963 0e58 de 24                          LDX         PNTR3       ; Set pointer to alien ship energy
1964 0e5a a6 00                          LDAA        0,X         ; Transfer alien ship energy
1965 0e5c 97 26                          STAA        STORE1      ;  to STORE1 for calculating
1966 0e5e a6 01                          LDAA        $01,X       ;  
1967 0e60 97 27                          STAA        STORE1+$01  ; Retaliation amount
1968 0e62 c6 02                          LDAB        #$02        ; Divide energy by 4 as
1969 0e64 bd 08 0f                       JSR         DVD         ;  retaliation by alien ship
1970 0e67 de 26                          LDX         STORE1      ; Place energy into index register
1971 0e69 7e 07 98                       JMP         ELOS        ; Remove from shield energy, return
1972                         
1973 0e6c ce 03 ca           DSTR        LDX         #$03CA      ; Print ‘DESTROYED’ 
1974 0e6f bd 05 06                       JSR         MSG         ; 
1975 0e72 de 22                          LDX         PNTR2       ; Fetch alien ship location 
1976 0e74 7e 08 4b                       JMP         DLET        ; Remove alien ship from galaxy, return 
1977                         
1978 0e77 a6 00              SPRC        LDAA        0,X         ; Fetch row and column byte 
1979 0e79 16                             TAB                     ; Save for column value 
1980 0e7a bd 05 12                       JSR         ROTR3       ; Position row to right 
1981 0e7d 84 07                          ANDA        #$07        ; Mask out row value 
1982 0e7f c4 07                          ANDB        #$07        ; Mask out column value 
1983 0e81 39                             RTS                     ; Return 
1984                         
1985                         ;---
1986                         
1987 0e82 26 03              PATCH       BNE         PATCH1
1988 0e84 08                             INX
1989 0e85 09                             DEX
1990 0e86 39                             RTS
1991 0e87 7e 06 24           PATCH1      JMP         MATCH2
1992                         
1993                         
1994                         
1995                         ;------------------------------------------
1996                         ; I/O - System (h/w and monitor) specific
1997                         ;------------------------------------------
1998                         ; For CDC DEMON monitor SWI calls... (mostly in I/O stuff at end)
1999 0000                    D_RESTART       EQU     $00     ; Reset Monitor (& Stack)
2000 0001                    D_RD_BYTE       EQU     $01     ; Get char into A from ACIA
2001 0004                    D_PR_BYTE       EQU     $04     ; Output char in A
2002                         
2003 0f80                                ORG     IOIF_BASE   ; Set address to match original listing
2004                         
2005 0f80 3f                 INPUT       SWI                 ; Call DEMON
2006 0f81 01                             FCB     D_RD_BYTE   ; to read a char into A
2007 0f82 81 03                          CMPA    #cCtrlC     ; Is it Control+C
2008 0f84 27 06                          BEQ     USREXIT     ; Yes: QUIT back to monitor
2009 0f86 8d 01                          BSR     PRINT       ; Echo it
2010 0f88 39                             RTS
2011                         
2012                         ;-------
2013                         
2014 0f89                    PRINT       EQU     *
2015 0f89 3f                             SWI                 ; Call DEMON
2016 0f8a 04                             FCB     D_PR_BYTE   ; to print char in A
2017 0f8b 39                             RTS
2018                         
2019                         ;-------
2020                         
2021                         ; User-defined EXIT ( Note values from JSR to get here are on stack )...
2022 0f8c 3f                 USREXIT     SWI                   ; Call DEMON (resets stack )
2023 0f8d 00                             FCB       D_RESTART   ;  Go back to DEMON prompt
2024 0f8e 39                             RTS                   ; (should not get here !)
