0722                         
0723 06be                    T_Q             RMB     1       ; Temp storage for ZIN
0724 06bf                    T_Z             RMB     2       ;   "     "     "  RDX
0725 06c1                    T_X             RMB     2       ;   "     "     "  PR_WORD
0726 06c3                    T_P             RMB     2       ;   "     "     "  PR_PHRASE
0727 06c5                    T_W             RMB     2       ;   "     "     "  PR_WEIGHT
0728 06c7                    DEC             RMB     3       ; for decimal value
0729 06ca                    RND             RMB     1       ; holds a random number (see RD_B
0730 06cb                    TEMP            RMB     2       ; temp var (non subroutine use)
0731 06cd                    T_WEIGHT        RMB     2       ; holds value of weight following a call to GETDATA
0732 06cf                    IDLE_COUNT      RMB     1       ; counts the number of empty measurement reports
0733 06d0                    IDLE_MSG_ID     RMB     1       ; holds value of next idle message to use
0734 06d1                    GREET_MSG_ID    RMB     1       ; holds value of next greeting message to use
0735 06d2                    LIGHT_MSG_ID    RMB     1       ; holds value of next light weight message to use
0736 06d3                    NORMAL_MSG_ID   RMB     1       ; holds value of next normal weight message to use
0737 06d4                    HEAVY_MSG_ID    RMB     1       ; holds value of next heavy weight message to use
0738 06d5                    SHEAVY_MSG_ID   RMB     1       ; holds value of next super heavy weight message to use
