0456 fe43 bd fc 65           MODIFY  JSR     RD_X    ; Get address to X
0457 fe46 bd fd 4d           STRT    JSR     PRSP    ; Print a space
0458 fe49 7f f0 f5                   CLR     T_R     ; T_R = 0
0459 fe4c a6 00              PRz     LDAA    0,X     ; Get byte pointed to by X to A
0460 fe4e bd fc c9                   JSR     ZOUT    ; Print it as 2.hex digits
0461 fe51 bd fc 00           WATSIT  JSR     RD_CMD  ; Get command character
0462 fe54 81 20              WHAT    CMPA    #$20    ; Is it a space ?
0463 fe56 26 0c                      BNE     ISSLSH  ; No: go test for slash
0464 fe58 08                 CARYON  INX             ; Increment X
0465 fe59 b6 f0 f5                   LDAA    T_R     ; A = T_R
0466 fe5c 81 16                      CMPA    #$16    ; At end of line ?
0467 fe5e 2f ec                      BLE     PRz     ; No: Loop back to continue
0468 fe60 8d 35              NEW_1   BSR     NEWLINE ; Print c/r l/f nul
0469 fe62 20 e2                      BRA     STRT    ; Loop back (Note: Hex was wrong in doc, E2 instead of E5)
0470                         
0471 fe64 81 2f              ISSLSH  CMPA    #'/     ; Is it a slash ?
0472 fe66 26 03                      BNE     ISCRET  ; No: go test for c/r
0473 fe68 09                         DEX             ; X = X - 1
0474 fe69 20 f5                      BRA     NEW_1   ; Loop back (print newline)
0475                         
0476 fe6b 81 0d              ISCRET  CMPA    #$0D    ; Is it a c/r ?
0477 fe6d 26 03                      BNE     ISHEX   ; No: go test for valid Hex
0478 fe6f 08                         INX             ; X = X + 1
0479 fe70 20 ee                      BRA     NEW_1   ; Loop back (print newline)
0480                         
0481 fe72 bd fc 1d           ISHEX   JSR     VHEX    ; Is it a valid hex character ?
0482 fe75 25 19                      BCS     PRQM    ; No: print `?` and ignore
0483 fe77 b7 f0 f6                   STAA    T_Q     ; T_Q = A : Save it
0484 fe7a bd fc 00                   JSR     RD_CMD  ; Get 2nd character
0485 fe7d bd fc 1d                   JSR     VHEX    ; Is it a valid hex character ?
0486 fe80 25 d2                      BCS     WHAT    ; No: then see what it is
0487 fe82 16                         TAB             ; B = A
0488 fe83 b6 f0 f6                   LDAA    T_Q     ; A = T_Q
0489 fe86 bd fc 31                   JSR     BINARY  ; Convert to binary value
0490 fe89 a7 00                      STAA    0,X     ; Store it
0491 fe8b bd fd 4d                   JSR     PRSP    ; Print a space
0492 fe8e 20 c8                      BRA     CARYON  ; Loop back
0493                         
0494 fe90 86 3f              PRQM    LDAA    #'?     ; Put `?` into A
0495 fe92 bd fc 0f                   JSR     PR_A    ; Print it
0496 fe95 20 ba                      BRA     WATSIT  ; Loop back
