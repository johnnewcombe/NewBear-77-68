   026B                      82 MAINLOOP:
                             83 ; -----------------------------------------------------
                             84 ; Data arrives at port B as four hex characters
                             85 ; -----------------------------------------------------
   026B BD 03 F4      [ 9]   86                 JSR     GETDATA         ; value in T_WEIGHT, stones in A
   026E 25 03         [ 4]   87                 BCS     ML1             ; is it invalid i.e. carry clear
   0270 7E 02 EE      [ 3]   88                 JMP     IDLE
   0273 7D 1C 5C      [ 6]   89 ML1:            TST     PROCESSING_FLG  ; are we already processing a weight
   0276 26 F3         [ 4]   90                 BNE     MAINLOOP        ; flag non-zero so ignore everything that follows
   0278 7C 1C 5C      [ 6]   91                 INC     PROCESSING_FLG  ; ignore any following data until we next idle
   027B 81 14         [ 2]   92                 CMPA    #TOO_HEAVY      ; more that 20 is too heavy
   027D 22 3B         [ 4]   93                 BHI     OVERLOADED
   027F B6 1C 54      [ 4]   94                 LDAA    T_WEIGHT+1      ; validate pounds
   0282 81 0D         [ 2]   95                 CMPA    #13             ; invalid pounds
   0284 22 4E         [ 4]   96                 BHI     IERROR          ; internal error
   0286 BD 03 26      [ 9]   97                 JSR     GREET           ; send a greeting message
                             98 
                             99                 ; get the weight a second time, this should allow the scales time to settle
   0289 BD 03 F4      [ 9]  100                 JSR     GETDATA
                            101 
