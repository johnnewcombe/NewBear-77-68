0662                         ; FF8F
0663                         ; -----------------------------------------------------
0664 ff8f 8e f0 d0           START   LDS     #STACK  ; Set up stack for MINMON
0665 ff92 8d 54                      BSR     SETACIA ; Set up ACIAs
0666 ff94 bd fc 76                   JSR     STRING  ; Print string...
0667 ff97 0d 0a 00 2a                FCB     $0D,$0A,$00,'*    ; c/r l/f null `*`
0668 ff9b ff                         FCB     $FF     ; End-of-string
0669 ff9c bd fc 00                   JSR     RD_CMD  ; Read a byte (test for `.`)
0670 ff9f ce ff b5                   LDX     #CMDTAB ; point to command table
0671 ffa2 e6 00              CMDLP   LDAB    0,X     ; B = key byte (0 ends table)
0672 ffa4 27 e9                      BEQ     START   ; end of table → default to START
0673 ffa6 11                         CBA             ; compare A vs B
0674 ffa7 27 05                      BEQ     FOUND   ; match → dispatch
0675 ffa9 08                         INX             ; skip key
0676 ffaa 08                         INX             ; skip FDB high
0677 ffab 08                         INX             ; skip FDB low
0678 ffac 20 f4                      BRA      CMDLP  ; try next entry
0679                         
0680 ffae e6 01              FOUND   LDAB    1,X     ; B = target high byte (FDB stores high,low)
0681 ffb0 a6 02                      LDAA    2,X     ; A = target low byte
0682 ffb2 36                         PSHA            ; push high first
0683 ffb3 37                         PSHB            ; push low — now low is on top of stack
0684 ffb4 39                         RTS             ; jump to target
0685                         
0686                         ; This can probably be removed...
0687                         ;.DEFAULT JMP     START ; unknown command → ignore
0688                         
0689                         ; Command table: key, then FDB routine
0690 ffb5 53                 CMDTAB  FCB     'S
0691 ffb6 ff 39                      FDB     BRPTSET
0692 ffb8 48                         FCB     'H
0693 ffb9 ff 63                      FDB     HEADER
0694 ffbb 50                         FCB     'P
0695 ffbc fd e2                      FDB     PUNCH
0696 ffbe 4c                         FCB     'L
0697 ffbf fc e3                      FDB     LOAD
0698 ffc1 52                         FCB     'R
0699 ffc2 fd 36                      FDB     REGPRT
0700 ffc4 4d                         FCB     'M
0701 ffc5 fe 43                      FDB     MODIFY
0702 ffc7 47                         FCB     'G
0703 ffc8 fe c2                      FDB     GO
0704 ffca 43                         FCB     'C
0705 ffcb fe d9                      FDB     CONTNU
0706 ffcd 44                         FCB     'D
0707 ffce ff 07                      FDB     DUMP
0708 ffd0 54                         FCB     'T'
0709 ffd1 fd 62                      FDB     MEMTEST
0710 ffd3 00                         FCB     0       ; terminator
0711 ffd4 ff 8f                      FDB     START   ; not used (any value ok after 0)
0712                         
0713                         ; Transmit an address '0000' S9 terminating record
0714 ffd6 bd fc 76           STERMS  JSR     STRING
0715 ffd9 0d 0a                      FCB     $0D,$0A
0716 ffdb 53 39 30 33 30 30          FCC     "S9030000FC"
     30 30 46 43
0717 ffe5 ff                         FCB     $FF
0718 ffe6 20 a7                      BRA     START
0719                         
0720                         ; Reset the ACIAs
0721 ffe8 86 11              SETACIA LDAA    #$11    ; 8 Data, No Parity, 2 Stop Bits
0722 ffea b7 f4 01                   STAA    CTRLA   ;   ACIA.A
0723 ffed 86 01                      LDAA     #$01    ; 7 Data, Even Parity, 2 Stop Bits
0724 ffef b7 f4 03                   STAA     CTRLB   ;   ACIA.B
0725 fff2 39                         RTS
0726                         
0727 fff3 01                         NOP
0728 fff4 01                         NOP
0729 fff5 01                         NOP
0730 fff6 01                         NOP
