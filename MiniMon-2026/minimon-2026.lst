0431                         
0432 fe43 bd fc 65           MODIFY  JSR     RD_X    ; Get address to X
0433 fe46 bd fd 4d           STRT    JSR     PRSP    ; Print a space
0434 fe49 7f f0 f5                   CLR     T_R     ; T_R = 0
0435 fe4c a6 00              PRz     LDAA    0,X     ; Get byte pointed to by X to A
0436 fe4e bd fc c9                   JSR     ZOUT    ; Print it as 2.hex digits
0437 fe51 bd fc 00           WATSIT  JSR     RD_CMD  ; Get command character
0438 fe54 81 20              WHAT    CMPA    #$20    ; Is it a space ?
0439 fe56 26 0c                      BNE     ISSLSH  ; No: go test for slash
0440 fe58 08                 CARYON  INX             ; Increment X
0441 fe59 b6 f0 f5                   LDAA    T_R     ; A = T_R
0442 fe5c 81 16                      CMPA    #$16    ; At end of line ?
0443 fe5e 2f ec                      BLE     PRz     ; No: Loop back to continue
0444 fe60 8d 35              NEW_1   BSR     NEWLINE ; Print c/r l/f nul
0445 fe62 20 e2                      BRA     STRT    ; Loop back (Note: Hex was wrong in doc, E2 instead of E5)
0446                         
0447 fe64 81 2f              ISSLSH  CMPA    #'/     ; Is it a slash ?
0448 fe66 26 03                      BNE     ISCRET  ; No: go test for c/r
0449 fe68 09                         DEX             ; X = X - 1
0450 fe69 20 f5                      BRA     NEW_1   ; Loop back (print newline)
0451                         
0452 fe6b 81 0d              ISCRET  CMPA    #$0D    ; Is it a c/r ?
0453 fe6d 26 03                      BNE     ISHEX   ; No: go test for valid Hex
0454 fe6f 08                         INX             ; X = X + 1
0455 fe70 20 ee                      BRA     NEW_1   ; Loop back (print newline)
0456                         
0457 fe72 bd fc 1d           ISHEX   JSR     VHEX    ; Is it a valid hex character ?
0458 fe75 25 19                      BCS     PRQM    ; No: print `?` and ignore
0459 fe77 b7 f0 f6                   STAA    T_Q     ; T_Q = A : Save it
0460 fe7a bd fc 00                   JSR     RD_CMD  ; Get 2nd character
0461 fe7d bd fc 1d                   JSR     VHEX    ; Is it a valid hex character ?
0462 fe80 25 d2                      BCS     WHAT    ; No: then see what it is
0463 fe82 16                         TAB             ; B = A
0464 fe83 b6 f0 f6                   LDAA    T_Q     ; A = T_Q
0465 fe86 bd fc 31                   JSR     BINARY  ; Convert to binary value
0466 fe89 a7 00                      STAA    0,X     ; Store it
0467 fe8b bd fd 4d                   JSR     PRSP    ; Print a space
0468 fe8e 20 c8                      BRA     CARYON  ; Loop back
0469                         
0470 fe90 86 3f              PRQM    LDAA    #'?     ; Put `?` into A
0471 fe92 bd fc 0f                   JSR     PR_A    ; Print it
0472 fe95 20 ba                      BRA     WATSIT  ; Loop back
0473                         
0474 fe97 ff f0 e3           NEWLINE STX     T_SAVE  ; Save X
0475 fe9a bd fc 76                   JSR     STRING  ; Print string...
0476 fe9d 0d 0a 00                   FCB     $0D,$0A,$00
0477 fea0 ff                         FCB     $FF     ; End-of-string
0478 fea1 fe f0 e3                   LDX     T_SAVE  ; Restore X
0479 fea4 bd fc bb                   JSR     PRX     ; Print X
0480 fea7 39                         RTS             ; RETURN
0481                         
0482 fea8 eb 00              .fOutHx2    ADDB    0,X         ; Update checksum
0483 feaa 36                             PSHA                ; Push A to STACK
0484 feab a6 00                          LDAA    0,X         ; Load byte to be o/p
0485 fead bd fc c9                       JSR     ZOUT        ; O/P byte <- X
0486 feb0 32                             PULA                ; Pull A off STACK
0487 feb1 08                             INX                 ; Increment X
0488 feb2 39                             RTS                 ; RETURN
0489                         
0490 feb3                            RMB 12          ; previously the ALTER command
