   022A 7C 1A 0C      [ 6]  157         INC     IDLE_MSG_ID     ; set to next message for the next next time
   022D CE 12 21      [ 3]  158         LDX     #IDLEPTR        ; A has phrase ID, set X to the base address
   0230 BD 02 A6      [ 9]  159         JSR     PHRASE_OUT
