0139 02df b6 07 a0                   LDAA    LIGHT_MSG_ID
0140 02e2 81 01                      CMPA    #LIGHT_MSG_CNT  ; are we beyond the end of the list
0141 02e4 26 05                      BNE     LIGHT_OP        ; still at valid id so output idle message
