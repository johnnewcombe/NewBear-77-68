0568 fdb6 bd fc e3           PR_AND_SP   JSR     PR_BYTE     ; Print from A
0569 fdb9 bd fe 6c           PR_SPACE    JSR     PR_STR_JSR  ; Print string...
0570 fdbc 20                             FCC     " "         ; space
0571 fdbd 00                             FCB     C_EOS       ;
0572 fdbe 39                             RTS                 ; RETURN
