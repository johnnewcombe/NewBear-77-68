0647                         ; FF8F
0648                         ; -----------------------------------------------------
0649 ff8f 8e f0 d0           START   LDS     #STACK  ; Set up stack for MINMON
0650 ff92 86 11                      LDAA    #$11    ; Set up: 8N2
0651 ff94 b7 f4 01                   STAA    CTRLA   ;   ACIA.A
0652 ff97 bd fc 76                   JSR     STRING  ; Print string...
0653 ff9a 0d 0a 00 2a                FCB     $0D,$0A,$00,'*    ; c/r l/f null `*`
0654 ff9e ff                         FCB     $FF     ; End-of-string
0655 ff9f bd fc 00                   JSR     RD_CMD  ; Read a byte (test for `.`)
0656 ffa2 ce ff b8                   LDX     #CMDTAB     ; point to command table
0657 ffa5 e6 00              CMDLP   LDAB    0,X         ; B = key byte (0 ends table)
0658 ffa7 27 e6                      BEQ     START       ; end of table → default to START
0659 ffa9 11                         CBA                 ; compare A vs B
0660 ffaa 27 05                      BEQ     FOUND       ; match → dispatch
0661 ffac 08                         INX                 ; skip key
0662 ffad 08                         INX                 ; skip FDB high
0663 ffae 08                         INX                 ; skip FDB low
0664 ffaf 20 f4                      BRA      CMDLP      ; try next entry
0665                         
0666 ffb1 e6 01              FOUND   LDAB    1,X        ; B = target high byte (FDB stores high,low)
0667 ffb3 a6 02                      LDAA    2,X        ; A = target low byte
0668 ffb5 36                         PSHA                ; push high first
0669 ffb6 37                         PSHB                ; push low — now low is on top of stack
0670 ffb7 39                         RTS                 ; jump to target
0671                         
0672                         ; This can probably be removed...
0673                         ;.DEFAULT JMP     START      ; unknown command → ignore
0674                         
