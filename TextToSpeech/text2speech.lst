0040                         MAINLOOP:
0041                         ; -----------------------------------------------------
0042                         ; Data arrives at port B as four hex characters
0043                         ; -----------------------------------------------------
0044 0205 bd 02 ff                   JSR     GETDATA         ; value in T_WEIGHT, stones in A
0045 0208 24 6f                      BCC     IDLE            ; is it invalid i.e. carry clear
0046 020a 81 14                      CMPA    #20             ; more that 20 is too heavy
0047 020c 22 20                      BHI     TOOHEAVY
0048 020e b6 06 a6                   LDAA    T_WEIGHT+1      ; validate pounds
0049 0211 81 0d                      CMPA    #13             ; invalid pounds
0050 0213 22 45                      BHI     ERROR           ; error
0051 0215 bd 02 98                   JSR GREET               ; send a greeting message
0052                         
0053                                 ; all good so output the weight mesage
0054                                 ; TODO get phrase from phrase table as per other message output routines
0055 0218 bd 03 2e                   JSR     STRINGB
0056 021b 59 6f 75 20 77 65          FCC     "You weigh"
     69 67 68
0057 0224 00                         FCB     $00
0058 0225 fe 06 a5                   LDX     T_WEIGHT        ; restore X
0059 0228 bd 03 97                   JSR     PR_WEIGHT       ; weight back X so output the weight
0060                         
0061                                 ; TODO determine phrase category (light normal, heavy etc. and jump o the section
0062                         
0063 022b 7e 02 fc                   JMP END
