0076                         ;--------------------------------------------------------------
0077                         ; DECIMAL CONVERSION EXAMPLE
0078                         ;--------------------------------------------------------------
0079                                 ;JSR     PR_DEC          ; puts 3 decimal digits in DEC, DEC+1 and DEC+2
0080                                 ;LDAA    DEC+1           ; don't care about the hundreds        ADDA    #$30
0081                                 ;JSR     PR_WORD
0082                                 ;JSR     PR_SPCB
0083                                 ;LDAA    DEC+2
0084                                 ;JSR     PR_WORD
0085                         
0086                         ; -----------------------------------------------------
0087                         ; PR_DEC: Puts 3 decimal digits in DEC, DEC+1 and DEC+2
0088                         ;
0089                         ;       !! ONLY WORKS WITH VALUES BELOW 128 !!
0090                         ; -----------------------------------------------------
0091 0239 5f                 PR_DEC  CLRB            ; Clear B for hundreds
0092                         
0093 023a 81 64              HUND    CMPA    #100    ; 100 or more?
0094                         
0095 023c 2d 05                      BLT     TENS
0096 023e 80 64                      SUBA    #100    ; Sub 100
0097 0240 5c                         INCB            ; Increment hundred counter
0098 0241 20 f7                      BRA     HUND
0099                         
0100 0243 f7 05 a1           TENS    STAB    DEC     ; store the hundreds
0101                         
0102 0246 5f                         CLRB
0103 0247 81 0a              TENS1   CMPA    #10     ; 10 or more?
0104 0249 2d 05                      BLT     UNITS
0105 024b 80 0a                      SUBA    #10     ; Sub 10
0106 024d 5c                         INCB            ; Increment ten counter
0107 024e 20 f7                      BRA     TENS1
0108                         
0109 0250 f7 05 a2           UNITS   STAB    DEC+1
0110 0253 b7 05 a3                   STAA    DEC+2   ; Final remainder is units
0111                         
0112 0256 39                         RTS
0113                         
0114                         
0115                         ; -----------------------------------------------------
0116                         ; Print string FOLLOWING JSR ( terminated by $FF ) to
0117                         ; ACIA(b) and ACIA(b)
0118                         ; -----------------------------------------------------
0119 0257 30                 STRINGB TSX             ; Get loc. of return addr to X
0120 0258 ee 00                      LDX     0,X     ; Get return addr to X
0121 025a 09                         DEX             ; Point to byte before
0122 025b 08                 AGAIN   INX             ; Point to next byte
0123 025c a6 00                      LDAA    0,X     ; Get byte to be printed
0124 025e 81 ff                      CMPA    #$FF    ; End-string ?
0125 0260 27 07                      BEQ     ENDSTR  ; Yes: Go to finish up
0126 0262 bd fc 0f                   JSR     PR_A    ; Print the byte to ACIA(a) (A is maintained)
0127 0265 8d 40                      BSR     PR_B    ; Print the byte to ACIA(b)
0128 0267 20 f2                      BRA     AGAIN   ; Go back for next byte
0129 0269 31                 ENDSTR  INS             ; Clean up stack...
0130 026a 31                         INS             ;  ( pop off the return addr )
0131 026b 6e 01                      JMP     1,X     ; Jump back to caller (RETURN)
0132                         
0133                         ; -----------------------------------------------------
0134                         ; Prints a string pointed to by X
0135                         ; -----------------------------------------------------
0136 026d a6 00              STRINGBX    LDAA    0,X         ; get char
0137 026f 81 ff                          CMPA    #$FF        ; is character NULL?
0138 0271 27 08                          BEQ     DONEB       ; yes, end of string
0139 0273 bd fc 0f                       JSR     PR_A        ; Print the byte to ACIA(a) (A is maintained)
0140 0276 8d 2f                          BSR     PR_B        ; Print the byte to ACIA(b)
0141 0278 08                             INX
0142 0279 20 f2                          BRA     STRINGBX
0143 027b 39                 DONEB       RTS
0144                         
0145                         ; -----------------------------------------------------
0146                         ; Reads a character from ACIA(b) into A
0147                         ; -----------------------------------------------------
0148 027c 7c 05 a4           RD_B    INC     RND         ; simple way to get a random number
0149 027f b6 f4 03                   LDAA    CTRLB       ; Get ACIA.A status byte
0150 0282 85 01                      BITA    #01         ; Is byte ready in DATAb
0151 0284 27 f6                      BEQ     RD_B        ; No: Try again
0152 0286 b6 f4 02                   LDAA    DATAB       ; Get the data byte to A
0153 0289 84 7f                      ANDA    #$7F        ; Mask off parity bit if it exists
0154 028b 39                         RTS                 ; RETURN
0155                         
0156                         ; -----------------------------------------------------
0157                         ;
0158                         ; -----------------------------------------------------
0159 028c 8d ee              ZINB    BSR     RD_B    ; Read a character
0160 028e bd fc 1d                   JSR     VHEX    ; Is it a hex character ?
0161 0291 25 12                      BCS     Z_PRQM  ; No: go to print `?`
0162 0293 b7 05 98                   STAA    T_Q     ; Yes: Save Acc.A
0163 0296 8d e4                      BSR     RD_B    ; Read 2nd character
0164 0298 bd fc 1d                   JSR     VHEX    ; Is it a hex character ?
0165 029b 25 08                      BCS     Z_PRQM  ; No: go to print `?`
0166 029d 16                         TAB             ; Yes: Put it into Acc.B
0167 029e b6 05 98                   LDAA    T_Q     ; Retrieve 1st hex char to Acc.A
0168 02a1 bd fc 31                   JSR     BINARY  ; Convert A:B to binary
0169 02a4 39                         RTS             ; RETURN
0170                         Z_PRQM  ;LDAA    #'?     ; Load `?` into A
0171                                 ;BSR     PR_B    ; Print it
0172 02a5 20 e5                      BRA     ZINB    ; Go back to start of hex input
0173                         
0174                         ; -----------------------------------------------------
0175                         ; Print character in A to ACIA(b)
0176                         ; -----------------------------------------------------
0177 02a7 f6 f4 03           PR_B    LDAB    CTRLB   ; Get ACIA(a) status byte
0178 02aa c5 02                      BITB    #02     ; Is it busy ?
0179 02ac 27 f9                      BEQ     PR_B    ; Yes: Try again
0180 02ae b7 f4 02                   STAA    DATAB   ;  No: Send data
0181 02b1 39                 PRB_END RTS             ; RETURN
0182                         
0183                         ; -----------------------------------------------------
0184                         ; Read 4 hex digits and put value into X
0185                         ; -----------------------------------------------------
0186 02b2 8d d8              RD_XB   BSR     ZINB    ; Read 2 digit hex value into A
0187 02b4 b7 05 99                   STAA    T_Z     ; Save byte (most significant)
0188 02b7 8d d3                      BSR     ZINB    ; Read 2 digit hex value into A
0189 02b9 b7 05 9a                   STAA    T_Z+1   ; Save byte (least significant)
0190 02bc fe 05 99                   LDX     T_Z     ; Load full 4 hex value into X
0191 02bf 39                         RTS             ; RETURN
0192                         
0193                         ; -----------------------------------------------------
0194                         ; Prints the message " n stones n pounds"
0195                         ; place stones in MSB of X and pound in LSB
0196                         ; -----------------------------------------------------
0197                         PR_WEIGHT
0198 02c0 ff 05 9f                   STX     T_W
0199 02c3 b6 05 9f                   LDAA    T_W             ; Load high byte of X into Accumulator A
0200 02c6 bd 03 1a                   JSR     PR_WORD         ; n
0201 02c9 bd 02 e6                   JSR     PR_SPCB
0202 02cc 86 1b                      LDAA    #$1B
0203 02ce bd 03 1a                   JSR     PR_WORD         ; "stones"
0204 02d1 bd 02 e6                   JSR     PR_SPCB
0205 02d4 b6 05 a0                   LDAA    T_W+1            ; Load high byte of X into Accumulator A
0206 02d7 bd 03 1a                   JSR     PR_WORD         ; n
0207 02da 86 1c                      LDAA    #$1C
0208 02dc bd 02 e6                   JSR     PR_SPCB
0209 02df bd 03 1a                   JSR     PR_WORD         ; "pounds"
0210 02e2 bd 02 f1                   JSR     PR_CRB
0211 02e5 39                         RTS
0212                         
0213                         ; -----------------------------------------------------
0214                         ; Prints a space on both consoles (preserves A)
0215                         ; -----------------------------------------------------
0216 02e6 36                 PR_SPCB   PSHA
0217 02e7 86 20                      LDAA    #$20        ; Put space character in A
0218 02e9 bd fc 0f                   JSR     PR_A
0219 02ec bd 02 a7                   JSR     PR_B        ; Print it
0220 02ef 32                         PULA
0221 02f0 39                         RTS                 ; RETURN
0222                         
0223                         ; -----------------------------------------------------
0224                         ; Prints a CRLF on both consoles (preserves A)
0225                         ; -----------------------------------------------------
0226 02f1 36                 PR_CRB  PSHA
0227 02f2 86 0d                      LDAA    #$0D        ; Put CHAR character in A
0228 02f4 bd fc 0f                   JSR     PR_A
0229 02f7 bd 02 a7                   JSR     PR_B        ; Print it
0230 02fa 86 0a                      LDAA    #$0A
0231 02fc bd fc 0f                   JSR     PR_A
0232 02ff bd 02 a7                   JSR     PR_B        ; Print it
0233 0302 32                         PULA
0234 0303 39                         RTS                 ; RETURN
0235                         
