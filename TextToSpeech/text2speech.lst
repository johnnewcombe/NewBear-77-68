0375                         ; Outputs a phrase from the value in A
0376                         ; -----------------------------------------------------
0377                         
0378                         ;PR_PHRASE
0379                         ;        LDAA    0,X         ; get word id
0380                         ;        INX                 ; point X to next word
0381                         ;        STX     T_P         ; store X away
0382                         ;        CMPA    #0
0383                         ;        BEQ     PR_END      ; no more words
0384                         ;        JSR     PR_WORD     ; print word based on value in A
0385                         ;        JSR     PR_SPCB
0386                         ;        LDX     T_P        ; recover X
0387                         ;        BRA     PR_PHRASE   ; next word
0388                         ;PR_END  RTS
