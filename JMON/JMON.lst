0642                         ; FF81
0643                         ; -----------------------------------------------------
0644 ff81 8e f0 d0           RESET   LDS     #STACK  ; Set up stack for MINIMON
0645 ff84 86 03                      LDAA    #$03    ; Reset:
0646 ff86 b7 f4 01                   STAA    CTRLA   ;   ACIA.A
0647 ff89 b7 f4 03                   STAA    CTRLB   ;   ACIA.B
0648                         
