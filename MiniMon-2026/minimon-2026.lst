output:  minimon-2026.s19
0001                         ; ------------------------------------------------------
0002                         ; Minimon
0003                         ; ------------------------------------------------------
0004                         ;  Original author ACH, Dec.1978;
0005                         ; ------------------------------------------------------
0006                         ; 13 NOV 2025 : [JN] added NOP at FFF7 to remove gap to
0007                         ;             : allow easier conversion to bin from s19
0008                         ; 05 DEC 2025 : [JN] Changed ACIA(a) to be 8N2 to match
0009                         ;             : PROM. So that MiniMon can be loaded and
0010                         ;             : run from the same terminal config.
0011                         ; ------------------------------------------------------
0012                         ; 2 x ACIAs :-
0013                         ;
0014                         
0015 f401                    CTRLA   EQU     $F401   ; ACIA.A Ctrl/Status
0016 f403                    CTRLB   EQU     $F403   ; ACIA.B Ctrl/Status
0017 f400                    DATAA   EQU     $F400   ; ACIA.A Data register
0018 f402                    DATAB   EQU     $F402   ; ACIA.B Data register
0019                         
0020                         ; Note:The original 256 bytes of RAM on the CPU board 
0021                         ;  appears at $F000 to $F0FE, with Switches/LEDs at $F0FF
0022                         ;  when a MON1 board is installed
0023                         
0024                         ; Stack goes down from $F0D0
0025 f0d0                    STACK   EQU     $F0D0   ; Top of MINIMON's stack
0026                         
0027                         
0028                         
0029                         ; RAM at $F0D1 to $F0DC appears to be unused
0030                         
0031                         ; 3 bytes reserved for each if NMI and IRQ handling
0032                         ; so an application can write JMP <addr> into those
0033                         ; places if those interrupts are wanted...
0034                         
0035 f0dd                    JNMI    EQU     $F0DD   ; Space for jump to NMI sub.
0036 f0e0                    JIRQ    EQU     $F0E0   ; Space for jump to IRQ sub.
0037                         
0038                         ; -----------------------------------------------------
0039 f0d5                            ORG     $F0D5   ; Start of RAM variables
0040                         ; -----------------------------------------------------
0041                         ; Note: Temp storage variables renamed to get T_ prefix
0042                         ;       as some were sharing names with labels or registers
0043                         ;
0044                         ; New additions to support S19 additions
0045 f0d5                    d_RdFstX    RMB     2       ;  "  RD_ByteFast X
0046 f0d7                    d_Hx4X      RMB     2       ;  "  RDX4 PRX4
0047 f0d9                    d_TW        RMB     2       ;  "  S19
0048 f0db                    d_STOP      RMB     2       ;  "  ASK_Addrs `Stop:`
0049 f0dd                    b_Csum      RMB     1       ;  "  S19
0050 f0de                    b_Count     RMB     1       ;  "  S19
0051 f0df                    b_Temp      RMB     1       ;  "  S19
0052 f0e0                    d_START     RMB     2       ;  "  ASK_Start `Start:`
0053 f0e2                    b_Q         RMB     1       ;  "  ZIN,DUMP
0054                         
0055 f0e3                    T_SAVE  RMB     2       ; Temp storage for NEWLINE
0056 f0e5                    T_P     RMB     1       ;   "     "     "  Z,X
0057 f0e6                    T_X     RMB     2       ;   "     "     "  Sub
0058 f0e8                    T_Y     RMB     2       ;   "     "     "  Sub
0059 f0ea                    T_NEW   RMB     2       ;   "     "     "  Block move
0060 f0ec                    T_M     RMB     1       ;   "     "     "  ZOUT
0061 f0ed                    T_TMPX  RMB     2       ;   "     "     "  PRX
0062 f0ef                    T_STRT  RMB     2       ;   "     "     "  GETADDRESS
0063 f0f1                    T_STOP  RMB     2       ;   "     "     "  GETADDRESS
0064 f0f3                    T_Z     RMB     2       ;   "     "     "   . RDX
0065 f0f5                    T_R     RMB     1       ;   "     "     "     PR
0066 f0f6                    T_Q     RMB     1       ;   "     "     "  ZIN,DUMP 
0067 f0f7                    T_ABYT  RMB     2       ;   "     "     "  SET BR.PT.
0068 f0f9                            RMB     2       ;   "     "     "  SET BR.PT.
0069 f0fb                    T_BYTE  RMB     2       ;   "     "     "  SET BR.PT.
0070 f0fd                    PSTACK  RMB     2       ;   "     "     "     SWI etc
0071                         
0072                         
0073                         
0074                         ;
0075                         ; -----------------------------------------------------
0076 ec00                            ORG     $EC00   ; Start of ROM based code
0077                         ; -----------------------------------------------------
0078 ec00 bd ed 2b           RD_CMD  JSR     RD_A    ; Input one character 
0079 ec03 27 fb                      BEQ     RD_CMD  ; Ignore paper tape follower
0080 ec05 8d 08                      BSR     PR_A    ; Echo character
0081 ec07 81 2e                      CMPA    #'.     ; Was it a fullstop ?
0082 ec09 26 03                      BNE     END_RD  ;
0083 ec0b 7e ef 8f                   JMP     START   ; Yes: Go to start of MINIMON
0084 ec0e 39                 END_RD  RTS             ;  No: RETURN
0085                         
0086                         ; -----------------------------------------------------
0087                         ; Print character in A
0088                         
0089 ec0f f6 f4 01           PR_A    LDAB    CTRLA   ; Get ACIA(a) status byte
0090 ec12 c5 02                      BITB    #02     ; Is it busy ?
0091 ec14 27 f9                      BEQ     PR_A    ; Yes: Try again
0092 ec16 b7 f4 00                   STAA    DATAA   ;  No: Send data
0093 ec19 7c f0 f5                   INC     T_R     ; Characters printed + One
0094 ec1c 39                         RTS             ; RETURN
0095                         
0096                         ; -----------------------------------------------------
0097                         ; Check A contains a HEX character,  Set C.bit on fail
0098                         
0099 ec1d 81 2f              VHEX    CMPA    #$2F    ; A < 30 ?
0100 ec1f 2f 0e                      BLE     NotHex  ;  not hex
0101 ec21 81 39                      CMPA    #$39    ; A > 39 ?    
0102 ec23 22 02                      BHI     NotNum  ;  Not a Numeral
0103 ec25 0c                 IsHex   CLC             ; It's OK (clear C bit)
0104 ec26 39                         RTS             ; RETURN
0105 ec27 81 40              NotNum  CMPA    #$40    ; A < 41 ?
0106 ec29 2f 04                      BLE     NotHex  ;  not hex
0107 ec2b 81 46                      CMPA    #$46    ; A <= 46
0108 ec2d 2f f6                      BLE     IsHex   ;  then it is hex
0109 ec2f 0d                 NotHex  SEC             ; Set C bit
0110 ec30 39                         RTS             ; RETURN
0111                         
0112                         ; -----------------------------------------------------
0113                         
0114 ec31 85 30              BINARY  BITA    #$30    ; Is it a letter ?
0115 ec33 27 0c                      BEQ     LETTA   ; Yes: Got to handle it
0116 ec35 48                 RIDA    ASLA            ;  No: It is a number, so
0117 ec36 48                         ASLA            ;      shift
0118 ec37 48                         ASLA            ;       left
0119 ec38 48                         ASLA            ;        4 bits
0120 ec39 c5 30                      BITB    #$30    ; Is Acc.B a letter ?
0121 ec3b 27 08                      BEQ     LETTB   ; Yes: Go handle it
0122 ec3d c4 0f              RIDB    ANDB    #$0F    ; Clear 4 high bits in Acc.B
0123 ec3f 1b                         ABA             ; Form binary character (A=A+B)
0124 ec40 39                         RTS             ; RETURN
0125 ec41 8b 09              LETTA   ADDA    #$09    ; Make Acc.A a binary
0126 ec43 20 f0                      BRA     RIDA    ;  as before
0127 ec45 cb 09              LETTB   ADDB    #$09    ; Make Acc.B a binary
0128 ec47 20 f4                      BRA     RIDB    ;  as before
0129                         
0130                         ; -----------------------------------------------------
0131                         ; Read a 4 digit HEX value, put result into X
0132                         
0133 ec49 8d b5              ZIN     BSR     RD_CMD  ; Read a character
0134 ec4b 8d d0                      BSR     VHEX    ; Is it a hex character ?
0135 ec4d 25 10                      BCS     Z_PRQM  ; No: go to print `?`
0136 ec4f b7 f0 f6                   STAA    T_Q     ; Yes: Save Acc.A
0137 ec52 8d ac                      BSR     RD_CMD  ; Read 2nd character
0138 ec54 8d c7                      BSR     VHEX    ; Is it a hex character ?
0139 ec56 25 07                      BCS     Z_PRQM  ; No: go to print `?`
0140 ec58 16                         TAB             ; Yes: Put it into Acc.B
0141 ec59 b6 f0 f6                   LDAA    T_Q     ; Retrieve 1st hex char to Acc.A
0142 ec5c 8d d3                      BSR     BINARY  ; Convert A:B to binary
0143 ec5e 39                         RTS             ; RETURN
0144 ec5f 86 3f              Z_PRQM  LDAA    #'?     ; Load `?` into A
0145 ec61 8d ac                      BSR     PR_A    ; Print it
0146 ec63 20 e4                      BRA     ZIN     ; Go back to start of hex input
0147                         
0148                         ; -----------------------------------------------------
0149                         ; Read 4 hex digits and put value into X
0150                         
0151 ec65 bd ed 4d           RD_X    JSR     PRSP    ; Print a space
0152 ec68 8d df                      BSR     ZIN     ; Read 2 digit hex value into A
0153 ec6a b7 f0 f3                   STAA    T_Z     ; Save byte (most significant)
0154 ec6d 8d da                      BSR     ZIN     ; Read 2 digit hex value into A
0155 ec6f b7 f0 f4                   STAA    T_Z+1   ; Save byte (least significant)
0156 ec72 fe f0 f3                   LDX     T_Z     ; Load full 4 hex value into X
0157 ec75 39                         RTS             ; RETURN
0158                         
0159                         ; -----------------------------------------------------
0160                         ; Print string FOLLOWING JSR ( terminated by $FF )
0161                         ;  IE: It starts at the `return addr` put onto the stack by JSR
0162                         ;  So actual return address needed is past the string
0163                         ;                       
0164 ec76 30                 STRING  TSX             ; Get loc. of return addr to X
0165 ec77 ee 00                      LDX     0,X     ; Get return addr to X
0166 ec79 09                         DEX             ; Point to byte before
0167 ec7a 08                 AGAIN   INX             ; Point to next byte
0168 ec7b a6 00                      LDAA    0,X     ; Get byte to be printed
0169 ec7d 81 ff                      CMPA    #$FF    ; End-string ?
0170 ec7f 27 04                      BEQ     ENDSTR  ; Yes: Go to finish up
0171 ec81 8d 8c                      BSR     PR_A    ; Print the byte
0172 ec83 20 f5                      BRA     AGAIN   ; Go back for next byte
0173 ec85 31                 ENDSTR  INS             ; Clean up stack...
0174 ec86 31                         INS             ;  ( pop off the return addr )
0175 ec87 6e 01                      JMP     1,X     ; Jump back to caller (RETURN)
0176                         
0177                         ; -----------------------------------------------------
0178                         ; 
0179 ec89 8d eb              GETADD  BSR     STRING  ; Print string...
0180 ec8b 20 53                      FCC     " S"    ;
0181 ec8d ff                         FCB     $FF     ; End-of-string
0182 ec8e 8d d5                      BSR     RD_X    ; Read 4 digit HEX addr value
0183 ec90 ff f0 ef                   STX     T_STRT  ; Save it
0184 ec93 8d e1                      BSR     STRING  ; Print string...
0185 ec95 20 46                      FCC     " F"    ;
0186 ec97 ff                         FCB     $FF     ; End-of-string
0187 ec98 8d cb                      BSR     RD_X    ; Read 4 digit HEX addr value
0188 ec9a ff f0 f1                   STX     T_STOP  ; Save it
0189 ec9d 39                         RTS             ; RETURN
0190                         
0191                         ; -----------------------------------------------------
0192                         ; Convert value in A to 2 x ASCII hex digits in A and B
0193                         
0194 ec9e 16                 ASCII   TAB             ; Copy A to B
0195 ec9f 84 f0                      ANDA    #$F0    ; Clear low order 4 bits of A
0196 eca1 44                         LSRA            ; Shift
0197 eca2 44                         LSRA            ;  right
0198 eca3 44                         LSRA            ;   4
0199 eca4 44                         LSRA            ;    bits
0200 eca5 81 09                      CMPA    #$09    ; Letter or number ?
0201 eca7 22 0b                      BHI     SUBT    ; 
0202 eca9 8b 30                      ADDA    #$30    ; Make it an ASCII number
0203 ecab c4 0f              AND     ANDB    #$0F    ; Clear high order bits of B
0204 ecad c1 09                      CMPB    #$09    ; Letter or number ?
0205 ecaf 22 07                      BHI     ADD     ;
0206 ecb1 cb 30                      ADDB    #$30    ; Make it an ASCII number
0207 ecb3 39                         RTS             ; RETURN
0208 ecb4 8b 37              SUBT    ADDA    #$37    ; Make it an ASCI letter
0209 ecb6 20 f3                      BRA     AND     ; Go to process low order value
0210 ecb8 cb 37              ADD     ADDB    #$37    ; Make it an ASII letter
0211 ecba 39                         RTS             ; RETURN
0212                         
0213                         ; -----------------------------------------------------
0214                         ; Print value in X as 4 hex digits
0215                         
0216 ecbb ff f0 ed           PRX     STX     T_TMPX  ; Save X
0217 ecbe b6 f0 ed                   LDAA    T_TMPX  ; Get high order byte to A
0218 ecc1 8d 06                      BSR     ZOUT    ; Print A as 2 hex digits
0219 ecc3 b6 f0 ee                   LDAA    T_TMPX+1 ; Get low order byte to A
0220 ecc6 8d 01                      BSR     ZOUT    ; Print A as 2 hex digits
0221 ecc8 39                         RTS             ; RETURN
0222                         
0223                         ; -----------------------------------------------------
0224                         ; Print value in A as 2 hex digits
0225                         
0226 ecc9 8d d3              ZOUT    BSR     ASCII   ; Convert A to ASCII in A & B
0227 eccb f7 f0 ec                   STAB    T_M     ; Save B
0228 ecce bd ec 0f                   JSR     PR_A    ; Print byte in A
0229 ecd1 b6 f0 ec                   LDAA    T_M     ; Get 2nd byte into A
0230 ecd4 bd ec 0f                   JSR     PR_A    ; Print byte in A
0231 ecd7 39                         RTS             ; RETURN
0232                         
0233                         ; -----------------------------------------------------
0234                         
0235                         PUNCH
0236 ecd8                            RMB 47
0237                         
0238                         ; -----------------------------------------------------
0239                         LOAD
0240 ed07                            RMB 36          ; spare byes
0241                         
0242                         ; -----------------------------------------------------
0243                         ; Read byte from ACIA.A to A
0244                         ;FD2B
0245 ed2b b6 f4 01           RD_A    LDAA    CTRLA   ; Get ACIA.A status byte
0246 ed2e 85 01                      BITA    #$01    ; Is byte ready in DATAA
0247 ed30 27 f9                      BEQ     RD_A    ; No: Try again
0248 ed32 b6 f4 00                   LDAA    DATAA   ; Get the data byte to A
0249 ed35 39                         RTS             ; RETURN
0250                         
0251                         ; -----------------------------------------------------
0252 ed36 8d 15              REGPRT  BSR     PRSP    ; Print a space
0253 ed38 fe f0 fd                   LDX     PSTACK  ; Point X at user's stack
0254 ed3b 8d 1c                      BSR     PR2     ; Print CC
0255 ed3d 8d 1a                      BSR     PR2     ; Print B
0256 ed3f 8d 18                      BSR     PR2     ; Print A
0257 ed41 8d 10                      BSR     PR4     ; Print X
0258 ed43 8d 0e                      BSR     PR4     ; Print PC
0259 ed45 ce f0 fd                   LDX     #PSTACK ; Point X at stack pointer
0260 ed48 8d 0a                      BSR     PR4X    ; Print stack pointer
0261 ed4a 7e ef 8f                   JMP     START   ; (RETURN) to MINIMON
0262                         
0263                         ; -----------------------------------------------------
0264 ed4d 86 20              PRSP    LDAA    #$20    ; Put space character in A
0265 ed4f bd ec 0f                   JSR     PR_A    ; Print it
0266 ed52 39                         RTS             ; RETURN
0267                         
0268 ed53 08                 PR4     INX             ; Point X to next character
0269 ed54 a6 00              PR4X    LDAA    0,X     ; Get byte pointed to by X
0270 ed56 bd ec c9                   JSR     ZOUT    ; Print it
0271 ed59 08                 PR2     INX             ; Point X to next character
0272 ed5a a6 00                      LDAA    0,X     ; Get byte pointed to by X
0273 ed5c bd ec c9                   JSR     ZOUT    ; Print it
0274 ed5f 8d ec                      BSR     PRSP    ; Print a space
0275 ed61 39                         RTS             ; RETURN
0276                         
0277                         ; -----------------------------------------------------
0278 ed62 bd ec 89           BLKMOV  JSR     GETADD  ; Prompt for boundary addresses
0279 ed65 bd ec 76                   JSR     STRING  ; Print string...
0280 ed68 20 54 6f                   FCC     " To"   ;
0281 ed6b ff                         FCB     $FF     ; End-of-string
0282 ed6c bd ec 65                   JSR     RD_X    ; Read 4 hex digit value into X
0283 ed6f ff f0 ea                   STX     T_NEW   ; Store it as NEW start address
0284 ed72 ff f0 e6                   STX     T_X     ;   "    "
0285 ed75 fe f0 ef                   LDX     T_STRT  ; Put start address into X
0286 ed78 ff f0 e8                   STX     T_Y     ; Store it
0287 ed7b 8d 59                      BSR     SUB     ; Perform T_X minus T_Y
0288 ed7d 2a 23                      BPL     DOWN    ; Go to Move downwards
0289 ed7f fe f0 f1                   LDX     T_STOP  ; Get the STOP stop address
0290 ed82 08                         INX             ; Add 1 to it
0291 ed83 ff f0 f1                   STX     T_STOP  ; and save it
0292 ed86 fe f0 ef           DO_UP   LDX     T_STRT  ; Get START address
0293 ed89 bc f0 f1                   CPX     T_STOP  ; Compare it with STOP
0294 ed8c 26 03                      BNE     CONT_A  ; Finished ?
0295 ed8e 7e ef 8f           STARTB  JMP     START   ; Yes: back to MINIMON
0296 ed91 a6 00              CONT_A  LDAA    0,X     ; No: Get data
0297 ed93 08                         INX             ; Point X to next `old` address
0298 ed94 ff f0 ef                   STX     T_STRT  ; and store it
0299 ed97 fe f0 ea                   LDX     T_NEW   ; get address of NEW location
0300 ed9a a7 00                      STAA    0,X     ; Store the data at NEW address
0301 ed9c 08                         INX             ; Point X to next `new` address
0302 ed9d ff f0 ea                   STX     T_NEW   ; and store it
0303 eda0 20 e4                      BRA     DO_UP   ; loop back for next byte
0304 eda2 fe f0 f1           DOWN    LDX     T_STOP  ; Get end address
0305 eda5 ff f0 e6                   STX     T_X     ; Store it
0306 eda8 8d 2c                      BSR     SUB     ; Perform T_X minus T_Y
0307 edaa bb f0 eb                   ADDA    T_NEW+1 ; Add NEW (low.byte) to A
0308 edad fb f0 ea                   ADDB    T_NEW   ; Add NEW (high.byte) to B
0309 edb0 b7 f0 eb                   STAA    T_NEW+1 ; Save NEW (low.byte)
0310 edb3 f7 f0 ea                   STAB    T_NEW   ;         (high.byte)
0311 edb6 fe f0 ef                   LDX     T_STRT  ; Get START address
0312 edb9 09                         DEX             ; Subract 1 from X
0313 edba ff f0 ef                   STX     T_STRT  ; Store it
0314 edbd fe f0 f1           DO_DOWN LDX     T_STOP  ; Get STOP address
0315 edc0 bc f0 ef                   CPX     T_STRT  ; Compare it with START address
0316 edc3 27 c9                      BEQ     STARTB  ; Effecively `JMP START`
0317 edc5 a6 00                      LDAA    0,X     ; Get data
0318 edc7 09                         DEX             ; Subract 1 from X
0319 edc8 ff f0 f1                   STX     T_STOP  ; Store it
0320 edcb fe f0 ea                   LDX     T_NEW   ; Load NEW loc address into X
0321 edce a7 00                      STAA    0,X     ; Store the data as NEW address
0322 edd0 09                         DEX             ; Point X to next `new` address
0323 edd1 ff f0 ea                   STX     T_NEW   ; Store it
0324 edd4 20 e7                      BRA     DO_DOWN ; Loop back for next byte
0325                         
0326                         ; -----------------------------------------------------
0327 edd6 ce f0 e6           SUB     LDX     #T_X    ; Point X to start of T_X data
0328 edd9 a6 01                      LDAA    1,X     ; A = T_X (low)
0329 eddb e6 00                      LDAB    0,X     ; B = T_X (high)
0330 eddd a0 03                      SUBA    3,X     ; A = A - T_Y (low)
0331 eddf e2 02                      SBCB    2,X     ; B = B - T_Y (high)
0332 ede1 39                         RTS             ; RETURN
0333                         
0334 ede2                            RMB 81          ; previously X and Z commands
0335                         
0336                         ; -----------------------------------------------------
0337                         ;FE33
0338 ee33 bd ec 76           PRP     JSR     STRING  ; Print string...
0339 ee36 20 50 20                   FCC     " P "   ;
0340 ee39 ff                         FCB     $FF     ; End-of-string
0341 ee3a 39                         RTS             ; RETURN
0342                         
0343                         ; -----------------------------------------------------
0344 ee3b bd ec 76           PRD     JSR     STRING  ; Print string...
0345 ee3e 20 44 20                   FCC     " D "   ;
0346 ee41 ff                         FCB     $FF     ; End-of-string
0347 ee42 39                         RTS             ; RETURN
0348                         
0349                         ; -----------------------------------------------------
0350 ee43 bd ec 65           MODIFY  JSR     RD_X    ; Get address to X
0351 ee46 bd ed 4d           STRT    JSR     PRSP    ; Print a space
0352 ee49 7f f0 f5                   CLR     T_R     ; T_R = 0
0353 ee4c a6 00              PRz     LDAA    0,X     ; Get byte pointed to by X to A
0354 ee4e bd ec c9                   JSR     ZOUT    ; Print it as 2.hex digits
0355 ee51 bd ec 00           WATSIT  JSR     RD_CMD  ; Get command character
0356 ee54 81 20              WHAT    CMPA    #$20    ; Is it a space ?
0357 ee56 26 0c                      BNE     ISSLSH  ; No: go test for slash
0358 ee58 08                 CARYON  INX             ; Increment X
0359 ee59 b6 f0 f5                   LDAA    T_R     ; A = T_R
0360 ee5c 81 16                      CMPA    #$16    ; At end of line ?
0361 ee5e 2f ec                      BLE     PRz     ; No: Loop back to continue
0362 ee60 8d 35              NEW_1   BSR     NEWLINE ; Print c/r l/f nul
0363 ee62 20 e2                      BRA     STRT    ; Loop back (Note: Hex was wrong in doc, E2 instead of E5)
0364                         
0365 ee64 81 2f              ISSLSH  CMPA    #'/     ; Is it a slash ?
0366 ee66 26 03                      BNE     ISCRET  ; No: go test for c/r
0367 ee68 09                         DEX             ; X = X - 1
0368 ee69 20 f5                      BRA     NEW_1   ; Loop back (print newline)
0369                         
0370 ee6b 81 0d              ISCRET  CMPA    #$0D    ; Is it a c/r ?
0371 ee6d 26 03                      BNE     ISHEX   ; No: go test for valid Hex
0372 ee6f 08                         INX             ; X = X + 1
0373 ee70 20 ee                      BRA     NEW_1   ; Loop back (print newline)
0374                         
0375 ee72 bd ec 1d           ISHEX   JSR     VHEX    ; Is it a valid hex character ?
0376 ee75 25 19                      BCS     PRQM    ; No: print `?` and ignore
0377 ee77 b7 f0 f6                   STAA    T_Q     ; T_Q = A : Save it
0378 ee7a bd ec 00                   JSR     RD_CMD  ; Get 2nd character
0379 ee7d bd ec 1d                   JSR     VHEX    ; Is it a valid hex character ?
0380 ee80 25 d2                      BCS     WHAT    ; No: then see what it is
0381 ee82 16                         TAB             ; B = A
0382 ee83 b6 f0 f6                   LDAA    T_Q     ; A = T_Q
0383 ee86 bd ec 31                   JSR     BINARY  ; Convert to binary value
0384 ee89 a7 00                      STAA    0,X     ; Store it
0385 ee8b bd ed 4d                   JSR     PRSP    ; Print a space
0386 ee8e 20 c8                      BRA     CARYON  ; Loop back
0387                         
0388 ee90 86 3f              PRQM    LDAA    #'?     ; Put `?` into A
0389 ee92 bd ec 0f                   JSR     PR_A    ; Print it
0390 ee95 20 ba                      BRA     WATSIT  ; Loop back
0391                         
0392 ee97 ff f0 e3           NEWLINE STX     T_SAVE  ; Save X
0393 ee9a bd ec 76                   JSR     STRING  ; Print string...
0394 ee9d 0d 0a 00                   FCB     $0D,$0A,$00
0395 eea0 ff                         FCB     $FF     ; End-of-string
0396 eea1 fe f0 e3                   LDX     T_SAVE  ; Restore X
0397 eea4 bd ec bb                   JSR     PRX     ; Print X
0398 eea7 39                         RTS             ; RETURN
0399                         
0400                         
0401 eea8                            RMB 26          ; previously the ALTER command
0402                         
0403                         ;FEC2
0404 eec2 bd ec 65           GO      JSR     RD_X    ; Get address to X (16.bit)
0405 eec5 bd ec 00                   JSR     RD_CMD  ; Right address ?
0406 eec8 b6 f0 f4                   LDAA    T_Z+1   ; T_Z.low to A
0407 eecb f6 f0 f3                   LDAB    T_Z     ; T_Z.high to B
0408 eece fe f0 fd           GOTO    LDX     PSTACK  ; Callers stack address to X
0409 eed1 a7 07                      STAA    7,X     ; Put new return
0410 eed3 e7 06                      STAB    6,X     ; address on stack
0411 eed5 be f0 fd                   LDS     PSTACK  ; Set up calling programs stack
0412 eed8 3b                         RTI             ; RETURN-FROM-INTERRUPT (SWI)
0413                         
0414 eed9 bd ec 00           CONTNU  JSR     RD_CMD  ; Read a byte (test for `.`)
0415 eedc 81 31                      CMPA    #'1     ; Is it `1` ?
0416 eede 26 10                      BNE     IsIt2  ; No: go test for `2`
0417 eee0 fe f0 f7                   LDX     T_ABYT  ; Get address of break.point
0418 eee3 b6 f0 fb                   LDAA    T_BYTE  ; Get saved opcode
0419 eee6 a7 00                      STAA    0,X     ; Put it back in the program
0420 eee8 b6 f0 f8                   LDAA    T_ABYT+1 ; Get address at which
0421 eeeb f6 f0 f7                   LDAB    T_ABYT  ;   to re-enter program
0422 eeee 20 de                      BRA     GOTO    ; Go to calling program
0423                         
0424 eef0 81 32              IsIt2   CMPA    #'2     ; Is it `2`
0425 eef2 27 03                      BEQ     G_Is2   ; Yes: go process it
0426 eef4 7e ef 8f                   JMP     START   ; No: Return to MINIMON
0427 eef7 fe f0 f9           G_Is2   LDX     T_ABYT+2 ; Get addr. of break.point 2
0428 eefa b6 f0 fc                   LDAA    T_BYTE+1 ; Get old opcode
0429 eefd a7 00                      STAA    0,X      ; Put it back
0430 eeff b6 f0 fa                   LDAA    T_ABYT+3 ; Load address to start
0431 ef02 f6 f0 f9                   LDAB    T_ABYT+2 ;  running program at
0432 ef05 20 c7                      BRA     GOTO    ; Run user program
0433                         
0434                         ; -----------------------------------------------------
0435 ef07 bd ec 89           DUMP    JSR     GETADD  ; Prompt for boundary addresses
0436 ef0a fe f0 ef                   LDX     T_STRT  ;
0437 ef0d bd ee 97           D_NEW   JSR     NEWLINE ; Print c/r l/f nul
0438 ef10 86 08                      LDAA    #$08    ;
0439 ef12 b7 f0 f6                   STAA    T_Q     ; T_Q = 8
0440 ef15 09                         DEX             ; X = X - 1
0441 ef16 08                 D_NXT   INX             ; X = X + 1
0442 ef17 bd ed 4d                   JSR     PRSP    ; Print a space
0443 ef1a a6 00                      LDAA    0,X     ; Get a byte
0444 ef1c bd ec c9                   JSR     ZOUT    ; Print it as 2.hex digits
0445 ef1f bc f0 f1                   CPX     T_STOP  ; Finished ?
0446 ef22 26 06                      BNE     D_CNT   ; No: Carry on
0447 ef24 b6 f4 00           D_END   LDAA    DATAA   ; Get a byte from ACIA (clear)
0448 ef27 7e ef 8f                   JMP     START   ; Return to MINIMON
0449 ef2a b6 f4 01           D_CNT   LDAA    CTRLA   ; Read ACIA status
0450 ef2d 85 01                      BITA    #$01    ; Stop dump ?
0451 ef2f 26 f3                      BNE     D_END   ; Yes; go clear ACIA etc
0452 ef31 7a f0 f6                   DEC     T_Q     ; New line needed ?
0453 ef34 26 e0                      BNE     D_NXT   ; No: Loop back
0454 ef36 08                         INX             ; Print next byte
0455 ef37 20 d4                      BRA     D_NEW   ;  on a new line
0456                         
0457                         ; -----------------------------------------------------
0458 ef39 bd ec 00           BRPTSET JSR     RD_CMD  ; Read a byte (test for `.`)
0459 ef3c 81 31                      CMPA    #'1     ; Is it `1` ?
0460 ef3e 26 12                      BNE     Is2b    ; No: go test for `2`
0461 ef40 bd ec 65                   JSR     RD_X    ; Read addr value into X
0462 ef43 a6 00                      LDAA    0,X     ; Get the opcode
0463 ef45 b7 f0 fb                   STAA    T_BYTE  ; Save it
0464 ef48 ff f0 f7                   STX     T_ABYT  ; and the address
0465 ef4b 86 3f              SAME    LDAA    #$3F    ; `SWI` opcode :
0466 ef4d a7 00                      STAA    0,X     ;   set the breakpoint
0467 ef4f 7e ef 8f           ENDB    JMP     START   ; Return to MINIMON
0468 ef52 81 32              Is2b    CMPA    #'2     ; Is it `2` ?
0469 ef54 26 f9                      BNE     ENDB   ; No: Return to MINIMON
0470 ef56 bd ec 65                   JSR     RD_X    ; Read address into X
0471 ef59 a6 00                      LDAA    0,X     ; Get opcode
0472 ef5b b7 f0 fc                   STAA    T_BYTE+1 ; Save it
0473 ef5e ff f0 f9                   STX     T_ABYT+2 ; Save address
0474 ef61 20 e8                      BRA     SAME    ; Set the breakpoint
0475                         
0476                         ; -----------------------------------------------------
0477 ef63 bd ec 76           HEADER  JSR     STRING  ; print string...
0478 ef66 20 43 43                   FCC     " CC"   ;
0479 ef69 20 42 20                   FCC     " B "   ;
0480 ef6c 20 41 20                   FCC     " A "   ;
0481 ef6f 20 20 58                   FCC     "  X"   ;
0482 ef72 20 20 20                   FCC     "   "   ;
0483 ef75 20 50 43                   FCC     " PC"   ;
0484 ef78 20 20 20                   FCC     "   "   ;
0485 ef7b 53 50                      FCC     "SP"    ;
0486 ef7d ff                         FCB     $FF     ; End-of-string
0487 ef7e 7e ef 8f                   JMP     START   ; Return to MINIMON
0488 ef81 8e f0 d0           RESET   LDS     #STACK  ; Set up stack for MINIMON
0489 ef84 86 03                      LDAA    #$03    ; Reset:
0490 ef86 b7 f4 01                   STAA    CTRLA   ;   ACIA.A
0491 ef89 b7 f4 03                   STAA    CTRLB   ;   ACIA.B
0492 ef8c bf f0 fd           SWI     STS     PSTACK  ; Save callers stack pointer
0493 ef8f 8e f0 d0           START   LDS     #STACK  ; Set up stack for MINMON
0494 ef92 86 11                      LDAA    #$11    ; Set up:
0495 ef94 b7 f4 01                   STAA    CTRLA   ;   ACIA.A
0496 ef97 bd ec 76                   JSR     STRING  ; Print string...
0497 ef9a 0d 0a 00 2a                FCB     $0D,$0A,$00,'*    ; c/r l/f null `*`
0498 ef9e ff                         FCB     $FF     ; End-of-string
0499 ef9f bd ec 00                   JSR     RD_CMD  ; Read a byte (test for `.`)
0500 efa2 81 53                      CMPA    #'S     ; Is it `S` ?
0501 efa4 27 93                      BEQ     BRPTSET ; Yes: Set breakpoint cmd
0502 efa6 81 48                      CMPA    #'H     ; Is it `H` ?
0503 efa8 27 b9                      BEQ     HEADER  ;
0504 efaa 81 50                      CMPA    #'P     ; Is it `P` ?
0505 efac 26 03                      BNE     L1      ; No: Skip
0506 efae 7e ec d8                   JMP     PUNCH   ;
0507 efb1 81 4c              L1      CMPA    #'L     ; Is it `L` ?
0508 efb3 26 03                      BNE     L2      ; No: Skip
0509 efb5 7e ed 07                   JMP     LOAD    ;
0510 efb8 81 52              L2      CMPA    #'R     ; Is it `R`
0511 efba 26 03                      BNE     L3      ; No: Skip
0512 efbc 7e ed 36                   JMP     REGPRT  ;
0513 efbf 81 42              L3      CMPA    #'B     ; Is it `B` ?
0514 efc1 26 03                      BNE     L6      ; No: Skip
0515 efc3 7e ed 62                   JMP     BLKMOV  ;
0516 efc6 81 4d              L6      CMPA    #'M     ; Is it `M` ?
0517 efc8 26 03                      BNE     L8      ; No: Skip
0518 efca 7e ee 43                   JMP     MODIFY  ;
0519 efcd 81 47              L8      CMPA    #'G     ; Is it `G` ?
0520 efcf 26 03                      BNE     L9      ; No: Skip
0521 efd1 7e ee c2                   JMP     GO      ;
0522 efd4 81 43              L9      CMPA    #'C     ; Is it `C` ?
0523 efd6 26 03                      BNE     L10     ; No: Skip
0524 efd8 7e ee d9                   JMP     CONTNU  ;
0525 efdb 81 44              L10     CMPA    #'D     ; Is it `D` ?
0526 efdd 26 b0                      BNE     START   ; No: Give up - ignore comand
0527 efdf 7e ef 07                   JMP     DUMP    ;
0528                         
0529                                 ; [JN] The code above ends at address FFF6 and
0530                                 ; there is no instruction at FFF7. Vectors
0531                                 ; start at FFF8 (see ORG statement below)
0532                                 ; Putting a NOP at FFF7 ensures there is no gap
0533                                 ; and allows for an easy conversion from s19 to
0534                                 ; binary.
0535 efe2 01                         NOP
0536                         
0537                         ; ============================================================================
0538                         ; This is the new load and save routines to be integrated into this monitor
0539                         ; this will need to relocated to fit in the original Load and Punch routines
0540                         ;=============================================================================
0541                         
0542                         ; Spare bytes for LOAD and PUNCH commands are as follows
0543                         ; Original LOAD command space = 36 Bytes
0544                         ; Original PUNCH command space = 47 Bytes
0545                         ; Addition space where old X and Z commands were 81 bytes
0546                         ; Additional space where the old ALTER command was = 26 Bytes
0547                         ;
0548                         ; Total free bytes = 190 bytes
0549                         
0550                         
0551                         ; 31 bytes
0552 efe3                    RD_ByteFast EQU     *           ; Read ONE Character (fast)
0553 efe3 ff f0 d5                       STX     d_RdFstX    ; Save X
0554 efe6 fe f4 00                       LDX     DATAA       ; X = addr of current ACIA
0555 efe9 a6 01              .rdChkF     LDAA    1,X         ; Get ACIA status byte DATAA + 1
0556 efeb 47                             ASRA                ; Shift low order bit to C
0557 efec 24 fb                          BCC     .rdChkF     ; Loop until C set
0558 efee a6 00                          LDAA    0,X         ; Get the data byte to A
0559 eff0 bd f0 cf                       JSR     PR_BYTE     ; Echo character ...echo...
0560 eff3 84 7f                          ANDA    #$7F        ; Strip off `parity` bit, if present
0561 eff5 27 f2                          BEQ     .rdChkF     ; Ignore paper tape follower
0562 eff7 81 2e                          CMPA    #'.         ; Was it
0563 eff9 26 03                          BNE     .rfDone     ;  a fullstop ?
0564 effb 7e ef 8f                       JMP     START       ; Yes: Go to START
0565 effe fe f0 d5           .rfDone     LDX     d_RdFstX    ; Restore X
0566 f001 39                             RTS                 ; RETURN
0567                         
0568                         ; -----------------------------------------------------
0569                         ; S format data load : Modded version of Mikbug code
0570                         ;
0571 f002                    CMD_L       EQU     *           ; L = Load = Input an S19 file
0572 f002 bd ec 76                       JSR     STRING
0573 f005 20 2b 20                       FCC     " + "
0574 f008 0d 0a                          FCB     $0D,$0A     ; c/r l/f
0575 f00a ff                             FCB     $FF         ; End-Of-String
0576 f00b 8d d6              .sRead      BSR     RD_ByteFast ; Read+Echo, test for '.'
0577 f00d 81 53                          CMPA    #'S         ; Is it `S` ?
0578 f00f 26 fa                          BNE     .sRead      ; No: Keep waiting for `S`
0579 f011 8d d0                          BSR     RD_ByteFast ; Read+Echo, test for '.'
0580 f013 81 39                          CMPA    #'9         ; Is it `9` ?  ( `S9` record )
0581 f015 27 27                          BEQ     .sDone      ; Yes: End-data, Back to START
0582 f017 81 31                          CMPA    #'1         ; Is it `1` ?  ( `S1` record )
0583 f019 26 f0                          BNE     .sRead      ; No: Wait for next `S`
0584 f01b 7f f0 dd                       CLR     b_Csum      ; Clear checksum
0585 f01e bd f0 a6                       JSR     RD_HEX2     ; Read 2xHex = data.byte count to A
0586 f021 80 02                          SUBA    #2          ; Subtract 2 (to get bytes left in line)
0587 f023 b7 f0 de                       STAA    b_Count     ; Store byte count
0588 f026 bd ec 65                       JSR     RD_X        ; Read 4xHex digit address to X
0589 f029 bd f0 a6           .sDoByt     JSR     RD_HEX2     ; Read 2xHex digits, value to A
0590 f02c 7a f0 de                       DEC     b_Count     ; Decrement our byte count
0591 f02f 27 05                          BEQ     .sChk       ; If end-of-line, go look at checksum
0592 f031 a7 00                          STAA    0,X         ; Save byte where X points
0593 f033 08                             INX                 ; Point X at next byte
0594 f034 20 f3                          BRA     .sDoByt     ; Go get next byte
0595 f036 7c f0 dd           .sChk       INC     b_Csum      ; Add 1 to checksum
0596 f039 27 d0                          BEQ     .sRead      ; OK: Go read next record
0597 f03b bd f0 cd                       JSR     PR_QM       ; Print "?"
0598 f03e                    .sDone      EQU     *
0599 f03e 7e ef 8f           STARTS      JMP     START       ; Go to START
0600                         
0601                         ; -----------------------------------------------------
0602                         ; S format data output : Modded version of Mikbug code
0603                         ;
0604 f041                    CMD_P       EQU     *           ; P = Punch : Output an S19 file
0605 f041 bd f0 d3                       JSR     ASK_Addrs   ; Prompt for "Start:","Stop:"
0606 f044 fe f0 e0                       LDX     d_START     ; Get start address
0607 f047 ff f0 d9                       STX     d_TW        ; save it to work area
0608 f04a b6 f0 dc           .fOut1      LDAA    d_STOP+1    ; get low order of end address
0609 f04d b0 f0 da                       SUBA    d_TW+1      ; Subtract low order start
0610 f050 f6 f0 db                       LDAB    d_STOP      ; ( carry not affected by LDA )
0611 f053 f2 f0 d9                       SBCB    d_TW        ; Subtract with Carry
0612 f056 26 04                          BNE     .fOut2
0613 f058 81 10                          CMPA    #16
0614 f05a 25 02                          BCS     .fOut3
0615 f05c 86 0f              .fOut2      LDAA    #15
0616 f05e 8b 04              .fOut3      ADDA    #4
0617 f060 b7 f0 de                       STAA    b_Count     ; FRAME COUNT THIS RECORD
0618 f063 80 03                          SUBA    #3
0619 f065 b7 f0 df                       STAA    b_Temp      ; BYTE COUNT THIS RECORD
0620 f068 bd ec 76                       JSR     STRING      ; Output this string...
0621 f06b 0d 0a                          FCB     $0D,$0A       ; c/r l/f
0622 f06d 53 31                          FCB     'S,'1       ; S1
0623 f06f ff                             FCB     $FF         ; End-Of-String
0624 f070 5f                             CLRB                ; Clear checksum
0625                         
0626                         ; Output frame count...
0627 f071 ce f0 de                       LDX     #b_Count    ; X = Address of Framecount
0628 f074 8d 25                          BSR     .fOutHx2    ; O/P byte <-X and inc X
0629                         
0630                         ; Output address...
0631 f076 ce f0 d9                       LDX     #d_TW
0632 f079 8d 20                          BSR     .fOutHx2    ; O/P byte <-X and inc X
0633 f07b 8d 1e                          BSR     .fOutHx2    ; O/P byte <-X and inc X
0634                         
0635                         ; Output data...
0636 f07d fe f0 d9                       LDX     d_TW
0637 f080 8d 19              .fOut4      BSR     .fOutHx2    ; O/P byte <-X and inc X
0638 f082 7a f0 df                       DEC     b_Temp      ; Decrement `bytes left` count
0639 f085 26 f9                          BNE     .fOut4      ; Loop back if any left
0640 f087 ff f0 d9                       STX     d_TW
0641 f08a 53                             COMB
0642 f08b 37                             PSHB
0643 f08c 30                             TSX                 ; X = S + 1
0644 f08d 8d 0c                          BSR     .fOutHx2    ; PUNCH CHECKSUM
0645 f08f 33                             PULB
0646 f090 fe f0 d9                       LDX     d_TW
0647 f093 09                             DEX
0648 f094 bc f0 db                       CPX     d_STOP
0649 f097 26 b1                          BNE     .fOut1
0650                         
0651                         ;x          JSR     PR_STRING   ; Output `S9` record...
0652                         ;x          FCB     C_CR,C_LF   ; c/r l/f
0653                         ;x          FCB     'S,'9       ; S9 = <eof>
0654                         ;x          FCB     C_EOS       ; End-Of-String
0655                         
0656 f099 8d a3                          BSR     STARTS      ;Go to START (via `S` code)
0657                         
0658                         ;- - - - - - - - - - - - - - - - - - - - - - - - -
0659                         ; 1) Update checksum
0660                         ; 2) Output byte pointed to by X as 2 x hex chars
0661                         ; 3) Increment X
0662                         ;
0663 f09b eb 00              .fOutHx2    ADDB    0,X         ; Update checksum
0664 f09d 36                             PSHA                ; Push A to STACK
0665 f09e a6 00                          LDAA    0,X         ; Load byte to be o/p
0666 f0a0 bd f0 f8                       JSR     PR_HEX2     ; O/P byte <- X
0667 f0a3 32                             PULA                ; Pull A off STACK
0668 f0a4 08                             INX                 ; Increment X
0669 f0a5 39                             RTS                 ; RETURN
0670                         
0671                         ; -----------------------------------------------------
0672                         ; Read a 2 digit HEX value, put result into X
0673                         
0674 f0a6                    RD_HEX2     EQU     *
0675 f0a6 bd ef e3                       JSR     RD_ByteFast ; Read a character
0676 f0a9 bd ec 1d                       JSR     VHEX     ; Is it a hex character ?
0677 f0ac 25 1a                          BCS     .rxPrQM     ; No: go to print `?`
0678 f0ae b7 f0 f6                       STAA    T_Q         ; Save it
0679 f0b1 bd ef e3                       JSR     RD_ByteFast ; Read 2nd character
0680 f0b4 bd ec 1d                       JSR     VHEX     ; Is it a hex character ?
0681 f0b7 25 0f                          BCS     .rxPrQM     ; No: go to print `?`
0682 f0b9 16                             TAB                 ; Yes: Put it into B
0683 f0ba b6 f0 f6                       LDAA    T_Q         ; Retrieve 1st hex char to A
0684 f0bd bd ec 31                       JSR     BINARY      ; Convert A:B to binary to A
0685 f0c0 16                             TAB                 ; B=A
0686 f0c1 fb f0 dd                       ADDB    b_Csum      ; Add this value
0687 f0c4 f7 f0 dd                       STAB    b_Csum      ; to the Checksum (for S19)
0688 f0c7 39                             RTS                 ; RETURN
0689 f0c8 bd f0 cd           .rxPrQM     JSR     PR_QM       ; Print "?"
0690 f0cb 20 d9                          BRA     RD_HEX2     ; Go back to start of hex input
0691                         
0692                         ; -----------------------------------------------------
0693                         ; Read 4 hex digits and put value into X
0694                         ;
0695                         ; RD_HEX4   = Read 4.hex digit address value into X
0696                         ; RD_HEX4_S = As above, but print a SPACE first
0697                         
0698                         ;RD_HEX4_S   JSR     PR_SP       ; Print a space
0699                         ;RD_HEX4     BSR     RD_HEX2     ; Read 2 digit hex val into A
0700                         ;            STAA    d_Hx4X      ; Save high.byte
0701                         ;            BSR     RD_HEX2     ; Read 2 digit hex val into A
0702                         ;            STAA    d_Hx4X+1    ; Save low.byte
0703                         ;            LDX     d_Hx4X      ; Load 4 digit hex val into X
0704                         ;            RTS                 ; RETURN
0705                         
0706 f0cd 86 3f              PR_QM       LDAA #'?              ; Put '?' character in A
0707 f0cf bd ec 0f           PR_BYTE     JSR     PR_A    ; Print it
0708 f0d2 39                             RTS             ; RETURN
