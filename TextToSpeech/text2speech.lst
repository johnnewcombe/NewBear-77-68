                            223 ; -----------------------------------------------------
                            224 ; PR_DEC: Puts 3 decimal digits in DEC, DEC+1 and DEC+2
                            225 ;
                            226 ;       !! ONLY WORKS WITH VALUES BELOW 128 !!
                            227 ; -----------------------------------------------------
   025E 5F            [ 2]  228 PR_DEC:  CLRB            ; Clear B for hundreds
                            229 
   025F 81 64         [ 2]  230 HUND:    CMPA    #100    ; 100 or more?
                            231 
   0261 2D 05         [ 4]  232         BLT     TENS
   0263 80 64         [ 2]  233         SUBA    #100    ; Sub 100
   0265 5C            [ 2]  234         INCB            ; Increment hundred counter
   0266 20 F7         [ 4]  235         BRA     HUND
                            236 
   0268 F7 19 5E      [ 5]  237 TENS:    STAB    DEC     ; store the hundreds
                            238 
   026B 5F            [ 2]  239         CLRB
   026C 81 0A         [ 2]  240 TENS1:   CMPA    #10     ; 10 or more?
   026E 2D 05         [ 4]  241         BLT     UNITS
   0270 80 0A         [ 2]  242         SUBA    #10     ; Sub 10
   0272 5C            [ 2]  243         INCB            ; Increment ten counter
   0273 20 F7         [ 4]  244         BRA     TENS1
                            245 
   0275 F7 19 5F      [ 5]  246 UNITS:   STAB    DEC+1
   0278 B7 19 60      [ 5]  247         STAA    DEC+2   ; Final remainder is units
                            248 
   027B 39            [ 5]  249         RTS
                            250 
                            251 
                            252 ; -----------------------------------------------------
                            253 ; Print string FOLLOWING JSR ( terminated by 0xFF ) to
                            254 ; ACIA(b) and ACIA(b)
                            255 ; -----------------------------------------------------
   027C 30            [ 4]  256 STRINGB: TSX             ; Get loc. of return addr to X
   027D EE 00         [ 6]  257         LDX     0,X     ; Get return addr to X
   027F 09            [ 4]  258         DEX             ; Point to byte before
   0280 08            [ 4]  259 STRB1:   INX             ; Point to next byte
   0281 A6 00         [ 5]  260         LDAA    0,X     ; Get byte to be printed
   0283 81 FF         [ 2]  261         CMPA    #0xFF    ; End-string ?
   0285 27 07         [ 4]  262         BEQ     ENDSTR  ; Yes: Go to finish up
   0287 BD FC 0F      [ 9]  263         JSR     PR_A    ; Print the byte to ACIA(a) (A is maintained)
   028A 8D 40         [ 8]  264         BSR     PR_B    ; Print the byte to ACIA(b)
   028C 20 F2         [ 4]  265         BRA     STRB1   ; Go back for next byte
   028E 31            [ 4]  266 ENDSTR:  INS             ; Clean up stack...
