0280                         ; Outputs a word based on value in A
0281                         ; -----------------------------------------------------
0282 031a 4c                 PR_WORD     INCA
0283 031b ce 05 06                       LDX     #WORDPTR  ; base of offset table
0284 031e 4a                 PR_WORD1    DECA
0285 031f 27 04                          BEQ     FOUNDW
0286 0321 08                             INX                 ; move to next address
0287 0322 08                             INX
0288 0323 26 f9                          BNE     PR_WORD1    ; loop around to retest
0289 0325 a6 00              FOUNDW      LDAA    0,X
0290 0327 b7 05 9b                       STAA    T_X
0291 032a a6 01                          LDAA    1,X
0292 032c b7 05 9c                       STAA    T_X+1
0293 032f fe 05 9b                       LDX     T_X
0294 0332 bd 02 6d                       JSR     STRINGBX
0295 0335 39                             RTS
