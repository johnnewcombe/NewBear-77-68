0073 0131 b6 19 51                   LDAA    T_WEIGHT
0074 0134 81 06                      CMPA    #LIGHT_WGHT
0075 0136 22 03                      BHI     ML2             ; less than light weight gets no comment
0076 0138 7e 01 05                   JMP     MAINLOOP
