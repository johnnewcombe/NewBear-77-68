                     F400     8 DATAA           .equ    0xF400          ; ACIA(a) Data register
                     F401     9 CTRLA           .equ    0xF401          ; ACIA(a) Ctrl/Status
                     F402    10 DATAB           .equ    0xF402          ; ACIA(b) Data register
                     F403    11 CTRLB           .equ    0xF403          ; ACIA(b) Ctrl/Status
                             12 
                             13 ; MINIMON routines
                     FC76    14 STRING          .equ    0xFC76          ; Prints a string.
                     FC89    15 GETADD          .equ    0xFC89          ; Get Address, read 4 digit hex value.
                     FCC9    16 ZOUT            .equ    0xFCC9          ; Print value in A as 2 hex digits.
                     FE97    17 NEWLINE         .equ    0xFE97          ; Prints a new line.
                     FF8F    18 START           .equ    0xFF8F          ; Restarts MniMon.
                     FC0F    19 PR_A            .equ    0xFC0F          ; Print char in A to ACIA (a)
                     FD2B    20 RD_A            .equ    0xFD2B          ; Read char from A
                     FD4D    21 PRSP            .equ    0xFD4D          ; Print a space
                     FC31    22 BINARY          .equ    0xFC31          ; Converts ASCII hex digits in A and B to binary?
                     FC65    23 RD_X            .equ    0xFC65          ; Read 4 hex digits Value from ACIA(a) and put value into X.
                     FC1D    24 VHEX            .equ    0xFC1D          ; Checks that A contains a HEX character
                             25 
                     000A    26 IDLE_SECS       .equ    10              ; seconds between idle messages
