0001                         ;------------------------------------------------------------------
0002                         ; text2speech.asm
0003                         ;------------------------------------------------------------------
0004                         
0005                         ; 7768 ACIA
0006 f400                    DATAA   EQU $F400 ; ACIA(a) Data register
0007 f401                    CTRLA   EQU $F401 ; ACIA(a) Ctrl/Status
0008 f402                    DATAB   EQU $F402 ; ACIA(b) Data register
0009 f403                    CTRLB   EQU $F403 ; ACIA(b) Ctrl/Status
0010                         
0011                         ; MINIMON routines
0012 fc76                    STRING  EQU $FC76 ; Prints a string. The string should follow JSR and be terminated with $FF.
0013 fc89                    GETADD  EQU $FC89 ; Get Address, read 4 digit hex value.
0014 fcc9                    ZOUT    EQU $FCC9 ; Print value in A as 2 hex digits.
0015 fe97                    NEWLINE EQU $FE97 ; Prints a new line.
0016 ff8f                    START   EQU $FF8F ; Restarts MniMon.
0017 fc0f                    PR_A    EQU $FC0F ; Print char in A to ACIA (a)
0018 fd2b                    RD_A    EQU $FD2B ; Read char from A
0019 fd4d                    PRSP    EQU $FD4D ; Print a space
0020 fc31                    BINARY  EQU $FC31 ; Converts ASCII hex digits in A and B to binary?
0021 fc65                    RD_X    EQU $FC65 ; Read 4 hex digits Value from ACIA(a) and put value into X.
0022 fc1d                    VHEX    EQU $FC1D ; Checks that A contains a HEX character
0023 0200                    	    ORG $0200
0024                         
0025                         ; initialise serial port B
0026 0200 86 11              TX2SP   LDAA    #$11    ; 8 Data, No Parity, 2 Stop Bits
0027 0202 b7 f4 03                   STAA    CTRLB   ;   ACIA.A
0028                         
0029                         
0030                         MAINLOOP:
0031                         ; -----------------------------------------------------
0032                         ; Data arrives at port B as four hex characters
0033                         ; -----------------------------------------------------
0034 0205 bd 02 94                   JSR     RD_XB           ; read 4 hex characters into X
0035 0208 ff 03 c0                   STX     TEMP
0036 020b b6 03 c0                   LDAA    TEMP
0037 020e 81 14                      CMPA    #20
0038 0210 22 0a                      BHI     END
0039 0212 b6 03 c1                   LDAA    TEMP+1
0040 0215 81 0f                      CMPA    #15
0041 0217 22 03                      BHI     END
0042 0219 bd 02 a3                   JSR     PR_WEIGHT       ; stoones in MSB, pounds in LSB
0043                         
0044                         ;--------------------------------------------------------------
0045                         ; DECIMAL CONVERSION EXAMPLE
0046                         ;--------------------------------------------------------------
0047                                 ;JSR     PR_DEC          ; puts 3 decimal digits in DEC, DEC+1 and DEC+2
0048                                 ;LDAA    DEC+1           ; don't care about the hundreds        ADDA    #$30
0049                                 ;JSR     PR_NUMB
0050                                 ;JSR     PRSPB
0051                                 ;LDAA    DEC+2
0052                                 ;JSR     PR_NUMB
0053                         
0054                         ;--------------------------------------------------------------
0055                         ;
0056                         ;--------------------------------------------------------------
0057                                 ;JSR     STRINGB
0058                                 ;FCB     $0D, $0A
0059                                 ;FCC     "Shall I tell you a joke?"
0060                                 ;FCB     $0D, $0A,$FF
0061                         
0062 021c 3f                 END     SWI
0063                         
0064 021d 7e 02 05                   JMP     MAINLOOP  ;START   ; all done
0065                         
0066                         ; -----------------------------------------------------
0067                         ; PR_DEC: Puts 3 decimal digits in DEC, DEC+1 and DEC+2
0068                         ;
0069                         ;       !! ONLY WORKS WITH VALUES BELOW 128 !!
0070                         ; -----------------------------------------------------
0071 0220 5f                 PR_DEC  CLRB            ; Clear B for hundreds
0072                         
0073 0221 81 64              HUND    CMPA    #100    ; 100 or more?
0074                         
0075 0223 2d 05                      BLT     TENS
0076 0225 80 64                      SUBA    #100    ; Sub 100
0077 0227 5c                         INCB            ; Increment hundred counter
0078 0228 20 f7                      BRA     HUND
0079                         
0080 022a f7 03 bd           TENS    STAB    DEC     ; store the hundreds
0081                         
0082 022d 5f                         CLRB
0083 022e 81 0a              TENS1   CMPA    #10     ; 10 or more?
0084 0230 2d 05                      BLT     UNITS
0085 0232 80 0a                      SUBA    #10     ; Sub 10
0086 0234 5c                         INCB            ; Increment ten counter
0087 0235 20 f7                      BRA     TENS1
0088                         
0089 0237 f7 03 be           UNITS   STAB    DEC+1
0090 023a b7 03 bf                   STAA    DEC+2   ; Final remainder is units
0091                         
0092 023d 39                         RTS
0093                         
0094                         
0095                         ; -----------------------------------------------------
0096                         ; Print string FOLLOWING JSR ( terminated by $FF ) to
0097                         ; ACIA(b) and ACIA(b)
0098                         ; -----------------------------------------------------
0099 023e 30                 STRINGB TSX             ; Get loc. of return addr to X
0100 023f ee 00                      LDX     0,X     ; Get return addr to X
0101 0241 09                         DEX             ; Point to byte before
0102 0242 08                 AGAIN   INX             ; Point to next byte
0103 0243 a6 00                      LDAA    0,X     ; Get byte to be printed
0104 0245 81 ff                      CMPA    #$FF    ; End-string ?
0105 0247 27 07                      BEQ     ENDSTR  ; Yes: Go to finish up
0106 0249 bd fc 0f                   JSR     PR_A    ; Print the byte to ACIA(a) (A is maintained)
0107 024c 8d 3b                      BSR     PR_B    ; Print the byte to ACIA(b)
0108 024e 20 f2                      BRA     AGAIN   ; Go back for next byte
0109 0250 31                 ENDSTR  INS             ; Clean up stack...
0110 0251 31                         INS             ;  ( pop off the return addr )
0111 0252 6e 01                      JMP     1,X     ; Jump back to caller (RETURN)
0112                         
0113                         ; -----------------------------------------------------
0114                         ; Prints a string pointed to by X
0115                         ; -----------------------------------------------------
0116 0254 a6 00              STRINGBX    LDAA    0,X         ; get char
0117 0256 81 ff                          CMPA    #$FF        ; is character NULL?
0118 0258 27 08                          BEQ     DONEB       ; yes, end of string
0119 025a bd fc 0f                       JSR     PR_A        ; Print the byte to ACIA(a) (A is maintained)
0120 025d 8d 2a                          BSR     PR_B        ; Print the byte to ACIA(b)
0121 025f 08                             INX
0122 0260 20 f2                          BRA     STRINGBX
0123 0262 39                 DONEB       RTS
0124                         
0125                         ; -----------------------------------------------------
0126                         ; Reads a character from ACIA(b) into A
0127                         ; -----------------------------------------------------
0128 0263 b6 f4 03           RD_B    LDAA    CTRLB       ; Get ACIA.A status byte
0129 0266 85 01                      BITA    #01         ; Is byte ready in DATAb
0130 0268 27 f9                      BEQ     RD_B        ; No: Try again
0131 026a b6 f4 02                   LDAA    DATAB       ; Get the data byte to A
0132                                 ;ANDA    #$7F        ; Mask off parity bit if it exists
0133 026d 39                         RTS                 ; RETURN
0134                         
0135                         ; -----------------------------------------------------
0136                         ;
0137                         ; -----------------------------------------------------
0138 026e 8d f3              ZINB    BSR     RD_B    ; Read a character
0139 0270 bd fc 1d                   JSR     VHEX    ; Is it a hex character ?
0140 0273 25 12                      BCS     Z_PRQM  ; No: go to print `?`
0141 0275 b7 03 b6                   STAA    T_Q     ; Yes: Save Acc.A
0142 0278 8d e9                      BSR     RD_B    ; Read 2nd character
0143 027a bd fc 1d                   JSR     VHEX    ; Is it a hex character ?
0144 027d 25 08                      BCS     Z_PRQM  ; No: go to print `?`
0145 027f 16                         TAB             ; Yes: Put it into Acc.B
0146 0280 b6 03 b6                   LDAA    T_Q     ; Retrieve 1st hex char to Acc.A
0147 0283 bd fc 31                   JSR     BINARY  ; Convert A:B to binary
0148 0286 39                         RTS             ; RETURN
0149                         Z_PRQM  ;LDAA    #'?     ; Load `?` into A
0150                                 ;BSR     PR_B    ; Print it
0151 0287 20 e5                      BRA     ZINB    ; Go back to start of hex input
0152                         
0153                         ; -----------------------------------------------------
0154                         ; Print character in A to ACIA(b)
0155                         ; -----------------------------------------------------
0156 0289 f6 f4 03           PR_B    LDAB    CTRLB   ; Get ACIA(a) status byte
0157 028c c5 02                      BITB    #02     ; Is it busy ?
0158 028e 27 f9                      BEQ     PR_B    ; Yes: Try again
0159 0290 b7 f4 02                   STAA    DATAB   ;  No: Send data
0160 0293 39                 PRB_END RTS             ; RETURN
0161                         
0162                         ; -----------------------------------------------------
0163                         ; Read 4 hex digits and put value into X
0164                         ; -----------------------------------------------------
0165                         RD_XB   ;JSR     PRSPB   ; Print a space
0166 0294 8d d8                      BSR     ZINB    ; Read 2 digit hex value into A
0167 0296 b7 03 b7                   STAA    T_Z     ; Save byte (most significant)
0168 0299 8d d3                      BSR     ZINB    ; Read 2 digit hex value into A
0169 029b b7 03 b8                   STAA    T_Z+1   ; Save byte (least significant)
0170 029e fe 03 b7                   LDX     T_Z     ; Load full 4 hex value into X
0171 02a1 39                         RTS             ; RETURN
0172                         
0173                         ; -----------------------------------------------------
0174                         ; Random idle phrase to ports B
0175                         ; -----------------------------------------------------
0176 02a2 39                 IDLE    RTS
0177                         
0178                         
0179                         ; -----------------------------------------------------
0180                         ; Prints the message "You weight n stones n pounds"
0181                         ; place stones in MSB of X and pound in LSB
0182                         ; -----------------------------------------------------
0183                         PR_WEIGHT
0184 02a3 ff 03 bb                   STX     T_W
0185 02a6 bd 02 3e                   JSR     STRINGB
0186 02a9 59 6f 75 20 77 65          FCC     "You weigh "
     69 67 68 20
0187 02b3 00 ff                      FDB     $FF
0188 02b5 b6 03 bb                   LDAA    T_W             ; Load high byte of X into Accumulator A
0189 02b8 bd 02 e7                   JSR     PR_NUMB
0190 02bb bd 02 3e                   JSR     STRINGB
0191 02be 20 73 74 6f 6e 65          FCC     " stones "
     73 20
0192 02c6 00 ff                      FDB     $FF
0193 02c8 b6 03 bc                   LDAA    T_W+1            ; Load high byte of X into Accumulator A
0194 02cb bd 02 e7                   JSR     PR_NUMB
0195 02ce bd 02 3e                   JSR     STRINGB
0196 02d1 20 70 6f 75 6e 64          FCC     " pounds"
     73
0197 02d8 0d 0a ff                   FCB     $0D, $0A,$FF
0198                         
0199 02db 39                         RTS
0200                         
0201                         ; -----------------------------------------------------
0202                         ; Prints a space on both consoles (preserves A)
0203                         ; -----------------------------------------------------
0204 02dc 36                 PRSPB   PSHA
0205 02dd 86 20                      LDAA    #$20        ; Put space character in A
0206 02df bd fc 0f                   JSR     PR_A
0207 02e2 bd 02 89                   JSR     PR_B        ; Print it
0208 02e5 32                         PULA
0209 02e6 39                         RTS                 ; RETURN
0210                         
0211                         
0212                         ; -----------------------------------------------------
0213                         ; Get number word based on value in A
0214                         ; -----------------------------------------------------
0215 02e7 4c                 PR_NUMB     INCA
0216 02e8 ce 03 03                       LDX     #TEXTBLOCKPTR  ; base of offset table
0217 02eb 4a                 PR_NUMB1    DECA
0218 02ec 27 04                          BEQ     FOUND
0219 02ee 08                             INX                 ; move to next address
0220 02ef 08                             INX
0221 02f0 26 f9                          BNE     PR_NUMB1    ; loop around to retest
0222 02f2 a6 00              FOUND       LDAA    0,X
0223 02f4 b7 03 b9                       STAA    T_X
0224 02f7 a6 01                          LDAA    1,X
0225 02f9 b7 03 ba                       STAA    T_X+1
0226 02fc fe 03 b9                       LDX     T_X
0227 02ff bd 02 54                       JSR     STRINGBX
0228 0302 39                             RTS
0229                         
