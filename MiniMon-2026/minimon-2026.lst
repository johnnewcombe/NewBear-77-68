0669                         
0670 fff8 f0 e0                      FDB     JIRQ    ; IRQ
0671 fffa ef 8f                      FDB     SWI     ; SWI
0672 fffc f0 dd                      FDB     JNMI    ; NMI
0673 fffe ef 84                      FDB     RESET   ; Reset
