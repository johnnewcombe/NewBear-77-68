output:  minimon-2026.s19
0001                         ; ------------------------------------------------------
0002                         ; Minimon
0003                         ; ------------------------------------------------------
0004                         ;  Original author ACH, Dec.1978;
0005                         ; ------------------------------------------------------
0006                         ; 13 NOV 2025 : [JN] added NOP at FFF7 to remove gap to
0007                         ;             : allow easier conversion to bin from s19
0008                         ; 05 DEC 2025 : [JN] Changed ACIA(a) to be 8N2 to match
0009                         ;             : PROM. So that MiniMon can be loaded and
0010                         ;             : run from the same terminal config.
0011                         ; ------------------------------------------------------
0012                         ; 2 x ACIAs :-
0013                         ;
0014                         
0015                         
0016 f401                    CTRLA   EQU     $F401   ; ACIA.A Ctrl/Status
0017 f403                    CTRLB   EQU     $F403   ; ACIA.B Ctrl/Status
0018 f400                    DATAA   EQU     $F400   ; ACIA.A Data register
0019 f402                    DATAB   EQU     $F402   ; ACIA.B Data register
0020                         
0021                         ; Note:The original 256 bytes of RAM on the CPU board 
0022                         ;  appears at $F000 to $F0FE, with Switches/LEDs at $F0FF
0023                         ;  when a MON1 board is installed
0024                         
0025                         ; Stack goes down from $F0D0
0026 f0d0                    STACK   EQU     $F0D0   ; Top of MINIMON's stack
0027                         
0028                         
0029                         
0030                         ; RAM at $F0D1 to $F0DC appears to be unused
0031                         
0032                         ; 3 bytes reserved for each if NMI and IRQ handling
0033                         ; so an application can write JMP <addr> into those
0034                         ; places if those interrupts are wanted...
0035                         
0036 f0dd                    JNMI    EQU     $F0DD   ; Space for jump to NMI sub.
0037 f0e0                    JIRQ    EQU     $F0E0   ; Space for jump to IRQ sub.
0038                         
0039                         ; -----------------------------------------------------
0040 f0de                            ORG     $F0DE   ; Start of RAM variables
0041                         ; -----------------------------------------------------
0042                         ; Note: Temp storage variables renamed to get T_ prefix
0043                         ;       as some were sharing names with labels or registers
0044                         ;
0045                         ; New additions to support S19 additions
0046                         ;d_RdFstX    RMB     2       ;  "  RD_ByteFast X
0047                         ;d_Hx4X      RMB     2       ;  "  RDX4 PRX4
0048 f0de                    d_TW        RMB     2       ;  "  S19
0049                         ;d_STOP      RMB     2       ;  "  ASK_Addrs `Stop:`
0050 f0e0                    b_Csum      RMB     1       ;  "  S19
0051 f0e1                    b_Count     RMB     1       ;  "  S19
0052 f0e2                    b_Temp      RMB     1       ;  "  S19
0053                         ;d_START     RMB     2       ;  "  ASK_Start `Start:`
0054                         ;b_Q         RMB     1       ;  "  ZIN,DUMP
0055                         
0056 f0e3                    T_SAVE  RMB     2       ; Temp storage for NEWLINE
0057 f0e5                    T_P     RMB     1       ;   "     "     "  Z,X
0058 f0e6                    T_X     RMB     2       ;   "     "     "  Sub
0059 f0e8                    T_Y     RMB     2       ;   "     "     "  Sub
0060 f0ea                    T_NEW   RMB     2       ;   "     "     "  Block move
0061 f0ec                    T_M     RMB     1       ;   "     "     "  ZOUT
0062 f0ed                    T_TMPX  RMB     2       ;   "     "     "  PRX
0063 f0ef                    T_STRT  RMB     2       ;   "     "     "  GETADDRESS
0064 f0f1                    T_STOP  RMB     2       ;   "     "     "  GETADDRESS
0065 f0f3                    T_Z     RMB     2       ;   "     "     "   . RDX
0066 f0f5                    T_R     RMB     1       ;   "     "     "     PR
0067 f0f6                    T_Q     RMB     1       ;   "     "     "  ZIN,DUMP 
0068 f0f7                    T_ABYT  RMB     2       ;   "     "     "  SET BR.PT.
0069 f0f9                            RMB     2       ;   "     "     "  SET BR.PT.
0070 f0fb                    T_BYTE  RMB     2       ;   "     "     "  SET BR.PT.
0071 f0fd                    PSTACK  RMB     2       ;   "     "     "     SWI etc
0072                         
0073                         
0074                         
0075                         ;
0076                         ; -----------------------------------------------------
0077 fc00                            ORG     $FC00   ; Start of ROM based code
0078                         ; -----------------------------------------------------
0079                         ;FC00
0080 fc00 bd fd 2b           RD_CMD  JSR     RD_A    ; Input one character 
0081 fc03 27 fb                      BEQ     RD_CMD  ; Ignore paper tape follower
0082 fc05 8d 08                      BSR     PR_A    ; Echo character
0083 fc07 81 2e                      CMPA    #'.     ; Was it a fullstop ?
0084 fc09 26 03                      BNE     END_RD  ;
0085 fc0b 7e ff 8f                   JMP     START   ; Yes: Go to start of MINIMON
0086 fc0e 39                 END_RD  RTS             ;  No: RETURN
0087                         
0088                         ; -----------------------------------------------------
0089                         ; Print character in A
0090                         ;FC0F
0091 fc0f f6 f4 01           PR_A    LDAB    CTRLA   ; Get ACIA(a) status byte
0092 fc12 c5 02                      BITB    #02     ; Is it busy ?
0093 fc14 27 f9                      BEQ     PR_A    ; Yes: Try again
0094 fc16 b7 f4 00                   STAA    DATAA   ;  No: Send data
0095 fc19 7c f0 f5                   INC     T_R     ; Characters printed + One
0096 fc1c 39                         RTS             ; RETURN
0097                         
0098                         ; -----------------------------------------------------
0099                         ; Check A contains a HEX character,  Set C.bit on fail
0100                         ;FC1D
0101 fc1d 81 2f              VHEX    CMPA    #$2F    ; A < 30 ?
0102 fc1f 2f 0e                      BLE     NotHex  ;  not hex
0103 fc21 81 39                      CMPA    #$39    ; A > 39 ?    
0104 fc23 22 02                      BHI     NotNum  ;  Not a Numeral
0105 fc25 0c                 IsHex   CLC             ; It's OK (clear C bit)
0106 fc26 39                         RTS             ; RETURN
0107 fc27 81 40              NotNum  CMPA    #$40    ; A < 41 ?
0108 fc29 2f 04                      BLE     NotHex  ;  not hex
0109 fc2b 81 46                      CMPA    #$46    ; A <= 46
0110 fc2d 2f f6                      BLE     IsHex   ;  then it is hex
0111 fc2f 0d                 NotHex  SEC             ; Set C bit
0112 fc30 39                         RTS             ; RETURN
0113                         
0114                         ; -----------------------------------------------------
0115                         ;FC31
0116 fc31 85 30              BINARY  BITA    #$30    ; Is it a letter ?
0117 fc33 27 0c                      BEQ     LETTA   ; Yes: Got to handle it
0118 fc35 48                 RIDA    ASLA            ;  No: It is a number, so
0119 fc36 48                         ASLA            ;      shift
0120 fc37 48                         ASLA            ;       left
0121 fc38 48                         ASLA            ;        4 bits
0122 fc39 c5 30                      BITB    #$30    ; Is Acc.B a letter ?
0123 fc3b 27 08                      BEQ     LETTB   ; Yes: Go handle it
0124 fc3d c4 0f              RIDB    ANDB    #$0F    ; Clear 4 high bits in Acc.B
0125 fc3f 1b                         ABA             ; Form binary character (A=A+B)
0126 fc40 39                         RTS             ; RETURN
0127 fc41 8b 09              LETTA   ADDA    #$09    ; Make Acc.A a binary
0128 fc43 20 f0                      BRA     RIDA    ;  as before
0129 fc45 cb 09              LETTB   ADDB    #$09    ; Make Acc.B a binary
0130 fc47 20 f4                      BRA     RIDB    ;  as before
0131                         
0132                         ; -----------------------------------------------------
0133                         ; Read a 4 digit HEX value, put result into X
0134                         ;FC49
0135 fc49 8d b5              ZIN         BSR     RD_CMD      ; Read a character
0136 fc4b 8d d0                          BSR     VHEX        ; Is it a hex character ?
0137 fc4d 25 10                          BCS     Z_PRQM      ; No: go to print `?`
0138 fc4f b7 f0 f6                       STAA    T_Q         ; Save it
0139 fc52 8d ac                          BSR     RD_CMD      ; Read 2nd character
0140 fc54 8d c7                          BSR     VHEX        ; Is it a hex character ?
0141 fc56 25 07                          BCS     Z_PRQM      ; No: go to print `?`
0142 fc58 16                             TAB                 ; Yes: Put it into B
0143 fc59 b6 f0 f6                       LDAA    T_Q         ; Retrieve 1st hex char to A
0144 fc5c 7e fc db                       JMP     ZIN2        ; S19 version of ZIN is longer
0145 fc5f bd fd 26           Z_PRQM      JSR     PR_QM       ; Print "?"
0146 fc62 7e fc 49                       JMP     ZIN      ; Go back to start of hex input
0147                         
0148                         ; -----------------------------------------------------
0149                         ; Read 4 hex digits and put value into X
0150                         ;FC65
0151 fc65 bd fd 4d           RD_X    JSR     PRSP    ; Print a space
0152 fc68 8d df                      BSR     ZIN     ; Read 2 digit hex value into A
0153 fc6a b7 f0 f3                   STAA    T_Z     ; Save byte (most significant)
0154 fc6d 8d da                      BSR     ZIN     ; Read 2 digit hex value into A
0155 fc6f b7 f0 f4                   STAA    T_Z+1   ; Save byte (least significant)
0156 fc72 fe f0 f3                   LDX     T_Z     ; Load full 4 hex value into X
0157 fc75 39                         RTS             ; RETURN
0158                         
0159                         ; -----------------------------------------------------
0160                         ; Print string FOLLOWING JSR ( terminated by $FF )
0161                         ;  IE: It starts at the `return addr` put onto the stack by JSR
0162                         ;  So actual return address needed is past the string
0163                         
0164                         ;fc76
0165 fc76 30                 STRING  TSX             ; Get loc. of return addr to X
0166 fc77 ee 00                      LDX     0,X     ; Get return addr to X
0167 fc79 09                         DEX             ; Point to byte before
0168 fc7a 08                 AGAIN   INX             ; Point to next byte
0169 fc7b a6 00                      LDAA    0,X     ; Get byte to be printed
0170 fc7d 81 ff                      CMPA    #$FF    ; End-string ?
0171 fc7f 27 04                      BEQ     ENDSTR  ; Yes: Go to finish up
0172 fc81 8d 8c                      BSR     PR_A    ; Print the byte
0173 fc83 20 f5                      BRA     AGAIN   ; Go back for next byte
0174 fc85 31                 ENDSTR  INS             ; Clean up stack...
0175 fc86 31                         INS             ;  ( pop off the return addr )
0176 fc87 6e 01                      JMP     1,X     ; Jump back to caller (RETURN)
0177                         
0178                         ; -----------------------------------------------------
0179                         ; FC89
0180 fc89 8d eb              GETADD  BSR     STRING  ; Print string...
0181 fc8b 20 53                      FCC     " S"    ;
0182 fc8d ff                         FCB     $FF     ; End-of-string
0183 fc8e 8d d5                      BSR     RD_X    ; Read 4 digit HEX addr value
0184 fc90 ff f0 ef                   STX     T_STRT  ; Save it
0185 fc93 8d e1                      BSR     STRING  ; Print string...
0186 fc95 20 46                      FCC     " F"    ;
0187 fc97 ff                         FCB     $FF     ; End-of-string
0188 fc98 8d cb                      BSR     RD_X    ; Read 4 digit HEX addr value
0189 fc9a ff f0 f1                   STX     T_STOP  ; Save it
0190 fc9d 39                         RTS             ; RETURN
0191                         
0192                         ; -----------------------------------------------------
0193                         ; Convert value in A to 2 x ASCII hex digits in A and B
0194                         ;FC9E
0195 fc9e 16                 ASCII   TAB             ; Copy A to B
0196 fc9f 84 f0                      ANDA    #$F0    ; Clear low order 4 bits of A
0197 fca1 44                         LSRA            ; Shift
0198 fca2 44                         LSRA            ;  right
0199 fca3 44                         LSRA            ;   4
0200 fca4 44                         LSRA            ;    bits
0201 fca5 81 09                      CMPA    #$09    ; Letter or number ?
0202 fca7 22 0b                      BHI     SUBT    ; 
0203 fca9 8b 30                      ADDA    #$30    ; Make it an ASCII number
0204 fcab c4 0f              AND     ANDB    #$0F    ; Clear high order bits of B
0205 fcad c1 09                      CMPB    #$09    ; Letter or number ?
0206 fcaf 22 07                      BHI     ADD     ;
0207 fcb1 cb 30                      ADDB    #$30    ; Make it an ASCII number
0208 fcb3 39                         RTS             ; RETURN
0209 fcb4 8b 37              SUBT    ADDA    #$37    ; Make it an ASCI letter
0210 fcb6 20 f3                      BRA     AND     ; Go to process low order value
0211 fcb8 cb 37              ADD     ADDB    #$37    ; Make it an ASII letter
0212 fcba 39                         RTS             ; RETURN
0213                         
0214                         ; -----------------------------------------------------
0215                         ; Print value in X as 4 hex digits
0216                         ;FCBB
0217 fcbb ff f0 ed           PRX     STX     T_TMPX  ; Save X
0218 fcbe b6 f0 ed                   LDAA    T_TMPX  ; Get high order byte to A
0219 fcc1 8d 06                      BSR     ZOUT    ; Print A as 2 hex digits
0220 fcc3 b6 f0 ee                   LDAA    T_TMPX+1 ; Get low order byte to A
0221 fcc6 8d 01                      BSR     ZOUT    ; Print A as 2 hex digits
0222 fcc8 39                         RTS             ; RETURN
0223                         
0224                         ; -----------------------------------------------------
0225                         ; Print value in A as 2 hex digits
0226                         ;FCC9
0227                         ;ZOUT    BSR     ASCII   ; Convert A to ASCII in A & B
0228                         ;        STAB    T_M     ; Save B
0229                         ;        JSR     PR_A    ; Print byte in A
0230                         ;        LDAA    T_M     ; Get 2nd byte into A
0231                         ;        JMP     PR_A    ; Print byte in A
0232                         
0233                         
0234                         ; -----------------------------------------------------
0235                         ; Print value in A as 2 hex digits, Preserve B
0236                         ; X unchanged by called routines
0237                         ; This is 1 byte shorter that ZOUT
0238 fcc9 37                 ZOUT        PSHB                ; Save B to STACK
0239 fcca 36                             PSHA                ; Save A to STACK
0240 fccb 8d d1                          BSR     ASCII       ; Convert A to ASCII in A & B
0241 fccd 37                             PSHB                ; Save B (2nd byte) to STACK
0242 fcce bd fc 0f                       JSR     PR_A        ; Print byte in A
0243 fcd1 32                             PULA                ; Get 2nd byte into A from STACK
0244 fcd2 bd fc 0f                       JSR     PR_A        ; Print byte in A
0245 fcd5 32                             PULA                ; Recover A from STACK
0246 fcd6 33                             PULB                ; Recover B from STACK
0247 fcd7 39                             RTS                 ; RETURN
0248                         
0249 fcd8 01                             NOP
0250 fcd9 01                             NOP
0251 fcda 01                             NOP
0252                         
0253                         ; second part of S19 version of ZIN
0254                         
0255 fcdb bd fc 31           ZIN2        JSR     BINARY      ; Convert A:B to binary to A
0256 fcde 16                             TAB                 ; B=A
0257 fcdf fb f0 e0                       ADDB    b_Csum      ; Add this value
0258 fce2 f7 f0 e0                       STAB    b_Csum      ; to the Checksum (for S19)
0259 fce5 39                             RTS                 ; RETURN
0260                         
0261                         ; -----------------------------------------------------
0262                         ; S19 format data load : Modded version of Mikbug code
0263                         ; NOTE THAT THIS IS IN THE WRONG PLACE AT PRESENT!!! It should be at FD07
0264                         ;
0265 fce6                    LOAD        EQU     *           ; L = Load = Input an S19 file
0266 fce6 bd fc 76                       JSR     STRING
0267 fce9 20 2b 20                       FCC     " + "
0268 fcec 0d 0a                          FCB     $0D,$0A     ; c/r l/f
0269 fcee ff                             FCB     $FF         ; End-Of-String
0270 fcef bd fc 00           .sRead      JSR     RD_CMD      ; Read+Echo, test for '.'
0271 fcf2 81 53                          CMPA    #'S         ; Is it `S` ?
0272 fcf4 26 f9                          BNE     .sRead      ; No: Keep waiting for `S`
0273 fcf6 bd fc 00                       JSR     RD_CMD      ; Read+Echo, test for '.'
0274 fcf9 81 39                          CMPA    #'9         ; Is it `9` ?  ( `S9` record )
0275 fcfb 27 26                          BEQ     STARTS      ; Yes: End-data, Back to START
0276 fcfd 81 31                          CMPA    #'1         ; Is it `1` ?  ( `S1` record )
0277 fcff 26 ee                          BNE     .sRead      ; No: Wait for next `S`
0278 fd01 7f f0 e0                       CLR     b_Csum      ; Clear checksum
0279 fd04 bd fc 49                       JSR     ZIN         ; Read 2xHex = data.byte count to A
0280 fd07 80 02                          SUBA    #2          ; Subtract 2 (to get bytes left in line)
0281 fd09 b7 f0 e1                       STAA    b_Count     ; Store byte count
0282 fd0c bd fc 65                       JSR     RD_X        ; Read 4xHex digit address to X
0283 fd0f bd fc 49           .sDoByt     JSR     ZIN         ; Read 2xHex digits, value to A
0284 fd12 7a f0 e1                       DEC     b_Count     ; Decrement our byte count
0285 fd15 27 05                          BEQ     .sChk       ; If end-of-line, go look at checksum
0286 fd17 a7 00                          STAA    0,X         ; Save byte where X points
0287 fd19 08                             INX                 ; Point X at next byte
0288 fd1a 20 f3                          BRA     .sDoByt     ; Go get next byte
0289 fd1c 7c f0 e0           .sChk       INC     b_Csum      ; Add 1 to checksum
0290 fd1f 27 ce                          BEQ     .sRead      ; OK: Go read next record
0291 fd21 8d 03                          BSR     PR_QM       ; Print "?"
0292 fd23 7e ff 8f           STARTS      JMP     START       ; Go to START
0293                         
0294 fd26 86 3f              PR_QM       LDAA #'?            ; Put '?' character in A
0295 fd28 7e fc 0f                       JMP     PR_A        ; Print it and return via PR_As RTS
0296                         
0297                         
0298                         
0299                         
0300                         ; -----------------------------------------------------
0301                         ; Read byte from ACIA.A to A
0302                         ;FD2B
0303 fd2b b6 f4 01           RD_A    LDAA    CTRLA   ; Get ACIA.A status byte
0304 fd2e 85 01                      BITA    #$01    ; Is byte ready in DATAA
0305 fd30 27 f9                      BEQ     RD_A    ; No: Try again
0306 fd32 b6 f4 00                   LDAA    DATAA   ; Get the data byte to A
0307 fd35 39                         RTS             ; RETURN
0308                         
0309                         ; -----------------------------------------------------
0310                         ;FD36
0311 fd36 8d 15              REGPRT  BSR     PRSP    ; Print a space
0312 fd38 fe f0 fd                   LDX     PSTACK  ; Point X at user's stack
0313 fd3b 8d 1c                      BSR     PR2     ; Print CC
0314 fd3d 8d 1a                      BSR     PR2     ; Print B
0315 fd3f 8d 18                      BSR     PR2     ; Print A
0316 fd41 8d 10                      BSR     PR4     ; Print X
0317 fd43 8d 0e                      BSR     PR4     ; Print PC
0318 fd45 ce f0 fd                   LDX     #PSTACK ; Point X at stack pointer
0319 fd48 8d 0a                      BSR     PR4X    ; Print stack pointer
0320 fd4a 7e ff 8f                   JMP     START   ; (RETURN) to MINIMON
0321                         
0322                         ; -----------------------------------------------------
0323                         ;FD4D
0324 fd4d 86 20              PRSP    LDAA    #$20    ; Put space character in A
0325 fd4f bd fc 0f                   JSR     PR_A    ; Print it
0326 fd52 39                         RTS             ; RETURN
0327                         
0328 fd53 08                 PR4     INX             ; Point X to next character
0329 fd54 a6 00              PR4X    LDAA    0,X     ; Get byte pointed to by X
0330 fd56 bd fc c9                   JSR     ZOUT    ; Print it
0331 fd59 08                 PR2     INX             ; Point X to next character
0332 fd5a a6 00                      LDAA    0,X     ; Get byte pointed to by X
0333 fd5c bd fc c9                   JSR     ZOUT    ; Print it
0334 fd5f 8d ec                      BSR     PRSP    ; Print a space
0335 fd61 39                         RTS             ; RETURN
0336                         
0337                         ; -----------------------------------------------------
0338                         ;FD62
0339 fd62 bd fc 89           BLKMOV  JSR     GETADD  ; Prompt for boundary addresses
0340 fd65 bd fc 76                   JSR     STRING  ; Print string...
0341 fd68 20 54 6f                   FCC     " To"   ;
0342 fd6b ff                         FCB     $FF     ; End-of-string
0343 fd6c bd fc 65                   JSR     RD_X    ; Read 4 hex digit value into X
0344 fd6f ff f0 ea                   STX     T_NEW   ; Store it as NEW start address
0345 fd72 ff f0 e6                   STX     T_X     ;   "    "
0346 fd75 fe f0 ef                   LDX     T_STRT  ; Put start address into X
0347 fd78 ff f0 e8                   STX     T_Y     ; Store it
0348 fd7b 8d 59                      BSR     SUB     ; Perform T_X minus T_Y
0349 fd7d 2a 23                      BPL     DOWN    ; Go to Move downwards
0350 fd7f fe f0 f1                   LDX     T_STOP  ; Get the STOP stop address
0351 fd82 08                         INX             ; Add 1 to it
0352 fd83 ff f0 f1                   STX     T_STOP  ; and save it
0353 fd86 fe f0 ef           DO_UP   LDX     T_STRT  ; Get START address
0354 fd89 bc f0 f1                   CPX     T_STOP  ; Compare it with STOP
0355 fd8c 26 03                      BNE     CONT_A  ; Finished ?
0356 fd8e 7e ff 8f           STARTB  JMP     START   ; Yes: back to MINIMON
0357 fd91 a6 00              CONT_A  LDAA    0,X     ; No: Get data
0358 fd93 08                         INX             ; Point X to next `old` address
0359 fd94 ff f0 ef                   STX     T_STRT  ; and store it
0360 fd97 fe f0 ea                   LDX     T_NEW   ; get address of NEW location
0361 fd9a a7 00                      STAA    0,X     ; Store the data at NEW address
0362 fd9c 08                         INX             ; Point X to next `new` address
0363 fd9d ff f0 ea                   STX     T_NEW   ; and store it
0364 fda0 20 e4                      BRA     DO_UP   ; loop back for next byte
0365 fda2 fe f0 f1           DOWN    LDX     T_STOP  ; Get end address
0366 fda5 ff f0 e6                   STX     T_X     ; Store it
0367 fda8 8d 2c                      BSR     SUB     ; Perform T_X minus T_Y
0368 fdaa bb f0 eb                   ADDA    T_NEW+1 ; Add NEW (low.byte) to A
0369 fdad fb f0 ea                   ADDB    T_NEW   ; Add NEW (high.byte) to B
0370 fdb0 b7 f0 eb                   STAA    T_NEW+1 ; Save NEW (low.byte)
0371 fdb3 f7 f0 ea                   STAB    T_NEW   ;         (high.byte)
0372 fdb6 fe f0 ef                   LDX     T_STRT  ; Get START address
0373 fdb9 09                         DEX             ; Subract 1 from X
0374 fdba ff f0 ef                   STX     T_STRT  ; Store it
0375 fdbd fe f0 f1           DO_DOWN LDX     T_STOP  ; Get STOP address
0376 fdc0 bc f0 ef                   CPX     T_STRT  ; Compare it with START address
0377 fdc3 27 c9                      BEQ     STARTB  ; Effecively `JMP START`
0378 fdc5 a6 00                      LDAA    0,X     ; Get data
0379 fdc7 09                         DEX             ; Subract 1 from X
0380 fdc8 ff f0 f1                   STX     T_STOP  ; Store it
0381 fdcb fe f0 ea                   LDX     T_NEW   ; Load NEW loc address into X
0382 fdce a7 00                      STAA    0,X     ; Store the data as NEW address
0383 fdd0 09                         DEX             ; Point X to next `new` address
0384 fdd1 ff f0 ea                   STX     T_NEW   ; Store it
0385 fdd4 20 e7                      BRA     DO_DOWN ; Loop back for next byte
0386                         
0387                         ; -----------------------------------------------------
0388                         ;FDD6
0389 fdd6 ce f0 e6           SUB     LDX     #T_X    ; Point X to start of T_X data
0390 fdd9 a6 01                      LDAA    1,X     ; A = T_X (low)
0391 fddb e6 00                      LDAB    0,X     ; B = T_X (high)
0392 fddd a0 03                      SUBA    3,X     ; A = A - T_Y (low)
0393 fddf e2 02                      SBCB    2,X     ; B = B - T_Y (high)
0394 fde1 39                         RTS             ; RETURN
0395                         
0396                         ; -----------------------------------------------------
0397                         ; S format data output : Modded version of Mikbug code
0398                         ;
0399                         
0400 fde2                    PUNCH       EQU     *           ; P = Punch : Output an S19 file
0401 fde2 bd fc 89                       JSR     GETADD      ; Prompt for "Start:","Stop:"
0402 fde5 fe f0 ef                       LDX     T_STRT     ; Get start address
0403 fde8 ff f0 de                       STX     d_TW        ; save it to work area
0404 fdeb b6 f0 f2           .fOut1      LDAA    T_STOP+1    ; get low order of end address
0405 fdee b0 f0 df                       SUBA    d_TW+1      ; Subtract low order start
0406 fdf1 f6 f0 f1                       LDAB    T_STOP      ; ( carry not affected by LDA )
0407 fdf4 f2 f0 de                       SBCB    d_TW        ; Subtract with Carry
0408 fdf7 26 04                          BNE     .fOut2
0409 fdf9 81 10                          CMPA    #16
0410 fdfb 25 02                          BCS     .fOut3
0411 fdfd 86 0f              .fOut2      LDAA    #15
0412 fdff 8b 04              .fOut3      ADDA    #4
0413 fe01 b7 f0 e1                       STAA    b_Count     ; FRAME COUNT THIS RECORD
0414 fe04 80 03                          SUBA    #3
0415 fe06 b7 f0 e2                       STAA    b_Temp      ; BYTE COUNT THIS RECORD
0416 fe09 bd fc 76                       JSR     STRING      ; Output this string...
0417 fe0c 0d 0a                          FCB     $0D,$0A       ; c/r l/f
0418 fe0e 53 31                          FCB     'S,'1       ; S1
0419 fe10 ff                             FCB     $FF         ; End-Of-String
0420 fe11 5f                             CLRB                ; Clear checksum
0421                         
0422                         ; Output frame count...
0423 fe12 ce f0 e1                       LDX     #b_Count    ; X = Address of Framecount
0424 fe15 bd fe a8                       JSR     .fOutHx2    ; O/P byte <-X and inc X
0425                         
