0439                         ;------------------------------------------
0440                         ; Binary / Decimal conversions
0441                         ;
0442                         ; The Galaxy program performs a number of operations involving 
0443                         ; the conversion of numbers from binary to decimal and vice versa for 
0444                         ; inputting and outputting numbers. The next trio of subroutines performs
0445                         ; the conversion of double precision binary whole numbers to 
0446                         ; and from decimal, and also checks that digits entered on the keyboard
0447                         ; fall within the range of the ASCII code for digits, namely BO 
0448                         ; through B9. The binary-to-decimal routine, labeled BINDEC, converts
0449                         ; a single or double precision binary number to its decimal 
0450                         ; equivalent up to five digits long, and stores the result in locations 51 
0451                         ; through 55 on page 00. Accumulator B is set to 01 for a single precision
0452                         ; number, and 02 for a double precision number, and the index 
0453                         ; register is set to the least significant byte of the number to be converted
0454                         ; before the BINDEC subroutine is called. The decimal-to-binary 
0455                         ; subroutine, labeled DCBN, converts the decimal values stored 
0456                         ; in locations 51 through 54 on page 00 to the equivalent double precision
0457                         ; binary number which is saved in location 28 for the least significant half,
0458                         ; and 29 on page 00 for the most significant half of the binary value.
0459                         ; The FNUM subroutine checks the memory location indicated by the index
0460                         ; register for a valid ASCII digit, and returns with 
0461                         ; the N flag reset if it is a valid digit, or set if it is not. 
0462                         ;
0463                         ; X=Address of number to convert
0464                         ; B=01 for X -> single precision
0465                         ; B=02 for X -> double precision
0466                         ;
0467                         ; Noe: Many 2-byte values in this program are in LSB:MSB ofter
0468                         
0469 0529 df 20              BINDEC      STX         PNTR1       ; Save pointer temporarily
0470 052b de 72                          LDX         PDG1ST      ; Set pointer to start of decimal table
0471 052d 6f 00                          CLR         $00,X       ; Clear digit table...
0472 052f 6f 01                          CLR         $01,X 
0473 0531 6f 02                          CLR         $02,X 
0474 0533 6f 03                          CLR         $03,X 
0475 0535 6f 04                          CLR         $04,X 
0476 0537 de 20                          LDX         PNTR1       ; Set pointer to binary value
0477 0539 a6 00                          LDAA        0,X         ; Get LSB
0478 053b 5a                             DECB                    ; Single precision ?
0479 053c 27 02                          BEQ         BNDC        ; Yes: most significanl half = 0
0480 053e e6 01                          LDAB        $01,X       ; No: get most significant hals
0481 0540 97 26              BNDC        STAA        STORE1      ; Store LSB
0482 0542 d7 27                          STAB        STORE1+$1   ; Store MSB
0483 0544 ce 10 27                       LDX         #$1027      ; Set up value for 10K
0484 0547 df 28                          STX         STORE2      ; Store for subtract routine
0485 0549 8d 21                          BSR         BD          ; Calculate 5th digit 
0486 054b d7 55                          STAB        DGT5TH      ; Store value of 5th digit
0487 054d ce e8 03                       LDX         #$E803      ; Binary value for 1K
0488 0550 df 28                          STX         STORE2      ; Store for subtract routine
0489 0552 8d 18                          BSR         BD          ; Calculate 4th digit
0490 0554 d7 54                          STAB        DGT4TH      ; Store value of 4th digit
0491 0556 ce 64 00                       LDX         #$6400      ; Binary value for 100
0492 0559 df 28                          STX         STORE2      ; Store for subtract routine
0493 055b 8d 0f                          BSR         BD          ; Calculate 3rd digit
0494 055d d7 53                          STAB        DGT3RD      ; Store value of 3rd digit
0495 055f 86 0a                          LDAA        #$0A        ; LS half value of 10 decimal
0496 0561 97 28                          STAA        STORE2      ; Store for subtract routine
0497 0563 8d 07                          BSR         BD          ; Calculate 2nd digit
0498 0565 d7 52                          STAB        DGT2ND      ; Store value of 2nd digit
0499 0567 96 26                          LDAA        STORE1      ; Get unit value
0500 0569 97 51                          STAA        DGT1ST      ; Store value of 1st digit
0501 056b 39                             RTS                     ; Return to calling program
0502                         
0503 056c 5f                 BD          CLRB                    ; Clear decimal digit counter
0504 056d 5c                 BD1         INCB                    ; Increment decimal digit
0505 056e 96 26                          LDAA        STORE1      ; Fetch the least significant half 
0506 0570 90 28                          SUBA        STORE2      ; Subtract LS half of constant
0507 0572 97 26                          STAA        STORE1      ; Save LS half of result
0508 0574 96 27                          LDAA        STORE1+$1   ; Fetch most significant half
0509 0576 92 29                          SBCA        STORE2+$1   ; Subtract MS half of constant
0510 0578 97 27                          STAA        STORE1+$1   ; Save MS half of result
0511 057a 24 f1                          BCC         BD1         ; If greater than 0, continue subtraction
0512 057c 96 26                          LDAA        STORE1      ; Else, restore binary value
0513 057e 9b 28                          ADDA        STORE2      ; Add LS half back to result
0514 0580 97 26                          STAA        STORE1      ; Restore result in memory
0515 0582 96 27                          LDAA        STORE1+$1   ; Fetch MS half of result
0516 0584 99 29                          ADCA        STORE2+$1   ; Add MS half back to result
0517 0586 97 27                          STAA        STORE1+$1   ; Restore result in memory
0518 0588 5a                             DECB                    ; Decrement decimal digit to correct
0519 0589 39                             RTS                     ; Return
0520                         
0521 058a 7f 00 29           DCBN        CLR         STORE2+$1   ; Clear MS half of result 
0522 058d 96 51                          LDAA        DGT1ST      ; Fetch units digit
0523 058f 97 28                          STAA        STORE2      ; Store in work area
0524 0591 d6 52                          LDAB        DGT2ND      ; Fetch ten’s digit
0525 0593 27 07                          BEQ         DC1         ; Digit = 0? Yes, do 100’s digit
0526 0595 ce 0a 00                       LDX         #$0A00      ; Binary value of 10
0527 0598 df 26                          STX         STORE1      ; To be added B times
0528 059a 8d 17                          BSR         TOBN        ; Add 10’s digit
0529                         
0530 059c d6 53              DC1         LDAB        DGT3RD      ; Get 3rd digit
0531 059e 27 07                          BEQ         DC2         ; Digit = 0? Yes, do 1000’s digit
0532 05a0 ce 64 00                       LDX         #$6400      ; Binary value of 100
0533 05a3 df 26                          STX         STORE1      ; To be added B times
0534 05a5 8d 0c                          BSR         TOBN        ; Add 100’s digit
0535 05a7 d6 54              DC2         LDAB        DGT4TH      ; Get 4th digit
0536 05a9 27 07                          BEQ         DC3         ; Digit = 0? Yes, finished
0537 05ab ce e8 03                       LDX         #$E803      ; Binary value of 1000
0538 05ae df 26                          STX         STORE1      ; To be added B times
0539 05b0 8d 01                          BSR         TOBN        ; Add 1000’s digit
0540 05b2 39                 DC3         RTS                     ; Return, binary value in STORE1
0541                         
0542 05b3 ce 00 28           TOBN        LDX         #STORE2     ; Set pointer to binary value
0543 05b6 bd 08 02                       JSR         TO1         ; Add value to STORE1
0544 05b9 5a                             DECB                    ; Multiplier =0?
0545 05ba 26 f7                          BNE         TOBN        ; No, continue
0546 05bc 39                             RTS                     ; Yes, return 
0547                         
