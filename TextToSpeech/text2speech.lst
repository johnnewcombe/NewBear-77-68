   02A0 A6 00         [ 5]  234         LDAA    0,X             ;  get high byte of word pointed to by X
   02A2 E6 01         [ 5]  235         LDAB    1,X             ;  get low byte of word pointed to by X
   02A4 B7 1A 16      [ 5]  236         STAA    TEMP
