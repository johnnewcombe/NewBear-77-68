                            238 ;END:     JMP     MAINLOOP  ;START   ; all done
                            239 
                            240 ;--------------------------------------------------------------
                            241 ; Gets the weight data from the scales and rerurns with carry
                            242 ; set if a valid reading, carry clear otherwise. A valid weight
                            243 ; reading resets the idle count. Data received is stored in
                            244 ; T_WEIGHT and MSB in A.
                            245 ;--------------------------------------------------------------
   028B                     246 GETDATA:
   028B BD 03 23      [ 9]  247         JSR     RD_XB           ; read 4 hex characters into X
   028E FF 1B 18      [ 6]  248         STX     T_WEIGHT        ; store X
   0291 0C            [ 2]  249         CLC
   0292 B6 1B 18      [ 4]  250         LDAA    T_WEIGHT        ; get fist byte (stones)
   0295 27 04         [ 4]  251         BEQ     GDDONE          ; idle message
   0297 7F 00 2D      [ 6]  252         CLR     IDLE_TICS       ; not an idle message so reset the idle counter
   029A 0D            [ 2]  253         SEC                     ; non idle message return with carry set
   029B 39            [ 5]  254 GDDONE:  RTS
                            255 
                            256 ; -----------------------------------------------------
                            257 ; PR_DEC: Puts 3 decimal digits in DEC, DEC+1 and DEC+2
                            258 ;
                            259 ;       !! ONLY WORKS WITH VALUES BELOW 128 !!
                            260 ; -----------------------------------------------------
   029C 5F            [ 2]  261 PR_DEC:  CLRB            ; Clear B for hundreds
                            262 
   029D 81 64         [ 2]  263 HUND:    CMPA    #100    ; 100 or more?
                            264 
   029F 2D 05         [ 4]  265         BLT     TENS
   02A1 80 64         [ 2]  266         SUBA    #100    ; Sub 100
   02A3 5C            [ 2]  267         INCB            ; Increment hundred counter
ASxxxx Assembler V05.50.5  (Motorola 6800/6802/6808)                    Page 6
Hexadecimal [16-Bits]                                 Fri May  8 20:16:17 2026



   02A4 20 F7         [ 4]  268         BRA     HUND
                            269 
   02A6 F7 1B 12      [ 5]  270 TENS:    STAB    DEC     ; store the hundreds
                            271 
   02A9 5F            [ 2]  272         CLRB
   02AA 81 0A         [ 2]  273 TENS1:   CMPA    #10     ; 10 or more?
   02AC 2D 05         [ 4]  274         BLT     UNITS
   02AE 80 0A         [ 2]  275         SUBA    #10     ; Sub 10
   02B0 5C            [ 2]  276         INCB            ; Increment ten counter
   02B1 20 F7         [ 4]  277         BRA     TENS1
                            278 
   02B3 F7 1B 13      [ 5]  279 UNITS:   STAB    DEC+1
   02B6 B7 1B 14      [ 5]  280         STAA    DEC+2   ; Final remainder is units
                            281 
   02B9 39            [ 5]  282         RTS
                            283 
                            284 
                            285 ; -----------------------------------------------------
                            286 ; Print string FOLLOWING JSR ( terminated by 0xFF ) to
                            287 ; ACIA(b) and ACIA(b)
                            288 ; -----------------------------------------------------
   02BA 30            [ 4]  289 STRINGB: TSX             ; Get loc. of return addr to X
   02BB EE 00         [ 6]  290          LDX     0,X     ; Get return addr to X
   02BD 09            [ 4]  291          DEX             ; Point to byte before
   02BE 08            [ 4]  292 STRB1:   INX             ; Point to next byte
   02BF A6 00         [ 5]  293          LDAA    0,X     ; Get byte to be printed
   02C1 81 FF         [ 2]  294          CMPA    #0xFF    ; End-string ?
   02C3 27 0E         [ 4]  295          BEQ     ENDSTR  ; Yes: Go to finish up
   02C5 F6 F0 FF      [ 4]  296          LDAB    PANEL
   02C8 C5 01         [ 2]  297          BITB     #1
   02CA 27 03         [ 4]  298          BEQ     STRB    ; panel switch 0 is debug and copies data to A
   02CC BD FC 0F      [ 9]  299          JSR     PR_A    ; Print the byte to ACIA(a) (A is maintained)
                            300                          ;  DEBUG depending on panel data switch zero
   02CF 8D 47         [ 8]  301 STRB:    BSR     PR_B    ; Print the byte to ACIA(b)
   02D1 20 EB         [ 4]  302          BRA     STRB1   ; Go back for next byte
   02D3 31            [ 4]  303 ENDSTR:  INS             ; Clean up stack...
   02D4 31            [ 4]  304          INS             ;  ( pop off the return addr )
   02D5 6E 01         [ 4]  305          JMP     1,X     ; Jump back to caller (RETURN)
                            306 
                            307 ; -----------------------------------------------------
                            308 ; Prints a string pointed to by X
                            309 ; -----------------------------------------------------
   02D7 A6 00         [ 5]  310 STRINGBX:   LDAA    0,X         ; get char
   02D9 81 FF         [ 2]  311             CMPA    #0xFF        ; is character NULL?
   02DB 27 0F         [ 4]  312             BEQ     DONEB       ; yes, end of string
                            313             ;STAA   PANEL     ; REMOVED, too much activity
   02DD F6 F0 FF      [ 4]  314             LDAB    PANEL
   02E0 C5 01         [ 2]  315             BITB    #1
   02E2 27 03         [ 4]  316             BEQ     STRBX       ; panel switch 0 is debug and copies data to A
   02E4 BD FC 0F      [ 9]  317             JSR     PR_A        ; Print the byte to ACIA(a) (A is maintained)
   02E7 8D 2F         [ 8]  318 STRBX:      BSR     PR_B        ; Print the byte to ACIA(b)
   02E9 08            [ 4]  319             INX
   02EA 20 EB         [ 4]  320             BRA     STRINGBX
   02EC 39            [ 5]  321 DONEB:      RTS
                            322 
