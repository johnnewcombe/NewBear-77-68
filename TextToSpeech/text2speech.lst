   019E 7C 19 66      [ 6]  102 IDLE:    INC     IDLE_COUNT      ; increase the idle count
   01A1 B6 19 66      [ 4]  103         LDAA    IDLE_COUNT      ; see if idle count = max idle time
   01A4 81 0A         [ 2]  104         CMPA    #IDLE_SECS      ; a data message appears every second
   01A6 27 03         [ 4]  105         BEQ     IDLE1           ; not reached the max idle time
   01A8 7E 01 05      [ 3]  106         JMP     MAINLOOP             ; nothing to do yet
                            107 
   01AB 7F 19 66      [ 6]  108 IDLE1:   CLR     IDLE_COUNT      ; time to output an idle message so reset the count
   01AE B6 19 67      [ 4]  109         LDAA    IDLE_MSG_ID     ; get next Message ID
   01B1 81 05         [ 2]  110         CMPA    #IDLE_MSG_CNT   ; are we beyond the end of the list
   01B3 26 04         [ 4]  111         BNE     IDLE_OP         ; still at valid id so output idle message
   01B5 7F 19 67      [ 6]  112         CLR     IDLE_MSG_ID     ; beyond last message so reset the current msg to zero
   01B8 4F            [ 2]  113         CLRA                    ; set currentid back to 0
   01B9                     114 IDLE_OP:
   01B9 7C 19 67      [ 6]  115         INC     IDLE_MSG_ID     ; set to next message for the next next time
   01BC CE 11 AA      [ 3]  116         LDX     #IDLEPTR        ; A has phrase ID, set X to the base address
   01BF BD 02 35      [ 9]  117         JSR     PHRASE_OUT
   01C2 7E 01 05      [ 3]  118         JMP     MAINLOOP
                            119 
