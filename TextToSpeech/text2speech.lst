Hexadecimal [16-Bits]                                 Fri May  8 20:16:17 2026



                            323 ; -----------------------------------------------------
                            324 ; Reads a character from ACIA(b) into A
                            325 ; -----------------------------------------------------
   02ED 7C 1B 15      [ 6]  326 RD_B:    INC     RND         ; simple way to get a random number
   02F0 B6 F4 03      [ 4]  327         LDAA    CTRLB       ; Get ACIA.A status byte
   02F3 85 01         [ 2]  328         BITA    #01         ; Is byte ready in DATAb
   02F5 27 F6         [ 4]  329         BEQ     RD_B        ; No: Try again
   02F7 B6 F4 02      [ 4]  330         LDAA    DATAB       ; Get the data byte to A
   02FA 84 7F         [ 2]  331         ANDA    #0x7F        ; Mask off parity bit if it exists
   02FC 39            [ 5]  332         RTS                 ; RETURN
                            333 
                            334 ; -----------------------------------------------------
                            335 ;
                            336 ; -----------------------------------------------------
   02FD 8D EE         [ 8]  337 ZINB:    BSR     RD_B    ; Read a character
   02FF BD FC 1D      [ 9]  338         JSR     VHEX    ; Is it a hex character ?
   0302 25 12         [ 4]  339         BCS     Z_PRQM  ; No: go to print `?`
   0304 B7 1B 05      [ 5]  340         STAA    T_Q     ; Yes: Save Acc.A
   0307 8D E4         [ 8]  341         BSR     RD_B    ; Read 2nd character
   0309 BD FC 1D      [ 9]  342         JSR     VHEX    ; Is it a hex character ?
   030C 25 08         [ 4]  343         BCS     Z_PRQM  ; No: go to print `?`
   030E 16            [ 2]  344         TAB             ; Yes: Put it into Acc.B
   030F B6 1B 05      [ 4]  345         LDAA    T_Q     ; Retrieve 1st hex char to Acc.A
   0312 BD FC 31      [ 9]  346         JSR     BINARY  ; Convert A:B to binary
   0315 39            [ 5]  347         RTS             ; RETURN
   0316                     348 Z_PRQM:  ;LDAA    #'?     ; Load `?` into A
                            349         ;BSR     PR_B    ; Print it
   0316 20 E5         [ 4]  350         BRA     ZINB    ; Go back to start of hex input
                            351 
                            352 
                            353 ; -----------------------------------------------------
                            354 ; Print character in A to ACIA(b)
                            355 ; -----------------------------------------------------
   0318 F6 F4 03      [ 4]  356 PR_B:    LDAB    CTRLB   ; Get ACIA(a) status byte
   031B C5 02         [ 2]  357         BITB    #02     ; Is it busy ?
   031D 27 F9         [ 4]  358         BEQ     PR_B    ; Yes: Try again
   031F B7 F4 02      [ 5]  359         STAA    DATAB   ;  No: Send data
   0322 39            [ 5]  360 PRB_END: RTS             ; RETURN
                            361 
                            362 ; -----------------------------------------------------
                            363 ; Read 4 hex digits and put value into X
                            364 ; -----------------------------------------------------
   0323 8D D8         [ 8]  365 RD_XB:   BSR     ZINB    ; Read 2 digit hex value into A
   0325 B7 1B 06      [ 5]  366         STAA    T_Z     ; Save byte (most significant)
   0328 8D D3         [ 8]  367         BSR     ZINB    ; Read 2 digit hex value into A
   032A B7 1B 07      [ 5]  368         STAA    T_Z+1   ; Save byte (least significant)
   032D FE 1B 06      [ 5]  369         LDX     T_Z     ; Load full 4 hex value into X
   0330 39            [ 5]  370         RTS             ; RETURN
                            371 
                            372 ; -----------------------------------------------------
                            373 ; Adds A to X and leaves the result in X, A is
                            374 ; preserved.
                            375 ; -----------------------------------------------------
   0331 36            [ 4]  376 ADX:     PSHA
   0332 FF 1B 10      [ 6]  377         STX     T_TMP
ASxxxx Assembler V05.50.5  (Motorola 6800/6802/6808)                    Page 8
Hexadecimal [16-Bits]                                 Fri May  8 20:16:17 2026



   0335 BB 1B 11      [ 4]  378         ADDA    T_TMP+1   ; add A to low byte
   0338 B7 1B 11      [ 5]  379         STAA    T_TMP+1
   033B B6 1B 10      [ 4]  380         LDAA    T_TMP     ; get high byte
   033E 89 00         [ 2]  381         ADCA    #0      ; add carry only
   0340 B7 1B 10      [ 5]  382         STAA    T_TMP
   0343 FE 1B 10      [ 5]  383         LDX     T_TMP
   0346 32            [ 4]  384         PULA
   0347 39            [ 5]  385         RTS
                            386 
                            387 ; -----------------------------------------------------
                            388 ; Loads X with A, A is preserved.
                            389 ; -----------------------------------------------------
   0348 B7 1B 11      [ 5]  390 TAX:    STAA    T_TMP+1       ; store A as low byte of X
   034B 7F 1B 10      [ 6]  391         CLR     T_TMP         ; zero the high byte
   034E FE 1B 10      [ 5]  392         LDX     T_TMP         ; load X
   0351 39            [ 5]  393         RTS
                            394 
                            395 ; -----------------------------------------------------
                            396 ; Prints the message " n stones n pounds"
                            397 ; place stones in MSB of X and pound in LSB
                            398 ; -----------------------------------------------------
   0352                     399 PR_WEIGHT:
                            400 
   0352 FF 1B 0E      [ 6]  401         STX     T_W
   0355 B6 1B 0E      [ 4]  402         LDAA    T_W
   0358 BD 03 48      [ 9]  403         JSR     TAX
   035B BD 03 C7      [ 9]  404         JSR     PR_WORD         ; n
   035E BD 03 80      [ 9]  405         JSR     PR_SPCB
   0361 CE 01 2B      [ 3]  406         LDX     #STONES
   0364 BD 03 C7      [ 9]  407         JSR     PR_WORD         ; "stones"
   0367 BD 03 80      [ 9]  408         JSR     PR_SPCB
   036A B6 1B 0F      [ 4]  409         LDAA    T_W+1            ; Load high byte of X into Accumulator A
   036D BD 03 48      [ 9]  410         JSR     TAX
   0370 BD 03 C7      [ 9]  411         JSR     PR_WORD         ; n
   0373 CE 00 F5      [ 3]  412         LDX     #POUNDS
   0376 BD 03 80      [ 9]  413         JSR     PR_SPCB
   0379 BD 03 C7      [ 9]  414         JSR     PR_WORD         ; "pounds"
   037C BD 03 8B      [ 9]  415         JSR     PR_CRB
   037F 39            [ 5]  416         RTS
                            417 
                            418 ; -----------------------------------------------------
                            419 ; Prints a space on both consoles (preserves A)
                            420 ; -----------------------------------------------------
   0380 36            [ 4]  421 PR_SPCB: PSHA
   0381 86 20         [ 2]  422         LDAA    #0x20        ; Put space character in A
   0383 BD FC 0F      [ 9]  423         JSR     PR_A
   0386 BD 03 18      [ 9]  424         JSR     PR_B        ; Print it
   0389 32            [ 4]  425         PULA
   038A 39            [ 5]  426         RTS                 ; RETURN
                            427 
                            428 ; -----------------------------------------------------
                            429 ; Prints a CRLF on both consoles (preserves A)
                            430 ; -----------------------------------------------------
   038B 36            [ 4]  431 PR_CRB:     PSHA
   038C 86 0D         [ 2]  432             LDAA    #0x0D        ; Put CHAR character in A
ASxxxx Assembler V05.50.5  (Motorola 6800/6802/6808)                    Page 9
Hexadecimal [16-Bits]                                 Fri May  8 20:16:17 2026



   038E BD FC 0F      [ 9]  433             JSR     PR_A
   0391 BD 03 18      [ 9]  434             JSR     PR_B        ; Print it
   0394 86 0A         [ 2]  435             LDAA    #0x0A
   0396 F6 F0 FF      [ 4]  436             LDAB     PANEL
   0399 C5 01         [ 2]  437             BITB    #1
   039B 27 03         [ 4]  438             BEQ     PR_CRB1
   039D BD FC 0F      [ 9]  439             JSR     PR_A
   03A0 BD 03 18      [ 9]  440 PR_CRB1:    JSR     PR_B        ; Print it
   03A3 32            [ 4]  441             PULA
   03A4 39            [ 5]  442             RTS                 ; RETURN
                            443 
                            444 ; -----------------------------------------------------
                            445 ; Outputs a phrase from the memory location in X
                            446 ; -----------------------------------------------------
   03A5                     447 PR_PHRASE:
                            448 
   03A5 A6 00         [ 5]  449 PR_PH1:  LDAA    0,X         ; get high byte of word
   03A7 E6 01         [ 5]  450         LDAB    1,X         ; get low byte
   03A9 81 FF         [ 2]  451         CMPA    #0xFF        ; check high byte
   03AB 27 19         [ 4]  452         BEQ     PR_PH2      ; high byte is 0xFF so we're done
   03AD FF 1B 0A      [ 6]  453 PR_PH3:  STX     T_Y         ; save table pointer
   03B0 B7 1B 0C      [ 5]  454         STAA    T_P
   03B3 F7 1B 0D      [ 5]  455         STAB    T_P+1
   03B6 FE 1B 0C      [ 5]  456         LDX     T_P         ; X now points to the word
   03B9 BD 03 C7      [ 9]  457         JSR     PR_WORD
   03BC BD 03 80      [ 9]  458         JSR     PR_SPCB
   03BF FE 1B 0A      [ 5]  459         LDX     T_Y         ; restore table pointer
   03C2 08            [ 4]  460         INX                 ; move to next entry
   03C3 08            [ 4]  461         INX                 ; (2 bytes per entry)
   03C4 20 DF         [ 4]  462         BRA     PR_PH1
   03C6 39            [ 5]  463 PR_PH2:  RTS
                            464 
                            465 ; -----------------------------------------------------
                            466 ; Outputs a word based on value in X
                            467 ; -----------------------------------------------------
   03C7                     468 PR_WORD:
   03C7 FF 1B 08      [ 6]  469             STX     T_X             ; use ASL and ROL to multiply by 2 (pointer is 2 bytes wide)
   03CA 78 1B 09      [ 6]  470             ASL     T_X+1           ; shift low byte left, bit 7 goes to carry
   03CD 79 1B 08      [ 6]  471             ROL     T_X             ; rotate high byte left, carry in from low byte
   03D0 FE 1B 08      [ 5]  472             LDX     T_X
   03D3 FF 1B 08      [ 6]  473             STX     T_X             ; Stash X
   03D6 B6 1B 08      [ 4]  474             LDAA    T_X             ; High byte of X
   03D9 F6 1B 09      [ 4]  475             LDAB    T_X+1           ; Low byte of X
   03DC CB 06         [ 2]  476             ADDB    #<WORDPTR    ; Add low byte of WORDPTR address
   03DE 89 04         [ 2]  477             ADCA    #>WORDPTR    ; Add high byte of WORDPTR address + carry
   03E0 B7 1B 08      [ 5]  478             STAA    T_X             ; T_X has the address of the pointer NOT the word
   03E3 F7 1B 09      [ 5]  479             STAB    T_X+1
   03E6 FE 1B 08      [ 5]  480             LDX     T_X             ; X has the address of the pointer NOT the word
                            481 
   03E9 A6 00         [ 5]  482             LDAA    0,X             ; get the hi byte of the word
   03EB B7 1B 08      [ 5]  483             STAA    T_X
   03EE A6 01         [ 5]  484             LDAA    1,X             ; get the low byte of the word
   03F0 B7 1B 09      [ 5]  485             STAA    T_X+1
   03F3 FE 1B 08      [ 5]  486             LDX     T_X             ; X now has address of the word
   03F6 BD 02 D7      [ 9]  487             JSR     STRINGBX        ; output the word
