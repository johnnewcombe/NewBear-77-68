0084                         ; -----------------------------------------------------
0085                         ; PR_DEC: Puts 3 decimal digits in DEC, DEC+1 and DEC+2
0086                         ;
0087                         ;       !! ONLY WORKS WITH VALUES BELOW 128 !!
0088                         ; -----------------------------------------------------
0089 0243 5f                 PR_DEC  CLRB            ; Clear B for hundreds
0090                         
0091 0244 81 64              HUND    CMPA    #100    ; 100 or more?
0092                         
0093 0246 2d 05                      BLT     TENS
0094 0248 80 64                      SUBA    #100    ; Sub 100
0095 024a 5c                         INCB            ; Increment hundred counter
0096 024b 20 f7                      BRA     HUND
0097                         
0098 024d f7 03 cf           TENS    STAB    DEC     ; store the hundreds
0099                         
0100 0250 5f                         CLRB
0101 0251 81 0a              TENS1   CMPA    #10     ; 10 or more?
0102 0253 2d 05                      BLT     UNITS
0103 0255 80 0a                      SUBA    #10     ; Sub 10
0104 0257 5c                         INCB            ; Increment ten counter
0105 0258 20 f7                      BRA     TENS1
0106                         
0107 025a f7 03 d0           UNITS   STAB    DEC+1
0108 025d b7 03 d1                   STAA    DEC+2   ; Final remainder is units
0109                         
0110 0260 39                         RTS
0111                         
0112                         
0113                         ; -----------------------------------------------------
0114                         ; Print string FOLLOWING JSR ( terminated by $FF ) to
0115                         ; ACIA(b) and ACIA(b)
0116                         ; -----------------------------------------------------
0117 0261 30                 STRINGB TSX             ; Get loc. of return addr to X
0118 0262 ee 00                      LDX     0,X     ; Get return addr to X
0119 0264 09                         DEX             ; Point to byte before
0120 0265 08                 AGAIN   INX             ; Point to next byte
0121 0266 a6 00                      LDAA    0,X     ; Get byte to be printed
0122 0268 81 ff                      CMPA    #$FF    ; End-string ?
0123 026a 27 07                      BEQ     ENDSTR  ; Yes: Go to finish up
0124 026c bd fc 0f                   JSR     PR_A    ; Print the byte to ACIA(a) (A is maintained)
0125 026f 8d 3b                      BSR     PR_B    ; Print the byte to ACIA(b)
0126 0271 20 f2                      BRA     AGAIN   ; Go back for next byte
0127 0273 31                 ENDSTR  INS             ; Clean up stack...
0128 0274 31                         INS             ;  ( pop off the return addr )
0129 0275 6e 01                      JMP     1,X     ; Jump back to caller (RETURN)
0130                         
0131                         ; -----------------------------------------------------
0132                         ; Prints a string pointed to by X
0133                         ; -----------------------------------------------------
0134 0277 a6 00              STRINGBX    LDAA    0,X         ; get char
0135 0279 81 ff                          CMPA    #$FF        ; is character NULL?
0136 027b 27 08                          BEQ     DONEB       ; yes, end of string
0137 027d bd fc 0f                       JSR     PR_A        ; Print the byte to ACIA(a) (A is maintained)
0138 0280 8d 2a                          BSR     PR_B        ; Print the byte to ACIA(b)
0139 0282 08                             INX
0140 0283 20 f2                          BRA     STRINGBX
0141 0285 39                 DONEB       RTS
0142                         
0143                         ; -----------------------------------------------------
0144                         ; Reads a character from ACIA(b) into A
0145                         ; -----------------------------------------------------
0146 0286 b6 f4 03           RD_B    LDAA    CTRLB       ; Get ACIA.A status byte
0147 0289 85 01                      BITA    #01         ; Is byte ready in DATAb
0148 028b 27 f9                      BEQ     RD_B        ; No: Try again
0149 028d b6 f4 02                   LDAA    DATAB       ; Get the data byte to A
0150                                 ;ANDA    #$7F        ; Mask off parity bit if it exists
0151 0290 39                         RTS                 ; RETURN
0152                         
0153                         ; -----------------------------------------------------
0154                         ;
0155                         ; -----------------------------------------------------
0156 0291 8d f3              ZINB    BSR     RD_B    ; Read a character
0157 0293 bd fc 1d                   JSR     VHEX    ; Is it a hex character ?
0158 0296 25 12                      BCS     Z_PRQM  ; No: go to print `?`
0159 0298 b7 03 ca                   STAA    T_Q     ; Yes: Save Acc.A
0160 029b 8d e9                      BSR     RD_B    ; Read 2nd character
0161 029d bd fc 1d                   JSR     VHEX    ; Is it a hex character ?
0162 02a0 25 08                      BCS     Z_PRQM  ; No: go to print `?`
0163 02a2 16                         TAB             ; Yes: Put it into Acc.B
0164 02a3 b6 03 ca                   LDAA    T_Q     ; Retrieve 1st hex char to Acc.A
0165 02a6 bd fc 31                   JSR     BINARY  ; Convert A:B to binary
0166 02a9 39                         RTS             ; RETURN
0167                         Z_PRQM  ;LDAA    #'?     ; Load `?` into A
0168                                 ;BSR     PR_B    ; Print it
0169 02aa 20 e5                      BRA     ZINB    ; Go back to start of hex input
0170                         
0171                         ; -----------------------------------------------------
0172                         ; Print character in A to ACIA(b)
0173                         ; -----------------------------------------------------
0174 02ac f6 f4 03           PR_B    LDAB    CTRLB   ; Get ACIA(a) status byte
0175 02af c5 02                      BITB    #02     ; Is it busy ?
0176 02b1 27 f9                      BEQ     PR_B    ; Yes: Try again
0177 02b3 b7 f4 02                   STAA    DATAB   ;  No: Send data
0178 02b6 39                 PRB_END RTS             ; RETURN
0179                         
0180                         ; -----------------------------------------------------
0181                         ; Read 4 hex digits and put value into X
0182                         ; -----------------------------------------------------
0183                         RD_XB   ;JSR     PRSPB   ; Print a space
0184 02b7 8d d8                      BSR     ZINB    ; Read 2 digit hex value into A
0185 02b9 b7 03 cb                   STAA    T_Z     ; Save byte (most significant)
0186 02bc 8d d3                      BSR     ZINB    ; Read 2 digit hex value into A
0187 02be b7 03 cc                   STAA    T_Z+1   ; Save byte (least significant)
0188 02c1 fe 03 cb                   LDX     T_Z     ; Load full 4 hex value into X
0189 02c4 39                         RTS             ; RETURN
0190                         
0191                         ; -----------------------------------------------------
0192                         ; Random idle phrase to ports B
0193                         ; -----------------------------------------------------
0194 02c5 39                 IDLE    RTS
0195                         
0196                         
0197                         ; -----------------------------------------------------
0198                         ; Prints the message "You weight n stones n pounds"
0199                         ; place stones in A and Pounds in B
0200                         ; -----------------------------------------------------
0201                         PRWEIGHT
0202                         
0203 02c6 b6 03 cd                   LDAA    TEMP            ; Load high byte of X into Accumulator A
0204 02c9 bd 02 f7                   JSR     PR_NUMB
0205 02cc bd 02 61                   JSR     STRINGB
0206 02cf 20 73 74 6f 6e 65          FCC     " stones "
     73 20
0207 02d7 00 ff                      fdb     $FF
0208 02d9 b6 03 ce                   LDAA    TEMP+1            ; Load high byte of X into Accumulator A
0209 02dc bd 02 f7                   JSR     PR_NUMB
0210 02df bd 02 61                   JSR     STRINGB
0211 02e2 20 70 6f 75 6e 64          FCC     " pounds"
     73
0212 02e9 0d 0a ff                   FCB     $0D, $0A,$FF
0213                         
