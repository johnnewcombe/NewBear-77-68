                            505 ; -----------------------------------------------------
                            506 ; Outputs a phrase from the memory location in X
                            507 ; -----------------------------------------------------
   0484                     508 PR_PHRASE:
                            509 
   0484 A6 00         [ 5]  510 PR_PH1:  LDAA    0,X         ; get high byte of word
   0486 E6 01         [ 5]  511         LDAB    1,X         ; get low byte
   0488 81 FF         [ 2]  512         CMPA    #0xFF        ; check high byte
   048A 27 19         [ 4]  513         BEQ     PR_PH2      ; high byte is 0xFF so we're done
   048C FF 00 05      [ 6]  514 PR_PH3:  STX     T_Y         ; save table pointer
   048F B7 00 07      [ 5]  515         STAA    T_P
   0492 F7 00 08      [ 5]  516         STAB    T_P+1
   0495 FE 00 07      [ 5]  517         LDX     T_P         ; X now points to the word
   0498 BD 04 A6      [ 9]  518         JSR     PR_WORD
   049B BD 04 62      [ 9]  519         JSR     PR_SPCB
   049E FE 00 05      [ 5]  520         LDX     T_Y         ; restore table pointer
   04A1 08            [ 4]  521         INX                 ; move to next entry
   04A2 08            [ 4]  522         INX                 ; (2 bytes per entry)
   04A3 20 DF         [ 4]  523         BRA     PR_PH1
   04A5 39            [ 5]  524 PR_PH2:  RTS
                            525 
                            526 ; -----------------------------------------------------
                            527 ; Outputs a word based on value in X
                            528 ; -----------------------------------------------------
   04A6                     529 PR_WORD:
   04A6 FF 00 03      [ 6]  530             STX     T_X             ; use ASL and ROL to multiply by 2 (pointer is 2 bytes wide)
   04A9 78 00 04      [ 6]  531             ASL     T_X+1           ; shift low byte left, bit 7 goes to carry
   04AC 79 00 03      [ 6]  532             ROL     T_X             ; rotate high byte left, carry in from low byte
   04AF FE 00 03      [ 5]  533             LDX     T_X
   04B2 FF 00 03      [ 6]  534             STX     T_X             ; Stash X
   04B5 B6 00 03      [ 4]  535             LDAA    T_X             ; High byte of X
   04B8 F6 00 04      [ 4]  536             LDAB    T_X+1           ; Low byte of X
   04BB CB DF         [ 2]  537             ADDB    #<WORDPTR    ; Add low byte of WORDPTR address
   04BD 89 04         [ 2]  538             ADCA    #>WORDPTR    ; Add high byte of WORDPTR address + carry
   04BF B7 00 03      [ 5]  539             STAA    T_X             ; T_X has the address of the pointer NOT the word
   04C2 F7 00 04      [ 5]  540             STAB    T_X+1
   04C5 FE 00 03      [ 5]  541             LDX     T_X             ; X has the address of the pointer NOT the word
                            542 
   04C8 A6 00         [ 5]  543             LDAA    0,X             ; get the hi byte of the word
   04CA B7 00 03      [ 5]  544             STAA    T_X
   04CD A6 01         [ 5]  545             LDAA    1,X             ; get the low byte of the word
   04CF B7 00 04      [ 5]  546             STAA    T_X+1
