0171                         ;--------------------------------------------------------------
0172                         ; Gets the weight data from the scales and rerurns with carry
0173                         ; set if a valid reading, carry clear otherwise. A valid weight
0174                         ; reading resets the idle count. Data received is stored in
0175                         ; T_WEIGHT and MSB in A.
0176                         ;--------------------------------------------------------------
0177                         GETDATA
0178 02ff bd 03 89                   JSR     RD_XB           ; read 4 hex characters into X
0179 0302 ff 06 a5                   STX     T_WEIGHT        ; store X
0180 0305 0c                         CLC
0181 0306 b6 06 a5                   LDAA    T_WEIGHT        ; get fist byte (stones)
0182 0309 27 04                      BEQ     GDDONE          ; idle message
0183 030b 7f 00 5a                   CLR     IDLE_SECS       ; not an idle message so reset the idle counter
0184 030e 0d                         SEC                     ; non idle message return with carry set
0185 030f 39                 GDDONE  RTS
0186                         
0187                         ;--------------------------------------------------------------
0188                         ; DECIMAL CONVERSION EXAMPLE
0189                         ;--------------------------------------------------------------
0190                                 ;JSR     PR_DEC          ; puts 3 decimal digits in DEC, DEC+1 and DEC+2
0191                                 ;LDAA    DEC+1           ; don't care about the hundreds        ADDA    #$30
0192                                 ;JSR     PR_WORD
0193                                 ;JSR     PR_SPCB
0194                                 ;LDAA    DEC+2
0195                                 ;JSR     PR_WORD
0196                         
0197                         ; -----------------------------------------------------
0198                         ; PR_DEC: Puts 3 decimal digits in DEC, DEC+1 and DEC+2
0199                         ;
0200                         ;       !! ONLY WORKS WITH VALUES BELOW 128 !!
0201                         ; -----------------------------------------------------
0202 0310 5f                 PR_DEC  CLRB            ; Clear B for hundreds
0203                         
0204 0311 81 64              HUND    CMPA    #100    ; 100 or more?
0205                         
0206 0313 2d 05                      BLT     TENS
0207 0315 80 64                      SUBA    #100    ; Sub 100
0208 0317 5c                         INCB            ; Increment hundred counter
0209 0318 20 f7                      BRA     HUND
0210                         
0211 031a f7 06 9f           TENS    STAB    DEC     ; store the hundreds
0212                         
0213 031d 5f                         CLRB
0214 031e 81 0a              TENS1   CMPA    #10     ; 10 or more?
0215 0320 2d 05                      BLT     UNITS
0216 0322 80 0a                      SUBA    #10     ; Sub 10
0217 0324 5c                         INCB            ; Increment ten counter
0218 0325 20 f7                      BRA     TENS1
0219                         
0220 0327 f7 06 a0           UNITS   STAB    DEC+1
0221 032a b7 06 a1                   STAA    DEC+2   ; Final remainder is units
0222                         
0223 032d 39                         RTS
0224                         
0225                         
0226                         ; -----------------------------------------------------
0227                         ; Print string FOLLOWING JSR ( terminated by $FF ) to
0228                         ; ACIA(b) and ACIA(b)
0229                         ; -----------------------------------------------------
0230 032e 30                 STRINGB TSX             ; Get loc. of return addr to X
0231 032f ee 00                      LDX     0,X     ; Get return addr to X
0232 0331 09                         DEX             ; Point to byte before
0233 0332 08                 AGAIN   INX             ; Point to next byte
0234 0333 a6 00                      LDAA    0,X     ; Get byte to be printed
0235 0335 81 ff                      CMPA    #$FF    ; End-string ?
0236 0337 27 07                      BEQ     ENDSTR  ; Yes: Go to finish up
0237 0339 bd fc 0f                   JSR     PR_A    ; Print the byte to ACIA(a) (A is maintained)
0238 033c 8d 40                      BSR     PR_B    ; Print the byte to ACIA(b)
0239 033e 20 f2                      BRA     AGAIN   ; Go back for next byte
0240 0340 31                 ENDSTR  INS             ; Clean up stack...
0241 0341 31                         INS             ;  ( pop off the return addr )
0242 0342 6e 01                      JMP     1,X     ; Jump back to caller (RETURN)
0243                         
0244                         ; -----------------------------------------------------
0245                         ; Prints a string pointed to by X
0246                         ; -----------------------------------------------------
0247 0344 a6 00              STRINGBX    LDAA    0,X         ; get char
0248 0346 81 ff                          CMPA    #$FF        ; is character NULL?
0249 0348 27 08                          BEQ     DONEB       ; yes, end of string
0250 034a bd fc 0f                       JSR     PR_A        ; Print the byte to ACIA(a) (A is maintained)
0251 034d 8d 2f                          BSR     PR_B        ; Print the byte to ACIA(b)
0252 034f 08                             INX
0253 0350 20 f2                          BRA     STRINGBX
0254 0352 39                 DONEB       RTS
0255                         
0256                         ; -----------------------------------------------------
0257                         ; Reads a character from ACIA(b) into A
0258                         ; -----------------------------------------------------
0259 0353 7c 06 a2           RD_B    INC     RND         ; simple way to get a random number
0260 0356 b6 f4 03                   LDAA    CTRLB       ; Get ACIA.A status byte
0261 0359 85 01                      BITA    #01         ; Is byte ready in DATAb
0262 035b 27 f6                      BEQ     RD_B        ; No: Try again
0263 035d b6 f4 02                   LDAA    DATAB       ; Get the data byte to A
0264 0360 84 7f                      ANDA    #$7F        ; Mask off parity bit if it exists
0265 0362 39                         RTS                 ; RETURN
0266                         
0267                         ; -----------------------------------------------------
0268                         ;
0269                         ; -----------------------------------------------------
0270 0363 8d ee              ZINB    BSR     RD_B    ; Read a character
0271 0365 bd fc 1d                   JSR     VHEX    ; Is it a hex character ?
0272 0368 25 12                      BCS     Z_PRQM  ; No: go to print `?`
0273 036a b7 06 96                   STAA    T_Q     ; Yes: Save Acc.A
0274 036d 8d e4                      BSR     RD_B    ; Read 2nd character
0275 036f bd fc 1d                   JSR     VHEX    ; Is it a hex character ?
0276 0372 25 08                      BCS     Z_PRQM  ; No: go to print `?`
0277 0374 16                         TAB             ; Yes: Put it into Acc.B
0278 0375 b6 06 96                   LDAA    T_Q     ; Retrieve 1st hex char to Acc.A
0279 0378 bd fc 31                   JSR     BINARY  ; Convert A:B to binary
0280 037b 39                         RTS             ; RETURN
0281                         Z_PRQM  ;LDAA    #'?     ; Load `?` into A
0282                                 ;BSR     PR_B    ; Print it
0283 037c 20 e5                      BRA     ZINB    ; Go back to start of hex input
0284                         
0285                         ; -----------------------------------------------------
0286                         ; Print character in A to ACIA(b)
0287                         ; -----------------------------------------------------
0288 037e f6 f4 03           PR_B    LDAB    CTRLB   ; Get ACIA(a) status byte
0289 0381 c5 02                      BITB    #02     ; Is it busy ?
0290 0383 27 f9                      BEQ     PR_B    ; Yes: Try again
0291 0385 b7 f4 02                   STAA    DATAB   ;  No: Send data
0292 0388 39                 PRB_END RTS             ; RETURN
0293                         
0294                         ; -----------------------------------------------------
0295                         ; Read 4 hex digits and put value into X
0296                         ; -----------------------------------------------------
0297 0389 8d d8              RD_XB   BSR     ZINB    ; Read 2 digit hex value into A
0298 038b b7 06 97                   STAA    T_Z     ; Save byte (most significant)
0299 038e 8d d3                      BSR     ZINB    ; Read 2 digit hex value into A
0300 0390 b7 06 98                   STAA    T_Z+1   ; Save byte (least significant)
0301 0393 fe 06 97                   LDX     T_Z     ; Load full 4 hex value into X
0302 0396 39                         RTS             ; RETURN
0303                         
0304                         ; -----------------------------------------------------
0305                         ; Prints the message " n stones n pounds"
0306                         ; place stones in MSB of X and pound in LSB
0307                         ; -----------------------------------------------------
0308                         PR_WEIGHT
0309 0397 ff 06 9d                   STX     T_W
0310 039a b6 06 9d                   LDAA    T_W             ; Load high byte of X into Accumulator A
0311 039d bd 04 06                   JSR     PR_WORD         ; n
0312 03a0 bd 03 bd                   JSR     PR_SPCB
0313 03a3 86 1b                      LDAA    #$1B
0314 03a5 bd 04 06                   JSR     PR_WORD         ; "stones"
0315 03a8 bd 03 bd                   JSR     PR_SPCB
0316 03ab b6 06 9e                   LDAA    T_W+1            ; Load high byte of X into Accumulator A
0317 03ae bd 04 06                   JSR     PR_WORD         ; n
0318 03b1 86 1c                      LDAA    #$1C
0319 03b3 bd 03 bd                   JSR     PR_SPCB
0320 03b6 bd 04 06                   JSR     PR_WORD         ; "pounds"
0321 03b9 bd 03 c8                   JSR     PR_CRB
0322 03bc 39                         RTS
0323                         
0324                         ; -----------------------------------------------------
0325                         ; Prints a space on both consoles (preserves A)
0326                         ; -----------------------------------------------------
0327 03bd 36                 PR_SPCB   PSHA
0328 03be 86 20                      LDAA    #$20        ; Put space character in A
0329 03c0 bd fc 0f                   JSR     PR_A
0330 03c3 bd 03 7e                   JSR     PR_B        ; Print it
0331 03c6 32                         PULA
0332 03c7 39                         RTS                 ; RETURN
0333                         
0334                         ; -----------------------------------------------------
0335                         ; Prints a CRLF on both consoles (preserves A)
0336                         ; -----------------------------------------------------
0337 03c8 36                 PR_CRB  PSHA
0338 03c9 86 0d                      LDAA    #$0D        ; Put CHAR character in A
0339 03cb bd fc 0f                   JSR     PR_A
0340 03ce bd 03 7e                   JSR     PR_B        ; Print it
0341 03d1 86 0a                      LDAA    #$0A
0342 03d3 bd fc 0f                   JSR     PR_A
0343 03d6 bd 03 7e                   JSR     PR_B        ; Print it
0344 03d9 32                         PULA
0345 03da 39                         RTS                 ; RETURN
0346                         
