1899 0ddc df 2c                          STX         STORE4      ; Save energy amount
1900 0dde de 6a                          LDX         PVASE1      ; Fetch pointer to alien ship no. 1 energy
1901 0de0 df 24                          STX         PNTR3       ; Save pointer for ASPH routine
1902 0de2 de 60                          LDX         PSLAS1      ; Pointer to alien ship no. 1 position 
1903 0de4 bd 0d fb                       JSR         ASPH        ; Fire phasor at alien ship no. 1
1904 0de7 de 6c                          LDX         PVASE2      ; Fetch pointer to alien ship no. 2 energy 
1905 0de9 df 24                          STX         PNTR3       ; Save pointer for ASPH routine 
1906 0deb de 62                          LDX         PSLAS2      ; Pointer to alien ship no. 2 position 
1907 0ded bd 0d fb                       JSR         ASPH        ; Fire phasor at alien ship no. 2 
1908 0df0 de 6e                          LDX         PVASE3      ; Fetch pointer to alien ship no. 3 energy 
1909 0df2 df 24                          STX         PNTR3       ; Save pointer for ASPH routine 
1910 0df4 de 64                          LDX         PSLAS3      ; Pointer to alien ship no. 3 position 
