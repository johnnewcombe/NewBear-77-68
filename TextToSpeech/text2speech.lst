                            221 ;END:     JMP     MAINLOOP  ;START   ; all done
                            222 
                            223 ;--------------------------------------------------------------
                            224 ; Gets the weight data from the scales and rerurns with carry
                            225 ; set if a valid reading, carry clear otherwise. A valid weight
                            226 ; reading resets the idle count. Data received is stored in
                            227 ; T_WEIGHT and MSB in A.
                            228 ;--------------------------------------------------------------
   02A1                     229 GETDATA:
   02A1 BD 03 2B      [ 9]  230         JSR     RD_XB           ; read 4 hex characters into X
   02A4 FF 19 B8      [ 6]  231         STX     T_WEIGHT        ; store X
   02A7 0C            [ 2]  232         CLC
   02A8 B6 19 B8      [ 4]  233         LDAA    T_WEIGHT        ; get fist byte (stones)
   02AB 27 04         [ 4]  234         BEQ     GDDONE          ; idle message
   02AD 7F 00 0A      [ 6]  235         CLR     IDLE_SECS       ; not an idle message so reset the idle counter
   02B0 0D            [ 2]  236         SEC                     ; non idle message return with carry set
   02B1 39            [ 5]  237 GDDONE:  RTS
                            238 
                            239 ;--------------------------------------------------------------
                            240 ; DECIMAL CONVERSION EXAMPLE
                            241 ;--------------------------------------------------------------
                            242         ;JSR     PR_DEC          ; puts 3 decimal digits in DEC, DEC+1 and DEC+2
                            243         ;LDAA    DEC+1           ; don't care about the hundreds        ADDA    #0x30
                            244         ;JSR     PR_WORD
                            245         ;JSR     PR_SPCB
                            246         ;LDAA    DEC+2
                            247         ;JSR     PR_WORD
                            248 
                            249 ; -----------------------------------------------------
                            250 ; PR_DEC: Puts 3 decimal digits in DEC, DEC+1 and DEC+2
                            251 ;
                            252 ;       !! ONLY WORKS WITH VALUES BELOW 128 !!
                            253 ; -----------------------------------------------------
   02B2 5F            [ 2]  254 PR_DEC:  CLRB            ; Clear B for hundreds
                            255 
   02B3 81 64         [ 2]  256 HUND:    CMPA    #100    ; 100 or more?
                            257 
   02B5 2D 05         [ 4]  258         BLT     TENS
