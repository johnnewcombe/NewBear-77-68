0711                         ; -----------------------------------------------------
0712 fff8                            ORG     $FFF8   ; 6800 interrupt vectors
0713                         
0714 fff8 f0 e0                      FDB     JIRQ    ; IRQ
0715 fffa ef 8c                      FDB     SWI     ; SWI
0716 fffc f0 dd                      FDB     JNMI    ; NMI
0717 fffe ef 81                      FDB     RESET   ; Reset
