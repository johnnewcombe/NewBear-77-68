0547 ff36 bd fc 00           BRPTSET JSR     RD_CMD  ; Read a byte (test for `.`)
0548 ff39 81 31                      CMPA    #'1     ; Is it `1` ?
0549 ff3b 26 12                      BNE     Is2b    ; No: go test for `2`
0550 ff3d bd fc 65                   JSR     RD_X    ; Read addr value into X
0551 ff40 a6 00                      LDAA    0,X     ; Get the opcode
0552 ff42 b7 f0 fb                   STAA    T_BYTE  ; Save it
0553 ff45 ff f0 f7                   STX     T_ABYT  ; and the address
0554 ff48 86 3f              SAME    LDAA    #$3F    ; `SWI` opcode :
0555 ff4a a7 00                      STAA    0,X     ;   set the breakpoint
0556 ff4c 7e ff 8c           ENDB    JMP     START   ; Return to MINIMON
0557 ff4f 81 32              Is2b    CMPA    #'2     ; Is it `2` ?
0558 ff51 26 f9                      BNE     ENDB   ; No: Return to MINIMON
0559 ff53 bd fc 65                   JSR     RD_X    ; Read address into X
0560 ff56 a6 00                      LDAA    0,X     ; Get opcode
0561 ff58 b7 f0 fc                   STAA    T_BYTE+1 ; Save it
0562 ff5b ff f0 f9                   STX     T_ABYT+2 ; Save address
0563 ff5e 20 e8                      BRA     SAME    ; Set the breakpoint
