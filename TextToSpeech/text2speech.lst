                            138 ; we cycle thought idle message when no one is on the scales, data comes in a one
                            139 ; second intervals so we simply increase the idle count until it's time to display
                            140 ; the next idle message
                            141 
   020C 7F 1A 12      [ 6]  142 IDLE:   CLR     PROCESSING_FLG  ; clear the processing flag as no one
                            143                                 ;   is standing on the scales
   020F 7C 1A 0B      [ 6]  144         INC     IDLE_COUNT      ; increase the idle count
   0212 B6 1A 0B      [ 4]  145         LDAA    IDLE_COUNT      ; see if idle count = max idle time
   0215 81 0A         [ 2]  146         CMPA    #IDLE_SECS      ; a data message appears every second
   0217 27 03         [ 4]  147         BEQ     IDLE1           ; not reached the max idle time
   0219 7E 01 6B      [ 3]  148         JMP     MAINLOOP             ; nothing to do yet
