1438 0b03 bd 05 29                       JSR         BINDEC      ; Convert to decimal 
1439 0b06 ce 02 03                       LDX         #Msg10a+1   ; Set pointer to torpedo message 
1440 0b09 c6 02                          LDAB        #$02        ; Counter to number of digits 
1441 0b0b bd 06 62                       JSR         DIGPRT      ; Put number of torpedoes in message 
1442 0b0e ce 01 f7                       LDX         #MSG10      ; 
1443 0b11 bd 0a ae                       JSR         SRSCN1      ; Print torpedo message 
1444                         
1445 0b14 c6 07                          LDAB        #$07        ; Set row number seven 
1446 0b16 bd 06 76                       JSR         ROWSET      ; Set up row for printout 
1447 0b19 de 68                          LDX         PDVSE       ; Set pointer to shield energy 
1448 0b1b c6 02                          LDAB        #$02        ; And set precision for 
1449 0b1d bd 05 29                       JSR         BINDEC      ;  binary to decimal conversion
1450 0b20 ce 02 13                       LDX         #Msg11a+3   ; Set pointer to shield energy message (was $0213)
1451 0b23 c6 04                          LDAB        #$04        ; Set digit count 
1452 0b25 bd 06 62                       JSR         DIGPRT      ; Put digits in memory 
1453 0b28 ce 02 05                       LDX         #MSG11      ; Set pointer to shield message 
1454 0b2b bd 05 06                       JSR         MSG         ; Print shield message 
1455                         
1456 0b2e c6 08                          LDAB        #$08        ; Set row number eight 
1457 0b30 bd 06 76                       JSR         ROWSET      ; Set up row for printout 
1458 0b33 ce 01 70                       LDX         #MSG03      ; Set pointer to final row 
1459 0b36 bd 05 06                       JSR         MSG         ; Print final row 
