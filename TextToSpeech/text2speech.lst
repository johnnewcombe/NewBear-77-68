                     F400     8 DATAA           .equ    0xF400          ; ACIA(a) Data register
                     F401     9 CTRLA           .equ    0xF401          ; ACIA(a) Ctrl/Status
                     F402    10 DATAB           .equ    0xF402          ; ACIA(b) Data register
                     F403    11 CTRLB           .equ    0xF403          ; ACIA(b) Ctrl/Status
