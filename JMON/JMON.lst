0666 ff6c 20 41 20                   FCC     " A "       ;
0667 ff6f 20 20 58                   FCC     "  X"       ;
0668 ff72 20 20 20                   FCC     "   "       ;
0669 ff75 20 50 43                   FCC     " PC"       ;
0670 ff78 20 20 20                   FCC     "   "       ;
0671 ff7b 53 50                      FCC     "SP"        ;
