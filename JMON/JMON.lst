0649                         ; FF81
0650                         ; -----------------------------------------------------
0651 ff81 8e f0 d0           RESET   LDS     #STACK  ; Set up stack for MINIMON
0652 ff84 86 03                      LDAA    #$03    ; Reset:
0653 ff86 b7 f4 01                   STAA    CTRLA   ;   ACIA.A
0654 ff89 b7 f4 03                   STAA    CTRLB   ;   ACIA.B
0655                         
