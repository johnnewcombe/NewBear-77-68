0498 fec2 bd fc 65           GO      JSR     RD_X    ; Get address to X (16.bit)
0499 fec5 bd fc 00                   JSR     RD_CMD  ; Right address ?
0500 fec8 b6 f0 f4                   LDAA    T_Z+1   ; T_Z.low to A
0501 fecb f6 f0 f3                   LDAB    T_Z     ; T_Z.high to B
0502 fece fe f0 fd           GOTO    LDX     PSTACK  ; Callers stack address to X
0503 fed1 a7 07                      STAA    7,X     ; Put new return
0504 fed3 e7 06                      STAB    6,X     ; address on stack
0505 fed5 be f0 fd                   LDS     PSTACK  ; Set up calling programs stack
0506 fed8 3b                         RTI             ; RETURN-FROM-INTERRUPT (SWI)
0507                         
0508                         ;FED9
0509 fed9 bd fc 00           CONTNU  JSR     RD_CMD  ; Read a byte (test for `.`)
0510 fedc 81 31                      CMPA    #'1     ; Is it `1` ?
0511 fede 26 10                      BNE     IsIt2  ; No: go test for `2`
0512 fee0 fe f0 f7                   LDX     T_ABYT  ; Get address of break.point
0513 fee3 b6 f0 fb                   LDAA    T_BYTE  ; Get saved opcode
0514 fee6 a7 00                      STAA    0,X     ; Put it back in the program
0515 fee8 b6 f0 f8                   LDAA    T_ABYT+1 ; Get address at which
0516 feeb f6 f0 f7                   LDAB    T_ABYT  ;   to re-enter program
0517 feee 20 de                      BRA     GOTO    ; Go to calling program
0518                         
0519 fef0 81 32              IsIt2   CMPA    #'2     ; Is it `2`
0520 fef2 27 03                      BEQ     G_Is2   ; Yes: go process it
0521 fef4 7e ff 8f                   JMP     START   ; No: Return to MINIMON
0522 fef7 fe f0 f9           G_Is2   LDX     T_ABYT+2 ; Get addr. of break.point 2
0523 fefa b6 f0 fc                   LDAA    T_BYTE+1 ; Get old opcode
0524 fefd a7 00                      STAA    0,X      ; Put it back
0525 feff b6 f0 fa                   LDAA    T_ABYT+3 ; Load address to start
0526 ff02 f6 f0 f9                   LDAB    T_ABYT+2 ;  running program at
0527 ff05 20 c7                      BRA     GOTO    ; Run user program
