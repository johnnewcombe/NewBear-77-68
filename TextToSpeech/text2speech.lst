0201                         ;--------------------------------------------------------------
0202                         ; Gets the weight data from the scales and rerurns with carry
0203                         ; set if a valid reading, carry clear otherwise. A valid weight
0204                         ; reading resets the idle count. Data received is stored in
0205                         ; T_WEIGHT and MSB in A.
0206                         ;--------------------------------------------------------------
0207                         GETDATA
0208 0342 bd 03 cc                   JSR     RD_XB           ; read 4 hex characters into X
0209 0345 ff 19 6d                   STX     T_WEIGHT        ; store X
0210 0348 0c                         CLC
0211 0349 b6 19 6d                   LDAA    T_WEIGHT        ; get fist byte (stones)
0212 034c 27 04                      BEQ     GDDONE          ; idle message
0213 034e 7f 00 02                   CLR     IDLE_SECS       ; not an idle message so reset the idle counter
0214 0351 0d                         SEC                     ; non idle message return with carry set
0215 0352 39                 GDDONE  RTS
0216                         
0217                         ;--------------------------------------------------------------
0218                         ; DECIMAL CONVERSION EXAMPLE
0219                         ;--------------------------------------------------------------
0220                                 ;JSR     PR_DEC          ; puts 3 decimal digits in DEC, DEC+1 and DEC+2
0221                                 ;LDAA    DEC+1           ; don't care about the hundreds        ADDA    #$30
0222                                 ;JSR     PR_WORD
0223                                 ;JSR     PR_SPCB
0224                                 ;LDAA    DEC+2
0225                                 ;JSR     PR_WORD
0226                         
0227                         ; -----------------------------------------------------
0228                         ; PR_DEC: Puts 3 decimal digits in DEC, DEC+1 and DEC+2
0229                         ;
0230                         ;       !! ONLY WORKS WITH VALUES BELOW 128 !!
0231                         ; -----------------------------------------------------
0232 0353 5f                 PR_DEC  CLRB            ; Clear B for hundreds
0233                         
0234 0354 81 64              HUND    CMPA    #100    ; 100 or more?
0235                         
0236 0356 2d 05                      BLT     TENS
0237 0358 80 64                      SUBA    #100    ; Sub 100
0238 035a 5c                         INCB            ; Increment hundred counter
0239 035b 20 f7                      BRA     HUND
0240                         
0241 035d f7 19 67           TENS    STAB    DEC     ; store the hundreds
0242                         
0243 0360 5f                         CLRB
0244 0361 81 0a              TENS1   CMPA    #10     ; 10 or more?
0245 0363 2d 05                      BLT     UNITS
0246 0365 80 0a                      SUBA    #10     ; Sub 10
0247 0367 5c                         INCB            ; Increment ten counter
0248 0368 20 f7                      BRA     TENS1
0249                         
0250 036a f7 19 68           UNITS   STAB    DEC+1
0251 036d b7 19 69                   STAA    DEC+2   ; Final remainder is units
0252                         
0253 0370 39                         RTS
0254                         
