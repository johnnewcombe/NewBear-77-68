0502 ef36 bd ec 00           BRPTSET JSR     RD_CMD  ; Read a byte (test for `.`)
0503 ef39 81 31                      CMPA    #'1     ; Is it `1` ?
0504 ef3b 26 12                      BNE     Is2b    ; No: go test for `2`
0505 ef3d bd ec 65                   JSR     RD_X    ; Read addr value into X
0506 ef40 a6 00                      LDAA    0,X     ; Get the opcode
0507 ef42 b7 f0 fb                   STAA    T_BYTE  ; Save it
0508 ef45 ff f0 f7                   STX     T_ABYT  ; and the address
0509 ef48 86 3f              SAME    LDAA    #$3F    ; `SWI` opcode :
0510 ef4a a7 00                      STAA    0,X     ;   set the breakpoint
0511 ef4c 7e ef 8c           ENDB    JMP     START   ; Return to MINIMON
0512 ef4f 81 32              Is2b    CMPA    #'2     ; Is it `2` ?
0513 ef51 26 f9                      BNE     ENDB   ; No: Return to MINIMON
0514 ef53 bd ec 65                   JSR     RD_X    ; Read address into X
0515 ef56 a6 00                      LDAA    0,X     ; Get opcode
0516 ef58 b7 f0 fc                   STAA    T_BYTE+1 ; Save it
0517 ef5b ff f0 f9                   STX     T_ABYT+2 ; Save address
0518 ef5e 20 e8                      BRA     SAME    ; Set the breakpoint
0519                         
