0608                         ; Print value in A as 2 hex digits, Preserve B
0609                         ; X unchanged by called routines
0610                         
0611 fdf2 37                 PR_HEX2     PSHB                ; Save B to STACK
0612 fdf3 36                             PSHA                ; Save A to STACK
0613 fdf4 8d 5e                          BSR     BIN2HEX     ; Convert A to ASCII in A & B
0614 fdf6 37                             PSHB                ; Save B (2nd byte) to STACK
0615 fdf7 bd fc e3                       JSR     PR_BYTE     ; Print byte in A
0616 fdfa 32                             PULA                ; Get 2nd byte into A from STACK
0617 fdfb bd fc e3                       JSR     PR_BYTE     ; Print byte in A
0618 fdfe 32                             PULA                ; Recover A from STACK
0619 fdff 33                             PULB                ; Recover B from STACK
0620 fe00 39                             RTS                 ; RETURN
