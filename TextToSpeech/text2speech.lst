0198                         ;--------------------------------------------------------------
0199                         ; Gets the weight data from the scales and rerurns with carry
0200                         ; set if a valid reading, carry clear otherwise. A valid weight
0201                         ; reading resets the idle count. Data received is stored in
0202                         ; T_WEIGHT and MSB in A.
0203                         ;--------------------------------------------------------------
0204                         GETDATA
0205 0339 bd 03 c3                   JSR     RD_XB           ; read 4 hex characters into X
0206 033c ff 04 e5                   STX     T_WEIGHT        ; store X
0207 033f 0c                         CLC
0208 0340 b6 04 e5                   LDAA    T_WEIGHT        ; get fist byte (stones)
0209 0343 27 04                      BEQ     GDDONE          ; idle message
0210 0345 7f 00 5a                   CLR     IDLE_SECS       ; not an idle message so reset the idle counter
0211 0348 0d                         SEC                     ; non idle message return with carry set
0212 0349 39                 GDDONE  RTS
0213                         
0214                         ;--------------------------------------------------------------
0215                         ; DECIMAL CONVERSION EXAMPLE
0216                         ;--------------------------------------------------------------
0217                                 ;JSR     PR_DEC          ; puts 3 decimal digits in DEC, DEC+1 and DEC+2
0218                                 ;LDAA    DEC+1           ; don't care about the hundreds        ADDA    #$30
0219                                 ;JSR     PR_WORD
0220                                 ;JSR     PR_SPCB
0221                                 ;LDAA    DEC+2
0222                                 ;JSR     PR_WORD
0223                         
0224                         ; -----------------------------------------------------
0225                         ; PR_DEC: Puts 3 decimal digits in DEC, DEC+1 and DEC+2
0226                         ;
0227                         ;       !! ONLY WORKS WITH VALUES BELOW 128 !!
0228                         ; -----------------------------------------------------
0229 034a 5f                 PR_DEC  CLRB            ; Clear B for hundreds
0230                         
0231 034b 81 64              HUND    CMPA    #100    ; 100 or more?
0232                         
0233 034d 2d 05                      BLT     TENS
0234 034f 80 64                      SUBA    #100    ; Sub 100
0235 0351 5c                         INCB            ; Increment hundred counter
0236 0352 20 f7                      BRA     HUND
0237                         
0238 0354 f7 04 df           TENS    STAB    DEC     ; store the hundreds
0239                         
0240 0357 5f                         CLRB
0241 0358 81 0a              TENS1   CMPA    #10     ; 10 or more?
0242 035a 2d 05                      BLT     UNITS
0243 035c 80 0a                      SUBA    #10     ; Sub 10
0244 035e 5c                         INCB            ; Increment ten counter
0245 035f 20 f7                      BRA     TENS1
0246                         
0247 0361 f7 04 e0           UNITS   STAB    DEC+1
0248 0364 b7 04 e1                   STAA    DEC+2   ; Final remainder is units
0249                         
0250 0367 39                         RTS
0251                         
0252                         
0253                         ; -----------------------------------------------------
0254                         ; Print string FOLLOWING JSR ( terminated by $FF ) to
0255                         ; ACIA(b) and ACIA(b)
0256                         ; -----------------------------------------------------
0257 0368 30                 STRINGB TSX             ; Get loc. of return addr to X
0258 0369 ee 00                      LDX     0,X     ; Get return addr to X
0259 036b 09                         DEX             ; Point to byte before
0260 036c 08                 AGAIN   INX             ; Point to next byte
0261 036d a6 00                      LDAA    0,X     ; Get byte to be printed
0262 036f 81 ff                      CMPA    #$FF    ; End-string ?
0263 0371 27 07                      BEQ     ENDSTR  ; Yes: Go to finish up
0264 0373 bd fc 0f                   JSR     PR_A    ; Print the byte to ACIA(a) (A is maintained)
0265 0376 8d 40                      BSR     PR_B    ; Print the byte to ACIA(b)
0266 0378 20 f2                      BRA     AGAIN   ; Go back for next byte
0267 037a 31                 ENDSTR  INS             ; Clean up stack...
0268 037b 31                         INS             ;  ( pop off the return addr )
0269 037c 6e 01                      JMP     1,X     ; Jump back to caller (RETURN)
0270                         
0271                         ; -----------------------------------------------------
0272                         ; Prints a string pointed to by X
0273                         ; -----------------------------------------------------
0274 037e a6 00              STRINGBX    LDAA    0,X         ; get char
0275 0380 81 ff                          CMPA    #$FF        ; is character NULL?
0276 0382 27 08                          BEQ     DONEB       ; yes, end of string
0277 0384 bd fc 0f                       JSR     PR_A        ; Print the byte to ACIA(a) (A is maintained)
0278 0387 8d 2f                          BSR     PR_B        ; Print the byte to ACIA(b)
0279 0389 08                             INX
0280 038a 20 f2                          BRA     STRINGBX
0281 038c 39                 DONEB       RTS
0282                         
0283                         ; -----------------------------------------------------
0284                         ; Reads a character from ACIA(b) into A
0285                         ; -----------------------------------------------------
0286 038d 7c 04 e2           RD_B    INC     RND         ; simple way to get a random number
0287 0390 b6 f4 03                   LDAA    CTRLB       ; Get ACIA.A status byte
0288 0393 85 01                      BITA    #01         ; Is byte ready in DATAb
0289 0395 27 f6                      BEQ     RD_B        ; No: Try again
0290 0397 b6 f4 02                   LDAA    DATAB       ; Get the data byte to A
0291 039a 84 7f                      ANDA    #$7F        ; Mask off parity bit if it exists
0292 039c 39                         RTS                 ; RETURN
0293                         
0294                         ; -----------------------------------------------------
0295                         ;
0296                         ; -----------------------------------------------------
0297 039d 8d ee              ZINB    BSR     RD_B    ; Read a character
0298 039f bd fc 1d                   JSR     VHEX    ; Is it a hex character ?
0299 03a2 25 12                      BCS     Z_PRQM  ; No: go to print `?`
0300 03a4 b7 04 d6                   STAA    T_Q     ; Yes: Save Acc.A
0301 03a7 8d e4                      BSR     RD_B    ; Read 2nd character
0302 03a9 bd fc 1d                   JSR     VHEX    ; Is it a hex character ?
0303 03ac 25 08                      BCS     Z_PRQM  ; No: go to print `?`
0304 03ae 16                         TAB             ; Yes: Put it into Acc.B
0305 03af b6 04 d6                   LDAA    T_Q     ; Retrieve 1st hex char to Acc.A
0306 03b2 bd fc 31                   JSR     BINARY  ; Convert A:B to binary
0307 03b5 39                         RTS             ; RETURN
0308                         Z_PRQM  ;LDAA    #'?     ; Load `?` into A
0309                                 ;BSR     PR_B    ; Print it
0310 03b6 20 e5                      BRA     ZINB    ; Go back to start of hex input
0311                         
0312                         ; -----------------------------------------------------
0313                         ; Print character in A to ACIA(b)
0314                         ; -----------------------------------------------------
0315 03b8 f6 f4 03           PR_B    LDAB    CTRLB   ; Get ACIA(a) status byte
0316 03bb c5 02                      BITB    #02     ; Is it busy ?
0317 03bd 27 f9                      BEQ     PR_B    ; Yes: Try again
0318 03bf b7 f4 02                   STAA    DATAB   ;  No: Send data
0319 03c2 39                 PRB_END RTS             ; RETURN
0320                         
0321                         ; -----------------------------------------------------
0322                         ; Read 4 hex digits and put value into X
0323                         ; -----------------------------------------------------
0324 03c3 8d d8              RD_XB   BSR     ZINB    ; Read 2 digit hex value into A
0325 03c5 b7 04 d7                   STAA    T_Z     ; Save byte (most significant)
0326 03c8 8d d3                      BSR     ZINB    ; Read 2 digit hex value into A
0327 03ca b7 04 d8                   STAA    T_Z+1   ; Save byte (least significant)
0328 03cd fe 04 d7                   LDX     T_Z     ; Load full 4 hex value into X
0329 03d0 39                         RTS             ; RETURN
0330                         
0331                         ; -----------------------------------------------------
0332                         ; Prints the message " n stones n pounds"
0333                         ; place stones in MSB of X and pound in LSB
0334                         ; -----------------------------------------------------
0335                         PR_WEIGHT
0336 03d1 ff 04 dd                   STX     T_W
0337 03d4 b6 04 dd                   LDAA    T_W             ; Load high byte of X into Accumulator A
0338 03d7 bd 04 40                   JSR     PR_WORD         ; n
0339 03da bd 03 f7                   JSR     PR_SPCB
0340 03dd 86 1b                      LDAA    #$1B
0341 03df bd 04 40                   JSR     PR_WORD         ; "stones"
0342 03e2 bd 03 f7                   JSR     PR_SPCB
0343 03e5 b6 04 de                   LDAA    T_W+1            ; Load high byte of X into Accumulator A
0344 03e8 bd 04 40                   JSR     PR_WORD         ; n
0345 03eb 86 1c                      LDAA    #$1C
0346 03ed bd 03 f7                   JSR     PR_SPCB
0347 03f0 bd 04 40                   JSR     PR_WORD         ; "pounds"
0348 03f3 bd 04 02                   JSR     PR_CRB
0349 03f6 39                         RTS
0350                         
0351                         ; -----------------------------------------------------
0352                         ; Prints a space on both consoles (preserves A)
0353                         ; -----------------------------------------------------
0354 03f7 36                 PR_SPCB   PSHA
0355 03f8 86 20                      LDAA    #$20        ; Put space character in A
0356 03fa bd fc 0f                   JSR     PR_A
0357 03fd bd 03 b8                   JSR     PR_B        ; Print it
0358 0400 32                         PULA
0359 0401 39                         RTS                 ; RETURN
0360                         
0361                         ; -----------------------------------------------------
0362                         ; Prints a CRLF on both consoles (preserves A)
0363                         ; -----------------------------------------------------
0364 0402 36                 PR_CRB  PSHA
0365 0403 86 0d                      LDAA    #$0D        ; Put CHAR character in A
0366 0405 bd fc 0f                   JSR     PR_A
0367 0408 bd 03 b8                   JSR     PR_B        ; Print it
0368 040b 86 0a                      LDAA    #$0A
0369 040d bd fc 0f                   JSR     PR_A
0370 0410 bd 03 b8                   JSR     PR_B        ; Print it
0371 0413 32                         PULA
0372 0414 39                         RTS                 ; RETURN
