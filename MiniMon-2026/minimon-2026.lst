0564 ff07 bd fc 89           DUMP    JSR     GETADD  ; Prompt for boundary addresses
0565 ff0a fe f0 ef                   LDX     T_STRT  ;
0566 ff0d bd fe 97           D_NEW   JSR     NEWLINE ; Print c/r l/f nul
0567 ff10 86 08                      LDAA    #$08    ;
0568 ff12 b7 f0 f6                   STAA    T_Q     ; T_Q = 8
0569 ff15 09                         DEX             ; X = X - 1
0570 ff16 08                 D_NXT   INX             ; X = X + 1
0571 ff17 bd fd 4d                   JSR     PRSP    ; Print a space
0572 ff1a a6 00                      LDAA    0,X     ; Get a byte
0573 ff1c bd fc c9                   JSR     ZOUT    ; Print it as 2.hex digits
0574 ff1f bc f0 f1                   CPX     T_STOP  ; Finished ?
0575 ff22 26 06                      BNE     D_CNT   ; No: Carry on
0576 ff24 b6 f4 00           D_END   LDAA    DATAA   ; Get a byte from ACIA (clear)
0577 ff27 7e ff 8f                   JMP     START   ; Return to MINIMON
0578 ff2a b6 f4 01           D_CNT   LDAA    CTRLA   ; Read ACIA status
0579 ff2d 85 01                      BITA    #$01    ; Stop dump ?
0580 ff2f 26 f3                      BNE     D_END   ; Yes; go clear ACIA etc
0581 ff31 7a f0 f6                   DEC     T_Q     ; New line needed ?
0582 ff34 26 e0                      BNE     D_NXT   ; No: Loop back
0583 ff36 08                         INX             ; Print next byte
