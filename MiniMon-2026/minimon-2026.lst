0531 fec2 bd fc 65           GO      JSR     RD_X    ; Get address to X (16.bit)
0532 fec5 bd fc 00                   JSR     RD_CMD  ; Right address ?
0533 fec8 b6 f0 f4                   LDAA    T_Z+1   ; T_Z.low to A
0534 fecb f6 f0 f3                   LDAB    T_Z     ; T_Z.high to B
0535 fece fe f0 fd           GOTO    LDX     PSTACK  ; Callers stack address to X
0536 fed1 a7 07                      STAA    7,X     ; Put new return
0537 fed3 e7 06                      STAB    6,X     ; address on stack
0538 fed5 be f0 fd                   LDS     PSTACK  ; Set up calling programs stack
0539 fed8 3b                         RTI             ; RETURN-FROM-INTERRUPT (SWI)
0540                         
0541                         ;FED9
0542 fed9 bd fc 00           CONTNU  JSR     RD_CMD  ; Read a byte (test for `.`)
0543 fedc 81 31                      CMPA    #'1     ; Is it `1` ?
0544 fede 26 10                      BNE     IsIt2  ; No: go test for `2`
0545 fee0 fe f0 f7                   LDX     T_ABYT  ; Get address of break.point
0546 fee3 b6 f0 fb                   LDAA    T_BYTE  ; Get saved opcode
0547 fee6 a7 00                      STAA    0,X     ; Put it back in the program
0548 fee8 b6 f0 f8                   LDAA    T_ABYT+1 ; Get address at which
0549 feeb f6 f0 f7                   LDAB    T_ABYT  ;   to re-enter program
0550 feee 20 de                      BRA     GOTO    ; Go to calling program
0551                         
0552 fef0 81 32              IsIt2   CMPA    #'2     ; Is it `2`
0553 fef2 27 03                      BEQ     G_Is2   ; Yes: go process it
0554 fef4 7e ff 8f                   JMP     START   ; No: Return to MINIMON
0555 fef7 fe f0 f9           G_Is2   LDX     T_ABYT+2 ; Get addr. of break.point 2
0556 fefa b6 f0 fc                   LDAA    T_BYTE+1 ; Get old opcode
0557 fefd a7 00                      STAA    0,X      ; Put it back
0558 feff b6 f0 fa                   LDAA    T_ABYT+3 ; Load address to start
0559 ff02 f6 f0 f9                   LDAB    T_ABYT+2 ;  running program at
0560 ff05 20 c7                      BRA     GOTO    ; Run user program
