0602                         ; -----------------------------------------------------
0603                         ; S format data load : Modded version of Mikbug code
0604                         ;
0605 efe3                    CMD_L       EQU     *           ; L = Load = Input an S19 file
0606 efe3 bd ec 76                       JSR     STRING
0607 efe6 20 2b 20                       FCC     " + "
0608 efe9 0d 0a                          FCB     $0D,$0A     ; c/r l/f
0609 efeb ff                             FCB     $FF         ; End-Of-String
0610 efec bd ec 00           .sRead      JSR     RD_CMD ; Read+Echo, test for '.'
0611 efef 81 53                          CMPA    #'S         ; Is it `S` ?
0612 eff1 26 f9                          BNE     .sRead      ; No: Keep waiting for `S`
0613 eff3 bd ec 00                       JSR     RD_CMD      ; Read+Echo, test for '.'
0614 eff6 81 39                          CMPA    #'9         ; Is it `9` ?  ( `S9` record )
0615 eff8 27 27                          BEQ     .sDone      ; Yes: End-data, Back to START
0616 effa 81 31                          CMPA    #'1         ; Is it `1` ?  ( `S1` record )
0617 effc 26 ee                          BNE     .sRead      ; No: Wait for next `S`
0618 effe 7f f0 e0                       CLR     b_Csum      ; Clear checksum
0619 f001 bd ec d8                       JSR     ZIN         ; Read 2xHex = data.byte count to A
0620 f004 80 02                          SUBA    #2          ; Subtract 2 (to get bytes left in line)
0621 f006 b7 f0 e1                       STAA    b_Count     ; Store byte count
0622 f009 bd ec 63                       JSR     RD_X        ; Read 4xHex digit address to X
0623 f00c bd ec d8           .sDoByt     JSR     ZIN         ; Read 2xHex digits, value to A
0624 f00f 7a f0 e1                       DEC     b_Count     ; Decrement our byte count
0625 f012 27 05                          BEQ     .sChk       ; If end-of-line, go look at checksum
0626 f014 a7 00                          STAA    0,X         ; Save byte where X points
0627 f016 08                             INX                 ; Point X at next byte
0628 f017 20 f3                          BRA     .sDoByt     ; Go get next byte
0629 f019 7c f0 e0           .sChk       INC     b_Csum      ; Add 1 to checksum
0630 f01c 27 ce                          BEQ     .sRead      ; OK: Go read next record
0631 f01e bd ec ff                       JSR     PR_QM       ; Print "?"
0632 f021                    .sDone      EQU     *
0633 f021 7e ef 8f           STARTS      JMP     START       ; Go to START
0634                         
0635                         ; -----------------------------------------------------
0636                         ; S format data output : Modded version of Mikbug code
0637                         ;
0638 f024                    CMD_P       EQU     *           ; P = Punch : Output an S19 file
0639 f024 bd ec 89                       JSR     GETADD      ; Prompt for "Start:","Stop:"
0640 f027 fe f0 ef                       LDX     T_STRT     ; Get start address
0641 f02a ff f0 de                       STX     d_TW        ; save it to work area
0642 f02d b6 f0 f2           .fOut1      LDAA    T_STOP+1    ; get low order of end address
0643 f030 b0 f0 df                       SUBA    d_TW+1      ; Subtract low order start
0644 f033 f6 f0 f1                       LDAB    T_STOP      ; ( carry not affected by LDA )
0645 f036 f2 f0 de                       SBCB    d_TW        ; Subtract with Carry
0646 f039 26 04                          BNE     .fOut2
0647 f03b 81 10                          CMPA    #16
0648 f03d 25 02                          BCS     .fOut3
0649 f03f 86 0f              .fOut2      LDAA    #15
0650 f041 8b 04              .fOut3      ADDA    #4
0651 f043 b7 f0 e1                       STAA    b_Count     ; FRAME COUNT THIS RECORD
0652 f046 80 03                          SUBA    #3
0653 f048 b7 f0 e2                       STAA    b_Temp      ; BYTE COUNT THIS RECORD
0654 f04b bd ec 76                       JSR     STRING      ; Output this string...
0655 f04e 0d 0a                          FCB     $0D,$0A       ; c/r l/f
0656 f050 53 31                          FCB     'S,'1       ; S1
0657 f052 ff                             FCB     $FF         ; End-Of-String
0658 f053 5f                             CLRB                ; Clear checksum
0659                         
0660                         ; Output frame count...
0661 f054 ce f0 e1                       LDX     #b_Count    ; X = Address of Framecount
0662 f057 8d 25                          BSR     .fOutHx2    ; O/P byte <-X and inc X
0663                         
0664                         ; Output address...
0665 f059 ce f0 de                       LDX     #d_TW
0666 f05c 8d 20                          BSR     .fOutHx2    ; O/P byte <-X and inc X
0667 f05e 8d 1e                          BSR     .fOutHx2    ; O/P byte <-X and inc X
0668                         
0669                         ; Output data...
0670 f060 fe f0 de                       LDX     d_TW
0671 f063 8d 19              .fOut4      BSR     .fOutHx2    ; O/P byte <-X and inc X
0672 f065 7a f0 e2                       DEC     b_Temp      ; Decrement `bytes left` count
0673 f068 26 f9                          BNE     .fOut4      ; Loop back if any left
0674 f06a ff f0 de                       STX     d_TW
0675 f06d 53                             COMB
0676 f06e 37                             PSHB
0677 f06f 30                             TSX                 ; X = S + 1
0678 f070 8d 0c                          BSR     .fOutHx2    ; PUNCH CHECKSUM
0679 f072 33                             PULB
0680 f073 fe f0 de                       LDX     d_TW
0681 f076 09                             DEX
0682 f077 bc f0 f1                       CPX     T_STOP
0683 f07a 26 b1                          BNE     .fOut1
0684                         
0685                         ;x          JSR     PR_STRING   ; Output `S9` record...
0686                         ;x          FCB     C_CR,C_LF   ; c/r l/f
0687                         ;x          FCB     'S,'9       ; S9 = <eof>
0688                         ;x          FCB     C_EOS       ; End-Of-String
0689                         
0690 f07c 8d a3                          BSR     STARTS      ;Go to START (via `S` code)
0691                         
0692                         ;- - - - - - - - - - - - - - - - - - - - - - - - -
0693                         ; 1) Update checksum
0694                         ; 2) Output byte pointed to by X as 2 x hex chars
0695                         ; 3) Increment X
0696                         ;
0697 f07e eb 00              .fOutHx2    ADDB    0,X         ; Update checksum
0698 f080 36                             PSHA                ; Push A to STACK
0699 f081 a6 00                          LDAA    0,X         ; Load byte to be o/p
0700 f083 bd ec c9                       JSR     ZOUT        ; O/P byte <- X
0701 f086 32                             PULA                ; Pull A off STACK
0702 f087 08                             INX                 ; Increment X
0703 f088 39                             RTS                 ; RETURN
0704                         
