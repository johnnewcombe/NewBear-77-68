   04D2 FE 00 03      [ 5]  547             LDX     T_X             ; X now has address of the word
   04D5 BD 03 B4      [ 9]  548             JSR     STRINGBX        ; output the word
   04D8 7C 00 19      [ 6]  549             INC     WORDS
   04DB BD FD 4D      [ 9]  550             JSR     PRSP
   04DE 39            [ 5]  551             RTS
