   1A09                     549 T_WEIGHT:        .rmb     2       ; holds value of weight following a call to GETDATA
   1A0B                     550 IDLE_COUNT:      .rmb     1       ; counts the number of empty measurement reports
   1A0C                     551 IDLE_MSG_ID:     .rmb     1       ; holds value of next idle message to use
   1A0D                     552 GREET_MSG_ID:    .rmb     1       ; holds value of next greeting message to use
   1A0E                     553 LIGHT_MSG_ID:    .rmb     1       ; holds value of next light weight message to use
   1A0F                     554 NORMAL_MSG_ID:   .rmb     1       ; holds value of next normal weight message to use
   1A10                     555 HEAVY_MSG_ID:    .rmb     1       ; holds value of next heavy weight message to use
   1A11                     556 SHEAVY_MSG_ID:   .rmb     1       ; holds value of next super heavy weight message to use
   1A12                     557 PROCESSING_FLG:  .rmb     1       ; non-zero indicates that that a weight is being processed
