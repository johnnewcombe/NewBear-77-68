0422                         ; -----------------------------------------------------
0423                         ; Outputs a word based on value in A
0424                         ; -----------------------------------------------------
0425                         ; The routine loops through all of the word pointers derementing X as it goes
0426                         ; When X = 0, then the pointer to the word has been found.
0427 0440 ce 04 5c           PR_WORD     LDX     #WORDPTR        ; base of pointer table
0428 0443 4d                 PR_WORD1    TSTA                    ; is A zero?
0429 0444 27 05                          BEQ     FOUNDW          ; yes, use current entry
0430 0446 08                             INX                     ; advance to next 2-byte entry
0431 0447 08                             INX
0432 0448 4a                             DECA                    ; decrement index
0433 0449 20 f8                          BRA     PR_WORD1        ; loop
0434 044b a6 00              FOUNDW      LDAA    0,X             ; load high byte of pointer
0435 044d b7 19 41                       STAA    T_X
0436 0450 a6 01                          LDAA    1,X             ; load low byte of pointer
0437 0452 b7 19 42                       STAA    T_X+1
0438 0455 fe 19 41                       LDX     T_X             ; load X with the word pointer
0439 0458 bd 03 7e                       JSR     STRINGBX        ; output the word
0440 045b 39                             RTS
0441                         
