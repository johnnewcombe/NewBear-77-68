0731 ffcd 43                         FCB     'C
0732 ffce fe d9                      FDB     CONTNU
0733 ffd0 44                         FCB     'D
0734 ffd1 ff 07                      FDB     DUMP
0735 ffd3 54                         FCB     'T'
0736 ffd4 fd 62                      FDB     MEMTEST
0737 ffd6 56                         FCB     'V'
0738 ffd7 fd c4                      FDB     VERSION
0739 ffd9 4e                         FCB     'N'
0740 ffda ff 81                      FDB     RESET
