0040                         ; initialise serial port B
0041 0200 86 11              TX2SP   LDAA    #$11    ; 8 Data, No Parity, 2 Stop Bits
0042 0202 b7 f4 03                   STAA    CTRLB   ;   ACIA.A
0043                         
