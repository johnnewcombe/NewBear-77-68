                            246 ;END:     JMP     MAINLOOP  ;START   ; all done
                            247 
                            248 ;--------------------------------------------------------------
                            249 ; Gets the weight data from the scales and rerurns with carry
                            250 ; set if a valid reading, carry clear otherwise. A valid weight
                            251 ; reading resets the idle count. Data received is stored in
                            252 ; T_WEIGHT and MSB in A.
                            253 ;--------------------------------------------------------------
   02B7                     254 GETDATA:
   02B7 BD 03 4F      [ 9]  255         JSR     RD_XB           ; read 4 hex characters into X
   02BA FF 1A 18      [ 6]  256         STX     T_WEIGHT        ; store X
   02BD 0C            [ 2]  257         CLC
   02BE B6 1A 18      [ 4]  258         LDAA    T_WEIGHT        ; get fist byte (stones)
   02C1 27 04         [ 4]  259         BEQ     GDDONE          ; idle message
ASxxxx Assembler V05.50.5  (Motorola 6800/6802/6808)                    Page 6
Hexadecimal [16-Bits]                                 Thu May  7 22:06:22 2026



   02C3 7F 00 2D      [ 6]  260         CLR     IDLE_TICS       ; not an idle message so reset the idle counter
   02C6 0D            [ 2]  261         SEC                     ; non idle message return with carry set
   02C7 39            [ 5]  262 GDDONE:  RTS
                            263 
                            264 ; -----------------------------------------------------
                            265 ; PR_DEC: Puts 3 decimal digits in DEC, DEC+1 and DEC+2
                            266 ;
                            267 ;       !! ONLY WORKS WITH VALUES BELOW 128 !!
                            268 ; -----------------------------------------------------
   02C8 5F            [ 2]  269 PR_DEC:  CLRB            ; Clear B for hundreds
                            270 
   02C9 81 64         [ 2]  271 HUND:    CMPA    #100    ; 100 or more?
                            272 
   02CB 2D 05         [ 4]  273         BLT     TENS
   02CD 80 64         [ 2]  274         SUBA    #100    ; Sub 100
   02CF 5C            [ 2]  275         INCB            ; Increment hundred counter
   02D0 20 F7         [ 4]  276         BRA     HUND
                            277 
   02D2 F7 1A 12      [ 5]  278 TENS:    STAB    DEC     ; store the hundreds
                            279 
   02D5 5F            [ 2]  280         CLRB
   02D6 81 0A         [ 2]  281 TENS1:   CMPA    #10     ; 10 or more?
   02D8 2D 05         [ 4]  282         BLT     UNITS
   02DA 80 0A         [ 2]  283         SUBA    #10     ; Sub 10
   02DC 5C            [ 2]  284         INCB            ; Increment ten counter
   02DD 20 F7         [ 4]  285         BRA     TENS1
                            286 
   02DF F7 1A 13      [ 5]  287 UNITS:   STAB    DEC+1
   02E2 B7 1A 14      [ 5]  288         STAA    DEC+2   ; Final remainder is units
                            289 
   02E5 39            [ 5]  290         RTS
                            291 
                            292 
                            293 ; -----------------------------------------------------
                            294 ; Print string FOLLOWING JSR ( terminated by 0xFF ) to
                            295 ; ACIA(b) and ACIA(b)
                            296 ; -----------------------------------------------------
   02E6 30            [ 4]  297 STRINGB: TSX             ; Get loc. of return addr to X
   02E7 EE 00         [ 6]  298          LDX     0,X     ; Get return addr to X
   02E9 09            [ 4]  299          DEX             ; Point to byte before
   02EA 08            [ 4]  300 STRB1:   INX             ; Point to next byte
   02EB A6 00         [ 5]  301          LDAA    0,X     ; Get byte to be printed
   02ED 81 FF         [ 2]  302          CMPA    #0xFF    ; End-string ?
   02EF 27 0E         [ 4]  303          BEQ     ENDSTR  ; Yes: Go to finish up
   02F1 F6 F0 FF      [ 4]  304          LDAB    PANEL
   02F4 C5 01         [ 2]  305          BITB     #1
   02F6 27 03         [ 4]  306          BEQ     STRB    ; panel switch 0 is debug and copies data to A
   02F8 BD FC 0F      [ 9]  307          JSR     PR_A    ; Print the byte to ACIA(a) (A is maintained)
                            308                          ;  DEBUG depending on panel data switch zero
   02FB 8D 47         [ 8]  309 STRB:    BSR     PR_B    ; Print the byte to ACIA(b)
   02FD 20 EB         [ 4]  310          BRA     STRB1   ; Go back for next byte
   02FF 31            [ 4]  311 ENDSTR:  INS             ; Clean up stack...
   0300 31            [ 4]  312          INS             ;  ( pop off the return addr )
   0301 6E 01         [ 4]  313          JMP     1,X     ; Jump back to caller (RETURN)
                            314 
