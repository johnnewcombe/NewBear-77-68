0612 ff81 8e f0 d0           RESET   LDS     #STACK  ; Set up stack for MINIMON
0613 ff84 86 03                      LDAA    #$03    ; Reset:
0614 ff86 b7 f4 01                   STAA    CTRLA   ;   ACIA.A
0615 ff89 b7 f4 03                   STAA    CTRLB   ;   ACIA.B
0616                         
