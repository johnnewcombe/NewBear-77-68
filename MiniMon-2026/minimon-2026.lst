0726                         ; -----------------------------------------------------
0727                         ; Print value in A as 2 hex digits, Preserve B
0728                         ; X unchanged by called routines
0729                         
0730 f0f8 37                 PR_HEX2     PSHB                ; Save B to STACK
0731 f0f9 36                             PSHA                ; Save A to STACK
0732 f0fa bd ec 9e                       JSR     ASCII       ; Convert A to ASCII in A & B
0733 f0fd 37                             PSHB                ; Save B (2nd byte) to STACK
0734 f0fe 8d cf                          BSR     PR_BYTE     ; Print byte in A
0735 f100 32                             PULA                ; Get 2nd byte into A from STACK
0736 f101 8d cc                          BSR     PR_BYTE     ; Print byte in A
0737 f103 32                             PULA                ; Recover A from STACK
0738 f104 33                             PULB                ; Recover B from STACK
0739 f105 39                             RTS                 ; RETURN
0740                         
0741 f106 bd ec 76           PR_SP       JSR     STRING      ; Print...
0742 f109 20                             FCB     $20         ;  SPACE
0743 f10a ff                             FCB     $FF         ; End-Of-String
0744 f10b 39                             RTS                 ; RETURN
