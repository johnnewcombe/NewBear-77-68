0646 ff8f 8e f0 d0           START   LDS     #STACK  ; Set up stack for MINMON
0647                                ;LDAA    #$11    ; Set up: 8N2
0648 ff92 86 09                      LDAA    #$09    ; Set up: 7E1
0649 ff94 b7 f4 01                   STAA    CTRLA   ;   ACIA.A
