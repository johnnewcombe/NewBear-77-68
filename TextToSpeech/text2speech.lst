ASxxxx Assembler V05.50.5  (Motorola 6800/6802/6808)                   Page 59
Hexadecimal [16-Bits]                                 Fri May  8 20:16:17 2026



                            497 
                            498 ; -----------------------------------------------
                            499 ; LED Pattern Display - MC6800
                            500 ; -----------------------------------------------
   1AD7                     501 PANEL_DISP:
                            502 
                            503 ; --- Main loop ---
   1AD7 CE 1A FB      [ 3]  504 PSTART: LDX     #PTABLE     ; Point X at start of table
   1ADA A6 00         [ 5]  505 NXTVAL: LDAA    ,X          ; Load pattern value from table
   1ADC B7 F0 FF      [ 5]  506         STAA    PANEL       ; Send to LED port
                            507         ;JSR     ZOUT        ; X not affected
   1ADF 8D 0D         [ 8]  508         BSR     DELAY       ; Delay so we can see it
   1AE1 08            [ 4]  509         INX                 ; Advance to next entry
   1AE2 8C 1B 05      [ 3]  510         CPX     #PTEND      ; Reached end of table?
   1AE5 26 F3         [ 4]  511         BNE     NXTVAL      ; No - go again
   1AE7 7A 1B 22      [ 6]  512         DEC     SYLLABLES   ; decrement the syllables to mimic
                            513                             ;  this doesn't affect carry
   1AEA 27 0E         [ 4]  514         BEQ     PDONE       ; head to nearest RTS
   1AEC 20 E9         [ 4]  515         BRA     PSTART      ; Yes - loop back to beginning
                            516 
                            517 ; --- Delay routine ---
                            518 ; Kills time so the eye can see each LED pattern
   1AEE FF 1B 10      [ 6]  519 DELAY:  STX     T_TMP
   1AF1 CE 03 FF      [ 3]  520         LDX     #DELAY_VAL  ; Load delay count
   1AF4 09            [ 4]  521 DLOOP:  DEX                 ; Decrement
   1AF5 26 FD         [ 4]  522         BNE     DLOOP       ; Not zero - keep counting
   1AF7 FE 1B 10      [ 5]  523         LDX     T_TMP
   1AFA 39            [ 5]  524 PDONE:  RTS                 ; Done
                            525 
                            526 ; --- Pattern table ---
   1AFB FF                  527 PTABLE: .FCB     0xFF         ; 1111 1111
   1AFC E7                  528         .FCB     0xE7         ; 1110 0111
   1AFD C3                  529         .FCB     0xC3         ; 1100 0011
   1AFE 81                  530         .FCB     0x81         ; 1000 0001
   1AFF 00                  531         .FCB     0x00         ; 0000 0000
   1B00 81                  532         .FCB     0x81         ; 1000 0001
   1B01 C3                  533         .FCB     0xC3         ; 1100 0011
   1B02 E7                  534         .FCB     0xE7         ; 1110 0111
   1B03 FF                  535         .FCB     0xFF         ; 1111 1111
   1B04 00                  536         .fcb     0X00         ; 0000 0000
   1B05                     537 PTEND:                        ; Address just past end of table
                            538 
                            539 ; -----------------------------------------------------
                            540 ; Reserved memory
                            541 ; -----------------------------------------------------
                            542 
   1B05                     543 T_Q:             .rmb     1       ; Temp storage for ZIN
   1B06                     544 T_Z:             .rmb     2       ;   "     "     "  RDX
   1B08                     545 T_X:             .rmb     2       ;   "     "     "  PR_WORD
   1B0A                     546 T_Y:             .rmb     2       ;   "     "     "  table pointer
   1B0C                     547 T_P:             .rmb     2       ;   "     "     "  PR_PHRASE
   1B0E                     548 T_W:             .rmb     2       ;   "     "     "  PR_WEIGHT
   1B10                     549 T_TMP:           .rmb     2       ;   "     "     "  within subroutine
   1B12                     550 DEC:             .rmb     3       ; for decimal value
   1B15                     551 RND:             .rmb     1       ; holds a random number (see RD_B
ASxxxx Assembler V05.50.5  (Motorola 6800/6802/6808)                   Page 60
Hexadecimal [16-Bits]                                 Fri May  8 20:16:17 2026



   1B16                     552 TEMP:            .rmb     2       ; temp var (non subroutine use)
   1B18                     553 T_WEIGHT:        .rmb     2       ; holds value of weight following a call to GETDATA
   1B1A                     554 IDLE_COUNT:      .rmb     1       ; counts the number of empty measurement reports
   1B1B                     555 IDLE_MSG_ID:     .rmb     1       ; holds value of next idle message to use
   1B1C                     556 GREET_MSG_ID:    .rmb     1       ; holds value of next greeting message to use
   1B1D                     557 LIGHT_MSG_ID:    .rmb     1       ; holds value of next light weight message to use
   1B1E                     558 NORMAL_MSG_ID:   .rmb     1       ; holds value of next normal weight message to use
   1B1F                     559 HEAVY_MSG_ID:    .rmb     1       ; holds value of next heavy weight message to use
   1B20                     560 SHEAVY_MSG_ID:   .rmb     1       ; holds value of next super heavy weight message to use
   1B21                     561 PROCESSING_FLG:  .rmb     1       ; non-zero indicates that that a weight is being processed
                            562                                   ;   all following weight data is ignored until the next
                            563                                   ;   idle (0000h) data resets it.
   1B22                     564 SYLLABLES:       .rmb     1       ; number of phrase syllables for the panel LED routines
                            565                                   ;  this is updated each time a word is transmitted and
                            566                                   ;  when PANELDISP is called, usually after acall to PR_PHRASE
                            567                                   ;  the lights are manipulated.
