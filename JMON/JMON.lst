0721 ffdd bd fc 76           STERMS  JSR     STRING
0722 ffe0 0d 0a                      FCB     $0D,$0A
0723 ffe2 53 39 30 33 30 30          FCC     "S9030000FC"
     30 30 46 43
0724 ffec ff                         FCB     $FF
0725 ffed 20 a0                      BRA     START
