0652 ff9e ff                         FCB     $FF     ; End-of-string
0653 ff9f bd fc 00                   JSR     RD_CMD  ; Read a byte (test for `.`)
0654 ffa2 ce ff b8                   LDX     #CMDTAB     ; point to command table
0655 ffa5 e6 00              .CMDLP  LDAB    0,X         ; B = key byte (0 ends table)
0656 ffa7 27 e6                      BEQ     START       ; end of table → default to START
0657 ffa9 11                         CBA                 ; compare A vs B
0658 ffaa 27 05                      BEQ     .FOUND      ; match → dispatch
0659 ffac 08                         INX                 ; skip key
0660 ffad 08                         INX                 ; skip FDB high
0661 ffae 08                         INX                 ; skip FDB low
0662 ffaf 20 f4                      BRA     .CMDLP      ; try next entry
0663                         
0664 ffb1 e6 01              .FOUND  LDAB    1,X        ; B = target high byte (FDB stores high,low)
0665 ffb3 a6 02                      LDAA    2,X        ; A = target low byte
0666 ffb5 36                         PSHA                ; push high first
0667 ffb6 37                         PSHB                ; push low — now low is on top of stack
0668                         ;        WAI
