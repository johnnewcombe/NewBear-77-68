                            185 ; get address of message in X from the pointer in X
   0239 A6 00         [ 5]  186         LDAA    0,X             ;  get high byte of word pointed to by X
   023B E6 01         [ 5]  187         LDAB    1,X             ;  get low byte of word pointed to by X
   023D B7 19 62      [ 5]  188         STAA    TEMP
   0240 F7 19 63      [ 5]  189         STAB    TEMP+1
   0243 FE 19 62      [ 5]  190         LDX     TEMP
