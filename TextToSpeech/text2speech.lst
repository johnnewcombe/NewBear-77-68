ASxxxx Assembler V05.50.5  (Motorola 6800/6802/6808)                   Page 58
Hexadecimal [16-Bits]                                 Thu May  7 21:56:15 2026



                            511 
                            512 ; -----------------------------------------------
                            513 ; LED Pattern Display - MC6800
                            514 ; -----------------------------------------------
   19E7                     515 PANEL_DISP:
                            516 
                            517 ; --- Main loop ---
   19E7 CE 1A 0B      [ 3]  518 PSTART: LDX     #PTABLE     ; Point X at start of table
   19EA A6 00         [ 5]  519 NXTVAL: LDAA    ,X          ; Load pattern value from table
   19EC B7 F0 FF      [ 5]  520         STAA    PANEL       ; Send to LED port
                            521         ;JSR     ZOUT        ; X not affected
   19EF 8D 0D         [ 8]  522         BSR     DELAY       ; Delay so we can see it
   19F1 08            [ 4]  523         INX                 ; Advance to next entry
   19F2 8C 1A 14      [ 3]  524         CPX     #PTEND      ; Reached end of table?
   19F5 26 F3         [ 4]  525         BNE     NXTVAL      ; No - go again
   19F7 7A 1A 25      [ 6]  526         DEC     SYLLABLES   ; decrement the syllables to mimic
   19FA 27 0E         [ 4]  527         BEQ     PDONE       ; nearest RTS
   19FC 20 E9         [ 4]  528         BRA     PSTART      ; Yes - loop back to beginning
                            529 
                            530 ; --- Delay routine ---
                            531 ; Kills time so the eye can see each LED pattern
   19FE FF 1A 1F      [ 6]  532 DELAY:  STX     T_TMP
   1A01 CE 00 FF      [ 3]  533         LDX     #DELAY_VAL  ; Load delay count
   1A04 09            [ 4]  534 DLOOP:  DEX                 ; Decrement
   1A05 26 FD         [ 4]  535         BNE     DLOOP       ; Not zero - keep counting
   1A07 FE 1A 1F      [ 5]  536         LDX     T_TMP
   1A0A 39            [ 5]  537 PDONE:  RTS                 ; Done
                            538 
                            539 ; --- Pattern table ---
   1A0B FF                  540 PTABLE: .FCB     0xFF         ; 1111 1111
   1A0C E7                  541         .FCB     0xE7         ; 1110 0111
   1A0D C3                  542         .FCB     0xC3         ; 1100 0011
   1A0E 81                  543         .FCB     0x81         ; 1000 0001
   1A0F 00                  544         .FCB     0x00         ; 0000 0000
   1A10 81                  545         .FCB     0x81         ; 1000 0001
   1A11 C3                  546         .FCB     0xC3         ; 1100 0011
   1A12 E7                  547         .FCB     0xE7         ; 1110 0111
   1A13 FF                  548         .FCB     0xFF         ; 1111 1111
   1A14                     549 PTEND:                        ; Address just past end of table
                            550 
                            551 
                            552 ; -----------------------------------------------------
                            553 ; Reserved memory
                            554 ; -----------------------------------------------------
                            555 
   1A14                     556 T_Q:             .rmb     1       ; Temp storage for ZIN
   1A15                     557 T_Z:             .rmb     2       ;   "     "     "  RDX
   1A17                     558 T_X:             .rmb     2       ;   "     "     "  PR_WORD
   1A19                     559 T_Y:             .rmb     2       ;   "     "     "  table pointer
   1A1B                     560 T_P:             .rmb     2       ;   "     "     "  PR_PHRASE
   1A1D                     561 T_W:             .rmb     2       ;   "     "     "  PR_WEIGHT
   1A1F                     562 T_TMP:           .rmb     2       ;   "     "     "  within subroutine
   1A21                     563 DEC:             .rmb     3       ; for decimal value
   1A24                     564 RND:             .rmb     1       ; holds a random number (see RD_B
   1A25                     565 SYLLABLES:       .rmb     1       ; number of phrase syllables for the panel LED routines
ASxxxx Assembler V05.50.5  (Motorola 6800/6802/6808)                   Page 59
