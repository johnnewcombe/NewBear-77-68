0286                         ; -----------------------------------------------------
0287                         ; Reads a character from ACIA(b) into A
0288                         ; -----------------------------------------------------
0289 0396 7c 19 6a           RD_B    INC     RND         ; simple way to get a random number
0290 0399 b6 f4 03                   LDAA    CTRLB       ; Get ACIA.A status byte
0291 039c 85 01                      BITA    #01         ; Is byte ready in DATAb
0292 039e 27 f6                      BEQ     RD_B        ; No: Try again
0293 03a0 b6 f4 02                   LDAA    DATAB       ; Get the data byte to A
0294 03a3 84 7f                      ANDA    #$7F        ; Mask off parity bit if it exists
0295 03a5 39                         RTS                 ; RETURN
0296                         
0297                         ; -----------------------------------------------------
0298                         ;
0299                         ; -----------------------------------------------------
0300 03a6 8d ee              ZINB    BSR     RD_B    ; Read a character
0301 03a8 bd fc 1d                   JSR     VHEX    ; Is it a hex character ?
0302 03ab 25 12                      BCS     Z_PRQM  ; No: go to print `?`
0303 03ad b7 19 5e                   STAA    T_Q     ; Yes: Save Acc.A
0304 03b0 8d e4                      BSR     RD_B    ; Read 2nd character
0305 03b2 bd fc 1d                   JSR     VHEX    ; Is it a hex character ?
0306 03b5 25 08                      BCS     Z_PRQM  ; No: go to print `?`
0307 03b7 16                         TAB             ; Yes: Put it into Acc.B
0308 03b8 b6 19 5e                   LDAA    T_Q     ; Retrieve 1st hex char to Acc.A
0309 03bb bd fc 31                   JSR     BINARY  ; Convert A:B to binary
0310 03be 39                         RTS             ; RETURN
0311                         Z_PRQM  ;LDAA    #'?     ; Load `?` into A
0312                                 ;BSR     PR_B    ; Print it
0313 03bf 20 e5                      BRA     ZINB    ; Go back to start of hex input
0314                         
0315                         ; -----------------------------------------------------
0316                         ; Print character in A to ACIA(b)
0317                         ; -----------------------------------------------------
0318 03c1 f6 f4 03           PR_B    LDAB    CTRLB   ; Get ACIA(a) status byte
0319 03c4 c5 02                      BITB    #02     ; Is it busy ?
0320 03c6 27 f9                      BEQ     PR_B    ; Yes: Try again
0321 03c8 b7 f4 02                   STAA    DATAB   ;  No: Send data
0322 03cb 39                 PRB_END RTS             ; RETURN
0323                         
