0205                         ;--------------------------------------------------------------
0206                         ; Gets the weight data from the scales and rerurns with carry
0207                         ; set if a valid reading, carry clear otherwise. A valid weight
0208                         ; reading resets the idle count. Data received is stored in
0209                         ; T_WEIGHT and MSB in A.
0210                         ;--------------------------------------------------------------
0211                         GETDATA
0212 024c bd 02 d6                   JSR     RD_XB           ; read 4 hex characters into X
0213 024f ff 19 51                   STX     T_WEIGHT        ; store X
0214 0252 0c                         CLC
0215 0253 b6 19 51                   LDAA    T_WEIGHT        ; get fist byte (stones)
0216 0256 27 04                      BEQ     GDDONE          ; idle message
0217 0258 7f 00 02                   CLR     IDLE_SECS       ; not an idle message so reset the idle counter
0218 025b 0d                         SEC                     ; non idle message return with carry set
0219 025c 39                 GDDONE  RTS
0220                         
0221                         ;--------------------------------------------------------------
0222                         ; DECIMAL CONVERSION EXAMPLE
0223                         ;--------------------------------------------------------------
0224                                 ;JSR     PR_DEC          ; puts 3 decimal digits in DEC, DEC+1 and DEC+2
0225                                 ;LDAA    DEC+1           ; don't care about the hundreds        ADDA    #$30
0226                                 ;JSR     PR_WORD
0227                                 ;JSR     PR_SPCB
0228                                 ;LDAA    DEC+2
0229                                 ;JSR     PR_WORD
0230                         
0231                         ; -----------------------------------------------------
0232                         ; PR_DEC: Puts 3 decimal digits in DEC, DEC+1 and DEC+2
0233                         ;
0234                         ;       !! ONLY WORKS WITH VALUES BELOW 128 !!
0235                         ; -----------------------------------------------------
0236 025d 5f                 PR_DEC  CLRB            ; Clear B for hundreds
0237                         
0238 025e 81 64              HUND    CMPA    #100    ; 100 or more?
0239                         
0240 0260 2d 05                      BLT     TENS
0241 0262 80 64                      SUBA    #100    ; Sub 100
0242 0264 5c                         INCB            ; Increment hundred counter
0243 0265 20 f7                      BRA     HUND
0244                         
0245 0267 f7 19 4b           TENS    STAB    DEC     ; store the hundreds
0246                         
0247 026a 5f                         CLRB
0248 026b 81 0a              TENS1   CMPA    #10     ; 10 or more?
0249 026d 2d 05                      BLT     UNITS
0250 026f 80 0a                      SUBA    #10     ; Sub 10
0251 0271 5c                         INCB            ; Increment ten counter
0252 0272 20 f7                      BRA     TENS1
0253                         
0254 0274 f7 19 4c           UNITS   STAB    DEC+1
0255 0277 b7 19 4d                   STAA    DEC+2   ; Final remainder is units
0256                         
0257 027a 39                         RTS
0258                         
0259                         
0260                         ; -----------------------------------------------------
0261                         ; Print string FOLLOWING JSR ( terminated by $FF ) to
0262                         ; ACIA(b) and ACIA(b)
0263                         ; -----------------------------------------------------
0264 027b 30                 STRINGB TSX             ; Get loc. of return addr to X
0265 027c ee 00                      LDX     0,X     ; Get return addr to X
0266 027e 09                         DEX             ; Point to byte before
0267 027f 08                 STRB1   INX             ; Point to next byte
0268 0280 a6 00                      LDAA    0,X     ; Get byte to be printed
0269 0282 81 ff                      CMPA    #$FF    ; End-string ?
0270 0284 27 07                      BEQ     ENDSTR  ; Yes: Go to finish up
0271 0286 bd fc 0f                   JSR     PR_A    ; Print the byte to ACIA(a) (A is maintained)
0272 0289 8d 40                      BSR     PR_B    ; Print the byte to ACIA(b)
0273 028b 20 f2                      BRA     STRB1   ; Go back for next byte
0274 028d 31                 ENDSTR  INS             ; Clean up stack...
0275 028e 31                         INS             ;  ( pop off the return addr )
0276 028f 6e 01                      JMP     1,X     ; Jump back to caller (RETURN)
0277                         
0278                         ; -----------------------------------------------------
0279                         ; Prints a string pointed to by X
0280                         ; -----------------------------------------------------
0281 0291 a6 00              STRINGBX    LDAA    0,X         ; get char
0282 0293 81 ff                          CMPA    #$FF        ; is character NULL?
0283 0295 27 08                          BEQ     DONEB       ; yes, end of string
0284 0297 bd fc 0f                       JSR     PR_A        ; Print the byte to ACIA(a) (A is maintained)
0285 029a 8d 2f                          BSR     PR_B        ; Print the byte to ACIA(b)
0286 029c 08                             INX
0287 029d 20 f2                          BRA     STRINGBX
0288 029f 39                 DONEB       RTS
0289                         
0290                         ; -----------------------------------------------------
0291                         ; Reads a character from ACIA(b) into A
0292                         ; -----------------------------------------------------
0293 02a0 7c 19 4e           RD_B    INC     RND         ; simple way to get a random number
0294 02a3 b6 f4 03                   LDAA    CTRLB       ; Get ACIA.A status byte
0295 02a6 85 01                      BITA    #01         ; Is byte ready in DATAb
0296 02a8 27 f6                      BEQ     RD_B        ; No: Try again
0297 02aa b6 f4 02                   LDAA    DATAB       ; Get the data byte to A
0298 02ad 84 7f                      ANDA    #$7F        ; Mask off parity bit if it exists
0299 02af 39                         RTS                 ; RETURN
0300                         
0301                         ; -----------------------------------------------------
0302                         ;
0303                         ; -----------------------------------------------------
0304 02b0 8d ee              ZINB    BSR     RD_B    ; Read a character
0305 02b2 bd fc 1d                   JSR     VHEX    ; Is it a hex character ?
0306 02b5 25 12                      BCS     Z_PRQM  ; No: go to print `?`
0307 02b7 b7 19 3e                   STAA    T_Q     ; Yes: Save Acc.A
0308 02ba 8d e4                      BSR     RD_B    ; Read 2nd character
0309 02bc bd fc 1d                   JSR     VHEX    ; Is it a hex character ?
0310 02bf 25 08                      BCS     Z_PRQM  ; No: go to print `?`
0311 02c1 16                         TAB             ; Yes: Put it into Acc.B
0312 02c2 b6 19 3e                   LDAA    T_Q     ; Retrieve 1st hex char to Acc.A
0313 02c5 bd fc 31                   JSR     BINARY  ; Convert A:B to binary
0314 02c8 39                         RTS             ; RETURN
0315                         Z_PRQM  ;LDAA    #'?     ; Load `?` into A
0316                                 ;BSR     PR_B    ; Print it
0317 02c9 20 e5                      BRA     ZINB    ; Go back to start of hex input
0318                         
0319                         ; -----------------------------------------------------
0320                         ; Print character in A to ACIA(b)
0321                         ; -----------------------------------------------------
0322 02cb f6 f4 03           PR_B    LDAB    CTRLB   ; Get ACIA(a) status byte
0323 02ce c5 02                      BITB    #02     ; Is it busy ?
0324 02d0 27 f9                      BEQ     PR_B    ; Yes: Try again
0325 02d2 b7 f4 02                   STAA    DATAB   ;  No: Send data
0326 02d5 39                 PRB_END RTS             ; RETURN
0327                         
0328                         ; -----------------------------------------------------
0329                         ; Read 4 hex digits and put value into X
0330                         ; -----------------------------------------------------
0331 02d6 8d d8              RD_XB   BSR     ZINB    ; Read 2 digit hex value into A
0332 02d8 b7 19 3f                   STAA    T_Z     ; Save byte (most significant)
0333 02db 8d d3                      BSR     ZINB    ; Read 2 digit hex value into A
0334 02dd b7 19 40                   STAA    T_Z+1   ; Save byte (least significant)
0335 02e0 fe 19 3f                   LDX     T_Z     ; Load full 4 hex value into X
0336 02e3 39                         RTS             ; RETURN
0337                         ; -----------------------------------------------------
0338                         ; Adds A to X and leaves the result in X, A is
0339                         ; preserved.
0340                         ; -----------------------------------------------------
0341 02e4 36                 ADX     PSHA
0342 02e5 ff 19 49                   STX     T_TMP
0343 02e8 bb 19 4a                   ADDA    T_TMP+1   ; add A to low byte
0344 02eb b7 19 4a                   STAA    T_TMP+1
0345 02ee b6 19 49                   LDAA    T_TMP     ; get high byte
0346 02f1 89 00                      ADCA    #0      ; add carry only
0347 02f3 b7 19 49                   STAA    T_TMP
0348 02f6 fe 19 49                   LDX     T_TMP
0349 02f9 32                         PULA
0350 02fa 39                         RTS
0351                         
0352                         ; -----------------------------------------------------
0353                         ; Prints the message " n stones n pounds"
0354                         ; place stones in MSB of X and pound in LSB
0355                         ; -----------------------------------------------------
0356                         PR_WEIGHT
0357 02fb ff 19 47                   STX     T_W
0358 02fe b6 19 47                   LDAA    T_W             ; Load high byte of X into Accumulator A
0359 0301 bd 03 61                   JSR     PR_WORD         ; n
0360 0304 bd 03 21                   JSR     PR_SPCB
0361 0307 86 1b                      LDAA    #$1B
0362 0309 bd 03 61                   JSR     PR_WORD         ; "stones"
0363 030c bd 03 21                   JSR     PR_SPCB
0364 030f b6 19 48                   LDAA    T_W+1            ; Load high byte of X into Accumulator A
0365 0312 bd 03 61                   JSR     PR_WORD         ; n
0366 0315 86 1c                      LDAA    #$1C
0367 0317 bd 03 21                   JSR     PR_SPCB
0368 031a bd 03 61                   JSR     PR_WORD         ; "pounds"
0369 031d bd 03 2c                   JSR     PR_CRB
0370 0320 39                         RTS
0371                         
0372                         ; -----------------------------------------------------
0373                         ; Prints a space on both consoles (preserves A)
0374                         ; -----------------------------------------------------
0375 0321 36                 PR_SPCB PSHA
0376 0322 86 20                      LDAA    #$20        ; Put space character in A
0377 0324 bd fc 0f                   JSR     PR_A
0378 0327 bd 02 cb                   JSR     PR_B        ; Print it
0379 032a 32                         PULA
0380 032b 39                         RTS                 ; RETURN
0381                         
