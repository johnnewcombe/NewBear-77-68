0221 02fb 36                 PR_NUMB     PSHA
0222 02fc 4c                             INCA
0223 02fd ce 03 19                       LDX     #TEXTBLOCKPTR  ; base of offset table
0224 0300 4a                 PR_NUMB1    DECA
0225 0301 27 04                          BEQ     FOUND
0226 0303 08                             INX                 ; move to next address
0227 0304 08                             INX
0228 0305 26 f9                          BNE     PR_NUMB1    ; loop around to retest
0229                         FOUND
0230 0307 a6 00                          LDAA    0,X
0231 0309 b7 10 04                       STAA    $1004
0232 030c a6 01                          LDAA    1,X
0233 030e b7 10 05                       STAA    $1005
0234 0311 fe 10 04                       LDX     $1004
0235 0314 bd 02 a1                       JSR     STRINGBX
0236 0317 32                             PULA
0237 0318 39                             RTS
