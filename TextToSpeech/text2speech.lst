0001                         ;------------------------------------------------------------------
0002                         ; text2speech.asm
0003                         ;------------------------------------------------------------------
0004                         
0005                         ; 7768 ACIA
0006 f400                    DATAA   EQU $F400 ; ACIA(a) Data register
0007 f401                    CTRLA   EQU $F401 ; ACIA(a) Ctrl/Status
0008 f402                    DATAB   EQU $F402 ; ACIA(b) Data register
0009 f403                    CTRLB   EQU $F403 ; ACIA(b) Ctrl/Status
0010                         
0011                         ; MINIMON routines
0012 fc76                    STRING  EQU $FC76 ; Prints a string. The string should follow JSR and be terminated with $FF.
0013 fc89                    GETADD  EQU $FC89 ; Get Address, read 4 digit hex value.
0014 fcc9                    ZOUT    EQU $FCC9 ; Print value in A as 2 hex digits.
0015 fe97                    NEWLINE EQU $FE97 ; Prints a new line.
0016 ff8f                    START   EQU $FF8F ; Restarts MniMon.
0017 fc0f                    PR_A    EQU $FC0F ; Print char in A to ACIA (a)
0018 fd2b                    RD_A    EQU $FD2B ; Read char from A
0019 fd4d                    PRSP    EQU $FD4D ; Print a space
0020 fc31                    BINARY  EQU $FC31 ; Converts ASCII hex digits in A and B to binary?
0021 fc65                    RD_X    EQU $FC65 ; Read 4 hex digits Value from ACIA(a) and put value into X.
0022 fc1d                    VHEX    EQU $FC1D ; Checks that A contains a HEX character
0023 0200                    	    ORG $0200
0024                         
0025                         ; initialise serial port B
0026 0200 86 11              TX2SP   LDAA    #$11    ; 8 Data, No Parity, 2 Stop Bits
0027 0202 b7 f4 03                   STAA    CTRLB   ;   ACIA.A
0028                         
0029                         
0030                         
0031                         
0032                         MAINLOOP:
0033                         ; -----------------------------------------------------
0034                         ; Data arrives at port B as four hex characters
0035                         ; -----------------------------------------------------
0036 0205 bd 02 ba                   JSR     RD_XB           ; read 4 hex characters into X
0037 0208 ff 04 1e                   STX     TEMP
0038 020b b6 04 1e                   LDAA    TEMP
0039 020e 81 14                      CMPA    #20
0040 0210 22 0c                      BHI     TOHEAVY
0041 0212 b6 04 1f                   LDAA    TEMP+1
0042 0215 81 0d                      CMPA    #13
0043 0217 22 05                      BHI     TOHEAVY
0044 0219 bd 02 c8                   JSR     PR_WEIGHT       ; stoones in MSB, pounds in LSB
0045 021c 20 00                      BRA     END
0046                         
0047                         ; -----------------------------------------------------
0048                         ; Over 20 stone so random heavy phrase to ports B
0049                         ; -----------------------------------------------------
0050                         TOHEAVY
0051                         
0052                         END
0053 021e ce 03 6e                   LDX     #TWENTYONE
0054 0221 bd 03 0c                   JSR     PR_PHRASE
0055 0224 7e 02 05                   JMP     MAINLOOP  ;START   ; all done
0056                         
0057                         ; -----------------------------------------------------
0058                         ; Random idle phrase to ports B
0059                         ; -----------------------------------------------------
0060 0227 bd 02 64           IDLE    JSR     STRINGB
0061 022a 53 68 61 6c 6c 20          FCC     "Shall I tell you a joke?"
     49 20 74 65 6c 6c
     20 79 6f 75 20 61
     20 6a 6f 6b 65 3f
0062 0242 0a 0d ff                   FCB     $0A, $0D, $FF
0063 0245 39                         RTS
0064                         
0065                         
0066                         ;--------------------------------------------------------------
0067                         ; DECIMAL CONVERSION EXAMPLE
0068                         ;--------------------------------------------------------------
0069                                 ;JSR     PR_DEC          ; puts 3 decimal digits in DEC, DEC+1 and DEC+2
0070                                 ;LDAA    DEC+1           ; don't care about the hundreds        ADDA    #$30
0071                                 ;JSR     PR_WORD
0072                                 ;JSR     PR_SPCB
0073                                 ;LDAA    DEC+2
0074                                 ;JSR     PR_WORD
0075                         
0076                         
0077                         
0078                         ; -----------------------------------------------------
0079                         ; PR_DEC: Puts 3 decimal digits in DEC, DEC+1 and DEC+2
0080                         ;
0081                         ;       !! ONLY WORKS WITH VALUES BELOW 128 !!
0082                         ; -----------------------------------------------------
0083 0246 5f                 PR_DEC  CLRB            ; Clear B for hundreds
0084                         
0085 0247 81 64              HUND    CMPA    #100    ; 100 or more?
0086                         
0087 0249 2d 05                      BLT     TENS
0088 024b 80 64                      SUBA    #100    ; Sub 100
0089 024d 5c                         INCB            ; Increment hundred counter
0090 024e 20 f7                      BRA     HUND
0091                         
0092 0250 f7 04 1b           TENS    STAB    DEC     ; store the hundreds
0093                         
0094 0253 5f                         CLRB
0095 0254 81 0a              TENS1   CMPA    #10     ; 10 or more?
0096 0256 2d 05                      BLT     UNITS
0097 0258 80 0a                      SUBA    #10     ; Sub 10
0098 025a 5c                         INCB            ; Increment ten counter
0099 025b 20 f7                      BRA     TENS1
0100                         
0101 025d f7 04 1c           UNITS   STAB    DEC+1
0102 0260 b7 04 1d                   STAA    DEC+2   ; Final remainder is units
0103                         
0104 0263 39                         RTS
0105                         
0106                         
0107                         ; -----------------------------------------------------
0108                         ; Print string FOLLOWING JSR ( terminated by $FF ) to
0109                         ; ACIA(b) and ACIA(b)
0110                         ; -----------------------------------------------------
0111 0264 30                 STRINGB TSX             ; Get loc. of return addr to X
0112 0265 ee 00                      LDX     0,X     ; Get return addr to X
0113 0267 09                         DEX             ; Point to byte before
0114 0268 08                 AGAIN   INX             ; Point to next byte
0115 0269 a6 00                      LDAA    0,X     ; Get byte to be printed
0116 026b 81 ff                      CMPA    #$FF    ; End-string ?
0117 026d 27 07                      BEQ     ENDSTR  ; Yes: Go to finish up
0118 026f bd fc 0f                   JSR     PR_A    ; Print the byte to ACIA(a) (A is maintained)
0119 0272 8d 3b                      BSR     PR_B    ; Print the byte to ACIA(b)
0120 0274 20 f2                      BRA     AGAIN   ; Go back for next byte
0121 0276 31                 ENDSTR  INS             ; Clean up stack...
0122 0277 31                         INS             ;  ( pop off the return addr )
0123 0278 6e 01                      JMP     1,X     ; Jump back to caller (RETURN)
0124                         
0125                         ; -----------------------------------------------------
0126                         ; Prints a string pointed to by X
0127                         ; -----------------------------------------------------
0128 027a a6 00              STRINGBX    LDAA    0,X         ; get char
0129 027c 81 ff                          CMPA    #$FF        ; is character NULL?
0130 027e 27 08                          BEQ     DONEB       ; yes, end of string
0131 0280 bd fc 0f                       JSR     PR_A        ; Print the byte to ACIA(a) (A is maintained)
0132 0283 8d 2a                          BSR     PR_B        ; Print the byte to ACIA(b)
0133 0285 08                             INX
0134 0286 20 f2                          BRA     STRINGBX
0135 0288 39                 DONEB       RTS
0136                         
0137                         ; -----------------------------------------------------
0138                         ; Reads a character from ACIA(b) into A
0139                         ; -----------------------------------------------------
0140 0289 b6 f4 03           RD_B    LDAA    CTRLB       ; Get ACIA.A status byte
0141 028c 85 01                      BITA    #01         ; Is byte ready in DATAb
0142 028e 27 f9                      BEQ     RD_B        ; No: Try again
0143 0290 b6 f4 02                   LDAA    DATAB       ; Get the data byte to A
0144                                 ;ANDA    #$7F        ; Mask off parity bit if it exists
0145 0293 39                         RTS                 ; RETURN
0146                         
0147                         ; -----------------------------------------------------
0148                         ;
0149                         ; -----------------------------------------------------
0150 0294 8d f3              ZINB    BSR     RD_B    ; Read a character
0151 0296 bd fc 1d                   JSR     VHEX    ; Is it a hex character ?
0152 0299 25 12                      BCS     Z_PRQM  ; No: go to print `?`
0153 029b b7 04 12                   STAA    T_Q     ; Yes: Save Acc.A
0154 029e 8d e9                      BSR     RD_B    ; Read 2nd character
0155 02a0 bd fc 1d                   JSR     VHEX    ; Is it a hex character ?
0156 02a3 25 08                      BCS     Z_PRQM  ; No: go to print `?`
0157 02a5 16                         TAB             ; Yes: Put it into Acc.B
0158 02a6 b6 04 12                   LDAA    T_Q     ; Retrieve 1st hex char to Acc.A
0159 02a9 bd fc 31                   JSR     BINARY  ; Convert A:B to binary
0160 02ac 39                         RTS             ; RETURN
0161                         Z_PRQM  ;LDAA    #'?     ; Load `?` into A
0162                                 ;BSR     PR_B    ; Print it
0163 02ad 20 e5                      BRA     ZINB    ; Go back to start of hex input
0164                         
0165                         ; -----------------------------------------------------
0166                         ; Print character in A to ACIA(b)
0167                         ; -----------------------------------------------------
0168 02af f6 f4 03           PR_B    LDAB    CTRLB   ; Get ACIA(a) status byte
0169 02b2 c5 02                      BITB    #02     ; Is it busy ?
0170 02b4 27 f9                      BEQ     PR_B    ; Yes: Try again
0171 02b6 b7 f4 02                   STAA    DATAB   ;  No: Send data
0172 02b9 39                 PRB_END RTS             ; RETURN
0173                         
0174                         ; -----------------------------------------------------
0175                         ; Read 4 hex digits and put value into X
0176                         ; -----------------------------------------------------
0177                         RD_XB   ;JSR     PR_SPCB   ; Print a space
0178 02ba 8d d8                      BSR     ZINB    ; Read 2 digit hex value into A
0179 02bc b7 04 13                   STAA    T_Z     ; Save byte (most significant)
0180 02bf 8d d3                      BSR     ZINB    ; Read 2 digit hex value into A
0181 02c1 b7 04 14                   STAA    T_Z+1   ; Save byte (least significant)
0182 02c4 fe 04 13                   LDX     T_Z     ; Load full 4 hex value into X
0183 02c7 39                         RTS             ; RETURN
0184                         
0185                         ; -----------------------------------------------------
0186                         ; Prints the message "You weight n stones n pounds"
0187                         ; place stones in MSB of X and pound in LSB
0188                         ; -----------------------------------------------------
0189                         PR_WEIGHT
0190 02c8 ff 04 19                   STX     T_W
0191 02cb bd 02 64                   JSR     STRINGB
0192 02ce 59 6f 75 20 77 65          FCC     "You weigh "
     69 67 68 20
0193 02d8 00 ff                      FDB     $FF
0194 02da b6 04 19                   LDAA    T_W             ; Load high byte of X into Accumulator A
0195 02dd bd 03 28                   JSR     PR_WORD
0196 02e0 bd 02 64                   JSR     STRINGB
0197 02e3 20 73 74 6f 6e 65          FCC     " stones "
     73 20
0198 02eb 00 ff                      FDB     $FF
0199 02ed b6 04 1a                   LDAA    T_W+1            ; Load high byte of X into Accumulator A
0200 02f0 bd 03 28                   JSR     PR_WORD
0201 02f3 bd 02 64                   JSR     STRINGB
0202 02f6 20 70 6f 75 6e 64          FCC     " pounds"
     73
0203 02fd 0d 0a ff                   FCB     $0D, $0A,$FF
0204                         
0205 0300 39                         RTS
0206                         
0207                         ; -----------------------------------------------------
0208                         ; Prints a space on both consoles (preserves A)
0209                         ; -----------------------------------------------------
0210 0301 36                 PR_SPCB   PSHA
0211 0302 86 20                      LDAA    #$20        ; Put space character in A
0212 0304 bd fc 0f                   JSR     PR_A
0213 0307 bd 02 af                   JSR     PR_B        ; Print it
0214 030a 32                         PULA
0215 030b 39                         RTS                 ; RETURN
0216                         
0217                         ; -----------------------------------------------------
0218                         ; Prints a phrase from the PHRASES table
0219                         ; -----------------------------------------------------
0220                         PR_PHRASE
0221 030c ff 04 17           PR_PH1  STX     T_P         ; save X
0222 030f a6 00                      LDAA    0,X         ; get word number
0223 0311 81 00                      CMPA    #0
0224 0313 27 0c                      BEQ     PR_PH2      ; no more words
0225 0315 bd 03 28                   JSR     PR_WORD     ; print word
0226 0318 fe 04 17                   LDX     T_P         ; recover X
0227 031b 08                         INX
0228 031c bd 03 01                   JSR     PR_SPCB
0229 031f 20 eb                      BRA     PR_PH1
0230 0321 bd 02 64           PR_PH2  JSR     STRINGB
0231 0324 0a 0d ff                   FCB     $0A,$0D,$FF
0232 0327 39                         RTS
0233                         
0234                         ; -----------------------------------------------------
0235                         ; Get number word based on value in A
0236                         ; -----------------------------------------------------
0237 0328 4c                 PR_WORD     INCA
0238 0329 ce 03 44                       LDX     #WORDPTR  ; base of offset table
0239 032c 4a                 PR_WORD1    DECA
0240 032d 27 04                          BEQ     FOUND
0241 032f 08                             INX                 ; move to next address
0242 0330 08                             INX
0243 0331 26 f9                          BNE     PR_WORD1    ; loop around to retest
0244 0333 a6 00              FOUND       LDAA    0,X
0245 0335 b7 04 15                       STAA    T_X
0246 0338 a6 01                          LDAA    1,X
0247 033a b7 04 16                       STAA    T_X+1
0248 033d fe 04 15                       LDX     T_X
0249 0340 bd 02 7a                       JSR     STRINGBX
0250 0343 39                             RTS
0251                         
