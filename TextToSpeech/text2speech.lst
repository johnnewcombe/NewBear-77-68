                             12 ; MINIMON routines
                     FC76    13 STRING              .equ 0xFC76   ; Prints a string. The string should follow JSR and be terminated with 0xFF.
                     FC89    14 GETADD              .equ 0xFC89   ; Get Address, read 4 digit hex value.
                     FCC9    15 ZOUT                .equ 0xFCC9   ; Print value in A as 2 hex digits.
                     FE97    16 NEWLINE             .equ 0xFE97   ; Prints a new line.
                     FF8F    17 START               .equ 0xFF8F   ; Restarts MniMon.
                     FC0F    18 PR_A                .equ 0xFC0F   ; Print char in A to ACIA (a)
                     FD2B    19 RD_A                .equ 0xFD2B   ; Read char from A
                     FD4D    20 PRSP                .equ 0xFD4D   ; Print a space
                     FC31    21 BINARY              .equ 0xFC31   ; Converts ASCII hex digits in A and B to binary?
                     FC65    22 RD_X                .equ 0xFC65   ; Read 4 hex digits Value from ACIA(a) and put value into X.
                     FC1D    23 VHEX                .equ 0xFC1D   ; Checks that A contains a HEX character
