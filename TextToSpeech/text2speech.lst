                            315 ; -----------------------------------------------------
                            316 ; Prints a string pointed to by X
                            317 ; -----------------------------------------------------
   0303 A6 00         [ 5]  318 STRINGBX:   LDAA    0,X         ; get char
   0305 81 FF         [ 2]  319             CMPA    #0xFF        ; is character NULL?
   0307 27 0F         [ 4]  320             BEQ     DONEB       ; yes, end of string
                            321             ;STAA   PANEL     ; REMOVED, too much activity
   0309 F6 F0 FF      [ 4]  322             LDAB    PANEL
   030C C5 01         [ 2]  323             BITB    #1
   030E 27 03         [ 4]  324             BEQ     STRBX       ; panel switch 0 is debug and copies data to A
   0310 BD FC 0F      [ 9]  325             JSR     PR_A        ; Print the byte to ACIA(a) (A is maintained)
   0313 8D 2F         [ 8]  326 STRBX:      BSR     PR_B        ; Print the byte to ACIA(b)
   0315 08            [ 4]  327             INX
   0316 20 EB         [ 4]  328             BRA     STRINGBX
   0318 39            [ 5]  329 DONEB:      RTS
                            330 
                            331 ; -----------------------------------------------------
                            332 ; Reads a character from ACIA(b) into A
                            333 ; -----------------------------------------------------
   0319 7C 1A 15      [ 6]  334 RD_B:    INC     RND         ; simple way to get a random number
   031C B6 F4 03      [ 4]  335         LDAA    CTRLB       ; Get ACIA.A status byte
   031F 85 01         [ 2]  336         BITA    #01         ; Is byte ready in DATAb
   0321 27 F6         [ 4]  337         BEQ     RD_B        ; No: Try again
   0323 B6 F4 02      [ 4]  338         LDAA    DATAB       ; Get the data byte to A
   0326 84 7F         [ 2]  339         ANDA    #0x7F        ; Mask off parity bit if it exists
   0328 39            [ 5]  340         RTS                 ; RETURN
                            341 
                            342 ; -----------------------------------------------------
                            343 ;
                            344 ; -----------------------------------------------------
   0329 8D EE         [ 8]  345 ZINB:    BSR     RD_B    ; Read a character
   032B BD FC 1D      [ 9]  346         JSR     VHEX    ; Is it a hex character ?
   032E 25 12         [ 4]  347         BCS     Z_PRQM  ; No: go to print `?`
   0330 B7 1A 05      [ 5]  348         STAA    T_Q     ; Yes: Save Acc.A
   0333 8D E4         [ 8]  349         BSR     RD_B    ; Read 2nd character
   0335 BD FC 1D      [ 9]  350         JSR     VHEX    ; Is it a hex character ?
   0338 25 08         [ 4]  351         BCS     Z_PRQM  ; No: go to print `?`
   033A 16            [ 2]  352         TAB             ; Yes: Put it into Acc.B
   033B B6 1A 05      [ 4]  353         LDAA    T_Q     ; Retrieve 1st hex char to Acc.A
   033E BD FC 31      [ 9]  354         JSR     BINARY  ; Convert A:B to binary
   0341 39            [ 5]  355         RTS             ; RETURN
   0342                     356 Z_PRQM:  ;LDAA    #'?     ; Load `?` into A
                            357         ;BSR     PR_B    ; Print it
   0342 20 E5         [ 4]  358         BRA     ZINB    ; Go back to start of hex input
                            359 
                            360 
                            361 ; -----------------------------------------------------
                            362 ; Print character in A to ACIA(b)
                            363 ; -----------------------------------------------------
   0344 F6 F4 03      [ 4]  364 PR_B:    LDAB    CTRLB   ; Get ACIA(a) status byte
   0347 C5 02         [ 2]  365         BITB    #02     ; Is it busy ?
   0349 27 F9         [ 4]  366         BEQ     PR_B    ; Yes: Try again
   034B B7 F4 02      [ 5]  367         STAA    DATAB   ;  No: Send data
   034E 39            [ 5]  368 PRB_END: RTS             ; RETURN
                            369 
ASxxxx Assembler V05.50.5  (Motorola 6800/6802/6808)                    Page 8
Hexadecimal [16-Bits]                                 Thu May  7 22:06:22 2026



                            370 ; -----------------------------------------------------
                            371 ; Read 4 hex digits and put value into X
                            372 ; -----------------------------------------------------
   034F 8D D8         [ 8]  373 RD_XB:   BSR     ZINB    ; Read 2 digit hex value into A
   0351 B7 1A 06      [ 5]  374         STAA    T_Z     ; Save byte (most significant)
   0354 8D D3         [ 8]  375         BSR     ZINB    ; Read 2 digit hex value into A
   0356 B7 1A 07      [ 5]  376         STAA    T_Z+1   ; Save byte (least significant)
   0359 FE 1A 06      [ 5]  377         LDX     T_Z     ; Load full 4 hex value into X
   035C 39            [ 5]  378         RTS             ; RETURN
                            379 
                            380 ; -----------------------------------------------------
                            381 ; Adds A to X and leaves the result in X, A is
                            382 ; preserved.
                            383 ; -----------------------------------------------------
   035D 36            [ 4]  384 ADX:     PSHA
   035E FF 1A 10      [ 6]  385         STX     T_TMP
   0361 BB 1A 11      [ 4]  386         ADDA    T_TMP+1   ; add A to low byte
   0364 B7 1A 11      [ 5]  387         STAA    T_TMP+1
   0367 B6 1A 10      [ 4]  388         LDAA    T_TMP     ; get high byte
   036A 89 00         [ 2]  389         ADCA    #0      ; add carry only
   036C B7 1A 10      [ 5]  390         STAA    T_TMP
   036F FE 1A 10      [ 5]  391         LDX     T_TMP
   0372 32            [ 4]  392         PULA
   0373 39            [ 5]  393         RTS
                            394 
                            395 ; -----------------------------------------------------
                            396 ; Loads X with A, A is preserved.
                            397 ; -----------------------------------------------------
   0374 B7 1A 11      [ 5]  398 TAX:    STAA    T_TMP+1       ; store A as low byte of X
   0377 7F 1A 10      [ 6]  399         CLR     T_TMP         ; zero the high byte
   037A FE 1A 10      [ 5]  400         LDX     T_TMP         ; load X
   037D 39            [ 5]  401         RTS
                            402 
                            403 ; -----------------------------------------------------
                            404 ; Prints the message " n stones n pounds"
                            405 ; place stones in MSB of X and pound in LSB
                            406 ; -----------------------------------------------------
   037E                     407 PR_WEIGHT:
                            408 
   037E FF 1A 0E      [ 6]  409         STX     T_W
   0381 B6 1A 0E      [ 4]  410         LDAA    T_W
   0384 BD 03 74      [ 9]  411         JSR     TAX
   0387 BD 03 F3      [ 9]  412         JSR     PR_WORD         ; n
   038A BD 03 AC      [ 9]  413         JSR     PR_SPCB
   038D CE 01 2B      [ 3]  414         LDX     #STONES
   0390 BD 03 F3      [ 9]  415         JSR     PR_WORD         ; "stones"
   0393 BD 03 AC      [ 9]  416         JSR     PR_SPCB
   0396 B6 1A 0F      [ 4]  417         LDAA    T_W+1            ; Load high byte of X into Accumulator A
   0399 BD 03 74      [ 9]  418         JSR     TAX
   039C BD 03 F3      [ 9]  419         JSR     PR_WORD         ; n
   039F CE 00 F5      [ 3]  420         LDX     #POUNDS
   03A2 BD 03 AC      [ 9]  421         JSR     PR_SPCB
   03A5 BD 03 F3      [ 9]  422         JSR     PR_WORD         ; "pounds"
   03A8 BD 03 B7      [ 9]  423         JSR     PR_CRB
   03AB 39            [ 5]  424         RTS
ASxxxx Assembler V05.50.5  (Motorola 6800/6802/6808)                    Page 9
Hexadecimal [16-Bits]                                 Thu May  7 22:06:22 2026



                            425 
                            426 ; -----------------------------------------------------
                            427 ; Prints a space on both consoles (preserves A)
                            428 ; -----------------------------------------------------
   03AC 36            [ 4]  429 PR_SPCB: PSHA
   03AD 86 20         [ 2]  430         LDAA    #0x20        ; Put space character in A
   03AF BD FC 0F      [ 9]  431         JSR     PR_A
   03B2 BD 03 44      [ 9]  432         JSR     PR_B        ; Print it
   03B5 32            [ 4]  433         PULA
   03B6 39            [ 5]  434         RTS                 ; RETURN
                            435 
                            436 ; -----------------------------------------------------
                            437 ; Prints a CRLF on both consoles (preserves A)
                            438 ; -----------------------------------------------------
   03B7 36            [ 4]  439 PR_CRB:     PSHA
   03B8 86 0D         [ 2]  440             LDAA    #0x0D        ; Put CHAR character in A
   03BA BD FC 0F      [ 9]  441             JSR     PR_A
   03BD BD 03 44      [ 9]  442             JSR     PR_B        ; Print it
   03C0 86 0A         [ 2]  443             LDAA    #0x0A
   03C2 F6 F0 FF      [ 4]  444             LDAB     PANEL
   03C5 C5 01         [ 2]  445             BITB    #1
   03C7 27 03         [ 4]  446             BEQ     PR_CRB1
   03C9 BD FC 0F      [ 9]  447             JSR     PR_A
   03CC BD 03 44      [ 9]  448 PR_CRB1:    JSR     PR_B        ; Print it
   03CF 32            [ 4]  449             PULA
   03D0 39            [ 5]  450             RTS                 ; RETURN
                            451 
                            452 ; -----------------------------------------------------
                            453 ; Outputs a phrase from the memory location in X
                            454 ; -----------------------------------------------------
   03D1                     455 PR_PHRASE:
                            456 
   03D1 A6 00         [ 5]  457 PR_PH1:  LDAA    0,X         ; get high byte of word
   03D3 E6 01         [ 5]  458         LDAB    1,X         ; get low byte
   03D5 81 FF         [ 2]  459         CMPA    #0xFF        ; check high byte
   03D7 27 19         [ 4]  460         BEQ     PR_PH2      ; high byte is 0xFF so we're done
   03D9 FF 1A 0A      [ 6]  461 PR_PH3:  STX     T_Y         ; save table pointer
   03DC B7 1A 0C      [ 5]  462         STAA    T_P
   03DF F7 1A 0D      [ 5]  463         STAB    T_P+1
   03E2 FE 1A 0C      [ 5]  464         LDX     T_P         ; X now points to the word
   03E5 BD 03 F3      [ 9]  465         JSR     PR_WORD
   03E8 BD 03 AC      [ 9]  466         JSR     PR_SPCB
   03EB FE 1A 0A      [ 5]  467         LDX     T_Y         ; restore table pointer
   03EE 08            [ 4]  468         INX                 ; move to next entry
   03EF 08            [ 4]  469         INX                 ; (2 bytes per entry)
   03F0 20 DF         [ 4]  470         BRA     PR_PH1
   03F2 39            [ 5]  471 PR_PH2:  RTS
                            472 
                            473 ; -----------------------------------------------------
                            474 ; Outputs a word based on value in X
                            475 ; -----------------------------------------------------
   03F3                     476 PR_WORD:
   03F3 FF 1A 08      [ 6]  477             STX     T_X             ; use ASL and ROL to multiply by 2 (pointer is 2 bytes wide)
   03F6 78 1A 09      [ 6]  478             ASL     T_X+1           ; shift low byte left, bit 7 goes to carry
   03F9 79 1A 08      [ 6]  479             ROL     T_X             ; rotate high byte left, carry in from low byte
ASxxxx Assembler V05.50.5  (Motorola 6800/6802/6808)                   Page 10
Hexadecimal [16-Bits]                                 Thu May  7 22:06:22 2026



   03FC FE 1A 08      [ 5]  480             LDX     T_X
   03FF FF 1A 08      [ 6]  481             STX     T_X             ; Stash X
   0402 B6 1A 08      [ 4]  482             LDAA    T_X             ; High byte of X
   0405 F6 1A 09      [ 4]  483             LDAB    T_X+1           ; Low byte of X
   0408 CB 29         [ 2]  484             ADDB    #<WORDPTR    ; Add low byte of WORDPTR address
   040A 89 04         [ 2]  485             ADCA    #>WORDPTR    ; Add high byte of WORDPTR address + carry
   040C B7 1A 08      [ 5]  486             STAA    T_X             ; T_X has the address of the pointer NOT the word
   040F F7 1A 09      [ 5]  487             STAB    T_X+1
   0412 FE 1A 08      [ 5]  488             LDX     T_X             ; X has the address of the pointer NOT the word
                            489 
   0415 A6 00         [ 5]  490             LDAA    0,X             ; get the hi byte of the word
   0417 B7 1A 08      [ 5]  491             STAA    T_X
   041A A6 01         [ 5]  492             LDAA    1,X             ; get the low byte of the word
   041C B7 1A 09      [ 5]  493             STAA    T_X+1
   041F FE 1A 08      [ 5]  494             LDX     T_X             ; X now has address of the word
   0422 BD 03 03      [ 9]  495             JSR     STRINGBX        ; output the word
   0425 7C 1A 22      [ 6]  496             INC     SYLLABLES
   0428 39            [ 5]  497             RTS
                            498 
