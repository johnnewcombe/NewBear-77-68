                            341 ; -----------------------------------------------------
                            342 ; Reads a character from ACIA(b) into A
                            343 ; -----------------------------------------------------
   0328 7C 1A 24      [ 6]  344 RD_B:    INC     RND         ; simple way to get a random number
   032B B6 F4 03      [ 4]  345         LDAA    CTRLB       ; Get ACIA.A status byte
   032E 85 01         [ 2]  346         BITA    #01         ; Is byte ready in DATAb
   0330 27 F6         [ 4]  347         BEQ     RD_B        ; No: Try again
   0332 B6 F4 02      [ 4]  348         LDAA    DATAB       ; Get the data byte to A
   0335 84 7F         [ 2]  349         ANDA    #0x7F        ; Mask off parity bit if it exists
   0337 39            [ 5]  350         RTS                 ; RETURN
                            351 
                            352 ; -----------------------------------------------------
                            353 ;
                            354 ; -----------------------------------------------------
   0338 8D EE         [ 8]  355 ZINB:    BSR     RD_B    ; Read a character
   033A BD FC 1D      [ 9]  356         JSR     VHEX    ; Is it a hex character ?
   033D 25 12         [ 4]  357         BCS     Z_PRQM  ; No: go to print `?`
   033F B7 1A 14      [ 5]  358         STAA    T_Q     ; Yes: Save Acc.A
   0342 8D E4         [ 8]  359         BSR     RD_B    ; Read 2nd character
   0344 BD FC 1D      [ 9]  360         JSR     VHEX    ; Is it a hex character ?
   0347 25 08         [ 4]  361         BCS     Z_PRQM  ; No: go to print `?`
   0349 16            [ 2]  362         TAB             ; Yes: Put it into Acc.B
   034A B6 1A 14      [ 4]  363         LDAA    T_Q     ; Retrieve 1st hex char to Acc.A
   034D BD FC 31      [ 9]  364         JSR     BINARY  ; Convert A:B to binary
   0350 39            [ 5]  365         RTS             ; RETURN
   0351                     366 Z_PRQM:  ;LDAA    #'?     ; Load `?` into A
                            367         ;BSR     PR_B    ; Print it
   0351 20 E5         [ 4]  368         BRA     ZINB    ; Go back to start of hex input
                            369 
ASxxxx Assembler V05.50.5  (Motorola 6800/6802/6808)                    Page 8
Hexadecimal [16-Bits]                                 Thu May  7 21:56:15 2026



                            370 
                            371 ; -----------------------------------------------------
                            372 ; Print character in A to ACIA(b)
                            373 ; -----------------------------------------------------
   0353 F6 F4 03      [ 4]  374 PR_B:    LDAB    CTRLB   ; Get ACIA(a) status byte
   0356 C5 02         [ 2]  375         BITB    #02     ; Is it busy ?
   0358 27 F9         [ 4]  376         BEQ     PR_B    ; Yes: Try again
   035A B7 F4 02      [ 5]  377         STAA    DATAB   ;  No: Send data
   035D 39            [ 5]  378 PRB_END: RTS             ; RETURN
                            379 
                            380 ; -----------------------------------------------------
                            381 ; Read 4 hex digits and put value into X
                            382 ; -----------------------------------------------------
   035E 8D D8         [ 8]  383 RD_XB:   BSR     ZINB    ; Read 2 digit hex value into A
   0360 B7 1A 15      [ 5]  384         STAA    T_Z     ; Save byte (most significant)
   0363 8D D3         [ 8]  385         BSR     ZINB    ; Read 2 digit hex value into A
   0365 B7 1A 16      [ 5]  386         STAA    T_Z+1   ; Save byte (least significant)
   0368 FE 1A 15      [ 5]  387         LDX     T_Z     ; Load full 4 hex value into X
   036B 39            [ 5]  388         RTS             ; RETURN
                            389 
                            390 ; -----------------------------------------------------
                            391 ; Adds A to X and leaves the result in X, A is
                            392 ; preserved.
                            393 ; -----------------------------------------------------
   036C 36            [ 4]  394 ADX:     PSHA
   036D FF 1A 1F      [ 6]  395         STX     T_TMP
   0370 BB 1A 20      [ 4]  396         ADDA    T_TMP+1   ; add A to low byte
   0373 B7 1A 20      [ 5]  397         STAA    T_TMP+1
   0376 B6 1A 1F      [ 4]  398         LDAA    T_TMP     ; get high byte
   0379 89 00         [ 2]  399         ADCA    #0      ; add carry only
   037B B7 1A 1F      [ 5]  400         STAA    T_TMP
   037E FE 1A 1F      [ 5]  401         LDX     T_TMP
   0381 32            [ 4]  402         PULA
   0382 39            [ 5]  403         RTS
                            404 
                            405 ; -----------------------------------------------------
                            406 ; Loads X with A, A is preserved.
                            407 ; -----------------------------------------------------
   0383 B7 1A 20      [ 5]  408 TAX:    STAA    T_TMP+1       ; store A as low byte of X
   0386 7F 1A 1F      [ 6]  409         CLR     T_TMP         ; zero the high byte
   0389 FE 1A 1F      [ 5]  410         LDX     T_TMP         ; load X
   038C 39            [ 5]  411         RTS
                            412 
                            413 ; -----------------------------------------------------
                            414 ; Prints the message " n stones n pounds"
                            415 ; place stones in MSB of X and pound in LSB
                            416 ; -----------------------------------------------------
   038D                     417 PR_WEIGHT:
                            418 
   038D FF 1A 1D      [ 6]  419         STX     T_W
   0390 B6 1A 1D      [ 4]  420         LDAA    T_W
   0393 BD 03 83      [ 9]  421         JSR     TAX
   0396 BD 04 02      [ 9]  422         JSR     PR_WORD         ; n
   0399 BD 03 BB      [ 9]  423         JSR     PR_SPCB
   039C CE 01 2B      [ 3]  424         LDX     #STONES
ASxxxx Assembler V05.50.5  (Motorola 6800/6802/6808)                    Page 9
Hexadecimal [16-Bits]                                 Thu May  7 21:56:15 2026



   039F BD 04 02      [ 9]  425         JSR     PR_WORD         ; "stones"
   03A2 BD 03 BB      [ 9]  426         JSR     PR_SPCB
   03A5 B6 1A 1E      [ 4]  427         LDAA    T_W+1            ; Load high byte of X into Accumulator A
   03A8 BD 03 83      [ 9]  428         JSR     TAX
   03AB BD 04 02      [ 9]  429         JSR     PR_WORD         ; n
   03AE CE 00 F5      [ 3]  430         LDX     #POUNDS
   03B1 BD 03 BB      [ 9]  431         JSR     PR_SPCB
   03B4 BD 04 02      [ 9]  432         JSR     PR_WORD         ; "pounds"
   03B7 BD 03 C6      [ 9]  433         JSR     PR_CRB
   03BA 39            [ 5]  434         RTS
                            435 
                            436 ; -----------------------------------------------------
                            437 ; Prints a space on both consoles (preserves A)
                            438 ; -----------------------------------------------------
   03BB 36            [ 4]  439 PR_SPCB: PSHA
   03BC 86 20         [ 2]  440         LDAA    #0x20        ; Put space character in A
   03BE BD FC 0F      [ 9]  441         JSR     PR_A
   03C1 BD 03 53      [ 9]  442         JSR     PR_B        ; Print it
   03C4 32            [ 4]  443         PULA
   03C5 39            [ 5]  444         RTS                 ; RETURN
                            445 
                            446 ; -----------------------------------------------------
                            447 ; Prints a CRLF on both consoles (preserves A)
                            448 ; -----------------------------------------------------
   03C6 36            [ 4]  449 PR_CRB:     PSHA
   03C7 86 0D         [ 2]  450             LDAA    #0x0D        ; Put CHAR character in A
   03C9 BD FC 0F      [ 9]  451             JSR     PR_A
   03CC BD 03 53      [ 9]  452             JSR     PR_B        ; Print it
   03CF 86 0A         [ 2]  453             LDAA    #0x0A
   03D1 F6 F0 FF      [ 4]  454             LDAB     PANEL
   03D4 C5 01         [ 2]  455             BITB    #1
   03D6 27 03         [ 4]  456             BEQ     PR_CRB1
   03D8 BD FC 0F      [ 9]  457             JSR     PR_A
   03DB BD 03 53      [ 9]  458 PR_CRB1:    JSR     PR_B        ; Print it
   03DE 32            [ 4]  459             PULA
   03DF 39            [ 5]  460             RTS                 ; RETURN
                            461 
                            462 ; -----------------------------------------------------
                            463 ; Outputs a phrase from the memory location in X
                            464 ; -----------------------------------------------------
   03E0                     465 PR_PHRASE:
                            466 
   03E0 A6 00         [ 5]  467 PR_PH1:  LDAA    0,X         ; get high byte of word
   03E2 E6 01         [ 5]  468         LDAB    1,X         ; get low byte
   03E4 81 FF         [ 2]  469         CMPA    #0xFF        ; check high byte
   03E6 27 19         [ 4]  470         BEQ     PR_PH2      ; high byte is 0xFF so we're done
   03E8 FF 1A 19      [ 6]  471 PR_PH3:  STX     T_Y         ; save table pointer
   03EB B7 1A 1B      [ 5]  472         STAA    T_P
   03EE F7 1A 1C      [ 5]  473         STAB    T_P+1
   03F1 FE 1A 1B      [ 5]  474         LDX     T_P         ; X now points to the word
   03F4 BD 04 02      [ 9]  475         JSR     PR_WORD
   03F7 BD 03 BB      [ 9]  476         JSR     PR_SPCB
   03FA FE 1A 19      [ 5]  477         LDX     T_Y         ; restore table pointer
   03FD 08            [ 4]  478         INX                 ; move to next entry
   03FE 08            [ 4]  479         INX                 ; (2 bytes per entry)
ASxxxx Assembler V05.50.5  (Motorola 6800/6802/6808)                   Page 10
Hexadecimal [16-Bits]                                 Thu May  7 21:56:15 2026



   03FF 20 DF         [ 4]  480         BRA     PR_PH1
   0401 39            [ 5]  481 PR_PH2:  RTS
                            482 
                            483 ; -----------------------------------------------------
                            484 ; Outputs a word based on value in X
                            485 ; -----------------------------------------------------
   0402                     486 PR_WORD:
   0402 FF 1A 17      [ 6]  487             STX     T_X             ; use ASL and ROL to multiply by 2 (pointer is 2 bytes wide)
   0405 78 1A 18      [ 6]  488             ASL     T_X+1           ; shift low byte left, bit 7 goes to carry
   0408 79 1A 17      [ 6]  489             ROL     T_X             ; rotate high byte left, carry in from low byte
   040B FE 1A 17      [ 5]  490             LDX     T_X
   040E FF 1A 17      [ 6]  491             STX     T_X             ; Stash X
   0411 B6 1A 17      [ 4]  492             LDAA    T_X             ; High byte of X
   0414 F6 1A 18      [ 4]  493             LDAB    T_X+1           ; Low byte of X
   0417 CB 38         [ 2]  494             ADDB    #<WORDPTR    ; Add low byte of WORDPTR address
   0419 89 04         [ 2]  495             ADCA    #>WORDPTR    ; Add high byte of WORDPTR address + carry
   041B B7 1A 17      [ 5]  496             STAA    T_X             ; T_X has the address of the pointer NOT the word
   041E F7 1A 18      [ 5]  497             STAB    T_X+1
   0421 FE 1A 17      [ 5]  498             LDX     T_X             ; X has the address of the pointer NOT the word
                            499 
   0424 A6 00         [ 5]  500             LDAA    0,X             ; get the hi byte of the word
   0426 B7 1A 17      [ 5]  501             STAA    T_X
   0429 A6 01         [ 5]  502             LDAA    1,X             ; get the low byte of the word
   042B B7 1A 18      [ 5]  503             STAA    T_X+1
   042E FE 1A 17      [ 5]  504             LDX     T_X             ; X now has address of the word
   0431 BD 03 12      [ 9]  505             JSR     STRINGBX        ; output the word
   0434 7C 1A 25      [ 6]  506             INC     SYLLABLES
   0437 39            [ 5]  507             RTS
                            508 
