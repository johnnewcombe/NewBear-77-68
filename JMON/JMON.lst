0660                         ; FF8F
0661                         ; -----------------------------------------------------
0662 ff8f 8e f0 d0           START   LDS     #STACK  ; Set up stack for MINMON
0663 ff92 8d 57                      BSR     SETACIA ; Set up ACIAs
0664 ff94 bd fc 76                   JSR     STRING  ; Print string...
0665 ff97 0d 0a 00 2a                FCB     $0D,$0A,$00,'*    ; c/r l/f null `*`
0666 ff9b ff                         FCB     $FF     ; End-of-string
0667 ff9c bd fc 00                   JSR     RD_CMD  ; Read a byte (test for `.`)
0668 ff9f ce ff b5                   LDX     #CMDTAB ; point to command table
0669 ffa2 e6 00              CMDLP   LDAB    0,X     ; B = key byte (0 ends table)
0670 ffa4 27 e9                      BEQ     START   ; end of table → default to START
0671 ffa6 11                         CBA             ; compare A vs B
0672 ffa7 27 05                      BEQ     FOUND   ; match → dispatch
0673 ffa9 08                         INX             ; skip key
0674 ffaa 08                         INX             ; skip FDB high
0675 ffab 08                         INX             ; skip FDB low
0676 ffac 20 f4                      BRA      CMDLP  ; try next entry
0677                         
0678 ffae e6 01              FOUND   LDAB    1,X     ; B = target high byte (FDB stores high,low)
0679 ffb0 a6 02                      LDAA    2,X     ; A = target low byte
0680 ffb2 36                         PSHA            ; push high first
0681 ffb3 37                         PSHB            ; push low — now low is on top of stack
0682 ffb4 39                         RTS             ; jump to target
0683                         
0684                         ; Command table: key, then FDB routine
0685 ffb5 53                 CMDTAB  FCB     'S
0686 ffb6 ff 39                      FDB     BRPTSET
0687 ffb8 48                         FCB     'H
0688 ffb9 ff 63                      FDB     HEADER
0689 ffbb 50                         FCB     'P
0690 ffbc fd e2                      FDB     PUNCH
0691 ffbe 4c                         FCB     'L
0692 ffbf fc e3                      FDB     LOAD
0693 ffc1 52                         FCB     'R
0694 ffc2 fd 36                      FDB     REGPRT
0695 ffc4 4d                         FCB     'M
0696 ffc5 fe 43                      FDB     MODIFY
0697 ffc7 47                         FCB     'G
0698 ffc8 fe c2                      FDB     GO
0699 ffca 43                         FCB     'C
0700 ffcb fe d9                      FDB     CONTNU
0701 ffcd 44                         FCB     'D
0702 ffce ff 07                      FDB     DUMP
0703 ffd0 54                         FCB     'T'
0704 ffd1 fd 62                      FDB     MEMTEST
0705 ffd3 56                         FCB     'V'
0706 ffd4 fd c3                      FDB     VERSION
0707 ffd6 00                         FCB     0       ; terminator
0708 ffd7 ff 8f                      FDB     START   ; not used (any value ok after 0)
0709                         
