   0105 BD 02 4D      [ 9]   49                 JSR     GETDATA         ; value in T_WEIGHT, stones in A
   0108 25 03         [ 4]   50                 BCS     ML1             ; is it invalid i.e. carry clear
   010A 7E 01 9E      [ 3]   51                 JMP     IDLE
   010D 81 14         [ 2]   52 ML1:            CMPA    #TOO_HEAVY      ; more that 20 is too heavy
   010F 22 43         [ 4]   53                 BHI     OVERLOADED
   0111 B6 19 65      [ 4]   54                 LDAA    T_WEIGHT+1      ; validate pounds
   0114 81 0D         [ 2]   55                 CMPA    #13             ; invalid pounds
