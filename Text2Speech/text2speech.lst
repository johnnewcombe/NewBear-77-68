   000F                      20 T_WEIGHT:        .rmb     2       ; holds value of weight following a call to GETDATA
                             21 
                             22 ; these are cleared at start up
   0011                      23 IDLE_COUNT:      .rmb     1       ; counts the number of empty measurement reports
   0012                      24 IDLE_MSG_ID:     .rmb     1       ; holds value of next idle message to use
   0013                      25 GREET_MSG_ID:    .rmb     1       ; holds value of next greeting message to use
   0014                      26 LIGHT_MSG_ID:    .rmb     1       ; holds value of next light weight message to use
   0015                      27 NORMAL_MSG_ID:   .rmb     1       ; holds value of next normal weight message to use
   0016                      28 HEAVY_MSG_ID:    .rmb     1       ; holds value of next heavy weight message to use
   0017                      29 SHEAVY_MSG_ID:   .rmb     1       ; holds value of next super heavy weight message to use
   0018                      30 PROCESSING_FLG:  .rmb     1       ; non-zero indicates that that a weight is being processed
                             31                                   ;   all following weight data is ignored until the next
                             32                                   ;   idle (0000h) data resets it.
   0019                      33 WORDS:           .rmb     1       ; number of words for the panel LED routines
                             34                                   ;  this is updated each time a word is transmitted.
   001A                      35 RND:            .rmb      1
