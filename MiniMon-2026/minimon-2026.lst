0493 febf bd fc 65           GO      JSR     RD_X    ; Get address to X (16.bit)
0494 fec2 bd fc 00                   JSR     RD_CMD  ; Right address ?
0495 fec5 b6 f0 f4                   LDAA    T_Z+1   ; T_Z.low to A
0496 fec8 f6 f0 f3                   LDAB    T_Z     ; T_Z.high to B
0497 fecb fe f0 fd           GOTO    LDX     PSTACK  ; Callers stack address to X
0498 fece a7 07                      STAA    7,X     ; Put new return
0499 fed0 e7 06                      STAB    6,X     ; address on stack
0500 fed2 be f0 fd                   LDS     PSTACK  ; Set up calling programs stack
0501 fed5 3b                         RTI             ; RETURN-FROM-INTERRUPT (SWI)
0502                         
0503 fed6 bd fc 00           CONTNU  JSR     RD_CMD  ; Read a byte (test for `.`)
0504 fed9 81 31                      CMPA    #'1     ; Is it `1` ?
0505 fedb 26 10                      BNE     IsIt2  ; No: go test for `2`
0506 fedd fe f0 f7                   LDX     T_ABYT  ; Get address of break.point
0507 fee0 b6 f0 fb                   LDAA    T_BYTE  ; Get saved opcode
0508 fee3 a7 00                      STAA    0,X     ; Put it back in the program
0509 fee5 b6 f0 f8                   LDAA    T_ABYT+1 ; Get address at which
0510 fee8 f6 f0 f7                   LDAB    T_ABYT  ;   to re-enter program
0511 feeb 20 de                      BRA     GOTO    ; Go to calling program
0512                         
0513 feed 81 32              IsIt2   CMPA    #'2     ; Is it `2`
0514 feef 27 03                      BEQ     G_Is2   ; Yes: go process it
0515 fef1 7e ff 8c                   JMP     START   ; No: Return to MINIMON
0516 fef4 fe f0 f9           G_Is2   LDX     T_ABYT+2 ; Get addr. of break.point 2
0517 fef7 b6 f0 fc                   LDAA    T_BYTE+1 ; Get old opcode
0518 fefa a7 00                      STAA    0,X      ; Put it back
0519 fefc b6 f0 fa                   LDAA    T_ABYT+3 ; Load address to start
0520 feff f6 f0 f9                   LDAB    T_ABYT+2 ;  running program at
0521 ff02 20 c7                      BRA     GOTO    ; Run user program
0522                         
