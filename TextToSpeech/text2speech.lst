   0303 C5 01         [ 2]  315          BITB     #1
   0305 27 03         [ 4]  316          BEQ     STRB    ; panel switch 0 is debug and copies data to A
   0307 BD FC 0F      [ 9]  317          JSR     PR_A    ; Print the byte to ACIA(a) (A is maintained)
                            318                          ;  DEBUG depending on panel data switch zero
   030A 8D 47         [ 8]  319 STRB:    BSR     PR_B    ; Print the byte to ACIA(b)
   030C 20 EB         [ 4]  320          BRA     STRB1   ; Go back for next byte
   030E 31            [ 4]  321 ENDSTR:  INS             ; Clean up stack...
   030F 31            [ 4]  322          INS             ;  ( pop off the return addr )
   0310 6E 01         [ 4]  323          JMP     1,X     ; Jump back to caller (RETURN)
                            324 
                            325 ; -----------------------------------------------------
                            326 ; Prints a string pointed to by X
                            327 ; -----------------------------------------------------
   0312 A6 00         [ 5]  328 STRINGBX:   LDAA    0,X         ; get char
   0314 81 FF         [ 2]  329             CMPA    #0xFF        ; is character NULL?
   0316 27 0F         [ 4]  330             BEQ     DONEB       ; yes, end of string
                            331             ;STAA   PANEL     ; REMOVED, too much activity
   0318 F6 F0 FF      [ 4]  332             LDAB    PANEL
   031B C5 01         [ 2]  333             BITB    #1
   031D 27 03         [ 4]  334             BEQ     STRBX       ; panel switch 0 is debug and copies data to A
   031F BD FC 0F      [ 9]  335             JSR     PR_A        ; Print the byte to ACIA(a) (A is maintained)
   0322 8D 2F         [ 8]  336 STRBX:      BSR     PR_B        ; Print the byte to ACIA(b)
   0324 08            [ 4]  337             INX
   0325 20 EB         [ 4]  338             BRA     STRINGBX
   0327 39            [ 5]  339 DONEB:      RTS
