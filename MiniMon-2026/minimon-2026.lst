output:  minimon-2026.s19
0001                         ; ------------------------------------------------------
0002                         ; Minimon
0003                         ; ------------------------------------------------------
0004                         ;  Original author ACH, Dec.1978;
0005                         ; ------------------------------------------------------
0006                         ; 13 NOV 2025 : [JN] added NOP at FFF7 to remove gap to
0007                         ;             : allow easier conversion to bin from s19
0008                         ; 05 DEC 2025 : [JN] Changed ACIA(a) to be 8N2 to match
0009                         ;             : PROM. So that MiniMon can be loaded and
0010                         ;             : run from the same terminal config.
0011                         ; ------------------------------------------------------
0012                         ; 2 x ACIAs :-
0013                         ;
0014                         
0015 f401                    CTRLA   EQU     $F401   ; ACIA.A Ctrl/Status
0016 f403                    CTRLB   EQU     $F403   ; ACIA.B Ctrl/Status
0017 f400                    DATAA   EQU     $F400   ; ACIA.A Data register
0018 f402                    DATAB   EQU     $F402   ; ACIA.B Data register
0019                         
0020                         ; Note:The original 256 bytes of RAM on the CPU board 
0021                         ;  appears at $F000 to $F0FE, with Switches/LEDs at $F0FF
0022                         ;  when a MON1 board is installed
0023                         
0024                         ; Stack goes down from $F0D0
0025 f0d0                    STACK   EQU     $F0D0   ; Top of MINIMON's stack
0026                         
0027                         
0028                         
0029                         ; RAM at $F0D1 to $F0DC appears to be unused
0030                         
0031                         ; 3 bytes reserved for each if NMI and IRQ handling
0032                         ; so an application can write JMP <addr> into those
0033                         ; places if those interrupts are wanted...
0034                         
0035 f0dd                    JNMI    EQU     $F0DD   ; Space for jump to NMI sub.
0036 f0e0                    JIRQ    EQU     $F0E0   ; Space for jump to IRQ sub.
0037                         
0038                         ; -----------------------------------------------------
0039 f0de                            ORG     $F0DE   ; Start of RAM variables
0040                         ; -----------------------------------------------------
0041                         ; Note: Temp storage variables renamed to get T_ prefix
0042                         ;       as some were sharing names with labels or registers
0043                         ;
0044                         ; New additions to support S19 additions
0045                         ;d_RdFstX    RMB     2       ;  "  RD_ByteFast X
0046                         ;d_Hx4X      RMB     2       ;  "  RDX4 PRX4
0047 f0de                    d_TW        RMB     2       ;  "  S19
0048                         ;d_STOP      RMB     2       ;  "  ASK_Addrs `Stop:`
0049 f0e0                    b_Csum      RMB     1       ;  "  S19
0050 f0e1                    b_Count     RMB     1       ;  "  S19
0051 f0e2                    b_Temp      RMB     1       ;  "  S19
0052                         ;d_START     RMB     2       ;  "  ASK_Start `Start:`
0053                         ;b_Q         RMB     1       ;  "  ZIN,DUMP
0054                         
0055 f0e3                    T_SAVE  RMB     2       ; Temp storage for NEWLINE
0056 f0e5                    T_P     RMB     1       ;   "     "     "  Z,X
0057 f0e6                    T_X     RMB     2       ;   "     "     "  Sub
0058 f0e8                    T_Y     RMB     2       ;   "     "     "  Sub
0059 f0ea                    T_NEW   RMB     2       ;   "     "     "  Block move
0060 f0ec                    T_M     RMB     1       ;   "     "     "  ZOUT
0061 f0ed                    T_TMPX  RMB     2       ;   "     "     "  PRX
0062 f0ef                    T_STRT  RMB     2       ;   "     "     "  GETADDRESS
0063 f0f1                    T_STOP  RMB     2       ;   "     "     "  GETADDRESS
0064 f0f3                    T_Z     RMB     2       ;   "     "     "   . RDX
0065 f0f5                    T_R     RMB     1       ;   "     "     "     PR
0066 f0f6                    T_Q     RMB     1       ;   "     "     "  ZIN,DUMP 
0067 f0f7                    T_ABYT  RMB     2       ;   "     "     "  SET BR.PT.
0068 f0f9                            RMB     2       ;   "     "     "  SET BR.PT.
0069 f0fb                    T_BYTE  RMB     2       ;   "     "     "  SET BR.PT.
0070 f0fd                    PSTACK  RMB     2       ;   "     "     "     SWI etc
0071                         
0072                         
0073                         
0074                         ;
0075                         ; -----------------------------------------------------
0076 ec00                            ORG     $EC00   ; Start of ROM based code
0077                         ; -----------------------------------------------------
0078 ec00 bd ed 2b           RD_CMD  JSR     RD_A    ; Input one character 
0079 ec03 27 fb                      BEQ     RD_CMD  ; Ignore paper tape follower
0080 ec05 8d 08                      BSR     PR_A    ; Echo character
0081 ec07 81 2e                      CMPA    #'.     ; Was it a fullstop ?
0082 ec09 26 03                      BNE     END_RD  ;
0083 ec0b 7e ef 8c                   JMP     START   ; Yes: Go to start of MINIMON
0084 ec0e 39                 END_RD  RTS             ;  No: RETURN
0085                         
0086                         ; -----------------------------------------------------
0087                         ; Print character in A
0088                         
0089 ec0f f6 f4 01           PR_A    LDAB    CTRLA   ; Get ACIA(a) status byte
0090 ec12 c5 02                      BITB    #02     ; Is it busy ?
0091 ec14 27 f9                      BEQ     PR_A    ; Yes: Try again
0092 ec16 b7 f4 00                   STAA    DATAA   ;  No: Send data
0093 ec19 7c f0 f5                   INC     T_R     ; Characters printed + One
0094 ec1c 39                         RTS             ; RETURN
0095                         
0096                         ; -----------------------------------------------------
0097                         ; Check A contains a HEX character,  Set C.bit on fail
0098                         
0099 ec1d 81 2f              VHEX    CMPA    #$2F    ; A < 30 ?
0100 ec1f 2f 0e                      BLE     NotHex  ;  not hex
0101 ec21 81 39                      CMPA    #$39    ; A > 39 ?    
0102 ec23 22 02                      BHI     NotNum  ;  Not a Numeral
0103 ec25 0c                 IsHex   CLC             ; It's OK (clear C bit)
0104 ec26 39                         RTS             ; RETURN
0105 ec27 81 40              NotNum  CMPA    #$40    ; A < 41 ?
0106 ec29 2f 04                      BLE     NotHex  ;  not hex
0107 ec2b 81 46                      CMPA    #$46    ; A <= 46
0108 ec2d 2f f6                      BLE     IsHex   ;  then it is hex
0109 ec2f 0d                 NotHex  SEC             ; Set C bit
0110 ec30 39                         RTS             ; RETURN
0111                         
0112                         ; -----------------------------------------------------
0113                         
0114 ec31 85 30              BINARY  BITA    #$30    ; Is it a letter ?
0115 ec33 27 0c                      BEQ     LETTA   ; Yes: Got to handle it
0116 ec35 48                 RIDA    ASLA            ;  No: It is a number, so
0117 ec36 48                         ASLA            ;      shift
0118 ec37 48                         ASLA            ;       left
0119 ec38 48                         ASLA            ;        4 bits
0120 ec39 c5 30                      BITB    #$30    ; Is Acc.B a letter ?
0121 ec3b 27 08                      BEQ     LETTB   ; Yes: Go handle it
0122 ec3d c4 0f              RIDB    ANDB    #$0F    ; Clear 4 high bits in Acc.B
0123 ec3f 1b                         ABA             ; Form binary character (A=A+B)
0124 ec40 39                         RTS             ; RETURN
0125 ec41 8b 09              LETTA   ADDA    #$09    ; Make Acc.A a binary
0126 ec43 20 f0                      BRA     RIDA    ;  as before
0127 ec45 cb 09              LETTB   ADDB    #$09    ; Make Acc.B a binary
0128 ec47 20 f4                      BRA     RIDB    ;  as before
0129                         
0130                         ; -----------------------------------------------------
0131                         ; Read a 4 digit HEX value, put result into X
0132                         
0133 ec49 8d b5              ZIN         BSR     RD_CMD      ; Read a character
0134 ec4b 8d d0                          BSR     VHEX        ; Is it a hex character ?
0135 ec4d 25 10                          BCS     Z_PRQM      ; No: go to print `?`
0136 ec4f b7 f0 f6                       STAA    T_Q         ; Save it
0137 ec52 8d ac                          BSR     RD_CMD      ; Read 2nd character
0138 ec54 8d c7                          BSR     VHEX        ; Is it a hex character ?
0139 ec56 25 07                          BCS     Z_PRQM      ; No: go to print `?`
0140 ec58 16                             TAB                 ; Yes: Put it into B
0141 ec59 b6 f0 f6                       LDAA    T_Q         ; Retrieve 1st hex char to A
0142 ec5c 7e ec db                       JMP     ZIN2        ; S19 version of ZIN is longer
0143 ec5f bd ed 26           Z_PRQM      JSR     PR_QM       ; Print "?"
0144 ec62 7e ec 49                       JMP     ZIN      ; Go back to start of hex input
0145                         
0146                         ; -----------------------------------------------------
0147                         ; Read 4 hex digits and put value into X
0148                         ;FC65
0149 ec65 bd ed 4d           RD_X    JSR     PRSP    ; Print a space
0150 ec68 8d df                      BSR     ZIN     ; Read 2 digit hex value into A
0151 ec6a b7 f0 f3                   STAA    T_Z     ; Save byte (most significant)
0152 ec6d 8d da                      BSR     ZIN     ; Read 2 digit hex value into A
0153 ec6f b7 f0 f4                   STAA    T_Z+1   ; Save byte (least significant)
0154 ec72 fe f0 f3                   LDX     T_Z     ; Load full 4 hex value into X
0155 ec75 39                         RTS             ; RETURN
0156                         
0157                         ; -----------------------------------------------------
0158                         ; Print string FOLLOWING JSR ( terminated by $FF )
0159                         ;  IE: It starts at the `return addr` put onto the stack by JSR
0160                         ;  So actual return address needed is past the string
0161                         
0162                         ;fc76
0163 ec76 30                 STRING  TSX             ; Get loc. of return addr to X
0164 ec77 ee 00                      LDX     0,X     ; Get return addr to X
0165 ec79 09                         DEX             ; Point to byte before
0166 ec7a 08                 AGAIN   INX             ; Point to next byte
0167 ec7b a6 00                      LDAA    0,X     ; Get byte to be printed
0168 ec7d 81 ff                      CMPA    #$FF    ; End-string ?
0169 ec7f 27 04                      BEQ     ENDSTR  ; Yes: Go to finish up
0170 ec81 8d 8c                      BSR     PR_A    ; Print the byte
0171 ec83 20 f5                      BRA     AGAIN   ; Go back for next byte
0172 ec85 31                 ENDSTR  INS             ; Clean up stack...
0173 ec86 31                         INS             ;  ( pop off the return addr )
0174 ec87 6e 01                      JMP     1,X     ; Jump back to caller (RETURN)
0175                         
0176                         ; -----------------------------------------------------
0177                         ; 
0178 ec89 8d eb              GETADD  BSR     STRING  ; Print string...
0179 ec8b 20 53                      FCC     " S"    ;
0180 ec8d ff                         FCB     $FF     ; End-of-string
0181 ec8e 8d d5                      BSR     RD_X    ; Read 4 digit HEX addr value
0182 ec90 ff f0 ef                   STX     T_STRT  ; Save it
0183 ec93 8d e1                      BSR     STRING  ; Print string...
0184 ec95 20 46                      FCC     " F"    ;
0185 ec97 ff                         FCB     $FF     ; End-of-string
0186 ec98 8d cb                      BSR     RD_X    ; Read 4 digit HEX addr value
0187 ec9a ff f0 f1                   STX     T_STOP  ; Save it
0188 ec9d 39                         RTS             ; RETURN
0189                         
0190                         ; -----------------------------------------------------
0191                         ; Convert value in A to 2 x ASCII hex digits in A and B
0192                         
0193 ec9e 16                 ASCII   TAB             ; Copy A to B
0194 ec9f 84 f0                      ANDA    #$F0    ; Clear low order 4 bits of A
0195 eca1 44                         LSRA            ; Shift
0196 eca2 44                         LSRA            ;  right
0197 eca3 44                         LSRA            ;   4
0198 eca4 44                         LSRA            ;    bits
0199 eca5 81 09                      CMPA    #$09    ; Letter or number ?
0200 eca7 22 0b                      BHI     SUBT    ; 
0201 eca9 8b 30                      ADDA    #$30    ; Make it an ASCII number
0202 ecab c4 0f              AND     ANDB    #$0F    ; Clear high order bits of B
0203 ecad c1 09                      CMPB    #$09    ; Letter or number ?
0204 ecaf 22 07                      BHI     ADD     ;
0205 ecb1 cb 30                      ADDB    #$30    ; Make it an ASCII number
0206 ecb3 39                         RTS             ; RETURN
0207 ecb4 8b 37              SUBT    ADDA    #$37    ; Make it an ASCI letter
0208 ecb6 20 f3                      BRA     AND     ; Go to process low order value
0209 ecb8 cb 37              ADD     ADDB    #$37    ; Make it an ASII letter
0210 ecba 39                         RTS             ; RETURN
0211                         
0212                         ; -----------------------------------------------------
0213                         ; Print value in X as 4 hex digits
0214                         
0215 ecbb ff f0 ed           PRX     STX     T_TMPX  ; Save X
0216 ecbe b6 f0 ed                   LDAA    T_TMPX  ; Get high order byte to A
0217 ecc1 8d 06                      BSR     ZOUT    ; Print A as 2 hex digits
0218 ecc3 b6 f0 ee                   LDAA    T_TMPX+1 ; Get low order byte to A
0219 ecc6 8d 01                      BSR     ZOUT    ; Print A as 2 hex digits
0220 ecc8 39                         RTS             ; RETURN
0221                         
0222                         ; -----------------------------------------------------
0223                         ; Print value in A as 2 hex digits
0224                         
0225 ecc9 8d d3              ZOUT    BSR     ASCII   ; Convert A to ASCII in A & B
0226 eccb f7 f0 ec                   STAB    T_M     ; Save B
0227 ecce bd ec 0f                   JSR     PR_A    ; Print byte in A
0228 ecd1 b6 f0 ec                   LDAA    T_M     ; Get 2nd byte into A
0229 ecd4 bd ec 0f                   JSR     PR_A    ; Print byte in A
0230 ecd7 39                         RTS             ; RETURN
0231                         
0232                         ; -----------------------------------------------------
0233                         ;RD_HEX2 This is a new ZIN and is called RD_HEX2 on GruntMon
0234                         
0235 ecd8                    PUNCH       EQU *
0236 ecd8 7e ef df                       JMP CMD_P
0237                         
0238                         ; second part of S19 version of ZIN
0239                         
0240 ecdb bd ec 31           ZIN2        JSR     BINARY      ; Convert A:B to binary to A
0241 ecde 16                             TAB                 ; B=A
0242 ecdf fb f0 e0                       ADDB    b_Csum      ; Add this value
0243 ece2 f7 f0 e0                       STAB    b_Csum      ; to the Checksum (for S19)
0244 ece5 39                             RTS                 ; RETURN
0245                         
0246                         ; -----------------------------------------------------
0247                         ; S19 format data load : Modded version of Mikbug code
0248                         ; NOTE THAT THIS IS IN THE WRONG PLACE AT PRESENT!!! It should be at FD07
0249                         ;
0250 ece6                    LOAD        EQU     *           ; L = Load = Input an S19 file
0251 ece6 bd ec 76                       JSR     STRING
0252 ece9 20 2b 20                       FCC     " + "
0253 ecec 0d 0a                          FCB     $0D,$0A     ; c/r l/f
0254 ecee ff                             FCB     $FF         ; End-Of-String
0255 ecef bd ec 00           .sRead      JSR     RD_CMD      ; Read+Echo, test for '.'
0256 ecf2 81 53                          CMPA    #'S         ; Is it `S` ?
0257 ecf4 26 f9                          BNE     .sRead      ; No: Keep waiting for `S`
0258 ecf6 bd ec 00                       JSR     RD_CMD      ; Read+Echo, test for '.'
0259 ecf9 81 39                          CMPA    #'9         ; Is it `9` ?  ( `S9` record )
0260 ecfb 27 26                          BEQ     STARTS      ; Yes: End-data, Back to START
0261 ecfd 81 31                          CMPA    #'1         ; Is it `1` ?  ( `S1` record )
0262 ecff 26 ee                          BNE     .sRead      ; No: Wait for next `S`
0263 ed01 7f f0 e0                       CLR     b_Csum      ; Clear checksum
0264 ed04 bd ec 49                       JSR     ZIN         ; Read 2xHex = data.byte count to A
0265 ed07 80 02                          SUBA    #2          ; Subtract 2 (to get bytes left in line)
0266 ed09 b7 f0 e1                       STAA    b_Count     ; Store byte count
0267 ed0c bd ec 65                       JSR     RD_X        ; Read 4xHex digit address to X
0268 ed0f bd ec 49           .sDoByt     JSR     ZIN         ; Read 2xHex digits, value to A
0269 ed12 7a f0 e1                       DEC     b_Count     ; Decrement our byte count
0270 ed15 27 05                          BEQ     .sChk       ; If end-of-line, go look at checksum
0271 ed17 a7 00                          STAA    0,X         ; Save byte where X points
0272 ed19 08                             INX                 ; Point X at next byte
0273 ed1a 20 f3                          BRA     .sDoByt     ; Go get next byte
0274 ed1c 7c f0 e0           .sChk       INC     b_Csum      ; Add 1 to checksum
0275 ed1f 27 ce                          BEQ     .sRead      ; OK: Go read next record
0276 ed21 8d 03                          BSR     PR_QM       ; Print "?"
0277 ed23 7e ef 8c           STARTS      JMP     START       ; Go to START
0278                         
0279 ed26 86 3f              PR_QM       LDAA #'?            ; Put '?' character in A
0280 ed28 7e ec 0f                       JMP     PR_A        ; Print it and return via PR_As RTS
0281                         
0282                         
0283                         
0284                         
0285                         
0286                         ; -----------------------------------------------------
0287                         ; Read byte from ACIA.A to A
0288                         ;FD2B
0289 ed2b b6 f4 01           RD_A    LDAA    CTRLA   ; Get ACIA.A status byte
0290 ed2e 85 01                      BITA    #$01    ; Is byte ready in DATAA
0291 ed30 27 f9                      BEQ     RD_A    ; No: Try again
0292 ed32 b6 f4 00                   LDAA    DATAA   ; Get the data byte to A
0293 ed35 39                         RTS             ; RETURN
0294                         
0295                         ; -----------------------------------------------------
0296 ed36 8d 15              REGPRT  BSR     PRSP    ; Print a space
0297 ed38 fe f0 fd                   LDX     PSTACK  ; Point X at user's stack
0298 ed3b 8d 1c                      BSR     PR2     ; Print CC
0299 ed3d 8d 1a                      BSR     PR2     ; Print B
0300 ed3f 8d 18                      BSR     PR2     ; Print A
0301 ed41 8d 10                      BSR     PR4     ; Print X
0302 ed43 8d 0e                      BSR     PR4     ; Print PC
0303 ed45 ce f0 fd                   LDX     #PSTACK ; Point X at stack pointer
0304 ed48 8d 0a                      BSR     PR4X    ; Print stack pointer
0305 ed4a 7e ef 8c                   JMP     START   ; (RETURN) to MINIMON
0306                         
0307                         ; -----------------------------------------------------
0308 ed4d 86 20              PRSP    LDAA    #$20    ; Put space character in A
0309 ed4f bd ec 0f                   JSR     PR_A    ; Print it
0310 ed52 39                         RTS             ; RETURN
0311                         
0312 ed53 08                 PR4     INX             ; Point X to next character
0313 ed54 a6 00              PR4X    LDAA    0,X     ; Get byte pointed to by X
0314 ed56 bd ec c9                   JSR     ZOUT    ; Print it
0315 ed59 08                 PR2     INX             ; Point X to next character
0316 ed5a a6 00                      LDAA    0,X     ; Get byte pointed to by X
0317 ed5c bd ec c9                   JSR     ZOUT    ; Print it
0318 ed5f 8d ec                      BSR     PRSP    ; Print a space
0319 ed61 39                         RTS             ; RETURN
0320                         
0321                         ; -----------------------------------------------------
0322 ed62 bd ec 89           BLKMOV  JSR     GETADD  ; Prompt for boundary addresses
0323 ed65 bd ec 76                   JSR     STRING  ; Print string...
0324 ed68 20 54 6f                   FCC     " To"   ;
0325 ed6b ff                         FCB     $FF     ; End-of-string
0326 ed6c bd ec 65                   JSR     RD_X    ; Read 4 hex digit value into X
0327 ed6f ff f0 ea                   STX     T_NEW   ; Store it as NEW start address
0328 ed72 ff f0 e6                   STX     T_X     ;   "    "
0329 ed75 fe f0 ef                   LDX     T_STRT  ; Put start address into X
0330 ed78 ff f0 e8                   STX     T_Y     ; Store it
0331 ed7b 8d 59                      BSR     SUB     ; Perform T_X minus T_Y
0332 ed7d 2a 23                      BPL     DOWN    ; Go to Move downwards
0333 ed7f fe f0 f1                   LDX     T_STOP  ; Get the STOP stop address
0334 ed82 08                         INX             ; Add 1 to it
0335 ed83 ff f0 f1                   STX     T_STOP  ; and save it
0336 ed86 fe f0 ef           DO_UP   LDX     T_STRT  ; Get START address
0337 ed89 bc f0 f1                   CPX     T_STOP  ; Compare it with STOP
0338 ed8c 26 03                      BNE     CONT_A  ; Finished ?
0339 ed8e 7e ef 8c           STARTB  JMP     START   ; Yes: back to MINIMON
0340 ed91 a6 00              CONT_A  LDAA    0,X     ; No: Get data
0341 ed93 08                         INX             ; Point X to next `old` address
0342 ed94 ff f0 ef                   STX     T_STRT  ; and store it
0343 ed97 fe f0 ea                   LDX     T_NEW   ; get address of NEW location
0344 ed9a a7 00                      STAA    0,X     ; Store the data at NEW address
0345 ed9c 08                         INX             ; Point X to next `new` address
0346 ed9d ff f0 ea                   STX     T_NEW   ; and store it
0347 eda0 20 e4                      BRA     DO_UP   ; loop back for next byte
0348 eda2 fe f0 f1           DOWN    LDX     T_STOP  ; Get end address
0349 eda5 ff f0 e6                   STX     T_X     ; Store it
0350 eda8 8d 2c                      BSR     SUB     ; Perform T_X minus T_Y
0351 edaa bb f0 eb                   ADDA    T_NEW+1 ; Add NEW (low.byte) to A
0352 edad fb f0 ea                   ADDB    T_NEW   ; Add NEW (high.byte) to B
0353 edb0 b7 f0 eb                   STAA    T_NEW+1 ; Save NEW (low.byte)
0354 edb3 f7 f0 ea                   STAB    T_NEW   ;         (high.byte)
0355 edb6 fe f0 ef                   LDX     T_STRT  ; Get START address
0356 edb9 09                         DEX             ; Subract 1 from X
0357 edba ff f0 ef                   STX     T_STRT  ; Store it
0358 edbd fe f0 f1           DO_DOWN LDX     T_STOP  ; Get STOP address
0359 edc0 bc f0 ef                   CPX     T_STRT  ; Compare it with START address
0360 edc3 27 c9                      BEQ     STARTB  ; Effecively `JMP START`
0361 edc5 a6 00                      LDAA    0,X     ; Get data
0362 edc7 09                         DEX             ; Subract 1 from X
0363 edc8 ff f0 f1                   STX     T_STOP  ; Store it
0364 edcb fe f0 ea                   LDX     T_NEW   ; Load NEW loc address into X
0365 edce a7 00                      STAA    0,X     ; Store the data as NEW address
0366 edd0 09                         DEX             ; Point X to next `new` address
0367 edd1 ff f0 ea                   STX     T_NEW   ; Store it
0368 edd4 20 e7                      BRA     DO_DOWN ; Loop back for next byte
0369                         
0370                         ; -----------------------------------------------------
0371 edd6 ce f0 e6           SUB     LDX     #T_X    ; Point X to start of T_X data
0372 edd9 a6 01                      LDAA    1,X     ; A = T_X (low)
0373 eddb e6 00                      LDAB    0,X     ; B = T_X (high)
0374 eddd a0 03                      SUBA    3,X     ; A = A - T_Y (low)
0375 eddf e2 02                      SBCB    2,X     ; B = B - T_Y (high)
0376 ede1 39                         RTS             ; RETURN
0377                         
0378 ede2                            RMB 81          ; previously X and Z commands
0379                         
0380                         ; -----------------------------------------------------
0381                         ;FE33
0382 ee33 bd ec 76           PRP     JSR     STRING  ; Print string...
0383 ee36 20 50 20                   FCC     " P "   ;
0384 ee39 ff                         FCB     $FF     ; End-of-string
0385 ee3a 39                         RTS             ; RETURN
0386                         
0387                         ; -----------------------------------------------------
0388 ee3b bd ec 76           PRD     JSR     STRING  ; Print string...
0389 ee3e 20 44 20                   FCC     " D "   ;
0390 ee41 ff                         FCB     $FF     ; End-of-string
0391 ee42 39                         RTS             ; RETURN
0392                         
0393                         ; -----------------------------------------------------
0394 ee43 bd ec 65           MODIFY  JSR     RD_X    ; Get address to X
0395 ee46 bd ed 4d           STRT    JSR     PRSP    ; Print a space
0396 ee49 7f f0 f5                   CLR     T_R     ; T_R = 0
0397 ee4c a6 00              PRz     LDAA    0,X     ; Get byte pointed to by X to A
0398 ee4e bd ec c9                   JSR     ZOUT    ; Print it as 2.hex digits
0399 ee51 bd ec 00           WATSIT  JSR     RD_CMD  ; Get command character
0400 ee54 81 20              WHAT    CMPA    #$20    ; Is it a space ?
0401 ee56 26 0c                      BNE     ISSLSH  ; No: go test for slash
0402 ee58 08                 CARYON  INX             ; Increment X
0403 ee59 b6 f0 f5                   LDAA    T_R     ; A = T_R
0404 ee5c 81 16                      CMPA    #$16    ; At end of line ?
0405 ee5e 2f ec                      BLE     PRz     ; No: Loop back to continue
0406 ee60 8d 35              NEW_1   BSR     NEWLINE ; Print c/r l/f nul
0407 ee62 20 e2                      BRA     STRT    ; Loop back (Note: Hex was wrong in doc, E2 instead of E5)
0408                         
0409 ee64 81 2f              ISSLSH  CMPA    #'/     ; Is it a slash ?
0410 ee66 26 03                      BNE     ISCRET  ; No: go test for c/r
0411 ee68 09                         DEX             ; X = X - 1
0412 ee69 20 f5                      BRA     NEW_1   ; Loop back (print newline)
0413                         
0414 ee6b 81 0d              ISCRET  CMPA    #$0D    ; Is it a c/r ?
0415 ee6d 26 03                      BNE     ISHEX   ; No: go test for valid Hex
0416 ee6f 08                         INX             ; X = X + 1
0417 ee70 20 ee                      BRA     NEW_1   ; Loop back (print newline)
0418                         
0419 ee72 bd ec 1d           ISHEX   JSR     VHEX    ; Is it a valid hex character ?
0420 ee75 25 19                      BCS     PRQM    ; No: print `?` and ignore
0421 ee77 b7 f0 f6                   STAA    T_Q     ; T_Q = A : Save it
0422 ee7a bd ec 00                   JSR     RD_CMD  ; Get 2nd character
0423 ee7d bd ec 1d                   JSR     VHEX    ; Is it a valid hex character ?
0424 ee80 25 d2                      BCS     WHAT    ; No: then see what it is
0425 ee82 16                         TAB             ; B = A
0426 ee83 b6 f0 f6                   LDAA    T_Q     ; A = T_Q
0427 ee86 bd ec 31                   JSR     BINARY  ; Convert to binary value
0428 ee89 a7 00                      STAA    0,X     ; Store it
0429 ee8b bd ed 4d                   JSR     PRSP    ; Print a space
0430 ee8e 20 c8                      BRA     CARYON  ; Loop back
0431                         
0432 ee90 86 3f              PRQM    LDAA    #'?     ; Put `?` into A
0433 ee92 bd ec 0f                   JSR     PR_A    ; Print it
0434 ee95 20 ba                      BRA     WATSIT  ; Loop back
0435                         
0436 ee97 ff f0 e3           NEWLINE STX     T_SAVE  ; Save X
0437 ee9a bd ec 76                   JSR     STRING  ; Print string...
0438 ee9d 0d 0a 00                   FCB     $0D,$0A,$00
0439 eea0 ff                         FCB     $FF     ; End-of-string
0440 eea1 fe f0 e3                   LDX     T_SAVE  ; Restore X
0441 eea4 bd ec bb                   JSR     PRX     ; Print X
0442 eea7 39                         RTS             ; RETURN
0443                         
0444                         
0445 eea8                            RMB 23          ; previously the ALTER command
0446                         
0447                         ;FEC2
0448 eebf bd ec 65           GO      JSR     RD_X    ; Get address to X (16.bit)
0449 eec2 bd ec 00                   JSR     RD_CMD  ; Right address ?
0450 eec5 b6 f0 f4                   LDAA    T_Z+1   ; T_Z.low to A
0451 eec8 f6 f0 f3                   LDAB    T_Z     ; T_Z.high to B
0452 eecb fe f0 fd           GOTO    LDX     PSTACK  ; Callers stack address to X
0453 eece a7 07                      STAA    7,X     ; Put new return
0454 eed0 e7 06                      STAB    6,X     ; address on stack
0455 eed2 be f0 fd                   LDS     PSTACK  ; Set up calling programs stack
0456 eed5 3b                         RTI             ; RETURN-FROM-INTERRUPT (SWI)
0457                         
0458 eed6 bd ec 00           CONTNU  JSR     RD_CMD  ; Read a byte (test for `.`)
0459 eed9 81 31                      CMPA    #'1     ; Is it `1` ?
0460 eedb 26 10                      BNE     IsIt2  ; No: go test for `2`
0461 eedd fe f0 f7                   LDX     T_ABYT  ; Get address of break.point
0462 eee0 b6 f0 fb                   LDAA    T_BYTE  ; Get saved opcode
0463 eee3 a7 00                      STAA    0,X     ; Put it back in the program
0464 eee5 b6 f0 f8                   LDAA    T_ABYT+1 ; Get address at which
0465 eee8 f6 f0 f7                   LDAB    T_ABYT  ;   to re-enter program
0466 eeeb 20 de                      BRA     GOTO    ; Go to calling program
0467                         
0468 eeed 81 32              IsIt2   CMPA    #'2     ; Is it `2`
0469 eeef 27 03                      BEQ     G_Is2   ; Yes: go process it
0470 eef1 7e ef 8c                   JMP     START   ; No: Return to MINIMON
0471 eef4 fe f0 f9           G_Is2   LDX     T_ABYT+2 ; Get addr. of break.point 2
0472 eef7 b6 f0 fc                   LDAA    T_BYTE+1 ; Get old opcode
0473 eefa a7 00                      STAA    0,X      ; Put it back
0474 eefc b6 f0 fa                   LDAA    T_ABYT+3 ; Load address to start
0475 eeff f6 f0 f9                   LDAB    T_ABYT+2 ;  running program at
0476 ef02 20 c7                      BRA     GOTO    ; Run user program
0477                         
0478                         ; -----------------------------------------------------
0479 ef04 bd ec 89           DUMP    JSR     GETADD  ; Prompt for boundary addresses
0480 ef07 fe f0 ef                   LDX     T_STRT  ;
0481 ef0a bd ee 97           D_NEW   JSR     NEWLINE ; Print c/r l/f nul
0482 ef0d 86 08                      LDAA    #$08    ;
0483 ef0f b7 f0 f6                   STAA    T_Q     ; T_Q = 8
0484 ef12 09                         DEX             ; X = X - 1
0485 ef13 08                 D_NXT   INX             ; X = X + 1
0486 ef14 bd ed 4d                   JSR     PRSP    ; Print a space
0487 ef17 a6 00                      LDAA    0,X     ; Get a byte
0488 ef19 bd ec c9                   JSR     ZOUT    ; Print it as 2.hex digits
0489 ef1c bc f0 f1                   CPX     T_STOP  ; Finished ?
0490 ef1f 26 06                      BNE     D_CNT   ; No: Carry on
0491 ef21 b6 f4 00           D_END   LDAA    DATAA   ; Get a byte from ACIA (clear)
0492 ef24 7e ef 8c                   JMP     START   ; Return to MINIMON
0493 ef27 b6 f4 01           D_CNT   LDAA    CTRLA   ; Read ACIA status
0494 ef2a 85 01                      BITA    #$01    ; Stop dump ?
0495 ef2c 26 f3                      BNE     D_END   ; Yes; go clear ACIA etc
0496 ef2e 7a f0 f6                   DEC     T_Q     ; New line needed ?
0497 ef31 26 e0                      BNE     D_NXT   ; No: Loop back
0498 ef33 08                         INX             ; Print next byte
0499 ef34 20 d4                      BRA     D_NEW   ;  on a new line
0500                         
