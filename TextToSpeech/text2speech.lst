   0205 7C 1A 1A      [ 6]  150         INC     IDLE_COUNT      ; increase the idle count
   0208 B6 1A 1A      [ 4]  151         LDAA    IDLE_COUNT      ; see if idle count = max idle time
   020B 81 2D         [ 2]  152         CMPA    #IDLE_TICS      ; a data message appears every second
   020D 27 03         [ 4]  153         BEQ     IDLE1           ; not reached the max idle time
   020F 7E 01 66      [ 3]  154         JMP     MAINLOOP             ; nothing to do yet
                            155 
   0212 7F 1A 1A      [ 6]  156 IDLE1:   CLR     IDLE_COUNT      ; time to output an idle message so reset the count
   0215 B6 1A 1B      [ 4]  157         LDAA    IDLE_MSG_ID     ; get next Message ID
   0218 81 19         [ 2]  158         CMPA    #IDLE_MSG_CNT   ; are we beyond the end of the list
   021A 26 04         [ 4]  159         BNE     IDLE_OP         ; still at valid id so output idle message
   021C 7F 1A 1B      [ 6]  160         CLR     IDLE_MSG_ID     ; beyond last message so reset the current msg to zero
   021F 4F            [ 2]  161         CLRA                    ; set currentid back to 0
   0220                     162 IDLE_OP:
   0220 7C 1A 1B      [ 6]  163         INC     IDLE_MSG_ID     ; set to next message for the next next time
   0223 CE 12 2C      [ 3]  164         LDX     #IDLEPTR        ; A has phrase ID, set X to the base address
   0226 BD 02 9C      [ 9]  165         JSR     PHRASE_OUT
   0229 7E 01 66      [ 3]  166         JMP     MAINLOOP
