0615                         ; FF07
0616                         ; -----------------------------------------------------
0617 ff07 bd fc 89           DUMP    JSR     GETADD      ; Prompt for boundary addresses
0618 ff0a fe f0 ef                   LDX     T_STRT
0619 ff0d bd fe 97           D_NEW   JSR     NEWLINE     ; Print c/r l/f nul
0620 ff10 86 08                      LDAA    #$08
0621 ff12 b7 f0 f6                   STAA    T_Q         ; T_Q = 8
0622 ff15 09                         DEX                 ; X = X - 1
0623 ff16 08                 D_NXT   INX                 ; X = X + 1
0624 ff17 bd fd 4d                   JSR     PRSP        ; Print a space
0625 ff1a a6 00                      LDAA    0,X         ; Get a byte
0626 ff1c bd fc c9                   JSR     ZOUT        ; Print it as 2.hex digits
0627 ff1f bc f0 f1                   CPX     T_STOP      ; Finished ?
0628 ff22 26 06                      BNE     D_CNT       ; No: Carry on
0629 ff24 b6 f4 00           D_END   LDAA    DATAA       ; Get a byte from ACIA (clear)
0630 ff27 7e ff 8f                   JMP     START       ; Return to MINIMON
0631 ff2a b6 f4 01           D_CNT   LDAA    CTRLA       ; Read ACIA status
0632 ff2d 85 01                      BITA    #$01        ; Stop dump ?
0633 ff2f 26 f3                      BNE     D_END       ; Yes; go clear ACIA etc
0634 ff31 7a f0 f6                   DEC     T_Q         ; New line needed ?
0635 ff34 26 e0                      BNE     D_NXT       ; No: Loop back
0636 ff36 08                         INX                 ; Print next byte
0637 ff37 20 d4                      BRA     D_NEW       ;  on a new line
0638                         
