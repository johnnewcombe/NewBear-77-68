                            301 ; get address of message in X from the pointer in X
   0360 A6 00         [ 5]  302         LDAA    0,X             ;  get high byte of word pointed to by X
   0362 E6 01         [ 5]  303         LDAB    1,X             ;  get low byte of word pointed to by X
   0364 B7 00 0D      [ 5]  304         STAA    TEMP
   0367 F7 00 0E      [ 5]  305         STAB    TEMP+1
