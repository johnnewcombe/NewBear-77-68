                            284 ; get address of message in X from the pointer in X
   03D8 A6 00         [ 5]  285         LDAA    0,X             ;  get high byte of word pointed to by X
   03DA E6 01         [ 5]  286         LDAB    1,X             ;  get low byte of word pointed to by X
   03DC B7 00 0D      [ 5]  287         STAA    TEMP
   03DF F7 00 0E      [ 5]  288         STAB    TEMP+1
   03E2 FE 00 0D      [ 5]  289         LDX     TEMP
   03E5 BD 04 F7      [ 9]  290         JSR     PR_PHRASE       ; output idle message
