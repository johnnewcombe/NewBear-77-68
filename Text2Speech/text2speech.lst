                              5                 .area   CODE1 (ABS)     ; absolute i.e. not relocatable
                              6 
   0200                       7                 .org    0x0200
                              8 
                     01FF     9 STACK           .equ    0x01FF
                     F400    10 DATAA           .equ    0xF400          ; ACIA(a) Data register
                     F401    11 CTRLA           .equ    0xF401          ; ACIA(a) Ctrl/Status
                     F402    12 DATAB           .equ    0xF402          ; ACIA(b) Data register
                     F403    13 CTRLB           .equ    0xF403          ; ACIA(b) Ctrl/Status
                             14 
                             15 ; MINIMON routines
                     FC76    16 STRING          .equ    0xFC76          ; Prints a string.
                     FC89    17 GETADD          .equ    0xFC89          ; Get Address, read 4 digit hex value.
                     FCC9    18 ZOUT            .equ    0xFCC9          ; Print value in A as 2 hex digits.
                     FE97    19 NEWLINE         .equ    0xFE97          ; Prints a new line.
                     FF8F    20 START           .equ    0xFF8F          ; Restarts MniMon.
                     FC0F    21 PR_A            .equ    0xFC0F          ; Print char in A to ACIA (a)
                     FD2B    22 RD_A            .equ    0xFD2B          ; Read char from A
                     FD4D    23 PRSP            .equ    0xFD4D          ; Print a space
                     FC31    24 BINARY          .equ    0xFC31          ; Converts ASCII hex digits in A and B to binary?
                     FC65    25 RD_X            .equ    0xFC65          ; Read 4 hex digits Value from ACIA(a) and put value into X.
                     FC1D    26 VHEX            .equ    0xFC1D          ; Checks that A contains a HEX character
                     FCBB    27 PRX             .equ    0xFCBB          ; print val in X as four hex digits
                             28 
                     F0FF    29 PANEL           .equ    0xF0FF          ; LEDs and switches
                     0B00    30 DELAY_VAL       .EQU    0x0B00          ; Delay loop count - adjust to taste (16 BIT VALUE)
                             31 
                     002D    32 IDLE_TICS       .equ   45              ; ticks between idle messages (1 tic = 2 secs approx)
                     000F    33 SHEAVY_WGHT     .equ    15              ; >= 15 stones
                     000D    34 HEAVY_WGHT      .equ    13              ; >= 13 stones
                     000A    35 NORM_WGHT       .equ    10              ; >= 10 stones
                     0006    36 LIGHT_WGHT      .equ    6               ; >= 6 stones
                     0014    37 TOO_HEAVY       .equ    20
                             38 
                             39 ; number of messages
                     000D    40 GREET_MSG_CNT   .equ    13
                     000A    41 LIGHT_MSG_CNT   .equ    10
                     0015    42 NORM_MSG_CNT    .equ    21
                     0012    43 HEAVY_MSG_CNT   .equ    18
                     000A    44 SHEAVY_MSG_CNT  .equ    10
                     0019    45 IDLE_MSG_CNT    .equ    25
