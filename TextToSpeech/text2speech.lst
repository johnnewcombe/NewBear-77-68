ASxxxx Assembler V05.50.5  (Motorola 6800/6802/6808)                   Page 58
Hexadecimal [16-Bits]                                 Wed May  6 15:47:33 2026



                            494 
                            495 ; -----------------------------------------------
                            496 ; LED Pattern Display - MC6800
                            497 ; -----------------------------------------------
   19C8                     498 PANEL_DISP:
                            499 
                            500 ; --- Main loop ---
   19C8 7A 1A 06      [ 6]  501 PSTART: DEC     SYLLABLES
   19CB 27 1E         [ 4]  502         BEQ     PDONE       ; nearest RTS
   19CD CE 19 EC      [ 3]  503         LDX     #PTABLE     ; Point X at start of table
   19D0 A6 00         [ 5]  504 NXTVAL: LDAA    ,X          ; Load pattern value from table
   19D2 B7 F0 FF      [ 5]  505         STAA    PANEL       ; Send to LED port
   19D5 8D 08         [ 8]  506         BSR     DELAY       ; Delay so we can see it
   19D7 08            [ 4]  507         INX                 ; Advance to next entry
   19D8 8C 19 F5      [ 3]  508         CPX     #PTEND      ; Reached end of table?
   19DB 26 F3         [ 4]  509         BNE     NXTVAL      ; No - go again
   19DD 20 E9         [ 4]  510         BRA     PSTART      ; Yes - loop back to beginning
                            511 
                            512 ; --- Delay routine ---
                            513 ; Kills time so the eye can see each LED pattern
   19DF FF 1A 00      [ 6]  514 DELAY:  STX     T_TMP
   19E2 CE 00 FF      [ 3]  515         LDX     #DELAY_VAL  ; Load delay count
   19E5 09            [ 4]  516 DLOOP:  DEX                 ; Decrement
   19E6 26 FD         [ 4]  517         BNE     DLOOP       ; Not zero - keep counting
   19E8 FE 1A 00      [ 5]  518         LDX     T_TMP
   19EB 39            [ 5]  519 PDONE:  RTS                 ; Done
                            520 
                            521 ; --- Pattern table ---
   19EC FF                  522 PTABLE: .FCB     0xFF         ; 1111 1111
   19ED E7                  523         .FCB     0xE7         ; 1110 0111
   19EE C3                  524         .FCB     0xC3         ; 1100 0011
   19EF 81                  525         .FCB     0x81         ; 1000 0001
   19F0 00                  526         .FCB     0x00         ; 0000 0000
   19F1 81                  527         .FCB     0x81         ; 1000 0001
   19F2 C3                  528         .FCB     0xC3         ; 1100 0011
   19F3 E7                  529         .FCB     0xE7         ; 1110 0111
   19F4 FF                  530         .FCB     0xFF         ; 1111 1111
   19F5                     531 PTEND:                        ; Address just past end of table
                            532 
                            533 
                            534 ; -----------------------------------------------------
                            535 ; Reserved memory
                            536 ; -----------------------------------------------------
                            537 
   19F5                     538 T_Q:             .rmb     1       ; Temp storage for ZIN
   19F6                     539 T_Z:             .rmb     2       ;   "     "     "  RDX
   19F8                     540 T_X:             .rmb     2       ;   "     "     "  PR_WORD
   19FA                     541 T_Y:             .rmb     2       ;   "     "     "  table pointer
   19FC                     542 T_P:             .rmb     2       ;   "     "     "  PR_PHRASE
   19FE                     543 T_W:             .rmb     2       ;   "     "     "  PR_WEIGHT
   1A00                     544 T_TMP:           .rmb     2       ;   "     "     "  within subroutine
   1A02                     545 DEC:             .rmb     3       ; for decimal value
   1A05                     546 RND:             .rmb     1       ; holds a random number (see RD_B
   1A06                     547 SYLLABLES:       .rmb     1       ; number of phrase syllables for the panel LED routines
   1A07                     548 TEMP:            .rmb     2       ; temp var (non subroutine use)
