ASxxxx Assembler V05.50.5  (Motorola 6800/6802/6808)                   Page 58
Hexadecimal [16-Bits]                                 Thu May  7 22:06:22 2026



                            501 
                            502 ; -----------------------------------------------
                            503 ; LED Pattern Display - MC6800
                            504 ; -----------------------------------------------
   19D8                     505 PANEL_DISP:
                            506 
                            507 ; --- Main loop ---
   19D8 CE 19 FC      [ 3]  508 PSTART: LDX     #PTABLE     ; Point X at start of table
   19DB A6 00         [ 5]  509 NXTVAL: LDAA    ,X          ; Load pattern value from table
   19DD B7 F0 FF      [ 5]  510         STAA    PANEL       ; Send to LED port
                            511         ;JSR     ZOUT        ; X not affected
   19E0 8D 0D         [ 8]  512         BSR     DELAY       ; Delay so we can see it
   19E2 08            [ 4]  513         INX                 ; Advance to next entry
   19E3 8C 1A 05      [ 3]  514         CPX     #PTEND      ; Reached end of table?
   19E6 26 F3         [ 4]  515         BNE     NXTVAL      ; No - go again
   19E8 7A 1A 22      [ 6]  516         DEC     SYLLABLES   ; decrement the syllables to mimic
   19EB 27 0E         [ 4]  517         BEQ     PDONE       ; nearest RTS
   19ED 20 E9         [ 4]  518         BRA     PSTART      ; Yes - loop back to beginning
                            519 
                            520 ; --- Delay routine ---
                            521 ; Kills time so the eye can see each LED pattern
   19EF FF 1A 10      [ 6]  522 DELAY:  STX     T_TMP
   19F2 CE 00 FF      [ 3]  523         LDX     #DELAY_VAL  ; Load delay count
   19F5 09            [ 4]  524 DLOOP:  DEX                 ; Decrement
   19F6 26 FD         [ 4]  525         BNE     DLOOP       ; Not zero - keep counting
   19F8 FE 1A 10      [ 5]  526         LDX     T_TMP
   19FB 39            [ 5]  527 PDONE:  RTS                 ; Done
                            528 
                            529 ; --- Pattern table ---
   19FC FF                  530 PTABLE: .FCB     0xFF         ; 1111 1111
   19FD E7                  531         .FCB     0xE7         ; 1110 0111
   19FE C3                  532         .FCB     0xC3         ; 1100 0011
   19FF 81                  533         .FCB     0x81         ; 1000 0001
   1A00 00                  534         .FCB     0x00         ; 0000 0000
   1A01 81                  535         .FCB     0x81         ; 1000 0001
   1A02 C3                  536         .FCB     0xC3         ; 1100 0011
   1A03 E7                  537         .FCB     0xE7         ; 1110 0111
   1A04 FF                  538         .FCB     0xFF         ; 1111 1111
   1A05                     539 PTEND:                        ; Address just past end of table
                            540 
                            541 
                            542 ; -----------------------------------------------------
                            543 ; Reserved memory
                            544 ; -----------------------------------------------------
                            545 
   1A05                     546 T_Q:             .rmb     1       ; Temp storage for ZIN
   1A06                     547 T_Z:             .rmb     2       ;   "     "     "  RDX
   1A08                     548 T_X:             .rmb     2       ;   "     "     "  PR_WORD
   1A0A                     549 T_Y:             .rmb     2       ;   "     "     "  table pointer
   1A0C                     550 T_P:             .rmb     2       ;   "     "     "  PR_PHRASE
   1A0E                     551 T_W:             .rmb     2       ;   "     "     "  PR_WEIGHT
   1A10                     552 T_TMP:           .rmb     2       ;   "     "     "  within subroutine
   1A12                     553 DEC:             .rmb     3       ; for decimal value
   1A15                     554 RND:             .rmb     1       ; holds a random number (see RD_B
   1A16                     555 TEMP:            .rmb     2       ; temp var (non subroutine use)
ASxxxx Assembler V05.50.5  (Motorola 6800/6802/6808)                   Page 59
Hexadecimal [16-Bits]                                 Thu May  7 22:06:22 2026



   1A18                     556 T_WEIGHT:        .rmb     2       ; holds value of weight following a call to GETDATA
   1A1A                     557 IDLE_COUNT:      .rmb     1       ; counts the number of empty measurement reports
   1A1B                     558 IDLE_MSG_ID:     .rmb     1       ; holds value of next idle message to use
   1A1C                     559 GREET_MSG_ID:    .rmb     1       ; holds value of next greeting message to use
   1A1D                     560 LIGHT_MSG_ID:    .rmb     1       ; holds value of next light weight message to use
   1A1E                     561 NORMAL_MSG_ID:   .rmb     1       ; holds value of next normal weight message to use
   1A1F                     562 HEAVY_MSG_ID:    .rmb     1       ; holds value of next heavy weight message to use
   1A20                     563 SHEAVY_MSG_ID:   .rmb     1       ; holds value of next super heavy weight message to use
   1A21                     564 PROCESSING_FLG:  .rmb     1       ; non-zero indicates that that a weight is being processed
                            565                                   ;   all following weight data is ignored until the next
                            566                                   ;   idle (0000h) data resets it.
   1A22                     567 SYLLABLES:       .rmb     1       ; number of phrase syllables for the panel LED routines
                            568                                   ;  this is updated each time a word is transmitted and
                            569                                   ;  when PANELDISP is called, usually after acall to PR_PHRASE
                            570                                   ;  the lights are manipulated.
