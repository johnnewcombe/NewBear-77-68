0102                         ; NEED TO CYCLE AROUND IDLE MESSAGES
0103                         
0104 02a1 7c 07 9d           IDLE    INC     IDLE_COUNT      ; increase the idle count
0105 02a4 b6 07 9d                   LDAA    IDLE_COUNT      ; see if idle count = max idle time
0106 02a7 81 5a                      CMPA    #IDLE_SECS      ; a data message appears every second
0107 02a9 27 03                      BEQ     IDLE1           ; not reached the max idle time
0108 02ab 7e 03 36                   JMP     END
0109 02ae 7f 07 9d           IDLE1   CLR     IDLE_COUNT      ; time to output an idle message so reset the count
0110                         
0111                                 ; output the idle message
0112 02b1 7c 07 9e                   INC     IDLE_MSG_ID     ; get next idle message
0113 02b4 b6 07 9e                   LDAA    IDLE_MSG_ID
0114 02b7 81 01                      CMPA    #IDLE_MSG_CNT   ; are we beyond the end of the list
0115 02b9 26 05                      BNE     IDLE_OP         ; still at valid id so output idle message
0116 02bb 86 00                      LDAA    #0              ; beyond last message so reset the current msg to zero
0117 02bd b7 07 9e                   STAA    IDLE_MSG_ID
0118                         
0119                         IDLE_OP
0120                                 ; TODO consider the offset depending upon where the idle phrases are within the phrase pointer table
0121 02c0 7e 03 2d                   JMP     PHRASE_OUT
0122                         
