0568 ff59 a6 00                      LDAA    0,X     ; Get opcode
0569 ff5b b7 f0 fc                   STAA    T_BYTE+1 ; Save it
0570 ff5e ff f0 f9                   STX     T_ABYT+2 ; Save address
0571 ff61 20 e8                      BRA     SAME    ; Set the breakpoint
