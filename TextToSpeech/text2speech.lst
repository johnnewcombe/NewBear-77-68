                            227 ; get address of message in X from the pointer in X
   02AA A6 00         [ 5]  228         LDAA    0,X             ;  get high byte of word pointed to by X
   02AC E6 01         [ 5]  229         LDAB    1,X             ;  get low byte of word pointed to by X
   02AE B7 1A 07      [ 5]  230         STAA    TEMP
   02B1 F7 1A 08      [ 5]  231         STAB    TEMP+1
   02B4 FE 1A 07      [ 5]  232         LDX     TEMP
