   0189 CE 1B 31      [ 3]   98                 LDX     #MYOUWEIGH
   018C BD 04 0D      [ 9]   99                 JSR     PR_PHRASE
   018F FE 1B 50      [ 5]  100                 LDX     T_WEIGHT        ; restore X
   0192 BD 03 AD      [ 9]  101                 JSR     PR_WEIGHT       ; weight back X so output the weight
                            102 
