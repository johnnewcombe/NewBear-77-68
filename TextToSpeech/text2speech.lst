0380                         PR_PHRASE
0381 041e 4c                         INCA
0382 041f ce 11 eb                   LDX     #PHRASEPTR  ; load address of phrase ponter
0383                                                     ; table
0384 0422 4a                 PR_PH1  DECA                ; loop through A times to get
0385 0423 27 04                      BEQ     FOUNDP      ;   address of phrase
0386 0425 08                         INX                 ; move to next address
0387 0426 08                         INX
0388 0427 20 f9                      BRA     PR_PH1      ; try again
0389                         
0390 0429 a6 00              FOUNDP  LDAA    0,X         ; transfer addr pointed to by X to memory
0391 042b b7 19 63                   STAA    T_P         ; MSB
0392 042e a6 01                      LDAA    1,X         ;
0393 0430 b7 19 64                   STAA    T_P+1       ; LSB
0394 0433 fe 19 63           PR_PH3  LDX     T_P         ; load X
0395 0436 a6 00                      LDAA    0,X         ; get word id
0396 0438 08                         INX                 ; point X to next word
0397 0439 ff 19 63                   STX     T_P         ; store X away
0398 043c 81 00                      CMPA    #0
0399 043e 27 08                      BEQ     PR_PH2      ; no more words
0400 0440 bd 04 49                   JSR     PR_WORD     ; print word based on value in A
