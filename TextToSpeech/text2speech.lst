0197                         ;--------------------------------------------------------------
0198                         ; Gets the weight data from the scales and rerurns with carry
0199                         ; set if a valid reading, carry clear otherwise. A valid weight
0200                         ; reading resets the idle count. Data received is stored in
0201                         ; T_WEIGHT and MSB in A.
0202                         ;--------------------------------------------------------------
0203                         GETDATA
0204 0339 bd 03 c3                   JSR     RD_XB           ; read 4 hex characters into X
0205 033c ff 17 f9                   STX     T_WEIGHT        ; store X
0206 033f 0c                         CLC
0207 0340 b6 17 f9                   LDAA    T_WEIGHT        ; get fist byte (stones)
0208 0343 27 04                      BEQ     GDDONE          ; idle message
0209 0345 7f 00 5a                   CLR     IDLE_SECS       ; not an idle message so reset the idle counter
0210 0348 0d                         SEC                     ; non idle message return with carry set
0211 0349 39                 GDDONE  RTS
0212                         
0213                         ;--------------------------------------------------------------
0214                         ; DECIMAL CONVERSION EXAMPLE
0215                         ;--------------------------------------------------------------
0216                                 ;JSR     PR_DEC          ; puts 3 decimal digits in DEC, DEC+1 and DEC+2
0217                                 ;LDAA    DEC+1           ; don't care about the hundreds        ADDA    #$30
0218                                 ;JSR     PR_WORD
0219                                 ;JSR     PR_SPCB
0220                                 ;LDAA    DEC+2
0221                                 ;JSR     PR_WORD
0222                         
0223                         ; -----------------------------------------------------
0224                         ; PR_DEC: Puts 3 decimal digits in DEC, DEC+1 and DEC+2
0225                         ;
0226                         ;       !! ONLY WORKS WITH VALUES BELOW 128 !!
0227                         ; -----------------------------------------------------
0228 034a 5f                 PR_DEC  CLRB            ; Clear B for hundreds
0229                         
0230 034b 81 64              HUND    CMPA    #100    ; 100 or more?
0231                         
0232 034d 2d 05                      BLT     TENS
0233 034f 80 64                      SUBA    #100    ; Sub 100
0234 0351 5c                         INCB            ; Increment hundred counter
0235 0352 20 f7                      BRA     HUND
0236                         
0237 0354 f7 17 f3           TENS    STAB    DEC     ; store the hundreds
0238                         
0239 0357 5f                         CLRB
0240 0358 81 0a              TENS1   CMPA    #10     ; 10 or more?
0241 035a 2d 05                      BLT     UNITS
0242 035c 80 0a                      SUBA    #10     ; Sub 10
0243 035e 5c                         INCB            ; Increment ten counter
0244 035f 20 f7                      BRA     TENS1
0245                         
0246 0361 f7 17 f4           UNITS   STAB    DEC+1
0247 0364 b7 17 f5                   STAA    DEC+2   ; Final remainder is units
0248                         
0249 0367 39                         RTS
0250                         
0251                         
0252                         ; -----------------------------------------------------
0253                         ; Print string FOLLOWING JSR ( terminated by $FF ) to
0254                         ; ACIA(b) and ACIA(b)
0255                         ; -----------------------------------------------------
0256 0368 30                 STRINGB TSX             ; Get loc. of return addr to X
0257 0369 ee 00                      LDX     0,X     ; Get return addr to X
0258 036b 09                         DEX             ; Point to byte before
0259 036c 08                 STRB1   INX             ; Point to next byte
0260 036d a6 00                      LDAA    0,X     ; Get byte to be printed
0261 036f 81 ff                      CMPA    #$FF    ; End-string ?
0262 0371 27 07                      BEQ     ENDSTR  ; Yes: Go to finish up
0263 0373 bd fc 0f                   JSR     PR_A    ; Print the byte to ACIA(a) (A is maintained)
0264 0376 8d 40                      BSR     PR_B    ; Print the byte to ACIA(b)
0265 0378 20 f2                      BRA     STRB1   ; Go back for next byte
0266 037a 31                 ENDSTR  INS             ; Clean up stack...
0267 037b 31                         INS             ;  ( pop off the return addr )
0268 037c 6e 01                      JMP     1,X     ; Jump back to caller (RETURN)
0269                         
0270                         ; -----------------------------------------------------
0271                         ; Prints a string pointed to by X
0272                         ; -----------------------------------------------------
0273 037e a6 00              STRINGBX    LDAA    0,X         ; get char
0274 0380 81 ff                          CMPA    #$FF        ; is character NULL?
0275 0382 27 08                          BEQ     DONEB       ; yes, end of string
0276 0384 bd fc 0f                       JSR     PR_A        ; Print the byte to ACIA(a) (A is maintained)
0277 0387 8d 2f                          BSR     PR_B        ; Print the byte to ACIA(b)
0278 0389 08                             INX
0279 038a 20 f2                          BRA     STRINGBX
0280 038c 39                 DONEB       RTS
0281                         
0282                         ; -----------------------------------------------------
0283                         ; Reads a character from ACIA(b) into A
0284                         ; -----------------------------------------------------
0285 038d 7c 17 f6           RD_B    INC     RND         ; simple way to get a random number
0286 0390 b6 f4 03                   LDAA    CTRLB       ; Get ACIA.A status byte
0287 0393 85 01                      BITA    #01         ; Is byte ready in DATAb
0288 0395 27 f6                      BEQ     RD_B        ; No: Try again
0289 0397 b6 f4 02                   LDAA    DATAB       ; Get the data byte to A
0290 039a 84 7f                      ANDA    #$7F        ; Mask off parity bit if it exists
0291 039c 39                         RTS                 ; RETURN
0292                         
0293                         ; -----------------------------------------------------
0294                         ;
0295                         ; -----------------------------------------------------
0296 039d 8d ee              ZINB    BSR     RD_B    ; Read a character
0297 039f bd fc 1d                   JSR     VHEX    ; Is it a hex character ?
0298 03a2 25 12                      BCS     Z_PRQM  ; No: go to print `?`
0299 03a4 b7 17 ea                   STAA    T_Q     ; Yes: Save Acc.A
0300 03a7 8d e4                      BSR     RD_B    ; Read 2nd character
0301 03a9 bd fc 1d                   JSR     VHEX    ; Is it a hex character ?
0302 03ac 25 08                      BCS     Z_PRQM  ; No: go to print `?`
0303 03ae 16                         TAB             ; Yes: Put it into Acc.B
0304 03af b6 17 ea                   LDAA    T_Q     ; Retrieve 1st hex char to Acc.A
0305 03b2 bd fc 31                   JSR     BINARY  ; Convert A:B to binary
0306 03b5 39                         RTS             ; RETURN
0307                         Z_PRQM  ;LDAA    #'?     ; Load `?` into A
0308                                 ;BSR     PR_B    ; Print it
0309 03b6 20 e5                      BRA     ZINB    ; Go back to start of hex input
0310                         
0311                         ; -----------------------------------------------------
0312                         ; Print character in A to ACIA(b)
0313                         ; -----------------------------------------------------
0314 03b8 f6 f4 03           PR_B    LDAB    CTRLB   ; Get ACIA(a) status byte
0315 03bb c5 02                      BITB    #02     ; Is it busy ?
0316 03bd 27 f9                      BEQ     PR_B    ; Yes: Try again
0317 03bf b7 f4 02                   STAA    DATAB   ;  No: Send data
0318 03c2 39                 PRB_END RTS             ; RETURN
0319                         
0320                         ; -----------------------------------------------------
0321                         ; Read 4 hex digits and put value into X
0322                         ; -----------------------------------------------------
0323 03c3 8d d8              RD_XB   BSR     ZINB    ; Read 2 digit hex value into A
0324 03c5 b7 17 eb                   STAA    T_Z     ; Save byte (most significant)
0325 03c8 8d d3                      BSR     ZINB    ; Read 2 digit hex value into A
0326 03ca b7 17 ec                   STAA    T_Z+1   ; Save byte (least significant)
0327 03cd fe 17 eb                   LDX     T_Z     ; Load full 4 hex value into X
0328 03d0 39                         RTS             ; RETURN
0329                         
0330                         ; -----------------------------------------------------
0331                         ; Prints the message " n stones n pounds"
0332                         ; place stones in MSB of X and pound in LSB
0333                         ; -----------------------------------------------------
0334                         PR_WEIGHT
0335 03d1 ff 17 f1                   STX     T_W
0336 03d4 b6 17 f1                   LDAA    T_W             ; Load high byte of X into Accumulator A
0337 03d7 bd 04 40                   JSR     PR_WORD         ; n
0338 03da bd 03 f7                   JSR     PR_SPCB
0339 03dd 86 1b                      LDAA    #$1B
0340 03df bd 04 40                   JSR     PR_WORD         ; "stones"
0341 03e2 bd 03 f7                   JSR     PR_SPCB
0342 03e5 b6 17 f2                   LDAA    T_W+1            ; Load high byte of X into Accumulator A
0343 03e8 bd 04 40                   JSR     PR_WORD         ; n
0344 03eb 86 1c                      LDAA    #$1C
0345 03ed bd 03 f7                   JSR     PR_SPCB
0346 03f0 bd 04 40                   JSR     PR_WORD         ; "pounds"
0347 03f3 bd 04 02                   JSR     PR_CRB
0348 03f6 39                         RTS
0349                         
0350                         ; -----------------------------------------------------
0351                         ; Prints a space on both consoles (preserves A)
0352                         ; -----------------------------------------------------
0353 03f7 36                 PR_SPCB   PSHA
0354 03f8 86 20                      LDAA    #$20        ; Put space character in A
0355 03fa bd fc 0f                   JSR     PR_A
0356 03fd bd 03 b8                   JSR     PR_B        ; Print it
0357 0400 32                         PULA
0358 0401 39                         RTS                 ; RETURN
0359                         
0360                         ; -----------------------------------------------------
0361                         ; Prints a CRLF on both consoles (preserves A)
0362                         ; -----------------------------------------------------
0363 0402 36                 PR_CRB  PSHA
0364 0403 86 0d                      LDAA    #$0D        ; Put CHAR character in A
0365 0405 bd fc 0f                   JSR     PR_A
0366 0408 bd 03 b8                   JSR     PR_B        ; Print it
0367 040b 86 0a                      LDAA    #$0A
0368 040d bd fc 0f                   JSR     PR_A
0369 0410 bd 03 b8                   JSR     PR_B        ; Print it
0370 0413 32                         PULA
0371 0414 39                         RTS                 ; RETURN
0372                         
0373                         ; -----------------------------------------------------
0374                         ; Outputs a phrase from the value in A
0375                         ; -----------------------------------------------------
0376                         PR_PHRASE
0377 0415 4c                         INCA
0378 0416 ce 04 5c                   LDX     #PHRASEPTR  ; load address of phrase ponter
0379                                                     ; table
0380 0419 4a                 PR_PH1  DECA                ; loop through A times to get
0381 041a 27 04                      BEQ     FOUNDP      ;   address of phrase
0382 041c 08                         INX                 ; move to next address
0383 041d 08                         INX
0384 041e 20 f9                      BRA     PR_PH1      ; try again
0385                         
0386 0420 a6 00              FOUNDP  LDAA    0,X         ; transfer addr pointed to by X to memory
0387 0422 b7 17 ef                   STAA    T_P         ; MSB
0388 0425 a6 01                      LDAA    1,X         ;
0389 0427 b7 17 f0                   STAA    T_P+1       ; LSB
0390 042a fe 17 ef           PR_PH3  LDX     T_P         ; load X
0391 042d a6 00                      LDAA    0,X         ; get word id
0392 042f 08                         INX                 ; point X to next word
0393 0430 ff 17 ef                   STX     T_P         ; store X away
0394 0433 81 00                      CMPA    #0
0395 0435 27 08                      BEQ     PR_PH2      ; no more words
0396 0437 bd 04 40                   JSR     PR_WORD     ; print word based on value in A
0397 043a bd 03 f7                   JSR     PR_SPCB
0398 043d 20 eb                      BRA     PR_PH3      ; next word
0399 043f 39                 PR_PH2  RTS
0400                         
