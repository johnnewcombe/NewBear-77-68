0425                         ; -----------------------------------------------------
0426                         ; Outputs a word based on value in X
0427                         ; -----------------------------------------------------
0428                         ; The routine loops through all of the word pointers derementing X as it goes
0429                         ; When X = 0, then the pointer to the word has been found.
0430                         PR_WORD
0431 0449 ff 19 61                       STX     T_X             ; use ASL and ROL to multiply by 2 (pointer is 2 bytes wide)
0432 044c 78 19 62                       ASL     T_X+1           ; shift low byte left, bit 7 goes to carry
0433 044f 79 19 61                       ROL     T_X             ; rotate high byte left, carry in from low byte
0434 0452 fe 19 61                       LDX     T_X
0435 0455 ff 19 61                       STX     T_X             ; Stash X
0436 0458 b6 19 61                       LDAA    T_X             ; High byte of X
0437 045b f6 19 62                       LDAB    T_X+1           ; Low byte of X
0438 045e cb 7c                          ADDB    #WORDPTR&255    ; Add low byte of WORDPTR address
0439 0460 89 04                          ADCA    #WORDPTR/256    ; Add high byte of WORDPTR address + carry
0440 0462 b7 19 61                       STAA    T_X             ; T_X has the address of the pointer NOT the word
0441 0465 f7 19 62                       STAB    T_X+1
0442 0468 fe 19 61                       LDX     T_X             ; X has the address of the pointer NOT the word
0443                         
0444 046b a6 00                          LDAA    0,X             ; get the hi byte of the word
0445 046d b7 19 61                       STAA    T_X
0446 0470 a6 01                          LDAA    1,X             ; get the low byte of the word
0447 0472 b7 19 62                       STAA    T_X+1
0448 0475 fe 19 61                       LDX     T_X             ; X now has address of the word
0449 0478 bd 03 87                       JSR     STRINGBX        ; output the word
0450 047b 39                             RTS
0451                         
0452                         ; -----------------------------------------------------
0453                         ; Word pointer table (max words 256)
0454                         ; Set X to the pointer ID and call PR_WORD
0455                         ; -----------------------------------------------------
0456                         ; To create new wordk add the word in the correct
0457                         ; (alphabetical) position in the word table. Then add
0458                         ; a pointer to that word at the END of the Word Pointer
0459                         ; table. Finally add an EQUATE using the word as a label
0460                         ; in the word equates table;
0461                         ; -----------------------------------------------------
0462                         
0463                         WORDPTR
