0445                         ; -----------------------------------------------------
0446                         ; Outputs a word based on value in X
0447                         ; -----------------------------------------------------
0448                         PR_WORD
0449 035e ff 19 38                       STX     T_X             ; use ASL and ROL to multiply by 2 (pointer is 2 bytes wide)
0450 0361 78 19 39                       ASL     T_X+1           ; shift low byte left, bit 7 goes to carry
0451 0364 79 19 38                       ROL     T_X             ; rotate high byte left, carry in from low byte
0452 0367 fe 19 38                       LDX     T_X
0453 036a ff 19 38                       STX     T_X             ; Stash X
0454 036d b6 19 38                       LDAA    T_X             ; High byte of X
0455 0370 f6 19 39                       LDAB    T_X+1           ; Low byte of X
0456 0373 cb 91                          ADDB    #WORDPTR&255    ; Add low byte of WORDPTR address
0457 0375 89 03                          ADCA    #WORDPTR/256    ; Add high byte of WORDPTR address + carry
0458 0377 b7 19 38                       STAA    T_X             ; T_X has the address of the pointer NOT the word
0459 037a f7 19 39                       STAB    T_X+1
0460 037d fe 19 38                       LDX     T_X             ; X has the address of the pointer NOT the word
0461                         
0462 0380 a6 00                          LDAA    0,X             ; get the hi byte of the word
0463 0382 b7 19 38                       STAA    T_X
0464 0385 a6 01                          LDAA    1,X             ; get the low byte of the word
0465 0387 b7 19 39                       STAA    T_X+1
0466 038a fe 19 38                       LDX     T_X             ; X now has address of the word
0467 038d bd 02 8e                       JSR     STRINGBX        ; output the word
0468 0390 39                             RTS
0469                         
0470                         ; -----------------------------------------------------
0471                         ; Word pointer table (max words 256)
0472                         ; Set X to the pointer ID and call PR_WORD
0473                         ; -----------------------------------------------------
0474                         ; To create new wordk add the word in the correct
0475                         ; (alphabetical) position in the word table. Then add
0476                         ; a pointer to that word at the END of the Word Pointer
0477                         ; table. Finally add an EQUATE using the word as a label
0478                         ; in the word equates table;
0479                         ; -----------------------------------------------------
