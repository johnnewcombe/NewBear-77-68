0720 ffdf bd fc 76           STERMS  JSR     STRING
0721 ffe2 0d 0a                      FCB     $0D,$0A
0722 ffe4 53 39 30 33 30 30          FCC     "S9030000FC"
     30 30 46 43
0723 ffee ff                         FCB     $FF
0724 ffef 20 9e                      BRA     START
