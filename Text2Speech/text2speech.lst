                            158 ; Over 20 stone so random heavy phrase to ports B
                            159 ; -----------------------------------------------------
   02BA                     160 OVERLOADED:
   02BA BD FC 76      [ 9]  161                 JSR     STRING
   02BD 53 54 3A 53 4F 46   162                 .fcc    "ST:SOFL "
        4C 20
   02C5 20 FF               163                 .fcb    0x20,0xff
   02C7 CE 1C 0A      [ 3]  164                 LDX     #MTOOHEAVY1
   02CA BD 04 F7      [ 9]  165                 JSR     PR_PHRASE
   02CD BD 04 DD      [ 9]  166                 JSR     PR_CRB
   02D0 7E 02 6B      [ 3]  167                 JMP     MAINLOOP
   02D3                     168 IERROR:
   02D3 BD FC 76      [ 9]  169                 JSR     STRING
   02D6 53 54 3A 49 45 52   170                 .fcc    "ST:IERR "
        52 20
   02DE 20 FF               171                 .fcb    0x20,0xff
   02E0 CE 1C 20      [ 3]  172                 LDX     #MERROR
   02E3 BD 04 F7      [ 9]  173                 JSR     PR_PHRASE
   02E6 BD 04 DD      [ 9]  174                 JSR     PR_CRB
   02E9 7E 02 6B      [ 3]  175                 JMP     MAINLOOP
                            176 
                            177 ; we cycle thought idle message when no one is on the scales, data comes in a one
                            178 ; second intervals so we simply increase the idle count until it's time to display
                            179 ; the next idle message
                            180 
   02EC 7F 00 18      [ 6]  181 IDLE:   CLR     PROCESSING_FLG  ; clear the processing flag as no one
                            182                                 ;   is standing on the scales
   02EF 7C 00 11      [ 6]  183         INC     IDLE_COUNT      ; increase the idle count
   02F2 B6 00 11      [ 4]  184         LDAA    IDLE_COUNT      ; see if idle count = max idle time
   02F5 81 2D         [ 2]  185         CMPA    #IDLE_TICS      ; a data message appears every second
   02F7 27 03         [ 4]  186         BEQ     IDLE1           ; not reached the max idle time
   02F9 7E 02 6B      [ 3]  187         JMP     MAINLOOP             ; nothing to do yet
                            188 
   02FC BD FC 76      [ 9]  189 IDLE1:  JSR     STRING
   02FF 53 54 3A 49 4D 53   190         .fcc    "ST:IMSG "
        47 20
   0307 20 FF               191         .fcb    0x20,0xff
   0309 7F 00 11      [ 6]  192         CLR     IDLE_COUNT      ; time to output an idle message so reset the count
   030C B6 00 12      [ 4]  193         LDAA    IDLE_MSG_ID     ; get next Message ID
   030F 81 19         [ 2]  194         CMPA    #IDLE_MSG_CNT   ; are we beyond the end of the list
   0311 26 04         [ 4]  195         BNE     IDLE_OP         ; still at valid id so output idle message
   0313 7F 00 12      [ 6]  196         CLR     IDLE_MSG_ID     ; beyond last message so reset the current msg to zero
   0316 4F            [ 2]  197         CLRA                    ; set currentid back to 0
   0317                     198 IDLE_OP:
   0317 7C 00 12      [ 6]  199         INC     IDLE_MSG_ID     ; set to next message for the next next time
   031A CE 13 75      [ 3]  200         LDX     #IDLEPTR        ; A has phrase ID, set X to the base address
   031D BD 03 D4      [ 9]  201         JSR     PHRASE_OUT
   0320 7E 02 6B      [ 3]  202         JMP     MAINLOOP
                            203 
   0323                     204 GREET:   ; output the greeting message
   0323 BD FC 76      [ 9]  205         JSR     STRING
   0326 53 54 3A 47 4D 53   206         .fcc    "ST:GMSG "
        47 20
   032E 20 FF               207         .fcb    0x20,0xff
   0330 B6 00 13      [ 4]  208         LDAA    GREET_MSG_ID    ; get next Message ID
