ASxxxx Assembler V05.50.5  (Motorola 6800/6802/6808)                   Page 58
Hexadecimal [16-Bits]                                 Thu May  7 22:05:00 2026



                            506 
                            507 ; -----------------------------------------------
                            508 ; LED Pattern Display - MC6800
                            509 ; -----------------------------------------------
   19DD                     510 PANEL_DISP:
                            511 
                            512 ; --- Main loop ---
   19DD CE 1A 01      [ 3]  513 PSTART: LDX     #PTABLE     ; Point X at start of table
   19E0 A6 00         [ 5]  514 NXTVAL: LDAA    ,X          ; Load pattern value from table
   19E2 B7 F0 FF      [ 5]  515         STAA    PANEL       ; Send to LED port
                            516         ;JSR     ZOUT        ; X not affected
   19E5 8D 0D         [ 8]  517         BSR     DELAY       ; Delay so we can see it
   19E7 08            [ 4]  518         INX                 ; Advance to next entry
   19E8 8C 1A 0A      [ 3]  519         CPX     #PTEND      ; Reached end of table?
   19EB 26 F3         [ 4]  520         BNE     NXTVAL      ; No - go again
   19ED 7A 1A 27      [ 6]  521         DEC     SYLLABLES   ; decrement the syllables to mimic
   19F0 27 0E         [ 4]  522         BEQ     PDONE       ; nearest RTS
   19F2 20 E9         [ 4]  523         BRA     PSTART      ; Yes - loop back to beginning
                            524 
                            525 ; --- Delay routine ---
                            526 ; Kills time so the eye can see each LED pattern
   19F4 FF 1A 15      [ 6]  527 DELAY:  STX     T_TMP
   19F7 CE 00 FF      [ 3]  528         LDX     #DELAY_VAL  ; Load delay count
   19FA 09            [ 4]  529 DLOOP:  DEX                 ; Decrement
   19FB 26 FD         [ 4]  530         BNE     DLOOP       ; Not zero - keep counting
   19FD FE 1A 15      [ 5]  531         LDX     T_TMP
   1A00 39            [ 5]  532 PDONE:  RTS                 ; Done
                            533 
                            534 ; --- Pattern table ---
   1A01 FF                  535 PTABLE: .FCB     0xFF         ; 1111 1111
   1A02 E7                  536         .FCB     0xE7         ; 1110 0111
   1A03 C3                  537         .FCB     0xC3         ; 1100 0011
   1A04 81                  538         .FCB     0x81         ; 1000 0001
   1A05 00                  539         .FCB     0x00         ; 0000 0000
   1A06 81                  540         .FCB     0x81         ; 1000 0001
   1A07 C3                  541         .FCB     0xC3         ; 1100 0011
   1A08 E7                  542         .FCB     0xE7         ; 1110 0111
   1A09 FF                  543         .FCB     0xFF         ; 1111 1111
   1A0A                     544 PTEND:                        ; Address just past end of table
                            545 
                            546 
                            547 ; -----------------------------------------------------
                            548 ; Reserved memory
                            549 ; -----------------------------------------------------
                            550 
   1A0A                     551 T_Q:             .rmb     1       ; Temp storage for ZIN
   1A0B                     552 T_Z:             .rmb     2       ;   "     "     "  RDX
   1A0D                     553 T_X:             .rmb     2       ;   "     "     "  PR_WORD
   1A0F                     554 T_Y:             .rmb     2       ;   "     "     "  table pointer
   1A11                     555 T_P:             .rmb     2       ;   "     "     "  PR_PHRASE
   1A13                     556 T_W:             .rmb     2       ;   "     "     "  PR_WEIGHT
   1A15                     557 T_TMP:           .rmb     2       ;   "     "     "  within subroutine
   1A17                     558 DEC:             .rmb     3       ; for decimal value
   1A1A                     559 RND:             .rmb     1       ; holds a random number (see RD_B
   1A1B                     560 TEMP:            .rmb     2       ; temp var (non subroutine use)
ASxxxx Assembler V05.50.5  (Motorola 6800/6802/6808)                   Page 59
Hexadecimal [16-Bits]                                 Thu May  7 22:05:00 2026



   1A1D                     561 T_WEIGHT:        .rmb     2       ; holds value of weight following a call to GETDATA
   1A1F                     562 IDLE_COUNT:      .rmb     1       ; counts the number of empty measurement reports
   1A20                     563 IDLE_MSG_ID:     .rmb     1       ; holds value of next idle message to use
   1A21                     564 GREET_MSG_ID:    .rmb     1       ; holds value of next greeting message to use
   1A22                     565 LIGHT_MSG_ID:    .rmb     1       ; holds value of next light weight message to use
   1A23                     566 NORMAL_MSG_ID:   .rmb     1       ; holds value of next normal weight message to use
   1A24                     567 HEAVY_MSG_ID:    .rmb     1       ; holds value of next heavy weight message to use
   1A25                     568 SHEAVY_MSG_ID:   .rmb     1       ; holds value of next super heavy weight message to use
   1A26                     569 PROCESSING_FLG:  .rmb     1       ; non-zero indicates that that a weight is being processed
                            570                                   ;   all following weight data is ignored until the next
                            571                                   ;   idle (0000h) data resets it.
   1A27                     572 SYLLABLES:       .rmb     1       ; number of phrase syllables for the panel LED routines
                            573                                   ;  this is updated each time a word is transmitted and
                            574                                   ;  when PANELDISP is called, usually after acall to PR_PHRASE
                            575                                   ;  the lights are manipulated.
