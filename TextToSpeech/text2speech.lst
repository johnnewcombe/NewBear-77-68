   1A26                     566 TEMP:            .rmb     2       ; temp var (non subroutine use)
   1A28                     567 T_WEIGHT:        .rmb     2       ; holds value of weight following a call to GETDATA
   1A2A                     568 IDLE_COUNT:      .rmb     1       ; counts the number of empty measurement reports
   1A2B                     569 IDLE_MSG_ID:     .rmb     1       ; holds value of next idle message to use
   1A2C                     570 GREET_MSG_ID:    .rmb     1       ; holds value of next greeting message to use
   1A2D                     571 LIGHT_MSG_ID:    .rmb     1       ; holds value of next light weight message to use
   1A2E                     572 NORMAL_MSG_ID:   .rmb     1       ; holds value of next normal weight message to use
   1A2F                     573 HEAVY_MSG_ID:    .rmb     1       ; holds value of next heavy weight message to use
   1A30                     574 SHEAVY_MSG_ID:   .rmb     1       ; holds value of next super heavy weight message to use
   1A31                     575 PROCESSING_FLG:  .rmb     1       ; non-zero indicates that that a weight is being processed
