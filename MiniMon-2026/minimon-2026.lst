0577 ff7b 7e ff 8c                   JMP     START   ; Return to MINIMON
0578 ff7e 8e f0 d0           RESET   LDS     #STACK  ; Set up stack for MINIMON
0579 ff81 86 03                      LDAA    #$03    ; Reset:
0580 ff83 b7 f4 01                   STAA    CTRLA   ;   ACIA.A
0581 ff86 b7 f4 03                   STAA    CTRLB   ;   ACIA.B
0582 ff89 bf f0 fd           SWI     STS     PSTACK  ; Save callers stack pointer
0583 ff8c 8e f0 d0           START   LDS     #STACK  ; Set up stack for MINMON
