output:  JMON.s19
0001                         ; ----------------------------------------------------------------------------
0002                         ; JMON (Jan. 2026)
0003                         ; ----------------------------------------------------------------------------
0004                         ;
0005                         ; Created by GlassTTY, Jan. 2026, using MINIMON (ACH, Dec. 1978) as a base
0006                         ; with additional code from Motorola's MIKBUG.
0007                         ;
0008                         ; Special thanks to Chris Carter for inspiration and help.
0009                         ;
0010                         ; ----------------------------------------------------------------------------
0011                         ;
0012                         ; This is a MINIMON compatible monitor for the 77-68 Bear/Newbear system with
0013                         ; the LOAD and PUNCH commands replaced for versions that support the
0014                         ; Motorola S Record Format (.s19) files.
0015                         ;
0016                         ; All entry points and source code labels as published in the MINIMON
0017                         ; documentation have been preserved with the exception of the LOAD and PUNCH
0018                         ; commands.
0019                         ;
0020                         ; In order to make space for the additional code required, the ALTER and
0021                         ; OFFSET CALCULATION commands have been removed. This has been justified as
0022                         ; the MODIFY command has very similar functionality to ALTER making ALTER
0023                         ; unnecessary, and the OFFSET CALCULATION routines (commands X and Y) are
0024                         ; rarely used as all cross-assemblers perform these calculations
0025                         ; automatically. In addition BLOCKMOVE command (Cmd 'B') has been removed
0026                         ; to allow for a memory test command to be added (Cmd 'T')'.
0027                         ;
0028                         ; One other minor change is that the terminal along with any devices sending
0029                         ; S19 format files have been configured for 8 Data Bits, No Parity, 2 Stop
0030                         ; Bits.
0031                         ;
0032                         ; ----------------------------------------------------------------------------
0033                         
0034 f401                    CTRLA   EQU     $F401   ; ACIA.A Ctrl/Status
0035 f403                    CTRLB   EQU     $F403   ; ACIA.B Ctrl/Status
0036 f400                    DATAA   EQU     $F400   ; ACIA.A Data register
0037 f402                    DATAB   EQU     $F402   ; ACIA.B Data register
0038                         
0039                         ; -----------------------------------------------------
0040                         ; Note:The original 256 bytes of RAM on the CPU board
0041                         ;  appears at $F000 to $F0FE, with Switches/LEDs at $F0FF
0042                         ;  when a MON1 board is installed
0043                         ; -----------------------------------------------------
0044 f0dd                    JNMI    EQU     $F0DD   ; 3 bytes for jump to NMI sub.
0045 f0e0                    JIRQ    EQU     $F0E0   ; 3 bytes for jump to IRQ sub.
0046 f0d0                    STACK   EQU     $F0D0   ; Stack goes down from $F0D0
0047                                                 ; The bytes above STACK, in
0048                                                 ; particular STACK+7 and
0049                                                 ; STACK+6 are used when the RTI
0050                                                 ; instruction is issued as part
0051                                                 ; of the GO command. Everything
0052                                                 ; from $F0D8 to $F0DC is unused
0053                                                 ; RAM.
0054                         
0055                         ; -----------------------------------------------------
0056 f0d8                            ORG     $F0D8
0057                         ; -----------------------------------------------------
0058                         
0059 f0d8                    T_TW    RMB     2       ; New additions to support SRec
0060 f0da                    T_CSUM  RMB     1       ;            "
0061 f0db                    T_COUNT RMB     1       ;            "
0062 f0dc                    T_TEMP  RMB     1       ;            "
0063                         
0064                         ; -----------------------------------------------------
0065 f0e3                            ORG     $F0E3   ; Start of RAM variables
0066                         ; -----------------------------------------------------
0067                         
0068 f0e3                    T_SAVE  RMB     2       ; Temp storage for NEWLINE
0069 f0e5                    T_P     RMB     1       ;   "     "     "  Z,X
0070 f0e6                    T_X     RMB     2       ;   "     "     "  Sub
0071 f0e8                    T_Y     RMB     2       ;   "     "     "  Sub
0072 f0ea                    T_NEW   RMB     2       ;   "     "     "  Block move
0073 f0ec                    T_M     RMB     1       ;   "     "     "  ZOUT
0074 f0ed                    T_TMPX  RMB     2       ;   "     "     "  PRX
0075 f0ef                    T_STRT  RMB     2       ;   "     "     "  GETADDRESS
0076 f0f1                    T_STOP  RMB     2       ;   "     "     "  GETADDRESS
0077 f0f3                    T_Z     RMB     2       ;   "     "     "   . RDX
0078 f0f5                    T_R     RMB     1       ;   "     "     "     PR
0079 f0f6                    T_Q     RMB     1       ;   "     "     "  ZIN,DUMP 
0080 f0f7                    T_ABYT  RMB     2       ;   "     "     "  SET BR.PT.
0081 f0f9                            RMB     2       ;   "     "     "  SET BR.PT.
0082 f0fb                    T_BYTE  RMB     2       ;   "     "     "  SET BR.PT.
0083 f0fd                    PSTACK  RMB     2       ;   "     "     "     SWI etc
0084                         
0085                         ; -----------------------------------------------------
0086 fc00                            ORG     $FC00   ; Start of ROM based code
0087                         ; -----------------------------------------------------
0088                         
0089                         ; -----------------------------------------------------
0090                         ; Read Character from ACIA
0091                         ; FC00
0092                         ; -----------------------------------------------------
0093 fc00 bd fd 2b           RD_CMD  JSR     RD_A    ; Input one character
0094 fc03 27 fb                      BEQ     RD_CMD  ; Ignore paper tape follower
0095 fc05 8d 08                      BSR     PR_A    ; Echo character
0096 fc07 81 2e                      CMPA    #'.     ; Was it a fullstop ?
0097 fc09 26 11                      BNE     PRA_END ;
0098 fc0b 7e ff 8f                   JMP     START   ; Yes: Go to start of MINIMON
0099                         
0100 fc0e 01                         NOP
0101                         
0102                         ; -----------------------------------------------------
0103                         ; Print character in A
0104                         ; FC0F
0105                         ; -----------------------------------------------------
0106 fc0f f6 f4 01           PR_A    LDAB    CTRLA   ; Get ACIA(a) status byte
0107 fc12 c5 02                      BITB    #02     ; Is it busy ?
0108 fc14 27 f9                      BEQ     PR_A    ; Yes: Try again
0109 fc16 b7 f4 00                   STAA    DATAA   ;  No: Send data
0110 fc19 7c f0 f5                   INC     T_R     ; Characters printed + One
0111 fc1c 39                 PRA_END RTS             ; RETURN
0112                         
0113                         ; -----------------------------------------------------
0114                         ; Check A contains a HEX character,  Set C.bit on fail
0115                         ; FC1D
0116                         ; -----------------------------------------------------
0117 fc1d 81 2f              VHEX    CMPA    #$2F    ; A < 30 ?
0118 fc1f 2f 0e                      BLE     NotHex  ;  not hex
0119 fc21 81 39                      CMPA    #$39    ; A > 39 ?    
0120 fc23 22 02                      BHI     NotNum  ;  Not a Numeral
0121 fc25 0c                 IsHex   CLC             ; It's OK (clear C bit)
0122 fc26 39                         RTS             ; RETURN
0123 fc27 81 40              NotNum  CMPA    #$40    ; A < 41 ?
0124 fc29 2f 04                      BLE     NotHex  ;  not hex
0125 fc2b 81 46                      CMPA    #$46    ; A <= 46
0126 fc2d 2f f6                      BLE     IsHex   ;  then it is hex
0127 fc2f 0d                 NotHex  SEC             ; Set C bit
0128 fc30 39                         RTS             ; RETURN
0129                         
0130                         ; -----------------------------------------------------
0131                         ; Convert A:B to binary
0132                         ; FC31
0133                         ; -----------------------------------------------------
0134 fc31 85 30              BINARY  BITA    #$30    ; Is it a letter ?
0135 fc33 27 0c                      BEQ     LETTA   ; Yes: Got to handle it
0136 fc35 48                 RIDA    ASLA            ;  No: It is a number, so
0137 fc36 48                         ASLA            ;      shift
0138 fc37 48                         ASLA            ;       left
0139 fc38 48                         ASLA            ;        4 bits
0140 fc39 c5 30                      BITB    #$30    ; Is Acc.B a letter ?
0141 fc3b 27 08                      BEQ     LETTB   ; Yes: Go handle it
0142 fc3d c4 0f              RIDB    ANDB    #$0F    ; Clear 4 high bits in Acc.B
0143 fc3f 1b                         ABA             ; Form binary character (A=A+B)
0144 fc40 39                         RTS             ; RETURN
0145 fc41 8b 09              LETTA   ADDA    #$09    ; Make Acc.A a binary
0146 fc43 20 f0                      BRA     RIDA    ;  as before
0147 fc45 cb 09              LETTB   ADDB    #$09    ; Make Acc.B a binary
0148 fc47 20 f4                      BRA     RIDB    ;  as before
0149                         
0150                         ; -----------------------------------------------------
0151                         ; Read a 4 digit HEX value, put result into X
0152                         ; FC49
0153                         ; -----------------------------------------------------
0154 fc49 8d b5              ZIN     BSR     RD_CMD  ; Read a character
0155 fc4b 8d d0                      BSR     VHEX    ; Is it a hex character ?
0156 fc4d 25 10                      BCS     Z_PRQM  ; No: go to print `?`
0157 fc4f b7 f0 f6                   STAA    T_Q     ; Save it
0158 fc52 8d ac                      BSR     RD_CMD  ; Read 2nd character
0159 fc54 8d c7                      BSR     VHEX    ; Is it a hex character ?
0160 fc56 25 07                      BCS     Z_PRQM  ; No: go to print `?`
0161 fc58 16                         TAB             ; Yes: Put it into B
0162 fc59 b6 f0 f6                   LDAA    T_Q     ; Retrieve 1st hex char to A
0163 fc5c 7e fc d8                   JMP     ZIN2    ; S19 version of ZIN is longer
0164 fc5f bd fd 21           Z_PRQM  JSR     PR_QM   ; Print "?"
0165 fc62 7e fc 49                   JMP     ZIN     ; Go back to start of hex input
0166                         
0167                         ; -----------------------------------------------------
0168                         ; Read 4 hex digits and put value into X
0169                         ; FC65
0170                         ; -----------------------------------------------------
0171 fc65 bd fd 4d           RD_X    JSR     PRSP    ; Print a space
0172 fc68 8d df                      BSR     ZIN     ; Read 2 digit hex value into A
0173 fc6a b7 f0 f3                   STAA    T_Z     ; Save byte (most significant)
0174 fc6d 8d da                      BSR     ZIN     ; Read 2 digit hex value into A
0175 fc6f b7 f0 f4                   STAA    T_Z+1   ; Save byte (least significant)
0176 fc72 fe f0 f3                   LDX     T_Z     ; Load full 4 hex value into X
0177 fc75 39                         RTS             ; RETURN
0178                         
0179                         ; -----------------------------------------------------
0180                         ; Print string FOLLOWING JSR ( terminated by $FF )
0181                         ;  IE: It starts at the `return addr` put onto the stack by JSR
0182                         ;  So actual return address needed is past the string
0183                         ; FC76
0184                         ; -----------------------------------------------------
0185 fc76 30                 STRING  TSX             ; Get loc. of return addr to X
0186 fc77 ee 00                      LDX     0,X     ; Get return addr to X
0187 fc79 09                         DEX             ; Point to byte before
0188 fc7a 08                 AGAIN   INX             ; Point to next byte
0189 fc7b a6 00                      LDAA    0,X     ; Get byte to be printed
0190 fc7d 81 ff                      CMPA    #$FF    ; End-string ?
0191 fc7f 27 04                      BEQ     ENDSTR  ; Yes: Go to finish up
0192 fc81 8d 8c                      BSR     PR_A    ; Print the byte
0193 fc83 20 f5                      BRA     AGAIN   ; Go back for next byte
0194 fc85 31                 ENDSTR  INS             ; Clean up stack...
0195 fc86 31                         INS             ;  ( pop off the return addr )
0196 fc87 6e 01                      JMP     1,X     ; Jump back to caller (RETURN)
0197                         
0198                         ; -----------------------------------------------------
0199                         ; FC89
0200                         ; -----------------------------------------------------
0201 fc89 8d eb              GETADD  BSR     STRING  ; Print string...
0202 fc8b 20 53                      FCC     " S"    ;
0203 fc8d ff                         FCB     $FF     ; End-of-string
0204 fc8e 8d d5                      BSR     RD_X    ; Read 4 digit HEX addr value
0205 fc90 ff f0 ef                   STX     T_STRT  ; Save it
0206 fc93 8d e1                      BSR     STRING  ; Print string...
0207 fc95 20 46                      FCC     " F"    ;
0208 fc97 ff                         FCB     $FF     ; End-of-string
0209 fc98 8d cb                      BSR     RD_X    ; Read 4 digit HEX addr value
0210 fc9a ff f0 f1                   STX     T_STOP  ; Save it
0211 fc9d 39                         RTS             ; RETURN
0212                         
0213                         ; -----------------------------------------------------
0214                         ; Convert value in A to 2 x ASCII hex digits in A and B
0215                         ; FC9E
0216                         ; -----------------------------------------------------
0217 fc9e 16                 ASCII   TAB             ; Copy A to B
0218 fc9f 84 f0                      ANDA    #$F0    ; Clear low order 4 bits of A
0219 fca1 44                         LSRA            ; Shift
0220 fca2 44                         LSRA            ;  right
0221 fca3 44                         LSRA            ;   4
0222 fca4 44                         LSRA            ;    bits
0223 fca5 81 09                      CMPA    #$09    ; Letter or number ?
0224 fca7 22 0b                      BHI     SUBT    ; 
0225 fca9 8b 30                      ADDA    #$30    ; Make it an ASCII number
0226 fcab c4 0f              AND     ANDB    #$0F    ; Clear high order bits of B
0227 fcad c1 09                      CMPB    #$09    ; Letter or number ?
0228 fcaf 22 07                      BHI     ADD     ;
0229 fcb1 cb 30                      ADDB    #$30    ; Make it an ASCII number
0230 fcb3 39                         RTS             ; RETURN
0231 fcb4 8b 37              SUBT    ADDA    #$37    ; Make it an ASCI letter
0232 fcb6 20 f3                      BRA     AND     ; Go to process low order value
0233 fcb8 cb 37              ADD     ADDB    #$37    ; Make it an ASII letter
0234 fcba 39                         RTS             ; RETURN
0235                         
0236                         ; -----------------------------------------------------
0237                         ; Print value in X as 4 hex digits
0238                         ; FCBB
0239                         ; -----------------------------------------------------
0240 fcbb ff f0 ed           PRX     STX     T_TMPX  ; Save X
0241 fcbe b6 f0 ed                   LDAA    T_TMPX  ; Get high order byte to A
0242 fcc1 8d 06                      BSR     ZOUT    ; Print A as 2 hex digits
0243 fcc3 b6 f0 ee                   LDAA    T_TMPX+1; Get low order byte to A
0244 fcc6 20 01                      BRA     ZOUT    ; Print A as 2 hex digits
0245                         
0246 fcc8 01                         NOP
0247                         
0248                         ; -----------------------------------------------------
0249                         ; Print value in A as 2 hex digits, Preserve B
0250                         ; X unchanged by called routines
0251                         ; This is 1 byte shorter that original ZOUT
0252                         ; FCC9
0253                         ; -----------------------------------------------------
0254 fcc9 37                 ZOUT    PSHB            ; Save B to STACK
0255 fcca 36                         PSHA            ; Save A to STACK
0256 fccb 8d d1                      BSR     ASCII   ; Convert A to ASCII in A & B
0257 fccd 37                         PSHB            ; Save B (2nd byte) to STACK
0258 fcce bd fc 0f                   JSR     PR_A    ; Print byte in A
0259 fcd1 32                         PULA            ; Get 2nd byte into A from STACK
0260 fcd2 bd fc 0f                   JSR     PR_A    ; Print byte in A
0261 fcd5 32                         PULA            ; Recover A from STACK
0262 fcd6 33                         PULB            ; Recover B from STACK
0263 fcd7 39                         RTS             ; RETURN
0264                         
0265                         
0266                         ; second part of S19 version of ZIN
0267 fcd8 bd fc 31           ZIN2    JSR     BINARY  ; Convert A:B to binary to A
0268 fcdb 16                         TAB             ; B=A
0269 fcdc fb f0 da                   ADDB    T_CSUM  ; Add this value
0270 fcdf f7 f0 da                   STAB    T_CSUM  ; to the Checksum (for S19)
0271 fce2 39                         RTS             ; RETURN
0272                         
0273                         ; -----------------------------------------------------
0274                         ; S19 format data load : Modded version of Mikbug code
0275                         ; FCE3
0276                         ; -----------------------------------------------------
0277 fce3                    LOAD    EQU     *       ; L = Load = Input an S19 file
0278 fce3 8d 91                      BSR     STRING
0279 fce5 0d 0a                      FCB     $0D,$0A ; c/r l/f
0280 fce7 ff                         FCB     $FF     ; End-Of-String
0281 fce8 bd fc 00           LREAD   JSR     RD_CMD  ; Read+Echo, test for '.'
0282 fceb 81 53                      CMPA    #'S     ; Is it `S` ?
0283 fced 26 f9                      BNE     LREAD   ; No: Keep waiting for `S`
0284 fcef bd fc 00                   JSR     RD_CMD  ; Read+Echo, test for '.'
0285 fcf2 81 39                      CMPA    #'9     ; Is it `9` ?  ( `S9` record )
0286 fcf4 26 03                      BNE     LREAD1
0287 fcf6 7e fe b3                   JMP     STERMR  ; handle termination record
0288 fcf9 81 31              LREAD1  CMPA    #'1     ; Is it `1` ?  ( `S1` record )
0289 fcfb 26 eb                      BNE     LREAD   ; No: Wait for next `S`
0290 fcfd 7f f0 da                   CLR     T_CSUM  ; Clear checksum
0291 fd00 bd fc 49                   JSR     ZIN     ; Read 2xHex = data.byte count to A
0292 fd03 80 02                      SUBA    #2      ; Subtract 2 (to get bytes left in line)
0293 fd05 b7 f0 db                   STAA    T_COUNT ; Store byte count
0294 fd08 bd fc 65                   JSR     RD_X    ; Read 4xHex digit address to X
0295 fd0b bd fc 49           LDOBYT  JSR     ZIN     ; Read 2xHex digits, value to A
0296 fd0e 7a f0 db                   DEC     T_COUNT ; Decrement our byte count
0297 fd11 27 05                      BEQ     LCHK    ; If end-of-line, go look at checksum
0298 fd13 a7 00                      STAA    0,X     ; Save byte where X points
0299 fd15 08                         INX             ; Point X at next byte
0300 fd16 20 f3                      BRA     LDOBYT  ; Go get next byte
0301 fd18 7c f0 da           LCHK    INC     T_CSUM  ; Add 1 to checksum
0302 fd1b 27 cb                      BEQ     LREAD   ; OK: Go read next record
0303 fd1d 8d 02                      BSR     PR_QM   ; Print "?"
0304 fd1f 20 29                      BRA     STARTR  ; Go to START
0305                         
0306 fd21 86 3f              PR_QM   LDAA #'?        ; Put '?' character in A
0307 fd23 7e fc 0f                   JMP     PR_A    ; Print it and return via PR_As RTS
0308                         
0309 fd26 01                         NOP
0310 fd27 01                         NOP
0311 fd28 01                         NOP
0312 fd29 01                         NOP
0313 fd2a 01                         NOP
0314                         
0315                         ; -----------------------------------------------------
0316                         ; Read byte from ACIA.A to A
0317                         ; FD2B
0318                         ; -----------------------------------------------------
0319 fd2b b6 f4 01           RD_A    LDAA    CTRLA   ; Get ACIA.A status byte
0320 fd2e 85 01                      BITA    #$01    ; Is byte ready in DATAA
0321 fd30 27 f9                      BEQ     RD_A    ; No: Try again
0322 fd32 7e fd cf                   JMP     PARITY  ; Need to clear parity as we
0323                                                 ; need to support 7E2 & 8N2
0324                         
0325 fd35 01                         NOP
0326                         
0327                         ; -----------------------------------------------------
0328                         ; FD36
0329                         ; -----------------------------------------------------
0330 fd36 8d 15              REGPRT  BSR     PRSP    ; Print a space
0331 fd38 fe f0 fd                   LDX     PSTACK  ; Point X at user's stack
0332 fd3b 8d 1c                      BSR     PR2     ; Print CC
0333 fd3d 8d 1a                      BSR     PR2     ; Print B
0334 fd3f 8d 18                      BSR     PR2     ; Print A
0335 fd41 8d 10                      BSR     PR4     ; Print X
0336 fd43 8d 0e                      BSR     PR4     ; Print PC
0337 fd45 ce f0 fd                   LDX     #PSTACK ; Point X at stack pointer
0338 fd48 8d 0a                      BSR     PR4X    ; Print stack pointer
0339 fd4a 7e ff 8f           STARTR  JMP     START  ; (RETURN) to MINIMON
0340                         
0341                         
0342                         ; -----------------------------------------------------
0343                         ; FD4D
0344                         ; -----------------------------------------------------
0345 fd4d 86 20              PRSP    LDAA    #$20    ; Put space character in A
0346 fd4f bd fc 0f                   JSR     PR_A    ; Print it
0347 fd52 39                         RTS             ; RETURN
0348 fd53 08                 PR4     INX             ; Point X to next character
0349 fd54 a6 00              PR4X    LDAA    0,X     ; Get byte pointed to by X
0350 fd56 bd fc c9                   JSR     ZOUT    ; Print it
0351 fd59 08                 PR2     INX             ; Point X to next character
0352 fd5a a6 00                      LDAA    0,X     ; Get byte pointed to by X
0353 fd5c bd fc c9                   JSR     ZOUT    ; Print it
0354 fd5f 8d ec                      BSR     PRSP    ; Print a space
0355 fd61 39                         RTS             ; RETURN
0356                         
0357                         ; -----------------------------------------------------
0358                         ; FD62
0359                         ; -----------------------------------------------------
0360 fd62 bd fc 89           MEMTEST JSR     GETADD      ; get the start and finish addresses
0361 fd65 bd fc 76                   JSR     STRING
0362 fd68 20 54 45 53 54 49          FCC     " TESTING..."
     4e 47 2e 2e 2e
0363 fd73 0d 0a ff                   FCB     $0D,$0A,$FF
0364 fd76 5f                         CLRB                ; set up accumulators
0365 fd77 37                 .TST    PSHB
0366 fd78 bd fc 76                   JSR     STRING
0367 fd7b 0d ff                      FCB     $0D,$FF
0368 fd7d 33                         PULB
0369 fd7e 17                         TBA
0370 fd7f bd fc c9                   JSR     ZOUT
0371 fd82 fe f0 ef                   LDX     T_STRT      ; put start address in X
0372 fd85 4f                         CLRA
0373 fd86 1b                 .LOOP1  ABA                 ; create the pattern
0374 fd87 a7 00                      STAA    0,X         ; Write to memory
0375 fd89 08                         INX
0376 fd8a bc f0 f1                   CPX     T_STOP      ; Check for end of memory
0377 fd8d 26 f7                      BNE     .LOOP1
0378 fd8f fe f0 ef                   LDX     T_STRT
0379 fd92 4f                         CLRA
0380 fd93 1b                 .LOOP2  ABA
0381 fd94 a1 00                      CMPA     0,X        ; Read from memory
0382 fd96 26 1d                      BNE     .FAULT
0383 fd98 08                 .NOPR   INX
0384 fd99 bc f0 f1                   CPX     T_STOP
0385 fd9c 26 f5                      BNE     .LOOP2
0386 fd9e b6 f4 01                   LDAA    CTRLA       ; Read ACIA status
0387 fda1 85 01                      BITA    #$01        ; Key waiting?
0388 fda3 26 03                      BNE     .END        ; Yes so end the test
0389 fda5 5c                         INCB                ; change the pattern and repeat
0390 fda6 26 cf                      BNE     .TST        ; we loop the test 256 times
0391 fda8 b6 f4 00           .END    LDAA    DATAA       ; Clear a byte from ACIA
0392 fdab bd fc 76                   JSR     STRING
0393 fdae 20 4f 4b                   FCC     " OK"
0394 fdb1 ff                         FCB     $FF
0395 fdb2 7e ff 8f                   JMP     START
0396 fdb5 bd fe 97           .FAULT  JSR     NEWLINE
0397 fdb8 bd fc 76                   JSR     STRING
0398 fdbb 20 46 4c 54                FCC     " FLT"
0399 fdbf ff                         FCB     $FF
0400 fdc0 7e ff 8f                   JMP START
0401                         
0402                         ; -----------------------------------------------------
0403                         ; FDC3
0404                         ; -----------------------------------------------------
0405 fdc3 bd fc 76           VERSION JSR     STRING
0406 fdc6 20 31 2e 30 30             FCC     " 1.00" ;
0407 fdcb ff                         FCB     $FF
0408 fdcc 7e ff 8f                   JMP     START
0409                         
0410 fdcf b6 f4 00           PARITY  LDAA    DATAA   ; Get the data byte to A
0411 fdd2 84 7f                      ANDA    #$7F    ; Mask off parity bit if it exists
0412 fdd4 39                         RTS             ; RETURN
0413                         
0414 fdd5 01                         NOP
0415                         
0416                         ; -----------------------------------------------------
0417                         ; FDD6
0418                         ; -----------------------------------------------------
0419 fdd6 ce f0 e6           SUB     LDX     #T_X    ; Point X to start of T_X data
0420 fdd9 a6 01                      LDAA    1,X     ; A = T_X (low)
0421 fddb e6 00                      LDAB    0,X     ; B = T_X (high)
0422 fddd a0 03                      SUBA    3,X     ; A = A - T_Y (low)
0423 fddf e2 02                      SBCB    2,X     ; B = B - T_Y (high)
0424 fde1 39                         RTS             ; RETURN
0425                         
0426                         ; -----------------------------------------------------
0427                         ; S format data output : Modded version of Mikbug code
0428                         ; -----------------------------------------------------
0429 fde2 bd fc 89           PUNCH   JSR     GETADD      ; Prompt for "Start:","Stop:"
0430 fde5 fe f0 ef                   LDX     T_STRT      ; Get start address
0431 fde8 ff f0 d8                   STX     T_TW        ; save it to work area
0432 fdeb b6 f0 f2           POUT1   LDAA    T_STOP+1    ; get low order of end address
0433 fdee b0 f0 d9                   SUBA    T_TW+1      ; Subtract low order start
0434 fdf1 f6 f0 f1                   LDAB    T_STOP      ; ( carry not affected by LDA )
0435 fdf4 f2 f0 d8                   SBCB    T_TW        ; Subtract with Carry
0436 fdf7 26 04                      BNE     POUT2
0437 fdf9 81 10                      CMPA    #16
0438 fdfb 25 02                      BCS     POUT3
0439 fdfd 86 0f              POUT2   LDAA    #15
0440 fdff 8b 04              POUT3   ADDA    #4
0441 fe01 b7 f0 db                   STAA    T_COUNT     ; FRAME COUNT THIS RECORD
0442 fe04 80 03                      SUBA    #3
0443 fe06 b7 f0 dc                   STAA    T_TEMP      ; BYTE COUNT THIS RECORD
0444 fe09 bd fc 76                   JSR     STRING      ; Output this string...
0445 fe0c 0d 0a                      FCB     $0D,$0A     ; c/r l/f
0446 fe0e 53 31                      FCB     'S,'1       ; S1
0447 fe10 ff                         FCB     $FF         ; End-Of-String
0448 fe11 5f                         CLRB                ; Clear checksum
0449                         
0450                         ; Output frame count...
0451 fe12 ce f0 db                   LDX     #T_COUNT    ; X = Address of Framecount
0452 fe15 bd fe a8                   JSR     POUTH2      ; O/P byte <-X and inc X
0453                         
0454                         ; Output address...
0455 fe18 ce f0 d8                   LDX     #T_TW
0456 fe1b bd fe a8                   JSR     POUTH2      ; O/P byte <-X and inc X
0457 fe1e bd fe a8                   JSR     POUTH2      ; O/P byte <-X and inc X
0458                         
0459                         ; Output data...
0460 fe21 fe f0 d8                   LDX     T_TW
0461 fe24 bd fe a8           POUT4   JSR     POUTH2      ; O/P byte <-X and inc X
0462 fe27 7a f0 dc                   DEC     T_TEMP      ; Decrement `bytes left` count
0463 fe2a 26 f8                      BNE     POUT4       ; Loop back if any left
0464 fe2c ff f0 d8                   STX     T_TW
0465 fe2f 53                         COMB
0466 fe30 37                         PSHB
0467 fe31 30                         TSX                ; X = S + 1
0468 fe32 8d 74                      BSR     POUTH2     ; PUNCH CHECKSUM
0469 fe34 33                         PULB
0470 fe35 fe f0 d8                   LDX     T_TW
0471 fe38 09                         DEX
0472 fe39 bc f0 f1                   CPX     T_STOP
0473 fe3c 26 ad                      BNE     POUT1
0474 fe3e 7e ff df                   JMP     STERMS
0475                         
0476 fe41 01                         NOP
0477 fe42 01                         NOP
0478                         
0479                         ; -----------------------------------------------------
0480                         ; FE43
0481                         ; -----------------------------------------------------
0482 fe43 bd fc 65           MODIFY  JSR     RD_X    ; Get address to X
0483 fe46 bd fd 4d           STRT    JSR     PRSP    ; Print a space
0484 fe49 7f f0 f5                   CLR     T_R     ; T_R = 0
0485 fe4c a6 00              PRz     LDAA    0,X     ; Get byte pointed to by X to A
0486 fe4e bd fc c9                   JSR     ZOUT    ; Print it as 2.hex digits
0487 fe51 bd fc 00           WATSIT  JSR     RD_CMD  ; Get command character
0488 fe54 81 20              WHAT    CMPA    #$20    ; Is it a space ?
0489 fe56 26 0c                      BNE     ISSLSH  ; No: go test for slash
0490 fe58 08                 CARYON  INX             ; Increment X
0491 fe59 b6 f0 f5                   LDAA    T_R     ; A = T_R
0492 fe5c 81 16                      CMPA    #$16    ; At end of line ?
0493 fe5e 2f ec                      BLE     PRz     ; No: Loop back to continue
0494 fe60 8d 35              NEW_1   BSR     NEWLINE ; Print c/r l/f nul
0495 fe62 20 e2                      BRA     STRT    ; Loop back (Note: Hex was wrong in doc, E2 instead of E5)
0496                         
0497 fe64 81 2f              ISSLSH  CMPA    #'/     ; Is it a slash ?
0498 fe66 26 03                      BNE     ISCRET  ; No: go test for c/r
0499 fe68 09                         DEX             ; X = X - 1
0500 fe69 20 f5                      BRA     NEW_1   ; Loop back (print newline)
0501                         
0502 fe6b 81 0d              ISCRET  CMPA    #$0D    ; Is it a c/r ?
0503 fe6d 26 03                      BNE     ISHEX   ; No: go test for valid Hex
0504 fe6f 08                         INX             ; X = X + 1
0505 fe70 20 ee                      BRA     NEW_1   ; Loop back (print newline)
0506                         
0507 fe72 bd fc 1d           ISHEX   JSR     VHEX    ; Is it a valid hex character ?
0508 fe75 25 19                      BCS     PRQM    ; No: print `?` and ignore
0509 fe77 b7 f0 f6                   STAA    T_Q     ; T_Q = A : Save it
0510 fe7a bd fc 00                   JSR     RD_CMD  ; Get 2nd character
0511 fe7d bd fc 1d                   JSR     VHEX    ; Is it a valid hex character ?
0512 fe80 25 d2                      BCS     WHAT    ; No: then see what it is
0513 fe82 16                         TAB             ; B = A
0514 fe83 b6 f0 f6                   LDAA    T_Q     ; A = T_Q
0515 fe86 bd fc 31                   JSR     BINARY  ; Convert to binary value
0516 fe89 a7 00                      STAA    0,X     ; Store it
0517 fe8b bd fd 4d                   JSR     PRSP    ; Print a space
0518 fe8e 20 c8                      BRA     CARYON  ; Loop back
0519                         
0520 fe90 86 3f              PRQM    LDAA    #'?     ; Put `?` into A
0521 fe92 bd fc 0f                   JSR     PR_A    ; Print it
0522 fe95 20 ba                      BRA     WATSIT  ; Loop back
0523                         
0524 fe97 ff f0 e3           NEWLINE STX     T_SAVE  ; Save X
0525 fe9a bd fc 76                   JSR     STRING  ; Print string...
0526 fe9d 0d 0a 00                   FCB     $0D,$0A,$00
0527 fea0 ff                         FCB     $FF     ; End-of-string
0528 fea1 fe f0 e3                   LDX     T_SAVE  ; Restore X
0529 fea4 bd fc bb                   JSR     PRX     ; Print X
0530 fea7 39                         RTS             ; RETURN
0531                         
0532 fea8 eb 00              POUTH2 ADDB    0,X      ; Update checksum
0533 feaa 36                         PSHA            ; Push A to STACK
0534 feab a6 00                      LDAA    0,X     ; Load byte to be o/p
0535 fead bd fc c9                   JSR     ZOUT    ; O/P byte <- X
0536 feb0 32                         PULA            ; Pull A off STACK
0537 feb1 08                         INX             ; Increment X
0538 feb2 39                         RTS             ; RETURN
0539                         
0540                         ; Processes the termination record which, if we get here is an S9 record
0541                         ; A will contain the umber of bytes to follow (should be 39h i.e. ASCII '9')
0542                         ; which means there are left to absorb.
0543 feb3 ce 00 08           STERMR  LDX     #8      ; get the number of bytes left in record
0544 feb6 bd fc 00           STERM1  JSR     RD_CMD  ; read and echo from ACIA and ignore
0545 feb9 09                         DEX
0546 feba 26 fa                      BNE     STERM1   ; loop for remaining bytes
0547 febc 7e ff 8f           STARTS  JMP     START
0548                         
0549 febf 01                         NOP
0550 fec0 01                         NOP
0551 fec1 01                         NOP
0552                         
0553                         ; -----------------------------------------------------
0554                         ; FEC2
0555                         ; -----------------------------------------------------
0556 fec2 bd fc 65           GO      JSR     RD_X    ; Get address to X (16.bit)
0557 fec5 bd fc 00                   JSR     RD_CMD  ; Right address ?
0558 fec8 b6 f0 f4                   LDAA    T_Z+1   ; T_Z.low to A
0559 fecb f6 f0 f3                   LDAB    T_Z     ; T_Z.high to B
0560 fece fe f0 fd           GOTO    LDX     PSTACK  ; Callers stack address to X
0561 fed1 a7 07                      STAA    7,X     ; Put new return
0562 fed3 e7 06                      STAB    6,X     ; address on stack
0563 fed5 be f0 fd                   LDS     PSTACK  ; Set up calling programs stack
0564 fed8 3b                         RTI             ; RETURN-FROM-INTERRUPT (SWI)
0565                         
0566                         ; -----------------------------------------------------
0567                         ; FED9
0568                         ; -----------------------------------------------------
0569 fed9 bd fc 00           CONTNU  JSR     RD_CMD  ; Read a byte (test for `.`)
0570 fedc 81 31                      CMPA    #'1     ; Is it `1` ?
0571 fede 26 10                      BNE     IsIt2  ; No: go test for `2`
0572 fee0 fe f0 f7                   LDX     T_ABYT  ; Get address of break.point
0573 fee3 b6 f0 fb                   LDAA    T_BYTE  ; Get saved opcode
0574 fee6 a7 00                      STAA    0,X     ; Put it back in the program
0575 fee8 b6 f0 f8                   LDAA    T_ABYT+1 ; Get address at which
0576 feeb f6 f0 f7                   LDAB    T_ABYT  ;   to re-enter program
0577 feee 20 de                      BRA     GOTO    ; Go to calling program
0578                         
0579 fef0 81 32              IsIt2   CMPA    #'2     ; Is it `2`
0580 fef2 27 03                      BEQ     G_Is2   ; Yes: go process it
0581 fef4 7e ff 8f                   JMP     START   ; No: Return to MINIMON
0582 fef7 fe f0 f9           G_Is2   LDX     T_ABYT+2 ; Get addr. of break.point 2
0583 fefa b6 f0 fc                   LDAA    T_BYTE+1 ; Get old opcode
0584 fefd a7 00                      STAA    0,X      ; Put it back
0585 feff b6 f0 fa                   LDAA    T_ABYT+3 ; Load address to start
0586 ff02 f6 f0 f9                   LDAB    T_ABYT+2 ;  running program at
0587 ff05 20 c7                      BRA     GOTO    ; Run user program
0588                         
0589                         ; -----------------------------------------------------
0590                         ; FF07
0591                         ; -----------------------------------------------------
0592 ff07 bd fc 89           DUMP    JSR     GETADD  ; Prompt for boundary addresses
0593 ff0a fe f0 ef                   LDX     T_STRT  ;
0594 ff0d bd fe 97           D_NEW   JSR     NEWLINE ; Print c/r l/f nul
0595 ff10 86 08                      LDAA    #$08    ;
0596 ff12 b7 f0 f6                   STAA    T_Q     ; T_Q = 8
0597 ff15 09                         DEX             ; X = X - 1
0598 ff16 08                 D_NXT   INX             ; X = X + 1
0599 ff17 bd fd 4d                   JSR     PRSP    ; Print a space
0600 ff1a a6 00                      LDAA    0,X     ; Get a byte
0601 ff1c bd fc c9                   JSR     ZOUT    ; Print it as 2.hex digits
0602 ff1f bc f0 f1                   CPX     T_STOP  ; Finished ?
0603 ff22 26 06                      BNE     D_CNT   ; No: Carry on
0604 ff24 b6 f4 00           D_END   LDAA    DATAA   ; Get a byte from ACIA (clear)
0605 ff27 7e ff 8f                   JMP     START   ; Return to MINIMON
0606 ff2a b6 f4 01           D_CNT   LDAA    CTRLA   ; Read ACIA status
0607 ff2d 85 01                      BITA    #$01    ; Stop dump ?
0608 ff2f 26 f3                      BNE     D_END   ; Yes; go clear ACIA etc
0609 ff31 7a f0 f6                   DEC     T_Q     ; New line needed ?
0610 ff34 26 e0                      BNE     D_NXT   ; No: Loop back
0611 ff36 08                         INX             ; Print next byte
0612 ff37 20 d4                      BRA     D_NEW   ;  on a new line
0613                         
0614                         ; -----------------------------------------------------
0615                         ; FF39
0616                         ; -----------------------------------------------------
0617 ff39 bd fc 00           BRPTSET JSR     RD_CMD  ; Read a byte (test for `.`)
0618 ff3c 81 31                      CMPA    #'1     ; Is it `1` ?
0619 ff3e 26 12                      BNE     Is2b    ; No: go test for `2`
0620 ff40 bd fc 65                   JSR     RD_X    ; Read addr value into X
0621 ff43 a6 00                      LDAA    0,X     ; Get the opcode
0622 ff45 b7 f0 fb                   STAA    T_BYTE  ; Save it
0623 ff48 ff f0 f7                   STX     T_ABYT  ; and the address
0624 ff4b 86 3f              SAME    LDAA    #$3F    ; `SWI` opcode :
0625 ff4d a7 00                      STAA    0,X     ;   set the breakpoint
0626 ff4f 7e ff 8f           ENDB    JMP     START   ; Return to MINIMON
0627 ff52 81 32              Is2b    CMPA    #'2     ; Is it `2` ?
0628 ff54 26 f9                      BNE     ENDB   ; No: Return to MINIMON
0629 ff56 bd fc 65                   JSR     RD_X    ; Read address into X
0630 ff59 a6 00                      LDAA    0,X     ; Get opcode
0631 ff5b b7 f0 fc                   STAA    T_BYTE+1 ; Save it
0632 ff5e ff f0 f9                   STX     T_ABYT+2 ; Save address
0633 ff61 20 e8                      BRA     SAME    ; Set the breakpoint
0634                         
