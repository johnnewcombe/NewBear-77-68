0001                         ;------------------------------------------------------------------
0002                         ; text2speech.asm
0003                         ;------------------------------------------------------------------
0004                         
0005                         ; 7768 ACIA
0006 f400                    DATAA   EQU $F400 ; ACIA(a) Data register
0007 f401                    CTRLA   EQU $F401 ; ACIA(a) Ctrl/Status
0008 f402                    DATAB   EQU $F402 ; ACIA(b) Data register
0009 f403                    CTRLB   EQU $F403 ; ACIA(b) Ctrl/Status
0010                         
0011                         ; MINIMON routines
0012 fc76                    STRING  EQU $FC76 ; Prints a string. The string should follow JSR and be terminated with $FF.
0013 fc89                    GETADD  EQU $FC89 ; Get Address, read 4 digit hex value.
0014 fcc9                    ZOUT    EQU $FCC9 ; Print value in A as 2 hex digits.
0015 fe97                    NEWLINE EQU $FE97 ; Prints a new line.
0016 ff8f                    START   EQU $FF8F ; Restarts MniMon.
0017 fc0f                    PR_A    EQU $FC0F ; Print char in A to ACIA (a)
0018 fd2b                    RD_A    EQU $FD2B ; Read char from A
0019 fd4d                    PRSP    EQU $FD4D ; Print a space
0020 fc31                    BINARY  EQU $FC31 ; Converts ASCII hex digits in A and B to binary?
0021 fc65                    RD_X    EQU $FC65 ; Read 4 hex digits Value from ACIA(a) and put value into X.
0022 fc1d                    VHEX    EQU $FC1D ; Checks that A contains a HEX character
0023 0200                    	    ORG $0200
0024                         
0025                         ; initialise serial port B
0026 0200 86 11              TX2SP   LDAA    #$11    ; 8 Data, No Parity, 2 Stop Bits
0027 0202 b7 f4 03                   STAA    CTRLB   ;   ACIA.A
0028                         
0029                                 ; -----------------------------------------------------
0030                                 ; PRINT NUMBERS 0 TO 9
0031                                 ; -----------------------------------------------------
0032                         ;        CLRA
0033                         ;PRNUMS  JSR     PRSPB
0034                         ;        JSR     PR_NUMB
0035                         ;        INCA
0036                         ;        CMPA    #10
0037                         ;        BNE     PRNUMS
0038                         ;        JSR     PRSPB
0039                         
0040                         
0041                         LOOP:
0042                         ; -----------------------------------------------------
0043                         ; Data arrives at port B as four hex characters
0044                         ; -----------------------------------------------------
0045 0205 bd 02 83                   JSR     RD_XB           ; read 4 hex characters into X
0046 0208 bd 02 92                   JSR     PR_WEIGHT       ; stoones in MSB, pounds in LSB
0047                         
0048                         ;--------------------------------------------------------------
0049                         ; DECIMAL CONVERSION
0050                         ;--------------------------------------------------------------
0051                                 ;JSR     PR_DEC          ; puts 3 decimal digits in DEC, DEC+1 and DEC+2
0052                                 ;LDAA    DEC+1           ; don't care about the hundreds        ADDA    #$30
0053                                 ;JSR     PR_NUMB
0054                                 ;JSR     PRSPB
0055                                 ;LDAA    DEC+2
0056                                 ;JSR     PR_NUMB
0057                         
0058                         ;--------------------------------------------------------------
0059                         ;
0060                         ;--------------------------------------------------------------
0061                                 ;JSR     STRINGB
0062                                 ;FCB     $0D, $0A
0063                                 ;FCC     "Shall I tell you a joke?"
0064                                 ;FCB     $0D, $0A,$FF
0065                         
0066 020b 3f                         SWI
0067                         
0068 020c 7e 02 05           .END    JMP     LOOP  ;START   ; all done
0069                         
0070                         ; -----------------------------------------------------
0071                         ; PR_DEC: Puts 3 decimal digits in DEC, DEC+1 and DEC+2
0072                         ;
0073                         ;       !! ONLY WORKS WITH VALUES BELOW 128 !!
0074                         ; -----------------------------------------------------
0075 020f 5f                 PR_DEC  CLRB            ; Clear B for hundreds
0076                         
0077 0210 81 64              HUND    CMPA    #100    ; 100 or more?
0078                         
0079 0212 2d 05                      BLT     TENS
0080 0214 80 64                      SUBA    #100    ; Sub 100
0081 0216 5c                         INCB            ; Increment hundred counter
0082 0217 20 f7                      BRA     HUND
0083                         
0084 0219 f7 03 ae           TENS    STAB    DEC     ; store the hundreds
0085                         
0086 021c 5f                         CLRB
0087 021d 81 0a              TENS1   CMPA    #10     ; 10 or more?
0088 021f 2d 05                      BLT     UNITS
0089 0221 80 0a                      SUBA    #10     ; Sub 10
0090 0223 5c                         INCB            ; Increment ten counter
0091 0224 20 f7                      BRA     TENS1
0092                         
0093 0226 f7 03 af           UNITS   STAB    DEC+1
0094 0229 b7 03 b0                   STAA    DEC+2   ; Final remainder is units
0095                         
0096 022c 39                         RTS
0097                         
0098                         
0099                         ; -----------------------------------------------------
0100                         ; Print string FOLLOWING JSR ( terminated by $FF ) to
0101                         ; ACIA(b) and ACIA(b)
0102                         ; -----------------------------------------------------
0103 022d 30                 STRINGB TSX             ; Get loc. of return addr to X
0104 022e ee 00                      LDX     0,X     ; Get return addr to X
0105 0230 09                         DEX             ; Point to byte before
0106 0231 08                 AGAIN   INX             ; Point to next byte
0107 0232 a6 00                      LDAA    0,X     ; Get byte to be printed
0108 0234 81 ff                      CMPA    #$FF    ; End-string ?
0109 0236 27 07                      BEQ     ENDSTR  ; Yes: Go to finish up
0110 0238 bd fc 0f                   JSR     PR_A    ; Print the byte to ACIA(a) (A is maintained)
0111 023b 8d 3b                      BSR     PR_B    ; Print the byte to ACIA(b)
0112 023d 20 f2                      BRA     AGAIN   ; Go back for next byte
0113 023f 31                 ENDSTR  INS             ; Clean up stack...
0114 0240 31                         INS             ;  ( pop off the return addr )
0115 0241 6e 01                      JMP     1,X     ; Jump back to caller (RETURN)
0116                         
0117                         ; -----------------------------------------------------
0118                         ; Prints a string pointed to by X
0119                         ; -----------------------------------------------------
0120 0243 a6 00              STRINGBX    LDAA    0,X         ; get char
0121 0245 81 ff                          CMPA    #$FF        ; is character NULL?
0122 0247 27 08                          BEQ     DONEB       ; yes, end of string
0123 0249 bd fc 0f                       JSR     PR_A        ; Print the byte to ACIA(a) (A is maintained)
0124 024c 8d 2a                          BSR     PR_B        ; Print the byte to ACIA(b)
0125 024e 08                             INX
0126 024f 20 f2                          BRA     STRINGBX
0127 0251 39                 DONEB       RTS
0128                         
0129                         ; -----------------------------------------------------
0130                         ; Reads a character from ACIA(b) into A
0131                         ; -----------------------------------------------------
0132 0252 b6 f4 03           RD_B    LDAA    CTRLB       ; Get ACIA.A status byte
0133 0255 85 01                      BITA    #01         ; Is byte ready in DATAb
0134 0257 27 f9                      BEQ     RD_B        ; No: Try again
0135 0259 b6 f4 02                   LDAA    DATAB       ; Get the data byte to A
0136                                 ;ANDA    #$7F        ; Mask off parity bit if it exists
0137 025c 39                         RTS                 ; RETURN
0138                         
0139                         ; -----------------------------------------------------
0140                         ;
0141                         ; -----------------------------------------------------
0142 025d 8d f3              ZINB    BSR     RD_B    ; Read a character
0143 025f bd fc 1d                   JSR     VHEX    ; Is it a hex character ?
0144 0262 25 12                      BCS     Z_PRQM  ; No: go to print `?`
0145 0264 b7 03 a7                   STAA    T_Q     ; Yes: Save Acc.A
0146 0267 8d e9                      BSR     RD_B    ; Read 2nd character
0147 0269 bd fc 1d                   JSR     VHEX    ; Is it a hex character ?
0148 026c 25 08                      BCS     Z_PRQM  ; No: go to print `?`
0149 026e 16                         TAB             ; Yes: Put it into Acc.B
0150 026f b6 03 a7                   LDAA    T_Q     ; Retrieve 1st hex char to Acc.A
0151 0272 bd fc 31                   JSR     BINARY  ; Convert A:B to binary
0152 0275 39                         RTS             ; RETURN
0153                         Z_PRQM  ;LDAA    #'?     ; Load `?` into A
0154                                 ;BSR     PR_B    ; Print it
0155 0276 20 e5                      BRA     ZINB    ; Go back to start of hex input
0156                         
0157                         ; -----------------------------------------------------
0158                         ; Print character in A to ACIA(b)
0159                         ; -----------------------------------------------------
0160 0278 f6 f4 03           PR_B    LDAB    CTRLB   ; Get ACIA(a) status byte
0161 027b c5 02                      BITB    #02     ; Is it busy ?
0162 027d 27 f9                      BEQ     PR_B    ; Yes: Try again
0163 027f b7 f4 02                   STAA    DATAB   ;  No: Send data
0164 0282 39                 PRB_END RTS             ; RETURN
0165                         
0166                         ; -----------------------------------------------------
0167                         ; Read 4 hex digits and put value into X
0168                         ; -----------------------------------------------------
0169                         RD_XB   ;JSR     PRSPB   ; Print a space
0170 0283 8d d8                      BSR     ZINB    ; Read 2 digit hex value into A
0171 0285 b7 03 a8                   STAA    T_Z     ; Save byte (most significant)
0172 0288 8d d3                      BSR     ZINB    ; Read 2 digit hex value into A
0173 028a b7 03 a9                   STAA    T_Z+1   ; Save byte (least significant)
0174 028d fe 03 a8                   LDX     T_Z     ; Load full 4 hex value into X
0175 0290 39                         RTS             ; RETURN
0176                         
0177                         ; -----------------------------------------------------
0178                         ; Random idle phrase to ports B
0179                         ; -----------------------------------------------------
0180 0291 39                 IDLE    RTS
0181                         
0182                         
0183                         ; -----------------------------------------------------
0184                         ; Prints the message "You weight n stones n pounds"
0185                         ; place stones in MSB of X and pound in LSB
0186                         ; -----------------------------------------------------
0187                         PR_WEIGHT
0188                         
0189                         
0190 0292 ff 03 b1                   STX     TEMP
0191 0295 bd 02 2d                   JSR     STRINGB
0192 0298 59 6f 75 20 77 65          FCC     "You weigh "
     69 67 68 20
0193 02a2 00 ff                      FDB     $FF
0194 02a4 b6 03 b1                   LDAA    TEMP            ; Load high byte of X into Accumulator A
0195 02a7 bd 02 d6                   JSR     PR_NUMB
0196 02aa bd 02 2d                   JSR     STRINGB
0197 02ad 20 73 74 6f 6e 65          FCC     " stones "
     73 20
0198 02b5 00 ff                      FDB     $FF
0199 02b7 b6 03 b2                   LDAA    TEMP+1            ; Load high byte of X into Accumulator A
0200 02ba bd 02 d6                   JSR     PR_NUMB
0201 02bd bd 02 2d                   JSR     STRINGB
0202 02c0 20 70 6f 75 6e 64          FCC     " pounds"
     73
0203 02c7 0d 0a ff                   FCB     $0D, $0A,$FF
0204                         
0205 02ca 39                         RTS
0206                         
0207                         ; -----------------------------------------------------
0208                         ; Prints a space on both consoles (preserves A)
0209                         ; -----------------------------------------------------
0210 02cb 36                 PRSPB   PSHA
0211 02cc 86 20                      LDAA    #$20        ; Put space character in A
0212 02ce bd fc 0f                   JSR     PR_A
0213 02d1 bd 02 78                   JSR     PR_B        ; Print it
0214 02d4 32                         PULA
0215 02d5 39                         RTS                 ; RETURN
0216                         
0217                         
0218                         ; -----------------------------------------------------
0219                         ; Get number word based on value in A
0220                         ; -----------------------------------------------------
0221 02d6 4c                 PR_NUMB     INCA
0222 02d7 ce 02 f2                       LDX     #TEXTBLOCKPTR  ; base of offset table
0223 02da 4a                 PR_NUMB1    DECA
0224 02db 27 04                          BEQ     FOUND
0225 02dd 08                             INX                 ; move to next address
0226 02de 08                             INX
0227 02df 26 f9                          BNE     PR_NUMB1    ; loop around to retest
0228 02e1 a6 00              FOUND       LDAA    0,X
0229 02e3 b7 03 aa                       STAA    T_X
0230 02e6 a6 01                          LDAA    1,X
0231 02e8 b7 03 ab                       STAA    T_X+1
0232 02eb fe 03 aa                       LDX     T_X
0233 02ee bd 02 43                       JSR     STRINGBX
0234 02f1 39                             RTS
0235                         
