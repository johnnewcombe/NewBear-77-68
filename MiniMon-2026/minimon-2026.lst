0624 ff8f 8e f0 d0           START   LDS     #STACK  ; Set up stack for MINMON
0625 ff92 86 11                      LDAA    #$11    ; Set up: 8N2
0626 ff94 b7 f4 01                   STAA    CTRLA   ;   ACIA.A
0627 ff97 bd fc 76                   JSR     STRING  ; Print string...
0628 ff9a 0d 0a 00 2a                FCB     $0D,$0A,$00,'*    ; c/r l/f null `*`
0629 ff9e ff                         FCB     $FF     ; End-of-string
0630 ff9f bd fc 00                   JSR     RD_CMD  ; Read a byte (test for `.`)
0631                         
0632                         
0633                                 ; A already has the command character from RD_CMD
0634 ffa2 ce ff bb                   LDX     #CMDTAB     ; point to command table
0635 ffa5 e6 00              .CMDLP  LDAB    0,X        ; B = key byte (0 ends table)
0636 ffa7 27 0f                      BEQ     .DEFAULT    ; end of table → default to START
0637 ffa9 11                         CBA                 ; compare A vs B
0638 ffaa 27 05                      BEQ     .FOUND      ; match → dispatch
0639 ffac 08                         INX                 ; skip key
0640 ffad 08                         INX                 ; skip FDB high
0641 ffae 08                         INX                 ; skip FDB low
0642 ffaf 20 f4                      BRA     .CMDLP      ; try next entry
0643                         
0644 ffb1 e6 01              .FOUND  LDAB    1,X        ; B = target high byte (FDB stores high,low)
0645 ffb3 a6 02                      LDAA    2,X        ; A = target low byte
0646 ffb5 36                         PSHA                ; push high first
0647 ffb6 37                         PSHB                ; push low — now low is on top of stack
0648                         ;        WAI
0649 ffb7 39                         RTS                 ; jump to target
0650                         
0651 ffb8 7e ff 8f           .DEFAULT JMP     START      ; unknown command → ignore
0652                         
