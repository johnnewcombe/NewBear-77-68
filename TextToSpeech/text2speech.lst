                            278 ; -----------------------------------------------------
                            279 ; Print string FOLLOWING JSR ( terminated by 0xFF ) to
                            280 ; ACIA(b) and ACIA(b)
                            281 ; -----------------------------------------------------
   02D0 30            [ 4]  282 STRINGB: TSX             ; Get loc. of return addr to X
   02D1 EE 00         [ 6]  283         LDX     0,X     ; Get return addr to X
   02D3 09            [ 4]  284         DEX             ; Point to byte before
   02D4 08            [ 4]  285 STRB1:   INX             ; Point to next byte
   02D5 A6 00         [ 5]  286         LDAA    0,X     ; Get byte to be printed
   02D7 81 FF         [ 2]  287         CMPA    #0xFF    ; End-string ?
   02D9 27 07         [ 4]  288         BEQ     ENDSTR  ; Yes: Go to finish up
   02DB BD FC 0F      [ 9]  289         JSR     PR_A    ; Print the byte to ACIA(a) (A is maintained)
   02DE 8D 40         [ 8]  290         BSR     PR_B    ; Print the byte to ACIA(b)
   02E0 20 F2         [ 4]  291         BRA     STRB1   ; Go back for next byte
   02E2 31            [ 4]  292 ENDSTR:  INS             ; Clean up stack...
   02E3 31            [ 4]  293         INS             ;  ( pop off the return addr )
   02E4 6E 01         [ 4]  294         JMP     1,X     ; Jump back to caller (RETURN)
                            295 
                            296 ; -----------------------------------------------------
                            297 ; Prints a string pointed to by X
                            298 ; -----------------------------------------------------
   02E6 A6 00         [ 5]  299 STRINGBX:    LDAA    0,X         ; get char
   02E8 81 FF         [ 2]  300             CMPA    #0xFF        ; is character NULL?
   02EA 27 08         [ 4]  301             BEQ     DONEB       ; yes, end of string
   02EC BD FC 0F      [ 9]  302             JSR     PR_A        ; Print the byte to ACIA(a) (A is maintained)
   02EF 8D 2F         [ 8]  303             BSR     PR_B        ; Print the byte to ACIA(b)
   02F1 08            [ 4]  304             INX
   02F2 20 F2         [ 4]  305             BRA     STRINGBX
   02F4 39            [ 5]  306 DONEB:       RTS
                            307 
                            308 ; -----------------------------------------------------
                            309 ; Reads a character from ACIA(b) into A
                            310 ; -----------------------------------------------------
   02F5 7C 19 B5      [ 6]  311 RD_B:    INC     RND         ; simple way to get a random number
   02F8 B6 F4 03      [ 4]  312         LDAA    CTRLB       ; Get ACIA.A status byte
   02FB 85 01         [ 2]  313         BITA    #01         ; Is byte ready in DATAb
ASxxxx Assembler V05.50.5  (Motorola 6800/6802/6808)                    Page 7
Hexadecimal [16-Bits]                                 Mon May  4 17:14:17 2026



   02FD 27 F6         [ 4]  314         BEQ     RD_B        ; No: Try again
   02FF B6 F4 02      [ 4]  315         LDAA    DATAB       ; Get the data byte to A
   0302 84 7F         [ 2]  316         ANDA    #0x7F        ; Mask off parity bit if it exists
   0304 39            [ 5]  317         RTS                 ; RETURN
                            318 
                            319 ; -----------------------------------------------------
                            320 ;
                            321 ; -----------------------------------------------------
   0305 8D EE         [ 8]  322 ZINB:    BSR     RD_B    ; Read a character
   0307 BD FC 1D      [ 9]  323         JSR     VHEX    ; Is it a hex character ?
   030A 25 12         [ 4]  324         BCS     Z_PRQM  ; No: go to print `?`
   030C B7 19 A5      [ 5]  325         STAA    T_Q     ; Yes: Save Acc.A
   030F 8D E4         [ 8]  326         BSR     RD_B    ; Read 2nd character
   0311 BD FC 1D      [ 9]  327         JSR     VHEX    ; Is it a hex character ?
   0314 25 08         [ 4]  328         BCS     Z_PRQM  ; No: go to print `?`
   0316 16            [ 2]  329         TAB             ; Yes: Put it into Acc.B
   0317 B6 19 A5      [ 4]  330         LDAA    T_Q     ; Retrieve 1st hex char to Acc.A
   031A BD FC 31      [ 9]  331         JSR     BINARY  ; Convert A:B to binary
   031D 39            [ 5]  332         RTS             ; RETURN
   031E                     333 Z_PRQM:  ;LDAA    #'?     ; Load `?` into A
                            334         ;BSR     PR_B    ; Print it
   031E 20 E5         [ 4]  335         BRA     ZINB    ; Go back to start of hex input
                            336 
                            337 
                            338 ; -----------------------------------------------------
                            339 ; Print character in A to ACIA(b)
                            340 ; -----------------------------------------------------
   0320 F6 F4 03      [ 4]  341 PR_B:    LDAB    CTRLB   ; Get ACIA(a) status byte
   0323 C5 02         [ 2]  342         BITB    #02     ; Is it busy ?
   0325 27 F9         [ 4]  343         BEQ     PR_B    ; Yes: Try again
   0327 B7 F4 02      [ 5]  344         STAA    DATAB   ;  No: Send data
   032A 39            [ 5]  345 PRB_END: RTS             ; RETURN
                            346 
                            347 ; -----------------------------------------------------
                            348 ; Read 4 hex digits and put value into X
                            349 ; -----------------------------------------------------
   032B 8D D8         [ 8]  350 RD_XB:   BSR     ZINB    ; Read 2 digit hex value into A
   032D B7 19 A6      [ 5]  351         STAA    T_Z     ; Save byte (most significant)
   0330 8D D3         [ 8]  352         BSR     ZINB    ; Read 2 digit hex value into A
   0332 B7 19 A7      [ 5]  353         STAA    T_Z+1   ; Save byte (least significant)
   0335 FE 19 A6      [ 5]  354         LDX     T_Z     ; Load full 4 hex value into X
   0338 39            [ 5]  355         RTS             ; RETURN
                            356 
                            357 ; -----------------------------------------------------
                            358 ; Adds A to X and leaves the result in X, A is
                            359 ; preserved.
                            360 ; -----------------------------------------------------
   0339 36            [ 4]  361 ADX:     PSHA
   033A FF 19 B0      [ 6]  362         STX     T_TMP
   033D BB 19 B1      [ 4]  363         ADDA    T_TMP+1   ; add A to low byte
   0340 B7 19 B1      [ 5]  364         STAA    T_TMP+1
   0343 B6 19 B0      [ 4]  365         LDAA    T_TMP     ; get high byte
   0346 89 00         [ 2]  366         ADCA    #0      ; add carry only
   0348 B7 19 B0      [ 5]  367         STAA    T_TMP
   034B FE 19 B0      [ 5]  368         LDX     T_TMP
ASxxxx Assembler V05.50.5  (Motorola 6800/6802/6808)                    Page 8
Hexadecimal [16-Bits]                                 Mon May  4 17:14:17 2026



   034E 32            [ 4]  369         PULA
   034F 39            [ 5]  370         RTS
                            371 
                            372 ; -----------------------------------------------------
                            373 ; Loads X with A, A is preserved.
                            374 ; -----------------------------------------------------
   0350 B7 19 B1      [ 5]  375 TAX:    STAA    T_TMP+1       ; store A as low byte of X
   0353 7F 19 B0      [ 6]  376         CLR     T_TMP         ; zero the high byte
   0356 FE 19 B0      [ 5]  377         LDX     T_TMP         ; load X
   0359 39            [ 5]  378         RTS
                            379 
                            380 ; -----------------------------------------------------
                            381 ; Prints the message " n stones n pounds"
                            382 ; place stones in MSB of X and pound in LSB
                            383 ; -----------------------------------------------------
   035A                     384 PR_WEIGHT:
                            385 
   035A FF 19 AE      [ 6]  386         STX     T_W
   035D B6 19 AE      [ 4]  387         LDAA    T_W
   0360 BD 03 50      [ 9]  388         JSR     TAX
   0363 BD 03 C8      [ 9]  389         JSR     PR_WORD         ; n
   0366 BD 03 88      [ 9]  390         JSR     PR_SPCB
   0369 CE 01 2B      [ 3]  391         LDX     #STONES
   036C BD 03 C8      [ 9]  392         JSR     PR_WORD         ; "stones"
   036F BD 03 88      [ 9]  393         JSR     PR_SPCB
   0372 B6 19 AF      [ 4]  394         LDAA    T_W+1            ; Load high byte of X into Accumulator A
   0375 BD 03 50      [ 9]  395         JSR     TAX
   0378 BD 03 C8      [ 9]  396         JSR     PR_WORD         ; n
   037B CE 00 F5      [ 3]  397         LDX     #POUNDS
   037E BD 03 88      [ 9]  398         JSR     PR_SPCB
   0381 BD 03 C8      [ 9]  399         JSR     PR_WORD         ; "pounds"
   0384 BD 03 93      [ 9]  400         JSR     PR_CRB
   0387 39            [ 5]  401         RTS
                            402 
                            403 ; -----------------------------------------------------
                            404 ; Prints a space on both consoles (preserves A)
                            405 ; -----------------------------------------------------
   0388 36            [ 4]  406 PR_SPCB: PSHA
   0389 86 20         [ 2]  407         LDAA    #0x20        ; Put space character in A
   038B BD FC 0F      [ 9]  408         JSR     PR_A
   038E BD 03 20      [ 9]  409         JSR     PR_B        ; Print it
   0391 32            [ 4]  410         PULA
   0392 39            [ 5]  411         RTS                 ; RETURN
                            412 
                            413 ; -----------------------------------------------------
                            414 ; Prints a CRLF on both consoles (preserves A)
                            415 ; -----------------------------------------------------
   0393 36            [ 4]  416 PR_CRB:  PSHA
   0394 86 0D         [ 2]  417         LDAA    #0x0D        ; Put CHAR character in A
   0396 BD FC 0F      [ 9]  418         JSR     PR_A
   0399 BD 03 20      [ 9]  419         JSR     PR_B        ; Print it
   039C 86 0A         [ 2]  420         LDAA    #0x0A
   039E BD FC 0F      [ 9]  421         JSR     PR_A
   03A1 BD 03 20      [ 9]  422         JSR     PR_B        ; Print it
   03A4 32            [ 4]  423         PULA
ASxxxx Assembler V05.50.5  (Motorola 6800/6802/6808)                    Page 9
Hexadecimal [16-Bits]                                 Mon May  4 17:14:17 2026



   03A5 39            [ 5]  424         RTS                 ; RETURN
                            425 
                            426 ; -----------------------------------------------------
                            427 ; Outputs a phrase from the memory location in X
                            428 ; -----------------------------------------------------
   03A6                     429 PR_PHRASE:
                            430 
   03A6 A6 00         [ 5]  431 PR_PH1:  LDAA    0,X         ; get high byte of word
   03A8 E6 01         [ 5]  432         LDAB    1,X         ; get low byte
   03AA 81 FF         [ 2]  433         CMPA    #0xFF        ; check high byte
   03AC 27 19         [ 4]  434         BEQ     PR_PH2      ; high byte is 0xFF so we're done
   03AE FF 19 AA      [ 6]  435 PR_PH3:  STX     T_Y         ; save table pointer
   03B1 B7 19 AC      [ 5]  436         STAA    T_P
   03B4 F7 19 AD      [ 5]  437         STAB    T_P+1
   03B7 FE 19 AC      [ 5]  438         LDX     T_P         ; X now points to the word
   03BA BD 03 C8      [ 9]  439         JSR     PR_WORD
   03BD BD 03 88      [ 9]  440         JSR     PR_SPCB
   03C0 FE 19 AA      [ 5]  441         LDX     T_Y         ; restore table pointer
   03C3 08            [ 4]  442         INX                 ; move to next entry
   03C4 08            [ 4]  443         INX                 ; (2 bytes per entry)
   03C5 20 DF         [ 4]  444         BRA     PR_PH1
   03C7 39            [ 5]  445 PR_PH2:  RTS
                            446 
                            447 ; -----------------------------------------------------
                            448 ; Outputs a word based on value in X
                            449 ; -----------------------------------------------------
   03C8                     450 PR_WORD:
   03C8 FF 19 A8      [ 6]  451             STX     T_X             ; use ASL and ROL to multiply by 2 (pointer is 2 bytes wide)
   03CB 78 19 A9      [ 6]  452             ASL     T_X+1           ; shift low byte left, bit 7 goes to carry
   03CE 79 19 A8      [ 6]  453             ROL     T_X             ; rotate high byte left, carry in from low byte
   03D1 FE 19 A8      [ 5]  454             LDX     T_X
   03D4 FF 19 A8      [ 6]  455             STX     T_X             ; Stash X
   03D7 B6 19 A8      [ 4]  456             LDAA    T_X             ; High byte of X
   03DA F6 19 A9      [ 4]  457             LDAB    T_X+1           ; Low byte of X
   03DD CB FB         [ 2]  458             ADDB    #<WORDPTR    ; Add low byte of WORDPTR address
   03DF 89 03         [ 2]  459             ADCA    #>WORDPTR    ; Add high byte of WORDPTR address + carry
   03E1 B7 19 A8      [ 5]  460             STAA    T_X             ; T_X has the address of the pointer NOT the word
   03E4 F7 19 A9      [ 5]  461             STAB    T_X+1
   03E7 FE 19 A8      [ 5]  462             LDX     T_X             ; X has the address of the pointer NOT the word
                            463 
   03EA A6 00         [ 5]  464             LDAA    0,X             ; get the hi byte of the word
   03EC B7 19 A8      [ 5]  465             STAA    T_X
   03EF A6 01         [ 5]  466             LDAA    1,X             ; get the low byte of the word
   03F1 B7 19 A9      [ 5]  467             STAA    T_X+1
   03F4 FE 19 A8      [ 5]  468             LDX     T_X             ; X now has address of the word
   03F7 BD 02 E6      [ 9]  469             JSR     STRINGBX        ; output the word
   03FA 39            [ 5]  470             RTS
                            471 
