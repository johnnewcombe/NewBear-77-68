output:  JMON.s19
0001                         ; ----------------------------------------------------------------------------
0002                         ; JMON (Jan. 2026)
0003                         ; ----------------------------------------------------------------------------
0004                         ;
0005                         ; Created by GlassTTY, Jan. 2026, using MINIMON (ACH, Dec. 1978) as a base
0006                         ; with additional code from Motorola's MIKBUG.
0007                         ;
0008                         ; Special thanks to Chris Carter for inspiration and help.
0009                         ;
0010                         ; ----------------------------------------------------------------------------
0011                         ;
0012                         ; This is a MINIMON compatible monitor for the 77-68 Bear/Newbear system with
0013                         ; the LOAD and PUNCH commands replaced for versions that support the
0014                         ; Motorola S Record Format (.s19) files.
0015                         ;
0016                         ; All entry points and source code labels as published in the MINIMON
0017                         ; documentation have been preserved with the exception of the LOAD and PUNCH
0018                         ; commands.
0019                         ;
0020                         ; In order to make space for the additional code required, the ALTER and
0021                         ; OFFSET CALCULATION commands have been removed. This has been justified as
0022                         ; the MODIFY command has very similar functionality to ALTER making ALTER
0023                         ; unnecessary, and the OFFSET CALCULATION routines (commands X and Y) are
0024                         ; rarely used as all cross-assemblers perform these calculations
0025                         ; automatically. In addition BLOCKMOVE command (Cmd 'B') has been removed
0026                         ; to allow for a memory test command to be added (Cmd 'T')'.
0027                         ;
0028                         ; One other minor change is that the terminal along with any devices sending
0029                         ; S19 format files have been configured for 8 Data Bits, No Parity, 2 Stop
0030                         ; Bits.
0031                         ;
0032                         ; ----------------------------------------------------------------------------
0033                         
0034 f401                    CTRLA   EQU     $F401   ; ACIA.A Ctrl/Status
0035 f403                    CTRLB   EQU     $F403   ; ACIA.B Ctrl/Status
0036 f400                    DATAA   EQU     $F400   ; ACIA.A Data register
0037 f402                    DATAB   EQU     $F402   ; ACIA.B Data register
0038                         
0039                         ; -----------------------------------------------------
0040                         ; Note:The original 256 bytes of RAM on the CPU board
0041                         ;  appears at $F000 to $F0FE, with Switches/LEDs at $F0FF
0042                         ;  when a MON1 board is installed
0043                         ; -----------------------------------------------------
0044 f0dd                    JNMI    EQU     $F0DD   ; 3 bytes for jump to NMI sub.
0045 f0e0                    JIRQ    EQU     $F0E0   ; 3 bytes for jump to IRQ sub.
0046 f0d0                    STACK   EQU     $F0D0   ; tack goes down from $F0D0
0047                         
0048                         ; -----------------------------------------------------
0049 f0d1                            ORG     $F0D1
0050                         ; -----------------------------------------------------
0051                         
0052                         ; $F0D1 to $F0DC is unused RAM in original  MINIMON
0053 f0d1                    T_TW    RMB     2       ; New additions to support SRec
0054 f0d3                    T_CSUM  RMB     1       ;            "
0055 f0d4                    T_COUNT RMB     1       ;            "
0056 f0d5                    T_TEMP  RMB     1       ;            "
0057                         
0058                         ; -----------------------------------------------------
0059 f0e3                            ORG     $F0E3   ; Start of RAM variables
0060                         ; -----------------------------------------------------
0061                         
0062 f0e3                    T_SAVE  RMB     2       ; Temp storage for NEWLINE
0063 f0e5                    T_P     RMB     1       ;   "     "     "  Z,X
0064 f0e6                    T_X     RMB     2       ;   "     "     "  Sub
0065 f0e8                    T_Y     RMB     2       ;   "     "     "  Sub
0066 f0ea                    T_NEW   RMB     2       ;   "     "     "  Block move
0067 f0ec                    T_M     RMB     1       ;   "     "     "  ZOUT
0068 f0ed                    T_TMPX  RMB     2       ;   "     "     "  PRX
0069 f0ef                    T_STRT  RMB     2       ;   "     "     "  GETADDRESS
0070 f0f1                    T_STOP  RMB     2       ;   "     "     "  GETADDRESS
0071 f0f3                    T_Z     RMB     2       ;   "     "     "   . RDX
0072 f0f5                    T_R     RMB     1       ;   "     "     "     PR
0073 f0f6                    T_Q     RMB     1       ;   "     "     "  ZIN,DUMP 
0074 f0f7                    T_ABYT  RMB     2       ;   "     "     "  SET BR.PT.
0075 f0f9                            RMB     2       ;   "     "     "  SET BR.PT.
0076 f0fb                    T_BYTE  RMB     2       ;   "     "     "  SET BR.PT.
0077 f0fd                    PSTACK  RMB     2       ;   "     "     "     SWI etc
0078                         
0079                         ; -----------------------------------------------------
0080 fc00                            ORG     $FC00   ; Start of ROM based code
0081                         ; -----------------------------------------------------
0082                         
0083                         ; -----------------------------------------------------
0084                         ; Read Character from ACIA
0085                         ; FC00
0086                         ; -----------------------------------------------------
0087 fc00 bd fd 2b           RD_CMD  JSR     RD_A    ; Input one character
0088 fc03 27 fb                      BEQ     RD_CMD  ; Ignore paper tape follower
0089 fc05 8d 08                      BSR     PR_A    ; Echo character
0090 fc07 81 2e                      CMPA    #'.     ; Was it a fullstop ?
0091 fc09 26 11                      BNE     PRA_END ;
0092 fc0b 7e ff 8f                   JMP     START   ; Yes: Go to start of MINIMON
0093                         
0094 fc0e 01                         NOP
0095                         
0096                         ; -----------------------------------------------------
0097                         ; Print character in A
0098                         ; FC0F
0099                         ; -----------------------------------------------------
0100 fc0f f6 f4 01           PR_A    LDAB    CTRLA   ; Get ACIA(a) status byte
0101 fc12 c5 02                      BITB    #02     ; Is it busy ?
0102 fc14 27 f9                      BEQ     PR_A    ; Yes: Try again
0103 fc16 b7 f4 00                   STAA    DATAA   ;  No: Send data
0104 fc19 7c f0 f5                   INC     T_R     ; Characters printed + One
0105 fc1c 39                 PRA_END RTS             ; RETURN
0106                         
0107                         ; -----------------------------------------------------
0108                         ; Check A contains a HEX character,  Set C.bit on fail
0109                         ; FC1D
0110                         ; -----------------------------------------------------
0111 fc1d 81 2f              VHEX    CMPA    #$2F    ; A < 30 ?
0112 fc1f 2f 0e                      BLE     NotHex  ;  not hex
0113 fc21 81 39                      CMPA    #$39    ; A > 39 ?    
0114 fc23 22 02                      BHI     NotNum  ;  Not a Numeral
0115 fc25 0c                 IsHex   CLC             ; It's OK (clear C bit)
0116 fc26 39                         RTS             ; RETURN
0117 fc27 81 40              NotNum  CMPA    #$40    ; A < 41 ?
0118 fc29 2f 04                      BLE     NotHex  ;  not hex
0119 fc2b 81 46                      CMPA    #$46    ; A <= 46
0120 fc2d 2f f6                      BLE     IsHex   ;  then it is hex
0121 fc2f 0d                 NotHex  SEC             ; Set C bit
0122 fc30 39                         RTS             ; RETURN
0123                         
0124                         ; -----------------------------------------------------
0125                         ; Convert A:B to binary
0126                         ; FC31
0127                         ; -----------------------------------------------------
0128 fc31 85 30              BINARY  BITA    #$30    ; Is it a letter ?
0129 fc33 27 0c                      BEQ     LETTA   ; Yes: Got to handle it
0130 fc35 48                 RIDA    ASLA            ;  No: It is a number, so
0131 fc36 48                         ASLA            ;      shift
0132 fc37 48                         ASLA            ;       left
0133 fc38 48                         ASLA            ;        4 bits
0134 fc39 c5 30                      BITB    #$30    ; Is Acc.B a letter ?
0135 fc3b 27 08                      BEQ     LETTB   ; Yes: Go handle it
0136 fc3d c4 0f              RIDB    ANDB    #$0F    ; Clear 4 high bits in Acc.B
0137 fc3f 1b                         ABA             ; Form binary character (A=A+B)
0138 fc40 39                         RTS             ; RETURN
0139 fc41 8b 09              LETTA   ADDA    #$09    ; Make Acc.A a binary
0140 fc43 20 f0                      BRA     RIDA    ;  as before
0141 fc45 cb 09              LETTB   ADDB    #$09    ; Make Acc.B a binary
0142 fc47 20 f4                      BRA     RIDB    ;  as before
0143                         
0144                         ; -----------------------------------------------------
0145                         ; Read a 4 digit HEX value, put result into X
0146                         ; FC49
0147                         ; -----------------------------------------------------
0148 fc49 8d b5              ZIN     BSR     RD_CMD  ; Read a character
0149 fc4b 8d d0                      BSR     VHEX    ; Is it a hex character ?
0150 fc4d 25 10                      BCS     Z_PRQM  ; No: go to print `?`
0151 fc4f b7 f0 f6                   STAA    T_Q     ; Save it
0152 fc52 8d ac                      BSR     RD_CMD  ; Read 2nd character
0153 fc54 8d c7                      BSR     VHEX    ; Is it a hex character ?
0154 fc56 25 07                      BCS     Z_PRQM  ; No: go to print `?`
0155 fc58 16                         TAB             ; Yes: Put it into B
0156 fc59 b6 f0 f6                   LDAA    T_Q     ; Retrieve 1st hex char to A
0157 fc5c 7e fc d8                   JMP     ZIN2    ; S19 version of ZIN is longer
0158 fc5f bd fd 23           Z_PRQM  JSR     PR_QM   ; Print "?"
0159 fc62 7e fc 49                   JMP     ZIN     ; Go back to start of hex input
0160                         
0161                         ; -----------------------------------------------------
0162                         ; Read 4 hex digits and put value into X
0163                         ; FC65
0164                         ; -----------------------------------------------------
0165 fc65 bd fd 4d           RD_X    JSR     PRSP    ; Print a space
0166 fc68 8d df                      BSR     ZIN     ; Read 2 digit hex value into A
0167 fc6a b7 f0 f3                   STAA    T_Z     ; Save byte (most significant)
0168 fc6d 8d da                      BSR     ZIN     ; Read 2 digit hex value into A
0169 fc6f b7 f0 f4                   STAA    T_Z+1   ; Save byte (least significant)
0170 fc72 fe f0 f3                   LDX     T_Z     ; Load full 4 hex value into X
0171 fc75 39                         RTS             ; RETURN
0172                         
0173                         ; -----------------------------------------------------
0174                         ; Print string FOLLOWING JSR ( terminated by $FF )
0175                         ;  IE: It starts at the `return addr` put onto the stack by JSR
0176                         ;  So actual return address needed is past the string
0177                         ; FC76
0178                         ; -----------------------------------------------------
0179 fc76 30                 STRING  TSX             ; Get loc. of return addr to X
0180 fc77 ee 00                      LDX     0,X     ; Get return addr to X
0181 fc79 09                         DEX             ; Point to byte before
0182 fc7a 08                 AGAIN   INX             ; Point to next byte
0183 fc7b a6 00                      LDAA    0,X     ; Get byte to be printed
0184 fc7d 81 ff                      CMPA    #$FF    ; End-string ?
0185 fc7f 27 04                      BEQ     ENDSTR  ; Yes: Go to finish up
0186 fc81 8d 8c                      BSR     PR_A    ; Print the byte
0187 fc83 20 f5                      BRA     AGAIN   ; Go back for next byte
0188 fc85 31                 ENDSTR  INS             ; Clean up stack...
0189 fc86 31                         INS             ;  ( pop off the return addr )
0190 fc87 6e 01                      JMP     1,X     ; Jump back to caller (RETURN)
0191                         
0192                         ; -----------------------------------------------------
0193                         ; FC89
0194                         ; -----------------------------------------------------
0195 fc89 8d eb              GETADD  BSR     STRING  ; Print string...
0196 fc8b 20 53                      FCC     " S"    ;
0197 fc8d ff                         FCB     $FF     ; End-of-string
0198 fc8e 8d d5                      BSR     RD_X    ; Read 4 digit HEX addr value
0199 fc90 ff f0 ef                   STX     T_STRT  ; Save it
0200 fc93 8d e1                      BSR     STRING  ; Print string...
0201 fc95 20 46                      FCC     " F"    ;
0202 fc97 ff                         FCB     $FF     ; End-of-string
0203 fc98 8d cb                      BSR     RD_X    ; Read 4 digit HEX addr value
0204 fc9a ff f0 f1                   STX     T_STOP  ; Save it
0205 fc9d 39                         RTS             ; RETURN
0206                         
0207                         ; -----------------------------------------------------
0208                         ; Convert value in A to 2 x ASCII hex digits in A and B
0209                         ; FC9E
0210                         ; -----------------------------------------------------
0211 fc9e 16                 ASCII   TAB             ; Copy A to B
0212 fc9f 84 f0                      ANDA    #$F0    ; Clear low order 4 bits of A
0213 fca1 44                         LSRA            ; Shift
0214 fca2 44                         LSRA            ;  right
0215 fca3 44                         LSRA            ;   4
0216 fca4 44                         LSRA            ;    bits
0217 fca5 81 09                      CMPA    #$09    ; Letter or number ?
0218 fca7 22 0b                      BHI     SUBT    ; 
0219 fca9 8b 30                      ADDA    #$30    ; Make it an ASCII number
0220 fcab c4 0f              AND     ANDB    #$0F    ; Clear high order bits of B
0221 fcad c1 09                      CMPB    #$09    ; Letter or number ?
0222 fcaf 22 07                      BHI     ADD     ;
0223 fcb1 cb 30                      ADDB    #$30    ; Make it an ASCII number
0224 fcb3 39                         RTS             ; RETURN
0225 fcb4 8b 37              SUBT    ADDA    #$37    ; Make it an ASCI letter
0226 fcb6 20 f3                      BRA     AND     ; Go to process low order value
0227 fcb8 cb 37              ADD     ADDB    #$37    ; Make it an ASII letter
0228 fcba 39                         RTS             ; RETURN
0229                         
0230                         ; -----------------------------------------------------
0231                         ; Print value in X as 4 hex digits
0232                         ; FCBB
0233                         ; -----------------------------------------------------
0234 fcbb ff f0 ed           PRX     STX     T_TMPX  ; Save X
0235 fcbe b6 f0 ed                   LDAA    T_TMPX  ; Get high order byte to A
0236 fcc1 8d 06                      BSR     ZOUT    ; Print A as 2 hex digits
0237 fcc3 b6 f0 ee                   LDAA    T_TMPX+1; Get low order byte to A
0238 fcc6 20 01                      BRA     ZOUT    ; Print A as 2 hex digits
0239                         
0240 fcc8 01                         NOP
0241                         
0242                         ; -----------------------------------------------------
0243                         ; Print value in A as 2 hex digits, Preserve B
0244                         ; X unchanged by called routines
0245                         ; This is 1 byte shorter that original ZOUT
0246                         ; FCC9
0247                         ; -----------------------------------------------------
0248 fcc9 37                 ZOUT    PSHB            ; Save B to STACK
0249 fcca 36                         PSHA            ; Save A to STACK
0250 fccb 8d d1                      BSR     ASCII   ; Convert A to ASCII in A & B
0251 fccd 37                         PSHB            ; Save B (2nd byte) to STACK
0252 fcce bd fc 0f                   JSR     PR_A    ; Print byte in A
0253 fcd1 32                         PULA            ; Get 2nd byte into A from STACK
0254 fcd2 bd fc 0f                   JSR     PR_A    ; Print byte in A
0255 fcd5 32                         PULA            ; Recover A from STACK
0256 fcd6 33                         PULB            ; Recover B from STACK
0257 fcd7 39                         RTS             ; RETURN
0258                         
0259                         
0260                         ; second part of S19 version of ZIN
0261 fcd8 bd fc 31           ZIN2    JSR     BINARY  ; Convert A:B to binary to A
0262 fcdb 16                         TAB             ; B=A
0263 fcdc fb f0 d3                   ADDB    T_CSUM  ; Add this value
0264 fcdf f7 f0 d3                   STAB    T_CSUM  ; to the Checksum (for S19)
0265 fce2 39                         RTS             ; RETURN
0266                         
0267                         ; -----------------------------------------------------
0268                         ; S19 format data load : Modded version of Mikbug code
0269                         ; -----------------------------------------------------
0270 fce3                    LOAD    EQU     *       ; L = Load = Input an S19 file
0271 fce3 8d 91                      BSR     STRING
0272 fce5 0d 0a                      FCB     $0D,$0A ; c/r l/f
0273 fce7 ff                         FCB     $FF     ; End-Of-String
0274 fce8 bd fc 00           LREAD   JSR     RD_CMD  ; Read+Echo, test for '.'
0275 fceb 84 7f                      ANDA    #$7F    ; Mask off parity bit if it exists
0276 fced 81 53                      CMPA    #'S     ; Is it `S` ?
0277 fcef 26 f7                      BNE     LREAD   ; No: Keep waiting for `S`
0278 fcf1 bd fc 00                   JSR     RD_CMD  ; Read+Echo, test for '.'
0279 fcf4 81 39                      CMPA    #'9     ; Is it `9` ?  ( `S9` record )
0280 fcf6 26 03                      BNE     LREAD1
0281 fcf8 7e fe b3                   JMP     STERMR  ; handle termination record
0282 fcfb 81 31              LREAD1  CMPA    #'1     ; Is it `1` ?  ( `S1` record )
0283 fcfd 26 e9                      BNE     LREAD   ; No: Wait for next `S`
0284 fcff 7f f0 d3                   CLR     T_CSUM  ; Clear checksum
0285 fd02 bd fc 49                   JSR     ZIN     ; Read 2xHex = data.byte count to A
0286 fd05 80 02                      SUBA    #2      ; Subtract 2 (to get bytes left in line)
0287 fd07 b7 f0 d4                   STAA    T_COUNT ; Store byte count
0288 fd0a bd fc 65                   JSR     RD_X    ; Read 4xHex digit address to X
0289 fd0d bd fc 49           LDOBYT  JSR     ZIN     ; Read 2xHex digits, value to A
0290 fd10 7a f0 d4                   DEC     T_COUNT ; Decrement our byte count
0291 fd13 27 05                      BEQ     LCHK    ; If end-of-line, go look at checksum
0292 fd15 a7 00                      STAA    0,X     ; Save byte where X points
0293 fd17 08                         INX             ; Point X at next byte
0294 fd18 20 f3                      BRA     LDOBYT  ; Go get next byte
0295 fd1a 7c f0 d3           LCHK    INC     T_CSUM  ; Add 1 to checksum
0296 fd1d 27 c9                      BEQ     LREAD   ; OK: Go read next record
0297 fd1f 8d 02                      BSR     PR_QM   ; Print "?"
0298 fd21 20 27                      BRA     STARTR  ; Go to START
0299                         
0300 fd23 86 3f              PR_QM   LDAA #'?        ; Put '?' character in A
0301 fd25 7e fc 0f                   JMP     PR_A    ; Print it and return via PR_As RTS
0302                         
0303 fd28 01                         NOP
0304 fd29 01                         NOP
0305 fd2a 01                         NOP
0306                         
0307                         ; -----------------------------------------------------
0308                         ; Read byte from ACIA.A to A
0309                         ; FD2B
0310                         ; -----------------------------------------------------
0311 fd2b b6 f4 01           RD_A    LDAA    CTRLA   ; Get ACIA.A status byte
0312 fd2e 85 01                      BITA    #$01    ; Is byte ready in DATAA
0313 fd30 27 f9                      BEQ     RD_A    ; No: Try again
0314 fd32 b6 f4 00                   LDAA    DATAA   ; Get the data byte to A
0315 fd35 39                         RTS             ; RETURN
0316                         
0317                         ; -----------------------------------------------------
0318                         ; FD36
0319                         ; -----------------------------------------------------
0320 fd36 8d 15              REGPRT  BSR     PRSP    ; Print a space
0321 fd38 fe f0 fd                   LDX     PSTACK  ; Point X at user's stack
0322 fd3b 8d 1c                      BSR     PR2     ; Print CC
0323 fd3d 8d 1a                      BSR     PR2     ; Print B
0324 fd3f 8d 18                      BSR     PR2     ; Print A
0325 fd41 8d 10                      BSR     PR4     ; Print X
0326 fd43 8d 0e                      BSR     PR4     ; Print PC
0327 fd45 ce f0 fd                   LDX     #PSTACK ; Point X at stack pointer
0328 fd48 8d 0a                      BSR     PR4X    ; Print stack pointer
0329 fd4a 7e ff 8f           STARTR  JMP     START  ; (RETURN) to MINIMON
0330                         
0331                         
0332                         ; -----------------------------------------------------
0333                         ; FD4D
0334                         ; -----------------------------------------------------
0335 fd4d 86 20              PRSP    LDAA    #$20    ; Put space character in A
0336 fd4f bd fc 0f                   JSR     PR_A    ; Print it
0337 fd52 39                         RTS             ; RETURN
0338 fd53 08                 PR4     INX             ; Point X to next character
0339 fd54 a6 00              PR4X    LDAA    0,X     ; Get byte pointed to by X
0340 fd56 bd fc c9                   JSR     ZOUT    ; Print it
0341 fd59 08                 PR2     INX             ; Point X to next character
0342 fd5a a6 00                      LDAA    0,X     ; Get byte pointed to by X
0343 fd5c bd fc c9                   JSR     ZOUT    ; Print it
0344 fd5f 8d ec                      BSR     PRSP    ; Print a space
0345 fd61 39                         RTS             ; RETURN
0346                         
0347                         ; -----------------------------------------------------
0348                         ; FD62
0349                         ; -----------------------------------------------------
0350 fd62 bd fc 89           MEMTEST JSR     GETADD      ; get the start and finish addresses
0351 fd65 bd fc 76                   JSR     STRING
0352 fd68 20 54 45 53 54 49          FCC     " TESTING..."
     4e 47 2e 2e 2e
0353 fd73 0d 0a ff                   FCB     $0D,$0A,$FF
0354 fd76 5f                         CLRB                ; set up accumulators
0355 fd77 37                 .TST    PSHB
0356 fd78 bd fc 76                   JSR     STRING
0357 fd7b 0d ff                      FCB     $0D,$FF
0358 fd7d 33                         PULB
0359 fd7e 17                         TBA
0360 fd7f bd fc c9                   JSR     ZOUT
0361 fd82 fe f0 ef                   LDX     T_STRT      ; put start address in X
0362 fd85 4f                         CLRA
0363 fd86 1b                 .LOOP1  ABA                 ; create the pattern
0364 fd87 a7 00                      STAA    0,X         ; Write to memory
0365 fd89 08                         INX
0366 fd8a bc f0 f1                   CPX     T_STOP      ; Check for end of memory
0367 fd8d 26 f7                      BNE     .LOOP1
0368 fd8f fe f0 ef                   LDX     T_STRT
0369 fd92 4f                         CLRA
0370 fd93 1b                 .LOOP2  ABA
0371 fd94 a1 00                      CMPA     0,X        ; Read from memory
0372 fd96 26 1d                      BNE     .FAULT
0373 fd98 08                 .NOPR   INX
0374 fd99 bc f0 f1                   CPX     T_STOP
0375 fd9c 26 f5                      BNE     .LOOP2
0376 fd9e b6 f4 01                   LDAA    CTRLA       ; Read ACIA status
0377 fda1 85 01                      BITA    #$01        ; Key waiting?
0378 fda3 26 03                      BNE     .END        ; Yes so end the test
0379 fda5 5c                         INCB                ; change the pattern and repeat
0380 fda6 26 cf                      BNE     .TST        ; we loop the test 256 times
0381 fda8 b6 f4 00           .END    LDAA    DATAA       ; Clear a byte from ACIA
0382 fdab bd fc 76                   JSR     STRING
0383 fdae 20 4f 4b                   FCC     " OK"
0384 fdb1 ff                         FCB     $FF
0385 fdb2 7e ff 8f                   JMP     START
0386 fdb5 bd fe 97           .FAULT  JSR     NEWLINE
0387 fdb8 bd fc 76                   JSR     STRING
0388 fdbb 20 46 4c 54                FCC     " FLT"
0389 fdbf ff                         FCB     $FF
0390 fdc0 7e ff 8f                   JMP START
0391                         
0392                         ; -----------------------------------------------------
0393                         ; FDC3
0394                         ; -----------------------------------------------------
0395 fdc3 bd fc 76           VERSION JSR     STRING
0396 fdc6 20 56 45 52 20 31          FCC     " VER 1.0"
     2e 30
0397 fdce ff                         FCB     $FF
0398 fdcf 7e ff 8f                   JMP     START
0399                         
0400 fdd2 01                         NOP
0401 fdd3 01                         NOP
0402 fdd4 01                         NOP
0403 fdd5 01                         NOP
0404                         
0405                         ; -----------------------------------------------------
0406                         ; FDD6
0407                         ; -----------------------------------------------------
0408 fdd6 ce f0 e6           SUB     LDX     #T_X    ; Point X to start of T_X data
0409 fdd9 a6 01                      LDAA    1,X     ; A = T_X (low)
0410 fddb e6 00                      LDAB    0,X     ; B = T_X (high)
0411 fddd a0 03                      SUBA    3,X     ; A = A - T_Y (low)
0412 fddf e2 02                      SBCB    2,X     ; B = B - T_Y (high)
0413 fde1 39                         RTS             ; RETURN
0414                         
0415                         ; -----------------------------------------------------
0416                         ; S format data output : Modded version of Mikbug code
0417                         ; -----------------------------------------------------
0418 fde2 bd fc 89           PUNCH   JSR     GETADD      ; Prompt for "Start:","Stop:"
0419 fde5 fe f0 ef                   LDX     T_STRT      ; Get start address
0420 fde8 ff f0 d1                   STX     T_TW        ; save it to work area
0421 fdeb b6 f0 f2           POUT1   LDAA    T_STOP+1    ; get low order of end address
0422 fdee b0 f0 d2                   SUBA    T_TW+1      ; Subtract low order start
0423 fdf1 f6 f0 f1                   LDAB    T_STOP      ; ( carry not affected by LDA )
0424 fdf4 f2 f0 d1                   SBCB    T_TW        ; Subtract with Carry
0425 fdf7 26 04                      BNE     POUT2
0426 fdf9 81 10                      CMPA    #16
0427 fdfb 25 02                      BCS     POUT3
0428 fdfd 86 0f              POUT2   LDAA    #15
0429 fdff 8b 04              POUT3   ADDA    #4
0430 fe01 b7 f0 d4                   STAA    T_COUNT     ; FRAME COUNT THIS RECORD
0431 fe04 80 03                      SUBA    #3
0432 fe06 b7 f0 d5                   STAA    T_TEMP      ; BYTE COUNT THIS RECORD
0433 fe09 bd fc 76                   JSR     STRING      ; Output this string...
0434 fe0c 0d 0a                      FCB     $0D,$0A     ; c/r l/f
0435 fe0e 53 31                      FCB     'S,'1       ; S1
0436 fe10 ff                         FCB     $FF         ; End-Of-String
0437 fe11 5f                         CLRB                ; Clear checksum
0438                         
0439                         ; Output frame count...
0440 fe12 ce f0 d4                   LDX     #T_COUNT    ; X = Address of Framecount
0441 fe15 bd fe a8                   JSR     POUTH2      ; O/P byte <-X and inc X
0442                         
0443                         ; Output address...
0444 fe18 ce f0 d1                   LDX     #T_TW
0445 fe1b bd fe a8                   JSR     POUTH2      ; O/P byte <-X and inc X
0446 fe1e bd fe a8                   JSR     POUTH2      ; O/P byte <-X and inc X
0447                         
0448                         ; Output data...
0449 fe21 fe f0 d1                   LDX     T_TW
0450 fe24 bd fe a8           POUT4   JSR     POUTH2      ; O/P byte <-X and inc X
0451 fe27 7a f0 d5                   DEC     T_TEMP      ; Decrement `bytes left` count
0452 fe2a 26 f8                      BNE     POUT4       ; Loop back if any left
0453 fe2c ff f0 d1                   STX     T_TW
0454 fe2f 53                         COMB
0455 fe30 37                         PSHB
0456 fe31 30                         TSX                ; X = S + 1
0457 fe32 8d 74                      BSR     POUTH2     ; PUNCH CHECKSUM
0458 fe34 33                         PULB
0459 fe35 fe f0 d1                   LDX     T_TW
0460 fe38 09                         DEX
0461 fe39 bc f0 f1                   CPX     T_STOP
0462 fe3c 26 ad                      BNE     POUT1
0463 fe3e 7e ff d9                   JMP     STERMS
0464                         
0465 fe41 01                         NOP
0466 fe42 01                         NOP
0467                         
0468                         ; -----------------------------------------------------
0469                         ; FE43
0470                         ; -----------------------------------------------------
0471 fe43 bd fc 65           MODIFY  JSR     RD_X    ; Get address to X
0472 fe46 bd fd 4d           STRT    JSR     PRSP    ; Print a space
0473 fe49 7f f0 f5                   CLR     T_R     ; T_R = 0
0474 fe4c a6 00              PRz     LDAA    0,X     ; Get byte pointed to by X to A
0475 fe4e bd fc c9                   JSR     ZOUT    ; Print it as 2.hex digits
0476 fe51 bd fc 00           WATSIT  JSR     RD_CMD  ; Get command character
0477 fe54 81 20              WHAT    CMPA    #$20    ; Is it a space ?
0478 fe56 26 0c                      BNE     ISSLSH  ; No: go test for slash
0479 fe58 08                 CARYON  INX             ; Increment X
0480 fe59 b6 f0 f5                   LDAA    T_R     ; A = T_R
0481 fe5c 81 16                      CMPA    #$16    ; At end of line ?
0482 fe5e 2f ec                      BLE     PRz     ; No: Loop back to continue
0483 fe60 8d 35              NEW_1   BSR     NEWLINE ; Print c/r l/f nul
0484 fe62 20 e2                      BRA     STRT    ; Loop back (Note: Hex was wrong in doc, E2 instead of E5)
0485                         
0486 fe64 81 2f              ISSLSH  CMPA    #'/     ; Is it a slash ?
0487 fe66 26 03                      BNE     ISCRET  ; No: go test for c/r
0488 fe68 09                         DEX             ; X = X - 1
0489 fe69 20 f5                      BRA     NEW_1   ; Loop back (print newline)
0490                         
0491 fe6b 81 0d              ISCRET  CMPA    #$0D    ; Is it a c/r ?
0492 fe6d 26 03                      BNE     ISHEX   ; No: go test for valid Hex
0493 fe6f 08                         INX             ; X = X + 1
0494 fe70 20 ee                      BRA     NEW_1   ; Loop back (print newline)
0495                         
0496 fe72 bd fc 1d           ISHEX   JSR     VHEX    ; Is it a valid hex character ?
0497 fe75 25 19                      BCS     PRQM    ; No: print `?` and ignore
0498 fe77 b7 f0 f6                   STAA    T_Q     ; T_Q = A : Save it
0499 fe7a bd fc 00                   JSR     RD_CMD  ; Get 2nd character
0500 fe7d bd fc 1d                   JSR     VHEX    ; Is it a valid hex character ?
0501 fe80 25 d2                      BCS     WHAT    ; No: then see what it is
0502 fe82 16                         TAB             ; B = A
0503 fe83 b6 f0 f6                   LDAA    T_Q     ; A = T_Q
0504 fe86 bd fc 31                   JSR     BINARY  ; Convert to binary value
0505 fe89 a7 00                      STAA    0,X     ; Store it
0506 fe8b bd fd 4d                   JSR     PRSP    ; Print a space
0507 fe8e 20 c8                      BRA     CARYON  ; Loop back
0508                         
0509 fe90 86 3f              PRQM    LDAA    #'?     ; Put `?` into A
0510 fe92 bd fc 0f                   JSR     PR_A    ; Print it
0511 fe95 20 ba                      BRA     WATSIT  ; Loop back
0512                         
0513 fe97 ff f0 e3           NEWLINE STX     T_SAVE  ; Save X
0514 fe9a bd fc 76                   JSR     STRING  ; Print string...
0515 fe9d 0d 0a 00                   FCB     $0D,$0A,$00
0516 fea0 ff                         FCB     $FF     ; End-of-string
0517 fea1 fe f0 e3                   LDX     T_SAVE  ; Restore X
0518 fea4 bd fc bb                   JSR     PRX     ; Print X
0519 fea7 39                         RTS             ; RETURN
0520                         
0521 fea8 eb 00              POUTH2 ADDB    0,X      ; Update checksum
0522 feaa 36                         PSHA            ; Push A to STACK
0523 feab a6 00                      LDAA    0,X     ; Load byte to be o/p
0524 fead bd fc c9                   JSR     ZOUT    ; O/P byte <- X
0525 feb0 32                         PULA            ; Pull A off STACK
0526 feb1 08                         INX             ; Increment X
0527 feb2 39                         RTS             ; RETURN
0528                         
0529                         ; Processes the termination record which, if we get here is an S9 record
0530                         ; A will contain the umber of bytes to follow (should be 39h i.e. ASCII '9')
0531                         ; which means there are left to absorb.
0532 feb3 ce 00 08           STERMR  LDX     #8      ; get the number of bytes left in record
0533 feb6 bd fc 00           STERM1  JSR     RD_CMD  ; read and echo from ACIA and ignore
0534 feb9 09                         DEX
0535 feba 26 fa                      BNE     STERM1   ; loop for remaining bytes
0536 febc 7e ff 8f           STARTS  JMP     START
0537                         
0538 febf 01                         NOP
0539 fec0 01                         NOP
0540 fec1 01                         NOP
0541                         
0542                         ; -----------------------------------------------------
0543                         ; FEC2
0544                         ; -----------------------------------------------------
0545 fec2 bd fc 65           GO      JSR     RD_X    ; Get address to X (16.bit)
0546 fec5 bd fc 00                   JSR     RD_CMD  ; Right address ?
0547 fec8 b6 f0 f4                   LDAA    T_Z+1   ; T_Z.low to A
0548 fecb f6 f0 f3                   LDAB    T_Z     ; T_Z.high to B
0549 fece fe f0 fd           GOTO    LDX     PSTACK  ; Callers stack address to X
0550 fed1 a7 07                      STAA    7,X     ; Put new return
0551 fed3 e7 06                      STAB    6,X     ; address on stack
0552 fed5 be f0 fd                   LDS     PSTACK  ; Set up calling programs stack
0553 fed8 3b                         RTI             ; RETURN-FROM-INTERRUPT (SWI)
0554                         
0555                         ; -----------------------------------------------------
0556                         ; FED9
0557                         ; -----------------------------------------------------
0558 fed9 bd fc 00           CONTNU  JSR     RD_CMD  ; Read a byte (test for `.`)
0559 fedc 81 31                      CMPA    #'1     ; Is it `1` ?
0560 fede 26 10                      BNE     IsIt2  ; No: go test for `2`
0561 fee0 fe f0 f7                   LDX     T_ABYT  ; Get address of break.point
0562 fee3 b6 f0 fb                   LDAA    T_BYTE  ; Get saved opcode
0563 fee6 a7 00                      STAA    0,X     ; Put it back in the program
0564 fee8 b6 f0 f8                   LDAA    T_ABYT+1 ; Get address at which
0565 feeb f6 f0 f7                   LDAB    T_ABYT  ;   to re-enter program
0566 feee 20 de                      BRA     GOTO    ; Go to calling program
0567                         
0568 fef0 81 32              IsIt2   CMPA    #'2     ; Is it `2`
0569 fef2 27 03                      BEQ     G_Is2   ; Yes: go process it
0570 fef4 7e ff 8f                   JMP     START   ; No: Return to MINIMON
0571 fef7 fe f0 f9           G_Is2   LDX     T_ABYT+2 ; Get addr. of break.point 2
0572 fefa b6 f0 fc                   LDAA    T_BYTE+1 ; Get old opcode
0573 fefd a7 00                      STAA    0,X      ; Put it back
0574 feff b6 f0 fa                   LDAA    T_ABYT+3 ; Load address to start
0575 ff02 f6 f0 f9                   LDAB    T_ABYT+2 ;  running program at
0576 ff05 20 c7                      BRA     GOTO    ; Run user program
0577                         
0578                         ; -----------------------------------------------------
0579                         ; FF07
0580                         ; -----------------------------------------------------
0581 ff07 bd fc 89           DUMP    JSR     GETADD  ; Prompt for boundary addresses
0582 ff0a fe f0 ef                   LDX     T_STRT  ;
0583 ff0d bd fe 97           D_NEW   JSR     NEWLINE ; Print c/r l/f nul
0584 ff10 86 08                      LDAA    #$08    ;
0585 ff12 b7 f0 f6                   STAA    T_Q     ; T_Q = 8
0586 ff15 09                         DEX             ; X = X - 1
0587 ff16 08                 D_NXT   INX             ; X = X + 1
0588 ff17 bd fd 4d                   JSR     PRSP    ; Print a space
0589 ff1a a6 00                      LDAA    0,X     ; Get a byte
0590 ff1c bd fc c9                   JSR     ZOUT    ; Print it as 2.hex digits
0591 ff1f bc f0 f1                   CPX     T_STOP  ; Finished ?
0592 ff22 26 06                      BNE     D_CNT   ; No: Carry on
0593 ff24 b6 f4 00           D_END   LDAA    DATAA   ; Get a byte from ACIA (clear)
0594 ff27 7e ff 8f                   JMP     START   ; Return to MINIMON
0595 ff2a b6 f4 01           D_CNT   LDAA    CTRLA   ; Read ACIA status
0596 ff2d 85 01                      BITA    #$01    ; Stop dump ?
0597 ff2f 26 f3                      BNE     D_END   ; Yes; go clear ACIA etc
0598 ff31 7a f0 f6                   DEC     T_Q     ; New line needed ?
0599 ff34 26 e0                      BNE     D_NXT   ; No: Loop back
0600 ff36 08                         INX             ; Print next byte
0601 ff37 20 d4                      BRA     D_NEW   ;  on a new line
0602                         
0603                         ; -----------------------------------------------------
0604                         ; FF39
0605                         ; -----------------------------------------------------
0606 ff39 bd fc 00           BRPTSET JSR     RD_CMD  ; Read a byte (test for `.`)
0607 ff3c 81 31                      CMPA    #'1     ; Is it `1` ?
0608 ff3e 26 12                      BNE     Is2b    ; No: go test for `2`
0609 ff40 bd fc 65                   JSR     RD_X    ; Read addr value into X
0610 ff43 a6 00                      LDAA    0,X     ; Get the opcode
0611 ff45 b7 f0 fb                   STAA    T_BYTE  ; Save it
0612 ff48 ff f0 f7                   STX     T_ABYT  ; and the address
0613 ff4b 86 3f              SAME    LDAA    #$3F    ; `SWI` opcode :
0614 ff4d a7 00                      STAA    0,X     ;   set the breakpoint
0615 ff4f 7e ff 8f           ENDB    JMP     START   ; Return to MINIMON
0616 ff52 81 32              Is2b    CMPA    #'2     ; Is it `2` ?
0617 ff54 26 f9                      BNE     ENDB   ; No: Return to MINIMON
0618 ff56 bd fc 65                   JSR     RD_X    ; Read address into X
0619 ff59 a6 00                      LDAA    0,X     ; Get opcode
0620 ff5b b7 f0 fc                   STAA    T_BYTE+1 ; Save it
0621 ff5e ff f0 f9                   STX     T_ABYT+2 ; Save address
0622 ff61 20 e8                      BRA     SAME    ; Set the breakpoint
0623                         
