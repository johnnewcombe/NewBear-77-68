0532 ff0a fe f0 ef                   LDX     T_STRT  ;
0533 ff0d bd fe 97           D_NEW   JSR     NEWLINE ; Print c/r l/f nul
0534 ff10 86 08                      LDAA    #$08    ;
0535 ff12 b7 f0 f6                   STAA    T_Q     ; T_Q = 8
0536 ff15 09                         DEX             ; X = X - 1
0537 ff16 08                 D_NXT   INX             ; X = X + 1
0538 ff17 bd fd 4d                   JSR     PRSP    ; Print a space
0539 ff1a a6 00                      LDAA    0,X     ; Get a byte
0540 ff1c bd fc c9                   JSR     ZOUT    ; Print it as 2.hex digits
0541 ff1f bc f0 f1                   CPX     T_STOP  ; Finished ?
0542 ff22 26 06                      BNE     D_CNT   ; No: Carry on
0543 ff24 b6 f4 00           D_END   LDAA    DATAA   ; Get a byte from ACIA (clear)
0544 ff27 7e ff 8f                   JMP     START   ; Return to MINIMON
0545 ff2a b6 f4 01           D_CNT   LDAA    CTRLA   ; Read ACIA status
0546 ff2d 85 01                      BITA    #$01    ; Stop dump ?
0547 ff2f 26 f3                      BNE     D_END   ; Yes; go clear ACIA etc
0548 ff31 7a f0 f6                   DEC     T_Q     ; New line needed ?
0549 ff34 26 e0                      BNE     D_NXT   ; No: Loop back
