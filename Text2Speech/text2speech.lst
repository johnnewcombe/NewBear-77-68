   0168                      77 MAINLOOP:
                             78 ; -----------------------------------------------------
                             79 ; Data arrives at port B as four hex characters
                             80 ; -----------------------------------------------------
   0168 BD 02 F1      [ 9]   81                 JSR     GETDATA         ; value in T_WEIGHT, stones in A
   016B 25 03         [ 4]   82                 BCS     ML1             ; is it invalid i.e. carry clear
   016D 7E 01 EB      [ 3]   83                 JMP     IDLE
   0170 7D 1B 59      [ 6]   84 ML1:            TST     PROCESSING_FLG  ; are we already processing a weight
   0173 26 F3         [ 4]   85                 BNE     MAINLOOP        ; flag non-zero so ignore everything that follows
   0175 7C 1B 59      [ 6]   86                 INC     PROCESSING_FLG  ; ignore any following data until we next idle
   0178 81 14         [ 2]   87                 CMPA    #TOO_HEAVY      ; more that 20 is too heavy
   017A 22 3B         [ 4]   88                 BHI     OVERLOADED
   017C B6 1B 51      [ 4]   89                 LDAA    T_WEIGHT+1      ; validate pounds
   017F 81 0D         [ 2]   90                 CMPA    #13             ; invalid pounds
   0181 22 4E         [ 4]   91                 BHI     IERROR          ; internal error
   0183 BD 02 23      [ 9]   92                 JSR     GREET           ; send a greeting message
                             93 
                             94                 ; get the weight a second time, this should allow the scales time to settle
   0186 BD 02 F1      [ 9]   95                 JSR     GETDATA
                             96 
