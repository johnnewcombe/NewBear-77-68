   02B7 80 64         [ 2]  259         SUBA    #100    ; Sub 100
   02B9 5C            [ 2]  260         INCB            ; Increment hundred counter
   02BA 20 F7         [ 4]  261         BRA     HUND
                            262 
   02BC F7 19 B2      [ 5]  263 TENS:    STAB    DEC     ; store the hundreds
                            264 
   02BF 5F            [ 2]  265         CLRB
   02C0 81 0A         [ 2]  266 TENS1:   CMPA    #10     ; 10 or more?
   02C2 2D 05         [ 4]  267         BLT     UNITS
   02C4 80 0A         [ 2]  268         SUBA    #10     ; Sub 10
   02C6 5C            [ 2]  269         INCB            ; Increment ten counter
   02C7 20 F7         [ 4]  270         BRA     TENS1
                            271 
