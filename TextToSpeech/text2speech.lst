ASxxxx Assembler V05.50.5  (Motorola 6800/6802/6808)                   Page 59
Hexadecimal [16-Bits]                                 Sun May 10 20:24:13 2026



                            506 
                            507 ; -----------------------------------------------
                            508 ; LED Pattern Display - MC6800
                            509 ; -----------------------------------------------
   1B6B                     510 PANEL_DISP:
                            511 
                            512 ; --- Main loop ---
   1B6B CE 1B 8F      [ 3]  513 PSTART: LDX     #PTABLE     ; Point X at start of table
   1B6E A6 00         [ 5]  514 NXTVAL: LDAA    ,X          ; Load pattern value from table
   1B70 B7 F0 FF      [ 5]  515         STAA    PANEL       ; Send to LED port
                            516         ;JSR     ZOUT        ; X not affected
   1B73 8D 0D         [ 8]  517         BSR     DELAY       ; Delay so we can see it
   1B75 08            [ 4]  518         INX                 ; Advance to next entry
   1B76 8C 1B 99      [ 3]  519         CPX     #PTEND      ; Reached end of table?
   1B79 26 F3         [ 4]  520         BNE     NXTVAL      ; No - go again
   1B7B 7A 1B B3      [ 6]  521         DEC     SYLLABLES   ; decrement the syllables to mimic
                            522                             ;  this doesn't affect carry
   1B7E 27 0E         [ 4]  523         BEQ     PDONE       ; head to nearest RTS
   1B80 20 E9         [ 4]  524         BRA     PSTART      ; Yes - loop back to beginning
                            525 
                            526 ; --- Delay routine ---
                            527 ; Kills time so the eye can see each LED pattern
   1B82 FF 1B A4      [ 6]  528 DELAY:  STX     T_TMP
   1B85 CE 0B 00      [ 3]  529         LDX     #DELAY_VAL  ; Load delay count
   1B88 09            [ 4]  530 DLOOP:  DEX                 ; Decrement
   1B89 26 FD         [ 4]  531         BNE     DLOOP       ; Not zero - keep counting
   1B8B FE 1B A4      [ 5]  532         LDX     T_TMP
   1B8E 39            [ 5]  533 PDONE:  RTS                 ; Done
                            534 
                            535 ; --- Pattern table ---
   1B8F FF                  536 PTABLE: .FCB     0xFF         ; 1111 1111
   1B90 E7                  537         .FCB     0xE7         ; 1110 0111
   1B91 C3                  538         .FCB     0xC3         ; 1100 0011
   1B92 81                  539         .FCB     0x81         ; 1000 0001
   1B93 00                  540         .FCB     0x00         ; 0000 0000
   1B94 81                  541         .FCB     0x81         ; 1000 0001
   1B95 C3                  542         .FCB     0xC3         ; 1100 0011
   1B96 E7                  543         .FCB     0xE7         ; 1110 0111
   1B97 FF                  544         .FCB     0xFF         ; 1111 1111
   1B98 00                  545         .fcb     0X00         ; 0000 0000
   1B99                     546 PTEND:                        ; Address just past end of table
                            547 
                            548 ; -----------------------------------------------------
                            549 ; Reserved memory
                            550 ; -----------------------------------------------------
                            551 
   1B99                     552 T_Q:             .rmb     1       ; Temp storage for ZIN
   1B9A                     553 T_Z:             .rmb     2       ;   "     "     "  RDX
   1B9C                     554 T_X:             .rmb     2       ;   "     "     "  PR_WORD
   1B9E                     555 T_Y:             .rmb     2       ;   "     "     "  table pointer
   1BA0                     556 T_P:             .rmb     2       ;   "     "     "  PR_PHRASE
   1BA2                     557 T_W:             .rmb     2       ;   "     "     "  PR_WEIGHT
   1BA4                     558 T_TMP:           .rmb     2       ;   "     "     "  within subroutine
   1BA6                     559 RND:             .rmb     1       ; holds a random number (see RD_B
   1BA7                     560 TEMP:            .rmb     2       ; temp var (non subroutine use)
ASxxxx Assembler V05.50.5  (Motorola 6800/6802/6808)                   Page 60
Hexadecimal [16-Bits]                                 Sun May 10 20:24:13 2026



   1BA9                     561 T_WEIGHT:        .rmb     2       ; holds value of weight following a call to GETDATA
                            562 
                            563 ; these are cleared at start up
   1BAB                     564 IDLE_COUNT:      .rmb     1       ; counts the number of empty measurement reports
   1BAC                     565 IDLE_MSG_ID:     .rmb     1       ; holds value of next idle message to use
   1BAD                     566 GREET_MSG_ID:    .rmb     1       ; holds value of next greeting message to use
   1BAE                     567 LIGHT_MSG_ID:    .rmb     1       ; holds value of next light weight message to use
   1BAF                     568 NORMAL_MSG_ID:   .rmb     1       ; holds value of next normal weight message to use
   1BB0                     569 HEAVY_MSG_ID:    .rmb     1       ; holds value of next heavy weight message to use
   1BB1                     570 SHEAVY_MSG_ID:   .rmb     1       ; holds value of next super heavy weight message to use
   1BB2                     571 PROCESSING_FLG:  .rmb     1       ; non-zero indicates that that a weight is being processed
                            572                                   ;   all following weight data is ignored until the next
                            573                                   ;   idle (0000h) data resets it.
   1BB3                     574 SYLLABLES:       .rmb     1       ; number of phrase syllables for the panel LED routines
                            575                                   ;  this is updated each time a word is transmitted and
                            576                                   ;  when PANELDISP is called, usually after acall to PR_PHRASE
                            577                                   ;  the lights are manipulated.
