                     01FF    39 STACK           .equ    0x01FF
                     F400    40 DATAA           .equ    0xF400          ; ACIA(a) Data register
                     F401    41 CTRLA           .equ    0xF401          ; ACIA(a) Ctrl/Status
                     F402    42 DATAB           .equ    0xF402          ; ACIA(b) Data register
                     F403    43 CTRLB           .equ    0xF403          ; ACIA(b) Ctrl/Status
                             44 
                             45 ; MINIMON routines
                     FC76    46 STRING          .equ    0xFC76          ; Prints a string.
                     FC89    47 GETADD          .equ    0xFC89          ; Get Address, read 4 digit hex value.
                     FCC9    48 ZOUT            .equ    0xFCC9          ; Print value in A as 2 hex digits.
                     FE97    49 NEWLINE         .equ    0xFE97          ; Prints a new line.
                     FF8F    50 START           .equ    0xFF8F          ; Restarts MniMon.
                     FC0F    51 PR_A            .equ    0xFC0F          ; Print char in A to ACIA (a)
                     FD2B    52 RD_A            .equ    0xFD2B          ; Read char from A
                     FD4D    53 PRSP            .equ    0xFD4D          ; Print a space
                     FC31    54 BINARY          .equ    0xFC31          ; Converts ASCII hex digits in A and B to binary?
                     FC65    55 RD_X            .equ    0xFC65          ; Read 4 hex digits Value from ACIA(a) and put value into X.
