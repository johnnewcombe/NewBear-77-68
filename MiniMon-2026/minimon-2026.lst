0596 ff39 bd fc 00           BRPTSET JSR     RD_CMD  ; Read a byte (test for `.`)
0597 ff3c 81 31                      CMPA    #'1     ; Is it `1` ?
0598 ff3e 26 12                      BNE     Is2b    ; No: go test for `2`
0599 ff40 bd fc 65                   JSR     RD_X    ; Read addr value into X
0600 ff43 a6 00                      LDAA    0,X     ; Get the opcode
0601 ff45 b7 f0 fb                   STAA    T_BYTE  ; Save it
0602 ff48 ff f0 f7                   STX     T_ABYT  ; and the address
0603 ff4b 86 3f              SAME    LDAA    #$3F    ; `SWI` opcode :
0604 ff4d a7 00                      STAA    0,X     ;   set the breakpoint
0605 ff4f 7e ff 8f           ENDB    JMP     START   ; Return to MINIMON
0606 ff52 81 32              Is2b    CMPA    #'2     ; Is it `2` ?
0607 ff54 26 f9                      BNE     ENDB   ; No: Return to MINIMON
0608 ff56 bd fc 65                   JSR     RD_X    ; Read address into X
0609 ff59 a6 00                      LDAA    0,X     ; Get opcode
0610 ff5b b7 f0 fc                   STAA    T_BYTE+1 ; Save it
0611 ff5e ff f0 f9                   STX     T_ABYT+2 ; Save address
0612 ff61 20 e8                      BRA     SAME    ; Set the breakpoint
