0364                         PR_PHRASE
0365 03db 4c                         INCA
0366 03dc ce 04 4b                   LDX     #PHRASEPTR  ; load address of phrase ponter
0367                                                     ; table
0368 03df 4a                 PR_PH1  DECA                ; loop through A times to get
0369 03e0 27 04                      BEQ     FOUNDP      ;   address of phrase
0370 03e2 08                         INX                 ; move to next address
0371 03e3 08                         INX
0372 03e4 20 f9                      BRA     PR_PH1      ; try again
0373                         
0374 03e6 a6 00              FOUNDP  LDAA    0,X         ; transfer addr pointed to by X to memory
0375 03e8 b7 06 9b                   STAA    T_P         ; MSB
0376 03eb a6 01                      LDAA    1,X         ;
0377 03ed b7 06 9c                   STAA    T_P+1       ; LSB
0378 03f0 fe 06 9b           PR_PH3  LDX     T_P         ; load X
0379 03f3 a6 00                      LDAA    0,X         ; get word id
0380 03f5 08                         INX                 ; point X to next word
0381 03f6 ff 06 9b                   STX     T_P         ; store X away
0382 03f9 81 00                      CMPA    #0
0383 03fb 27 08                      BEQ     PR_PH2      ; no more words
0384 03fd bd 04 06                   JSR     PR_WORD     ; print word based on value in A
0385 0400 bd 03 bd                   JSR     PR_SPCB
0386 0403 20 eb                      BRA     PR_PH3      ; next word
0387 0405 39                 PR_PH2  RTS
0388                         
