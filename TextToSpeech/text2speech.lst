0087                         ; -----------------------------------------------------
0088                         ; Random idle phrase to ports B
0089                         ; -----------------------------------------------------
0090 0238 39                 IDLE    RTS
0091                         
0092                         ;--------------------------------------------------------------
0093                         ; DECIMAL CONVERSION EXAMPLE
0094                         ;--------------------------------------------------------------
0095                                 ;JSR     PR_DEC          ; puts 3 decimal digits in DEC, DEC+1 and DEC+2
0096                                 ;LDAA    DEC+1           ; don't care about the hundreds        ADDA    #$30
0097                                 ;JSR     PR_WORD
0098                                 ;JSR     PR_SPCB
0099                                 ;LDAA    DEC+2
0100                                 ;JSR     PR_WORD
0101                         
0102                         ; -----------------------------------------------------
0103                         ; PR_DEC: Puts 3 decimal digits in DEC, DEC+1 and DEC+2
0104                         ;
0105                         ;       !! ONLY WORKS WITH VALUES BELOW 128 !!
0106                         ; -----------------------------------------------------
0107 0239 5f                 PR_DEC  CLRB            ; Clear B for hundreds
0108                         
0109 023a 81 64              HUND    CMPA    #100    ; 100 or more?
0110                         
0111 023c 2d 05                      BLT     TENS
0112 023e 80 64                      SUBA    #100    ; Sub 100
0113 0240 5c                         INCB            ; Increment hundred counter
0114 0241 20 f7                      BRA     HUND
0115                         
0116 0243 f7 04 4d           TENS    STAB    DEC     ; store the hundreds
0117                         
0118 0246 5f                         CLRB
0119 0247 81 0a              TENS1   CMPA    #10     ; 10 or more?
0120 0249 2d 05                      BLT     UNITS
0121 024b 80 0a                      SUBA    #10     ; Sub 10
0122 024d 5c                         INCB            ; Increment ten counter
0123 024e 20 f7                      BRA     TENS1
0124                         
0125 0250 f7 04 4e           UNITS   STAB    DEC+1
0126 0253 b7 04 4f                   STAA    DEC+2   ; Final remainder is units
0127                         
0128 0256 39                         RTS
0129                         
0130                         
0131                         ; -----------------------------------------------------
0132                         ; Print string FOLLOWING JSR ( terminated by $FF ) to
0133                         ; ACIA(b) and ACIA(b)
0134                         ; -----------------------------------------------------
0135 0257 30                 STRINGB TSX             ; Get loc. of return addr to X
0136 0258 ee 00                      LDX     0,X     ; Get return addr to X
0137 025a 09                         DEX             ; Point to byte before
0138 025b 08                 AGAIN   INX             ; Point to next byte
0139 025c a6 00                      LDAA    0,X     ; Get byte to be printed
0140 025e 81 ff                      CMPA    #$FF    ; End-string ?
0141 0260 27 07                      BEQ     ENDSTR  ; Yes: Go to finish up
0142 0262 bd fc 0f                   JSR     PR_A    ; Print the byte to ACIA(a) (A is maintained)
0143 0265 8d 40                      BSR     PR_B    ; Print the byte to ACIA(b)
0144 0267 20 f2                      BRA     AGAIN   ; Go back for next byte
0145 0269 31                 ENDSTR  INS             ; Clean up stack...
0146 026a 31                         INS             ;  ( pop off the return addr )
0147 026b 6e 01                      JMP     1,X     ; Jump back to caller (RETURN)
0148                         
0149                         ; -----------------------------------------------------
0150                         ; Prints a string pointed to by X
0151                         ; -----------------------------------------------------
0152 026d a6 00              STRINGBX    LDAA    0,X         ; get char
0153 026f 81 ff                          CMPA    #$FF        ; is character NULL?
0154 0271 27 08                          BEQ     DONEB       ; yes, end of string
0155 0273 bd fc 0f                       JSR     PR_A        ; Print the byte to ACIA(a) (A is maintained)
0156 0276 8d 2f                          BSR     PR_B        ; Print the byte to ACIA(b)
0157 0278 08                             INX
0158 0279 20 f2                          BRA     STRINGBX
0159 027b 39                 DONEB       RTS
0160                         
0161                         ; -----------------------------------------------------
0162                         ; Reads a character from ACIA(b) into A
0163                         ; -----------------------------------------------------
0164 027c 7c 04 50           RD_B    INC     RND         ; simple way to get a random number
0165 027f b6 f4 03                   LDAA    CTRLB       ; Get ACIA.A status byte
0166 0282 85 01                      BITA    #01         ; Is byte ready in DATAb
0167 0284 27 f6                      BEQ     RD_B        ; No: Try again
0168 0286 b6 f4 02                   LDAA    DATAB       ; Get the data byte to A
0169 0289 84 7f                      ANDA    #$7F        ; Mask off parity bit if it exists
0170 028b 39                         RTS                 ; RETURN
0171                         
0172                         ; -----------------------------------------------------
0173                         ;
0174                         ; -----------------------------------------------------
0175 028c 8d ee              ZINB    BSR     RD_B    ; Read a character
0176 028e bd fc 1d                   JSR     VHEX    ; Is it a hex character ?
0177 0291 25 12                      BCS     Z_PRQM  ; No: go to print `?`
0178 0293 b7 04 44                   STAA    T_Q     ; Yes: Save Acc.A
0179 0296 8d e4                      BSR     RD_B    ; Read 2nd character
0180 0298 bd fc 1d                   JSR     VHEX    ; Is it a hex character ?
0181 029b 25 08                      BCS     Z_PRQM  ; No: go to print `?`
0182 029d 16                         TAB             ; Yes: Put it into Acc.B
0183 029e b6 04 44                   LDAA    T_Q     ; Retrieve 1st hex char to Acc.A
0184 02a1 bd fc 31                   JSR     BINARY  ; Convert A:B to binary
0185 02a4 39                         RTS             ; RETURN
0186                         Z_PRQM  ;LDAA    #'?     ; Load `?` into A
0187                                 ;BSR     PR_B    ; Print it
0188 02a5 20 e5                      BRA     ZINB    ; Go back to start of hex input
0189                         
0190                         ; -----------------------------------------------------
0191                         ; Print character in A to ACIA(b)
0192                         ; -----------------------------------------------------
0193 02a7 f6 f4 03           PR_B    LDAB    CTRLB   ; Get ACIA(a) status byte
0194 02aa c5 02                      BITB    #02     ; Is it busy ?
0195 02ac 27 f9                      BEQ     PR_B    ; Yes: Try again
0196 02ae b7 f4 02                   STAA    DATAB   ;  No: Send data
0197 02b1 39                 PRB_END RTS             ; RETURN
0198                         
0199                         ; -----------------------------------------------------
0200                         ; Read 4 hex digits and put value into X
0201                         ; -----------------------------------------------------
0202 02b2 8d d8              RD_XB   BSR     ZINB    ; Read 2 digit hex value into A
0203 02b4 b7 04 45                   STAA    T_Z     ; Save byte (most significant)
0204 02b7 8d d3                      BSR     ZINB    ; Read 2 digit hex value into A
0205 02b9 b7 04 46                   STAA    T_Z+1   ; Save byte (least significant)
0206 02bc fe 04 45                   LDX     T_Z     ; Load full 4 hex value into X
0207 02bf 39                         RTS             ; RETURN
0208                         
0209                         ; -----------------------------------------------------
0210                         ; Prints the message " n stones n pounds"
0211                         ; place stones in MSB of X and pound in LSB
0212                         ; -----------------------------------------------------
0213                         PR_WEIGHT
0214 02c0 ff 04 4b                   STX     T_W
0215 02c3 b6 04 4b                   LDAA    T_W             ; Load high byte of X into Accumulator A
0216 02c6 bd 03 2f                   JSR     PR_WORD         ; n
0217 02c9 bd 02 e6                   JSR     PR_SPCB
0218 02cc 86 1b                      LDAA    #$1B
0219 02ce bd 03 2f                   JSR     PR_WORD         ; "stones"
0220 02d1 bd 02 e6                   JSR     PR_SPCB
0221 02d4 b6 04 4c                   LDAA    T_W+1            ; Load high byte of X into Accumulator A
0222 02d7 bd 03 2f                   JSR     PR_WORD         ; n
0223 02da 86 1c                      LDAA    #$1C
0224 02dc bd 02 e6                   JSR     PR_SPCB
0225 02df bd 03 2f                   JSR     PR_WORD         ; "pounds"
0226 02e2 bd 02 f1                   JSR     PR_CRB
0227 02e5 39                         RTS
0228                         
0229                         ; -----------------------------------------------------
0230                         ; Prints a space on both consoles (preserves A)
0231                         ; -----------------------------------------------------
0232 02e6 36                 PR_SPCB   PSHA
0233 02e7 86 20                      LDAA    #$20        ; Put space character in A
0234 02e9 bd fc 0f                   JSR     PR_A
0235 02ec bd 02 a7                   JSR     PR_B        ; Print it
0236 02ef 32                         PULA
0237 02f0 39                         RTS                 ; RETURN
0238                         
0239                         ; -----------------------------------------------------
0240                         ; Prints a CRLF on both consoles (preserves A)
0241                         ; -----------------------------------------------------
0242 02f1 36                 PR_CRB  PSHA
0243 02f2 86 0d                      LDAA    #$0D        ; Put CHAR character in A
0244 02f4 bd fc 0f                   JSR     PR_A
0245 02f7 bd 02 a7                   JSR     PR_B        ; Print it
0246 02fa 86 0a                      LDAA    #$0A
0247 02fc bd fc 0f                   JSR     PR_A
0248 02ff bd 02 a7                   JSR     PR_B        ; Print it
0249 0302 32                         PULA
0250 0303 39                         RTS                 ; RETURN
0251                         
0252                         ; -----------------------------------------------------
0253                         ; Outputs a phrase from the value in A
0254                         ; -----------------------------------------------------
0255                         PR_PHRASE
0256 0304 4c                         INCA
0257 0305 ce 03 85                   LDX     #PHRASEPTR  ; load address of phrase ponter
0258                                                     ; table
0259 0308 4a                 PR_PH1  DECA                ; loop through A times to get
0260 0309 27 04                      BEQ     FOUNDP      ;   address of phrase
0261 030b 08                         INX                 ; move to next address
0262 030c 08                         INX
0263 030d 20 f9                      BRA     PR_PH1      ; try again
0264 030f a6 00              FOUNDP  LDAA    0,X         ; transfer addr pointed to by X to memory
0265 0311 b7 04 49                   STAA    T_P         ; MSB
0266 0314 a6 01                      LDAA    1,X         ;
0267 0316 b7 04 4a                   STAA    T_P+1       ; LSB
0268 0319 fe 04 49           PR_PH3  LDX     T_P         ; load X
0269 031c a6 00                      LDAA    0,X         ; get word id
0270 031e 08                         INX                 ; point X to next word
0271 031f ff 04 49                   STX     T_P         ; store X away
0272 0322 81 00                      CMPA    #0
0273 0324 27 08                      BEQ     PR_PH2      ; no more words
0274 0326 bd 03 2f                   JSR     PR_WORD     ; print word based on value in A
0275 0329 bd 02 e6                   JSR     PR_SPCB
0276 032c 20 eb                      BRA     PR_PH3      ; next word
0277 032e 39                 PR_PH2  RTS
0278                         
0279                         ; -----------------------------------------------------
0280                         ; Outputs a word based on value in A
0281                         ; -----------------------------------------------------
0282 032f 4c                 PR_WORD     INCA
0283 0330 ce 03 4b                       LDX     #WORDPTR  ; base of offset table
0284 0333 4a                 PR_WORD1    DECA
0285 0334 27 04                          BEQ     FOUNDW
0286 0336 08                             INX                 ; move to next address
0287 0337 08                             INX
0288 0338 26 f9                          BNE     PR_WORD1    ; loop around to retest
0289 033a a6 00              FOUNDW      LDAA    0,X
0290 033c b7 04 47                       STAA    T_X
0291 033f a6 01                          LDAA    1,X
0292 0341 b7 04 48                       STAA    T_X+1
0293 0344 fe 04 47                       LDX     T_X
0294 0347 bd 02 6d                       JSR     STRINGBX
0295 034a 39                             RTS
