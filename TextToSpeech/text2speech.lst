0416 042e 4c                 PR_WORD     INCA
0417 042f ce 06 2c                       LDX     #WORDPTR  ; base of offset table
0418 0432 4a                 PR_WORD1    DECA
0419 0433 27 04                          BEQ     FOUNDW
0420 0435 08                             INX                 ; move to next address
0421 0436 08                             INX
0422 0437 26 f9                          BNE     PR_WORD1    ; loop around to retest
0423 0439 a6 00              FOUNDW      LDAA    0,X
0424 043b b7 06 c1                       STAA    T_X
0425 043e a6 01                          LDAA    1,X
0426 0440 b7 06 c2                       STAA    T_X+1
0427 0443 fe 06 c1                       LDX     T_X
0428 0446 bd 03 6c                       JSR     STRINGBX
0429 0449 39                             RTS
