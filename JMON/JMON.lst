0711 ffd9 bd fc 76           STERMS  JSR     STRING
0712 ffdc 0d 0a                      FCB     $0D,$0A
0713 ffde 53 39 30 33 30 30          FCC     "S9030000FC"
     30 30 46 43
0714 ffe8 ff                         FCB     $FF
0715 ffe9 20 a4                      BRA     START
0716                         
