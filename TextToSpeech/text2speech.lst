0131 01c9 26 04                      BNE     GREET_OP        ; still at valid id so output idle message
0132 01cb 7f 19 55                   CLR     GREET_MSG_ID    ; beyond last message so reset the current msg to zero
0133 01ce 4f                         CLRA                    ; set currentid back to 0
