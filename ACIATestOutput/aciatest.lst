output:  aciatest.s19
0001 f400                    DATAA   EQU     $F400   ; ACIA.A Data register
0002 f401                    CTRLA   EQU     $F401   ; ACIA.A Ctrl/Status
0003 f402                    DATAB   EQU     $F402   ; ACIA.B Data register
0004 f403                    CTRLB   EQU     $F403   ; ACIA.B Ctrl/Status
0005 f0ff                    DISPLAY EQU     $F0FF   ; LEDs
0006                         
0007 ff00                            ORG     $FF00
0008 ff00 4c                 START   INCA
0009 ff01 b7 f0 ff                   STAA    DISPLAY
0010 ff04 f6 f4 01           LOOP    LDAB    CTRLA   ; get ACIA status
0011 ff07 c5 02                      BITB    #2      ; wait for TX buffer empty
0012 ff09 27 f9                      BEQ     LOOP
0013                         
0014 ff0b b7 f4 00                   STAA    DATAA   ; send char to port
0015 ff0e 20 f0                      BRA     START   ; repeat
0016                         
0017 fffe                            ORG     $FFFE
0018                         
0019 fffe ff 00                      FDB     START
0020                         
0021                                 END
