                            506 
   1B41                     507 T_Q:             .rmb     1       ; Temp storage for ZIN
   1B42                     508 T_Z:             .rmb     2       ;   "     "     "  RDX
   1B44                     509 T_X:             .rmb     2       ;   "     "     "  PR_WORD
   1B46                     510 T_Y:             .rmb     2       ;   "     "     "  table pointer
   1B48                     511 T_P:             .rmb     2       ;   "     "     "  PR_PHRASE
   1B4A                     512 T_W:             .rmb     2       ;   "     "     "  PR_WEIGHT
   1B4C                     513 T_TMP:           .rmb     2       ;   "     "     "  within subroutine
   1B4E                     514 TEMP:            .rmb     2       ; temp var (non subroutine use)
   1B50                     515 T_WEIGHT:        .rmb     2       ; holds value of weight following a call to GETDATA
                            516 
                            517 ; these are cleared at start up
   1B52                     518 IDLE_COUNT:      .rmb     1       ; counts the number of empty measurement reports
   1B53                     519 IDLE_MSG_ID:     .rmb     1       ; holds value of next idle message to use
   1B54                     520 GREET_MSG_ID:    .rmb     1       ; holds value of next greeting message to use
   1B55                     521 LIGHT_MSG_ID:    .rmb     1       ; holds value of next light weight message to use
   1B56                     522 NORMAL_MSG_ID:   .rmb     1       ; holds value of next normal weight message to use
   1B57                     523 HEAVY_MSG_ID:    .rmb     1       ; holds value of next heavy weight message to use
   1B58                     524 SHEAVY_MSG_ID:   .rmb     1       ; holds value of next super heavy weight message to use
   1B59                     525 PROCESSING_FLG:  .rmb     1       ; non-zero indicates that that a weight is being processed
                            526                                   ;   all following weight data is ignored until the next
                            527                                   ;   idle (0000h) data resets it.
   1B5A                     528 WORDS:           .rmb     1       ; number of words for the panel LED routines
                            529                                   ;  this is updated each time a word is transmitted.
