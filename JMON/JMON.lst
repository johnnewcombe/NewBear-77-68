0627 ff63 bd fc 76           HEADER  JSR     STRING  ; print string...
0628 ff66 20 43 43                   FCC     " CC"   ;
0629 ff69 20 42 20                   FCC     " B "   ;
0630 ff6c 20 41 20                   FCC     " A "   ;
0631 ff6f 20 20 58                   FCC     "  X"   ;
0632 ff72 20 20 20                   FCC     "   "   ;
0633 ff75 20 50 43                   FCC     " PC"   ;
0634 ff78 20 20 20                   FCC     "   "   ;
0635 ff7b 53 50                      FCC     "SP"    ;
0636 ff7d ff                         FCB     $FF     ; End-of-string
0637 ff7e 20 0f                      BRA     START   ; Return to MINIMON
0638                         
0639 ff80 01                         NOP
