0303 0341 4c                 PR_WORD     INCA
0304 0342 ce 05 2d                       LDX     #WORDPTR  ; base of offset table
0305 0345 4a                 PR_WORD1    DECA
0306 0346 27 04                          BEQ     FOUNDW
0307 0348 08                             INX                 ; move to next address
0308 0349 08                             INX
0309 034a 26 f9                          BNE     PR_WORD1    ; loop around to retest
0310 034c a6 00              FOUNDW      LDAA    0,X
0311 034e b7 05 c2                       STAA    T_X
0312 0351 a6 01                          LDAA    1,X
0313 0353 b7 05 c3                       STAA    T_X+1
0314 0356 fe 05 c2                       LDX     T_X
