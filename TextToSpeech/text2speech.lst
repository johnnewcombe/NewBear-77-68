                            240 ;END:     JMP     MAINLOOP  ;START   ; all done
                            241 
                            242 ;--------------------------------------------------------------
                            243 ; Gets the weight data from the scales and rerurns with carry
                            244 ; set if a valid reading, carry clear otherwise. A valid weight
                            245 ; reading resets the idle count. Data received is stored in
                            246 ; T_WEIGHT and MSB in A.
                            247 ;--------------------------------------------------------------
   02C1                     248 GETDATA:
   02C1 BD 03 4E      [ 9]  249         JSR     RD_XB           ; read 4 hex characters into X
   02C4 FF 1A 09      [ 6]  250         STX     T_WEIGHT        ; store X
   02C7 0C            [ 2]  251         CLC
   02C8 B6 1A 09      [ 4]  252         LDAA    T_WEIGHT        ; get fist byte (stones)
   02CB 27 04         [ 4]  253         BEQ     GDDONE          ; idle message
   02CD 7F 00 0A      [ 6]  254         CLR     IDLE_SECS       ; not an idle message so reset the idle counter
   02D0 0D            [ 2]  255         SEC                     ; non idle message return with carry set
   02D1 39            [ 5]  256 GDDONE:  RTS
                            257 
                            258 ;--------------------------------------------------------------
