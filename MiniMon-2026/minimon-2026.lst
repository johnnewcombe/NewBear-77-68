output:  minimon-2026.s19
0001                         ; ------------------------------------------------------
0002                         ; Minimon
0003                         ; ------------------------------------------------------
0004                         ;  Original author ACH, Dec.1978;
0005                         ; ------------------------------------------------------
0006                         ; 13 NOV 2025 : [JN] added NOP at FFF7 to remove gap to
0007                         ;             : allow easier conversion to bin from s19
0008                         ; 05 DEC 2025 : [JN] Changed ACIA(a) to be 8N2 to match
0009                         ;             : PROM. So that MiniMon can be loaded and
0010                         ;             : run from the same terminal config.
0011                         ; ------------------------------------------------------
0012                         ; 2 x ACIAs :-
0013                         ;
0014                         
0015 f401                    CTRLA   EQU     $F401   ; ACIA.A Ctrl/Status
0016 f403                    CTRLB   EQU     $F403   ; ACIA.B Ctrl/Status
0017 f400                    DATAA   EQU     $F400   ; ACIA.A Data register
0018 f402                    DATAB   EQU     $F402   ; ACIA.B Data register
0019                         
0020                         ; Note:The original 256 bytes of RAM on the CPU board 
0021                         ;  appears at $F000 to $F0FE, with Switches/LEDs at $F0FF
0022                         ;  when a MON1 board is installed
0023                         
0024                         ; Stack goes down from $F0D0
0025 f0d0                    STACK   EQU     $F0D0   ; Top of MINIMON's stack
0026                         
0027                         
0028                         
0029                         ; RAM at $F0D1 to $F0DC appears to be unused
0030                         
0031                         ; 3 bytes reserved for each if NMI and IRQ handling
0032                         ; so an application can write JMP <addr> into those
0033                         ; places if those interrupts are wanted...
0034                         
0035 f0dd                    JNMI    EQU     $F0DD   ; Space for jump to NMI sub.
0036 f0e0                    JIRQ    EQU     $F0E0   ; Space for jump to IRQ sub.
0037                         
0038                         ; -----------------------------------------------------
0039 f0de                            ORG     $F0DE   ; Start of RAM variables
0040                         ; -----------------------------------------------------
0041                         ; Note: Temp storage variables renamed to get T_ prefix
0042                         ;       as some were sharing names with labels or registers
0043                         ;
0044                         ; New additions to support S19 additions
0045                         ;d_RdFstX    RMB     2       ;  "  RD_ByteFast X
0046                         ;d_Hx4X      RMB     2       ;  "  RDX4 PRX4
0047 f0de                    d_TW        RMB     2       ;  "  S19
0048                         ;d_STOP      RMB     2       ;  "  ASK_Addrs `Stop:`
0049 f0e0                    b_Csum      RMB     1       ;  "  S19
0050 f0e1                    b_Count     RMB     1       ;  "  S19
0051 f0e2                    b_Temp      RMB     1       ;  "  S19
0052                         ;d_START     RMB     2       ;  "  ASK_Start `Start:`
0053                         ;b_Q         RMB     1       ;  "  ZIN,DUMP
0054                         
0055 f0e3                    T_SAVE  RMB     2       ; Temp storage for NEWLINE
0056 f0e5                    T_P     RMB     1       ;   "     "     "  Z,X
0057 f0e6                    T_X     RMB     2       ;   "     "     "  Sub
0058 f0e8                    T_Y     RMB     2       ;   "     "     "  Sub
0059 f0ea                    T_NEW   RMB     2       ;   "     "     "  Block move
0060 f0ec                    T_M     RMB     1       ;   "     "     "  ZOUT
0061 f0ed                    T_TMPX  RMB     2       ;   "     "     "  PRX
0062 f0ef                    T_STRT  RMB     2       ;   "     "     "  GETADDRESS
0063 f0f1                    T_STOP  RMB     2       ;   "     "     "  GETADDRESS
0064 f0f3                    T_Z     RMB     2       ;   "     "     "   . RDX
0065 f0f5                    T_R     RMB     1       ;   "     "     "     PR
0066 f0f6                    T_Q     RMB     1       ;   "     "     "  ZIN,DUMP 
0067 f0f7                    T_ABYT  RMB     2       ;   "     "     "  SET BR.PT.
0068 f0f9                            RMB     2       ;   "     "     "  SET BR.PT.
0069 f0fb                    T_BYTE  RMB     2       ;   "     "     "  SET BR.PT.
0070 f0fd                    PSTACK  RMB     2       ;   "     "     "     SWI etc
0071                         
0072                         
0073                         
0074                         ;
0075                         ; -----------------------------------------------------
0076 fc00                            ORG     $FC00   ; Start of ROM based code
0077                         ; -----------------------------------------------------
0078 fc00 bd fd 2b           RD_CMD  JSR     RD_A    ; Input one character 
0079 fc03 27 fb                      BEQ     RD_CMD  ; Ignore paper tape follower
0080 fc05 8d 08                      BSR     PR_A    ; Echo character
0081 fc07 81 2e                      CMPA    #'.     ; Was it a fullstop ?
0082 fc09 26 03                      BNE     END_RD  ;
0083 fc0b 7e ff 8c                   JMP     START   ; Yes: Go to start of MINIMON
0084 fc0e 39                 END_RD  RTS             ;  No: RETURN
0085                         
0086                         ; -----------------------------------------------------
0087                         ; Print character in A
0088                         
0089 fc0f f6 f4 01           PR_A    LDAB    CTRLA   ; Get ACIA(a) status byte
0090 fc12 c5 02                      BITB    #02     ; Is it busy ?
0091 fc14 27 f9                      BEQ     PR_A    ; Yes: Try again
0092 fc16 b7 f4 00                   STAA    DATAA   ;  No: Send data
0093 fc19 7c f0 f5                   INC     T_R     ; Characters printed + One
0094 fc1c 39                         RTS             ; RETURN
0095                         
0096                         ; -----------------------------------------------------
0097                         ; Check A contains a HEX character,  Set C.bit on fail
0098                         
0099 fc1d 81 2f              VHEX    CMPA    #$2F    ; A < 30 ?
0100 fc1f 2f 0e                      BLE     NotHex  ;  not hex
0101 fc21 81 39                      CMPA    #$39    ; A > 39 ?    
0102 fc23 22 02                      BHI     NotNum  ;  Not a Numeral
0103 fc25 0c                 IsHex   CLC             ; It's OK (clear C bit)
0104 fc26 39                         RTS             ; RETURN
0105 fc27 81 40              NotNum  CMPA    #$40    ; A < 41 ?
0106 fc29 2f 04                      BLE     NotHex  ;  not hex
0107 fc2b 81 46                      CMPA    #$46    ; A <= 46
0108 fc2d 2f f6                      BLE     IsHex   ;  then it is hex
0109 fc2f 0d                 NotHex  SEC             ; Set C bit
0110 fc30 39                         RTS             ; RETURN
0111                         
0112                         ; -----------------------------------------------------
0113                         
0114 fc31 85 30              BINARY  BITA    #$30    ; Is it a letter ?
0115 fc33 27 0c                      BEQ     LETTA   ; Yes: Got to handle it
0116 fc35 48                 RIDA    ASLA            ;  No: It is a number, so
0117 fc36 48                         ASLA            ;      shift
0118 fc37 48                         ASLA            ;       left
0119 fc38 48                         ASLA            ;        4 bits
0120 fc39 c5 30                      BITB    #$30    ; Is Acc.B a letter ?
0121 fc3b 27 08                      BEQ     LETTB   ; Yes: Go handle it
0122 fc3d c4 0f              RIDB    ANDB    #$0F    ; Clear 4 high bits in Acc.B
0123 fc3f 1b                         ABA             ; Form binary character (A=A+B)
0124 fc40 39                         RTS             ; RETURN
0125 fc41 8b 09              LETTA   ADDA    #$09    ; Make Acc.A a binary
0126 fc43 20 f0                      BRA     RIDA    ;  as before
0127 fc45 cb 09              LETTB   ADDB    #$09    ; Make Acc.B a binary
0128 fc47 20 f4                      BRA     RIDB    ;  as before
0129                         
0130                         ; -----------------------------------------------------
0131                         ; Read a 4 digit HEX value, put result into X
0132                         
0133 fc49 8d b5              ZIN         BSR     RD_CMD      ; Read a character
0134 fc4b 8d d0                          BSR     VHEX        ; Is it a hex character ?
0135 fc4d 25 10                          BCS     Z_PRQM      ; No: go to print `?`
0136 fc4f b7 f0 f6                       STAA    T_Q         ; Save it
0137 fc52 8d ac                          BSR     RD_CMD      ; Read 2nd character
0138 fc54 8d c7                          BSR     VHEX        ; Is it a hex character ?
0139 fc56 25 07                          BCS     Z_PRQM      ; No: go to print `?`
0140 fc58 16                             TAB                 ; Yes: Put it into B
0141 fc59 b6 f0 f6                       LDAA    T_Q         ; Retrieve 1st hex char to A
0142 fc5c 7e fc db                       JMP     ZIN2        ; S19 version of ZIN is longer
0143 fc5f bd fd 26           Z_PRQM      JSR     PR_QM       ; Print "?"
0144 fc62 7e fc 49                       JMP     ZIN      ; Go back to start of hex input
0145                         
0146                         ; -----------------------------------------------------
0147                         ; Read 4 hex digits and put value into X
0148                         ;FC65
0149 fc65 bd fd 4d           RD_X    JSR     PRSP    ; Print a space
0150 fc68 8d df                      BSR     ZIN     ; Read 2 digit hex value into A
0151 fc6a b7 f0 f3                   STAA    T_Z     ; Save byte (most significant)
0152 fc6d 8d da                      BSR     ZIN     ; Read 2 digit hex value into A
0153 fc6f b7 f0 f4                   STAA    T_Z+1   ; Save byte (least significant)
0154 fc72 fe f0 f3                   LDX     T_Z     ; Load full 4 hex value into X
0155 fc75 39                         RTS             ; RETURN
0156                         
0157                         ; -----------------------------------------------------
0158                         ; Print string FOLLOWING JSR ( terminated by $FF )
0159                         ;  IE: It starts at the `return addr` put onto the stack by JSR
0160                         ;  So actual return address needed is past the string
0161                         
0162                         ;fc76
0163 fc76 30                 STRING  TSX             ; Get loc. of return addr to X
0164 fc77 ee 00                      LDX     0,X     ; Get return addr to X
0165 fc79 09                         DEX             ; Point to byte before
0166 fc7a 08                 AGAIN   INX             ; Point to next byte
0167 fc7b a6 00                      LDAA    0,X     ; Get byte to be printed
0168 fc7d 81 ff                      CMPA    #$FF    ; End-string ?
0169 fc7f 27 04                      BEQ     ENDSTR  ; Yes: Go to finish up
0170 fc81 8d 8c                      BSR     PR_A    ; Print the byte
0171 fc83 20 f5                      BRA     AGAIN   ; Go back for next byte
0172 fc85 31                 ENDSTR  INS             ; Clean up stack...
0173 fc86 31                         INS             ;  ( pop off the return addr )
0174 fc87 6e 01                      JMP     1,X     ; Jump back to caller (RETURN)
0175                         
0176                         ; -----------------------------------------------------
0177                         ; 
0178 fc89 8d eb              GETADD  BSR     STRING  ; Print string...
0179 fc8b 20 53                      FCC     " S"    ;
0180 fc8d ff                         FCB     $FF     ; End-of-string
0181 fc8e 8d d5                      BSR     RD_X    ; Read 4 digit HEX addr value
0182 fc90 ff f0 ef                   STX     T_STRT  ; Save it
0183 fc93 8d e1                      BSR     STRING  ; Print string...
0184 fc95 20 46                      FCC     " F"    ;
0185 fc97 ff                         FCB     $FF     ; End-of-string
0186 fc98 8d cb                      BSR     RD_X    ; Read 4 digit HEX addr value
0187 fc9a ff f0 f1                   STX     T_STOP  ; Save it
0188 fc9d 39                         RTS             ; RETURN
0189                         
0190                         ; -----------------------------------------------------
0191                         ; Convert value in A to 2 x ASCII hex digits in A and B
0192                         
0193 fc9e 16                 ASCII   TAB             ; Copy A to B
0194 fc9f 84 f0                      ANDA    #$F0    ; Clear low order 4 bits of A
0195 fca1 44                         LSRA            ; Shift
0196 fca2 44                         LSRA            ;  right
0197 fca3 44                         LSRA            ;   4
0198 fca4 44                         LSRA            ;    bits
0199 fca5 81 09                      CMPA    #$09    ; Letter or number ?
0200 fca7 22 0b                      BHI     SUBT    ; 
0201 fca9 8b 30                      ADDA    #$30    ; Make it an ASCII number
0202 fcab c4 0f              AND     ANDB    #$0F    ; Clear high order bits of B
0203 fcad c1 09                      CMPB    #$09    ; Letter or number ?
0204 fcaf 22 07                      BHI     ADD     ;
0205 fcb1 cb 30                      ADDB    #$30    ; Make it an ASCII number
0206 fcb3 39                         RTS             ; RETURN
0207 fcb4 8b 37              SUBT    ADDA    #$37    ; Make it an ASCI letter
0208 fcb6 20 f3                      BRA     AND     ; Go to process low order value
0209 fcb8 cb 37              ADD     ADDB    #$37    ; Make it an ASII letter
0210 fcba 39                         RTS             ; RETURN
0211                         
0212                         ; -----------------------------------------------------
0213                         ; Print value in X as 4 hex digits
0214                         
0215 fcbb ff f0 ed           PRX     STX     T_TMPX  ; Save X
0216 fcbe b6 f0 ed                   LDAA    T_TMPX  ; Get high order byte to A
0217 fcc1 8d 06                      BSR     ZOUT    ; Print A as 2 hex digits
0218 fcc3 b6 f0 ee                   LDAA    T_TMPX+1 ; Get low order byte to A
0219 fcc6 8d 01                      BSR     ZOUT    ; Print A as 2 hex digits
0220 fcc8 39                         RTS             ; RETURN
0221                         
0222                         ; -----------------------------------------------------
0223                         ; Print value in A as 2 hex digits
0224                         
0225 fcc9 8d d3              ZOUT    BSR     ASCII   ; Convert A to ASCII in A & B
0226 fccb f7 f0 ec                   STAB    T_M     ; Save B
0227 fcce bd fc 0f                   JSR     PR_A    ; Print byte in A
0228 fcd1 b6 f0 ec                   LDAA    T_M     ; Get 2nd byte into A
0229 fcd4 bd fc 0f                   JSR     PR_A    ; Print byte in A
0230 fcd7 39                         RTS             ; RETURN
0231                         
0232                         ; -----------------------------------------------------
0233                         ;RD_HEX2 This is a new ZIN and is called RD_HEX2 on GruntMon
0234                         
0235 fcd8                    PUNCH       EQU *
0236 fcd8 7e fd e2                       JMP CMD_P
0237                         
0238                         ; second part of S19 version of ZIN
0239                         
0240 fcdb bd fc 31           ZIN2        JSR     BINARY      ; Convert A:B to binary to A
0241 fcde 16                             TAB                 ; B=A
0242 fcdf fb f0 e0                       ADDB    b_Csum      ; Add this value
0243 fce2 f7 f0 e0                       STAB    b_Csum      ; to the Checksum (for S19)
0244 fce5 39                             RTS                 ; RETURN
0245                         
0246                         ; -----------------------------------------------------
0247                         ; S19 format data load : Modded version of Mikbug code
0248                         ; NOTE THAT THIS IS IN THE WRONG PLACE AT PRESENT!!! It should be at FD07
0249                         ;
0250 fce6                    LOAD        EQU     *           ; L = Load = Input an S19 file
0251 fce6 bd fc 76                       JSR     STRING
0252 fce9 20 2b 20                       FCC     " + "
0253 fcec 0d 0a                          FCB     $0D,$0A     ; c/r l/f
0254 fcee ff                             FCB     $FF         ; End-Of-String
0255 fcef bd fc 00           .sRead      JSR     RD_CMD      ; Read+Echo, test for '.'
0256 fcf2 81 53                          CMPA    #'S         ; Is it `S` ?
0257 fcf4 26 f9                          BNE     .sRead      ; No: Keep waiting for `S`
0258 fcf6 bd fc 00                       JSR     RD_CMD      ; Read+Echo, test for '.'
0259 fcf9 81 39                          CMPA    #'9         ; Is it `9` ?  ( `S9` record )
0260 fcfb 27 26                          BEQ     STARTS      ; Yes: End-data, Back to START
0261 fcfd 81 31                          CMPA    #'1         ; Is it `1` ?  ( `S1` record )
0262 fcff 26 ee                          BNE     .sRead      ; No: Wait for next `S`
0263 fd01 7f f0 e0                       CLR     b_Csum      ; Clear checksum
0264 fd04 bd fc 49                       JSR     ZIN         ; Read 2xHex = data.byte count to A
0265 fd07 80 02                          SUBA    #2          ; Subtract 2 (to get bytes left in line)
0266 fd09 b7 f0 e1                       STAA    b_Count     ; Store byte count
0267 fd0c bd fc 65                       JSR     RD_X        ; Read 4xHex digit address to X
0268 fd0f bd fc 49           .sDoByt     JSR     ZIN         ; Read 2xHex digits, value to A
0269 fd12 7a f0 e1                       DEC     b_Count     ; Decrement our byte count
0270 fd15 27 05                          BEQ     .sChk       ; If end-of-line, go look at checksum
0271 fd17 a7 00                          STAA    0,X         ; Save byte where X points
0272 fd19 08                             INX                 ; Point X at next byte
0273 fd1a 20 f3                          BRA     .sDoByt     ; Go get next byte
0274 fd1c 7c f0 e0           .sChk       INC     b_Csum      ; Add 1 to checksum
0275 fd1f 27 ce                          BEQ     .sRead      ; OK: Go read next record
0276 fd21 8d 03                          BSR     PR_QM       ; Print "?"
0277 fd23 7e ff 8c           STARTS      JMP     START       ; Go to START
0278                         
0279 fd26 86 3f              PR_QM       LDAA #'?            ; Put '?' character in A
0280 fd28 7e fc 0f                       JMP     PR_A        ; Print it and return via PR_As RTS
0281                         
0282                         
0283                         
0284                         
0285                         
0286                         ; -----------------------------------------------------
0287                         ; Read byte from ACIA.A to A
0288                         ;FD2B
0289 fd2b b6 f4 01           RD_A    LDAA    CTRLA   ; Get ACIA.A status byte
0290 fd2e 85 01                      BITA    #$01    ; Is byte ready in DATAA
0291 fd30 27 f9                      BEQ     RD_A    ; No: Try again
0292 fd32 b6 f4 00                   LDAA    DATAA   ; Get the data byte to A
0293 fd35 39                         RTS             ; RETURN
0294                         
0295                         ; -----------------------------------------------------
0296 fd36 8d 15              REGPRT  BSR     PRSP    ; Print a space
0297 fd38 fe f0 fd                   LDX     PSTACK  ; Point X at user's stack
0298 fd3b 8d 1c                      BSR     PR2     ; Print CC
0299 fd3d 8d 1a                      BSR     PR2     ; Print B
0300 fd3f 8d 18                      BSR     PR2     ; Print A
0301 fd41 8d 10                      BSR     PR4     ; Print X
0302 fd43 8d 0e                      BSR     PR4     ; Print PC
0303 fd45 ce f0 fd                   LDX     #PSTACK ; Point X at stack pointer
0304 fd48 8d 0a                      BSR     PR4X    ; Print stack pointer
0305 fd4a 7e ff 8c                   JMP     START   ; (RETURN) to MINIMON
0306                         
0307                         ; -----------------------------------------------------
0308 fd4d 86 20              PRSP    LDAA    #$20    ; Put space character in A
0309 fd4f bd fc 0f                   JSR     PR_A    ; Print it
0310 fd52 39                         RTS             ; RETURN
0311                         
0312 fd53 08                 PR4     INX             ; Point X to next character
0313 fd54 a6 00              PR4X    LDAA    0,X     ; Get byte pointed to by X
0314 fd56 bd fc c9                   JSR     ZOUT    ; Print it
0315 fd59 08                 PR2     INX             ; Point X to next character
0316 fd5a a6 00                      LDAA    0,X     ; Get byte pointed to by X
0317 fd5c bd fc c9                   JSR     ZOUT    ; Print it
0318 fd5f 8d ec                      BSR     PRSP    ; Print a space
0319 fd61 39                         RTS             ; RETURN
0320                         
0321                         ; -----------------------------------------------------
0322 fd62 bd fc 89           BLKMOV  JSR     GETADD  ; Prompt for boundary addresses
0323 fd65 bd fc 76                   JSR     STRING  ; Print string...
0324 fd68 20 54 6f                   FCC     " To"   ;
0325 fd6b ff                         FCB     $FF     ; End-of-string
0326 fd6c bd fc 65                   JSR     RD_X    ; Read 4 hex digit value into X
0327 fd6f ff f0 ea                   STX     T_NEW   ; Store it as NEW start address
0328 fd72 ff f0 e6                   STX     T_X     ;   "    "
0329 fd75 fe f0 ef                   LDX     T_STRT  ; Put start address into X
0330 fd78 ff f0 e8                   STX     T_Y     ; Store it
0331 fd7b 8d 59                      BSR     SUB     ; Perform T_X minus T_Y
0332 fd7d 2a 23                      BPL     DOWN    ; Go to Move downwards
0333 fd7f fe f0 f1                   LDX     T_STOP  ; Get the STOP stop address
0334 fd82 08                         INX             ; Add 1 to it
0335 fd83 ff f0 f1                   STX     T_STOP  ; and save it
0336 fd86 fe f0 ef           DO_UP   LDX     T_STRT  ; Get START address
0337 fd89 bc f0 f1                   CPX     T_STOP  ; Compare it with STOP
0338 fd8c 26 03                      BNE     CONT_A  ; Finished ?
0339 fd8e 7e ff 8c           STARTB  JMP     START   ; Yes: back to MINIMON
0340 fd91 a6 00              CONT_A  LDAA    0,X     ; No: Get data
0341 fd93 08                         INX             ; Point X to next `old` address
0342 fd94 ff f0 ef                   STX     T_STRT  ; and store it
0343 fd97 fe f0 ea                   LDX     T_NEW   ; get address of NEW location
0344 fd9a a7 00                      STAA    0,X     ; Store the data at NEW address
0345 fd9c 08                         INX             ; Point X to next `new` address
0346 fd9d ff f0 ea                   STX     T_NEW   ; and store it
0347 fda0 20 e4                      BRA     DO_UP   ; loop back for next byte
0348 fda2 fe f0 f1           DOWN    LDX     T_STOP  ; Get end address
0349 fda5 ff f0 e6                   STX     T_X     ; Store it
0350 fda8 8d 2c                      BSR     SUB     ; Perform T_X minus T_Y
0351 fdaa bb f0 eb                   ADDA    T_NEW+1 ; Add NEW (low.byte) to A
0352 fdad fb f0 ea                   ADDB    T_NEW   ; Add NEW (high.byte) to B
0353 fdb0 b7 f0 eb                   STAA    T_NEW+1 ; Save NEW (low.byte)
0354 fdb3 f7 f0 ea                   STAB    T_NEW   ;         (high.byte)
0355 fdb6 fe f0 ef                   LDX     T_STRT  ; Get START address
0356 fdb9 09                         DEX             ; Subract 1 from X
0357 fdba ff f0 ef                   STX     T_STRT  ; Store it
0358 fdbd fe f0 f1           DO_DOWN LDX     T_STOP  ; Get STOP address
0359 fdc0 bc f0 ef                   CPX     T_STRT  ; Compare it with START address
0360 fdc3 27 c9                      BEQ     STARTB  ; Effecively `JMP START`
0361 fdc5 a6 00                      LDAA    0,X     ; Get data
0362 fdc7 09                         DEX             ; Subract 1 from X
0363 fdc8 ff f0 f1                   STX     T_STOP  ; Store it
0364 fdcb fe f0 ea                   LDX     T_NEW   ; Load NEW loc address into X
0365 fdce a7 00                      STAA    0,X     ; Store the data as NEW address
0366 fdd0 09                         DEX             ; Point X to next `new` address
0367 fdd1 ff f0 ea                   STX     T_NEW   ; Store it
0368 fdd4 20 e7                      BRA     DO_DOWN ; Loop back for next byte
0369                         
0370                         ; -----------------------------------------------------
0371 fdd6 ce f0 e6           SUB     LDX     #T_X    ; Point X to start of T_X data
0372 fdd9 a6 01                      LDAA    1,X     ; A = T_X (low)
0373 fddb e6 00                      LDAB    0,X     ; B = T_X (high)
0374 fddd a0 03                      SUBA    3,X     ; A = A - T_Y (low)
0375 fddf e2 02                      SBCB    2,X     ; B = B - T_Y (high)
0376 fde1 39                         RTS             ; RETURN
0377                         
0378                         ; -----------------------------------------------------
0379                         ; S format data output : Modded version of Mikbug code
0380                         ;
0381                         
0382 fde2                    CMD_P       EQU     *           ; P = Punch : Output an S19 file
0383 fde2 bd fc 89                       JSR     GETADD      ; Prompt for "Start:","Stop:"
0384 fde5 fe f0 ef                       LDX     T_STRT     ; Get start address
0385 fde8 ff f0 de                       STX     d_TW        ; save it to work area
0386 fdeb b6 f0 f2           .fOut1      LDAA    T_STOP+1    ; get low order of end address
0387 fdee b0 f0 df                       SUBA    d_TW+1      ; Subtract low order start
0388 fdf1 f6 f0 f1                       LDAB    T_STOP      ; ( carry not affected by LDA )
0389 fdf4 f2 f0 de                       SBCB    d_TW        ; Subtract with Carry
0390 fdf7 26 04                          BNE     .fOut2
0391 fdf9 81 10                          CMPA    #16
0392 fdfb 25 02                          BCS     .fOut3
0393 fdfd 86 0f              .fOut2      LDAA    #15
0394 fdff 8b 04              .fOut3      ADDA    #4
0395 fe01 b7 f0 e1                       STAA    b_Count     ; FRAME COUNT THIS RECORD
0396 fe04 80 03                          SUBA    #3
0397 fe06 b7 f0 e2                       STAA    b_Temp      ; BYTE COUNT THIS RECORD
0398 fe09 bd fc 76                       JSR     STRING      ; Output this string...
0399 fe0c 0d 0a                          FCB     $0D,$0A       ; c/r l/f
0400 fe0e 53 31                          FCB     'S,'1       ; S1
0401 fe10 ff                             FCB     $FF         ; End-Of-String
0402 fe11 5f                             CLRB                ; Clear checksum
0403                         
0404                         ; Output frame count...
0405 fe12 ce f0 e1                       LDX     #b_Count    ; X = Address of Framecount
0406 fe15 bd fe a8                       JSR     .fOutHx2    ; O/P byte <-X and inc X
0407                         
0408                         ; Output address...
0409 fe18 ce f0 de                       LDX     #d_TW
0410 fe1b bd fe a8                       JSR     .fOutHx2    ; O/P byte <-X and inc X
0411 fe1e bd fe a8                       JSR     .fOutHx2    ; O/P byte <-X and inc X
0412                         
0413                         ; Output data...
0414 fe21 fe f0 de                       LDX     d_TW
0415 fe24 bd fe a8           .fOut4      JSR     .fOutHx2    ; O/P byte <-X and inc X
0416 fe27 7a f0 e2                       DEC     b_Temp      ; Decrement `bytes left` count
0417 fe2a 26 f8                          BNE     .fOut4      ; Loop back if any left
0418 fe2c ff f0 de                       STX     d_TW
0419 fe2f 53                             COMB
0420 fe30 37                             PSHB
0421 fe31 30                             TSX                 ; X = S + 1
0422 fe32 8d 74                          BSR     .fOutHx2    ; PUNCH CHECKSUM
0423 fe34 33                             PULB
0424 fe35 fe f0 de                       LDX     d_TW
0425 fe38 09                             DEX
0426 fe39 bc f0 f1                       CPX     T_STOP
0427 fe3c 26 ad                          BNE     .fOut1
0428 fe3e bd fd 23                       JSR     STARTS      ;Go to START (via `S` code)
0429 fe41 20 65                          BRA     .fOutHx2
