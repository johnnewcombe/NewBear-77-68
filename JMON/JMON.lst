0634 ff63 bd fc 76           HEADER  JSR     STRING  ; print string...
0635 ff66 20 43 43                   FCC     " CC"   ;
0636 ff69 20 42 20                   FCC     " B "   ;
0637 ff6c 20 41 20                   FCC     " A "   ;
0638 ff6f 20 20 58                   FCC     "  X"   ;
0639 ff72 20 20 20                   FCC     "   "   ;
0640 ff75 20 50 43                   FCC     " PC"   ;
0641 ff78 20 20 20                   FCC     "   "   ;
0642 ff7b 53 50                      FCC     "SP"    ;
0643 ff7d ff                         FCB     $FF     ; End-of-string
0644 ff7e 20 0f                      BRA     START   ; Return to MINIMON
0645                         
