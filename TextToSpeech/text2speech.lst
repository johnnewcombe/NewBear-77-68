0029 0005                    GREET_MSG_CNT       EQU 5
0030 0005                    IDLE_MSG_CNT        EQU 5
0031 0005                    LIGHT_MSG_CNT       EQU 5
0032 0005                    NORM_MSG_CNT        EQU 5
0033 0005                    HEAVY_MSG_CNT       EQU 5
0034 0005                    SHEAVY_MSG_CNT      EQU 5
