0633 ff66 20 43 43                   FCC     " CC"   ;
0634 ff69 20 42 20                   FCC     " B "   ;
0635 ff6c 20 41 20                   FCC     " A "   ;
0636 ff6f 20 20 58                   FCC     "  X"   ;
0637 ff72 20 20 20                   FCC     "   "   ;
0638 ff75 20 50 43                   FCC     " PC"   ;
0639 ff78 20 20 20                   FCC     "   "   ;
0640 ff7b 53 50                      FCC     "SP"    ;
