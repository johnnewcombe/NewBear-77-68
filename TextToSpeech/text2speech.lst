0001                         ;------------------------------------------------------------------
0002                         ; text2speech.asm
0003                         ;------------------------------------------------------------------
0004                         
0005                         ; 7768 ACIA
0006 f400                    DATAA   EQU $F400 ; ACIA(a) Data register
0007 f401                    CTRLA   EQU $F401 ; ACIA(a) Ctrl/Status
0008 f402                    DATAB   EQU $F402 ; ACIA(b) Data register
0009 f403                    CTRLB   EQU $F403 ; ACIA(b) Ctrl/Status
0010                         
0011                         ; MINIMON routines
0012 fc76                    STRING  EQU $FC76 ; Prints a string. The string should follow JSR and be terminated with $FF.
0013 fc89                    GETADD  EQU $FC89 ; Get Address, read 4 digit hex value.
0014 fcc9                    ZOUT    EQU $FCC9 ; Print value in A as 2 hex digits.
0015 fe97                    NEWLINE EQU $FE97 ; Prints a new line.
0016 ff8f                    START   EQU $FF8F ; Restarts MniMon.
0017 fc0f                    PR_A    EQU $FC0F ; Print char in A to ACIA (a)
0018 fd2b                    RD_A    EQU $FD2B ; Read char from A
0019 fd4d                    PRSP    EQU $FD4D ; Print a space
0020 fc31                    BINARY  EQU $FC31 ; Converts ASCII hex digits in A and B to binary?
0021 fc65                    RD_X    EQU $FC65 ; Read 4 hex digits Value from ACIA(a) and put value into X.
0022 fc1d                    VHEX    EQU $FC1D ; Checks that A contains a HEX character
0023 0200                    	    ORG $0200
0024                         
0025                         ; initialise serial port B
0026 0200 86 11              TX2SP   LDAA    #$11    ; 8 Data, No Parity, 2 Stop Bits
0027 0202 b7 f4 03                   STAA    CTRLB   ;   ACIA.A
0028                         
0029                         
0030                         
0031                                 ; -----------------------------------------------------
0032                                 ; PRINT NUMBERS 0 TO 9
0033                                 ; -----------------------------------------------------
0034                         
0035 0205 4f                         CLRA
0036 0206 bd 02 f2           PRNUMS  JSR     PRSPB
0037 0209 bd 02 fd                   JSR     PR_NUMB
0038 020c 4c                         INCA
0039 020d 81 0a                      CMPA    #10
0040 020f 26 f5                      BNE     PRNUMS
0041 0211 bd 02 f2                   JSR     PRSPB
0042                         
0043                         
0044                         LOOP:
0045                         ; -----------------------------------------------------
0046                         ; Data arrives at port B as four hex characters
0047                         ; -----------------------------------------------------
0048 0214 bd 02 e3                   JSR     RD_XB           ; read 4 hex characters into X
0049 0217 ff 03 68                   STX     TEMP            ; save X
0050                         
0051 021a bd 02 f2                   JSR     PRSPB
0052 021d b6 03 68                   LDAA    TEMP            ; Load high byte of X into Accumulator A
0053 0220 bd 02 6f                   JSR     PR_DEC          ; puts 3 decimal digits in DEC, DEC+1 and DEC+2
0054                         
0055 0223 b6 03 6b                   LDAA    DEC+1           ; don't care about the hundreds
0056 0226 8b 30                      ADDA    #$30
0057 0228 bd 02 d8                   JSR     PR_B
0058                         
0059 022b b6 03 6c                   LDAA    DEC+2
0060 022e 8b 30                      ADDA    #$30
0061 0230 bd 02 d8                   JSR     PR_B
0062                         
0063                         
0064                         ;--------------------------------------------------------------
0065                         ; SECOND DIGIT
0066                         ;--------------------------------------------------------------
0067                         
0068 0233 bd 02 f2                   JSR     PRSPB
0069 0236 b6 03 69                   LDAA    TEMP+1            ; Load high byte of X into Accumulator A
0070 0239 bd 02 6f                   JSR     PR_DEC
0071                         
0072 023c b6 03 6b                   LDAA    DEC+1             ; don't care about the hundreds
0073 023f 8b 30                      ADDA    #$30
0074 0241 bd 02 d8                   JSR     PR_B
0075                         
0076 0244 b6 03 6c                   LDAA    DEC+2
0077 0247 8b 30                      ADDA    #$30
0078 0249 bd 02 d8                   JSR     PR_B
0079                         
0080 024c bd 02 8d                   JSR     STRINGB
0081 024f 0d 0a                      FCB     $0D, $0A
0082 0251 53 68 61 6c 6c 20          FCC     "Shall I tell you a joke?"
     49 20 74 65 6c 6c
     20 79 6f 75 20 61
     20 6a 6f 6b 65 3f
0083 0269 0d 0a ff                   FCB     $0D, $0A,$FF
0084                         
0085 026c 7e 02 14           .END    JMP     LOOP  ;START   ; all done
0086                         
0087                         ; -----------------------------------------------------
0088                         ; PR_DEC: Puts 3 decimal digits in DEC, DEC+1 and DEC+2
0089                         ;
0090                         ;       !! ONLY WORKS WITH VALUES BELOW 128 !!
0091                         ; -----------------------------------------------------
0092 026f 5f                 PR_DEC  CLRB            ; Clear B for hundreds
0093                         
0094 0270 81 64              HUND    CMPA    #100    ; 100 or more?
0095                         
0096 0272 2d 05                      BLT     TENS
0097 0274 80 64                      SUBA    #100    ; Sub 100
0098 0276 5c                         INCB            ; Increment hundred counter
0099 0277 20 f7                      BRA     HUND
0100                         
0101 0279 f7 03 6a           TENS    STAB    DEC     ; store the hundreds
0102                         
0103 027c 5f                         CLRB
0104 027d 81 0a              TENS1   CMPA    #10     ; 10 or more?
0105 027f 2d 05                      BLT     UNITS
0106 0281 80 0a                      SUBA    #10     ; Sub 10
0107 0283 5c                         INCB            ; Increment ten counter
0108 0284 20 f7                      BRA     TENS1
0109                         
0110 0286 f7 03 6b           UNITS   STAB    DEC+1
0111 0289 b7 03 6c                   STAA    DEC+2   ; Final remainder is units
0112                         
0113 028c 39                         RTS
0114                         
0115                         
0116                         ; -----------------------------------------------------
0117                         ; Print string FOLLOWING JSR ( terminated by $FF ) to
0118                         ; ACIA(b) and ACIA(b)
0119                         ; -----------------------------------------------------
0120 028d 30                 STRINGB TSX             ; Get loc. of return addr to X
0121 028e ee 00                      LDX     0,X     ; Get return addr to X
0122 0290 09                         DEX             ; Point to byte before
0123 0291 08                 AGAIN   INX             ; Point to next byte
0124 0292 a6 00                      LDAA    0,X     ; Get byte to be printed
0125 0294 81 ff                      CMPA    #$FF    ; End-string ?
0126 0296 27 07                      BEQ     ENDSTR  ; Yes: Go to finish up
0127 0298 bd fc 0f                   JSR     PR_A    ; Print the byte to ACIA(a) (A is maintained)
0128 029b 8d 3b                      BSR     PR_B    ; Print the byte to ACIA(b)
0129 029d 20 f2                      BRA     AGAIN   ; Go back for next byte
0130 029f 31                 ENDSTR  INS             ; Clean up stack...
0131 02a0 31                         INS             ;  ( pop off the return addr )
0132 02a1 6e 01                      JMP     1,X     ; Jump back to caller (RETURN)
0133                         
0134                         ; -----------------------------------------------------
0135                         ; Prints a string pointed to by X
0136                         ; -----------------------------------------------------
0137 02a3 a6 00              STRINGBX    LDAA    0,X         ; get char
0138 02a5 81 ff                          CMPA    #$FF        ; is character NULL?
0139 02a7 27 08                          BEQ     DONEB       ; yes, end of string
0140 02a9 bd fc 0f                       JSR     PR_A        ; Print the byte to ACIA(a) (A is maintained)
0141 02ac 8d 2a                          BSR     PR_B        ; Print the byte to ACIA(b)
0142 02ae 08                             INX
0143 02af 20 f2                          BRA     STRINGBX
0144 02b1 39                 DONEB       RTS
0145                         
0146                         ; -----------------------------------------------------
0147                         ; Reads a character from ACIA(b) into A
0148                         ; -----------------------------------------------------
0149 02b2 b6 f4 03           RD_B    LDAA    CTRLB       ; Get ACIA.A status byte
0150 02b5 85 01                      BITA    #01         ; Is byte ready in DATAb
0151 02b7 27 f9                      BEQ     RD_B        ; No: Try again
0152 02b9 b6 f4 02                   LDAA    DATAB       ; Get the data byte to A
0153                                 ;ANDA    #$7F        ; Mask off parity bit if it exists
0154 02bc 39                         RTS                 ; RETURN
0155                         
0156                         ; -----------------------------------------------------
0157                         ;
0158                         ; -----------------------------------------------------
0159 02bd 8d f3              ZINB    BSR     RD_B    ; Read a character
0160 02bf bd fc 1d                   JSR     VHEX    ; Is it a hex character ?
0161 02c2 25 12                      BCS     Z_PRQM  ; No: go to print `?`
0162 02c4 b7 03 65                   STAA    T_Q     ; Yes: Save Acc.A
0163 02c7 8d e9                      BSR     RD_B    ; Read 2nd character
0164 02c9 bd fc 1d                   JSR     VHEX    ; Is it a hex character ?
0165 02cc 25 08                      BCS     Z_PRQM  ; No: go to print `?`
0166 02ce 16                         TAB             ; Yes: Put it into Acc.B
0167 02cf b6 03 65                   LDAA    T_Q     ; Retrieve 1st hex char to Acc.A
0168 02d2 bd fc 31                   JSR     BINARY  ; Convert A:B to binary
0169 02d5 39                         RTS             ; RETURN
0170                         Z_PRQM  ;LDAA    #'?     ; Load `?` into A
0171                                 ;BSR     PR_B    ; Print it
0172 02d6 20 e5                      BRA     ZINB    ; Go back to start of hex input
0173                         
0174                         ; -----------------------------------------------------
0175                         ; Print character in A to ACIA(b)
0176                         ; -----------------------------------------------------
0177 02d8 f6 f4 03           PR_B    LDAB    CTRLB   ; Get ACIA(a) status byte
0178 02db c5 02                      BITB    #02     ; Is it busy ?
0179 02dd 27 f9                      BEQ     PR_B    ; Yes: Try again
0180 02df b7 f4 02                   STAA    DATAB   ;  No: Send data
0181 02e2 39                 PRB_END RTS             ; RETURN
0182                         
0183                         ; -----------------------------------------------------
0184                         ; Read 4 hex digits and put value into X
0185                         ; -----------------------------------------------------
0186                         RD_XB   ;JSR     PRSPB   ; Print a space
0187 02e3 8d d8                      BSR     ZINB    ; Read 2 digit hex value into A
0188 02e5 b7 03 66                   STAA    T_Z     ; Save byte (most significant)
0189 02e8 8d d3                      BSR     ZINB    ; Read 2 digit hex value into A
0190 02ea b7 03 67                   STAA    T_Z+1   ; Save byte (least significant)
0191 02ed fe 03 66                   LDX     T_Z     ; Load full 4 hex value into X
0192 02f0 39                         RTS             ; RETURN
0193                         
0194                         ; -----------------------------------------------------
0195                         ; Random idle phrase to ports B
0196                         ; -----------------------------------------------------
0197 02f1 39                 IDLE    RTS
0198                         
0199                         ; -----------------------------------------------------
0200                         ; Prints a space on both consoles (preserves A)
0201                         ; -----------------------------------------------------
0202 02f2 36                 PRSPB   PSHA
0203 02f3 86 20                      LDAA    #$20        ; Put space character in A
0204 02f5 bd fc 0f                   JSR     PR_A
0205 02f8 bd 02 d8                   JSR     PR_B        ; Print it
0206 02fb 32                         PULA
0207 02fc 39                         RTS                 ; RETURN
0208                         
