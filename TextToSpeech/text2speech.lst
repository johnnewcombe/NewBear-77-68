0213 02fd 36                 PR_NUMB     PSHA
0214 02fe 4c                             INCA
0215 02ff ce 03 1b                       LDX     #TEXTBLOCKPTR  ; base of offset table
0216 0302 4a                 PR_NUMB1    DECA
0217 0303 27 04                          BEQ     FOUND
0218 0305 08                             INX                 ; move to next address
0219 0306 08                             INX
0220 0307 26 f9                          BNE     PR_NUMB1    ; loop around to retest
0221                         FOUND
0222 0309 a6 00                          LDAA    0,X
0223 030b b7 10 04                       STAA    $1004
0224 030e a6 01                          LDAA    1,X
0225 0310 b7 10 05                       STAA    $1005
0226 0313 fe 10 04                       LDX     $1004
0227 0316 bd 02 a3                       JSR     STRINGBX
0228 0319 32                             PULA
0229 031a 39                             RTS
