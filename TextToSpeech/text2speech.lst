   0270 48            [ 2]  222         ASLA                    ; multiply A by 2 as each pointer is two bytes
   0271 BD 03 31      [ 9]  223         JSR     ADX             ; now have the correct pointer value in X
                            224 
                            225 ; get address of message in X from the pointer in X
   0274 A6 00         [ 5]  226         LDAA    0,X             ;  get high byte of word pointed to by X
   0276 E6 01         [ 5]  227         LDAB    1,X             ;  get low byte of word pointed to by X
   0278 B7 1B 16      [ 5]  228         STAA    TEMP
   027B F7 1B 17      [ 5]  229         STAB    TEMP+1
   027E FE 1B 16      [ 5]  230         LDX     TEMP
   0281 BD 03 A5      [ 9]  231         JSR     PR_PHRASE       ; output idle message
   0284 BD 03 8B      [ 9]  232         JSR     PR_CRB          ; CR/LF
