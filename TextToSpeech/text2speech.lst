0256                         ; -----------------------------------------------------
0257                         ; Print string FOLLOWING JSR ( terminated by $FF ) to
0258                         ; ACIA(b) and ACIA(b)
0259                         ; -----------------------------------------------------
0260 0371 30                 STRINGB TSX             ; Get loc. of return addr to X
0261 0372 ee 00                      LDX     0,X     ; Get return addr to X
0262 0374 09                         DEX             ; Point to byte before
0263 0375 08                 STRB1   INX             ; Point to next byte
0264 0376 a6 00                      LDAA    0,X     ; Get byte to be printed
0265 0378 81 ff                      CMPA    #$FF    ; End-string ?
0266 037a 27 07                      BEQ     ENDSTR  ; Yes: Go to finish up
0267 037c bd fc 0f                   JSR     PR_A    ; Print the byte to ACIA(a) (A is maintained)
0268 037f 8d 40                      BSR     PR_B    ; Print the byte to ACIA(b)
0269 0381 20 f2                      BRA     STRB1   ; Go back for next byte
0270 0383 31                 ENDSTR  INS             ; Clean up stack...
0271 0384 31                         INS             ;  ( pop off the return addr )
0272 0385 6e 01                      JMP     1,X     ; Jump back to caller (RETURN)
0273                         
