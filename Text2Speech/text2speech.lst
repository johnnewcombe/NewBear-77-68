                            294 ;END:     JMP     MAINLOOP  ;START   ; all done
                            295 
                            296 ;--------------------------------------------------------------
                            297 ; Gets the weight data from the scales and rerurns with carry
                            298 ; set if a valid reading, carry clear otherwise. A valid weight
                            299 ; reading resets the idle count. Data received is stored in
                            300 ; T_WEIGHT and MSB in A.
                            301 ;--------------------------------------------------------------
   03EC                     302 GETDATA:
   03EC BD 04 78      [ 9]  303         JSR     RD_XB           ; read 4 hex characters into X
   03EF FF 00 0F      [ 6]  304         STX     T_WEIGHT        ; store X
   03F2 BD FC 76      [ 9]  305         JSR     STRING
   03F5 44 52 3A            306         .fcc    "DR:"
   03F8 FF                  307         .fcb    0xff
   03F9 FE 00 0F      [ 5]  308         LDX     T_WEIGHT
   03FC BD FC BB      [ 9]  309         JSR     PRX             ; print the data
   03FF BD FD 4D      [ 9]  310         JSR    PRSP
   0402 0C            [ 2]  311         CLC
   0403 B6 00 0F      [ 4]  312         LDAA    T_WEIGHT        ; get fist byte (stones)
   0406 27 04         [ 4]  313         BEQ     GDDONE          ; idle message
   0408 7F 00 2D      [ 6]  314         CLR     IDLE_TICS       ; not an idle message so reset the idle counter
ASxxxx Assembler V05.50.5  (Motorola 6800/6802/6808)                    Page 7
Hexadecimal [16-Bits]                                 Sat May 16 08:06:54 2026



   040B 0D            [ 2]  315         SEC                     ; non idle message return with carry set
   040C 39            [ 5]  316 GDDONE:  RTS
                            317 
                            318 ; -----------------------------------------------------
                            319 ; Print string FOLLOWING JSR ( terminated by 0xFF ) to
                            320 ; ACIA(b) and ACIA(b)
                            321 ; -----------------------------------------------------
   040D 30            [ 4]  322 STRINGB: TSX             ; Get loc. of return addr to X
   040E EE 00         [ 6]  323          LDX     0,X     ; Get return addr to X
   0410 09            [ 4]  324          DEX             ; Point to byte before
   0411 08            [ 4]  325 STRB1:   INX             ; Point to next byte
   0412 A6 00         [ 5]  326          LDAA    0,X     ; Get byte to be printed
   0414 81 FF         [ 2]  327          CMPA    #0xFF    ; End-string ?
   0416 27 0E         [ 4]  328          BEQ     ENDSTR  ; Yes: Go to finish up
   0418 F6 F0 FF      [ 4]  329          LDAB    PANEL
   041B C5 01         [ 2]  330          BITB     #1
   041D 27 03         [ 4]  331          BEQ     STRB    ; panel switch 0 is debug and copies data to A
   041F BD FC 0F      [ 9]  332          JSR     PR_A    ; Print the byte to ACIA(a) (A is maintained)
                            333                          ;  DEBUG depending on panel data switch zero
   0422 8D 46         [ 8]  334 STRB:    BSR     PR_B    ; Print the byte to ACIA(b)
   0424 20 EB         [ 4]  335          BRA     STRB1   ; Go back for next byte
   0426 31            [ 4]  336 ENDSTR:  INS             ; Clean up stack...
   0427 31            [ 4]  337          INS             ;  ( pop off the return addr )
   0428 6E 01         [ 4]  338          JMP     1,X     ; Jump back to caller (RETURN)
                            339 
                            340 ; -----------------------------------------------------
                            341 ; Prints a string pointed to by X
                            342 ; -----------------------------------------------------
   042A A6 00         [ 5]  343 STRINGBX:   LDAA    0,X         ; get char
   042C 81 FF         [ 2]  344             CMPA    #0xFF        ; is character NULL?
   042E 27 0F         [ 4]  345             BEQ     DONEB       ; yes, end of string
   0430 F6 F0 FF      [ 4]  346             LDAB    PANEL
   0433 C5 01         [ 2]  347             BITB    #1
   0435 27 03         [ 4]  348             BEQ     STRBX       ; panel switch 0 is debug and copies data to A
   0437 BD FC 0F      [ 9]  349             JSR     PR_A        ; Print the byte to ACIA(a) (A is maintained)
   043A 8D 2E         [ 8]  350 STRBX:      BSR     PR_B        ; Print the byte to ACIA(b)
   043C 08            [ 4]  351             INX
   043D 20 EB         [ 4]  352             BRA     STRINGBX
   043F 39            [ 5]  353 DONEB:      RTS
                            354 
                            355 ; -----------------------------------------------------
                            356 ; Reads a character from ACIA(b) into A
                            357 ; -----------------------------------------------------
   0440 B6 F4 03      [ 4]  358 RD_B:   LDAA    CTRLB       ; Get ACIA.A status byte
   0443 85 01         [ 2]  359         BITA    #01         ; Is byte ready in DATAb
   0445 27 F9         [ 4]  360         BEQ     RD_B        ; No: Try again
   0447 B6 F4 02      [ 4]  361         LDAA    DATAB       ; Get the data byte to A
                            362         ;STAA     PANEL
   044A 84 7F         [ 2]  363         ANDA    #0x7F        ; Mask off parity bit if it exists
   044C 39            [ 5]  364         RTS                 ; RETURN
                            365 
                            366 ; -----------------------------------------------------
                            367 ; Reads 2 hex ascii characters and saves them the
                            368 ; byte value to A e.g. "0F" received is stored to A as
                            369 ; 15d.
ASxxxx Assembler V05.50.5  (Motorola 6800/6802/6808)                    Page 8
Hexadecimal [16-Bits]                                 Sat May 16 08:06:54 2026



                            370 ; This version ignores non-hex characters
                            371 ; -----------------------------------------------------
   044D 8D F1         [ 8]  372 ZINB:   BSR     RD_B    ; Read a character
   044F BD FC 1D      [ 9]  373         JSR     VHEX    ; Is it a hex character ?
   0452 24 02         [ 4]  374         BCC     ZINBA   ; No: go to print `?`
   0454 86 FF         [ 2]  375         LDAA    #0xFF
   0456 B7 00 00      [ 5]  376 ZINBA:  STAA    T_Q     ; Yes: Save Acc.A
   0459 8D E5         [ 8]  377         BSR     RD_B    ; Read 2nd character
   045B BD FC 1D      [ 9]  378         JSR     VHEX    ; Is it a hex character ?
   045E 24 02         [ 4]  379         BCC     ZINBB   ; No: go to print `?`
   0460 86 FF         [ 2]  380         LDAA    #0xFF
   0462 16            [ 2]  381 ZINBB:  TAB             ; Yes: Put it into Acc.B
   0463 B6 00 00      [ 4]  382         LDAA    T_Q     ; Retrieve 1st hex char to Acc.A
   0466 BD FC 31      [ 9]  383         JSR     BINARY  ; Convert A:B to binary
   0469 39            [ 5]  384         RTS             ; RETURN
                            385 
                            386 ; -----------------------------------------------------
                            387 ; Print character in A to ACIA(b)
                            388 ; -----------------------------------------------------
   046A F6 F4 03      [ 4]  389 PR_B:    LDAB    CTRLB   ; Get ACIA(a) status byte
   046D C5 02         [ 2]  390         BITB    #02     ; Is it busy ?
   046F 27 F9         [ 4]  391         BEQ     PR_B    ; Yes: Try again
   0471 B7 F4 02      [ 5]  392         STAA    DATAB   ;  No: Send data
   0474 B7 F0 FF      [ 5]  393         STAA    PANEL
   0477 39            [ 5]  394 PRB_END: RTS             ; RETURN
                            395 
                            396 ; -----------------------------------------------------
                            397 ; Read 4 hex digits and put value into X
                            398 ; -----------------------------------------------------
   0478 8D D3         [ 8]  399 RD_XB:   BSR     ZINB    ; Read 2 digit hex value into A
   047A B7 00 01      [ 5]  400         STAA    T_Z     ; Save byte (most significant)
   047D 8D CE         [ 8]  401         BSR     ZINB    ; Read 2 digit hex value into A
   047F B7 00 02      [ 5]  402         STAA    T_Z+1   ; Save byte (least significant)
   0482 FE 00 01      [ 5]  403         LDX     T_Z     ; Load full 4 hex value into X
   0485 39            [ 5]  404         RTS             ; RETURN
                            405 
                            406 ; -----------------------------------------------------
                            407 ; Adds A to X and leaves the result in X, A is
                            408 ; preserved.
                            409 ; -----------------------------------------------------
   0486 36            [ 4]  410 ADX:     PSHA
   0487 FF 00 0B      [ 6]  411         STX     T_TMP
   048A BB 00 0C      [ 4]  412         ADDA    T_TMP+1   ; add A to low byte
   048D B7 00 0C      [ 5]  413         STAA    T_TMP+1
   0490 B6 00 0B      [ 4]  414         LDAA    T_TMP     ; get high byte
   0493 89 00         [ 2]  415         ADCA    #0      ; add carry only
   0495 B7 00 0B      [ 5]  416         STAA    T_TMP
   0498 FE 00 0B      [ 5]  417         LDX     T_TMP
   049B 32            [ 4]  418         PULA
   049C 39            [ 5]  419         RTS
                            420 
                            421 ; -----------------------------------------------------
                            422 ; Loads X with A, A is preserved.
                            423 ; -----------------------------------------------------
   049D B7 00 0C      [ 5]  424 TAX:    STAA    T_TMP+1       ; store A as low byte of X
ASxxxx Assembler V05.50.5  (Motorola 6800/6802/6808)                    Page 9
Hexadecimal [16-Bits]                                 Sat May 16 08:06:54 2026



   04A0 7F 00 0B      [ 6]  425         CLR     T_TMP         ; zero the high byte
   04A3 FE 00 0B      [ 5]  426         LDX     T_TMP         ; load X
   04A6 39            [ 5]  427         RTS
                            428 
                            429 ; -----------------------------------------------------
                            430 ; Prints the message " n stones n pounds"
                            431 ; place stones in MSB of X and pound in LSB
                            432 ; -----------------------------------------------------
   04A7                     433 PR_WEIGHT:
                            434 
   04A7 FF 00 09      [ 6]  435         STX     T_W
   04AA B6 00 09      [ 4]  436         LDAA    T_W
   04AD BD 04 9D      [ 9]  437         JSR     TAX
   04B0 BD 05 19      [ 9]  438         JSR     PR_WORD         ; n
   04B3 BD 04 D5      [ 9]  439         JSR     PR_SPCB
   04B6 CE 01 2B      [ 3]  440         LDX     #STONES
   04B9 BD 05 19      [ 9]  441         JSR     PR_WORD         ; "stones"
   04BC BD 04 D5      [ 9]  442         JSR     PR_SPCB
   04BF B6 00 0A      [ 4]  443         LDAA    T_W+1            ; Load high byte of X into Accumulator A
   04C2 BD 04 9D      [ 9]  444         JSR     TAX
   04C5 BD 05 19      [ 9]  445         JSR     PR_WORD         ; n
   04C8 CE 00 F5      [ 3]  446         LDX     #POUNDS
   04CB BD 04 D5      [ 9]  447         JSR     PR_SPCB
   04CE BD 05 19      [ 9]  448         JSR     PR_WORD         ; "pounds"
   04D1 BD 04 DD      [ 9]  449         JSR     PR_CRB
   04D4 39            [ 5]  450         RTS
                            451 
                            452 ; -----------------------------------------------------
                            453 ; Prints a space on both consoles (preserves A)
                            454 ; -----------------------------------------------------
   04D5 36            [ 4]  455 PR_SPCB: PSHA
   04D6 86 20         [ 2]  456         LDAA    #0x20        ; Put space character in A
                            457         ;JSR     PR_A
   04D8 BD 04 6A      [ 9]  458         JSR     PR_B        ; Print it
   04DB 32            [ 4]  459         PULA
   04DC 39            [ 5]  460         RTS                 ; RETURN
                            461 
                            462 ; -----------------------------------------------------
                            463 ; Prints a CRLF on both consoles (preserves A)
                            464 ; -----------------------------------------------------
   04DD 36            [ 4]  465 PR_CRB:     PSHA
   04DE 86 0D         [ 2]  466             LDAA    #0x0D        ; Put CHAR character in A
   04E0 BD FC 0F      [ 9]  467             JSR     PR_A
   04E3 BD 04 6A      [ 9]  468             JSR     PR_B        ; Print it
   04E6 86 0A         [ 2]  469             LDAA    #0x0A
   04E8 F6 F0 FF      [ 4]  470             LDAB     PANEL
   04EB C5 01         [ 2]  471             BITB    #1
   04ED 27 03         [ 4]  472             BEQ     PR_CRB1
   04EF BD FC 0F      [ 9]  473             JSR     PR_A
   04F2 BD 04 6A      [ 9]  474 PR_CRB1:    JSR     PR_B        ; Print it
   04F5 32            [ 4]  475             PULA
   04F6 39            [ 5]  476             RTS                 ; RETURN
                            477 
                            478 ; -----------------------------------------------------
                            479 ; Outputs a phrase from the memory location in X
ASxxxx Assembler V05.50.5  (Motorola 6800/6802/6808)                   Page 10
Hexadecimal [16-Bits]                                 Sat May 16 08:06:54 2026



                            480 ; -----------------------------------------------------
   04F7                     481 PR_PHRASE:
                            482 
   04F7 A6 00         [ 5]  483 PR_PH1:  LDAA    0,X         ; get high byte of word
   04F9 E6 01         [ 5]  484         LDAB    1,X         ; get low byte
   04FB 81 FF         [ 2]  485         CMPA    #0xFF        ; check high byte
   04FD 27 19         [ 4]  486         BEQ     PR_PH2      ; high byte is 0xFF so we're done
   04FF FF 00 05      [ 6]  487 PR_PH3:  STX     T_Y         ; save table pointer
   0502 B7 00 07      [ 5]  488         STAA    T_P
   0505 F7 00 08      [ 5]  489         STAB    T_P+1
   0508 FE 00 07      [ 5]  490         LDX     T_P         ; X now points to the word
   050B BD 05 19      [ 9]  491         JSR     PR_WORD
   050E BD 04 D5      [ 9]  492         JSR     PR_SPCB
   0511 FE 00 05      [ 5]  493         LDX     T_Y         ; restore table pointer
   0514 08            [ 4]  494         INX                 ; move to next entry
   0515 08            [ 4]  495         INX                 ; (2 bytes per entry)
   0516 20 DF         [ 4]  496         BRA     PR_PH1
   0518 39            [ 5]  497 PR_PH2:  RTS
                            498 
                            499 ; -----------------------------------------------------
                            500 ; Outputs a word based on value in X
                            501 ; -----------------------------------------------------
   0519                     502 PR_WORD:
   0519 FF 00 03      [ 6]  503             STX     T_X             ; use ASL and ROL to multiply by 2 (pointer is 2 bytes wide)
   051C 78 00 04      [ 6]  504             ASL     T_X+1           ; shift low byte left, bit 7 goes to carry
   051F 79 00 03      [ 6]  505             ROL     T_X             ; rotate high byte left, carry in from low byte
   0522 FE 00 03      [ 5]  506             LDX     T_X
   0525 FF 00 03      [ 6]  507             STX     T_X             ; Stash X
   0528 B6 00 03      [ 4]  508             LDAA    T_X             ; High byte of X
   052B F6 00 04      [ 4]  509             LDAB    T_X+1           ; Low byte of X
   052E CB 52         [ 2]  510             ADDB    #<WORDPTR    ; Add low byte of WORDPTR address
   0530 89 05         [ 2]  511             ADCA    #>WORDPTR    ; Add high byte of WORDPTR address + carry
   0532 B7 00 03      [ 5]  512             STAA    T_X             ; T_X has the address of the pointer NOT the word
   0535 F7 00 04      [ 5]  513             STAB    T_X+1
   0538 FE 00 03      [ 5]  514             LDX     T_X             ; X has the address of the pointer NOT the word
                            515 
   053B A6 00         [ 5]  516             LDAA    0,X             ; get the hi byte of the word
   053D B7 00 03      [ 5]  517             STAA    T_X
   0540 A6 01         [ 5]  518             LDAA    1,X             ; get the low byte of the word
   0542 B7 00 04      [ 5]  519             STAA    T_X+1
   0545 FE 00 03      [ 5]  520             LDX     T_X             ; X now has address of the word
   0548 BD 04 2A      [ 9]  521             JSR     STRINGBX        ; output the word
   054B 7C 00 19      [ 6]  522             INC     WORDS
   054E BD FD 4D      [ 9]  523             JSR     PRSP
   0551 39            [ 5]  524             RTS
