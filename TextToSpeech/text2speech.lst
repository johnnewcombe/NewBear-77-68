0417                         ; Outputs a word based on value in A
0418                         ; -----------------------------------------------------
0419 0440 4c                 PR_WORD     INCA
0420 0441 ce 04 74                       LDX     #WORDPTR  ; base of offset table
0421 0444 4a                 PR_WORD1    DECA
0422 0445 27 04                          BEQ     FOUNDW
0423 0447 08                             INX                 ; move to next address
0424 0448 08                             INX
0425 0449 26 f9                          BNE     PR_WORD1    ; loop around to retest
0426 044b a6 00              FOUNDW      LDAA    0,X
0427 044d b7 04 d9                       STAA    T_X
0428 0450 a6 01                          LDAA    1,X
0429 0452 b7 04 da                       STAA    T_X+1
0430 0455 fe 04 d9                       LDX     T_X
0431 0458 bd 03 7e                       JSR     STRINGBX
0432 045b 39                             RTS
