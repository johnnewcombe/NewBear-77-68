0325                         ; Read 4 hex digits and put value into X
0326                         ; -----------------------------------------------------
0327 03cc 8d d8              RD_XB   BSR     ZINB    ; Read 2 digit hex value into A
0328 03ce b7 19 5f                   STAA    T_Z     ; Save byte (most significant)
0329 03d1 8d d3                      BSR     ZINB    ; Read 2 digit hex value into A
0330 03d3 b7 19 60                   STAA    T_Z+1   ; Save byte (least significant)
0331 03d6 fe 19 5f                   LDX     T_Z     ; Load full 4 hex value into X
0332 03d9 39                         RTS             ; RETURN
