   0123 BD FC 76      [ 9]   61                 JSR STRING
   0126 53 70 65 61 6B 20    62                 .fcc    "Speak Your Weight (c) John Newcombe 2026"
        59 6F 75 72 20 57
        65 69 67 68 74 20
        28 63 29 20 4A 6F
        68 6E 20 4E 65 77
        63 6F 6D 62 65 20
        32 30 32 36
   014E 0D 0A FF             63                 .Fcb    0x0d, 0x0a, 0xFF
                             64 
                             65                 ; initialise the speach processor
                             66                 ;   @R6 = excitability (Default=3)
                             67                 ;   @W2 = speed (Default=3)
                             68                 ;   @F8 = pitch center (Default=8)
                             69                 ;   @V3 = one of six preset voices
                             70                 ;   @K0 = male or non-male table
                             71                 ;
   0151 BD 02 BA      [ 9]   72                 JSR STRINGB
   0154 40 52 36 40 57 32    73                 .fcc    "@R6@W2@F8@V3@K0"
        40 46 38 40 56 33
        40 4B 30
   0163 0D 0A FF             74                 .fcb    0x0d, 0x0a, 0xFF
                             75 
   0166                      76 MAINLOOP:
                             77 
                             78 ; -----------------------------------------------------
                             79 ; Data arrives at port B as four hex characters
                             80 ; -----------------------------------------------------
   0166 BD 02 8B      [ 9]   81                 JSR     GETDATA         ; value in T_WEIGHT, stones in A
   0169 25 03         [ 4]   82                 BCS     ML1             ; is it invalid i.e. carry clear
   016B 7E 01 D6      [ 3]   83                 JMP     IDLE
   016E 7D 1B 21      [ 6]   84 ML1:            TST     PROCESSING_FLG  ; are we already processing a weight
   0171 26 F3         [ 4]   85                 BNE     MAINLOOP        ; flag non-zero so ignore everything that follows
   0173 7C 1B 21      [ 6]   86                 INC     PROCESSING_FLG  ; ignore any following data until we next idle
   0176 81 14         [ 2]   87                 CMPA    #TOO_HEAVY      ; more that 20 is too heavy
   0178 22 3E         [ 4]   88                 BHI     OVERLOADED
   017A B6 1B 19      [ 4]   89                 LDAA    T_WEIGHT+1      ; validate pounds
   017D 81 0D         [ 2]   90                 CMPA    #13             ; invalid pounds
   017F 22 46         [ 4]   91                 BHI     IERROR          ; internal error
   0181 BD 02 00      [ 9]   92                 JSR     GREET           ; send a greeting message
                             93 
                             94                 ; get the weight a second time, this should allow the scales time to settle
   0184 BD 02 8B      [ 9]   95                 JSR     GETDATA
                             96 
                             97                 ; output "you weigh" maybe use a phrase rather than individual words
   0187 CE 1A CB      [ 3]   98                 LDX     #MYOUWEIGH
   018A BD 03 A5      [ 9]   99                 JSR     PR_PHRASE
   018D FE 1B 18      [ 5]  100                 LDX     T_WEIGHT        ; restore X
   0190 BD 03 52      [ 9]  101                 JSR     PR_WEIGHT       ; weight back X so output the weight
   0193 BD 1A D7      [ 9]  102                 JSR     PANEL_DISP
