0082 0142 81 0d              ML3     CMPA    #HEAVY_WGHT     ; less than heavy is normal
0083 0144 22 03                      BHI     ML4
0084 0146 7e 01 f3                   JMP     NORMALW
0085 0149 81 0f              ML4     CMPA    #SHEAVY_WGHT    ; less than super heavy is heavy
0086 014b 2b 03                      BMI     ML5
