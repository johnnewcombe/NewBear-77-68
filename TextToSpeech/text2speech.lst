0437                         ; -----------------------------------------------------
0438                         ; Outputs a word based on value in X
0439                         ; -----------------------------------------------------
0440                         PR_WORD
0441 0361 ff 19 41                       STX     T_X             ; use ASL and ROL to multiply by 2 (pointer is 2 bytes wide)
0442 0364 78 19 42                       ASL     T_X+1           ; shift low byte left, bit 7 goes to carry
0443 0367 79 19 41                       ROL     T_X             ; rotate high byte left, carry in from low byte
0444 036a fe 19 41                       LDX     T_X
0445 036d ff 19 41                       STX     T_X             ; Stash X
0446 0370 b6 19 41                       LDAA    T_X             ; High byte of X
0447 0373 f6 19 42                       LDAB    T_X+1           ; Low byte of X
0448 0376 cb 94                          ADDB    #WORDPTR&255    ; Add low byte of WORDPTR address
0449 0378 89 03                          ADCA    #WORDPTR/256    ; Add high byte of WORDPTR address + carry
0450 037a b7 19 41                       STAA    T_X             ; T_X has the address of the pointer NOT the word
0451 037d f7 19 42                       STAB    T_X+1
0452 0380 fe 19 41                       LDX     T_X             ; X has the address of the pointer NOT the word
0453                         
0454 0383 a6 00                          LDAA    0,X             ; get the hi byte of the word
0455 0385 b7 19 41                       STAA    T_X
0456 0388 a6 01                          LDAA    1,X             ; get the low byte of the word
0457 038a b7 19 42                       STAA    T_X+1
0458 038d fe 19 41                       LDX     T_X             ; X now has address of the word
0459 0390 bd 02 91                       JSR     STRINGBX        ; output the word
0460 0393 39                             RTS
0461                         
0462                         ; -----------------------------------------------------
0463                         ; Word pointer table (max words 256)
0464                         ; Set X to the pointer ID and call PR_WORD
0465                         ; -----------------------------------------------------
0466                         ; To create new wordk add the word in the correct
0467                         ; (alphabetical) position in the word table. Then add
0468                         ; a pointer to that word at the END of the Word Pointer
0469                         ; table. Finally add an EQUATE using the word as a label
0470                         ; in the word equates table;
0471                         ; -----------------------------------------------------
