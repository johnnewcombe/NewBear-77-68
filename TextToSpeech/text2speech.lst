0107                         ; we cycle thought idle message when no one is on the scales, data comes in a one
0108                         ; second intervals so we simply increase the idle count until it's time to display
0109                         ; the next idle message
0110                         
0111 01a1 7c 19 4a           IDLE    INC     IDLE_COUNT      ; increase the idle count
0112 01a4 b6 19 4a                   LDAA    IDLE_COUNT      ; see if idle count = max idle time
0113 01a7 81 02                      CMPA    #IDLE_SECS      ; a data message appears every second
0114 01a9 27 03                      BEQ     IDLE1           ; not reached the max idle time
0115 01ab 7e 02 46                   JMP     END             ; nothing to do yet
0116                         
0117 01ae 7f 19 4a           IDLE1   CLR     IDLE_COUNT      ; time to output an idle message so reset the count
0118                         
0119                                 ; output the idle message
0120 01b1 b6 19 4b                   LDAA    IDLE_MSG_ID
0121 01b4 7c 19 4b                   INC     IDLE_MSG_ID     ; set to next message for the next next time
0122 01b7 81 05                      CMPA    #IDLE_MSG_CNT   ; are we beyond the end of the list
0123 01b9 26 04                      BNE     IDLE_OP         ; still at valid id so output idle message
0124 01bb 7f 19 4b                   CLR     IDLE_MSG_ID     ; beyond last message so reset the current msg to zero
0125 01be 4f                         CLRA                    ; set currentid back to 0
0126                         IDLE_OP
0127 01bf ce 11 8e                   LDX     #IDLEPTR        ; A has phrase ID, set X to the base address
0128 01c2 7e 02 2f                   JMP     PHRASE_OUT
0129                         
0130                         GREET   ; output the greeting message
0131 01c5 7c 19 4c                   INC     GREET_MSG_ID    ; get next idle message
0132 01c8 b6 19 4c                   LDAA    GREET_MSG_ID
0133 01cb 81 05                      CMPA    #GREET_MSG_CNT  ; are we beyond the end of the list
0134 01cd 26 05                      BNE     GREET_OP        ; still at valid id so output idle message
0135 01cf 86 00                      LDAA    #0              ; beyond last message so reset the current msg to zero
0136 01d1 b7 19 4c                   STAA    GREET_MSG_ID
0137                         
0138                         GREET_OP
0139 01d4 bb 00 00                   ADDA    GREETPTR-PHRASEPTR ; add the offset phrase pointers
0140 01d7 bd 03 3c                   JSR     PR_PHRASE       ; output idle message
0141 01da bd 03 29                   JSR     PR_CRB          ; CR/LF
0142 01dd 39                         RTS
0143                         
0144                         LIGHTW   ; output the light message
0145 01de 7c 19 4d                   INC     LIGHT_MSG_ID    ; get next idle message
0146 01e1 b6 19 4d                   LDAA    LIGHT_MSG_ID
0147 01e4 81 05                      CMPA    #LIGHT_MSG_CNT  ; are we beyond the end of the list
0148 01e6 26 05                      BNE     LIGHT_OP        ; still at valid id so output idle message
0149 01e8 86 00                      LDAA    #0              ; beyond last message so reset the current msg to zero
0150 01ea b7 19 4d                   STAA    LIGHT_MSG_ID
0151                         
