0596 ff4d a7 00                      STAA    0,X     ;   set the breakpoint
0597 ff4f 7e ff 8f           ENDB    JMP     START   ; Return to MINIMON
0598 ff52 81 32              Is2b    CMPA    #'2     ; Is it `2` ?
0599 ff54 26 f9                      BNE     ENDB   ; No: Return to MINIMON
0600 ff56 bd fc 65                   JSR     RD_X    ; Read address into X
0601 ff59 a6 00                      LDAA    0,X     ; Get opcode
0602 ff5b b7 f0 fc                   STAA    T_BYTE+1 ; Save it
0603 ff5e ff f0 f9                   STX     T_ABYT+2 ; Save address
0604 ff61 20 e8                      BRA     SAME    ; Set the breakpoint
